  "nodes": [
    {
      "id": "source_evidence",
      "label": "固定来源证据\narXiv 2210.01240v4\nPDF SHA-256 8e0502fa3b6b\n论文代码 v1 066f73fc70bf\n论文与固定分支联合核验",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "task_scope",
      "label": "定义受控推理任务\n只允许重复使用肯定前件\n证明演算包含公理 Ax 与跳步 Hop\n要求唯一标准证明",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "ontology_types",
      "label": "选择本体类型\n虚构名称规避预训练知识\n真实本体来自三个手工编写本体\n反事实本体随机组合真实概念名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "linear_ontology",
      "label": "生成线性层次本体\n随机包含 3 至 10 个概念\n每个节点有零个或一个子节点\n添加子类型关系与概念属性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "controlled_grammar",
      "label": "用简单语法渲染本体\n翻译每条边与每个属性\n使用受控句法变体\n保持简单且唯一的反向解析",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "context_order",
      "label": "先确定本体上下文顺序\n前序遍历生成自顶向下顺序\n后序遍历生成自底向上顺序\n完成排序后才插入干扰句",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "shortcut_audit",
      "label": "审查标签捷径\n无干扰句时标签预测接近完美\n查询属性是否出现会泄露极性\n消除此非推理启发式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "distractor",
      "label": "插入反捷径干扰句\n取已生成证明的结论属性\n在断开的新概念上赋予其否定\n将该句随机插入已排序上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "seed_axiom",
      "label": "播种形式证明\n均匀选择一个起始节点\n把一个实体赋给该概念\n创建初始类型公理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "proof_walk",
      "label": "沿本体树向上推演\n每一跳应用一次演绎规则\n在节点或节点属性处停止\n匹配目标证明长度 · 测试 1 3 5 跳",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "query_polarity",
      "label": "渲染实体事实与查询\n用自然语言表述初始公理\n以 0.5 概率询问证明结论\n或其否定是否为真",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold_cot",
      "label": "渲染标准思维链\n保持形式证明的有序步骤\n翻译每一步的结论\n每个证明步骤输出一句话",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "example_record",
      "label": "组装一条合成样本\n上下文 · 查询 · 标准思维链 · 标签\n保留与形式证明的一一映射\n按需动态生成样本",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "experiment_controls",
      "label": "设置论文实验变量\n1 · 3 · 5 跳\n自顶向下或自底向上上下文\n虚构 · 真实 · 反事实本体",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eight_shot",
      "label": "构造八样本思维链提示\n独立生成八条\n完整带标签的演示样本\n追加一条无答案测试样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "greedy_decode",
      "label": "解码思维链与二元标签\n使用贪心解码\ntext-ada-001 至 text-curie-001\ndavinci · text-davinci-001 · text-davinci-002",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "response_split",
      "label": "拆分模型回答\n恢复预测思维链句子\n恢复最终真或假标签\n标签与标准答案单独比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "semantic_parser",
      "label": "将预测思维链解析为符号形式\n应用递归下降语法\n恢复逻辑形式序列\n无法解析的步骤标记为错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_validity",
      "label": "判定步骤有效性\n严格有效仅用标准证明规则\n广义有效使用扩展演算\n其余步骤判为无效",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_atomicity",
      "label": "判定步骤原子性\n原子步骤只应用一次规则\n非原子步骤跳过中间结论\n该划分用于严格有效步骤",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_utility",
      "label": "判定步骤效用\n标准证明前提导向路径外结论\n即为误导步骤\n否则标记为正确步骤",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "proof_path",
      "label": "重建预测证明图\n寻找从前提到结论的路径\n正确路径可以与\n额外无效步骤同时存在",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "strict_metric",
      "label": "严格证明准确率\n要求存在规范路径\n步骤需严格有效 原子\n且位于正确路径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "skip_metric",
      "label": "跳步证明准确率\n额外允许严格有效\n非原子的正确步骤\n仍须到达目标结论",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "broad_metric",
      "label": "广义证明准确率\n允许广义有效步骤\n使用更强的证明演算\n仍须到达目标结论",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "valid_metric",
      "label": "有效证明准确率\n允许严格或广义有效步骤\n使用最宽松的证明路径\n仍须到达目标结论",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "label_metric",
      "label": "标签准确率\n直接比较真或假\n与证明准确率分开计算\n检查答案与推理是否一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "breakdown",
      "label": "汇总形式化分析\n按跳数 顺序与本体类型分解\n统计步骤类别及首个错误\n计算 Wilson 95% 置信区间",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_report",
      "label": "报告论文实验\n每个配置生成 400 条样本\n主分析共 48 组实验\n比较标签与四种证明准确率",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "论文匹配的代码与许可边界\n使用 v1 分支 066f73fc70bf\nCLI 默认 500 次 · 跳数遍历 1 至 5\n固定种子 62471893 · main 为后续 OOD 代码\n按需生成样本 · Apache-2.0",
      "type": "document",
      "size": "xl"
    }
  ],
