  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3024" pageHeight="712" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="DLC-Bench · arXiv:2504.16072v1&#xa;代码 @ 153ad3d · 数据 @ 2336d95&#xa;DLC-SDP 训练数据流水线&#xa;不属于本基准构建流程" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Objects365 v2 验证子集&#xa;选择高难对象区域&#xa;人工标注分割掩码&#xa;每个基准实例对应一个目标区域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="将 100 个区域分配给三个 VLM&#xa;GPT-4o：34&#xa;Gemini 1.5 Pro：35&#xa;Claude 3.5 Sonnet：31" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="两类问题" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="正向细节问题&#xa;对象 / 部件：颜色 · 形状&#xa;纹理 · 材料 · 大小&#xa;人工补充缺项 · 修正错误&