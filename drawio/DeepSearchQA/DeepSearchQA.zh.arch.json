      "size": "medium"
    },
    {
      "id": "blind_review",
      "label": "三方独立盲审评测\n3名独立专家背靠背检索\n执行全网多源深度取证",
      "type": "user",
      "size": "medium"
    },
    {
      "id": "comparison",
      "label": "盲审答案交叉比对\n对比3方独立检索与命题真值\n识别是否存在事实分歧",
      "type": "decision",
      "size": "medium"
    },
    {
      "id": "retain_curator_gt",
      "label": "保留策题人真值\n所有复核者达成一致结论\n无事实分歧直接验证通过",
      "type": "process",
      "size": "medium"
    },
    {
      "id": "resolution_class",
