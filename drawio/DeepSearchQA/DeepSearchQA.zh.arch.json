      "type": "decision",
      "size": "medium"
    },
    {
      "id": "update_gt",
      "label": "修正真值集合\n复核专家发现更新事实佐证\n根据新证据修订标准答案",
      "type": "process",
      "size": "medium"
    },
    {
      "id": "keep_gt",
      "label": "维持策题人权威真值\n判定复核检索存在疏漏或误判\n坚持经验证的原始真值",
      "type": "process",
      "size": "large"
    },
    {
      "id": "ambiguity_filter",
      "label": "剔除歧义问题\n存在无法消解的时间或语义歧义\n从评测数据集中永久剔除",
      "type": "terminal",
      "size": "medium"
    },
    {
      "id": "final_dataset",
      "label": "DeepSearchQA 金标评测集\n900道高难度深度检索试题\n584道集合题与316道单值题",
