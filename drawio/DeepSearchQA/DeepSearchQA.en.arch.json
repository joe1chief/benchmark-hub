      "label": "Discrepancy Cause Classification\nAnalyze root cause of divergence\nAssign adjudication resolution track",
      "type": "decision",
      "size": "medium"
    },
    {
      "id": "update_gt",
      "label": "Update Ground Truth\nReviewer identifies valid new web facts\nExpand ground truth with verified evidence",
      "type": "process",
      "size": "medium"
    },
    {
      "id": "keep_gt",
      "label": "Uphold Curator Ground Truth\nReviewer search found flawed or incomplete\nRetain rigorously validated curator truth",
      "type": "process",
      "size": "large"
    },
    {
      "id": "ambiguity_filter",
      "label": "Drop Ambiguous Prompt\nIrresolvable temporal or query ambiguity\nPermanently eliminate noisy task",
      "type": "terminal",
      "size": "medium"
    },
    {
      "id": "final_dataset",
