  "nodes": [
    {
      "id": "evidence",
      "label": "证据 · EACL 2026 正式版\n2026.eacl-long.362 · Git c1017dbe\nA.9 · 有效 batch128 · LR1e-5\nwarmup10% · bfloat16 · AdamW\nGit GenRM · 2e-5 · 3 epochs · max8192\nGit 脚本 ≠ 论文配置",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "reddit",
      "label": "r/WritingPrompts 语料源\n共享提示下的人类故事\n赞数 · 评论 · 时间戳\n赞数只是有噪声的偏好代理",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "test_source",
      "label": "留出测试候选\n用 PRAW 搜索 Fan 等来源帖\n每个来源帖取前 100 项结果\n得到 5,000+ 个提示帖 ID\n剔除 2023 年前故事",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "train_source",
      "label": "训练候选\neuclaise/WritingPrompts_preferences\n来源 HF 6f0b721 · MIT\n故事严格早于 2023 年",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "test_story_qc",
      "label": "故事级质检 · 测试\n赞数至少为 10\n删除非故事评论\n不少于 50 词 · 至多 2,048 token",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "train_story_qc",
      "label": "故事级质检 · 训练\n赞数至少为 10\n删除非故事评论\n不少于 50 词 · 至多 2,048 token",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "test_pairs",
      "label": "同提示测试配对\n赞数更高者作为 chosen\n赞数差至少为 chosen 的 25%\nchosen 必须发布时间更晚",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "train_pairs",
      "label": "同提示训练配对\n赞数更高者作为 chosen\n赞数差至少为 chosen 的 25%\nchosen 必须发布时间更晚",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "test_length",
      "label": "测试配对长度去偏\n按 chosen−rejected 建 100 桶直方图\n剪枝至对称分布\n平衡 chosen 更长 / 更短",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "train_length",
      "label": "训练配对长度去偏\n按 chosen−rejected 建 100 桶直方图\n剪枝至对称分布\n平衡 chosen 更长 / 更短",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "test_set",
      "label": "论文测试基准\n2,480 个成对比较\n3,543 篇唯一故事\n平均每篇 550 词",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "train_set",
      "label": "论文训练语料\n43,827 个偏好对\n50,309 篇唯一故事\n与测试集独立整理",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "zero_shot",
      "label": "零样本 LLM 裁判\n输入无标签故事 A / B\n先解释再输出 A/B\n两种故事顺序都评测\n对成对准确率取平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "bt_model",
      "label": "Bradley-Terry 奖励模型\n用 43,827 对训练\n分别给两篇故事打分\n最小化 chosen−rejected 奖励\n的负对数 sigmoid",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gen_model",
      "label": "生成式奖励模型\nSFT 直接 A/B 或 GPT-4.1 理由 + 结论\n测试时随机交换 A/B\n温度 0 · 单次采样\n使用交叉熵训练",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "成对准确率 + 论文结论\n正确偏好数 ÷ 有效样本数\n零样本结果平均两种故事顺序\nClaude 3.7 Sonnet · 73%\n最佳 BT / GenRM · 约 78%\nGenRM-CoT · 72%",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "rm_ranking",
      "label": "新故事奖励模型排序\n64 篇故事 · 40 个 LitBench 提示\n由 GPT-4.1 + GPT-4o 生成\nLlama-8B BT 排序新故事\n每个提示选 RM 最佳 / 最差故事",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_study",
      "label": "在线人工实验\n46 名英美 Prolific 工作者\n每对 10–13 名评分者\n选择 RM 偏好者 · 56.4% vs 43.6%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "固定公开工件\nTrain 079a36d · 43,827 对\nTest 21e2739 · 2,381 个完整 ID\nRationales 7c5e045 · 43,736 条\n比论文训练对少 91 条\nGit c1017dbe · 无许可证 · PRAW 复水",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "disclosure_gaps",
      "label": "工件缺口\nTest 2,480 · 干净 ID 2,381 · 99 对不完整\nTrain 43,827 · Rationales 43,736 · 差 91\nReddit 文本未重新许可\n§4.3：5/precision · A.3：6/accuracy\n无固定模型或官方排行榜",
      "type": "document",
      "size": "xl"
    }
  ],
