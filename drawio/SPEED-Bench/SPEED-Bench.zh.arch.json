  "nodes": [
    {
      "id": "public_sources",
      "label": "公开提示词数据源\n涵盖 18 个主流开源评测与对话语料集\nHumanEval · GSM8K · ShareGPT · UltraChat",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "category_classification",
      "label": "领域分类与语义标注\n将候选提示词规范归类至 11 个语义领域\n代码 · 数学 · 多轮对话 · 逻辑推理 · 问答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "split_curation_gate",
      "label": "评测基准切分流向门\n筛选高多样性语义质量集 (880条)\n或构造生产吞吐压力负载 (1k-32k)？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "qualitative_pipeline",
      "label": "嵌入空间语义多样性筛选\n基于 text-embedding-3-large 与贪心局部互换\n每类精选 80 条提示词 (共 880 条质量集)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "throughput_pipeline",
      "label": "长度分桶与领域信息熵划分\n划分 5 个输入长度分桶 (1k, 2k, 8k, 16k, 32k)\n涵盖高/混合/低熵3类 · 每组 512 条基准样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "SPEED-Bench 双轨评测发布集\n880 条高语义多样性定性评测提示词\n7,680 条真实大并发生产吞吐压力负载",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "offline_tokenization",
      "label": "离线分词与输入规整引擎\n在推理服务引擎外提前完成统一分词\n彻底消除客户端网络传输与分词耗时干扰",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "spec_verification_gate",
      "label": "推测词元验证判定门\n草稿模型生成的词元是否被目标模型接受？\n在目标模型沙箱中执行推测采样与对齐校验",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "accept_branch",
      "label": "草稿词元快速接收通路\n目标大模型验证确认草稿预测准确\n按接收长度推进上下文窗口并跳过自回归计算",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rollback_branch",
      "label": "草稿回滚与重新采样通路\n目标大模型纠正不匹配的草稿预测\n回滚推测状态并依据目标分布重新采样",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "token_telemetry",
      "label": "词元接收与回滚动态度量\n统计词元接收长度 (AL) 与回滚惩罚开销\n高并发分发请求最高支持 512 突发并发",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "推测解码服务效率指标报告\n接收率 (AR) · 输出 TPS · 用户端 TPS\n跨 SGLang、vLLM 与 TensorRT-LLM 加速比",
      "type": "terminal",
      "size": "xl"
    }
  ],
