  "nodes": [
    {
      "id": "evidence",
      "label": "证据边界\n无独立论文 • 无固定数据集\n官方 API 文档 + Blog 20762",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "platform",
      "label": "Codeforces 平台\n公开比赛 + 题库\n持续更新",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "objects",
      "label": "官方 API 对象\nProblem • Contest • Submission\nRanklistRow + RatingChange",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "identity",
      "label": "不是固定基准\n无标准题数、划分\n提示、尝试预算或得分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "selection",
      "label": "冻结报告选题\n比赛时间窗 • 题目子集\n污染 + 资格规则",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "protocol",
      "label": "冻结模型协议\n提示 • 语言 • 尝试预算\n工具 • 采样 • 时间预算",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model",
      "label": "生成完整程序\n保留尝试顺序\n记录每个提交候选",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_route",
      "label": "评测判题路径选择\n官方在线平台隐藏判题机 vs\n报告自有离线测试沙箱环境",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "online",
      "label": "官方在线提交\nCodeforces 隐藏测试 + 评测器\n平台限制与判定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "offline",
      "label": "报告自有离线评测器\n报告自有测试 + 沙箱\n必须详述；并非标准协议",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "outcome",
      "label": "逐提交结果\n判定 • testset • passedTestCount\n时间 + 内存消耗",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "aggregation_route",
      "label": "指标聚合路径决策\n固定题集准确率与 Pass@k vs\n在线竞赛得分、罚时与天梯分",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "fixed_metric",
      "label": "固定题集指标\n准确率或 Pass@k\n仅在报告定义后使用",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "contest_metric",
      "label": "比赛指标\n得分 • 罚时 • 排名 • 等级分\n仅在报告定义后使用",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "完整披露的评测报告\n选题 + 协议 + 判题 + 指标\n只比较相同冻结协议",
      "type": "terminal",
      "size": "xl"
    }
  ],
