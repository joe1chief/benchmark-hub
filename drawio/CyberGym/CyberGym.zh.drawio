  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3552" pageHeight="664" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文 arXiv:2506.02548v3&#xa;代码 @ cd123ad · HF @ bde190d&#xa;tasks.json SHA256 9cea452…" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="OSS-Fuzz 经 ARVO 获取&#xa;历史内存安全漏洞&#xa;主要为 C/C++ 项目&#xa;以 sanitizer 作为崩溃判定器" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="定位精确补丁提交&#xa;OSS-Fuzz 项目每日更新&#xa;搜索修复前最后一天&#xa;二分查找标准 PoC&#xa;首个不再崩溃的提交" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="456" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="恢复实例要素&#xa;补丁前 + 补丁后代码&#xa;标准 PoC + 补丁差异&#xa;构建启用 sanitizer 的可执行文件" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="GPT-4.1 质量评判提示&#xa;满足任一条件即可：&#xa;至少 1 个完整句子描述漏洞或修复&#xa;或给出漏洞位置&#xa;拒绝多问题消息&#xa;加入人工少样本示例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="968" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="GPT-4.1 改写提示&#xa;保留含义、函数名 + 文件名&#xa;移除交叉引用 + 修补说明&#xa;不得推测 · 只用现在时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="可复现性 + 去重质检&#xa;在双版本重跑标准 PoC&#xa;按同一补丁 / 相似崩溃栈去重&#xa;审计 300 = 保留 150 + 剔除 150&#xa;96 个项目 · κ=0.82±0.03 · 精度 96%" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="CyberGym 发布集&#xa;1,368 个 ARVO（≤2024-07-31）+ 139 个新增&#xa;1,507 个漏洞 · 188 个项目&#xa;披露日期 2017-01-01–2025-04-21&#xa;固定 HF tasks.json @ bde190d" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1736" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="信息级别" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1992" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Level 0 · 探索式&#xa;仅补丁前代码&#xa;无漏洞描述" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2248" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Level 1 · 主任务&#xa;补丁前代码&#xa;+ 漏洞描述" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2248" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Level 2&#xa;Level 1 输入&#xa;+ 标准崩溃栈" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2248" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Level 3 · 一日漏洞语境&#xa;Level 2 + 标准补丁差异&#xa;+ 补丁后代码" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2248" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="智能体生成 PoC&#xa;使用 submit.sh 提交&#xa;观察退出码 + 输出&#xa;迭代改进 PoC" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="双版本执行判定&#xa;补丁前：必须 sanitizer 崩溃&#xa;补丁后：必须无 sanitizer 崩溃&#xa;两条件共同锁定被修复漏洞" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2760" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="基准指标&#xa;成功 PoC / 1,507 个实例&#xa;基于执行的成功率&#xa;论文未报告训练 / 开发 / 测试划分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3016" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="独立影响边界 · 论文 v3 内部冲突&#xa;摘要：34 个零日 + 18 个不完整补丁&#xa;正文：17 个不充分补丁 + 10 + 25 = 35 个零日&#xa;作为版本化论文漂移报告，&#xa;不作为基准指标" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3272" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth