    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3520" pageHeight="672" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据边界&#xa;论文 2408.03361v7&#xa;仓库 d8a6a326 · 数据 a8c7450a&#xa;VLMEvalKit 7055d301" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="收集 2D/3D 医疗数据集&#xa;保留 268 个公开集 + 16 个医院集&#xa;分类 · 检测 · 分割" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="标准化数据&#xa;按 SA-Med2D-20M 转为 2D RGB&#xa;MeSH：展开 · 统一 · 合并左右侧标签" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="构建词汇分类树&#xa;38 模态 · 18 任务 · 18 科室&#xa;4 粒度；每标签 3 人标注并投票合并" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="生成问题模板&#xa;按模态 × 任务 × 粒度组合&#xa;10 个标签 × 10 个 GPT-4o 候选&#xa;人工审核；模态替换为占位符" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="构建选项池&#xa;全局视角：同源数据集的其他标签&#xa;局部视角：按模态/任务/粒度共享" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="组装 VQA 候选&#xa;抽取模板并恢复具体模态&#xa;加入正确答案和最多 4 个选项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="人工验证&#xa;必须含 3 类线索且必须看图作答&#xa;删除错答 · 目标不清 · 图像质量差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="平衡并保持多样性&#xa;每答案至多 30 例；不足则全部保留&#xa;变化外观 · 来源 · 年龄 · 性别" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="发布 25,831 个 VQA 对&#xa;验证 4,550 · 测试 21,281&#xa;测试答案隐藏；由组织方评分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="论文评测提示&#xa;单选：选择正确选项&#xa;多选：选全并以逗号分隔字母&#xa;零样本；不含示例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="论文答案抽取&#xa;优先识别选项字母&#xa;否则用 ChatGPT-3.5-turbo-0613&#xa;无法抽取即记错" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="论文指标&#xa;单选 ACC = 答对数 / 题数&#xa;多选 ACC = 命中数 / 预测数&#xa;多选召回 = 命中数 / 标准答案数" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3240" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="固定 VLMEvalKit&#xa;GMAI 继承 ImageMCQDataset&#xa;Question + Options；精确后缀&#xa;Please select the correct answer&#xa;from the options above.&#xa;exact_matching / 可选 judge；无多选解析器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, 