{
  "version": 1,
  "title": "ProtocolQA 构建与评测流程",
  "type": "academic-diagram",
  "source": "generated",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 14,
