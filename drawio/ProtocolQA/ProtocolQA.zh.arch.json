    "modules": 0
  },
  "nodes": [
    {
      "id": "step_1",
      "label": "招募生物学专家\n签约生物学博士\n或顶尖博士项目学生\n依靠领域专家人工构建",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "提取已发表实验方案\n从protocols.io选择记录\n选择STAR Protocols文章\n保留可操作的实验步骤",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "注入一个或多个错误\n有意改变一个实验步骤\n明确破坏或改变实验输出\n也覆盖中间步骤失败",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "解释注入的错误\n记录改动为何错误\n说明预期负面影响\n将解释与修改方案配对",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "交给另一批专家\n进行第二轮问题撰写\n提供全部相关修改上下文\n分离错误创建与题目起草",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "验证失败场景\n检查错误与解释是否对齐\n确认确实可能产生负面结果\n两项检查通过后才继续",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "起草故障排除问题\n描述假想的湿实验结果\n询问何种改动可改善结果\n正确答案对应注入错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "构建多项选择题\n保存问题与答案选项\n指定一个理想纠正措施\n加入合理的替代操作",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "在创作界面中审核\n用Airtable维护任务与元数据\n修订 · 拒绝 · 或批准草稿\n把通过题目合入语料库",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "冻结135道ProtocolQA题\n保持该子任务无工具\n公开发布约80%\n私留20%用于污染监测",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "使用零样本思维链提示\n随机打乱答案选项\n加入信息不足拒答选项\n要求答案标签内单个字母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "解析模型选择\n用正则提取答案标签\n失败时回退到Claude 2解析\n把拒答视为未尝试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "计算选择性指标\n准确率 = 正确数除以全部题\n精确率 = 正确数除以已尝试题\n覆盖率 = 已尝试题除以全部题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "用人类与自由回答验证\n专家测验可使用研究工具\n不让作者看到自己编写的题\n专家评分20题开放回答子集",
      "type": "terminal",
      "size": "xl"
    }
  ],
