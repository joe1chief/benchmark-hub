    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3856" pageHeight="1336" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="主要证据与固定版本&#xa;arXiv:2604.09554v2 · 2026-05-05&#xa;Git c028ecdc · 2026-05-07&#xa;HF 27d12d72 · 2026-03-13&#xa;官方排行榜核验于 2026-07-21" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-72" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义五类科研能力&#xa;文献理解与检索 1,287 · 数据访问 86&#xa;分子生物学 400 · 实验方案排错 125&#xa;实验规划 14 · 合计 1,912&#xa;开放式检索与文件任务" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-72" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="专家文献路线 · 1,137 行&#xa;LitQA3 168 · 专利 121 · 临床 120&#xa;补充 125 · 图 101×3 · 表 100×3&#xa;博士级签约专家 · 专用平台&#xa;仅由指定来源回答 · 签约与内部专家多轮审核" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="384" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="SourceQualQA · 150 行&#xa;从 100 篇开放系统综述开始&#xa;提取因果问题 · 排除研究 · 专家组理由&#xa;当前 file 模式提供被排除研究的 PDF&#xa;最终人工检查专家可回答性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="384" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="DbQA2 · 86 行&#xa;用 LLM 分析 1,000 篇近期 bioRxiv 论文&#xa;按来源占比排序 · 人工整理与补充&#xa;43 个来源 → 内部与签约专家编题&#xa;多轮审核与修订" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="384" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="SeqQA2 · 400 行&#xa;内部生物学家定义 20 个模板&#xa;每类扩展 20 个设计或真实序列变体&#xa;保留逐题模式与验证器参数&#xa;构建 20 类任务专用验证器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="384" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="ProtocolQA2 · 125 行&#xa;protocols.io · STAR Methods · 专家方案&#xa;专家提供的部分方案尚未发表&#xa;签约专家注入一个会导致明确失败的错误&#xa;构造情景与结果 · 后缀要求只答一个错误" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="384" y="912" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="CloningQA · 14 行&#xa;限制性连接 · Gibson · Golden Gate&#xa;设计 DNA / 酶与端到端步骤&#xa;要求输出可解析 DSL 以供计算机模拟检查&#xa;论文未披露任务构建来源" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="384" y="1152" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="发布 LABBench2 · 1,912 行评测数据&#xa;五类规模：1,287 + 86 + 400 + 125 + 14&#xa;HF all + 15 个配置 · 唯一 split 名为 train&#xa;自动门控 Parquet · 公开 GCS 附件&#xa;ideal · sources · mode · 评分器元数据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="物化文档与检索模式&#xa;图：inject/PDF/图像 · 各 101&#xa;表：inject/PDF/图像 · 各 100&#xa;文献/专利/临床/补充/Db：inject&#xa;SourceQuality/ProtocolQA2：file" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1296" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="物化序列输入模式&#xa;SeqQA2：inject 400 · file 400&#xa;retrieve 200&#xa;Cloning：inject/file/retrieve · 各 14&#xa;按逐题 mode 过滤支持&#xa;自主检索 ≠ harness 模式别名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1296" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="运行官方评测框架&#xa;基础系统：不提供工具&#xa;工具增强：主要提供网络搜索与代码执行&#xa;路由模式专用提示、文件与检索输入&#xa;HybridEvaluator 按 tag 分发" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1752" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="通用语义 LLM 评分器&#xa;LitQA3 · 专利 · 临床试验&#xa;SourceQuality · Protocol&#xa;Claude Sonnet 4.5 · 温度 0&#xa;接受语义或数值等价&#xa;正确 1 · 错误 / 不确定 / 评分异常 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2208" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="DbQA2 召回率 LLM 评分器&#xa;召回率 = 匹配的期望项 / 期望项总数&#xa;数值默认允许 ±5% · 必须精确时除外&#xa;召回率 ≥ 0.95 → 1&#xa;较低召回率 / 不确定 / 评分异常 → 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2208" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="数值 LLM 评分器&#xa;FigQA2* · TableQA2* · SuppQA2&#xa;绝对或相对误差 &lt; 1e-6&#xa;遵循题目明确要求的输出格式&#xa;正确 1 · 其他 / 不确定 / 评分异常 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2208" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="SeqQA2 确定性验证器&#xa;用逐题 answer_regex 解析 [answer]&#xa;合并 validator_params 与抽取字段&#xa;调用 20 类任务专用验证器之一&#xa;通过 1 · 解析 / 文件 / 验证失败 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2208" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="CloningQA DSL 验证器&#xa;解析并执行 [protocol] 表达式&#xa;相似度 = 1 − 编辑距离 / 最大长度&#xa;与参考序列相似度 ≥ 0.95 · 支持环状旋转&#xa;可选酶切片段检查 · 任一失败记 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2208" y="912" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="计算评测指标&#xa;Overall = 正确数 /（完成数 + 运行失败数）&#xa;Attempted = 正确数 / 完成数&#xa;每个运行失败均记 0&#xa;按能力类 · 模式 · 类型 · 基础/工具拆分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2664" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="官方在线排行榜&#xa;对 15 个子基准做宏平均&#xa;重复运行取均值 · 展示标准误差&#xa;汇总对比要求覆盖至少 14/15&#xa;2026-07-21 观测：9 个模型 · 201 次运行" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3120" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="发布与结果漂移&#xa;v1 / OpenReview 1,883 → arXiv v2 1,912&#xa;2026-03-13：替换 150 条 SourceQuality&#xa;inject → file · 03-23 runner 修复&#xa;博客 1,892 + HF 论文号已过时" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3120" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="制品与披露边界&#xa;任务数据自动门控 · 框架与 GCS 文件公开&#xa;train 只是 split 名称，不代表用于训练&#xa;未报告 train/dev/test、去重或污染检查流程&#xa;未披露 Cloning 题目构建来源与质控" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-