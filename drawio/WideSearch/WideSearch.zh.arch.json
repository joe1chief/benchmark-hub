  "nodes": [
    {
      "id": "real_queries",
      "label": "真实用户查询语料库\n采集自真实搜索日志中的复杂信息需求\n涵盖跨实体、多维度对比之深度调研诉求",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_clarify",
      "label": "人工筛选与意图澄清\n人工初筛并消除问题中的代词与语境歧义\n将模糊需求显式转化为结构化信息调研总表",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "gold_search",
      "label": "穷尽全网搜索与标准表制作\n专家团队进行穷尽式检索与信息交叉验证\n记录耗时、检索词与网页数，编撰黄金 Markdown 表格",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parametric_gate",
      "label": "闭卷大模型独立可解性门禁\n测试无外挂工具的纯大模型是否能完整作答\n坚决剔除依靠内部参数记忆即可答对的常识题",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "drop_query",
      "label": "淘汰非挑战性任务\n判定该题目依赖内部记忆即可解或过于平庸\n从候选任务库中予以永久剔除",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "difficulty_gate",
      "label": "耗时与网页数量难度门禁\n强制要求人工专家平均搜寻耗时不少于 10 分钟\n必须至少查阅并综合 10 个以上独立域名网页",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "commercial_response",
      "label": "商业顶尖智能体实测作答\n将题目输入顶尖商业搜索智能体进行实测推演\n捕获其生成的完整 Markdown 结构化表格回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "auto_score",
      "label": "自动化评测脚本打分\n运行自动化表格解析与单元格对齐比对程序\n输出各字段得分与表格完整度初步指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_score",
      "label": "人工专家盲审独立打分\n领域专家独立对同一份商业模型回答人工判分\n形成用于检验自动化打分可靠性的人工基准分",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "score_agreement_gate",
      "label": "自动/人工评分一致性门禁 (>=95%)\n比对自动化评测结果与专家人工打分的一致度\n要求打分一致性相似度必须达到 95% 以上",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise_gold",
      "label": "任务题面与标准答案迭代修订\n修正题面约束漏洞或补充标准表格中的长尾有效答案\n循环迭代直至自动与人工打分达成高度一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wide_set",
      "label": "200 道经验证的双语深度搜索任务\n包含 100 道英文任务与 100 道中文任务\n横跨科技、人文、经管等 18 大真实专题领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "search_agent",
      "label": "运行受测搜索智能体\n向智能体输入深度调研任务提示词\n自主开展多步网页检索、内容抽取与表格构建",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_gate",
      "label": "Markdown 表格语法合规门禁\n解析输出文本中的表格标记与表头定义\n严格核验是否形成合法可解析的二维数据表格",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "zero_score",
      "label": "格式畸变判定零分\n输出格式崩溃、未生成表格或字段严重错位\n直接判定整表零分并终止单元格对齐",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "primary_align",
      "label": "按主键智能对齐数据行\n自动识别主键列并在候选行与标准行之间对齐\n解决输出行次序颠倒与部分缺失的匹配问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cell_router",
      "label": "单元格数据类型分流路由器\n依据列定义的语义数据类型实施精准分流\n分派至精确、数值、日期、链接或语义校验模块",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "exact_eval",
      "label": "精确文本比对器\n标准化字符串完全一致性比对\n自动忽略字母大小写与两端空白字符扰动",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "numeric_eval",
      "label": "数值与单位容差校验器\n解析提取数值大小与物理/货币度量单位\n在预设合理公差范围内验证数值正确性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "date_eval",
      "label": "日期与时间规范化校验器\n将多样化日期表达规范化为标准 ISO 格式\n核对年月日的时间一致性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "url_eval",
      "label": "URL 域名与目标核验器\n规范化链接参数并核实引用目标网页有效性\n检验所引出处证据的权威度与忠实度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "semantic_eval",
      "label": "GPT-4.1 语义等价评判器\n对长文本描述型单元格实施模型裁判语义核验\n客观判定表述差异下事实核心的一致性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cell_scores",
      "label": "单元格与数据行 Precision / Recall / F1\n计算细粒度字段级精确率、召回率与 F1 调和均值\n在对齐后的数据矩阵中展开多维度统分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wide_metrics",
      "label": "整表成功率与行/项 F1 综合指标\n统计要求全表无瑕疵的完备成功率 (SR)\n汇总行级 F1 均值与单元格级 Item-F1 指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "multi_run",
      "label": "多次推演综合评估大报\n统计输出多次运行下的 Avg@N、Pass@N 与 Max@N\n全面展示智能体在大规模深度搜索任务上的能力图谱",
      "type": "terminal",
      "size": "xl"
    }
  ],
