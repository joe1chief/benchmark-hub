  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4360" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定论文证据&#xa;arXiv 2003.10286v1&#xa;PDF cbfe071a8d80&#xa;ACL 2021 · PDF 9760f1711cdb" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="解决医疗数据缺口&#xa;公开病理图像稀缺&#xa;病理学家缺少标注时间&#xa;改用教材与数字图书馆" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择公开教材来源&#xa;Textbook of Pathology&#xa;Basic Pathology&#xa;使用在线PDF版本" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="抽取PDF图像与文本&#xa;PyPDF2读取图像XObject&#xa;PDFMiner读取文本与位置&#xa;保留页面坐标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="匹配教材图注&#xa;用正则查找Fig或Figure&#xa;按页面位置排序&#xa;依次配对图像与图注" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="选择在线图书馆&#xa;病理教育信息资源库&#xa;PEIR公开数字图书馆&#xa;使用图像页面与图注" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="抓取PEIR图文对&#xa;Requests下载页面与图像&#xa;Beautiful Soup解析目标HTML标签&#xa;图注随本地图像保存" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="清洗图像图注对&#xa;移除非病理图像&#xa;排除流程图与肖像&#xa;修正图注错配" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="使用CoreNLP解析图注&#xa;分句与分词&#xa;标注词性与命名实体&#xa;生成成分与依存分析" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="简化长句&#xa;重排主语、动词与从句&#xa;应用论文引用的句法规则&#xa;生成更短的陈述句" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="应用Tregex转换器&#xa;按规则查询成分树&#xa;分解主要动词&#xa;执行主语与助动词倒装" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="生成肯定问题&#xa;倒装主语与助动词&#xa;保留图注原命题&#xa;原始答案对应yes" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="生成平衡的否定问题&#xa;采样相同词性的短语&#xa;从其他图注取替换项&#xa;替换原问题中心词" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="生成开放式问题&#xa;what · where · when · whose · how&#xa;how much或how many&#xa;移除目标答案短语" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="合并生成的问答对&#xa;汇总开放式与是非分支&#xa;保留抽取出的答案短语&#xa;每条数据绑定对应图像" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="逐题人工校对&#xa;修正拼写、句法与语义&#xa;删除含糊或过短问题&#xa;清理符号、空格与答案冠词" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="形成arXiv v1数据集&#xa;4,998张图像 · 32,799个问答&#xa;教材1,670张 · PEIR 3,328张&#xa;开放题16,465 · 是非题16,334" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="按图像随机划分&#xa;比例0.5 · 0.3 · 0.2&#xa;训练2,499图 · 17,325问答&#xa;验证1,499 · 9,462 · 测试1,000 · 6,012" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="运行论文VQA基线&#xa;输入一张图像与一个问题&#xa;生成yes、no或自由文本&#xa;与参考答案比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3304" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="判断问题类型&#xa;二元yes或no&#xa;开放式自由回答&#xa;使用论文分类指标" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3560" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="评测二元问题&#xa;使用精确yes或no准确率&#xa;报告答对百分比&#xa;与开放题分开统计" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3824" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="评测开放式答案&#xa;精确匹配 · 宏平均F1&#xa;BLEU-1 · BLEU-2 · BLEU-3&#xa;比较词项与n元组" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3824" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="报告PathVQA结果&#xa;分别保留二元与开放题指标&#xa;保留官方图像级划分&#xa;比较论文披露的VQA基线" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4080" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="论文计数边界&#xa;arXiv v1记载32,799个问答&#xa;ACL 2021记载32,795个&#xa;两个版本不可互相替换" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#