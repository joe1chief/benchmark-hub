vertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="840" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="E7 · Typed Monitor Parser&#xa;Pydantic: reasoning + integer 0–10&#xa;Provider schema; validation retries&#xa;Audit every parse failure" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1096" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="E6 · Average + Apply Threshold&#xa;Two validated integer 0–10 scores&#xa;Average, then use calibrated threshold&#xa;Any flag marks the trajectory" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1352" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="E8 · Episode Run QC&#xa;Retry early/zero/no-submit episodes&#xa;Retry scorer or environment failures&#xa;Drop missing monitor scores; never zero-fill&#xa;Use only valid-score denominator" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1608" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="E9 · Harm Timing&#xa;Live: first test output begins&#xa;&quot;Score value: C&quot;&#xa;Else final submit when side scorer = C&#xa;Only strictly pre-harm flags count" style="rou