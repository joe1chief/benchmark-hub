      "type": "process",
      "size": "xl"
    },
    {
      "id": "dependencies",
      "label": "设计跨会话依赖\n每个 Episode 含六个强依赖组\n每组由两至三个任务构成\n另含五个大体独立任务",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "starts",
      "label": "编写自然的欠规格开端\n用户发出的初始请求\n或环境触发信号\n信息足以启动但仍保留缺口",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "hidden_intents",
      "label": "标注 524 个可恢复意图\n表达潜在约束与偏好\n可在会话内或跨会话持续\n可从证据推断询问并执行",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "checklists",
      "label": "定义可核验 Checklist\n510 个 Rubric 项 · 168 个规则项\n表达具体细粒度义务\n保证条件必要且充分",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "graders",
      "label": "实现两类评分器\n模型 Rubric 判断开放内容\n确定性核验文件字符串与工具\n验证 Schema 与客观条件",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reference_review",
      "label": "执行并复核每个任务\n专家产出参考解答\n核验文件工具技能与评分器\n确保流程正确且边界清晰",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "定稿 π-Bench\n100 个任务 · 五类 Persona\n100 个多轮会话\n持久跨会话工作流",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "user_config",
      "label": "配置评测参与者\n统一 Nanobot 派生脚手架\nGPT-5.4 模拟用户和 Rubric Judge\n温度为零 · 默认解码 · 开启思考",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "repeat3",
      "label": "运行三条独立轨迹\n每个任务重复三次\n保留会话历史与产物\n报告均值与标准差",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "session_start",
      "label": "启动一个基准会话\n加载 Persona 记忆和工作区\n发送初始请求或触发信号\n隐藏已标注意图",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "agent_act",
      "label": "被测 Agent 响应\n推理澄清并调用工具\n创建或修改产物\n更新持久工作区",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "observe",
      "label": "模拟用户观察进展\n检查回复与工具调用\n检查工作区更新与产物\n更新意图跟踪状态",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "status_gate",
      "label": "分配唯一意图终态\n当前意图如何解决？\n检查本轮全部证据",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "completed",
      "label": "已完成意图\n行动或产物满足意图\n用户未显式披露\nAgent 直接完成",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "inferred",
      "label": "已推断意图\nAgent 提出定向问题\n用户在下一轮披露\nAgent 随后可执行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "provided",
      "label": "用户提供意图\nAgent 未解决也未定向询问\n用户主动补充缺失需求\n交互随后继续",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "terminal_gate",
      "label": "所有意图都已终态？\n已完成已推断或用户提供\n同时要求 Agent 最终回复",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "proc",
      "label": "计算主动性 PROC\n已完成与已推断意图之和\n除以全部隐藏意图\n行动与定向询问同等计分",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "comp",
      "label": "计算完成度 COMP\n每个 Checklist 项二元计分\n使用模型 Rubric 或确定性程序\n对会话 Checklist 取均值",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告两种不同能力\nPROC 衡量需求发现\nCOMP 衡量正确产物与决策\n三次运行取均值并报告偏差",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "prompt_boundary",
