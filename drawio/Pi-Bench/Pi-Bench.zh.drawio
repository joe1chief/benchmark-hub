okeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="已推断意图&#xa;Agent 提出定向问题&#xa;用户在下一轮披露&#xa;Agent 随后可执行" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="用户提供意图&#xa;Agent 未解决也未定向询问&#xa;用户主动补充缺失需求&#xa;交互随后继续" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="832" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="所有意图都已终态？&#xa;已完成已推断或用户提供&#xa;同时要求 Agent 最终回复" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="计算主动性 PROC&#xa;已完成与已推断意图之和&#xa;除以全部隐藏意图&#xa;行动与定向询问同等计分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="计算完成度 COMP&#xa;每个 Checklist 项二元计分&#xa;使用模型 Rubric 或确定性程序&#xa;对会话 Checklist 取均值" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;si