    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1176" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;arXiv 2605.14678v3 · f435e09ef007&#xa;Git 383910b16987 · 说明 aeb39fc6eb78&#xa;HF 116ae739261d · 任务 95807131f24d&#xa;发布 100 条任务记录" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="构建五类稳定 Persona&#xa;研究员 · 营销人员 · 药剂师&#xa;法律实习生 · 金融从业者&#xa;定义例程偏好与长期目标" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="创建长程 Episode&#xa;每个 Persona 对应一个 Episode&#xa;每个 Episode 含 20 个会话&#xa;每个会话对应一个多轮任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="构建持久环境&#xa;工作区跨会话共享&#xa;187 个独立工具&#xa;21 个可复用技能" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="派生工作流任务&#xa;来自真实工作例程与材料&#xa;要求产生具体交付物&#xa;人工复核真实性与可行性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="设计跨会话依赖&#xa;每个 Episode 含六个强依赖组&#xa;每组由两至三个任务构成&#xa;另含五个大体独立任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="编写自然的欠规格开端&#xa;用户发出的初始请求&#xa;或环境触发信号&#xa;信息足以启动但仍保留缺口" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="标注 524 个可恢复意图&#xa;表达潜在约束与偏好&#xa;可在会话内或跨会话持续&#xa;可从证据推断询问并执行" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="定义可核验 Checklist&#xa;510 个 Rubric 项 · 168 个规则项&#xa;表达具体细粒度义务&#xa;保证条件必要且充分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="实现两类评分器&#xa;模型 Rubric 判断开放内容&#xa;确定性核验文件字符串与工具&#xa;验证 Schema 与客观条件" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行并复核每个任务&#xa;专家产出参考解答&#xa;核验文件工具技能与评分器&#xa;确保流程正确且边界清晰" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="定稿 π-Bench&#xa;100 个任务 · 五类 Persona&#xa;100 个多轮会话&#xa;持久跨会话工作流" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="配置评测参与者&#xa;统一 Nanobot 派生脚手架&#xa;GPT-5.4 模拟用户和 Rubric Judge&#xa;温度为零 · 默认解码 · 开启思考" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="运行三条独立轨迹&#xa;每个任务重复三次&#xa;保留会话历史与产物&#xa;报告均值与标准差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;