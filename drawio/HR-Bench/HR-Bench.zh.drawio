  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3824" pageHeight="912" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据与固定版本&#xa;arXiv 2408.15556v1 · 仓库 5ad1177&#xa;Hugging Face 数据集 83b9013" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="收集 200 张 8K 图像&#xa;开放 DIV8K 与互联网来源&#xa;保留完整分辨率原图" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="人工标注相关目标的边界框&#xa;标出与问题对应的对象&#xa;保留目标在 8K 图像中的坐标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="在边界框内裁剪图像&#xa;GPT-4o 生成问答对&#xa;聚焦需视觉落地的细节" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="人工专家逐对复核&#xa;删除错误或有歧义的问题&#xa;保留难以靠猜测回答的样本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="分配感知任务&#xa;单实例细粒度信息&#xa;或跨实例关系" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="FSP · 100 个样本&#xa;属性识别 · OCR&#xa;视觉提示" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="FCP · 100 个样本&#xa;地图分析 · 图表分析&#xa;空间关系" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="构建两个分辨率视图&#xa;8K 保留原图&#xa;4K 围绕相关目标裁剪并保持宽高比" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="构造 4 个 A-D 选项&#xa;两个视图绑定同一标准答案&#xa;保持问题与目标的对应关系" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="论文协议&#xa;循环位移完整 A-D 序列&#xa;每个选项移到下一位置&#xa;运行 4 次并报告平均 ACC" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="固定 HF 发布差异 · 83b9013&#xa;四行组：标准答案 A → B → C → D&#xa;完整选项顺序不是循环位移" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="候选 MLLM 提示与输出&#xa;Question + Options A-D + 选择指令&#xa;将候选回答交给评测器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="仓库辅助 Yes/No 评判器&#xa;要求 llm_path；具体模型未固定&#xa;标准答案 + 候选回答&#xa;top_p 0.8 · top_k 40 · 温度 0.2" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="转为小写并匹配 yes/no 前缀&#xa;yes → 1&#xa;no 或其他任何前缀 → 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3240" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="仓库聚合&#xa;按 cycle_category 分组&#xa;对类别与 all 计算 gpt_score 均值&#xa;再平均各组；分别报告 4K 与 8K" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3544" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="试验性分辨率研究&#xa;准确率 + 分辨率相关的&#xa;下一 token 不确定度&#xa;不属于基准主评测" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="728" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="5ad1177 官方产物边界&#xa;4K 800 行 + 8K 800 行&#xa;每视图 200 道题 × 4 行&#xa;论文/发布置换差异已明确标出&#xa;DC² 是推理方法，不是基准构建步骤" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3544" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" par