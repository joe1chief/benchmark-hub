ht="100" as="geometry"/></mxCell><mxCell id="6" value="构建任务专属 GPT-4 提示&#xa;统一的初始指令&#xa;各任务独有规则&#xa;人工编写示例" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="生成候选对话&#xa;GPT-4 每任务生成超过 1,000 条&#xa;遵循指定能力约束&#xa;覆盖主题清单" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="应用五类筛选准则&#xa;任务规则与主题多样性&#xa;删除近似重复&#xa;排除实时或 2022 年后知识&#xa;拒绝常识错误、冒犯与隐私信息" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="五名标注员是否&#xa;全部通过该候选？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="发布 MT-Bench-101&#xa;1,388 个英文对话&#xa;4,208 个历史轮次 · 13 项任务&#xa;公开 · Apache-2.0" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeom