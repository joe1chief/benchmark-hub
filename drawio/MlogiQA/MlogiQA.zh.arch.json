  "nodes": [
    {
      "id": "source",
      "label": "LogiQA 原始测试题对\n英文 651 题 · 中文 651 题\n篇章 · 问题 · 四个选项\n标准选项索引",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "candidate_order",
      "label": "按源数据顺序取前 N 题\n单任务数据集抽样规则\n发布 ID 为 0–103 且有空缺\n最终目标为 80 道题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "languages",
      "label": "固定十种语言\n英 · 中 · 阿 · 西 · 日\n韩 · 泰 · 法 · 葡 · 越\n覆盖七个语言家族",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "translate",
      "label": "翻译另外八种语言\nGPT-4o-2024-05-13\n保留原始英文与中文\n翻译完整四选一记录",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "professional_review",
      "label": "专业翻译团队复核\n穷尽式审核每条机器译文\n检查含义与术语\n检查文化适配性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review_gate",
      "label": "译文忠实、自然且可翻译？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "localize",
      "label": "保留题：纠错并本地化\n修正翻译错误\n本地化词汇\n统一不一致术语",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "remove",
      "label": "淘汰题：删除不可翻译题目\n排除不合格候选\n不发布该条记录",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "edit_rates",
      "label": "人工修改率 · Table 2\n阿 22.50 · 西 30.00 · 日 51.25 · 韩 33.75\n泰 46.25 · 法 3.75 · 葡 46.25 · 越 18.75",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "selection_boundary",
      "label": "选择边界\n删除后如何补充题目\n论文未披露规则\n以发布 ID 确定最终集合",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "align",
      "label": "按 ID 对齐平行记录\n连接前规范化 ID 类型\n禁止按文件行序直接配对\n各语言 ID 集与标准答案一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MLogiQA 测试集\n每种语言 80 道测试题\n十个语言文件\n共 800 条测试实例",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_settings",
      "label": "比较三种提示设定\nEN · 英文指令\nNative · 目标语言指令\nEN-Few-shot · 目标语言示例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fewshot",
      "label": "发布的验证记录\n每种语言八条验证题\n主要用于提供示例\n论文未说明每次提示使用的 k",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "direct",
      "label": "生成直接答案\nMLogiQA 不使用 CoT\n篇章 · 问题 · A–D\n要求固定 JSON 答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generation_boundary",
      "label": "推理边界\n解码参数未披露\n论文未给出 MLogiQA 专用\n温度或 Token 上限",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "released_code_boundary",
      "label": "OpenCompass 0.3.7 边界\nHF 行使用 options 数组\n配置却要求四个编号选项字段\n仅 EN 零样本 · ZeroRetriever",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "解析最后一个 JSON 或母语短语匹配\nJSON 正则仅接受大写 A–D\n母语短语可能产出小写 a–d\n比较时忽略大小写；否则 None",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_gate",
      "label": "成功抽取选项？\nA · B · C · D",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "parser_abort",
      "label": "无法解析：发布代码失败路径\n代码把 None 交给模糊扫描\n不可解析输出触发 TypeError\n未修补代码则没有分数",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "已抽取：计算各语言准确率\n正确选项数 ÷ 全部 80 题\n错误选项计 0 分\n百分比保留两位小数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cacr",
      "label": "计算 CACR 英→目标语言\n英文答对题中两语均答对的比例\n使用平行对齐后的 ID\n报告迁移一致性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "cacr_boundary",
      "label": "分析代码边界\n论文 Formula 1 定义 CACR\nOpenCompass 0.3.7\n未发布 CACR 实现",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "rights_boundary",
      "label": "访问与权利边界\nP-MMEval 卡片：Apache-2.0\nLogiQA 仓库无 LICENSE 文件\n无专用排行榜",
      "type": "document",
      "size": "xl"
    }
