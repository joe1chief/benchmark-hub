    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1064" pageHeight="544" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Google 报告：2026 年 3 月&#xa;PDF SHA256 95d1144…&#xa;基础代码 c37b284 / 数据 5dc7739" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="复用固定 1,000 条文本提示&#xa;复用既有公开评分器&#xa;无新音频数据集发布" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="派生评测边界&#xa;无新采样 / 划分 / 去重 / 标注&#xa;未声称新增质检" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="为既有提示逐条合成音频&#xa;TTS 模型、音色与参数均未披露&#xa;保持提示语义" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="静态上下文多轮协议&#xa;相互依赖的旅行预订调用&#xa;保留基础任务序列" style="rounded=1;arcSize=20;html=0;convert