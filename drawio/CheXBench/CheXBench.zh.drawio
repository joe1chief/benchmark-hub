    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2624" pageHeight="736" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义 35 项 CXR 解读任务&#xa;35 项任务分属五类&#xa;粗粒度图像感知 • 细粒度图像感知&#xa;文本生成 • 问答 • 其他" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="收集 32 个公开 CXR 数据集&#xa;1,077,494 张唯一图像&#xa;报告 • 标签 • 框 • 图注" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="人工质控 + 自动化工程&#xa;过滤低质量或无关样本&#xa;GPT-4 重构自由格式报告&#xa;统一文件、标签与任务映射" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="保留官方或传统数据划分&#xa;严格分开训练、验证与测试&#xa;防止派生任务间数据泄漏" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="训练背景：CheXinstruct&#xa;8,466,352 个指令—图像—回答三元组&#xa;每项任务从 1