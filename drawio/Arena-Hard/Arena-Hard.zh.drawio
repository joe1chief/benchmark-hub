    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="1016" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Chatbot Arena 查询池&#xa;200,000 条众包提示" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="论文 v2 提示清理&#xa;去重 • 单轮 • 英文&#xa;精确快照与过滤规则未公开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="论文 v2 主题建模&#xa;text-embedding-3-small • UMAP • HDBSCAN&#xa;4,000 个不同主题&#xa;由 LLM 总结并命名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="论文 v2 质量标注&#xa;GPT-4-Turbo • 七项标准&#xa;逐条提示评分 0–7" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="论文 v2 质量门槛&#xa;保留提示得分 ≥ 6&#xa;保留簇均分 ≥ 5" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="高质量主题簇池&#xa;超过 500 个簇&#xa;由论文 v2 门槛筛得" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="多样性随机采样&#xa;随机选择 250 个簇&#xa;每簇 2 条 = 500 条" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="采样后安全清理&#xa;移除 PII / 冒犯性内容&#xa;在 250 × 2 采样之后执行" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Arena-Hard 流程页&#xa;同一 Arena-Hard-Auto-v0.1 发布&#xa;500 题 • 并非独立数据集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="候选模型与基线回复&#xa;基线：gpt-4-0314&#xa;在 500 条开放提示上生成" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="每题执行两局裁判&#xa;交换 A/B 位置&#xa;500 × 2 = 每模型 1,000 次判断" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="gpt-4-1106-preview • T = 0&#xa;max_tokens = 4,096&#xa;先生成自己的答案，再比较回复" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="五个允许的裁判标签&#xa;[[A&gt;&gt;B]] • [[A&gt;B]] • [[A=B]]&#xa;[[B&gt;A]] • [[B&gt;&gt;A]]" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="固定版本裁判解析器&#xa;无标签 → continuation；最多 2 次&#xa;单一 / 重复同标签 → 接受&#xa;冲突标签 → 立即无效；不重试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value=