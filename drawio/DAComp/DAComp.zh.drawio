    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3040" pageHeight="936" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文 arXiv:2512.04324v1&#xa;HF DE / Gold @ 8c4a189 / 11f04f0&#xa;HF DA / Eval @ 2cc2214 / 30e915f&#xa;论文未固定代码提交版本" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="8 位专家收集数据&#xa;宽松许可资产&#xa;Apache-2.0 / MIT 示例&#xa;保持企业真实性" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="完整数据智能生命周期" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="456" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="数据工程资产&#xa;73 个企业 SaaS 领域&#xa;每套模式约 400 列&#xa;数据转换项目&#xa;关系一致的合成数据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="经审核的 DE 基线&#xa;选择开源 dbt 项目 · 无错误&#xa;规范为纯 SQL&#xa;展开宏 / 物化关系 · 冻结依赖&#xa;资深工程师审计&#xa;连接 · 粒度 · SCD · 测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="968" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="DE 任务合同" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="DE-架构 · 30 题&#xa;从分析层出发&#xa;提出 5 个候选业务需求&#xa;数据工程师选 1 个&#xa;可行且有挑战的需求&#xa;高层需求 + 初始仓库&#xa;→ 工程规范" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="DE-实现 · 30 题&#xa;将审核基线逆向为单个&#xa;data_contract.yaml&#xa;完整 DAG + 语义&#xa;详细规范 + 空仓库&#xa;→ 标准多层 SQL 仓库" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="DE-演化 · 50 题&#xa;在职数据工程师&#xa;编写变更&#xa;现有生产式仓库&#xa;新业务 / 模式 / 窗口&#xa;/ 治理需求&#xa;→ 安全演化的多文件仓库" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="数据分析资产&#xa;100 个复杂 Web 数据库&#xa;+ 来自 DE 数据的语义层&#xa;分析就绪表" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="DA 任务设计 · 100 题&#xa;每张表起草 8 个开放问题&#xa;5 名标注者按真实性 + 难度投票&#xa;保留前 2 个问题&#xa;要求报告、洞察、行动建议 + 可视化" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="968" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="八位专家质量控制&#xa;真实性 · 质量 · 一致性&#xa;DA 评分标准对齐讨论&#xa;确定性 DE 标准仓库&#xa;+ 执行脚本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1736" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="DAComp · 210 题&#xa;DE-架构 30 · DE-实现 30&#xa;DE-演化 50 · DA 100&#xa;DAComp-zh 使用相同任务集&#xa;英文 / 中文发布产物" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1992" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="按任务类型分流" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2248" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="DE-架构评估&#xa;标准非层次评分 · 无 GSB&#xa;业务对齐 + 语义准确&#xa;技术可行 + 结构完整&#xa;设计质量" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="DE-实现 / 演化 · DuckDB&#xa;精确模式 + 数据&#xa;CS：每节点使用标准上游&#xa;CFS：使用预测上游；错误级联&#xa;SR：全部组件完美&#xa;DE-Evol 成功边界：CFS ≥ 80" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="DA 评估 · 至少 3 名标注者 + 对齐&#xa;有效路径 + 锚点值&#xa;5 个多样 LLM 覆盖验证&#xa;层次评分：完整性 · 准确性&#xa;· 洞察力&#xa;GSB：可读性 · 分析深度&#xa;· 可视化 · 对比 5 份基线&#xa;Gemini-2.5-Flash&#xa;最终 0.6 评分 + 0.4 GSB" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=8;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="DAComp 混合报告&#xa;DE 架构评分&#xa;CS · CFS · SR&#xa;DA 层次评分 + GSB&#xa;DE、DA 与总分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2760" y="432" width="200" height="100" as