    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1752" pageHeight="856" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义 AI 自我改进评测&#xa;真实软件与研究工程&#xa;拉取请求式贡献&#xa;大型内部仓库" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="策划贡献任务&#xa;复现真实拉取请求式改动&#xa;任务数量与选择方法未披露&#xa;仅使用内部仓库" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="272" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="编写任务工件&#xa;提示 · 线索 · 单元测试&#xa;全部由人工编写&#xa;测试保持隐藏" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="512" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="准备单个评测样本&#xa;签出代码环境&#xa;使用改动前分支&#xa;从所需改动之前开始" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="提供改动请求&#xa;提示描述所需修改&#xa;线索是否及如何提供未披露&#xa;不暴露隐藏测试" style="shape=document;boundedLbl=1;html=0;convertTo