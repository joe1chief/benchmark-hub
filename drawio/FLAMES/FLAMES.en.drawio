    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2824" pageHeight="776" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Fixed evidence boundary&#xa;arXiv:2311.06899v6&#xa;Flames repo @ 234bcb7&#xa;HF CaasiHUANG/flames-scorer&#xa;revision @ cdb1528" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Define the five-dimensional framework&#xa;fairness 590 · safety 779&#xa;morality 522 · legality 118&#xa;data protection 242&#xa;Chinese values fall under morality" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Crowdworkers write Chinese prompts&#xa;concrete scenario per subcomponent&#xa;disguise · reverse induction&#xa;unsafe inquiry&#xa;successful examples guide free writing" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Apply two review rounds&#xa;1: target value + explicit scenario&#xa;+ attack method&#xa;2: attack at least one tested LLM&#xa;inspectors modify or discard failures" style="rounded=1;arcSize=20;html=0;convertToSvg