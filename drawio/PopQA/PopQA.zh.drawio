<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="1112" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2212.10511v4 · PDF 6de64bcf9b19&#xa;Git 8172ab04794a · HF 098765c79ea1&#xa;同一 TSV · SHA 9a5227f41bff" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义开放域事实问答&#xa;事实表示为主语 · 关系 · 宾语&#xa;提出实体中心问题&#xa;不提供标准证据段落" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择 16 种 Wikidata 关系&#xa;职业 · 出生地 · 类型 · 父亲&#xa;国家 · 制片人 · 导演 · 作为首都&#xa;编剧 · 作曲家 · 颜色 · 宗教&#xa;运动 · 作者 · 母亲 · 首都" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="向高流行度加权抽样&#xa;仅当 \(f &gt; \exp(8R - 6)\) 时保留&#xa;R 在 (0,1) 上均匀分布&#xa;f 为精确匹配词频&#xa;来自 800 MB C4 样本中的主语别名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="限制每种关系规模&#xa;每种关系达到 2,000 条即停止&#xa;提高关系类型多样性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="作者人工标注模板&#xa;每种关系一个最终自然语言模板&#xa;附录表 2 列出全部 16 个模板" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="实例化每个问题&#xa;将主语 S 代入占位符&#xa;使用关系 R 对应模板&#xa;生成自然语言问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="构造可接受答案闭包&#xa;纳入每个实体 E&#xa;满足 Wikidata 中存在 (S, R, E)&#xa;将所有这类实体作为金标答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="附加流行度&#xa;查询维基百科月度访问量&#xa;以主语流行度作为代理量&#xa;按主语流行度分析记忆表现" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="封装固定发布&#xa;14,267 行 · 17 列&#xa;Git TSV 与 HF test.tsv 相同&#xa;ID · 别名 · URI · 维基标题&#xa;问题 · 流行度 · 可接受答案" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="使用论文提示词&#xa;原文：Q: &amp;lt;question&amp;gt; A:&#xa;GPT-3 使用零样本&#xa;GPT-Neo 与 OPT 使用 15 样本&#xa;从其余 15 种关系各取一例" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="选择记忆模式&#xa;原始参数记忆&#xa;BM25 · Contriever · GenRead&#xa;使用相同问题做对比" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="使用参数记忆&#xa;使用已配置的零样本或 15 样本提示&#xa;不加入检索或生成上下文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="使用增强上下文&#xa;BM25：保留完整首段检索文本&#xa;Contriever：按“. ”切分并丢弃末段&#xa;GenRead：维基百科背景 · 最多 150 token&#xa;随后追加问答提示" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="生成自由文本答案&#xa;runner 最多生成 15 个新 token&#xa;GPT-3 温度 0 · top-p 1&#xa;本地模型使用贪心解码&#xa;仅保留输出首行" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="应用固定 runner 评分器&#xa;读取 possible_answers&#xa;检查原样 · 小写 · 首字母大写金标&#xa;在预测子串中查找金标&#xa;不做通用归一化" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="报告 PopQA 结果&#xa;平均准确率 · 各关系准确率&#xa;关联二元正确性&#xa;与主语流行度对数" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="运行自适应检索协议&#xa;75% 用于阈值开发&#xa;25% 用于评测&#xa;重复 100 次随机划分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="学习各关系阈值&#xa;穷举流行度阈值&#xa;最大化自适应准确率&#xa;仅使用开发集预测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="应用各关系阈值策略&#xa;低于阈值时使用检索增强预测&#xa;否则使用参数记忆预测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="报告自适应准确率&#xa;对 100 次划分取平均&#xa;比较准确率与检索占比&#xa;保留各关系独立阈值" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="发布与运行数量边界&#xa;固定 TSV 与图 4：14,267&#xa;附录 B 称 GPT-3 运行 14,282 题&#xa;15 题差异尚未解释&#xa;不得把运行快照等同于固定 TSV" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="调用漂移&#xa;论文 GPT-3：零样本 · runner：15 样本&#xa;README 遗漏 --n_examples 0&#xa;Contriever README：--ret_file&#xa;runner：--ret_path" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="论文与 runner 评分边界&#xa;论文：金标精确子串&#xa;runner 检查三种金标大小写&#xa;不将整段预测转为小写&#xa;无 token 或别名归一化器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="自适应结果边界&#xa;notebook 输入路径为空&#xa;未提供固定结果文件&#xa;阈值逻辑可复现&#xa;此处不重算论文数值" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exit