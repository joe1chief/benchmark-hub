  "nodes": [
    {
      "id": "raw_databases",
      "label": "Multi-Domain Relational Databases\n95 Databases Across 37 Domains (33.4 GB)\nSourced from Kaggle, CTU, & Open Portals",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "schema_profiling",
      "label": "Schema Profiling & Knowledge Extraction\nEntity-Relationship Graphs & Descriptions\nExtract External Domain Knowledge Hints",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dual_sql_authoring",
      "label": "Dual Independent SQL Authoring\nAnnotators Author Question + Evidence\nTwo Independent Experts Write Ground SQL",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "execution_match_gate",
      "label": "Dual-Execution Equivalence Gate\nDo Both Independent Queries Yield Identical Tables?\nExecuted on Active Relational Database",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "expert_adjudication",
      "label": "Expert Review & Efficiency Optimization\nAdjudicate Mismatch & Prune Ambiguity\nSelect Most Computationally Efficient SQL",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "match_candidate",
      "label": "Verified Consistent SQL Candidate\nConsistent Question-Evidence-SQL Tuple\nHigh Quality Semantic-Execution Alignment",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "BIRD-SQL Frozen Benchmark\n12,751 Clean Text-to-SQL Pairs\n69 Train · 11 Dev · 15 Held-Out Test DBs",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_assembly",
      "label": "Schema & Evidence Prompt Assembly\nDDL Schema + Foreign Keys + Domain Evidence\nAppends Natural Language User Question",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "Model SQL Generation\nIn-Context Learning (CoT) or Fine-Tuned Model\nOutputs Executable SQL Query Statement",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sandbox_execution",
      "label": "SQLite Database Sandbox Execution\nExecute Predicted Query on SQLite Engine\nCatch Syntax Errors & Execution Timeouts",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "result_accuracy_gate",
      "label": "Result Table Equivalence Gate\nPredicted Table Matches Gold Result Set?\nOrder-Agnostic Value Comparison",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "valid_efficient",
      "label": "Execution Success & VES Timing\nMeasure Relative Query Execution Speed\nCompute Computational Efficiency Ratio",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execution_failure",
      "label": "Execution Failure & Error Triage\nSyntax Error, Null Output, or Data Mismatch\nScore Zero for Invalid SQL Execution",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "Official Multi-Metric Reporting\nExecution Accuracy (EX) & Valid Accuracy (VA)\nReward-based Valid Efficiency Score (R-VES)",
      "type": "terminal",
      "size": "xl"
    }
  ],
