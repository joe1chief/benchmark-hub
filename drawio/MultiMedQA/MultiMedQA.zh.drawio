<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="736" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义广覆盖医疗问答评测&#xa;医学考试 · 研究文献 · 消费者问题&#xa;多项选择与长文本回答&#xa;仅覆盖英文" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择六个既有问答数据集&#xa;专业考试 · 生物医学文献&#xa;消费者健康与用药问题&#xa;保留各数据集格式" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="准备健康查询种子&#xa;疾病与相关症状作为种子&#xa;面向消费者的起始词&#xa;进入搜索驱动采集分支" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCDD2;strokeColor=#E57373;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="盘点既有数据源&#xa;MedQA · MedMCQA · PubMedQA&#xa;MMLU 六个临床主题&#xa;LiveQA · MedicationQA" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="获取公开搜索建议&#xa;输入疾病与症状种子&#xa;收集所有用户可见的问题&#xa;保留常见消费者措辞" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="整理 HealthSearchQA&#xa;发表版表格含 3,173 条问题&#xa;3,156 个唯一文本 · 17 条重复&#xa;仅问题 · 自由文本 · 开放域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="汇编七数据集套件&#xa;七个英文数据集&#xa;多选与长文本两类格式&#xa;同时含开放域和封闭域任务" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="路由四组多选任务&#xa;MedQA · MedMCQA · PubMedQA&#xa;MMLU 临床主题&#xa;PubMedQA 输入包含摘要上下文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="应用提示策略&#xa;少样本 · 思维链&#xa;自一致性使用 11 次解码&#xa;论文明确该数字用于三个数据集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="按准确选项计分&#xa;分数据集或 MMLU 主题算准确率&#xa;比较 PaLM 与 Flan-PaLM 变体&#xa;报告提示策略消融" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="抽取 140 题长回答集&#xa;HealthSearchQA 100 题 · LiveQA 20 题&#xa;MedicationQA 20 题&#xa;与提示调优样例不重合" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="生成三组回答&#xa;临床医生参考回答&#xa;Flan-PaLM 540B 回答&#xa;Med-PaLM 540B 回答" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCDD2;strokeColor=#E57373;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="执行临床医生盲审&#xa;由另一组医生评审 · 隐藏回答来源&#xa;每个回答由一名医生评分&#xa;九名医生来自美国 · 英国 · 印度" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="评定临床质量维度&#xa;科学共识 · 伤害程度与可能性&#xa;理解 · 回忆 · 推理的正确与错误证据&#xa;错误或缺失内容 · 偏见" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="88" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="执行普通用户评审&#xa;五名印度非医学背景评分者&#xa;是否回应用户意图&#xa;是否有帮助且可行动" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="报告 MultiMedQA 结果&#xa;多选准确率与人工评分&#xa;1,000 次 Bootstrap 重采样&#xa;95% 百分位区间" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="既有参考答案边界&#xa;不把既有解释当作标准答案&#xa;来源不一致且部分来自非临床人员&#xa;由合格临床医生提供标准化参考" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="发布与权利边界&#xa;Nature 补充文件发布 HealthSearchQA · CC BY 4.0&#xa;六个源数据集各自保留使用条款&#xa;Med-PaLM 代码与权重未公开" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5