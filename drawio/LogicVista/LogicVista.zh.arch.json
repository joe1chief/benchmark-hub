  "nodes": [
    {
      "id": "source_banks",
      "label": "固定仓库 · 9 个来源题库\nAssessmentDay 261\nPractice Aptitude Tests 86\nAssess.ly 26 · JobTestPrep 25\n其余 5 个题库 · 共 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "access_controls",
      "label": "通过访问门槛降低泄漏\n许可 · 注册 · 付费\n获得研究使用授权\n论文：专有/封闭来源",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_collection",
      "label": "5 名标注者 · 历时 3 个月\n收集视觉推理题\n摘取图像与金标答案\n整理可获得的解释",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "item_annotation",
      "label": "构建每道视觉多选题\n图像 + 问题\n选项内嵌于文本/图像\n人工编写理由\n来源名称 + 来源网址",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "quality_review",
      "label": "交叉核验答案解释\n多轮标注复核\n人工验证字段\n避免真实场景捷径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "skill_axis",
      "label": "每题仅属一类推理技能\n归纳 107 · 演绎 93\n数值 95 · 空间 79\n机械 74 · 合计 448",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_capabilities",
      "label": "论文能力标签可重叠\n图示 330 · OCR 234\n模式 105 · 图形 67\n表格 70 · 3D 形状 45\n谜题 256 · 序列 76 · 物理 69",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_release",
      "label": "论文数据集\n448 道英文视觉多选题\n图像 + 问题 + 金标\n人工理由\n未报告数据划分",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "repo_snapshot",
      "label": "固定公开仓库\ndataset.json + 448 个 PNG\n样本 ID 为 0 至 447\n无划分清单/发布标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "released_schema",
      "label": "固定 JSON 结构\nimagename · question · answer\nreasoning · skill · 宽/细能力字段\nliscenced 是字符串字段\n样本 220：sourceli,nk 键名错误",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "taxonomy_drift",
      "label": "发布审计 · 类别漂移\n宽类：图示 236 · OCR 125\n图示 + OCR 87\n11 个互斥细类标签\n两套口径都合计 448",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "content_drift",
      "label": "发布审计 · 内容漂移\n44 条理由为空\n样本 382：问题与答案为空\n3 条多选项金标字符串\n论文宣称理由完整",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "rights_drift",
      "label": "发布审计 · 权利边界\n公开仓库 · Apache-2.0\nliscenced 字符串：true 161 · false 287\n论文/项目页：已许可来源\n图像权利范围仍不明确",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "missing_construction",
      "label": "发布审计 · 构建细节缺失\n无纳入/排除规则\n无去重/拒绝数量\n无一致性统计\n无来源留出策略",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "eval_drift",
      "label": "发布审计 · 评测器缺陷\ncapability 字段不匹配\n作者本机数据路径\n修复分支未置 success\n重试引用未定义 prompt",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "candidate_input",
      "label": "候选多模态模型输入\n图像 + 问题\n选项内嵌于图像/文本\n提示词与生成参数未公开",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "raw_output",
      "label": "模型自由文本输出\n字母 · 数字 · 句子\n已发布答案 JSON 输入脚本",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "answer_extractor",
      "label": "已发布 GPT-4 答案抽取器\nmodel = gpt-4 · temp = 0.2\n提示：问题 + 原始回答\n无独立选项字段",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "structured_parse",
      "label": "Pydantic 答案解析器\n输出 choices 列表\n允许字母或数字\n无法恢复选项 → ZZZZZ",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_valid",
      "label": "结构化解析有效？\n是 → 精确匹配\n否 → 回退路径",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "repair_retry",
      "label": "论文协议 vs 固定代码回退\n论文：携验证反馈重新抽取\n代码：OutputFixing 解析同一输出\nsuccess 未置位 · prompt 未定义\n最终回退 choices = ZZZZZ",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "exact_match",
      "label": "归一化并精确集合匹配\n两个列表均小写后排序\n按“逗号 + 空格”切分金标\n仅完全一致判正确",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "item_score",
      "label": "逐题二值评分\n正确为 1 · 否则为 0\n空输出 + 空金标可判 1 分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate_accuracy",
      "label": "汇总准确率（%）\n100 × 正确数 / 分组样本数\n总体 N = 448\n按技能与论文能力报告",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "results_boundary",
      "label": "论文/项目页静态结果\n标题称 8 个 MLLM\n表中列出 16 个配置\n约五选一随机基线\n无人类基线 · 无实时排行榜",
      "type": "terminal",
      "size": "xl"
    }
  ],
