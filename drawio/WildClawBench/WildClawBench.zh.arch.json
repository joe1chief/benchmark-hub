  "nodes": [
    {
      "id": "researcher_authoring",
      "label": "8 名研究者历时 2 周人工出题\n源自真实日常专业工作场景与生产力痛点\n设计严密的工程实现与办公自动化规格要求",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "task_package",
      "label": "标准化任务资产包\n包含 Markdown 规范说明、YAML 环境配置文件\n打包初始工作区文件、扩展技能库与依赖说明",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "expert_reference",
      "label": "专家基准参考解法\n制作标准产物工件、预期系统副作用基准\n编写自动化可执行的 Python 判分套件",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "frontier_pilot",
      "label": "前沿大模型与代理框架实测推演\n在多款顶尖前沿模型与 Agent 框架上实机试跑\n收集基线执行表现与得分分布数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gap_gate",
      "label": "分差区分度与天花板/地板效应门禁\n强制要求不同能力系统间分差 >= 0.2\n严密剔除全员满分或全员零分的无效题目",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "iterative_refine",
      "label": "任务迭代打磨与精修管线\n改写题目表述、重整输入资产、细化打分细则\n适度植入真实干扰项以检验抗干扰鲁棒性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "joint_review",
      "label": "全员人工联合深度审查\n逐题审核指导书、参考解法、打分器与执行轨迹\n深入排查系统日志与各种偶发失败归因",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "issue_gate",
      "label": "缺陷与信息泄漏审查门禁\n核验是否存在表述歧义、评分规则脆弱或答案泄漏\n排查环境不可复现性与隐藏依赖缺陷",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "fix_issues",
      "label": "修复已知缺陷并加固沙箱\n修正题面表述歧义、重构脆弱的判定断言代码\n清除潜在的答案泄漏并严格锁死镜像环境依赖",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recheck_gate",
      "label": "评分稳定性复检门禁\n确认评分逻辑在多次运行下具备绝对稳定性\n验证在相同输入与状态下输出完全一致",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "final_60",
      "label": "60 个最终可执行评测任务\n封存经过严苛质量检验的高难度实战级题目库\n正式发布标准化评测任务集合",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_composition",
      "label": "均衡的任务构成配比\n包含 36 英文 / 24 中文；26 多模态 / 34 纯文本\n涵盖效率流程、代码智能、社交、搜索、合成与安全",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "harness_fanout",
      "label": "多框架并行推演分发\n在四种异构框架下并行运行完全相同的任务\n各自保留原生提示词、工具协议与上下文管理逻辑",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "common_runtime",
      "label": "隔离 Docker 运行沙箱\n统一拉起轻量纯净的隔离 Linux 容器环境\n挂载标准化公共工作区目录与核心基础工具",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "openclaw",
      "label": "OpenClaw 框架执行推演\n在 OpenClaw 智能体架构下自主推进任务\n展开端到端多步工具调用与文件操作",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "claude_code",
      "label": "Claude Code 框架执行推演\n在 Claude Code 智能体架构下自主推演\n施展代码检索、就地修改与命令行运维能力",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "codex",
      "label": "Codex 框架执行推演\n在 OpenAI Codex 专用执行框架下开展推演\n进行程序化代码生成、脚本执行与结果校验",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hermes",
      "label": "Hermes 框架执行推演\n在 Hermes 智能体架构下调度模型运行\n施展多轮函数调用与自主推理决策",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "timeout_policy",
      "label": "动态任务超时控制策略\n根据题目复杂度设定 300 至 1,200 秒动态超时上限\n全集官方报告平均超时阈值为 881 秒",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "completion_gate",
      "label": "智能体退出与超时判定门禁\n检测受测智能体是否在超时前主动宣布完成并退出\n分流正常交付与超时强制中断两类状态",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "collect_outputs",
      "label": "收集产物工件与执行状态\n完整抓取生成的目标文件、环境系统变更数据\n归档交互轨迹、控制台日志与 token 消耗统计",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "terminate_partial",
      "label": "终止运行并保留部分阶段产物\n安全中断超时超步的沙箱容器进程\n完整保留已生成的中间文件以进行阶梯式诊断打分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hidden_grading",
      "label": "隐藏 Ground Truth 与评分资产库\n严密封存用于判分的标准对照答案与测试脚本\n在智能体推演执行期间完全屏蔽隔离以防作弊",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "post_exit_mount",
      "label": "退出后挂载隐藏评分资产\n仅在智能体确认退出或终止后方挂载评测套件\n彻底阻断智能体通过探索文件系统偷窥判分逻辑",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "grading_fanout",
      "label": "三重证据通道并行打分\n调度至多 3 条独立互补的证据通道开展多维核验\n融合确定性规则、底层环境状态与模型智能评审",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rule_audit_checks",
      "label": "确定性规则与系统环境审计\n证据通道 1 与 2：校验精准规则与文件差异\n深度审计守护进程存活、网络连通与操作轨迹合规性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gpt54_judge",
      "label": "GPT-5.4 语义与视觉综合裁判\n证据通道 3：施展高级自然语言与多模态感知裁决\n对长篇技术论述、图表排版与 UI 美观度实施专业评分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rubric_aggregate",
      "label": "依据任务 Rubric 加权聚合\n将各证据通道打分代入专属 Rubric 权重公式\n精准计算该题目的综合目标达成百分比",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "modality_weighting",
      "label": "多模态与文本加权平衡公式\n总分 = (26 * 多模态均值 + 34 * 纯文本均值) / 60\n客观平衡两大不同模态赛道的能力评估贡献",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wildclaw_report",
      "label": "WildClawBench 综合表现总报\n输出横跨四大框架与六大场景的 Rubric 终评大报\n客观反映智能体在真实复杂工作环境下的实战解决力",
      "type": "terminal",
      "size": "xl"
    }
