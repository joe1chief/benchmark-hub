      "type": "user",
      "size": "xl"
    },
    {
      "id": "issue_gate",
      "label": "Defect & Leakage Detection Gate\nCheck for ambiguity, brittle grading or leakage\nVerify environment reproducibility",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "fix_issues",
      "label": "Fix Identified Defects\nPatch ambiguities and brittle evaluation scripts\nEliminate information leaks and pin environments",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recheck_gate",
      "label": "Grading Stability Recheck Gate\nConfirm grading logic is stable and reproducible\nValidate zero variance on identical inputs",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "final_60",
      "label": "60 Final Executable Tasks\nCurated suite of verified complex tasks\nStandardized benchmark delivery",
      "type": "database",
      "size": "xl"
    },
