      "id": "task_composition",
      "label": "Balanced Task Composition\n36 English / 24 Chinese; 26 multimodal / 34 text\nProductivity, code, social, search, synthesis, safety",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "harness_fanout",
      "label": "Multi-Harness Execution Fanout\nRun identical task across 4 distinct harnesses\nPreserve distinct prompts, schemas, and contexts",
