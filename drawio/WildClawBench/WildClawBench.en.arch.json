      "size": "xl"
    },
    {
      "id": "common_runtime",
      "label": "Isolated Docker Runtime\nUnified isolated Linux container\nCommon workspace directory and tools",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "openclaw",
