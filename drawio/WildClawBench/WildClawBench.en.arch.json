      "type": "process",
      "size": "xl"
    },
    {
      "id": "timeout_policy",
      "label": "Dynamic Task Timeout Policy\nTask timeout between 300 and 1,200 seconds\nReported mean timeout: 881 seconds",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "completion_gate",
      "label": "Agent Exit & Timeout Gate\nDetect if agent finished before timeout\nHandle normal exit vs timeout interruption",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "collect_outputs",
      "label": "Collect Artifacts & Execution State\nGather created files, environment mutations\nRecord traces, logs, and token usage",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "terminate_partial",
      "label": "Terminate Run & Preserve Partial State\nSafely interrupt container execution\nPreserve partial artifacts for diagnostic grading",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hidden_grading",
      "label": "Hidden Ground Truth & Grading Assets\nWithheld verification materials\nStrictly hidden during agent execution",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "post_exit_mount",
      "label": "Post-Exit Grading Asset Mount\nMount hidden evaluation assets only after exit\nEnsure zero possibility of prompt injection leaks",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "grading_fanout",
      "label": "Three Evidence Channels Fanout\nGrade across up to 3 independent channels\nDeterministic rules, environment, and model judge",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rule_audit_checks",
      "label": "Deterministic Rules & Environment Audit\nEvidence channels 1 & 2: rules, file diffs\nVerify process status, network, and execution traces",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gpt54_judge",
      "label": "GPT-5.4 Semantic & Visual Judge\nEvidence channel 3: semantic & multimodal evaluation\nJudge complex artifacts, UI aesthetics & reports",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rubric_aggregate",
      "label": "Task Rubric Aggregation\nAggregate individual criterion scores per rubric\nCompute weighted task achievement percentage",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "modality_weighting",
      "label": "Modality Weighting Formula\nOverall = (26 * MM Mean + 34 * Text Mean) / 60\nBalanced multimodal and text evaluation",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wildclaw_report",
      "label": "WildClawBench Consolidated Score\nFinal rubric score across tasks and harnesses\nHigher score reflects stronger real-work agent capability",
      "type": "terminal",
      "size": "xl"
    }
