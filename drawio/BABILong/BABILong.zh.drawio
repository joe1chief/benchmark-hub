<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2744" pageHeight="752" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="生成 bAbI 模拟&#xa;人物、物体、地点与事件&#xa;合成事实和标准答案" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择 QA1 至 QA20&#xa;事实链 • 归纳 • 演绎&#xa;计数 • 列表/集合 • 时空推理" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="采样 PG19 图书&#xa;自然长篇叙事&#xa;按原顺序抽取背景句子" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="把任务事实隐藏到背景文本&#xa;交错相关句与干扰句&#xa;保持自然顺序和逻辑顺序" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="添加背景直至目标长度&#xa;用 GPT-2 tokenizer 计量&#xa;算法化调整事实位置" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="预生成可复现长度分区&#xa;0K • 4K • 8K • 16K • 32K • 64K&#xa;128K • 512K • 1M • 10M token" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="直接运行长上下文 LLM&#xa;定位支撑事实&#xa;记忆并推理得到答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="运行 RAG-C 基线&#xa;检索 512-token 文本块&#xa;把证据交给 LLM" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="运行 RAG-S 基线&#xa;检索单句&#xa;测试多跳与时序失败" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="课程式微调记忆模型&#xa;RMT • ARMT • Mamba&#xa;逐步增加循环片段数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="评测循环记忆&#xa;外推到训练长度之外&#xa;部分实验测试到 50M token" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="直接评测 QA1–QA5 准确率&#xa;每任务、每长度 1,000 例&#xa;覆盖至 32K&#xa;32K 以上 100 例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="RAG 精确准确率&#xa;每任务、每长度 50 例&#xa;RAG-C / RAG-S 分别报告" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="264" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="循环记忆准确率&#xa;至 1M 使用完整测试集&#xa;10M 使用 100 例&#xa;部分实验外推至 50M" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="诊断上下文利用&#xa;一、二、三事实任务&#xa;跟踪准确率随长度衰减&#xa;分析检索顺序与遗漏事实" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="504" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="比较独立评测协议&#xa;直接 • RAG-C • RAG-S&#xa;RMT • ARMT • Mamba&#xa;不合并不同样本数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="264" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="发布 BABILong 结果&#xa;按任务、长度、方法报告准确率&#xa;保留各自样本协议&#xa;报告部分 50M 外推结果" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="384" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;