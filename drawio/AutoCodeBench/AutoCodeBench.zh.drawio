F;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="执行解答与两类输入&#xa;多语言沙箱&#xa;获取演示与隐藏输出" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="构建可执行测试函数&#xa;DeepSeek-V3 整合输入输出&#xa;demo_test_func&#xa;full_test_func&#xa;与解答一起重跑两类测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="逆向生成编程题&#xa;六项启发式规范&#xa;嵌入演示测试 • 不泄露解法" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="语言覆盖路由&#xa;6 种语言走直接流程&#xa;其余 14 种翻译未使用数据&#xa;再应用相同过滤" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="难度控制&#xa;DeepSeek-Coder-V2-Lite&#xa;每题尝试 10 次&#xa;丢弃 10 / 10 解出的题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpa