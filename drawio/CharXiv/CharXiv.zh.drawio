  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3520" pageHeight="536" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="下载 arXiv 预印本&#xa;8 个学科&#xa;2020年1月–2023年9月&#xa;提取源文件图形" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="重新渲染高分辨率 JPEG&#xa;长边缩放至 1024 px&#xa;保留自然科学图表" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="SigLIP 候选预筛&#xa;余弦相似度 ≥ 0.65&#xa;参照 MathVista 均值&#xa;找出可能的图表" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="研究生执行多样性筛选&#xa;每学科每年份 750 个&#xa;每 10 张选择 1 张" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="成对相似度 ≥ 0.95&#xa;去重近似图表&#xa;删除模糊/标签不清&#xa;保留 2,323 张图表" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="描述题&#xa;19 个模板 • 每图 4 题&#xa;信息提取 • 枚举&#xa;模式识别 • 计数&#xa;组合" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="每图 3 道可答&#xa;+ 1 道不可答&#xa;共 9,292 道开放词表题&#xa;使用模板对应真值答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="推理题 • 每图 1 题&#xa;查看 10 个 GPT-4V&#xa;候选问答&#xa;选择/修改/自写问答" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="要求答案明确且无歧义&#xa;图内文本 / 通用文本&#xa;图内数值 / 通用数值&#xa;无需高级领域知识" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="人类专家核验&#xa;策划图表与问题&#xa;检查真值答案&#xa;确认准确性与可回答性" style="ellipse;html=0;conver