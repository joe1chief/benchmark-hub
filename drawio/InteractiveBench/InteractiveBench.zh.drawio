  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2424" pageHeight="1032" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="主要证据与固定快照&#xa;arXiv:2603.04737v4&#xa;首投 2026-03 · Git caaf091&#xa;论文定义五个独立测试床" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="统一 Horizon-T 交互框架&#xa;Player π ↔ 环境 / 评审器 / 智能体&#xa;各测试床独立定义轮数与终止条件" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="交互式证明&#xa;隐藏真值 + 全知验证器&#xa;在查询预算内最大化任务得分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="交互式博弈&#xa;与其他智能体交互并获得任务奖励&#xa;最大化长期期望效用" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="逻辑 · 46 个情境谜题&#xa;推理与解谜协会专家整理&#xa;筛选：交互必要性 + 歧义可消解性" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="20 轮 Player–Judge 循环&#xa;询问是非问题或提交完整解释&#xa;反馈：是 / 否 / 两者皆有 / 无关&#xa;错误最终答案消耗一次动作&#xa;正确提交立即结束" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="逻辑结果&#xa;预算内准确率&#xa;仅已解题平均轮数&#xa;Grok-4.1-fast 评审 · 温度 0" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="UI2Html · 50 张 UI2Code-Real 截图&#xa;前端专家筛选并重新标注&#xa;布局清晰 · 组件多样 · 视觉复杂 · 可实现" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="160" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="固定 qwen-vl-max 摘要器与评审器&#xa;不完整摘要提供给 Player&#xa;20 轮：完整 HTML + 二元问题&#xa;无头渲染对比隐藏目标&#xa;随后独立提交一次无问题的最终 HTML" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="160" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="UI2Html 结果&#xa;布局 + 组件 + 风格&#xa;文本 + 完成度 · 仅在本域求和" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="160" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="数学 · 52 道 HLE 数学题&#xa;专家保留困难且推理密集的问题&#xa;参考推导 + 最终答案" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="20 轮中间命题 / 最终解答循环&#xa;四类稀疏反馈&#xa;Grok-4.1-fast 评审 · 温度 0&#xa;Pass@k 仅匹配 Player token&#xa;不计评审器 token" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="数学结果&#xa;准确率 + 已解题平均轮数&#xa;对比预算匹配 Pass@k" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="德州扑克环境&#xa;5,000 手牌 · 10 桌 × 500 手&#xa;六个固定智能体 · 初始筹码 10,000&#xa;盲注 50 / 100 · 规则一致" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="结构化不完全观察&#xa;输出合法弃牌 / 过牌 / 跟注 / 加注 / 全押&#xa;非法输出可重试一次 → 自动弃牌" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="跨牌桌扑克结果&#xa;每手收益均值 ± 标准差&#xa;VPIP · 弃牌率 · 响应延迟" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="随机时长信任博弈&#xa;重复囚徒困境收益矩阵&#xa;两两循环赛 + 继续概率 δ&#xa;独立比赛次数 R 未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="收益：CC 2,2 · CD -1,3&#xa;DC 3,-1 · DD 0,0&#xa;观察历史后双方同时选择 C 或 D" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="信任博弈结果&#xa;每轮平均实际收益&#xa;合作率&#xa;对方上一轮合作后的背叛率" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helv