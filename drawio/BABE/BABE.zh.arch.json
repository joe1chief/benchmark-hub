      "type": "process",
      "size": "xl"
    },
    {
      "id": "llm_filter",
      "label": "借助 LLM 移除简单题\n保留研究级实验推理题\n保存明确的相关性标注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "strong_relation",
      "label": "标注强相关题组\nQ1 → Q2 → Q3 顺序依赖\n前题答案是后题必要输入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "weak_relation",
      "label": "标注弱相关题组\n并行独立证据提取\n从同一来源文档读取不同上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 BABE\n研究来源的多模态三题组\n12 个生物子领域 • 强相关 45% / 弱相关 55%",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_eval",
      "label": "评测前沿与开源模型\n综合实验图表与背景上下文\n回答每组三道问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "subset_scores",
      "label": "评分答案正确性\n总体平均 • 强相关子集\n弱相关子集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "multi_trial",
      "label": "运行多次推理\nn = 1、2、4、8\n比较平均分与 Best-of-N 增益",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reasoning_analysis",
      "label": "分析推理行为\n深度推理 • 自我探索\n自我反思与收敛性",
