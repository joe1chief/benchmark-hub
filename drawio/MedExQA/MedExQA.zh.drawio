<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="确定五个代表不足的医学专业&#xa;生物医学工程 · 临床实验室科学&#xa;临床心理学 · 作业治疗&#xa;言语语言病理学" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="人工收集英文多选题&#xa;免费访问的模拟测验与在线考试&#xa;五类职业 · 来源解释用于构建&#xa;保留或改写方式未披露&#xa;60% 及格线仅作描述 · 不作筛选" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="来源溯源边界&#xa;论文未逐题列出来源网址&#xa;原始题量与来源构成未报告&#xa;未报告逐题上游权利审计" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="删除完全重复项&#xa;对问题去重&#xa;对解释去重&#xa;各阶段剔除数量未报告" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="删除语义相似问题&#xa;使用 BERT 表征与余弦相似度&#xa;检查语义近重复&#xa;模型版本与阈值未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="排除法律法规类问题&#xa;使用人工整理的关键词表&#xa;词表与匹配规则未发布&#xa;本阶段剔除数量未报告" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="打乱答案选项&#xa;为合理使用调整原始选项位置&#xa;保持正确答案映射不变&#xa;算法与随机种子未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="每个问答对附两份解释&#xa;采用不同写作风格&#xa;对正确选项给出可理解的推理&#xa;全集解释对相似度为 78.7%" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="人工核验每条记录&#xa;检查问题与两份解释&#xa;确认表达方式不同&#xa;确认医学推理正确且可理解" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="构建审核边界&#xa;解释的撰写或选择方法未说明&#xa;核验人数与资质未报告&#xa;分工、裁决与一致性未报告" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="形成 965 道英文多选题&#xa;生物医学工程 148 · 实验室科学 377&#xa;临床心理学 111 · 作业治疗 194&#xa;言语语言病理学 135" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="在每个专业内划分数据&#xa;开发集：每类 5 道，共 25 道&#xa;测试集：143 + 372 + 106 + 189 + 130 = 940&#xa;除人工评测外，模型评测均使用测试集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="发布数据集与研究资产&#xa;数据集采用 CC BY-NC-SA 4.0 · 仅限非商业&#xa;基于该数据训练的模型仅限研究用途&#xa;未验证可用于临床决策" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="评测 22 个模型条目&#xa;18 个开源基线 + MedPhi-2&#xa;GPT-3.5-1106 · GPT-4-1106 · GPT-4-0125&#xa;零样本 · 批大小 1 · 温度 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="选择评测分支？&#xa;下一词元分类&#xa;或对话式答案加解释" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="下一词元概率分类&#xa;无法取得概率的三个 GPT 接口不参与&#xa;汇集 A · B · C · D 的概率&#xa;选择概率最高的词元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="608" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="生成对话式答案与解释&#xa;发布脚本采用贪心解码&#xa;不采样 · 最多生成 300 个新词元&#xa;将 generated_text 直接交给解析器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="将对话答案解析为 A 至 D&#xa;替换选项文本 · 正则匹配答案句式&#xa;首个独立字母 · thefuzz 兜底&#xa;模糊匹配后不存在弃答状态" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="解析出的选项&#xa;是否等于标准答案？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="计算答案准确率&#xa;逐题精确比较 A 至 D&#xa;分别报告各专业结果&#xa;论文报告五专业宏平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="608" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="评价生成解释&#xa;BLEU · ROUGE-L · METEOR&#xa;通过 evaluate 计算 SciBERT BERTScore&#xa;与两份参考解释比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="832" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="将全部解释指标强制置零&#xa;字符串匹配答案错误时必须执行&#xa;错误答案的推理不能获得部分分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="1048" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="25 道开发题人工评分规则&#xa;三名健康相关专业硕士评审&#xa;0 分：错误 / 缺失 / 无关&#xa;0.5 分：答案对 / 理由有缺陷&#xa;1 分：答案与理由均正确" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="人工评审边界&#xa;未报告题目分配与每题评审人数&#xa;未报告分数聚合方式&#xa;未报告裁决与一致性" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="1392" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="报告评测结果&#xa;答案 · 解释 · 人工评价&#xa;五专业宏平均&#xa;与人工评分的相关系数&#xa;单参考 .9347 · 双参考 .9385" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="发布代码与分母边界&#xa;代码按专业写 CSV；已有 CSV 会直接复用&#xa;未发布解释、人工评测或宏平均流水线&#xa;未规定报错、缺行、版本或双参考归约策略" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#9E9E9E;strokeWidth=1;endArrow=open;endFill=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=3 3;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="" style="edgeStyle=orth