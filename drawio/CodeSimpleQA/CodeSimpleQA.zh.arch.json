    {
      "id": "raw_sources",
      "label": "双语技术语料源\n官方技术文档 · Stack Overflow 讨论\nCommon Crawl 技术文章与 GitHub 仓库",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "content_filter",
      "label": "文档过滤与内容清洗\nFastText 分类器与代码文本比例过滤\n去除 HTML 噪声与跨平台内容去重",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qa_generation",
      "label": "候选问答对合成\nDeepSeek-V3.1 在 T=0.1 下精准采样\n基于技术事实合成 1,500 对候选问答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_consensus_gate",
      "label": "多专家一致性质检门\n8名专业标注员 + 资深软件工程师复核\n要求至少 3 位评审员达成事实一致",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_ambiguous",
      "label": "淘汰争议与模糊题目\n剔除存在事实争议或主观推测的问题\n确保标准答案客观唯一且无可辩驳",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "CodeSimpleQA 冻结基准集\n包含 1,498 对高质量中英双语问答\n覆盖多种主流编程语言与计算机核心领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "双语问答提示装配\n直接问题输入 + 简练事实回答格式约定\n单跳编程知识记忆与事实检索评估",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "模型事实问答推理\n零样本自回归生成知识回答\n模型输出简明事实陈述与关键代码名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fact_verification",
      "label": "事实一致性核验引擎\n正则精确匹配 + LLM-as-a-Judge 语义对齐\n严格检验事实正确性并拦截幻觉回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "事实准确率指标评估\n总体准确率 (Accuracy) 与幻觉率报告\n按编程语言与学科领域分层细粒度评估",
      "type": "terminal",
      "size": "xl"
    }
  ],
