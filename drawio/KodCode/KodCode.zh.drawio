<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3000" pageHeight="1096" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="主要证据与版本边界&#xa;arXiv:2503.02951v2&#xa;Findings ACL 2025&#xa;论文数据集：KodCode-V1&#xa;Git 3a98720：后续 V2 发布代码&#xa;V1 时期 Git 35bcc3d：未证明精确对应" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="合成论文的十二类问题子集&#xa;Prefill · LeetCode&#xa;Codeforces · APPS · TACO&#xa;Code Contests · Algorithm&#xa;Data Structure · Docs · Filter&#xa;Package · Evol" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="在每个子集内部语义去重&#xa;all-mpnet-base-v2 向量&#xa;FAISS 最近邻搜索&#xa;过滤超过预设相似度阈值的问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="GPT-4o-0513 每次重新生成两者&#xa;Python 解答 + Pytest 单元测试&#xa;只有问题作为固定输入&#xa;启动自验证尝试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="执行生成的单元测试&#xa;用每组测试运行配套解答&#xa;通过 pytest-cov 测量分支&#xa;记录每次尝试的通过与覆盖率" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="自验证 · 最多十次尝试&#xa;重试时从头生成解答与测试&#xa;要求测试全过且分支覆盖率 100%&#xa;重试覆盖率不得下降" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="难度标记与失败门禁&#xa;简单：成功率高于 2/3&#xa;中等：1/3 至 2/3 · 困难：低于 1/3&#xa;十次全部失败：丢弃该问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="论文第二步产出 · 279K&#xa;已验证问题—解答—测试三元组&#xa;至少一次尝试通过门禁&#xa;保留简单 · 中等 · 困难标签" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="基于 LLM 的风格转换&#xa;输入问题 + 解答 + 测试&#xa;转为带函数签名与示例的 Python 补全题&#xa;新增 168K 个三元组" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文 KodCode-V1 · 447K&#xa;279K 已验证 + 168K 转换&#xa;问题—解答—测试三元组&#xa;十二子集 · 三种难度标签&#xa;配套测试使数据可用于 RL" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="DeepSeek-R1 回答合成&#xa;使用已验证三元组中的问题&#xa;生成思维链与代码&#xa;每个问题采样三个回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="基于测试的拒绝采样&#xa;在配套测试上执行每个 R1 代码&#xa;仅保留可验证正确的回答&#xa;被拒回答不作为 SFT 正样本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="构建论文 KodCode-SFT&#xa;问题 + 通过测试的 R1 思维链回答&#xa;三次采样并按测试筛选&#xa;与 447K 个 RL 三元组分开" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="固定的后续 HF 公开制品&#xa;RL 97d81f0：训练 484,097&#xa;谨慎使用 3,335&#xa;SFT 26c8a11：训练 268,211&#xa;错误 210,787 + 谨慎使用 4,439&#xa;公开 v1.1 划分不等于论文 447K V1" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="仅为论文 RL 效用实验&#xa;随机 9.5K 训练 + 0.5K 验证&#xa;GRPO · 测试全过得 1，否则得 0&#xa;两个 Qwen2.5 7B 模型 · 并非全部 447K" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="仅为论文 SFT 效用实验&#xa;过滤长度与类实现回答&#xa;50K 混合集 + 全部 18K 困难集&#xa;微调 Qwen2.5-Coder-32B" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="污染分析 · 仅用于评测&#xa;HumanEval · MBPP&#xa;BigCodeBench · LCB V5&#xa;余弦相似度高于 0.95 → 94 个重叠&#xa;仅从评测排除，不从训练数据删除" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="912" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="下游数据效用评测&#xa;HumanEval 与 HumanEval+&#xa;MBPP 与 MBPP+ · BigCodeBench&#xa;LiveCodeBench V5 · 贪心 Pass@1" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="汇报论文数据效用结果&#xa;按基准报告 Pass@1&#xa;分别比较 SFT 与 RL 模型&#xa;94 个重叠仅在此处排除" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;