    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1624" pageHeight="832" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="准备 PDDL 信源&#xa;有生成器时生成领域 / 问题&#xa;ALFWorld：复用官方 PDDL&#xa;13 个规划领域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="生成计划&#xa;优先最高质量规划器&#xa;多样化规划器作为后备&#xa;保留多条有效计划" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="按任务采样&#xa;根据目标任务采样&#xa;计划或中间状态" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="生成任务专用符号问答&#xa;App • Prog • Reach • AReach&#xa;Val • Just • Land • NextA&#xa;Reach / AReach：存疑状态跳过&#xa;保留验证所需材料" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="使用领域模板翻译&#xa;PDDL 事实 / 动作 → 自然语言&#xa;保留事实、计划、代价&#xa