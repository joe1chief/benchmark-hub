  "nodes": [
    {
      "id": "collect",
      "label": "人工收集互联网视频\n时长超过 10 分钟\n保留音频与字幕",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "taxonomy_video",
      "label": "标注并平衡视频内容\n14 个根类 • 171 个二级类 • 638 个三级类\n覆盖多样的 10–80 分钟视频",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review_video",
      "label": "七轮人工视频审核\n检查相关性、质量与多样性\n保留 1,219 个长视频",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "question_taxonomy",
      "label": "定义问题分类体系\n感知 • 推理 • 幻觉\n包含细粒度子类",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "qac",
      "label": "每个视频标注 6–15 个 QAC\n观看完整视频 • 使用母语\n先写问答，再标一个或多个线索区间",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "options",
      "label": "创建多项选择选项\n增加 4–7 个负选项\n在线索区间中保留完整事件",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_qc",
      "label": "人工合理性检查\n审核问题、选项与答案\n拒绝不合理或薄弱条目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "text_qc",
      "label": "GPT-4 纯文本检查\n拒绝无需视频即可回答的问题\n强制依赖视频内容",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "visual_qc",
      "label": "MLLM 视觉难度检查\n拒绝稀疏帧即可回答的条目\n拒绝小模型容易完成的条目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "distribution_qc",
      "label": "线索分布检查\n监控线索时长与时间位置\n保持数据集级多样性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "all_gate",
      "label": "四项检查全部通过？\n人工 AND GPT-4 AND MLLM AND 分布\n任一失败均必须修订",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise",
      "label": "返回标注员\n修订问答、选项或线索区间\n重新进入完整质量门",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 CG-Bench\n1,219 个视频 • 12,129 个 QAC\n14,362 个线索区间",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "mcq",
      "label": "完整视频 / 线索片段 MCQ\n对比长视频与合并线索输入\n报告 long-acc. + clue-acc.",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "white_box",
      "label": "白盒线索定位\n预测一个或多个时间区间\nmIoU • rec.@IoU • acc.@IoU",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "black_box",
      "label": "黑盒可信度\n对比完整视频与仅线索准确率\nCRR = min(long-acc., clue-acc.) / clue-acc.",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_ended",
      "label": "线索辅助开放问答\nGPT-4o 先评文本，再请求视觉线索\n仅从标注区间采样帧",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告准确率、定位与可信度\n按问题类别拆分\n诊断长上下文稀释",
      "type": "terminal",
      "size": "xl"
    }
  ],
