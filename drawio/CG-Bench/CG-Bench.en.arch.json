  "nodes": [
    {
      "id": "collect",
      "label": "Manually Collect Internet Videos\nLonger Than 10 Minutes\nPreserve Audio + Subtitles",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "taxonomy_video",
      "label": "Tag and Balance Video Content\n14 Root • 171 Secondary • 638 Tertiary\nCover Diverse 10–80 Minute Videos",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review_video",
      "label": "Seven Rounds of Manual Video Review\nCheck Relevance, Quality, and Diversity\nRetain 1,219 Long Videos",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "question_taxonomy",
      "label": "Define Question Taxonomy\nPerception • Reasoning • Hallucination\nInclude Fine-grained Subcategories",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "qac",
      "label": "Annotate 6–15 QAC per Video\nWatch Entire Video • Use Native Language\nWrite QA, Then One or More Clue Intervals",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "options",
      "label": "Create Multiple-choice Options\nAdd 4–7 Negative Options\nPreserve Complete Events in Clue Intervals",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_qc",
      "label": "Manual Rationality Check\nInspect Question, Options, and Answer\nReject Illogical or Weak Items",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "text_qc",
      "label": "GPT-4 Text-only Check\nReject Questions Answerable Without Video\nEnforce Video Dependence",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "visual_qc",
      "label": "MLLM Visual-difficulty Check\nReject Sparse-frame-answerable Items\nReject Items Easy for Smaller Models",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "distribution_qc",
      "label": "Clue-distribution Check\nMonitor Clue Duration + Temporal Position\nPreserve Dataset-level Diversity",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "all_gate",
      "label": "All Four Checks Pass?\nManual AND GPT-4 AND MLLM AND Distribution\nAny Failure Requires Revision",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise",
      "label": "Return to Annotators\nRevise QA, Options, or Clue Intervals\nRe-enter the Complete Quality Gate",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Release CG-Bench\n1,219 Videos • 12,129 QAC\n14,362 Clue Intervals",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "mcq",
      "label": "Full-video / Clue-clip MCQ\nCompare Long-video and Merged Clue Input\nReport long-acc. + clue-acc.",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "white_box",
      "label": "White-box Clue Grounding\nPredict One or More Time Intervals\nmIoU • rec.@IoU • acc.@IoU",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "black_box",
      "label": "Black-box Credibility\nCompare Full-video and Clue-only Accuracy\nCRR = min(long-acc., clue-acc.) / clue-acc.",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_ended",
      "label": "Clue-aided Open QA\nGPT-4o Judges Text, Then Requests Visual Clues\nSample Frames Only from Annotated Intervals",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report Accuracy, Grounding, and Credibility\nBreak Down Question Categories\nDiagnose Long-context Dilution",
      "type": "terminal",
      "size": "xl"
    }
  ],
