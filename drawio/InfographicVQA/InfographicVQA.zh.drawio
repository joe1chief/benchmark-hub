  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="712" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="主要证据与稳定发布入口&#xa;arXiv:2104.12756v2&#xa;WACV 2022 · DocVQA / RRC" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="网络图片搜索&#xa;Google + Bing 搜索“infographics”&#xa;下载超过 10,000 张图片" style="ellipse;shape=cloud;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="感知哈希第一轮去重&#xa;移除近 2,000 张重复图片" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="第二轮去重&#xa;Amazon Textract OCR 文本词元&#xa;按 Jaccard 相似度比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="标注候选池&#xa;约 7,000 张多样信息图" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="放弃噪声超过 40% 的众包试点&#xa;内部工具 + 90 分钟讲解 + 测验&#xa;筛选 13 名可密切沟通的标注者" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="第一阶段标注&#xa;可拒绝不适合的图片&#xa;创建问题与答案对&#xa;超过 3 万题后停止" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="按图片随机互斥划分&#xa;约 80% / 10% / 10%&#xa;训练 · 验证 · 测试" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="验证与测试集第二阶段&#xa;由不同标注者独立作答&#xa;不查看首个答案&#xa;可标记“无法回答”" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="标注问答类型&#xa;答案来源四类 · 证据五类&#xa;操作：计数 / 排序 / 算术" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpac