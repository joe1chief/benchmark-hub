<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3584" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义双语长上下文评测&#xa;合成检索与推理任务&#xa;覆盖信息稀疏与信息密集场景&#xa;自适应上下文长度" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="生成合成信息单元&#xa;虚构事实与亲属关系&#xa;随机姓名和模板&#xa;避免真实世界及预训练知识" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择哪种&#xa;信息密度场景？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="稀疏任务填充语料&#xa;英文：Paul Graham 随笔&#xa;中文：领域建模评测语料&#xa;无关文本仅用于稀疏任务" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="实例化三类稀疏任务&#xa;S-RT：单事实检索&#xa;M-RT：多事实检索&#xa;M-RS：2–5 条亲属事实推理" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="在受控深度插入针&#xa;单个或多个关键信息单元&#xa;分散多针输入&#xa;保持目标上下文长度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="遍历官方 V2 配置&#xa;4k · 8k · 32k · 128k&#xa;200k · 256k · 1,000k&#xa;GPT-4 分词器 · 长度缓冲 · R=10" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="运行候选模型&#xa;阅读完整填充文本与问题&#xa;生成任务指定格式答案&#xa;缓冲后仍保留完整指令" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="使用哪种稀疏任务&#xa;输出合同？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="计分 S-RT 与 M-RT&#xa;关键词感知精确匹配&#xa;出现任一核心关键词即满分&#xa;否则为零" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="M-RS：论文与固定代码&#xa;论文：boxed + 关键词感知 EM&#xa;固定：boxed 清洗 + 严格相等&#xa;记录计分差异" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="汇总稀疏任务结果&#xa;各任务平均长度 × 深度 × R&#xa;三项任务等权平均&#xa;S-RT · M-RT · M-RS&#xa;取代早期加权均值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="抽取 n+1 个唯一姓名&#xa;英文或中文姓名池&#xa;组成顺序家庭链&#xa;程序化生成标准答案" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="生成 n 条亲属关系陈述&#xa;随机关系词和语言模板&#xa;代际权重为 1 或 2&#xa;累计总代际距离" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="随机打乱亲属关系&#xa;拼接成连续上下文&#xa;消除位置偏差&#xa;每句话都与答案相关" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="创建四类 ATC 问题&#xa;最年长祖先 · 第 N 代祖先&#xa;第 N 代后代 · 关系距离&#xa;推导精确标准答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="按 2 的幂扩展 ATC&#xa;2 · 4 · 8 · 16 · 32&#xa;64 · 128 · 256 · 512 条针&#xa;每种配置重复 R=10" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="在密集上下文上运行候选模型&#xa;整合每一条亲属关系&#xa;按所选问题类型作答&#xa;最终答案放入 boxed 框" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="已发布 ATC 解析器&#xa;仅提取 boxed 框内答案&#xa;去除 LaTeX · 斜杠 · 引号 · 波浪号&#xa;缺少 boxed 答案时返回 None" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="计算 ATC 精确匹配&#xa;去除预测与答案首尾空白&#xa;要求字符串完全相等&#xa;按针数报告准确率百分比" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2744" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="论文定义的 ATC 指标&#xa;按针数加权准确率&#xa;ENL-50：准确率 ≥50% 的最大 N&#xa;固定 V2：仅逐针数精确分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3024" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="报告长上下文能力&#xa;分别保留稀疏任务和 ATC 结果&#xa;比较语言与上下文长度&#xa;分析连续推理失败" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3304" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="论文与代码边界&#xa;arXiv v3 SHA-256 ae3779…&#xa;OpenCompass 34da831… · Apache-2.0&#xa;V2 代码与配置公开&#xa;Git 中不含 needlebench 数据载荷" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3304" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=