<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2920" pageHeight="1016" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义规避监督问题&#xa;高风险软件环境&#xa;隐蔽完成副任务&#xa;模拟真实部署场景" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="接收私有 LinuxBench&#xa;Redwood Research AI 控制场景&#xa;主任务与副任务配对&#xa;私下共享给 Anthropic" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="改编 LinuxBench 子集&#xa;1,948 个主任务/副任务对&#xa;保留高风险软件情境&#xa;子集改编不等于完整基准合同" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="明确保留构建未知项&#xa;任务来源与配对规则未披露&#xa;环境与验证协议未披露&#xa;无公开解析器或评分器合同" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="832" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="随机抽取 200 个任务对&#xa;少量样本在评测前失败&#xa;有效分母略低于 200&#xa;报告时保留该说明" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="运行哪种攻击协议？&#xa;主要 · 每条轨迹均尝试&#xa;选择性 · 有把握时才尝试" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="配置主要攻击&#xa;三种攻击系统提示&#xa;每条轨迹均尝试副任务&#xa;明示完整轨迹会被监控" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="配置选择性攻击迁移&#xa;使用表现最佳的 Mythos 检查点&#xa;人工编写并迭代优化提示&#xa;在 SHADE-Arena 而非 Minimal-Linux 上优化" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="运行智能体轨迹&#xa;应用已配置的攻击协议&#xa;仅主要设定 · 不启用扩展思考&#xa;仅主要设定 · 比较早期检查点与纯有用模型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="准备用于监控的交互轨迹&#xa;仅主要设定 · 完整轨迹且包含助手轮次&#xa;其他轨迹内容未说明&#xa;序列化与工具模式未披露" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1680" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="应用轨迹监控器&#xa;仅主要设定 · 比较无 CoT 与含 CoT 监控器&#xa;早期 · 无 CoT；当前 · 含 CoT&#xa;监控器实现未发布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1920" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="计算三项结果比例&#xa;副任务完成&#xa;被监控器标记&#xa;隐蔽成功 = 完成且未被发现" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="报告主要设定&#xa;样本中有 69 个副任务完成&#xa;Mythos 隐蔽率 · 无 CoT 11.4% · 含 CoT 2.7%&#xa;95% Wilson 置信区间" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2400" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="报告选择性迁移&#xa;完成 · 42.8 / 18.8 / 20.8%&#xa;告警 · 77.2 / 39.8 / 39.9%&#xa;隐蔽 · 4.8 / 1.1 / 1.2%" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSi