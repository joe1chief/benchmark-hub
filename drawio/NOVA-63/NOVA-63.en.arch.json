      "size": "xl"
    },
    {
      "id": "extraction_gate",
      "label": "Extraction Complete\nand Independently Usable?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_extract",
      "label": "Reject Extraction Failure\nMissing Components or Context\nUnusable Formatting",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "quality_filter",
      "label": "LLM Quality Annotation\nReadability 1–3 · Completeness 0–1\nClarity and Consistency 1–3\nRecord Scores with Reasons",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality_gate",
      "label": "At Maximum on Every Criterion?\nReadability 3 · Completeness 1\nClarity and Consistency 3",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_quality",
      "label": "Reject Quality Failure\nMissing Media or Context\nPoor Readability or Ambiguity",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "classify",
      "label": "Add Multi-faceted Metadata\n13 Primary · 63 Secondary · 262 Tertiary\nHierarchical Closest-match Classification\nRecitation-based or Reasoning-based",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_panel",
      "label": "Difficulty Model Panel\nChat and Reasoning Models\nSmall ≤14B · Large >14B\nZero-shot · Seed 42 · Temperature 0",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_annotation",
      "label": "Run Model Difficulty Annotation\nRecord Correctness and Chosen Options\nParse JSON then Answer-based Fallbacks\nDrop Explicit Multimedia Questions",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "difficulty_gate",
      "label": "Large-model Accuracy\nBelow 50%?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_easy",
      "label": "Reject Insufficient Difficulty\nLarge-model Accuracy ≥50%",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "abnormal_gate",
      "label": "Suspicious Pattern?\nSmall > Large or Concentrated Wrong Option\nNative Expert Review",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "manual_validation",
      "label": "Native Expert Manual Validation\nCheck Language · Ambiguity · Missing Media\nVerify Reference Answer\nRelevant Postgraduate Expertise",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "validation_gate",
      "label": "Final Appendix Threshold\nor Review Error?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_abnormal",
      "label": "Reject Suspicious Item\nAppendix Threshold Rules or\nNative Review Finds an Error",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "selected_pool",
      "label": "Initial Difficult Valid Pool\nCoordinate Counts at\nSecondary-discipline Level",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "supplement_gate",
      "label": "Secondary-discipline\nPool Needs Supplementation?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "qa_conversion",
      "label": "Convert Selected QA to MCQ\nJudge Model Answers against Gold\nUse Common Model Errors as Distractors\n2,425 Converted Questions",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "conversion_rescreen",
      "label": "Reapply All Earlier Standards\nQuality and Difficulty Screening\nManually Review Every Conversion\nCheck Native Fluency and Translationese",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "interdisciplinary",
      "label": "Reassign Interdisciplinary Questions\nLLM Judges Potential Overlap\nMove Item to the Smaller Pool\nBalance Secondary Disciplines",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_review",
      "label": "Final Manual Review\nDiscipline Relevance · Text Quality\nMachine-translation Artifacts\nCompleteness and Obvious Logic Errors",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_gate",
      "label": "Pass Every Final\nReview Criterion?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_final",
      "label": "Reject Final-review Failure\nLow Relevance or Quality\nTranslation Artifact or Incompleteness",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "balance",
      "label": "Balance Language × Secondary Discipline\nMaintain at Least 50 Questions\nCap at 150 Questions\nRandomly Sample Any Excess",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "NOVA-63 Paper Benchmark\n89,107 Native MCQs · 14 Languages\nEight Families · 63 Secondary Disciplines\n50–150 per Language-discipline Cell",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "Evaluate 62 LLMs\nChat/Reasoning: Zero-shot Answer Ending\nBase: Five-shot Option Probabilities\nBase Samples Reused within a Discipline",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "Report Exact-option Accuracy\nQuestion · Secondary · Primary Averages\nMain Result Uses Primary-discipline Mean\nAvoid Overweighting Larger Disciplines",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "publication_boundary",
