  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2184" pageHeight="1616" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="母语者采集本地题目&#xa;教育网站 · 学术出版物 · 考试&#xa;中学至研究生层级&#xa;验证母语与文化真实性" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="LLM 上下文学习格式规范化&#xa;提取题干 · 选项 · 答案&#xa;同时分类为选择题或问答题&#xa;去除 HTML 与无关内容" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="抽样人工核验提取质量&#xa;检查多媒体过滤与原文保留&#xa;检查完整性与格式&#xa;不是逐题人工关卡" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="提取完整且可&#xa;独立作答吗？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="淘汰提取失败项&#xa;缺少组件或上下文&#xa;格式不可用" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="LLM 质量标注&#xa;可读性 1–3 · 完整性 0–1&#xa;清晰度与一致性 1–3&#xa;评分并给出理由" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="每项质量指标都达到最高分吗？&#xa;可读性 3 · 完整性 1&#xa;清晰度与一致性 3" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="淘汰质量失败项&#xa;缺少媒体或上下文&#xa;可读性差或含歧义" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="添加多维元信息&#xa;13 个一级 · 63 个二级 · 262 个三级学科&#xa;分层选择最接近类别&#xa;识记型或推理型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="难度评估模型组&#xa;对话与推理模型&#xa;小模型 ≤14B · 大模型 &gt;14B&#xa;零样本 · 种子 42 · 温度 0" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行模型难度标注&#xa;记录正误与所选选项&#xa;先解析 JSON 再按答案文本兜底&#xa;淘汰显式依赖多媒体的题目" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="大模型准确率&#xa;低于 50% 吗？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="淘汰难度不足项&#xa;大模型准确率 ≥50%" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="难度模式可疑吗？&#xa;小模型更高或错误选项答案集中&#xa;交由母语专家复核" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="母语专家人工核验&#xa;检查语言 · 歧义 · 缺失媒体&#xa;验证参考答案&#xa;需具备相关研究生专业背景" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="触发附录最终阈值&#xa;或复核发现错误吗？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="淘汰可疑题目&#xa;触发附录阈值规则或&#xa;母语复核发现错误" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="初始高难有效题池&#xa;在二级学科层面&#xa;统计和协调题量" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="二级学科题池&#xa;需要补充吗？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="将选定问答题转为选择题&#xa;对照标准答案判定模型回答&#xa;用常见模型错误构造干扰项&#xa;共转换 2,425 道题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="重新应用此前全部标准&#xa;再做质量与难度筛选&#xa;每道转换题都人工复核&#xa;检查母语流畅度与翻译腔" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="重分配跨学科题目&#xa;LLM 判断潜在学科交叉&#xa;将题目移入较小题池&#xa;平衡二级学科分布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="最终人工复核&#xa;学科相关性 · 文本质量&#xa;机器翻译痕迹&#xa;完整性与明显逻辑错误" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="所有最终复核&#xa;标准都通过吗？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="淘汰最终复核失败项&#xa;相关性或质量低&#xa;有翻译痕迹或不完整" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="1048" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="平衡语言 × 二级学科&#xa;至少保留 50 道题&#xa;上限设为 150 道题&#xa;超出上限时随机采样" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="NOVA-63 论文基准&#xa;89,107 道母语选择题 · 14 种语言&#xa;8 个语系 · 63 个二级学科&#xa;每个语言-学科单元 50–150 道" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="评测 62 个 LLM&#xa;对话/推理模型：零样本结尾答案&#xa;基座模型：五样本选项概率&#xa;同学科内复用示例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="报告精确选项准确率&#xa;题目 · 二级学科 · 一级学科平均&#xa;主结果采用一级学科均值&#xa;避免大规模学科权重过高" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="31" value="论文与发布边界&#xa;ACL PDF SHA-256 630e3a… 报告 89,107&#xa;ACL 网页摘要当前写 93,536&#xa;HF 修订 7bfc985… 仅含 README&#xa;MIT 数据卡注明数据仍在评审" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;stroke