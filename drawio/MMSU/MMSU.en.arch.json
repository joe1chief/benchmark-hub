  "nodes": [
    {
      "id": "evidence",
      "label": "Freeze Primary Evidence\nPaper · arXiv 2506.04779v3\nOfficial Repo · 217d1d3f\nHF Dataset · 548e2283\nAudit Exact Revisions",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "framework",
      "label": "Stage 1 · Linguistic Framework\nConsult Linguistics Experts\nSix Named Subfields\nDefine 47 Spoken-language Tasks",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "questions",
      "label": "Stage 2 · Curate MCQs\nAuthoritative Linguistics Textbooks\nSupplement with Online Sources\nPreserve Linguistic Phenomena",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "options",
      "label": "Expert-in-the-loop Augmentation\nExpertise-guided Prompts\nGPT-4o Generates Candidate Options\nHuman Review Applies Later",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "source_route",
      "label": "Stage 3 · Match Audio Sources\nPrefer Authentic Recordings\nFill Phonology / Semantic Gaps\nPreserve Source-type Accounting",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_audio",
      "label": "Open-source Audio\n3,837 Clips · 76.74%\nNamed Source Sets in Appendix B\nMajority of Benchmark Audio",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "custom_audio",
      "label": "Custom Recordings\n672 Clips · 13.44%\nProfessional Actors for Phonology Gaps\nPlus 15 Diverse Real Speakers",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "synthetic",
      "label": "Synthetic Supplement\n491 Clips · 9.82%\nAzure Multi-voice TTS\n20 Selected Voices",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "merge_audio",
      "label": "Align Audio + Text + MCQ\nPreserve Task / Source Context",
      "type": "process",
      "size": "s"
    },
    {
      "id": "pair_review",
      "label": "Stage 4 · Paired Human Review\nFive Groups · Two Annotators Each\n1,000 Items per Pair\nIndependently Apply Four Criteria",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "pair_gate",
      "label": "Both Annotators Approve the Item?\nMulti-Criteria Quality & Validation Gate\nThreshold-Based Verification Criterion",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise",
      "label": "Resolve Flagged Item\nFilter Low-quality / Ambiguous Samples\nOr Re-record / Rewrite / Modify Choices\nOnly Retained Revisions Return",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cross_review",
      "label": "Cross-pair Review Rounds\nFirst Pass Covers All 5,000\nShuffle Whole Dataset\nReassign Each 1,000 to Different Pair",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "objection_gate",
      "label": "Further Objections after This Round?\nMulti-Criteria Quality & Validation Gate\nThreshold-Based Verification Criterion",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise_round",
      "label": "Revise and Re-evaluate\nRepeat Shuffled Review\nPaper Reports 2–3 Rounds",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "expert_final",
      "label": "Expert + Team Final Review\nThree Linguistics Experts\nValidate Linguistic Alignment\nNo More Than 20 Minor Adjustments",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "Assemble MMSU v3\n5,000 MCQs · 47 Tasks\nPerception 2,580 · Reasoning 2,420\nMean Audio Length · 7.01 Seconds",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "Public Release Boundary\nHF 548e2283 · Public / Ungated\nOne Train Split · 5,000 Rows\n13 Fields · Dataset Card MIT",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "construction_gaps",
      "label": "Undisclosed Construction Details\nSource Dataset Revisions / Sampling\nGPT-4o Snapshot / Decoding\nCandidate and Rejection Counts\nPer-item Provenance / Rights Mapping",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "evaluator_boundary",
      "label": "Paper-to-code Boundary\nPaper Does Not Specify Response Parser\nCurrent Code Added in February 2026\nDataset Download Has No Revision Pin\nModel Integration / Decoding Left to User",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_eval",
      "label": "Paper-v3 Evaluation\n22 Models · 12 SpeechLLMs + 10 OmniLLMs\nRandomized, Balanced A–D Positions\nSame Optimized Prompt across Models",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "repo_infer",
      "label": "Current Official Inference Scaffold\nFixed “Only A, B, C, or D” Prompt\nUser Supplies Model Implementation\nWrite Response + Dataset Fields to JSONL",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "load_jsonl",
      "label": "Load Supplied JSONL Rows\nMalformed JSON Lines Are Skipped\nNo 5,000-ID Completeness Check\nDuplicate / Unknown Rows Are Not Joined",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "first_gate",
      "label": "First Character Is Uppercase A–D?\nMulti-Criteria Quality & Validation Gate\nThreshold-Based Verification Criterion",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "second_gate",
      "label": "Length > 1 and Second-last Is A–D?\nMulti-Criteria Quality & Validation Gate\nThreshold-Based Verification Criterion",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "compare_gate",
      "label": "Compare Selected Choice with answer_gt\nExact Match → Item Contribution 1\nMismatch → Item Contribution 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "invalid_gate",
      "label": "Empty Response or Literal “None”?\nMulti-Criteria Quality & Validation Gate\nThreshold-Based Verification Criterion",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "skipped",
      "label": "Skip Row Entirely\nNonempty Malformed Format\nResponse Normalization Exception\nExcluded from Denominator",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "Compute Micro Accuracy\nPer Category + Sub-category\nPer-category Mean and Overall\nDenominator Follows Accepted Rows",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report MMSU Accuracy\nPerception / Reasoning Breakdowns\nSemantics · Phonology · Paralinguistics\nPaper Human Baseline · 1,000 Items",
      "type": "terminal",
      "size": "xl"
    }
  ],
