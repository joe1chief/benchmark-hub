lor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2704" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="专家 + 团队最终复核&#xa;三名语言学专家&#xa;检查语言学现象对齐&#xa;最多做 20 处轻微调整" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2976" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="汇总 MMSU v3&#xa;5,000 道选择题 · 47 项任务&#xa;感知 2,580 · 推理 2,420&#xa;平均音频时长 · 7.01 秒" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3248" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="公开发布边界&#xa;HF 548e2283 · 公开 / 无门槛&#xa;单一 train 划分 · 5,000 行&#xa;13 个字段 · 数据卡 MIT" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="未披露的构建细节&#xa;来源数据版本 / 抽样方法&#xa;GPT-4o 快照 / 解码设置&#xa;候选与淘汰数量&#xa;逐条来源 / 权利映射" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="论文到代码的边界&#xa;论文未规定回答解析