    {
      "id": "source_evidence",
      "label": "固定官方证据\narXiv 2605.03546v1\nPDF 87c67873f06f\nGit v1.2.4 963063c9271c\nHF de0ddfb63759",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "candidate_repositories",
      "label": "识别候选开源仓库\n要求可构建独立程序\n优先编译型语言项目\n覆盖多种软件领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "collection_agent",
      "label": "标准化采集智能体\nmini-SWE-agent 框架\nClaude Sonnet 4.5\nUbuntu 22.04 Docker 容器",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold_build",
      "label": "构建标准可执行程序\n编译原始源代码\n验证程序能够运行\n记录单一可复现构建脚本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "behavior_sources",
      "label": "探索行为证据源\n用多样输入探测标准程序\n阅读源码、测试与文档\n收集现有行为测试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generate_tests",
      "label": "生成行为测试\n使用 Pytest 测试框架\n断言输出、退出状态与文件效果\n避免依赖源码内部实现",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "coverage_loop",
      "label": "按覆盖率扩充测试\n测量第一方代码行覆盖率\n定向覆盖缺失代码路径\n迭代达到覆盖率目标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "assertion_linter",
      "label": "检查断言质量\n标记仅退出码检查\n标记短子串与或式逻辑\n提示智能体修复测试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "validation_gate",
      "label": "应用标准程序与虚假程序过滤\n要求标准程序确定性通过\n拒绝虚假程序也能通过的测试\n修订或丢弃剩余失败测试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sanitize_documentation",
      "label": "清理使用文档\n保留用户可见接口\n删除源代码与原始测试\n删除实现细节",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "cleanroom_image",
      "label": "构建洁净任务镜像\n注入只可执行标准程序\n使用独立全新镜像\n加入文档与必需测试资产",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "paper_release",
      "label": "完成论文口径 ProgramBench\n200 个开源程序任务\n248,853 个行为测试函数\n每任务测试中位数为 770",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "candidate_inputs",
      "label": "公开候选侧可见输入\n只可执行标准程序\n清理后文档与必需资产\n行为测试始终隐藏",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "policy_prompt",
      "label": "强制执行黑盒规则\n禁止源码查找与联网\n禁止封装标准程序\n禁止反编译与跟踪",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agent_run",
      "label": "运行软件智能体\nmini-SWE-agent · 任意语言\n20 核 CPU · 60 GB 内存\n最多 1,000 步与 6 小时",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "submission",
      "label": "打包候选代码仓库\n提交全部编写的源代码\n根目录提供 compile.sh\n打包为 submission.tar.gz",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "clean_eval_image",
      "label": "启动评测镜像\n解包至洁净工作区\n删除与标准程序哈希相同的文件\n编译期间阻断网络",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "compile_submission",
      "label": "编译候选程序\n执行 chmod 与 compile.sh\n产出候选可执行程序\n构建失败即停止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "branch_selection",
      "label": "选择测试分支\n读取 tests.json 元数据\n保留未忽略的分支\n从 HF 下载分支数据包",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hidden_pytest",
      "label": "运行隐藏行为 Pytest\n执行每个选中分支\n比较标准程序的外部行为\n生成 JUnit XML 结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "junit_parser",
      "label": "解析 JUnit 测试结果\n映射通过、失败与错误\n将缺失预期测试标为未运行\n检测互相冲突的重复结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ignored_test_filter",
      "label": "应用逐测试排除规则\n移除 tests.json 忽略项\n将意外结果保留为警告\n非通过状态均视为未解决",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "instance_score",
      "label": "计算每个任务分数\n测试通过率为通过数除以有效测试\n仅全部测试通过才算解决\n保留部分进展分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cheating_review",
      "label": "应用论文作弊门\n检查完整轨迹与代码库\n检测源码查找或程序封装\n严格多数评判即标记",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "headline_metrics",
      "label": "报告基准指标\n解决率：全部测试通过且无作弊\n每任务测试通过率\n近乎解决率：至少通过 95%",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_drift_boundary",
      "label": "固定 v1.2.4 计数漂移\nGit：201 个任务目录（含计算器夹具）\n313,292 列出 · 65,845 忽略\n247,447 个有效计分名\n论文：200 任务 · 248,853 测试函数",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "license_boundary",
      "label": "发布许可边界\nGit 评测代码采用 MIT\nHF 测试数据卡采用 MIT\n每任务保留上游许可证\nHF 含 200 个任务目录",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "construction_boundary",
      "label": "构建发布边界\n论文注明智能体、模型与镜像\n按功能描述提示\n未公开完整构建流水线代码\n公开 Git 以评测器为主",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "prompt_boundary",
      "label": "推理提示边界\n附录给出完整行为规则\n公开评测器不绑定智能体框架\n基线智能体运行器位于外部\n不臆造隐藏设置",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "cheating_boundary",
      "label": "作弊评判边界\n每次运行由 9 个模型评判\n3 个 GPT-5.2 · 3 个 Sonnet 4.5\n3 个 Gemini 3.1 Pro · 5 票即多数\n公开评测 CLI 未实现此流程",
      "type": "document",
      "size": "xl"
    }
