<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3064" pageHeight="1296" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2605.03546v1&#xa;PDF 87c67873f06f&#xa;Git v1.2.4 963063c9271c&#xa;HF de0ddfb63759" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="识别候选开源仓库&#xa;要求可构建独立程序&#xa;优先编译型语言项目&#xa;覆盖多种软件领域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="标准化采集智能体&#xa;mini-SWE-agent 框架&#xa;Claude Sonnet 4.5&#xa;Ubuntu 22.04 Docker 容器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="构建标准可执行程序&#xa;编译原始源代码&#xa;验证程序能够运行&#xa;记录单一可复现构建脚本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="探索行为证据源&#xa;用多样输入探测标准程序&#xa;阅读源码、测试与文档&#xa;收集现有行为测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="生成行为测试&#xa;使用 Pytest 测试框架&#xa;断言输出、退出状态与文件效果&#xa;避免依赖源码内部实现" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="按覆盖率扩充测试&#xa;测量第一方代码行覆盖率&#xa;定向覆盖缺失代码路径&#xa;迭代达到覆盖率目标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="检查断言质量&#xa;标记仅退出码检查&#xa;标记短子串与或式逻辑&#xa;提示智能体修复测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="应用标准程序与虚假程序过滤&#xa;要求标准程序确定性通过&#xa;拒绝虚假程序也能通过的测试&#xa;修订或丢弃剩余失败测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="清理使用文档&#xa;保留用户可见接口&#xa;删除源代码与原始测试&#xa;删除实现细节" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="构建洁净任务镜像&#xa;注入只可执行标准程序&#xa;使用独立全新镜像&#xa;加入文档与必需测试资产" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="完成论文口径 ProgramBench&#xa;200 个开源程序任务&#xa;248,853 个行为测试函数&#xa;每任务测试中位数为 770" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="公开候选侧可见输入&#xa;只可执行标准程序&#xa;清理后文档与必需资产&#xa;行为测试始终隐藏" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="强制执行黑盒规则&#xa;禁止源码查找与联网&#xa;禁止封装标准程序&#xa;禁止反编译与跟踪" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="运行软件智能体&#xa;mini-SWE-agent · 任意语言&#xa;20 核 CPU · 60 GB 内存&#xa;最多 1,000 步与 6 小时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="打包候选代码仓库&#xa;提交全部编写的源代码&#xa;根目录提供 compile.sh&#xa;打包为 submission.tar.gz" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="启动评测镜像&#xa;解包至洁净工作区&#xa;删除与标准程序哈希相同的文件&#xa;编译期间阻断网络" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="编译候选程序&#xa;执行 chmod 与 compile.sh&#xa;产出候选可执行程序&#xa;构建失败即停止" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="选择测试分支&#xa;读取 tests.json 元数据&#xa;保留未忽略的分支&#xa;从 HF 下载分支数据包" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="运行隐藏行为 Pytest&#xa;执行每个选中分支&#xa;比较标准程序的外部行为&#xa;生成 JUnit XML 结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="解析 JUnit 测试结果&#xa;映射通过、失败与错误&#xa;将缺失预期测试标为未运行&#xa;检测互相冲突的重复结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="应用逐测试排除规则&#xa;移除 tests.json 忽略项&#xa;将意外结果保留为警告&#xa;非通过状态均视为未解决" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="计算每个任务分数&#xa;测试通过率为通过数除以有效测试&#xa;仅全部测试通过才算解决&#xa;保留部分进展分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="应用论文作弊门&#xa;检查完整轨迹与代码库&#xa;检测源码查找或程序封装&#xa;严格多数评判即标记" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="报告基准指标&#xa;解决率：全部测试通过且无作弊&#xa;每任务测试通过率&#xa;近乎解决率：至少通过 95%" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="固定 v1.2.4 计数漂移&#xa;Git：201 个任务目录（含计算器夹具）&#xa;313,292 列出 · 65,845 忽略&#xa;247,447 个有效计分名&#xa;论文：200 任务 · 248,853 测试函数" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="发布许可边界&#xa;Git 评测代码采用 MIT&#xa;HF 测试数据卡采用 MIT&#xa;每任务保留上游许可证&#xa;HF 含 200 个任务目录" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="构建发布边界&#xa;论文注明智能体、模型与镜像&#xa;按功能描述提示&#xa;未公开完整构建流水线代码&#xa;公开 Git 以评测器为主" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="推理提示边界&#xa;附录给出完整行为规则&#xa;公开评测器不绑定智能体框架&#xa;基线智能体运行器位于外部&#xa;不臆造隐藏设置" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="31" value="作弊评判边界&#xa;每次运行由 9 个模型评判&#xa;3 个 GPT-5.2 · 3 个 Sonnet 4.5&#xa;3 个 Gemini 3.1 Pro · 5 票即多数&#xa;公开评测 CLI 未实现此流程" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeo