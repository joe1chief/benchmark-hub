  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4384" pageHeight="784" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据边界&#xa;arXiv 2406.16855v2&#xa;仓库 66ca27e5&#xa;HF 版本 459b0649&#xa;data.zip 提交 d5b0c8a2" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="候选主体关键词&#xa;GPT-4o 生成 200&#xa;Unsplash 热词 200&#xa;去重后由 7 位标注员扩展&#xa;扩展后约 300 个关键词" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="获取候选参考图&#xa;Unsplash · Rawpixel&#xa;Google 搜索&#xa;获授权个人贡献&#xa;核验学术使用版权状态" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="SAM 自动筛选&#xa;移除主体面积过小的图像" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="7 位标注员质量控制&#xa;移除噪声背景和 NSFW&#xa;裁剪并居中主体&#xa;每个关键词保留两张图&#xa;丢弃无合适图像的关键词" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="补强非写实风格&#xa;动漫 · 素描 · 国画&#xa;艺术作品 · 游戏卡通&#xa;平衡主体类别与图像风格" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="GPT-4o 每图生成 9 个提示&#xa;PartiPrompts 少样本 · 人工校准&#xa;写实 4 + 非写实 3 + 想象 2&#xa;600 + 450 + 300 = 1,350 个提示" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="核心发布集 · 150 张图&#xa;动物 45 · 人物 20 · 物体 65&#xa;风格 20 · 写实 120 + 非写实 30&#xa;150 个说明文件 · 每图 9 个提示" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="发布边界&#xa;无训练、验证或测试划分&#xa;输出与评分存于未版本化 Drive&#xa;不属于固定 HF 核心集" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文评测的七种方法&#xa;TI · DB · DB-LoRA&#xa;BLIP-Diffusion · Emu2&#xa;IP-Adapter Plus-H · ViT-G&#xa;SD1.5 / SDXL" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="1,350 × 7 = 9,450 张目标输出&#xa;默认 100 步 · 引导系数 7.5&#xa;Emu2：50 步 · 引导系数 3&#xa;IP-Adapter 比例 0.6 · 种子 42" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="人工编写 CP / PF 元提示&#xa;任务 · 量表 · 原始 0–4 · 格式&#xa;GPT-4o-2024-05-13&#xa;温度 1 · 最多重试 3 次" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="静态总结规划 assistant prefill&#xa;每个实例一次评分调用&#xa;非动态两次调用规划" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="两个独立评分维度&#xa;CP：参考图 + 生成图&#xa;PF：文本 + 生成图" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3064" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="概念保持&#xa;主体：形状 · 颜色 · 纹理 · 面部&#xa;风格：色调 · 笔触 · 纹理&#xa;风格表现" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3320" y="40" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="提示遵循&#xa;相关性 · 准确性&#xa;完整性 · 上下文&#xa;不输入参考图" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3320" y="360" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="每个维度原始 0–4 分&#xa;报告均值 / 4，映射到 0–1&#xa;full / full2 / full3 三次运行&#xa;汇总均值 ± 标准差" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3584" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="独立人工评分&#xa;7 位受训标注员 · 同一量表&#xa;GPT 与人工评分隔离&#xa;每个实例至少 2 个人工评分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3584" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="区间 Krippendorff alpha&#xa;H-H 按方法及 CP / PF 计算&#xa;G-H = 各人工组结果均值&#xa;Pearson 分开报告" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3840" y="280" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="指标对齐报告&#xa;比较 GPT-4o、DINO、CLIP-I/T&#xa;alpha / Pearson 属于验证分析&#xa;不是逐图基准得分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4104" y="280" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;round