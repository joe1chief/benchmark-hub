  "nodes": [
    {
      "id": "step_1",
      "label": "定义高难PDF基准\n测试忠实文本线性化\n覆盖结构与自然阅读顺序\n避免依赖完整参考转录",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "收集七类文档来源\narXiv数学 · 老扫描数学 · 表格\n老扫描 · 页眉页脚\n多栏 · 长篇微小文字",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "应用发布资格过滤\n移除包含个人信息的文档\n移除不可公开传播文件\n保留来源信息",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "与训练数据去污染\n对照olmOCR-mix-0225\n按benchmark PDF URL去重\n隔离评测文档",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "按来源编写单元测试\n人工标注公式与扫描件\nLLM起草表格与版式检查\n脚本编码阅读顺序检查",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "人工核验每项测试\n检查页面证据与触发条件\n使用KaTeX验证公式\n复核生成与拆分测试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "发布1,403份PDF与7,010项测试\n存在721 · 缺失823\n阅读顺序1,061 · 表格1,020\n数学公式3,385",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "运行各OCR系统\n处理全部benchmark PDF\n输出Markdown或纯文本\n保持自然阅读顺序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "规范化OCR输出\n规范空白与Markdown强调\n规范引号与连字符\n应用Unicode NFC",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "应用基线健全性测试\n要求含字母或数字内容\n拒绝结尾超过30的n-gram循环\n拒绝未标记的中日韩字符或Emoji",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "测试文本存在与缺失\n定位必须出现的文本片段\n拒绝不应出现的页眉页脚\n执行位置条件",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "测试结构与关系\n自然阅读顺序\n表格单元格关系\n公式符号与边界框关系",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "计算二元结果\n每项单元测试通过或失败\n按PDF来源计算通过率\n保留来源级诊断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告最终基准分数\n对文档来源做宏平均\nBootstrap 95%置信区间\n一致比较各OCR系统",
      "type": "terminal",
      "size": "xl"
    }
  ],
