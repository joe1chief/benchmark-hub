  "nodes": [
    {
      "id": "step_1",
      "label": "定义语言引导指向任务\n输入RGB图像与文本查询\n预测目标坐标点\n不依赖框评估视觉落点",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "收集近期公开图像\n使用2025-04-20后发布图像\n降低模型数据暴露可能\n保留多样真实场景",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "均衡五类任务\n空间 · 可供性 · 计数\n可操纵 · 推理\n匹配各类特定场景需求",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "众包编写自然查询\n向标注者展示抽样图像\n编写符合类别的请求\n可操纵类避免显式物体名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "探测查询难度\n询问三个匿名多模态模型\n评测每条候选查询\n把输出交给人工评审",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "保留高难有效查询\n人工评审核实正确性\n至多允许一个模型答对\n剔除简单或歧义问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "标记目标点\n标注者识别全部目标\n在预期物体上放置点\n保留目标数量",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "生成初始目标掩码\n用标注点提示SAM\n分割预期目标物体\n产生二元掩码候选",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "人工细化掩码\n编辑错误掩码区域\n移除非预期部分\n让每个掩码对齐目标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "独立核验掩码\n使用另一组标注者\n检查目标覆盖与边界\n修正剩余标注错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "发布982组图文样例\n保存查询与目标掩码\n保留五类标签\n保留计数目标数量",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "运行标准零样本指向\n要求输出x-y坐标格式\n每条查询预测K个点\n非计数任务要求一个点",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "应用二元成功标准\n要求K等于目标数K星\n每个掩码至少被一点覆盖\n非计数多输出时仅取第一点",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告Point-Bench成功率\n16个模型评测全部982组\n运行三次独立试验\n汇总五类均值与标准差",
      "type": "terminal",
      "size": "xl"
    }
  ],
