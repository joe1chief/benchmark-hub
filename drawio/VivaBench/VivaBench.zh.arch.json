    {
      "id": "medqa",
      "label": "MedQA 与临床病例文献库\nUSMLE 执业医师考试与医学院教材病例\n交互式临床模拟的基础题干来源",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "pubmed",
      "label": "PubMed 生物医学文献数据库\n临床病例报告与同行评审病案\n循证医学诊断验证的文献知识库",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "screen",
      "label": "临床病例合规性初筛\n过滤具备完整诊疗轨迹的高质量病案\n剔除病因模糊或多重原发混杂病例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "structure_case",
      "label": "临床本体与 Schema 结构化\n解构为病史、体格检查、影像学与检验四大模块\n分级病例规范化数据模式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "codes",
      "label": "医学术语标准化编码\nSNOMED-CT 临床概念与 LOINC 检验编码\n对齐 ICD-10 国际疾病分类体系",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "diagnosisRoute",
      "label": "诊断实体解析判定\n验证金标准诊断是否可由机器直接提取\n分流至自动解析或人工专家标注分支",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "autoParse",
      "label": "自动化诊断实体抽取\n基于规则与命名实体识别流水线\n将候选诊断词条映射至标准医学本体",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "expertAnnotate",
      "label": "专科医师人工诊断标注\n执业医师手动解析疑难与非结构化表述\n标准化鉴别诊断与确定性诊断集",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "complete",
      "label": "临床专家补全隐式证据\n专科医生补充病案未明示的必要阴性所见\n确保交互模拟符合真实循证诊断常理",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "physicianGate",
      "label": "资深主任医师临床复核门槛\n审查医学真实性、逻辑连贯性与题干自洽度\n通过合规病例，不达标者退回修订",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reviseCase",
      "label": "临床病例文本重构与修订\n消除术语歧义与检验指标冲突\n由临床医生再次校验结构完整性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "VivaBench 正式验证基准发布\n官方 HuggingFace 快照：990 例经临床复核病例\n全量 1,952 条生成的结构化候选病例库",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "initialStem",
      "label": "患者初始就诊主诉题干\n患者基本信息、主诉与急诊初诊表现\n输入给 LLM 智能体的初始交互提示",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "hpQuery",
      "label": "审视阶段：病史与体检交互问诊\n智能体多轮主动询问既往史、现病史与体格检查\n多轮对话式获取基础临床信息",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hpGate",
      "label": "病史与查体信息充分性判定\n评估当前信息是否足以支撑提出初步鉴别诊断\n决定继续追问或进入初步诊断提交",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "moreHp",
      "label": "针对性病史与查体深入追问\n追问具体症状发作时长、加重诱因及伴随体征\n累加交互轮次并记录信息检索轨迹",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "provisional",
      "label": "初步鉴别诊断提交 (dP)\n基于病史查体生成的 Top-k 候选诊断与归一化置信度\n不含辅助检查证据的初诊推理评估点",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "ilQuery",
      "label": "检验阶段：申请影像与实验室检查\n智能体开具针对性血液生化、病理与影像学检查单\n交互式查询引擎返回对应的检查检验结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ilGate",
      "label": "检查检验充分性评估决策\n评估辅助检查结果是否足以支持确诊或排除诊断\n继续追加检查或锁定最终诊断",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "moreIl",
      "label": "追加后续针对性辅助检查\n开具进一步确诊影像、基因检测或组织活检\n跟踪检查利用效率并计入诊断成本惩罚",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "finalDiagnosis",
      "label": "交互式最终诊断结论 (dD)\n结合全流程问诊与检查证据得出的最终 Top-k 诊断\n综合病史、查体与支持性辅助检查的决策终点",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "fullInfo",
      "label": "完整信息非交互对照诊断 (dF)\n单轮全量信息输入下的基准诊断上限对照\n一次性提供病史、查体与全部辅助检查文本",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "metricRouter",
      "label": "诊断评测指标分流路由\n分流至 Top-k 准确率、置信度分数 Sconf 与检索 P/R\n分别独立计算 dP、dD 与 dF 各阶段指标",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "relevantIxGate",
      "label": "单预测逐项诊断匹配门槛\n将预测诊断与支持性辅助检查结果进行成对校验\n分类为精确匹配 (E)、近似匹配 (A) 或未匹配 (U)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "topk_accuracy",
      "label": "交互式 Top-k 诊断准确率\n评估 dP 与 dD 阶段的 Top-k (k=1..5) 预测表现\n分别独立统计精确匹配与近似匹配准确率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sconf",
      "label": "置信度加权诊断得分 Sconf\n归一化模型预测置信度分布 (sum c'=1)\n公式：Sconf = sum(E) c' + sum(A) c' - sum(U) c'",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "queryPr",
      "label": "信息检索精确率与召回率 (P/R)\n评估病史查体与辅助检查查询的针对性与有效性\n计算匹配诊断依据对完整证据链的覆盖比例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "VivaBench 多维临床诊断综合报告\n汇总 dP、dD 与 dF 全流程诊断指标\n评估交互推理能力、置信校准度与检查利用效率",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "df_match_topk",
      "label": "全信息 dF Top-k 基准评估\n无辅助检查先决条件的独立标准诊断匹配\n分别独立报告精确与近似 Top-k 准确率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "relevantIxBranch",
      "label": "诊断匹配类别决策分支\n校验候选诊断是否具备对应的支持性检查证据\n分流至正向得分累加或未匹配负向惩罚项",
      "type": "decision",
      "size": "xl"
    }
  ],
