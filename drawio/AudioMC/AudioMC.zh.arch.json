      "size": "xl"
    },
    {
      "id": "planner",
      "label": "Planner 提出挑战策略\nTester 生成音频轮次\n目标成功后增加难度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "synthetic_gate",
      "label": "失败是否早于最大轮数？\n目标成功时继续循环\n失败或达到轮数上限时停止",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard",
      "label": "丢弃未失败的尝试\n无失败则不生成量规\n记录排除原因",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "blueprint",
      "label": "保留失败蓝图\n提供策略而非脚本\n指导人工尝试",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "direct_human_seed",
      "label": "加入直接人工种子\n不使用合成蓝图\n独立创作尝试",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_recording",
      "label": "录制人工对话\n约 65% 使用合成蓝图\n其余使用直接人工种子",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "human_gate",
      "label": "人工最终轮失败？\n判断已录制对话\n仅保留观察到的失败",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "rubrics",
      "label": "编写最终失败轮量规\n原子化 • 准确 • 自包含\n仅评分最后一轮",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "qc",
      "label": "运行三阶段质检\n训练后评审 • 独立质检\n内部研究团队审核",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 452 段对话\n47 名说话人 • 14.99 小时\n1,712 条原子量规",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "fixed_context",
      "label": "注入固定对话上下文\n只生成最终轮回答\n保持历史完全一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
