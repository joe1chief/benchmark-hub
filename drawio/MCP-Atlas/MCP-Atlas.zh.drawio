<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2184" pageHeight="1352" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;arXiv 2602.00933v3 · 2026-05-19&#xa;PDF SHA-256 2cd00f60…&#xa;Git b6edd44 · HF b5bcde2" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择服务器生态&#xa;36 个生产级 MCP 服务器&#xa;全部任务共使用 220 个工具&#xa;五个领域 · 不使用合成模拟桩" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="专家编写 1,000 个任务&#xa;每题平均投入 4.6 个专家工时&#xa;工具依赖 · 稳定 · 无歧义&#xa;自然的单轮英文提示" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="配置每题工具环境&#xa;暴露 6–37 个工具 · 均值 15.2&#xa;必需 2–8 个 · 均值 4.1&#xa;可信干扰项 · 均值 11.1&#xa;隐去服务器、工具和参数名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="执行参考轨迹&#xa;最小充分证据路径&#xa;论文称平均 9.8 步&#xa;验证可解性与工具依赖&#xa;从不作为通过判定目标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="编写有依据的声明评分标准&#xa;原子且可独立核验的事实&#xa;全量均值 4.7 条 · 范围 1–23 条&#xa;每条声明均基于工具输出&#xa;其他有效轨迹同样可得分" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="执行五层质量检查&#xa;1 专家执行 · 2 领域复审&#xa;3 泄露复审 · 4 LLM 自动核验&#xa;5 随机样本人工审计" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="随机拆分 1,000 个任务&#xa;公开 500 题：支持复现&#xa;私有 500 题：监控暴露&#xa;留出集维护榜单完整性" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="固定公开数据资产&#xa;HF b5bcde2 · 500 行 Parquet&#xa;TASK · ENABLED_TOOLS · PROMPT&#xa;GTFA_CLAIMS · TRAJECTORY&#xa;CC BY 4.0 · 不含私有题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="公开 Parquet 实测&#xa;暴露 7–37 个工具 · 均值 15.20&#xa;调用 2–8 种工具 · 均值 4.11&#xa;3–17 次工具调用 · 均值 4.85&#xa;1–23 条声明 · 均值 3.90" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="HF 卡片与 Parquet 不一致&#xa;卡片称 10–25 个工具 · 3–6 次调用&#xa;六行超出 10–25 范围&#xa;五十行超过六次调用&#xa;计数应以 Parquet 为准" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="公开数据结构审计&#xa;五行 ENABLED_TOOLS 使用对象&#xa;其余行使用工具名字符串&#xa;一行 GTFA_CLAIMS 列表格式损坏&#xa;依赖关系没有独立字段" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="审计公开 Harness&#xa;Git b6edd44 · TypeScript v2&#xa;镜像仓库快照：1.2.7 @ sha256:24e6ed…&#xa;run_eval 传标签 · run_all 用本地 latest&#xa;沙盒 URL 不校验镜像摘要" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="论文与公开 Harness 边界&#xa;论文：Apache-2.0 · 仓库：MIT&#xa;论文：每题最多重试五次&#xa;外层 LLM 调用：3 次尝试 · 最多重试 2 次&#xa;LiteLLM 401/429：最多重试 5 次" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="环境隔离边界&#xa;第 3.1 节：每轮评测间重启&#xa;附录：每题之间重启&#xa;公开 v2：共享沙盒且未重置&#xa;实时 API 仍会产生上游漂移" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="选择公开或私有任务&#xa;单轮提示 + 暴露工具集&#xa;目标工具与干扰工具混合&#xa;论文完整评测使用全部 1,000 题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="固定任务级评测条件&#xa;相同提示 · 工具 · 100 次调用预算&#xa;相同评分标准 · 最终答案协议&#xa;仅底层适配器随提供方变化&#xa;不使用模型专属脚手架" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="运行工具型智能体&#xa;发现工具 · 调用实时端点&#xa;消费结果或错误并继续&#xa;达到上限时仍评分部分响应&#xa;最终输出一份文本答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="主声明评判器&#xa;Gemini 3.1 Pro Preview&#xa;每条声明独立调用一次&#xa;仅输入声明与最终答案&#xa;满足 1 · 部分满足 0.5 · 未满足 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="计算仅基于答案的覆盖率&#xa;独立声明得分取均值&#xa;参考轨迹不参与评分&#xa;覆盖率 ≥ 0.75 才通过" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="汇总 1,000 个任务&#xa;通过率为任务通过值均值&#xa;执行 10,000 次 Bootstrap 重采样&#xa;95% CI 取 2.5 与 97.5 百分位" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="论文 v3 汇报边界&#xa;20 个模型 · 六个提供方&#xa;主评判器定义主要结果&#xa;最佳 Pass@0.75 = 82.2%" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="跨评判器仅做敏感性分析&#xa;GPT-5.4 + Claude Opus 4.6&#xa;对每个任务独立重新评分&#xa;报告 2.1–4.6 个百分点范围&#xa;不取平均生成主结果" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="1168" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="只诊断未通过任务&#xa;覆盖率 &lt; 0.75 · 仅事后分析&#xa;4 类工具调用 + 7 类认知故障&#xa;从不改变通过判定" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="1168" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="动态榜单边界&#xa;四月：Gemini 2.5 + 原始提示&#xa;瞬态错误重试 + 100 次调用&#xa;v3：Gemini 3.1 · 仅声明与答案&#xa;当前榜单行已超出论文范围" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="1168" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent=