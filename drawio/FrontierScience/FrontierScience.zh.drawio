<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1784" pageHeight="576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据：arXiv:2601.21165v1&#xa;HF 黄金集 @ 25ed67db · 160 行&#xa;无公开评测仓库或解析器代码" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="奥赛作者池：42 位专家&#xa;国际奖牌得主或国家队教练&#xa;共 108 枚：金 45 · 银 37 · 铜 26" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="研究作者池：45 位博士科学家&#xa;博士生、博后或教授&#xa;真实研究子问题，至少需 3–5 小时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="创作全新、自包含奥赛任务&#xa;难度至少达到国际奥赛水平&#xa;数值/表达式或可模糊匹配字符串答案" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="创作全新、真实的研究子问题&#xa;完整满分解答 + 元数据&#xa;独立客观评分项合计 10 分" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="用内部 OpenAI 模型筛难&#xa;至少 1 次独立评审 + 整体评审&#xa;作者与评审达成一致，否则丢弃" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="按内部模型评分标准得分筛难&#xa;至少 2 次独立评审 + 元评审&#xa;作者与评审达成一致，否则丢弃" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="500+ → 100 奥赛题；200+ → 60 研究题&#xa;HF 字段：problem · answer · subject&#xa;task_group_id；研究 answer 存评分标准" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="裁判提示：题目 + 尝试答案 + 参考答案&#xa;GPT-5 高；末行需为&#xa;VERDICT: CORRECT / INCORRECT&#xa;无浏览；20 次试验取平均准确率" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="裁判提示：题目 + 尝试答案 + 10 分标准&#xa;GPT-5 高；末行需为&#xa;VERDICT: 2.5 或 VERDICT: 8&#xa;无浏览；≥7/10 成功；30 次试验取平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="分轨报告平均准确率&#xa;奥赛判断等价 · 研究以 ≥7 为成功&#xa;裁判/解析器实现未发布" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="5"><mxGeometry rel