00;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1616" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="中止整个评分器&#xa;字段拆包 / 断言失败&#xa;不逐行跳过或补值" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="688" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="解析小写化后的响应&#xa;精确 yes / no 直接接受&#xa;否则只检查前四个字符&#xa;先查 yes 再查 no · 否则 other" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="解析结果为 yes 或 no？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1072" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="与标准答案比较&#xa;标签正确则单题正确数加一&#xa;两题都正确则 ACC+ 计数加一" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="688" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="将 other 视为错误&#xa;保留在 ACC 与 ACC+ 分母&#xa;从精确率 / 召回率 / 混淆计数中排除" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121