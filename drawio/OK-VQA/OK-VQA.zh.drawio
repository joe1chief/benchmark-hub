<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="976" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="随机抽取 COCO 图像&#xa;原始约 8 万训练集&#xa;原始约 4 万验证集&#xa;对应 OK-VQA 训练与测试集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="MTurk 第一轮：编写问题&#xa;目标是难住智能机器人&#xa;问题必须关联图像&#xa;必须需要外部知识" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="MTurk 第二轮：收集开放答案&#xa;每个图文对由五人独立作答&#xa;逐个图像问题对标注&#xa;保留独立回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="原始众包候选池&#xa;86,700 道问题&#xa;混有知识题与低质量项&#xa;最终过滤前已经收集答案" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="人工审核知识依赖性&#xa;删除计数与无图可答问题&#xa;删除无意义问题&#xa;审核人数和协议未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="是否需要外部知识？&#xa;保留 34,921 道问题&#xa;必须与图像内容相关&#xa;必须超出视觉识别" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="淘汰低质量候选&#xa;计数或检测题&#xa;无需图像即可回答&#xa;无意义或不依赖知识" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="控制答案频率偏差&#xa;训练集与测试集分别处理&#xa;统计每个众数答案&#xa;标记出现超过五次者" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="众数答案次数&#xa;是否不超过五次？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="删除频率偏置项&#xa;众数答案出现&#xa;超过五次" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="标注员答案是否有一致？&#xa;比较五位工人的回答" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="删除零一致项&#xa;工人之间没有共享答案" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="最终 COCO 来源划分&#xa;训练 9,009 · 测试 5,046&#xa;共 14,055 题 · 14,031 张图&#xa;训练图 8,998 · 测试图 5,033" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="标注知识类别&#xa;每题由五位 MTurk 工人分类&#xa;十个预定义类别&#xa;取相对多数否则归为其他" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="公开 OK-VQA v1.1 · 2020-07-29&#xa;训练 9,009 · 测试 5,046&#xa;五份答案各存两次：共十条&#xa;问题和图像相对 v1.0 未变化" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="预测一个开放答案&#xa;输入图像与问题&#xa;不提供多选项&#xa;可检索外部知识" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="论文协议：规范化答案&#xa;论文要求 Porter 词干化&#xa;v1.1 的 gold answer 已预词干化&#xa;固定通用评分器不词干化预测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="留一法计算人工一致度&#xa;每次比较：min(1, 命中数 / 3)&#xa;对十条答案记录求平均&#xa;再对所有问题求平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="报告 OK-VQA 表现&#xa;总体 VQA 分数&#xa;十个知识类别&#xa;加其他类别" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="固定公开边