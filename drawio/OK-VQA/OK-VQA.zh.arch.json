  "nodes": [
    {
      "id": "coco",
      "label": "随机抽取 COCO 图像\n原始约 8 万训练集\n原始约 4 万验证集\n对应 OK-VQA 训练与测试集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "question_round",
      "label": "MTurk 第一轮：编写问题\n目标是难住智能机器人\n问题必须关联图像\n必须需要外部知识",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_round",
      "label": "MTurk 第二轮：收集开放答案\n每个图文对由五人独立作答\n逐个图像问题对标注\n保留独立回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidate_pool",
      "label": "原始众包候选池\n86,700 道问题\n混有知识题与低质量项\n最终过滤前已经收集答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "manual_review",
      "label": "人工审核知识依赖性\n删除计数与无图可答问题\n删除无意义问题\n审核人数和协议未披露",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "knowledge_gate",
      "label": "是否需要外部知识？\n保留 34,921 道问题\n必须与图像内容相关\n必须超出视觉识别",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_quality",
      "label": "淘汰低质量候选\n计数或检测题\n无需图像即可回答\n无意义或不依赖知识",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "bias_filter",
      "label": "控制答案频率偏差\n训练集与测试集分别处理\n统计每个众数答案\n标记出现超过五次者",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "bias_gate",
      "label": "众数答案次数\n是否不超过五次？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_bias",
      "label": "删除频率偏置项\n众数答案出现\n超过五次",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "agreement_gate",
      "label": "标注员答案是否有一致？\n比较五位工人的回答",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_disagreement",
      "label": "删除零一致项\n工人之间没有共享答案",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "final_split",
      "label": "最终 COCO 来源划分\n训练 9,009 · 测试 5,046\n共 14,055 题 · 14,031 张图\n训练图 8,998 · 测试图 5,033",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "category_annotation",
      "label": "标注知识类别\n每题由五位 MTurk 工人分类\n十个预定义类别\n取相对多数否则归为其他",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "公开 OK-VQA v1.1 · 2020-07-29\n训练 9,009 · 测试 5,046\n五份答案各存两次：共十条\n问题和图像相对 v1.0 未变化",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_answer",
      "label": "预测一个开放答案\n输入图像与问题\n不提供多选项\n可检索外部知识",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_normalization",
      "label": "论文协议：规范化答案\n论文要求 Porter 词干化\nv1.1 的 gold answer 已预词干化\n固定通用评分器不词干化预测",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "vqa_score",
      "label": "留一法计算人工一致度\n每次比较：min(1, 命中数 / 3)\n对十条答案记录求平均\n再对所有问题求平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 OK-VQA 表现\n总体 VQA 分数\n十个知识类别\n加其他类别",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "source_boundary",
      "label": "固定公开边界\nv1.1 JSON：CC BY 4.0 · COCO 另计\na013f004… 通用 VQA 评分器\n未随评分器打包知识类别划分",
      "type": "document",
      "size": "xl"
    }
  ],
