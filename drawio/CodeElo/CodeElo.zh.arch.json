      "size": "xl"
    },
    {
      "id": "hf_release",
      "label": "固定 HF 公开发布版\n57 场比赛 • 408 条记录\n含 21 道 Div. 1 • Markdown",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "paper_prompt",
      "label": "论文 CoT 提示\n生成完整 C++ 程序\n原始 HTML • 隐藏标签",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_use",
      "label": "公开版边界\n过滤 21 道 Div. 1 后为 387\nMarkdown ≠ 原始 HTML 提示",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "inference_route",
      "label": "选择推理路径",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "open_source",
      "label": "开源模型解码\n温度 0.7 • top_p 0.8 • top_k 20\n重复惩罚 1.1\n4,096 tokens；QwQ 32,768",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "proprietary",
      "label": "闭源模型\n提供商 API 默认参数\n使用相同 C++ CoT 提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "runner_parse",
      "label": "固定仓库解析器\n提取首个围栏代码块\n无语言标签时默认 C++\n仓库 0bffc84",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attempt_execution",
      "label": "固定尝试执行\n每题最多 8 次\n生成并提交全部可解析候选\n出现 AC 后也不提前停止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "official_judge",
      "label": "直接提交 Codeforces 判题\n隐藏测试 • 特殊/交互评测器\n平台时间 + 内存限制\n必须通过全部测试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "contest_score",
      "label": "重建比赛得分\n失败尝试降低得分 / 增加罚分\n不计提交时间罚时\n首次通过时计分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "elo",
      "label": "人类可比 Elo\n将模型插入人类排名\n二分搜索期望等级分\n平均 54 场比赛等级分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "CodeElo 报告\nElo + 人类百分位\nPass@1 / 2 / 4 / 8\n披露所用资产变体",
      "type": "terminal",
      "size": "xl"
    }
