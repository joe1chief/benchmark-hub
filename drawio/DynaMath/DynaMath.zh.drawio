    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3480" pageHeight="1016" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据边界&#xa;arXiv:2411.00836v2&#xa;DynaMath 仓库 @ 598c3c3" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="视觉数学候选题&#xa;MathVista 107 · MATH-V 27&#xa;科学图表 45 · 图结构题 48&#xa;公开网页 236 · 作者新题 38" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="全面复核种子题&#xa;保留依赖视觉的数学推理&#xa;剔除图像过于复杂、&#xa;难以程序化生成的问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="501 道种子题 · 既有 227 + 新增 274&#xa;学段：小学 63 · 高中 277&#xa;本科 161 · 覆盖九个数学主题&#xa;数值题 296 · 选择题 174 · 自由作答 31" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="大学 STEM 学生标注解题策略&#xa;每题手工编写一个 Python 程序&#xa;条件采样 + 算法解法&#xa;明确答案格式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="编码论文定义的七类变化&#xa;数值 · 几何 · 函数 · 颜色&#xa;符号 · 图结构&#xa;现实情境" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="渲染每道采样后的视觉题&#xa;470 个绘图程序 · Matplotlib / Pyglet&#xa;31 个固定图像程序&#xa;仅随机替换文字元素" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="论文仅报告全面人工复核&#xa;以及程序均为精心编写&#xa;具体程序质控检查清单&#xa;未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="动态变体网格&#xa;N=501 个种子 · 每题 M=10 个变体&#xa;501 × 10 = 5,010 道问题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="独立重复评测分支&#xa;501 道问题 × 5 次响应&#xa;每次与第一次响应比较&#xa;不属于 501 × 10 变体网格" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="608" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="视觉语言模型零样本推理&#xa;输入图像与问题提示&#xa;生成推理过程和简短答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="基于提示抽取答案&#xa;模板匹配&#xa;将 Ans(i,j) 与程序标准答案 GT(i,j) 比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="两套论文评测轨道&#xa;变体网格：N=501 · M=10&#xa;重复网格：501 道问题 · K=5" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="平均准确率 Aavg&#xa;Aavg=(1/N) Σᵢ (1/M) Σⱼ&#xa;I[Ans(i,j)=GT(i,j)]&#xa;N=501 · M=10" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFami