<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义临床评测范围&#xa;超越多项选择问答&#xa;选择 11 类临床任务&#xa;覆盖知识回忆与上下文检索" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="整合现有来源&#xa;论文版包含 28 个数据集&#xa;临床文本 · 考试 · 论文&#xa;医学知识资源" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="组织论文版基准&#xa;11 个高层任务类别&#xa;52 项不同任务&#xa;约 30 万条样本" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="重构每个数据集&#xa;转为指令提示问答结构&#xa;规范化输入与输出&#xa;保留原数据集语义" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="手工编写任务定义&#xa;说明所需输出&#xa;提供统一指令合同&#xa;支持异构临床任务" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="分类所需能力&#xa;八类需回忆模型知识&#xa;三类从给定上下文检索&#xa;记录任务与词元统计" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="建立评测划分&#xa;使用现有训练测试划分&#xa;否则随机按 9 比 1 划分&#xa;保留测试部分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="防止提示泄漏&#xa;示例中排除测试样本&#xa;从训练数据抽取演示&#xa;测试标准答案保持隐藏" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="构建评测切片&#xa;多选题使用完整测试集&#xa;对其他大型基准做成本抽样&#xa;指定场景约抽 1,500 条" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="定稿论文版 MedS-Bench&#xa;11 类临床任务&#xa;28 个来源数据集 · 52 项任务&#xa;指令与标准答案记录" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="评测六个主流大模型&#xa;GPT-4 · Claude-3.5&#xa;Llama 3 · Mistral · InternLM 2&#xa;医学模型 MEDITRON" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="保留提示合同冲突&#xa;第 2.3 节：多选零样本，其余三样本&#xa;附录 A.1：全部评测均为三样本&#xa;固定 eval.py 默认：三样本" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="按输出合同评分&#xa;封闭决策使用准确率&#xa;标签任务用精确率召回率与 F1&#xa;生成任务用 BLEU 与 ROUGE" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="维护动态榜单&#xa;提交模型或 Hugging Face 链接&#xa;或提交结果 CSV&#xa;扩展并刷新测试集" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="计数与发布边界&#xa;论文第 2.1 节/图 1：28 数据集 · 52 任务&#xa;论文图 3 与 README：39 数据集&#xa;SPLIT 53 个任务文件 · HF main 32 个" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="提示复现边界&#xa;论文不同章节的多选样本数冲突&#xa;固定代码不会自动选择零样本&#xa;必须显式记录实际评测样本设置" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="访问与权利边界&#xa;代码 LICENSE 声明 CC BY-SA&#xa;README 无许可声明&#xa;HF 基准卡无许可字段 · 来源条款仍适用" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy