    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2520" pageHeight="1096" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="40" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="3" value="核验" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="120" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="4" value="在线" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#F3E5F5;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="200" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="5" value="边界" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FAFAFA;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="280" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="6" value="接受条款并提交实时提示&#xa;同意数据发布条款&#xa;不预设问题或固定评分量表&#xa;开放式多轮输入" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="-104" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="选择匿名模型对&#xa;论文采用非均匀采样&#xa;优先相近且高不确定的模型对&#xa;并非均匀随机基线" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="152" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="并排模型对战&#xa;向两模型发送相同对话轮次&#xa;对战期间隐藏模型身份&#xa;用户无法判断时继续对话" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="408" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="记录一条人工偏好&#xa;模型 A · 模型 B · 平局 · 两者都差&#xa;投票后才揭示模型身份&#xa;保存两侧对话与选票" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="664" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="排除身份泄漏&#xa;过滤模型名与公司名关键词&#xa;保留匿名排名数据&#xa;论文明确的主数据过滤" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="920" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文表 1 快照&#xa;2024-01-21 · 243,329 段对话&#xa;50 个模型 · 90,051 位用户&#xa;149 种语言 · 平均 1.3 轮" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1176" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="IPW 获胜矩阵估计&#xa;θ̂_T(a) = T⁻¹ Σₜ Hₜ 1{Aₜ=a}/Pₜ(a)&#xa;校正非均匀模型对采样&#xa;论文排名回放：213,576 张选票" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1432" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="重加权 Bradley-Terry 最大似然&#xa;P(i≻j)=e^ξⁱ/(e^ξⁱ+e^ξʲ)；ξ₁=0&#xa;ξ̂ = argmin Σₜ P(Aₜ)⁻¹ ℓ(Hₜ,pξ(Aₜ))&#xa;目标为均匀模型对分布" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1688" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="三明治联合置信集合&#xa;多重性校正的近似排名&#xa;Rₘ = 1 + Σₘ′ 1{inf Cₘ′ &gt; sup Cₘ}&#xa;不能只排序点估计" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1944" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="发布论文时期排名&#xa;BT 系数 · 获胜矩阵&#xa;置信区间 · 近似排名&#xa;早期界面 Elo 并非该估计器" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="2200" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="主动采样反馈&#xa;Pₜ(a) ∝ √(Σ̂ₜ,ₐₐ / nₜ(a))&#xa;− √(Σ̂ₜ,ₐₐ / (nₜ(a)+1))&#xa;按预期区间宽度下降采样" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="200" y="-152" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="仅标记不安全内容&#xa;使用 OpenAI Moderation API&#xa;3% 用户请求被标记&#xa;论文未说明因此排除排名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="328" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="仅用于专家验证&#xa;随机 160 场对战 · 盲标&#xa;研究生标注并可外部事实核查&#xa;众包与专家一致率 72.8–83.1%" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1096" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="仅为论文异常用户实验&#xa;25 个异常 + 25 个正常 IP&#xa;5 个随机检查点执行 Fisher 检验&#xa;不进入论文排名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1352" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="2024-08-29 → 2025-05-16&#xa;风格控制成为文本榜默认方法&#xa;token 数 · 标题 · 粗体 · 列表&#xa;z_f = std((f_A−f_B)/(f_A+f_B))&#xa;上下文 BT：β_A−β_B+zᵀγ" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="-264" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="2025-07-23&#xa;在线 Bootstrap → CLT / M-估计区间&#xa;按模型对出现频率重加权&#xa;Arena-Rank 权重：max{n_ab, 50} 的倒数&#xa;不等同论文基于采样概率的 IPW" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="104" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="2025-07-14 → 2025-10-04&#xa;加强去重与身份泄漏检查&#xa;增加统计异常用户过滤&#xa;移除模型与自身对战记录&#xa;精确去重 / 异常算法未公开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="472" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="2026-03 → 2026-05-12&#xa;10% 直接聊天会话转为对战&#xa;排除跳过票；仅保留明确 A/B 偏好&#xa;新增 is_direct_battle&#xa;+ same_org_indicator&#xa;特征精确编码未公开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1208" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="2026-04-30 上榜政策&#xa;仅展示已公开可用模型&#xa;排名稳定且至少收集 1,000 张选票&#xa;每场至少包含一个公开模型&#xa;至少 20% 为公开模型之间对战" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="840" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="改名后的在线 Arena 排行榜&#xa;BT / 上下文 BT，而非 Elo 更新&#xa;Arena-Rank 尺度：1000 + 400β / ln(10)&#xa;后续方法不能改写论文 v1" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1576" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="不得混合论文统计单位&#xa;表 1：243,329 段对话&#xa;排名回放：213,576 张选票&#xa;范围与用途不同" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="5"><mxGeometry x="24" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="部分公开制品&#xa;140K rev 6322995：135,634 条文本记录&#xa;排行榜 rev cc2d2cd：仅聚合快照&#xa;提示 CC-BY-4.0；输出遵循供应商条款&#xa;完整在线排名语料未公开" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="5"><mxGeometry x="760" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="" style="edgeStyle=o