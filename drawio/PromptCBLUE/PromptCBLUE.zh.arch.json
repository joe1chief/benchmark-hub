    {
      "id": "source_evidence",
      "label": "固定来源证据\narXiv 2310.14151v1\nPDF SHA-256 2a69d5133e62\nGit b0753a61a7c1\n论文与官方仓库联合核验",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "cblue_scope",
      "label": "汇集 16 项中文医疗 NLP 任务\n二次开发 CBLUE 与配套任务\n保留真实中文医疗文本\n同时覆盖理解与生成",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_cohorts",
      "label": "组织论文中的五类任务\n信息抽取 5 · 文本分类 3\n自然语言推理 4 · 症状状态 2\n医疗内容生成 2",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_seeds",
      "label": "人工撰写多样化种子提示\n三名计算机专业研究生标注员\n每人约写两条种子\n每项任务约六条种子",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "expert_seed_review",
      "label": "审核每条人工种子\n两名医疗专家\n一名资深 NLP 研究者\n修改直至专家接受",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "chatgpt_rephrase",
      "label": "用 ChatGPT 扩写已接收种子\n每条种子改写十次\n不改变语义\n不改变任何占位符",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "expert_augmented_review",
      "label": "复审生成的提示模板\n仍由同一专家组完成\n剔除语义或占位符漂移\n仅接纳审核通过的模板",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt_components",
      "label": "组装每条提示\n任务指令与文本输入\n可附标签解释及输出格式\n可附示例或分步推理要求",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "target_serialization",
      "label": "将原始目标序列化为文本\n转换跨度 标签与结构\n保留各任务特定语义\n统一改造成生成任务",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "uniform_schema",
      "label": "输出统一提示—回答结构\ninput · target · answer_choices\nsample_id · task_type · task_dataset\n四个辅助字段不输入模型",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "template_fill",
      "label": "用来源样本填充提示模板\n形成大型提示—回答候选池\n保留任务与样本身份\n有标签集时保留允许选项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "uniform_sample",
      "label": "论文正文：每任务均匀抽样\n训练 3,000 至 5,000 条\n开发与测试各 600 至 800 条\n表 8：CHIP-CTC 6,600 · QIC 5,500\n论文未解释正文与表格冲突",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality_checks",
      "label": "执行三类质量检查\n专家审模板 · 协助修订 CBLUE\n触发 QQR 重新标注\n每任务查 5% 或 200 条 · 错标率 0.9%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_release",
      "label": "表 8 总计与 16 行实算\n印刷训/开/测：82,600 / 7,656 / 7,656\n行和训/开/测：78,100 / 6,856 / 6,856\n差额训/开/测：4,500 / 800 / 800\n论文未作解释",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "evaluation_settings",
      "label": "选择论文披露的评测设置\n少样本上下文学习\n少样本微调\n全量微调或参数高效微调",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "icl_setting",
      "label": "构造固定上下文示例\n使用同任务演示\n可行时每标签至少 k 条\nCHIP-CTC 选不同标签示例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fewshot_ft",
      "label": "执行少样本微调\n复用已选择的演示样本\n改变训练样本数量\n衡量样本效率影响",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "full_ft",
      "label": "在大型参考训练集上训练\n比较全参数微调\n与参数高效方法\n将 PromptCBLUE 视作单一任务",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "shared_model_rule",
      "label": "执行竞赛模型约束\n所有任务共用一个 LLM 主干\n所有任务共用一个 LM 预测头\nPEFT 总参数量低于主干 1%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "test_generation",
      "label": "为每条测试样本生成一个回答\n原样输入固定 input\n发布测试输入中的 target 为空\n保持顺序 数量与 sample_id",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "submission_package",
      "label": "构造提交 ZIP 包\ntest_predictions.json\npost_generate_process.py\n两个文件均置于 ZIP 根目录",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "platform_parser",
      "label": "在线运行参赛者后处理脚本\n仅允许 Python 标准库\n文本转为按任务组织的 results.json\n忽略手工上传的 results.json",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extraction_metrics",
      "label": "评分信息抽取与状态任务\n严格实例级 Micro-F1\n实例内全部字段必须精确命中\n覆盖实体 三元组 事件与 ICD 输出",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "classification_metrics",
      "label": "评分分类与推理任务\nCTC QIC DAC 使用 Macro-F1\nSTS QQR IR QTR 使用 Micro-F1\n基于解析后的任务标签计算",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generation_metrics",
      "label": "评分医疗生成任务\n汉字空格化后算 ROUGE-1 · ROUGE-2 · ROUGE-L\nMRG 六个报告章节分别评分后平均\nMedDG 回复直接评分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "overall_score",
      "label": "计算总体分数\n选择每项任务主指标\n平均 16 项论文任务得分\n每项使用 F1 或 ROUGE-L",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "leaderboard",
      "label": "在天池平台排名\n通用赛道与开源赛道\n执行各赛道审核规则\n发布分任务与总体结果",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "固定仓库发布边界\nv0.2 README 声称 94 个模板\n训练 68,900 · 开发 10,360 · 测试 A/B 各 10,320\n文件含 91 条人工 · 352 条扩写记录",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "license_boundary",
      "label": "许可边界\n固定 Git 树没有 LICENSE 文件\n完整数据通过天池分发\n不推断数据集再使用条款",
      "type": "document",
      "size": "xl"
    }
  ],
