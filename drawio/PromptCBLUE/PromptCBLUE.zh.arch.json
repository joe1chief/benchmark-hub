  "nodes": [
    {
      "id": "step_1",
      "label": "汇集16个医疗NLP任务\n基于CBLUE及配套任务\n保留真实中文医疗文本\n覆盖理解与生成",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "组织五类任务组\n医疗信息抽取\n文本分类与自然语言推理\n对话状态与内容生成",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "为LLM改造每个任务\n转换跨度标签与结构\n全部目标表达为生成文本\n保留任务专用语义",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "编写94个指令模板\n使用多样自然提示措辞\n适用任务加入候选答案\n任务身份不作为模型输入",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "生成统一JSONL模式\ninput · target · task type\nanswer choices · sample ID\n全任务共用提示响应合同",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "保留数据切分\n68,900训练 · 10,360验证\n测试A与B各10,320条\n每个切分混合全部任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "隐藏测试集标准答案\n发布固定测试输入\ntarget字符串留空\n减少直接标签泄漏",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "定义评测设置\n各任务固定少样本示例\n全量与少样本微调\n共用文本生成接口",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "约束参评模型\n一个共享LLM主干\n一个共享语言模型头\nPEFT参数低于主干1%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "生成全部测试响应\n原样输入固定prompt\n保持行顺序与sample ID\n每条提交一个文本答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "解析为任务结构\n提供仅标准库后处理代码\n文本转实体标签或章节\n生成按任务分组results JSON",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "评估理解类任务\n抽取任务严格micro-F1\n部分分类任务macro-F1\n其余推理任务micro-F1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "评估生成类任务\nROUGE-1 · ROUGE-2 · ROUGE-L\n评分前按汉字切分\nIMCS-MRG六章节分数平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "按总体分数排名\n每任务选F1或ROUGE-L\n平均16项任务主指标\n在在线平台执行评测",
      "type": "terminal",
      "size": "xl"
    }
  ],
