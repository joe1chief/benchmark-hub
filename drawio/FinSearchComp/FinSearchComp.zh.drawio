<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2560" pageHeight="608" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据边界：arXiv:2509.13160v1&#xa;FinSearchComp @ 55b6393f&#xa;数据 SHA 6437a6da&#xa;论文协议 + 固定论文后代码审计" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义三类客观任务&#xa;T1 时效数据 · T2 简单历史查询&#xa;T3 复杂历史调查 · 均需外部工具" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="T1 问题 + 可执行公共 API 动态答案&#xa;T2 官方直接事实，不做计算&#xa;T3 可靠表格 + 多源计算" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="50 名标注专家 + 20 名资深专家 = 70&#xa;至少硕士学历，保持金融从业身份&#xa;约 180 + 60 个专家工时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="交叉核验申报文件、权威网站与数据库&#xa;明确定义/日期，规避易变指标&#xa;设置答案范围或明确容差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="另请 1-2 名专家在不见答案时盲解&#xa;资深专家编辑或仲裁分歧&#xa;模糊题被修订或丢弃" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="发布 635 道双语问题&#xa;Global 337 → T1/T2/T3 134/119/84&#xa;大中华区 298 → 110/100/88" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="智能体可用任意搜索工具或来源&#xa;T1：市场收盘后执行动态 API&#xa;T2/T3：静态参考答案 + 标注评分规则" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="评分规则分布：21.4% 精确匹配&#xa;78.6% 范围 / 容差检查&#xa;LLM 评审为每个回答输出一个二元分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文指标：0-1 平均准确率&#xa;J(回答, 规则) 只能为 0 或 1&#xa;人工审计报告至少 95% 一致率" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="固定仓库：完整 635 · AkShare 子集 594&#xa;内置快照日期为 2025-10-17&#xa;属于论文后发布物，并非论文时状态" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="424" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="提示要求 answer_score 标量 0/1&#xa;解析器却索引 answer_score[0][0]&#xa;合法标量输出会退化为错误值 -100000" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="424" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="non_ts 计数器从未更新&#xa;公开脚本因此写出 accuracy = 0&#xa;original_accuracy 才是解析分数均值" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="424" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle