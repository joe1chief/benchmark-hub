  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3824" pageHeight="576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="抓取 CC BY 4.0&#xa;arXiv 源文件&#xa;发表于 2024 年 2 月后&#xa;提取 PDF 图形" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="筛选约 174,100 张图&#xa;仅保留 Matplotlib&#xa;生成的 PDF&#xa;留下约 15,800 个候选" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="五领域专家复核&#xa;15,800 → 1,295&#xa;经 7 天多样性初筛&#xa;全票或 ≥3/5 → 279 张" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="补充独特公开样例&#xa;Matplotlib&#xa;Stack Overflow&#xa;Twitter • Reddit&#xa;填补 arXiv 池缺失风格" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="人工选择与补齐&#xa;替换补充样例的数据/配色&#xa;组装 600 张原型图表" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Python 标注员&#xa;计算机硕士生 • 6 年以上&#xa;Python 3.9.0&#xa;matplotlib 3.8.4" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Direct Mimic&#xa;600 个种子三元组&#xa;用 Python 复现图表&#xa;编写匹配指令" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Customized Mimic&#xa;600 个种子三元组&#xa;插入新领域数据&#xa;修改代码/指令" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="人工数据增强&#xa;每个种子额外生成 3 个变体&#xa;修改数据/配色/标记&#xa;合计 4,800" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Direct 2,400&#xa;Customized 2,400 • 201 子类&#xa;22 种图型 • 发布 4,800&#xa;测试 3,600 • Testmini 1,200" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="输入图形 + 任务指令&#xa;生成 Python 图表代码&#xa;执行代码并渲染输出" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="高层相似度 • 0–100&#xa;GPT-4o 比较&#xa;参考图与输出图&#xa;判断整体视觉保真度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="低层代码追踪 F1&#xa;文本 • 布局&#xa;类型 • 颜色&#xa;对四项元素得分取平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="总分 = 高层与低层平均&#xa;执行失败则两项均为零&#xa;执行率另报且不加权" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="指标与人工判断验证&#xa;300 个 Direct 测试样本&#xa;GPT-4o × 4 种提示方法&#xa;1,200 张输出 • 每图 3 人&#xa;计算 Pearson 相关系数" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3240" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="分别报告 Direct/Customized&#xa;高层 • 低层 • 总分&#xa;执行率&#xa;分析复杂度与失败类型" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3544" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source=