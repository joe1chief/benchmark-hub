eometry x="640" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Run the 29-dataset Study&#xa;FullTest JSON · Paper Tables 1–2&#xa;Per-dataset Containment Accuracy&#xa;Distinct from the 1,000-item Release" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Define Compact OCRBench&#xa;Fixed Quotas across Five Components&#xa;1,000 Image–Question–Answer Rows&#xa;Item-selection Algorithm Not Reported" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Allocate the Five&#xa;Component Quotas" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Text Recognition · 300&#xa;Regular · Irregular · Artistic&#xa;Handwriting · Digit String · NST&#xa;Six Types × 50" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="88" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Scene Text VQA · 200&#xa;STVQA · TextVQA&#xa;ESTVQA