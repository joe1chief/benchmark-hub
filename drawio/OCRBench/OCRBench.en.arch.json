      "type": "document",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "Verify All 1,000 Rows Manually\nCorrect Inaccurate Answers\nAdd Alternative Correct Candidates\nCheck the Fixed Component Quotas",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Release OCRBench Data and Images\nJSON Fields: Type · Dataset · Question\nAnswers · Image Path · ID\nPublic 1,000-row HF Mirror",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "infer",
      "label": "Run Zero-shot LMM Inference\nSupply One Image and Its Question\nKeep a Free-form Prediction\nNo Paper-wide Generation Settings",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "Apply Released Normalization\nNon-HMER: Lowercase + Trim\nFlatten Lines\nHMER: Remove Spaces/Line Breaks\nTest Each Alternative Gold",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "containment",
      "label": "Assign Released Binary Row Score\nAny Normalized Gold Is a\nPrediction Substring → 1\nOtherwise → 0",
      "type": "process",
      "size": "xl"
    },
