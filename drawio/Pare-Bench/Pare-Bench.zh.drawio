    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="1032" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2604.00842v1 · PDF 259caaeaa7d3&#xa;Git 261149914a9e · tar c0c5aa90099a&#xa;full.txt SHA 50b6d79aae2f" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="24" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="扩展ARE平台&#xa;复用应用 · 场景 · 验证机制&#xa;加入主动用户仿真智能体&#xa;保留共享持久状态" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="280" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="定义论文v1应用范围&#xa;四类领域共9个FSM应用&#xa;System · Agent UI · FileSystem&#xa;核心应用列于表5" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="将每个用户应用建模为FSM&#xa;屏幕作为状态&#xa;导航与表单作为转移&#xa;跟踪前台与后台应用" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="强制接口非对称&#xa;用户仅见状态依赖动作&#xa;助手获得扁平应用API&#xa;双方修改同一共享环境" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="定义场景三部分&#xa;初始应用状态与种子数据&#xa;环境事件与Oracle事件流&#xa;最终状态验证条件" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="启动场景生成智能体&#xa;基于Claude Agent SDK&#xa;只读访问Pare代码库上下文&#xa;必须包含指定目标应用" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1584" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="阶段1 · 生成故事&#xa;编写自然语言场景&#xa;扎根一个隐含用户目标&#xa;指定真实应用上下文" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="故事唯一？&#xa;大模型描述检查" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2104" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="阶段2 · 填充应用状态&#xa;生成init_and_populate_apps&#xa;写入联系人 · 邮件 · 日程数据&#xa;建立场景上下文" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2360" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="阶段3 · 构建事件流&#xa;生成build_event_flow&#xa;调度环境事件&#xa;添加Oracle用户与助手动作" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2360" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="阶段4 · 生成验证逻辑&#xa;定义最终状态条件&#xa;检查完成任务所需动作&#xa;绑定任务成功Oracle" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2104" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Oracle检查是否通过？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="论文第5节：作者核验每个候选场景&#xa;检查故事连贯性&#xa;检查验证条件正确性&#xa;检查事件内容真实性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1584" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="路由Oracle检查失败&#xa;阶段2应用状态 · 阶段3事件流&#xa;阶段4验证逻辑&#xa;仅重试失败阶段" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2104" y="608" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="定稿Pare-Bench&#xa;四类领域共143个场景&#xa;上下文 · 目标 · 时机 · 编排&#xa;支持可选失败与噪声" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="固定论文评测配置&#xa;四次运行 · GPT-5-mini用户&#xa;最多10轮 · 用户每轮1次迭代&#xa;观察5次 · 执行10次迭代" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="主动用户仿真器&#xa;每轮先行动&#xa;仅使用当前状态工具&#xa;接受 · 拒绝 · 或继续收集上下文" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="助手观察模式&#xa;接收用户动作与通知&#xa;只读工具&#xa;等待或提出帮助" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="提议结果？&#xa;接受 · 拒绝 · 收集&#xa;或任务结束／轮次上限" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="280" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="助手执行模式&#xa;完整跨应用扁平API&#xa;仅执行获批任务&#xa;随后进入下一用户轮次" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="280" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="最终状态Oracle&#xa;检查用户目标是否完成&#xa;记录提议与接受次数&#xa;统计只读动作与轮次" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="24" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="选择环境条件&#xa;基线：不注入失败或噪声&#xa;工具失败率0.1 · 0.2 · 0.4&#xa;泊松噪声每分钟2 · 4 · 6个事件&#xa;噪声穿插到场景事件中" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="报告四次运行指标&#xa;Success@4 · Success⁴&#xa;成功率 · 提议率&#xa;接受率 · 平均只读动作数" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=cente