    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3864" pageHeight="832" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文 arXiv:2506.11763v1&#xa;初始代码 @ 214741e&#xa;查询 SHA256 62b197a…&#xa;HF 产物 @ f7d27cd" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="论文后漂移 · 不纳入本图主流程&#xa;main @ 469cce5 · 2026-05-11&#xa;RACE GPT-5.5&#xa;FACT GPT-5.4-mini&#xa;旧 Gemini 分支 @ a5bbbe8" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="96,147 条真实用户查询&#xa;联网搜索聊天机器人日志&#xa;内部需求样本" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="隐私匿名化&#xa;移除用户标识与 IP 地址&#xa;移除会话元数据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="DeepSeek-V3-0324 过滤&#xa;多轮搜索与信息收集&#xa;分析并生成高质量报告&#xa;保留 44,019 条查询" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="WebOrganizer 分类体系&#xa;DeepSeek-V3-0324 分类&#xa;22 领域需求分布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="按比例压缩&#xa;保持主题分布平衡&#xa;确定 100 题领域配额" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="博士或资深从业者&#xa;至少 5 年领域经验&#xa;提出前沿研究任务" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="人工筛选与迭代修改&#xa;质量 · 清晰度 · 复杂度&#xa;真实性 · 深度研究匹配度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="DeepResearch Bench v1&#xa;100 题 · 22 领域&#xa;中文 50 + 英文 50&#xa;每题均为单语&#xa;评测提示 · 无训练/开发/测试划分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="外部研究智能体&#xa;搜索轨迹由系统自行决定&#xa;基准不标注内部轨迹&#xa;只评最终带引用报告" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="两个互补的&#xa;论文 v1 评测器&#xa;报告质量 + 检索证据支撑" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="论文 RACE · Gemini-2.5-pro&#xa;COMP · DEPTH · INST · READ&#xa;维度权重取 T 次试验均值&#xa;任务特定评分标准&#xa;标准权重之和为 1" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="参考：Gemini DR · 2025 年 4 月&#xa;商业模型迭代无法确认&#xa;加权 S_int(tgt), S_int(ref)&#xa;S_final = S_int(tgt) /&#xa;[S_int(tgt) + S_int(ref)]" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3064" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="论文 FACT · Gemini-2.5-flash&#xa;提取陈述—链接对&#xa;同一事实 + 同一链接&#xa;去重后只保留一条" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="通过 Jina Reader 获取网页&#xa;裁判判断证据是否支撑&#xa;二元结果：支持 / 不支持" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3064" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="Acc_t = N_s,t/N_u,t；无链接对则为零&#xa;C. Acc = 对 Acc_t 取均值&#xa;E. Cit = 求和 N_s,t / |T|&#xa;只统计唯一且被支持的链接对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3320" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="人类验证 · 50 个中文任务&#xa;4 个智能体 × 每题 3 位专家&#xa;70+ 位硕士领域专家&#xa;225 人时 · 每人最多 3 个问题&#xa;ICC ≥ 0 后保留 37 题" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3320" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="DeepResearch Bench 报告&#xa;RACE 相对质量分&#xa;引用准确率 · 有效引用数&#xa;人类一致性证据" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeCol