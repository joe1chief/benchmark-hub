  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="952" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="公开问答与文本来源&#xa;LIC · HotpotQA + 2Wiki&#xa;DuReader · LooGLE · CMRC&#xa;MFQA（LongBench）&#xa;事实召回：PG-19 +《西游记》" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="证据边界&#xa;论文：arXiv:2402.05136v3&#xa;Git 63e7ae9 · HF 86a3b0e&#xa;主流程以论文 v3 为准" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="汇总 11 个双语问答集&#xa;单跳 7 个 · 多跳 4 个 · 英文 6 / 中文 5&#xa;改造 1,329 个 + 人工编写 2 个事实问答&#xa;= 1,331 个独特问答对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="混合支持文档与干扰文档&#xa;常规集：同源未选问答的上下文&#xa;Hotpot / DuReader：打散多份支持证据&#xa;采样 → 随机排序 → 前缀 Passage i" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="生成五档长度&#xa;16K · 32K · 64K · 128K · 256K&#xa;常规集：每问答每档一个上下文&#xa;事实召回：每档 200 个均匀证据位置" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="属于 CFI 集？&#xa;六个指定数据集" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="CFI · 6 集 · 557 个实例&#xa;Hotpot · LIC · MFQA 中/英&#xa;事实召回中/英&#xa;GPT-4 生成 2 条相似但事实不同的内容&#xa;语言学标注员消除冲突；随机插入" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="属于 KPR 集？&#xa;六个指定数据集" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="KPR · 6 集 · 1,924 条规则&#xa;Hotpot · CMRC · MFQA 中/英&#xa;事实召回中/英&#xa;数量：232 + 786 + 476&#xa;424 + 3 + 3&#xa;同时替换上下文与问答；复核一致性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="属于 AK 集？&#xa;除两个数据集外" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="AK · 9 集 · 955 个实例&#xa;除 CMRC 与 DuReader 外全部适用&#xa;标注答案的关键内容&#xa;两名标注员 · 一个工作日" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="发布 LV-Eval 测试工件&#xa;每档 1,729 个实例 × 5 = 8,645&#xa;上下文 · 问题 · 答案 · 长度 · 语言&#xa;按条件包含 AK 与混淆事实字段" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="使用各数据集专用零样本提示&#xa;直接作答 · 无统一解析器&#xa;贪心解码：常规 64 · 事实召回 16&#xa;超窗：保留头部与尾部" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="论文 v3&#xa;选择指标路径" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="9 个 AK 数据集&#xa;R_AK = overlap(pred, AK)&#xa;/ |AK|&#xa;门槛：中文 0.2 · 英文 0.4&#xa;未过 → 0；通过 → 黑名单词元 F1&#xa;中英文分别归一化" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="仅 CMRC&#xa;无答案关键词门控&#xa;黑名单感知中文词元 F1" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="仅 DuReader&#xa;无答案关键词门控&#xa;黑名单感知 ROUGE-L" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="汇报论文结果&#xa;11 个数据集 × 5 档长度&#xa;得分 = 100 × 样本分数均值&#xa;长度及单跳 / 多跳分析" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="构建共享词黑名单&#xa;Llama2-7B + ChatGLM3 生成答案&#xa;取与标准答案重合最高频的 100 个词&#xa;人工保留无信息量词" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;f