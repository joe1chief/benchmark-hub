  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="2288" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="审查既有图像编辑基准&#xa;GEdit • ImgEdit • Kontext • Reason-Edit&#xa;识别结构、视角与参考生成等缺口" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="448" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="补充策划新的编辑数据&#xa;提高任务与指令多样性&#xa;覆盖既有套件遗漏的能力" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1048" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="整合并扩展数据来源&#xa;统一图像编辑样本&#xa;保留细粒度任务意图" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="构建双语编辑样本对&#xa;输入图像 • 英文指令&#xa;语义对应的中文指令" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="内容级编辑&#xa;主体替换 13% • 添加 11% • 移除 9%&#xa;人像编辑 5% • 动作变化 6%" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="外观与上下文编辑&#xa;文字 9% • 背景 5% • 风格 3% • 材质 6%&#xa;色调 7% • 颜色 4%" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="648" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="高阶结构编辑&#xa;参考生成 10% • 视角变化 7%&#xa;结构编辑 4% • 目标检测 1%" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1104" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="封装数据字段&#xa;key • input_image • instruction_en&#xa;instruction_cn • task_type" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="984" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="发布 CEdit-Bench&#xa;1,464 对中英双语编辑样本&#xa;15 个细粒度类别 • MIT 许可证" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="1208" width="200" height="100" as="geometry"/></