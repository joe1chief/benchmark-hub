{
  "version": 1,
  "title": "DiagnosisArena 数据集构建流水线与临床诊断评测协议",
  "type": "academic-diagram",
  "source": "paper-grounded",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 16,
    "edges": 17,
    "modules": 2
  },
  "nodes": [
    {
      "id": "journal_corpus",
      "label": "顶级医学期刊病例库\n从 10 本国际顶级医学期刊搜集 4,175 份临床真实病例报告\n覆盖 28 个临床专科的疑难与罕见诊断挑战",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "claude_segmentation",
      "label": "Claude 3.5 Sonnet 临床文本分段\n解耦患者初始临床就诊信息与后续确诊病理及转归结果\n结构化抽取 4 个核心字段（病史、检验检查、鉴别诊断、黄金确诊）",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "leakage_gate",
      "label": "零诊断信息泄露门控？\n严格审查文本边界，确保隐去术后病理、特异性靶向治疗等提示\n防止就诊早期文本中包含直接暗示最终确诊结论的污染线索",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "leakage_discard",
      "label": "信息泄露病例剔除池\n剔除治疗方案直接明示疾病本体或分段不彻底的病例报告\n保障临床诊断基准具备真实的床旁盲态决策评测效度",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "multimodel_screening",
      "label": "多模型难度分级初筛\n采用 3 款基础大模型（GPT-4o、Claude 3.5、Gemini）各尝试 2 次\n快速区分常见典型病例与具备高鉴别难度的复杂疑难病例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hardness_gate",
      "label": "具备足够难度且 AI 全票通过？\n过滤各基础大模型轻而易举即可完全答对的典型常规题目\n筛选出 1,783 个适合深度逻辑临床推演的高难度候选病例",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "trivials_discard",
      "label": "简单常规病例剔除池\n排除教科书式常见病及无实质鉴别诊断争议的标准病例\n将评测重点高度聚焦于疑难、非典型及罕见临床病症",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "physician_verification",
      "label": "专科主治医师专家组裁决门控\n资深临床医师对病例信息的真实完整性与无歧义性进行复审\n经 DeepSeek-R1 (8次采样) 验证可解性后最终定稿 1,113 题",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "dataset_freeze",
      "label": "DiagnosisArena 官方冻结基准\n锁定 1,113 个高难度临床诊断病例（915 个公开测试集）\n标准确诊结论统一规范映射至 ICD-10 与 SNOMED-CT 医学本体",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "病史与辅助检查提示组装\n按时间线呈现主诉、现病史、既往史、查体结果及实验室生化指标\n支持开放式自由鉴别诊断生成或四选一多项选择题型格式",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "临床自回归诊断推演\n待测模型生成按可能性排序的鉴别诊断清单及临床依据\n采用贪婪解码策略 (T=0) 输出首选诊断与 Top-k 备选诊断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "entity_normalization",
      "label": "医学实体抽取与 UMLS 归一化\n利用 MedCAT 实体解析器结合同义词正则表达式抽取诊断词条\n将非结构化诊断术语规范映射至统一 UMLS 概念唯一标识符 (CUI)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "diagnosis_eval_gate",
      "label": "预测诊断与黄金确诊匹配？\n对比预测诊断实体与标准金标准病理诊断的语义概念等价性\n判定 Top-1 首选诊断命中状态及 Top-k 鉴别诊断候选覆盖情况",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "misdiagnosis_sink",
      "label": "误诊/漏诊错误分析池\n归类误诊病种、过早诊断闭合以及错失罕见病鉴别等失效模式\n按人体各大器官系统、疾病发病率及临床误诊严重程度统计",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "differential_scoring",
      "label": "Top-k 诊断准确率得分累加\n累计统计 Top-1 精确命中分值、Top-3 覆盖率与 Top-5 包含率\n评估模型输出的诊断置信度排序与临床实际严重程度的校准度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics_reporting",
      "label": "DiagnosisArena 官方指标发布\n公布全局 Top-1 确诊准确率 (%)、Top-3 及 Top-5 鉴别覆盖率 (%)\n并提供 28 个临床医学专科方向的详细诊断能力雷达图",
      "type": "terminal",
      "size": "xl"
    }
  ],
