  "nodes": [
    {
      "id": "b1",
      "label": "B1 · 锁定论文 v3\narXiv 2406.04264v3 · 2025-01-01\n九类任务 · 23 个 MLLM\nPDF SHA-256 653b5ca6…\nv1/v2：1,334 视频 · 2,593 问题",
      "type": "document",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b2",
      "label": "B2 · 构建 ULVC · 986 个视频\n电影 168 · 纪录 60 · 游戏 65\n监控 239 · 第一视角 100\n卡通 72 · 电视剧 92\n教程 60 · 体育 60 · 生活记录 70",
      "type": "database",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b3",
      "label": "B3 · 转换 ULVC\n选择 · 编辑 · 合成\nSSC 整片 · VS 约 10 分钟片段\n针式/动作任务使用 ULVC 背景\n主集 3 分钟至 2+ 小时 · 时间阶梯 3/6/10 分钟",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b4",
      "label": "B4 · 整体理解任务\nTR 355 · 人工主题选择题\nAR 239 · UCF-Crime 标签改选择题\nVS 257 · 人工纯视觉摘要\n任务级质检见 R1",
      "type": "user",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b5",
      "label": "B5 · 单细节任务\nNQA 415 · GPT-4 针式问答\nER 405 · Ego4D NLQ 改选择题\nPQA 589 · 人工唯一情节问答\nSSC 247 · 提示/描述/评分点",
      "type": "user",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b6",
      "label": "B6 · 多细节任务\nAO 329 · 动作探针排序\nAC 266 · 重复探针计数\nKinetics/ActivityNet + ULVC\n合成视频/问题/答案",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "r1",
      "label": "R1 · 任务级质量控制\nVS：纯视觉/按时序/无角色名\nNQA/AO/AC：背景中无目标内容\nPQA/SSC：唯一线索/无直接提示\nSSC：非重复评分点",
      "type": "process",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r2",
      "label": "R2 · 论文 v3 数据口径\n1,730 个视频 · 3,102 个问题\n开发集 2,593 · 测试集 509\n7 类选择题 + 2 类生成题\n开发集 4 选项 · 测试集 6 选项",
      "type": "database",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r3",
      "label": "R3 · 公开开发集结构\n选择题：video/duration/question\ncandidates/answer/question_type\nSSC 加 scoring_points · VS 无 candidates\n无 question_id/来源/质检字段",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r4",
      "label": "R4 · 标签与访问边界\n开发集答案公开\nee8ac098：测试答案隐藏\n当前答案：2025-03-18 已发布\nHF 视频/测试需通过门控\nCC BY-NC-SA 4.0 · 视频可变",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r5",
      "label": "R5 · 可复现版本锁定\n论文数据提交 4bcc3c0…\n开发 4a16523… · 评测 10b31fa…\nHEAD bc1a68d… · 无 Release\nHF 开发 06ddc388… · 测试 dc6616b2…",
      "type": "database",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r6",
      "label": "R6 · 论文未披露构建细节\n无 986→1,730 的逐项转换清单\n无划分方法/互斥性声明\n无标注一致性/拒绝率\n无去重或训练污染扫描",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "d1",
      "label": "D1 · 后续测试集漂移\n论文 v3：9 类任务 · 测试 509 题\n当前增加体育/教程问答\n11 类任务 · 测试 588 · 总计 3,181\n不计入论文口径",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "e1",
      "label": "E1 · 零样本评测\n使用官方实现/API\n图像 MLLM：多图帧序列\n视频 MLLM：各自官方采样\n不在 MLVU 上微调",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e2",
      "label": "E2 · 按模型采样\n均匀 N 帧或固定 N fps\nVideoChat2 16 · LLaMA-VID 1 fps\nGPT-4o 0.5 fps · Claude/Qwen 16\n无统一帧数预算",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e3",
      "label": "E3 · 选择题提示\n视频/图像模型系统提示\n问题 + 候选选项\n答案提示：\n“Only choose the best option.\nBest option: (”",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e4",
      "label": "E4 · 生成任务提示\n不加入选择题答案提示\nVS：固定摘要问题\nSSC：唯一 “Please describe…” 提示\n输出自由文本",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e5",
      "label": "E5 · GPT-4 裁判\n论文未说明版本/解码参数\n代码：gpt-4-turbo · temperature 0\nSSC：准确性 + 相关性\nVS：完整性 + 可靠性",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e6",
      "label": "E6 · 任务级输出\n选择题：预测 + 正确选项\nSSC：准确性 + 相关性\nVS：完整性 + 可靠性\n开发/测试结果分开报告",
      "type": "document",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "s1",
      "label": "S1 · 选择题准确率\n预测与正确选项精确匹配\nAccuracy_t = Correct_t / Items_t\nTR · AR · NQA · ER · PQA · AO · AC\n不给部分分",
      "type": "formula",
      "module": "score",
      "size": "xl"
    },
    {
      "id": "s2",
      "label": "S2 · M-Avg\n七类任务准确率的平均值\n不按题量加权的宏平均\n由论文表格复算和代码支持\n论文未直接打印此公式",
      "type": "formula",
      "module": "score",
      "size": "xl"
    },
    {
      "id": "s3",
      "label": "S3 · SSC 分数\n准确性：按评分点给 1–5 分\n相关性：1–5 分\nSSC = 平均准确性 + 平均相关性\n有效范围：2–10",
      "type": "formula",
      "module": "score",
      "size": "xl"
    },
    {
      "id": "s4",
      "label": "S4 · VS 分数\n完整性 1–5 · 可靠性 1–5\nVS = 平均完整性 + 平均可靠性\n有效范围：2–10\nFigure 8 写 “Correctness”；代码用可靠性",
      "type": "formula",
      "module": "score",
      "size": "xl"
    },
    {
      "id": "s5",
      "label": "S5 · G-Avg\n(SSC 任务分 + VS 任务分) / 2\n两类任务不加权宏平均\n可由论文表格复算\n论文未直接打印此公式",
      "type": "terminal",
      "module": "score",
      "size": "xl"
    },
    {
      "id": "s6",
      "label": "S6 · 评测器缺口\n无种子/解码参数/重复次数/方差\nchoice_bench.py 的 pred 未定义\n裁判脚本依赖脆弱文本查找\n无合并 G-Avg 的脚本",
      "type": "document",
      "module": "score",
      "size": "xl"
    }
  ],
