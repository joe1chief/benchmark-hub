      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "论文基线输入\n打乱选项 + 加入信息不足\n零样本思维链 · 图像置于文本后\n不提供工具",
      "type": "process",
      "size": "xl"
    },
