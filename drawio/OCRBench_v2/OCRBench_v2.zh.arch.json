  "nodes": [
    {
      "id": "scope",
      "label": "固定基准范围\n单图文本中心任务\n不评测多页长上下文\n各任务的双语覆盖不同",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "collect",
      "label": "收集并筛选 81 个数据集\n文本密集型学术来源\n补充自标注与私有来源\n覆盖 31 个实际场景",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "八类能力下定义 23 项任务\n识别 · 指代 · 端到端检测 · 抽取\n解析 · 计算 · 理解 · 推理\n相关任务可复用同一来源",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "guidelines",
      "label": "制定标注规范\n纳入常见数字与答案变体\n按从左到右、从上到下阅读\n坐标归一到 0–1,000",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "标注公开分支\n15 名专业标注员\n创建指令—回答对\n按任务添加坐标\nMarkdown · HTML · JSON · LaTeX",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "交叉复核公开记录\n标注员 1 完成 · 标注员 2 复核\n有分歧交由标注员 3 裁决\n无共识即删除 · 最终修正约 1%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release_gate",
      "label": "选择哪条数据分支？\n公开或私有",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "public",
      "label": "发布 10,000 条指令记录\n约 9,500 张图像 · 论文表 1\n英文 7,400 + 中文 2,600\n固定公开 HF c7e7cdf…",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "private_collect",
      "label": "独立收集私有集\n1,500 张图像\n实拍 735 + 无标签 765\n纸质书 · 电子书 · 扫描 · 网页\n对齐公开集 23 任务分布",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "private_annotate",
      "label": "单独标注私有集\n核验私有标签\n使用公开任务合同\n用于抗污染评测\n最终论文称：不发布",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "执行单图指令评测\n将模型输出写入 predict\n解析任务专属输出合同\n使用发布版 eval.py 路由",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_gate",
      "label": "应使用哪一种\n任务专属评测器？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "structured_metrics",
      "label": "结构/关系指标\n表格/图表：TEDS\n文档：STEDS\nKIE/映射：解析字典 F1\n公式：发布版归一化器",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "spatial_reading_metrics",
      "label": "空间/长文本指标\n文本定位：IoU\n位置 VQA：½ 内容 + ½ IoU\n检测：ICDAR Hmean @ IoU 0.5\n长文本：BLEU · METEOR\nF1 · 1−NED",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "count_vqa_metrics",
      "label": "计数/基础 VQA 指标\n字符计数：精确\n单词计数：归一化 L1\n选择题：精确选项\n短答：包含 · 长答：ANLS",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_means",
      "label": "按能力聚合\n每项能力内逐条取均值\n英文：21 任务 → 8 能力\n中文：9 任务 → 5 能力\n任务均值仅作诊断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "language_gate",
      "label": "对应哪一种分语言\n能力集合？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "en_macro",
      "label": "英文：八类能力均值\n识别 · 指代 · 端到端检测\n抽取 · 解析 · 计算\n理解 · 推理\n无权平均 · 0–100",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cn_macro",
      "label": "中文：五类能力均值\n识别 · 抽取 · 解析\n理解 · 推理\n不汇总：\n指代 · 端到端检测 · 计算",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "分语言报告\n各能力分数 + 宏平均\n公开结果 + 私有趋势\n无统一双语总分",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "source_boundary",
      "label": "来源/权利边界\nNeurIPS 2fd3db… · arXiv 8f4980…\n仓库 86d091… · HF c7e7cdf…\n公开 HF：10,000 条\n私有集：论文不放 · 新闻称已发布\nHF MIT · 仓库仅研究/非商用",
      "type": "document",
      "size": "xl"
    }
  ],
