  "nodes": [
    {
      "id": "taxonomy_schema",
      "label": "五阶段教育梯度分类体系\n小学、初中、高中、大学与高等竞赛数学\n结构化知识点图谱，包含阶段与主题元数据",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "theory_sourcing",
      "label": "数学理论知识概念采集\n源自权威教材、专业辞典与学术知识库\n涵盖概念定义、定理公理、数学性质与公式推导",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "applied_sourcing",
      "label": "实际应用题与竞赛题语料库\n收集自高考、AMC 10/12、大学期末与各类数学竞赛\n真实的多步文字应用题与数值计算任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "mcq_standardization",
      "label": "四选一单选题标准化改写\n将题目规范为唯一正确答案的 4 选项单选题\n设计高混淆度干扰项以惩罚浅层表面试探",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gpt4_ce_screen",
      "label": "GPT-4 循环评估初步初筛？\n对每道题目评估 4 次选项循环轮换变体\nCE 分流：剔除浅层 CE-4 题目，保留高区分度 CE-0/1/2",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "trivial_discard",
      "label": "简单/偏差题目剔除\n剔除所有轮换下均被轻易答对或存在表述缺陷的题目\n过滤低区分度候选题目",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "expert_audit",
      "label": "数学专家教研审核\n由专业数学教育工作者复核题意准确性与解析\n核验教育阶段匹配度与知识点归属",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "mathbench_freeze",
      "label": "MathBench 3,709 双语基准集冻结\nMathBench-T (理论集: 2,209) + MathBench-A (应用集: 1,500)\n中英双语平行的高质量评测全集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "cyclic_permutation",
      "label": "选项循环轮换生成器\n将选项循环轮换 N 次 (ABCD -> BCDA -> CDAB -> DABC)\n为每道题目构造 N 组对称的输入评测提示词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "大模型自回归推理评测\n对话模型采用零样本思维链 / 基座模型采用对数似然困惑度\n生成完整的逐步数学推导与选项判断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "perm_answer_parser",
      "label": "轮换感知答案解析器\n从各轮换提示的模型输出中提取所选选项字母\n将轮换后的字母映射回原始语义选项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "circular_eval_gate",
      "label": "全部 N 次轮换均回答正确？\n严格核验在全部 4 次循环置换中均选出正确语义\n要求对选项位置摆放具有 100% 的鲁棒一致性",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "ce_full_pass",
      "label": "循环评估通过 (CE Pass)\n获得基准评测完整计分\n证明模型具备真正的数学理解而非概率蒙猜",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "ce_permutation_fail",
      "label": "选项轮换不一致失败\n在一次或多次选项置换中发生错误（位置偏置）\n在严格 CE 指标下判定为未解出（计 0 分）",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "benchmark_metrics",
      "label": "MathBench 综合指标汇总\n常规单次准确率 vs 严格 CE 循环准确率 (0–100%)\n各教育阶段表现与理论/应用能力均衡度对比",
      "type": "terminal",
      "size": "xl"
    }
  ],
