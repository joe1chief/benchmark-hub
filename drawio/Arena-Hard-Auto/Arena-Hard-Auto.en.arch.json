      "type": "process",
      "size": "xl"
    },
    {
      "id": "parser",
      "label": "Pinned Verdict Parser\nNo Label → Continue; At Most 2 Attempts\nSingle / Repeated Same Label → Accept\nConflicting Labels → Invalid; No Retry",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalized_battles",
      "label": "Normalize Second-Game Position\nStrong Win/Loss ×3 • Slight ×1\nTie Preserved • Invalid Dropped",
