  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1344" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="FLORES-200 Parallel Passages&#xa;488 Distinct Passages&#xa;Wikinews • Wikijunior • WikiVoyage" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Authoring Guidelines First&#xa;Passage-Only Comprehension • No External Knowledge&#xa;Plausible Distractors • No Ambiguity or Shortcuts" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Five-Round English MCQ Authoring&#xa;Four Options • Exactly One Correct&#xa;Provider Revises from Round Feedback" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Human Sampling Review Each Round&#xa;Inspect Difficulty and Ambiguity&#xa;Feed Findings into the Next Round" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Automatic Shortcut QA&#xa;Lexical Overlap • Answer Length • Bag-of-Words&#xa;Check Correct-vs-Distractor Feature Balance" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Final English Set&#xa;Filter About 20% in Final Round&#xa;900 Questions over 488 Passages" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Expert Human Translation&#xa;Questions and Answers Only • Never Machine Translation&#xa;Align Ambiguities to the Existing FLORES Passage" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Independent Proofreading&#xa;Second Annotator Edits Every Translation&#xa;Preserve Localized Passage Alignment" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value=