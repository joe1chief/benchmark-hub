  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1344" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="FLORES-200 平行段落&#xa;488 个不同段落&#xa;Wikinews • Wikijunior • WikiVoyage" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="编写前先应用指南&#xa;仅依赖段落 • 无需外部知识&#xa;干扰项可信 • 无歧义和捷径" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="五轮英文 MCQ 编写&#xa;四个选项 • 仅一个正确答案&#xa;供应方依据每轮反馈修订" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="每轮人工抽样检查&#xa;检查难度和歧义&#xa;将发现反馈到下一轮" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="自动捷径检查&#xa;词汇重叠 • 答案长度 • 词袋模型&#xa;比较正确项与干扰项特征分布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="最终英文题集&#xa;末轮过滤约 20%&#xa;488 个段落上的 900 题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="专家人工翻译&#xa;仅翻译问题和答案 • 禁止机器翻译&#xa;歧义表达与既有 FLORES 段落对齐" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="独立校对&#xa;第二位标注者编辑每条翻译&#xa;保持与本地化段落的配对" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="印地语 • 孟加拉语 • 乌尔都语&#xa;尼泊尔语 • 僧伽罗语？&#xa;仅这五种语言需要拉丁文字变体" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="条件式 IndicXlit 支路&#xa;标注者将本族文字转为拉丁文字&#xa;复核问题、答案与段落配对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;stro