  "nodes": [
    {
      "id": "monthly_papers",
      "label": "收集上月论文\n近期 arXiv 数学研究\n覆盖多样领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "candidate_pool",
      "label": "生成约 200 道候选题\n聚焦核心研究结果\n一个可验证最终答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "screening",
      "label": "筛选并修订问题\n补齐论文全文上下文\n删除存疑候选题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_review",
      "label": "MathArena 团队最终审核\n核验清晰性与正确性\n批准标准答案",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布约 30 道问题\n月度动态基准\n保存最终标准答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_outputs",
      "label": "生成模型输出\n使用默认参数\n不启用搜索或代码工具",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parser",
      "label": "运行精确答案解析器\n符号等价判断\n与标准答案比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "llm_judge",
      "label": "并行运行 LLM 裁判\n独立检查答案正确性\n比较最终判定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "format_gate",
      "label": "解析格式失败？\n有效解析不做修复\n仅路由格式失败",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "restate",
      "label": "要求模型重述答案\n使用预期答案格式\n不修改答案内容",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parser_retry",
      "label": "重试一次解析器\n解析重述后的最终答案\n保留新的判定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agreement_gate",
      "label": "解析器与裁判一致？\n分歧少于 1%\n仅路由例外情况",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "manual_review",
      "label": "人工复核少于 1% 的分歧\n仅解决不一致结果\n记录最终判定",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告最终准确率\n汇总重复运行结果\n跟踪月度版本",
      "type": "terminal",
      "size": "xl"
    }
  ],
