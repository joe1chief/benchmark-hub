<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1392" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="通过邮件招募临床指令作者&#xa;共 15 名执业临床医生&#xa;覆盖 7 个医学专科&#xa;通过在线表单提交" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="第一阶段：收集指令&#xa;构想日常 EHR 工作情境&#xa;提交 1314 条问题或命令&#xa;附患者特征与临床语境" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="是否存在 ROUGE-L 相似度&#xa;高于 0.7 的近重复指令？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="移除近乎相同的指令&#xa;不进入 983 条指令目录" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="保留 MedAlign 指令目录&#xa;共 983 条去重指令&#xa;其中 407 条适用于一般患者&#xa;六大类与二十个子类" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="指令是否标记为&#xa;适用于一般患者？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="保留为仅含指令的记录&#xa;不匹配 EHR 也不生成参考回复&#xa;仍属于全部 983 条指令" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="第二阶段：构造检索查询&#xa;指令 + 患者特征&#xa;+ 预期临床语境&#xa;对比 BM25Okapi 与随机采样" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="准备纵向 EHR 索引&#xa;含时间戳的结构与文本事件&#xa;OMOP CDM → 每份记录一个 XML&#xa;随机抽取 77200 名患者" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="检索并审核候选病历&#xa;BM25 为每条查询返回 top-5&#xa;按排名复核并在首个相关项停止&#xa;随机基线使用同一患者池" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="top-5 中是否至少一份 EHR&#xa;经人工判定为相关？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="不进入有依据回复的子集&#xa;top-5 中没有相关 EHR&#xa;指令仍保留在 983 条目录中" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="第三阶段：撰写专家回复&#xa;优先分配同专科非原作者&#xa;检查可行性与 EHR 信息充分性&#xa;以病历最新时间为锚作答" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="发布论文中的 MedAlign 合同&#xa;983 条指令 · 303 条参考回复&#xa;303 个相关配对 · 276 份不同 EHR&#xa;BM25 top-5 为 74% · 随机为 38%" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="访问与版本边界&#xa;完整数据需 Redivis + CITI + DUA&#xa;论文 v2 为 276 份 EHR；仓库称 275&#xa;回复阶段剔除量未披露" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="评测六种模型配置&#xa;GPT-4 多配置 · Vicuna-7B/13B · MPT-7B&#xa;使用相同指令与匹配 EHR 提示&#xa;为生成预留 256 Tokens" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="是否使用 GPT-4 32k&#xa;多步精炼配置？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="构造单上下文提示&#xa;扣除提示、指令与 256 Tokens&#xa;从病历开头截断&#xa;尽量保留最近的 EHR 内容" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="执行多步精炼&#xa;将完整 EHR 切为 30k-token 块&#xa;从最早到最新依次处理&#xa;更新或保留上一版回复" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="模型 API 是否返回&#xa;临床文本回复？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="保留内容过滤错误结果&#xa;44 题影响至少一个 GPT-4 配置&#xa;主分析正确性：失败输出记错&#xa;补充分析排除后为 259 题&#xa;主表 303 题的排名处理未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="九名临床医生盲法评测&#xa;向医生展示完整且未截断的 EHR&#xa;不评自己提交的指令或回复&#xa;随机模型顺序并允许并列&#xa;其中 50 个配对由三人复核" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="记录二元临床正确性&#xa;临床不当、改变解释的错误&#xa;或未回答指令 → 错误&#xa;主分母为每种配置 303 个配对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="汇总人工偏好&#xa;按相关性与适当性排序&#xa;报告平均排名与严格胜率&#xa;内容过滤错误的排名处理未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="计算自动文本生成指标&#xa;无源指标只使用标准参考回复&#xa;COMET 与 UniEval 另用 BM25 EHR 片段&#xa;将指标得分转换为模型排名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="发布 MedAlign 评测结果&#xa;正确率 · 平均排名 · 两两胜率&#xa;指标排名与人工排名的平均 Kendall Tau&#xa;分析模型与上下文长度影响" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="可复现性边界&#xa;已锁定公开仓库只有样例而无评测器&#xa;自由文本输出不存在答案解析器&#xa;仓库未发布自动指标代码版本" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=a