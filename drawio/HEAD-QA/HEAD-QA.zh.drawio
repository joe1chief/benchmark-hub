<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="672" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据边界&#xa;arXiv:1906.04701v1&#xa;aghie/head-qa @ da54ff2&#xa;dvilares/head_qa @ d444ead&#xa;数据集脚本版本 1.1.0" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="收集西班牙公共医疗考试&#xa;医疗系统专业岗位资格考试&#xa;使用 2013 年起的官方试卷" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="保留六个医疗领域&#xa;医学 · 药学 · 心理学&#xa;护理 · 生物学 · 化学" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="按来源实施排除&#xa;放射物理的 PDF 公式难以可靠解析&#xa;移除考试后被官方作废的题目" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="官方记录 schema&#xa;name / year / category / qid&#xa;qtext / ra / 可选 image&#xa;answers 包含 aid + atext" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="官方按年份切分&#xa;2013-14 训练：2,657&#xa;2015 验证：1,366&#xa;后续测试：2,742 · 总计 6,765" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="西班牙文视图：同一 6,765 行&#xa;2013-14：五个选项&#xa;后续考试：四个选项&#xa;约 14% 医学题引用图像" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="用 Google API 翻译成英文&#xa;翻译题干与答案文本&#xa;保留 ID / 标签 / 图像 / 切分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="抽检 60 条随机翻译&#xa;双语充分性：4.35 / 5&#xa;第二位充分性：4.71 / 5&#xa;英语母语流畅度：4 / 5" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1640" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文西班牙文基线&#xa;Length / Random / Blind / IR&#xa;不使用题目引用的图像&#xa;无规范 LLM 提示词或生成配置" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1920" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="论文英文 / 跨语言实验&#xa;使用翻译后的题目与选项&#xa;Length / Random / Blind / IR / DrQA&#xa;官方代码中 DrQA 仅用于英文&#xa;无规范 LLM 提示词或生成配置" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1920" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="官方 eval.py 契约&#xa;预测行 = qid + 答案 ID&#xa;真值行 = qid + 答案 ID&#xa;&quot;-&quot; 表示未作答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2224" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="准确率 + 宏观 P/R/F1&#xa;官方 POINTS 计分&#xa;答对 × 3 · 答错 × -1&#xa;未作答贡献 0" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;ex