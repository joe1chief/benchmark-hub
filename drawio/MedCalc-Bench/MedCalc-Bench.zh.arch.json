  },
  "nodes": [
    {
      "id": "mdcalc_calculators",
      "label": "MDCalc 临床医学计算器目录\n精选 55 个覆盖急诊与重症监护的临床常用医学计算器\n包含 19 个基于规则的离散评分系统与 36 个连续方程计算器",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "open_patients_corpus",
      "label": "Open-Patients 临床病历语料库\n汇总 MIMIC-IV、MTSamples 与 PMC 的 18 万份脱敏病历\n涵盖详尽的患者人口统计学、生命体征及实验室生化检验指标",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "llm_extraction_pipeline",
      "label": "两阶段大模型属性抽取流水线\nGPT-3.5 Turbo 初筛病历，GPT-4 深度抽取公式必需临床参数\n精准提取年龄、体重、实验室血生化检验值与合并症评分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "coverage_completeness_gate",
      "label": "必需临床参数是否完全覆盖？\n检验病历中是否显式完整包含目标计算器所需的全部生理参数\n识别缺乏足够天然真实病历表征的特定计算任务",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "synthetic_note_generation",
      "label": "临床医生专业病历合成\n执业医师针对缺乏公开病历的 21 个计算器合成逼真临床记录\n确保 55 个计算器各自拥有恰好 20 个高质量的评测样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "expert_validation_gate",
      "label": "医学专业人员复核验证门控？\n执业临床医生逐项人工比对病历文本与抽取的属性数值\n校正 OCR 乱码、计量单位不一致及语义参数对应偏差",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_note_discard",
      "label": "错误抽取与瑕疵病历剔除池\n剔除存在歧义、数值物理矛盾或单位冲突的不合格病历\n确保所有测试病历在临床医学与生理学上 100% 真实可靠",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "medcalc_freeze",
      "label": "MedCalc-Bench 冻结评测基准\n1,100 个经医学专家严格审计的临床实例 (55 任务 x 20 题)\n配套详细的分步数学推导过程与标准确定性数值结果",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "临床计算提示词组装\n整合原始病历文本、明确的临床医学计算问题及目标单位\n支持零样本直接提示、零样本思维链及单样本思维链评测",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "自回归数学与临床推理\n待测模型从复杂文本中抽取数值并执行临床公式计算\n生成分步临床推理陈述以及最终框定的数值答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "regex_numeric_extraction",
      "label": "数值答案抽取与正则解析引擎\n从生成回答中提取计算所得医学数值、离散评分或日期\n标准化度量单位、小数位数、科学计数法及舍入规则",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "calculator_type_routing",
      "label": "计算器类型评测分流？\n基于规则的离散评分系统 vs 基于连续方程的医学计算器\n根据临床应用场景制定差异化的容差判定阈值",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "rule_exact_match_gate",
      "label": "规则评分精确匹配？\n要求离散整型得分必须完全相等（容差为 0）\n评估 CHA2DS2-VASc、CURB-65 与格拉斯哥昏迷评分 (GCS) 等",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "equation_tolerance_gate",
      "label": "连续计算处于 5% 相对容差内？\n验证预测连续数值满足相对误差比率 |Y - Y*| / Y* <= 0.05\n评估肾小球滤过率 (GFR)、阴离子间隙 (Anion Gap) 及 MELD 等",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "calculation_error_sink",
      "label": "计算失败与超差分析池\n归纳参数抽取遗漏、公式计算错误及量纲单位换算失误\n精细定位模型在信息抽取、数学计算与临床推理间的短板",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "metrics_reporting",
      "label": "MedCalc-Bench 官方指标报告\n全局计算准确率 (%)、规则评分准确率（严格精确匹配）\n及连续方程计算准确率（5% 相对误差容差）",
      "type": "terminal",
      "size": "xl"
    }
  ],
