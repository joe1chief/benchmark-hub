  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1392" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Aggregate Eight Medical QA Sources&#xa;MedQA · PubMedQA · MedMCQA · MedBullets&#xa;MMLU · MMLU-Pro · MedExQA · MedXpertQA&#xa;MedXpertQA Splits into R and U" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Standardize Multiple-choice Records&#xa;Question · Option Map · Gold Index&#xa;Preserve Dataset and Real-item IDs&#xa;Three to Ten Answer Options" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Probe Each Candidate across Models&#xa;Use Multiple Model Architectures&#xa;Count k Correct among N Tested&#xa;Avoid One-model Difficulty Bias" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Is the Correct-model Fraction&#xa;k / N Strictly below 50%?" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Sample Hard Candidates per Subset&#xa;Maximum 100 from Each Subset&#xa;Balance Nine Evaluation Subsets&#xa;Preserve Source Diversity" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Annotate Reasoning Depth&#xa;Four Clinical-year Medical Students&#xa;Five Levels of Minimum Inference Steps&#xa;Calibration + Overlap for Agreement" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Review Question Validity&#xa;Flag Wrong Gold · Poor Context&#xa;Flag Outdated or Irrelevant Knowledge&#xa;Any Flag Triggers Group Review" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Do Fewer than Two Annotators&#xa;Agree the Concern Is Valid?" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Run MELD Contamination Screening&#xa;Remove Options · Split Question in Half&#xa;Generate the Unseen Second Half&#xa;Compare by Levenshtein Similarity" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Integrate Both Verification Controls&#xa;Human Validity + MELD Evidence&#xa;MELD Cutoff + Exclusions Undisclosed&#xa;Final-count Reconciliation Undisclosed" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Exclude from Paper Hard Set&#xa;Easy Candidate or Validity Failure&#xa;Twenty-one Human-review Exclusions&#xa;5 Wrong · 5 Context · 11 Relevance" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Release Paper-v3 MedicalAgentsBench&#xa;862 Questions · Mean 147.4 Tokens&#xa;Seven Subsets × 100 + MedBullets 89&#xa;+ MMLU 73 across Nine Subsets" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Pinned Public-release Drift&#xa;Git v1.0 + HF/Zenodo Add AfriMedQA 32&#xa;README Task Table Totals 894, Not 862&#xa;Paper Gives No Reconciliation" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Run Standardized Evaluations&#xa;7 Base + 3 Internalized Models&#xa;Nine Externalized Methods; Coverage Varies&#xa;SPO/AFlow: GPT-4o-mini / GPT-4o Only&#xa;Hard-set Agents · Three Runs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Extract One Option Label&#xa;Method-specific JSON or LLM Parsers&#xa;Reimplemented Agent Parsers Where Needed&#xa;No Single Universal Parser Is Released" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="Did the Runner Emit a Result Row&#xa;with realidx and predicted_answer?" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" valu