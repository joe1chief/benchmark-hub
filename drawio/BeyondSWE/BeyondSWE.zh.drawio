    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="各任务候选来源&#xa;PR • 外链 • 依赖升级&#xa;新仓库 • 任务规范" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="CrossRepo 候选漏斗&#xa;约 3,000 个含外链的合并请求&#xa;需要仓库外部知识" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="DomainFix 候选漏斗&#xa;约 800 个合并请求&#xa;21 个仓库 • 11 个研究领域" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="DepMigrate 候选漏斗&#xa;LLM 过滤 → 约 7,000 个候选&#xa;23 个发生版本升级的软件包" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Doc2Repo 候选漏斗&#xa;2025 年创建的 Python 仓库&#xa;持续活跃 • ≥3 位贡献者 • &gt;20 星" style="rounded=1;arcSize=20;h