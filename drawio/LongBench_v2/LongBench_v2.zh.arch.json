    {
      "id": "annotators",
      "label": "97 名合格标注专家\n经过严格筛选的英文母语及双语专业领域学者\n接受针对长文本问答构建的系统化专业培训",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "documents",
      "label": "英文原始长文档汇聚\n涵盖学术论文、法典专著、文学作品与深度行业报告\n汇集高质量长上下文多领域真实语料库",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "text_extract",
      "label": "PyMuPDF 文本提取与排版解析\n从 PDF 及 HTML 原始文档中提取纯净连续文本流\n剔除排版噪声、多余表格杂质与 OCR 乱码",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_filter",
      "label": "文档长度与去重准入判定\n严格强制最低词数阈值要求（>8,192 词）\n采用 MinHash 算法对标准评测基准进行深度去重",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "doc_reject",
      "label": "不合格文档淘汰流\n丢弃过短、排版损坏或内容高度重复的候选文本\n记录淘汰依据用于全流程数据审计",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "annotation",
      "label": "多选题编写与关键证据针定位\n人工设计高难度四选一问答题目\n精确标注跨上下文的多跳支撑性证据句位置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qa_review_gate",
      "label": "三模型与24位专家联合质检闸门\n前沿大模型初筛（GPT-4o、Claude 3.5、Gemini 1.5）\n由独立领域专家进行双盲交叉核验与难度把关",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revision",
      "label": "迭代修正循环（<= 5 轮）\n标注员根据模型及同行评审反馈修改题干与干扰项\n剔除可通过短上下文浅层启发式规则解出的题目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "terminate",
      "label": "超时题目终止淘汰（> 5 轮）\n对超出最大修改轮次限制的题目予以永久舍弃\n维持严格的基准题目质量标准",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "final",
      "label": "503 道终选英文单选问答\n最终冻结的 LongBench-v2 官方黄金评测集\n在 8k 至 128k 词的不同长度与领域间均衡分布",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_prompt",
      "label": "长上下文评测提示词组装\n标准化提示词框架集成完整上下文文本与题目\n支持零样本（Zero-shot）与少样本评测规范",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "模型长文本理解与生成推理\n在 8K 至 128K 超长上下文窗口下执行模型前向推理\n解析并提取模型输出的选项预测代号（A、B、C、D）",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "scoring_pipeline",
      "label": "分层准确率打分与能力分析\n统计 6 大核心领域任务的综合宏观准确率\n按不同上下文长度区间进行模型衰退分层评测",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "leaderboard_report",
      "label": "LongBench-v2 官方排行榜发布\n长文本有效上下文容量综合评级报告\n冻结发布硬核长文本推理基准测试集",
      "type": "terminal",
      "size": "xl"
    }
  ],
