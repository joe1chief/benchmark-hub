<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1784" pageHeight="552" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据：arXiv:2411.04872v7&#xa;官方 gist @ 39d23771 + 当前 v2 页面&#xa;私有基准；无公开完整数据集仓库" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="与 60+ 位数学家合作&#xa;来自十多个国家的高校&#xa;专长覆盖现代数学主要领域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="创作全新、未发表的问题&#xa;覆盖约 70% 的 MSC2020 顶级学科&#xa;专家解题耗时数小时至数天" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="执行四项命题要求&#xa;原创 · 可自动核验&#xa;不可猜中 · 计算上可处理" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="提交题面 + 详细解答 + 验证器&#xa;学科与技巧分类&#xa;背景 · 创造 · 执行三维难度" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="至少一次领域专家盲审&#xa;检查正确性、歧义、不可猜性&#xa;审核验证器/元数据/难度；失败则修订" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="控制原创性与污染风险&#xa;安全处理 + 专家检索公开来源&#xa;Quetext/Copyscape 仅检查题面" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="v2 2026-06-12：共 338 题&#xa;Tiers 1–3 295 题 + Tier 4 43 题&#xa;公开 12 题：前三级 10 + 第四级 2，均已包含&#xa;修正 123+12；移除 5+7" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="版本边界：不可混合两套协议&#xa;论文：10,000 token + 标记/pickle；非当前&#xa;v2 已替换该历史提交循环" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="当前 v2：python + submit_answer&#xa;硬上限 1,000,000；660,000 时强制提交&#xa;Python 无状态；每次工具调用最多 30 秒" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="提交 answer()；无参数&#xa;返回指定类型对象；不输出且无注释&#xa;answer 最多运行 30 秒；未提交即错误" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="在沙箱运行私有 verify(answer())&#xa;True → 1；False/错误/超时/无答案 → 0&#xa;报告准确率；完整验证器集仍为私有" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" paren