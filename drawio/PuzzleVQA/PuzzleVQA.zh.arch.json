{
  "version": 1,
  "title": "PuzzleVQA 构建与评测流程",
  "type": "academic-diagram",
  "source": "paper-grounded",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 30,
    "edges": 33,
    "modules": 2
  },
  "nodes": [
    {
      "id": "source_evidence",
      "label": "固定官方证据\narXiv 2403.13315v3\nPDF a7cc824f4ed3\n论文期代码 e974881fd10a",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "task_scope",
      "label": "定义抽象图案视觉问答\n诊断视觉感知\n归纳与演绎能力\n无需大量世界知识",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "concepts",
      "label": "四类基础概念\n数字 · 颜色\n大小 · 形状",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "mode_taxonomy",
      "label": "组合谜题模式\n四类单概念题\n六类双概念题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "categories",
      "label": "十个谜题类别\n每类 200 条测试题\n同时覆盖单概念与双概念",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "templates",
      "label": "设计 20 个多模态模板\n每类别两个模板\n定义对象 · 布局\n规律 · 示例 · 问题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "define_layout",
      "label": "固定布局与抽象规律\n使用直接明确的规则\n避免不必要复杂度\n保证程序化正确性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "populate_objects",
      "label": "随机填充具体对象\n满足模板规律\n形成多组用于展示\n底层规律的示例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "construct_query",
      "label": "构造缺失对象问题\n选择一个目标答案\n用问号隐藏该对象",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "make_choices",
      "label": "构造选择题选项\n通常为四个选项\n大小题为三个选项\n启发式采样干扰项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "render_image",
      "label": "使用 Python 渲染谜题\nPillow 绘制图像对象\n扩增模板与对象组合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reasoning_text",
      "label": "生成标准推理解释\n图像描述对应视觉感知\n规律解释对应归纳\n推导步骤指向最终答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "record_schema",
      "label": "保存七个记录字段\n图像 · 问题 · 选项 · 答案\n描述 · 规律解释 · 推导",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "paper_dataset",
      "label": "PuzzleVQA 论文数据集\n20 个模板 × 各 100 条唯一题目\n20 个 JSONL 文件 · 共 2,000 行\n仅测试基准",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_input",
      "label": "评测同一批 2,000 道题\n输入图像 + 问题 + 选项\n零样本设置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt_gate",
      "label": "选择诊断提示\n基线提示或逐级加入\n标准信息的提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "zero_shot",
      "label": "零样本思维链基线\n先描述图像\n再逐步思考",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "guided_caption",
      "label": "引导视觉感知\n在问题前加入\n标准图像描述",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "guided_induction",
      "label": "引导感知与归纳\n加入图像描述\n+ 标准规律解释",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "guided_deduction",
      "label": "引导至演绎阶段\n图像描述 + 规律 + 推导\n在揭示答案前停止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_output",
      "label": "多模态模型输出\n贪心解码\n推理过程 + 候选选择",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "direct_regex",
      "label": "解析模型原始响应\n优先最后一个带括号 A–D\n回退到最后一个裸 A–D",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extraction_prompt",
      "label": "直接解析失败时\n将原输出交给模型\n并附加明确选项触发语",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fallback_regex",
      "label": "对二次响应复用同一解析器\n优先最后一个带括号 A–D\n回退到最后一个裸 A–D",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parsed_answer",
      "label": "将字母映射为选项\n生成一个预测答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "报告准确率\n正确预测数\n除以 2,000 道题",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "paper_release",
      "label": "论文匹配代码快照\ne974881fd10a\n生成代码 4f1278484889\n提示代码 e7be8ba6639b\n主程序 6e0f5d9db945",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "current_release",
      "label": "当前仓库边界\n9b3a074cca0c\n后续仓库变更\n不得改写论文口径",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "scope_boundary",
      "label": "基准范围边界\n本图仅表示 PuzzleVQA\nAlgoPuzzleVQA 属于\n后续独立基准路线",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "license_boundary",
      "label": "许可时间边界\n论文匹配快照没有 LICENSE\n当前快照后来加入 MIT\n不将许可文件追溯至论文期",
      "type": "document",
      "size": "xl"
    }
  ],
