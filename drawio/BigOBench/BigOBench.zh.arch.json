      "size": "xl"
    },
    {
      "id": "expand",
      "label": "系统化扩展输入\n独立 / 联合增长参数规模\n随机与恒等扩展策略",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "profile",
      "label": "隔离动态性能分析\nBubblewrap 沙箱\ncProfile运行时间 + tracemalloc内存",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fit",
      "label": "推断复杂度曲线\n非负最小二乘\n最小残差 + 简单性偏置 + 曲线系数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "BigO(Bench) 发布\n3,105题 / 1,190,250份解答\n时空类别 + 系数 + 原始性能数据",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "validate",
      "label": "框架验证\n与人工标注匹配：时间92% / 空间84%\n审计数据覆盖率与测试集标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "tests",
      "label": "整理复杂度测试集\n时间：311题 / 640解答 / 11类\n空间：308题 / 636解答 / 5类 • 重叠63题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "predict",
      "label": "任务一：复杂度预测\n输入题目 + 人类解答\n采样20次模型输出\n预测时间与空间Big-O类别",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prediction_metric",
      "label": "任务一：20次采样无偏估计\nPass@k • Best@k • All@k\n时间与空间类别准确率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "任务二：约束代码生成\n输入题目 + 可行目标复杂度\n生成满足约束的正确Python解答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generation_metric",
      "label": "任务二指标：每题20次采样\nPass@k • Best@k • All@k\n同时检查正确性与复杂度约束",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rank",
      "label": "任务三：系数排序\n生成20个候选解答\n在同一Big-O类取最佳正确系数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ranking_metric",
      "label": "任务三系数分数\n20次尝试取最佳值\n无正确解记0\n对人类解答计算系数百分位",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "汇报三项并行评测\n预测准确率 • 生成指标\n系数百分位排序",
      "type": "terminal",
      "size": "xl"
    }
