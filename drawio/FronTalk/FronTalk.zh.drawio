    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1624" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="真实世界网站池&#xa;抽样 10,000 个 C4 页面&#xa;后续排除低信息&#xa;种子页面" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="网站摘要与聚类&#xa;GPT-4o 生成内容&#xa;+ 功能摘要&#xa;BERTopic 聚类" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="人工选择网站&#xa;主要主题簇各选&#xa;一个有效网站&#xa;共 100 个多样化种子" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="十轮意图 + 测试&#xa;GPT-4o 每轮随机选择&#xa;功能类 / 设计类&#xa;每个意图配可验证测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="人工精炼&#xa;全部测试均复核&#xa;删除 66 个（1.7%）&#xa;编辑 2,783 个（73.4%）&#xa;抽样 224 个：90.1% -&gt; 94.7%" style="rounded=1;arcSize=