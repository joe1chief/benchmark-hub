      "type": "document",
      "size": "xl"
    },
    {
      "id": "design_goal",
      "label": "隔离指令可遵循性\n固定到目标的求解路径\n最小化隐式知识\n测量直接多步推理",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "task_criteria",
      "label": "应用任务设计条件\n明确给出完整程序\n每个人类操作步骤都简单\n只需基础英文知识",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_families",
      "label": "定义 23 个不同任务族\n字符串、列表和整数状态\n覆盖多种状态转移规则\n不需专业领域知识",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "fixed_templates",
      "label": "每类任务编写固定模板\n给出完整求解程序\n规定具体输入字段\n要求输出全部结果状态",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_schedule",
      "label": "安排受控问题长度\n问题长度为 2 至 25 步\n每个长度生成 10 例\n每个任务族共 240 例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_generator",
      "label": "运行任务专用生成器\n抽取字符串、列表或数字\n执行模板规定的操作\n保存问题配置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_gate",
      "label": "强制满足目标步数\n比较生成状态长度\n丢弃步数不符的样本\n重采样直至填满配额",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ground_truth",
      "label": "同步生成标准答案\n保存初始状态\n保存全部中间状态\n保存类型化最终状态",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "benchmark_release",
      "label": "冻结论文口径 ProcBench\n23 个任务族 × 每类 240 例\n总计 5,520 个样本\n固定模板与具体问题配对",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "length_splits",
      "label": "派生长度分组\n短：2 至 6 步\n中：7 至 16 步\n长：17 至 25 步",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_prompt",
      "label": "提示输出完整序列\n提供模板与具体问题\n要求中间及最终状态\n不使用任务专用辅助提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "raw_response",
      "label": "收集模型自由文本\n保存原始答案\n保存模型用量元数据\n将文本交给统一抽取器",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "extraction_schema",
      "label": "推断每类任务的类型模式\n读取标准答案字段类型\nintermediate：类型化列表\nfinal：整数、字符串或列表",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gpt4o_parser",
      "label": "使用 GPT-4o 规范化\n模型 gpt-4o-2024-08-06\nPydantic 结构化输出解析\n中间列表不得重复最终状态",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_outcome",
      "label": "形成解析后的预测\n保留 intermediate 与 final\n保持任务专用类型\n解析失败时插入空预测",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "exact_comparison",
      "label": "精确比较状态元素\n转换整数或字符串预测\n列表长度与顺序必须相同\n首次不匹配即停止前缀",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prefix_match_length",
      "label": "计算前缀匹配长度\n从第一个预测状态开始\n统计连续精确匹配数\n首次错误即停止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prefix_accuracy",
      "label": "计算前缀准确率\n用较长序列长度归一化 PML\n惩罚多余预测状态\n惩罚缺失预测状态",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sequential_match",
      "label": "计算完整序列匹配\n仅当 PA 等于一时取一\n其余情况取零\n要求整个序列相等",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_match",
      "label": "计算最终状态匹配\n比较目标和预测的末状态\n忽略此前状态的不匹配\n返回二值结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate_report",
      "label": "报告四项逐步指标\nPML · PA · SM · FM\n按模型与任务求平均\n同时按长度分组汇总",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "固定发布与许可边界\nGit 树 7aaeabca63f9 · MIT\nHF 树 95499b2392f3 · CC BY 4.0\n23 个任务文件 · 5,520 行\n代码与数据许可证不同",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "review_boundary",
      "label": "复核来源边界\n生成器直接产生精确真值\n长度不符时触发重采样\n论文未披露人工复核阶段\n不推断存在人工标注",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "parser_boundary",
      "label": "解析提示边界\n固定 GPT-4o 抽取模型\n动态类型化 Pydantic 模式\n失败时返回空预测\n报告指标包含解析影响",
      "type": "document",
      "size": "xl"
    }
  ],
