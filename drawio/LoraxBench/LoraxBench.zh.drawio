  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3104" pageHeight="1536" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定主要证据&#xa;arXiv 2508.12459v1 · 2025-08-17&#xa;google/LoraxBench @ 1ebe2dac&#xa;七个 Parquet 文件 · CC BY 4.0" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义 20 种语言 · 23 个子集&#xa;印尼语 + 19 种本地语言 · 三种各分为两个语域&#xa;爪哇语 · Krama / Ngoko&#xa;巽他语 · Lemes / Loma&#xa;马都拉语 · Engghi Ethen / Enja’Iya" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="将六类印尼语源任务并行分流" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="568" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="阅读理解 · TyDi-QA&#xa;印尼语 Secondary Task&#xa;保留文章 + 问题 + 文中答案片段&#xa;每子集 564 条测试 + 100 条训练" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="开放域问答 · 来自阅读理解测试集&#xa;移除文章 · 逐题人工验证&#xa;删除 6 道不可回答问题&#xa;每子集 558 条测试题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="自然语言推断 · IndoNLI&#xa;专家编写测试集 · 单句子集&#xa;前提 + 假设 · 三分类标签&#xa;每子集 1,446 条测试题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="机器翻译 · IndoNLI&#xa;复用 251 条印尼语前提句&#xa;翻译成 22 个源语言/语域版本&#xa;评测方向：本地语言 → 印尼语" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="因果推理 · COPAL-ID&#xa;曾居雅加达的母语者&#xa;过滤雅加达特有题&#xa;原因 / 结果 · 两个选项&#xa;每子集 365 条测试题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="文化问答 · IndoCulture&#xa;选择非省份特定题&#xa;删除 61 · 修正错字 12 · 改进干扰项 13&#xa;每子集 510 道三选一题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="832" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="整理印尼语主记录&#xa;保留任务专属字段与标准答案&#xa;按任务保留上下文和选项&#xa;MCQA 训练集与测试集分开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="保留印尼语原始记录&#xa;仅适用于五类非翻译任务&#xa;这些记录不经过翻译&#xa;发布时与 22 个本地变体配套组装" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="执行翻译指南&#xa;保持语义 · 不增删上下文&#xa;只选一个自然译法 · 不用“/”或括号&#xa;数字形式与印尼语原文一致&#xa;严格采用指定正式/日常语域" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="专业母语者翻译&#xa;供应商聘用双语母语标注者&#xa;同时掌握印尼语与对应本地语言&#xa;翻译方向：印尼语 → 本地语言" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1864" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="人工 + 脚本辅助验证&#xa;第二位母语者复核每条记录&#xa;Sheets 标记长度 / 数字异常&#xa;每种语言聘用 8–31 名标注者" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="修正确认错误&#xa;重译被标记的错误项&#xa;团队会议解决不一致&#xa;将修正版本纳入发布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="688" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="组装 23 个子集 · 机器翻译仅含 22 个源变体&#xa;发布六个 Hugging Face 配置&#xa;测试 84,711 + MCQA 训练 2,300&#xa;官方总量 · 87,011 行&#xa;数据 revision · 1ebe2dac" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="保留数量口径证据&#xa;论文表 3 合计 · 84,711 条测试&#xa;论文 §3.5 正文 · 84,895（多 184）&#xa;HF · 84,711 测试 + 2,300 训练" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="公开发布边界&#xa;CC BY 4.0 数据与 README&#xa;未公开构建或评测代码&#xa;未固定上游 revision / 选择随机种子" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2824" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="选择评测设置&#xa;六类任务均做零样本评测&#xa;阅读理解另外做少样本实验&#xa;使用其 100 条训练样本池" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2824" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="构造附录中的任务提示&#xa;基础提示 · 直接作答&#xa;语言提示 · 说明与印尼语相似&#xa;GATITOS 词典 · 仅覆盖支持语言" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="运行已选择的推理模式&#xa;使用论文列出的模型检查点&#xa;多语言 · 东南亚 · 印尼专用模型&#xa;按适用范围调用闭源或开源模型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1864" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="配置答案 / 推理模式&#xa;生成文本 + 答案抽取&#xa;NLI / 文化 / 因果 · 选项对数概率&#xa;文化 / 因果 · 完形对数概率&#xa;概率模式仅适用于开源模型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="计算任务指标&#xa;五类非翻译任务 · 准确率&#xa;机器翻译 · ChrF++&#xa;开放问答 · 标准答案是输出子串" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="附录敏感性分析&#xa;Gemini-2.5-Flash 评审 · 1–5 分&#xa;得分除以 5 归一化&#xa;论文提醒低资源语言评审可靠性风险" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="1352" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="选择表现最佳设置&#xa;报告各提示中的最大表现&#xa;包含适用的答案选择模式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="报告 LoraxBench 结果&#xa;任务 × 模型 × 语言&#xa;印尼语与本地语言对比&#xa;正式与日常语域对比" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="904" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="评测可复现性边界&#xa;未公开解码配置&#xa;未公开少样本 k / 抽样规则 / 随机种子&#xa;未发布超出论文描述的精确解析器代码" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="1352" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;e