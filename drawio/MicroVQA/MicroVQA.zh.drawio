<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2000" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义三类科研任务&#xa;访谈九名显微研究 PI 与博士后&#xa;专家图像理解&#xa;假设生成 · 实验方案设计" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="招募 12 名生物学专家&#xa;覆盖不同显微研究领域&#xa;每名专家约 90 条样本&#xa;估计专家总工时约 600 小时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="汇集可再分发图像&#xa;贡献者自有实验&#xa;开放数据库与 CC-BY 论文&#xa;2024 年 1 月以后发表的文献" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="创建 1,061 条原始 VQA&#xa;每题最多六张 RGB 图或视频帧&#xa;问题 · 详细答案 · 干扰项&#xa;实验背景与研究动机" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="审核贡献者样本质量&#xa;研究难度 · 任务对齐 · 图像多样性&#xa;正文称第 10 与第 40 条后反馈&#xa;附录 E.1 称先审四至六条" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="创建 50 道金标多选题&#xa;由医师科学家主导设计&#xa;遵循 NBME 单一最佳答案格式&#xa;保留原始问答目标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="优化第一阶段提示&#xa;DSPy MIPROv2 · 思维链 + RAG · o1-mini&#xa;裁判语义 · NBME 格式 · 多余线索&#xa;语义保持权重最高" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="生成第一阶段考试式多选题&#xa;保留科学语义&#xa;形成单一最佳答案&#xa;添加可信且长度相近的干扰项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1720" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="执行一次 RefineBot 尝试&#xa;GPT-4o 无图评测器 + 反思器&#xa;改写器累计利用历轮反思&#xa;等价性检查 · 最多五轮" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1720" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="RefineBot 尝试成功吗？&#xa;评测器答错 · 改写语义保持" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="最终难度门槛通过吗？&#xa;两个指定模型均失败 · 两种子" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="最终门槛模型对&#xa;GPT-4o-2024-08-06&#xa;Claude-3.5-Sonnet-20241022" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="以新随机种子重跑整个 RefineBot&#xa;论文未给出总重跑次数上限&#xa;部分题目最终仍无法通过" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="保留第一阶段多选题&#xa;用于始终无法通过 RefineBot 的题目&#xa;不采用未成功的第二阶段改写" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="原创建者复核最终多选题&#xa;全量复核发布的 1,042 题&#xa;检查正确答案与干扰项&#xa;发现问题时做最小修正" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="构建计数边界&#xa;1,061 条原始样本 → 1,042 道发布题&#xa;论文与数据卡均未披露&#xa;19 条样本的流失规则" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="发布 MicroVQA 测试集&#xa;1,042 道多选题 · 423 道多图题&#xa;三类科学推理任务&#xa;数据采用 CC BY-SA 4.0" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="构造论文评测提示&#xa;图像 + 问题 + 从一编号的选项&#xa;LLaVA 系列外采用 MMMU-Pro 思维链&#xa;要求输出“The answer is (X)”" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="解析首个精确答案匹配&#xa;区分大小写的“answer is”加一位数字&#xa;允许可选粗体与括号&#xa;序号减一 · 无匹配记为负一" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-ser