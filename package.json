{
  "name": "benchmark-hub",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite --host",
    "build": "vite build && esbuild server/index.ts --platform=node --packages=external --bundle --format=esm --outdir=dist",
    "start": "NODE_ENV=production node dist/index.js",
    "preview": "vite preview --host",
    "check": "tsc --noEmit",
    "audit:build-process": "node scripts/benchmark_build_process/audit_build_process_assets.mjs",
    "report:build-process-paper-alignment": "node scripts/benchmark_build_process/audit_build_process_assets.mjs --allow-incomplete --queue-json docs/reports/2026-07-18-build-process-paper-alignment-queue.json --queue-markdown docs/reports/2026-07-18-build-process-paper-alignment-queue.md",
    "test:ci-workflows": "python3 -m unittest scripts/test_ci_workflows.py",
    "test:build-process": "python3 -m unittest scripts/test_validate_benchmarks.py scripts/test_ci_workflows.py && python3 scripts/validate_benchmarks.py && node --test scripts/benchmark_build_process/*.test.mjs && vitest run client/src/components/BenchmarkDrawer.test.tsx client/src/lib/benchmarkRoute.test.ts client/src/lib/benchmarkText.test.ts client/src/lib/openness.test.ts",
    "test:drawio-fidelity": "node --test --test-concurrency=1 scripts/benchmark_build_process/paper_review_site_a*.scoped.test.mjs",
    "normalize:drawio-svg": "node scripts/benchmark_build_process/normalize_drawio_svg.mjs",
    "format": "prettier --write .",
    "build:ghpages": "vite build --config vite.ghpages.config.ts"
  },
