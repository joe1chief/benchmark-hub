    {
      "id": "clinical_trials_gov",
      "label": "ClinicalTrials.gov 官方XML注册库\n海量临床试验协议原始记录\nNCT标识、试验设计、分期与干预措施\n入排标准与官方报告结果",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "external_knowledge_bases",
      "label": "外部多源临床知识库\nDrugBank药物化学与分子图谱\nTrialTrove试验成败与终止记录\nICD-10与CCS层级化疾病本体编码",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "feature_entity_mapping",
      "label": "跨模态实体统一关联\n将干预措施关联至DrugBank分子图结构\n将适应症归一化至ICD-10/CCS层级编码\n将临床结局精确映射至NCT唯一标识",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "preevent_guard_gate",
      "label": "事件前特征约束质检门\n特征是否严格在目标事件发生前可得？\n彻底消除事后信息与结局泄露？\n剔除恒定值/全空特征或保留有效特征",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "eligibility_filter_gate",
      "label": "任务特定入排筛选决策门\n试验是否满足特定任务约束规范？\n是否具备分期、样本量或疗法完整字段？\n剔除不合规试验或分流至任务构建",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "label_derivation",
      "label": "多模态标签规范化构建\n推导二分类、连续数值及事件标签\n由日期与入组人数提取试验持续周期\nGPT辅助结构化提取非结构化入排条件",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "trialbench_suite",
      "label": "TrialBench基准数据集套件\n23个AI-ready多模态临床试验数据集\n涵盖SMILES、文本、编码等5类模态\n提供标准化的训练、验证与测试划分",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "multimodal_encoding",
      "label": "多模态特征融合编码\n编码分子SMILES图、ICD-10与自由文本\n嵌入表格数值与类别型试验设计特征\n多模态联合表征输入任务特定预测头",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_family_routing",
      "label": "试验预测任务分流决策门\n分流至目标预测任务族系：\n分类任务 · 回归任务 · 生成任务\n分发输入至对应评估指标流水线",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "classification_metrics",
      "label": "试验分类任务性能评测\n药物获批预测与试验分期跃迁\n计算PR-AUC、ROC-AUC、F1及准确率\n评估试验成败与严重不良反应风险预测",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "regression_metrics",
      "label": "试验回归任务性能评测\n招募周期时长与入组患者规模建模\n评估RMSE、MAE、Pearson及一致性指数(C-Index)\n量化临床试验时间线与规模预测精度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generation_metrics",
      "label": "试验文本生成任务评测\n入排标准文本生成与试验协议撰写\n计算BLEU、ROUGE及BertScore等指标\n评估生成临床文本的医学合理性与一致性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "benchmark_leaderboard",
      "label": "TrialBench多模态综合评测报告\n跨模态消融分析与多任务基准表现矩阵\n模型临床试验全流程设计能力画像\n临床试验AI预测综合评测排行榜",
      "type": "terminal",
      "size": "xl"
    }
