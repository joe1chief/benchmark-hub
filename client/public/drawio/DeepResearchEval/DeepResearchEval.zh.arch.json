  "nodes": [
    {
      "id": "domains",
      "label": "10 大综合专业研究领域\n医疗健康、金融经济、法律合规、前沿科技等\n覆盖跨学科复杂真实研究场景",
      "type": "document",
      "size": "large"
    },
    {
      "id": "persona_model",
      "label": "人设画像自动合成引擎\n利用大语言模型自动生成专家人设背景\n赋予真实职业角色诉求与专业知识结构",
      "type": "process",
      "size": "large"
    },
    {
      "id": "personas",
      "label": "50 个多元专业人设画像\n分析师、律师、临床医师、科学家与架构师\n驱动高度专业化与定制化的信息调研需求",
      "type": "document",
      "size": "large"
    },
    {
      "id": "task_synthesis",
      "label": "人设锚定研究任务合成\n生成开放式复杂长程综合调研提示词\n要求多源信息搜集、交叉比对与研报撰写",
      "type": "process",
      "size": "large"
    },
    {
      "id": "candidates",
      "label": "初始候选题目池 (200 题)\n详尽的用户深度研究提示词规范\n具备极高认知负荷与多源信息检索诉求",
      "type": "document",
      "size": "large"
    },
    {
      "id": "qualification",
      "label": "资格审查与可行性初筛\n核验研究目标明确度、可验证性与边界范围\n剔除过于宽泛或过于狭隘的低质提问",
      "type": "process",
      "size": "large"
    },
    {
      "id": "no_search",
      "label": "闭卷无检索基线摸底测试\n在禁止联网环境下运行前沿基础大模型\n严密探测模型参数内部记忆直接作答能力",
      "type": "process",
      "size": "large"
    },
    {
      "id": "search_needed",
      "label": "外部网络检索必要性验证闸门\n强制剔除纯靠参数记忆即可完美回答的题目\n确保任务必须依赖实时或长尾网络检索",
      "type": "process",
      "size": "large"
    },
    {
      "id": "retained",
      "label": "合格研究候选集 (155 题)\n确认必须依赖开放网络长程检索的高质量题目\n具备极高信息熵与深入检索探索空间",
      "type": "document",
      "size": "large"
    },
    {
      "id": "expert_rank",
      "label": "7 位领域专家盲审共识评审\n按深度、无歧义性与科学严密性多维打分\n达成约 80% 专家高度一致性评级",
      "type": "process",
      "size": "large"
    },
    {
      "id": "selection",
      "label": "分层平衡最终遴选\n按领域代表性与难度梯度严谨分层抽样\n优中选优锁定最具区分度的代表性题目",
      "type": "process",
      "size": "large"
    },
    {
      "id": "final",
      "label": "DeepResearchEval 最终基准 (100 题)\n黄金标准英文深度研究 Agent 评测集\n全面度量自主长篇研报撰写与综合洞察力",
      "type": "terminal",
      "size": "large"
    }
  ],
