  "nodes": [
    {
      "id": "sessions",
      "label": "Recorded Driving Sessions\nSingle Front-facing RGB Camera\nNo LiDAR in Benchmark Input",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "clips",
      "label": "4 s Scenario · 1 Hz\n5 Frames over 4 Seconds\nFaces + Plates Anonymised",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "train_branch",
      "label": "Training Construction Branch?\nMulti-Criteria Quality & Validation Gate\nThreshold-Based Verification Criterion",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "action_seed",
      "label": "Action · Notable Behaviour Changes\nDecel · Accel · Lane Change · Turn\nOperator Situation + Behaviour Labels\nLights · Detections · Weather\nSpeed · Steering · Road Type",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "action_gpt",
      "label": "Action / Justification Templates\nExample Questions + Answer Hints\nGPT-3.5 Rephrase · Answer · Extend",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "action_balance",
      "label": "Rebalance Action + Policy Classes\nSample ≤500 Events per Category\nPaper Prose · 24,577 Action Snippets",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "scenery_seed",
      "label": "Scenery · 3 × 30 min Sessions\nELAN Dense Captions Every Second\n≈15 Caption Categories",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "scenery_gpt",
      "label": "GPT-4 Chain-of-thought\nGenerate Perception Questions + Answers\n≈43 QA per Scenario",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_total",
      "label": "Paper Headline Dataset Total\nScope Is Unresolved\n28K Scenarios · 419.9K QA\nAction + Scenery · 9 Competencies\nFree-form Answers · 17.2 Words Average",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "count_drift",
      "label": "Count Drift · Paper vs Release\nProse Action 167,774 · Table 3 267.8K\nTable 3 Scenery 152.5K · Total 420.3K\nREADME Swaps Branch Counts / Ratios\nParquet 413,829 QA · 27,999 Clips",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "missing_contracts",
      "label": "Paper Disclosures / Conflicts\nAction: Rephrase · Answer · Extend\nLater: GPT-3.5 Only Rephrasing\nGeneration Prompts + Config Not Released\nTrain-output QC / Reject Rate Not Reported",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "heldout",
      "label": "Held-out Evaluation Data\n100 Short-video Scenarios\n5 Questions per Scenario",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_qa",
      "label": "20+ In-house Evaluators\nCreate Questions + Answers\n500 Unique Human Questions",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "double_label",
      "label": "Initial Answer Double-labeling\nSame Evaluator Never Gets Same Question",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "qc_gate",
      "label": "Semantic Disagreement or Mistake?\nMulti-Criteria Quality & Validation Gate\nThreshold-Based Verification Criterion",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "relabel",
      "label": "Relabel Disputed Samples Twice More\nIndependent Expert Review & Validation\nResolves Inter-Annotator Disagreements",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "majority",
      "label": "Resolve by Majority Semantics\nPreserve Maximum Wording Diversity",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_release",
      "label": "Evaluation Release\n500 Questions · 1,000 Reference Rows\n2 Correct Diverse References per Question",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_input",
      "label": "Candidate Model\n5 Frames + Question\nFree-form Predicted Answer",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "predictions_csv",
      "label": "predictions.csv · 500 Answers\nquestion_id · segment_id · answer",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "judge_prompt",
      "label": "Official Judge Pre-processing\nLowercase + Strip Ref / Prediction\nQuestion Kept As Is\n[CLS] · Question · Answer · Student\nmax_length = 128",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_logits",
      "label": "Released Lingo-Judge\nDeBERTa-V3 Text Classifier\nOne Raw Logit per Reference\nNo Video Input",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "max_logit",
      "label": "Two References per Question\nPaper Eq. Omits q · Code Includes q\nzᵢ = maxⱼ f(qᵢ, rᵢⱼ, aᵢ)\nCorrect iff zᵢ > 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "LingoQA Accuracy (%)\n100 / 500 × Σᵢ 1[zᵢ > 0]",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "LingoQA Accuracy Report\nComplete Submission · N = 500\nMismatch Only Warns in Official Code",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "judge_data",
      "label": "Judge Training Data\nEarly-model Predictions\nEvaluation Questions + References\nHuman Correctness Labels",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "judge_lora",
      "label": "DeBERTa-V3 + LoRA\nLinear Head on Class Token\nTrain / Split / LoRA Config Undisclosed",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_release",
      "label": "Active-learning Corrections\nRelabel Errors from Discarded Models\nReleased Judge Revision\na1a6e2194fd1aedaba02bde82316a6b73753d1d5",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_evidence",
      "label": "Judge Validation Evidence\nHeld-out Accuracy 95.0%\n17 Systems · 15 Models + 2 Human Groups\nSpearman .950 · Pearson .993",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "Release / Openness Boundary\nPartly Public · Drive Data + HF Judge\nCustom Non-commercial · Revocable Licence\nNo Candidate-VLM Prompt / Parser / Code\nNo Official Live Leaderboard",
      "type": "document",
      "size": "xl"
    }
