keColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2192" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="发布 C3-Benchmark&#xa;256 条单任务 + 768 条多任务&#xa;2–4 个相关任务 • 336 种策略切换" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="挑战 1：工具依赖&#xa;DFS / 拓扑排序枚举有效路径&#xa;增量匹配复杂工具关系" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2688" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="挑战 2：隐藏信息&#xa;省略 • 指代 • 长上下文条件&#xa;正确用户与摘要历史；仅评最后任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2688" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="挑战 3：决策历史&#xa;注入正确的先前动作与观察&#xa;与挑战 2 对比" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2688" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="计算鲁棒性指标&#xa;Accuracy • AP • OP Rate&#xa;PTF • VF • DDD" style="rounded=1;arcSize=20;html=0;convertToSvg=1