  "nodes": [
    {
      "id": "healthbench",
      "label": "复用 HealthBench 任务\n开放式医疗健康对话\n未引入独立问题集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "response",
      "label": "生成长篇模型回答\n评估模型内部医疗知识\n保留专业声明与上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "scope",
      "label": "定义事实错误范围\n生成内容中的医疗误解\n分流两种主要失败模式",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "knowledge_error",
      "label": "知识错误\n错误临床事实或规则\n将正确知识误用于当前情境",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "evidence_error",
      "label": "证据错误\n虚构文献或临床数据\n歪曲因果关系",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extract",
      "label": "用 GPT-5 抽取原子声明\n采用高精度评测配置\n提高细粒度声明覆盖率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "规范化可验证单元\n拆分事实并消解指代\n去噪/干扰项 · 按顺序去重",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "search",
      "label": "实时验证每条声明\n对权威来源执行多轮搜索\n要求充分临床证据 · 不用缓存",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "verdict",
      "label": "分配证据结论\n将声明与所收集证据比对\n支持 · 不确定 · 反驳",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "supported",
      "label": "支持 · 权重 0.0\n权威证据支持该声明\n计为事实正确",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "uncertain",
      "label": "不确定 · 权重 0.5\n证据不足或存在歧义\n表示中等事实风险",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "refuted",
      "label": "反驳 · 权重 1.0\n证据与声明矛盾\n表示严重事实错误",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "报告医疗幻觉风险\n按声明计算加权幻觉率\n同时展示反驳率与不确定率",
      "type": "terminal",
      "size": "xl"
    }
  ],
