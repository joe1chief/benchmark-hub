      "type": "database",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "生成被测响应\n回答最后一个用户消息\n保留完整对话上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "grade",
