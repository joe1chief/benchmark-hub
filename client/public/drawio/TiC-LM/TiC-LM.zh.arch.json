    {
      "id": "step_1",
      "label": "114 个 Common Crawl 月度转储\n时间跨度涵盖 2013-05 至 2024-07\n网络级时序动态网页存档库",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "Resiliparse 高效文本提取\n底层高性能解析 HTML 页面结构\n彻底剥离网页模板、脚本与样式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "启发式文本质量清洗过滤\n应用 RefinedWeb 体系质量过滤规则\n剔除低信噪比与机器生成脏数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "月度区间内模糊去重过滤\nMinHash 与 LSH 仅在当月执行\n防止未来时间步数据反向污染过去",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "严格时序因果屏障保障\n拒绝依赖未来全局分类器\n确保严格单向时序信息流动",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "2.9 万亿 Token TiC-CC 语料库\n严格按时间戳分层切分的预训练集\n支撑持续语言学习大模型研究",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "时序留出验证评估集\n包含 TiC-CC、TiC-Wiki 与 TiC-News\n动态时序困惑度专属评测子集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "垂直领域持续学习评测集\nTiC-StackE（182 技术社区问答）\nTiC-CodeDocs（库版本迭代文档）",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "时序渐进预训练协议\n按月度时间序列推进模型权重更新\n严格遵循时序先后演进迭代",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "持续学习适应机制对比\n经验回放缓冲区、参数正则与 LoRA\n抑制灾难性遗忘核心算法",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "周期全量重训 Oracle 基线\n在历史全量累积数据上重新训练\n作为持续学习算法表现理论上限",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "时序困惑度动态度量\n评测各时间切片自回归困惑度\n追踪不同时期分布内泛化拟合度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "三向能力追踪评估体系\n回溯旧知识、当前分布内与前向推演\n全面评估历史、当代与未来泛化能力",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "遗忘率与正向迁移增益分析\n度量知识遗忘率与长尾记忆保留\n量化对新兴未见数据的正向迁移收益",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_15",
      "label": "TiC-LM 综合基准评估报告\n动态时序衰减曲线 + DCLM 静态基线\n综合衡量可塑性、稳定性与泛化能力",
      "type": "terminal",
      "size": "xl"
    }
