  "nodes": [
    {
      "id": "step_1",
      "label": "定义 8 类社交智能体任务\n涵盖帖子级、用户级与全局综合型任务\n推荐、情感分析、内容审核与事实核查",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "划分 3 大任务层级类别\n解耦以帖子为中心、以用户为中心与全景任务\n构建全方位社交网络能力测试维度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "采集 32 个社交平台数据源\n汇聚公开社交动态、论坛发帖与微博数据\n融合开源公开数据集与商业授权语料",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "构建多模态社交大数据仓\n收纳逾 916 万条发帖与 6,591 个用户画像\n包含 25,686 份专业机构事实核查报告",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "多模态媒体深度解析转换\nQwen2.5-VL 提取图像/视频描述与文字 OCR\nGPT-4o 转换音频与语音为高精度文本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "规则模板生成真值标签\n逆向推导用户互动行为预测与评论模拟\n严禁篡改社交平台客观发生之真实结局",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "人机协同交互标注真值\nQwen3-32B 辅助事件检测与社交复杂问答\n多轮人机交互提炼深层社交认知标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "整合经典谣言核查基准\n引入 LIAR-RAW 与 RAWFC 谣言数据集\n构建权威真实性与辟谣证据真值库",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "10 人专业审核团深度复核\n10 名专家人工质检验收并筛除瑕疵数据\n全面审核生成的问题、背景资料与标准答案",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "冻结 17,869 条标准查询集\n固化经过严格质检的社交智能体评测库\n在 8 项典型任务间保持数据分布均衡",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "封装 8 个标准 MCP 工具服务\n基于模型上下文协议 (MCP) 开发接口\n提供对海量用户、帖子与图谱的检索能力",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "分发智能体评测查询\n向受测智能体输入真实社交任务描述\n呈现具有高噪音、长上下文特征的复杂问题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "智能体调用 MCP 工具链推理\n受测模型自主查询社交图谱、发帖历史与画像\n在海量长程噪音数据中进行多步分析",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "差异化任务评分工具链\n对 3 项开放生成任务执行语义比对打分\n对 5 项分析抽取任务执行结构化精准比对",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_15",
      "label": "计算任务完成率 (TCR)\n统计各测试任务在预定步数内的成功率\n跟踪工具调用有效性与指令遵循完整度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_16",
      "label": "汇总 8 类任务宏平均得分\n归一化各项得分并计算全域宏平均表现\n绘制涵盖社交理解、行为预测与核查的雷达图",
      "type": "terminal",
      "size": "xl"
    }
