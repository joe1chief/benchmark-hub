  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3528" pageHeight="1128" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;论文 · arXiv 2406.14515v3&#xa;数据 · 78bfb7c7 · 1,998 行&#xa;VLMEvalKit · 796dc7cd&#xa;首次集成 · 2024-06-26" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="志愿者收集 YouTube 视频&#xa;参考 YouTube-8M 的类别&#xa;保留标题 · 点击量 · 字幕&#xa;覆盖多样长时网页内容" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="视频时长至少 30 秒？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="拒绝短视频&#xa;时长不足 30 秒" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="-16" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="定义问答证据片段&#xa;收集视频本身不设时长上限&#xa;每组问答最多使用六分钟" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="建立三级能力体系&#xa;一级 · 感知 / 推理&#xa;九项二级 · 26 项叶子能力&#xa;新增三项视频专属二级能力" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1072" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="人工为每个视频编写多题&#xa;每题标注一项或多项叶子能力&#xa;鼓励时序必要问题&#xa;自由表达 · 详细标准答案" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="执行五项准则并交叉核验&#xa;不写绝对时间戳 · 改用相对时间&#xa;多样 / 对话式措辞&#xa;验证准确性与准则遵循" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1616" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="探测时序必要性&#xa;每题使用四个不同随机种子&#xa;每次随机抽取一帧&#xa;GPT-4V 生成四个回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="GPT-4 逐次评判&#xa;语义相似度 · 零至三分&#xa;计算每题四次得分均值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="四次平均分至少为 2.5？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2432" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="排除静态可答问题&#xa;共移除 246 组问答" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2704" y="-16" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="人工复核&#xa;检查 LVLM 过滤后的问题&#xa;保留确需时序信息的问答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2704" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="汇总论文基准&#xa;609 个视频 · 1,998 组问答&#xa;平均 165.4 秒 · 32.6 个镜头&#xa;叶子能力可多标签" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2976" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="在 Hugging Face 发布完整包&#xa;完整快照 · 78bfb7c7&#xa;数据至 ef35e21d 未变化&#xa;论文：CC BY-NC 4.0&#xa;数据卡：CC BY 4.0 · 冲突" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3248" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="发布产物差异&#xa;论文 · 16 类 · TSV · 19 种 video_type&#xa;1,998 行 · 609 视频 · 26 叶子能力&#xa;无缺失 / 重复索引&#xa;正文 ≥ 30 秒 · Datasheet 最短 16.9 秒" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="未披露的构建细节&#xa;志愿者数量 / 培训 / 分工&#xa;视频检索与纳入协议&#xa;交叉核验一致性 / 仲裁&#xa;人工复核准则与数量" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="后续工具边界 · 7055d301&#xa;数据下载仍未固定 revision&#xa;新增原生视频输入路径&#xa;核心提示仍无字幕字段&#xa;Pack 解析器与评分器等价保留" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="首版官方均匀采帧&#xa;默认 F = 8 · 可覆盖&#xa;索引 int(i × N / (F + 1))&#xa;按时间顺序取内部帧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3248" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="构造候选模型提示&#xa;Pack · 同视频全部问题 → JSON&#xa;No-pack · 单题 → 直接文本&#xa;代码未加入字幕字段&#xa;信息不足也必须回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2976" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="解析候选输出&#xa;Pack · 必须恰有一个 JSON 对象&#xa;单左花括号时逐行宽松回退&#xa;缺键 / 解析 / 生成失败 → None&#xa;No-pack · 不解析回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2704" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="GPT-4 系列语义评判&#xa;论文 · GPT-4 与零至三分量表&#xa;首版代码默认 · gpt-4-1106-preview&#xa;忽略语法 · 要求单个整数" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2432" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="istype 内先对响应执行不安全的 eval&#xa;求值结果是否为 int？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="使用 int(响应) 转换&#xa;纯整数文本 → 保存得分&#xa;不强制零至三分范围&#xa;表达式可能已执行并在转换时中止" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="688" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="保存 −1 哨兵值&#xa;缺预测 / 评判失败 / 非整数文本&#xa;进入共享聚合" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="944" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="聚合多标签均值&#xa;每个得分 · ALL 使用 max(x, 0)&#xa;VALID 仅保留 x ≥ 0&#xa;26 叶子 · 九项二级能力&#xa;感知 · 推理 · 总体" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1616" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="Rating JSON&#xa;粗粒度 / 细粒度 · ALL / VALID&#xa;名义零至三分量表上的平均分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endAr