  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n论文 · arXiv 2406.14515v3\n数据 · 78bfb7c7 · 1,998 行\nVLMEvalKit · 796dc7cd\n首次集成 · 2024-06-26",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "collect",
      "label": "志愿者收集 YouTube 视频\n参考 YouTube-8M 的类别\n保留标题 · 点击量 · 字幕\n覆盖多样长时网页内容",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "duration_gate",
      "label": "视频时长至少 30 秒？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_short",
      "label": "拒绝短视频\n时长不足 30 秒",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "clip",
      "label": "定义问答证据片段\n收集视频本身不设时长上限\n每组问答最多使用六分钟",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "建立三级能力体系\n一级 · 感知 / 推理\n九项二级 · 26 项叶子能力\n新增三项视频专属二级能力",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "author",
      "label": "人工为每个视频编写多题\n每题标注一项或多项叶子能力\n鼓励时序必要问题\n自由表达 · 详细标准答案",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "crosscheck",
      "label": "执行五项准则并交叉核验\n不写绝对时间戳 · 改用相对时间\n多样 / 对话式措辞\n验证准确性与准则遵循",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "frames",
      "label": "探测时序必要性\n每题使用四个不同随机种子\n每次随机抽取一帧\nGPT-4V 生成四个回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mean_score",
      "label": "GPT-4 逐次评判\n语义相似度 · 零至三分\n计算每题四次得分均值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "temporal_gate",
      "label": "四次平均分至少为 2.5？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "exclude_static",
      "label": "排除静态可答问题\n共移除 246 组问答",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "manual_verify",
      "label": "人工复核\n检查 LVLM 过滤后的问题\n保留确需时序信息的问答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "汇总论文基准\n609 个视频 · 1,998 组问答\n平均 165.4 秒 · 32.6 个镜头\n叶子能力可多标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "在 Hugging Face 发布完整包\n完整快照 · 78bfb7c7\n数据至 ef35e21d 未变化\n论文：CC BY-NC 4.0\n数据卡：CC BY 4.0 · 冲突",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "artifact_drift",
      "label": "发布产物差异\n论文 · 16 类 · TSV · 19 种 video_type\n1,998 行 · 609 视频 · 26 叶子能力\n无缺失 / 重复索引\n正文 ≥ 30 秒 · Datasheet 最短 16.9 秒",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "construction_gaps",
      "label": "未披露的构建细节\n志愿者数量 / 培训 / 分工\n视频检索与纳入协议\n交叉核验一致性 / 仲裁\n人工复核准则与数量",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "current_boundary",
      "label": "后续工具边界 · 7055d301\n数据下载仍未固定 revision\n新增原生视频输入路径\n核心提示仍无字幕字段\nPack 解析器与评分器等价保留",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sampling",
      "label": "首版官方均匀采帧\n默认 F = 8 · 可覆盖\n索引 int(i × N / (F + 1))\n按时间顺序取内部帧",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "构造候选模型提示\nPack · 同视频全部问题 → JSON\nNo-pack · 单题 → 直接文本\n代码未加入字幕字段\n信息不足也必须回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pack_parse",
      "label": "解析候选输出\nPack · 必须恰有一个 JSON 对象\n单左花括号时逐行宽松回退\n缺键 / 解析 / 生成失败 → None\nNo-pack · 不解析回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "GPT-4 系列语义评判\n论文 · GPT-4 与零至三分量表\n首版代码默认 · gpt-4-1106-preview\n忽略语法 · 要求单个整数",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "score_gate",
      "label": "istype 内先对响应执行不安全的 eval\n求值结果是否为 int？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "valid_score",
      "label": "使用 int(响应) 转换\n纯整数文本 → 保存得分\n不强制零至三分范围\n表达式可能已执行并在转换时中止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "invalid_score",
      "label": "保存 −1 哨兵值\n缺预测 / 评判失败 / 非整数文本\n进入共享聚合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "聚合多标签均值\n每个得分 · ALL 使用 max(x, 0)\nVALID 仅保留 x ≥ 0\n26 叶子 · 九项二级能力\n感知 · 推理 · 总体",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "output",
      "label": "Rating JSON\n粗粒度 / 细粒度 · ALL / VALID\n名义零至三分量表上的平均分",
      "type": "terminal",
      "size": "xl"
    }
  ],
