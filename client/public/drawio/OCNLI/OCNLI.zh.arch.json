    {
      "id": "source",
      "label": "收集原生中文前提句\n政府 · 新闻 · 文学\n电视谈话 · 电话对话\n同时覆盖书面与口语原始来源",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "preprocess",
      "label": "预处理来源句子\n移除中文 Callhome 标注符号\n保留 8–50 个汉字的句子\n不从英文数据翻译",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "writers",
      "label": "招募 145 名假设撰写者\n中文母语者\n高校本科生与研究生\n中文或其他语言专业",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "protocol",
      "label": "改编 MNLI 假设生成协议\n蕴含 · 中立 · 矛盾\n假设与前提重叠不超过 70%\n限制单个撰写者的贡献量",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "strategy_gate",
      "label": "采用哪种假设\n生成条件？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "single",
      "label": "SINGLE · MNLI 式\n每个 NLI 标签写一个假设\n论文报告 11,986 个句对\n不设简单/中等/困难顺序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "multi",
      "label": "MULTI\n每标签最多写三个假设\n第一 · 第二 · 第三个 = 简单 · 中等 · 困难\n论文报告 12,328 个句对",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "encourage",
      "label": "MULTI ENCOURAGE\n奖励多样化假设\n鼓励不用否定词构造矛盾\n论文报告 16,584 个句对",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "constraint",
      "label": "MULTI CONSTRAINT\n三个矛盾假设中最多一个含否定词\n随机检查 · 违规降低报酬\n论文报告 15,627 个句对",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "corpus",
      "label": "形成原始 OCNLI 语料\n论文标题数与表中总数为 56,486\n四个子集行相加却为 56,525\n显式保留 39 条计数冲突",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "从每种条件抽样复标\nSINGLE 1,919 · MULTI 1,994\nENCOURAGE 3,000 · CONSTRAINT 3,000\n四个独立标签 + 原撰写标签 = 五个",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agreement",
      "label": "检查复标一致性\n至少三票一致率为 98.3–98.8%\n比较生成条件与生成顺序\n保留全部五个标签作为证据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold",
      "label": "确定参考标签\n对五个标签多数投票\n蕴含 · 中立 · 矛盾\n无多数票样本标记为“-”",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "创建论文主划分\n随机打散 6,000 条已复标 ENCOURAGE/CONSTRAINT\n验证 3,000 + 测试 3,000 · 平衡生成顺序\nSINGLE/MULTI 与其余句对进入训练集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "full_release",
      "label": "固定仓库发布 b53efde…\n训练 50,486 · 验证 3,000 · 测试 3,000\n测试输入公开但标签隐藏\n训练含 49 条“-” · 验证含 50 条“-”",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "small_release",
      "label": "删除与验证/测试重合的前提\ntrain.small 发布 30,286 行\n仓库另采样 10k 与 3k 子集\n共用同一验证集与测试集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_eval",
      "label": "预测三个 NLI 标签之一\nCBOW · 双向长短期记忆网络 · ESIM\n中文 BERT-base · RoBERTa-large\n分别使用完整 50k 或去重 30k 训练",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "label_gate",
      "label": "参考标签可用\n且不是“-”吗？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "exclude",
      "label": "不在本地计分\n排除无多数票的“-”样本\n隐藏测试标签需提交到 CLUE",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "计算三分类准确率\n排除无多数票参考项\n分别报告验证与测试结果\n论文模型结果取五次运行均值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "保守人工基线\n20 条练习 + 300 条随机测试样本\n五名未参与构建的本科生为 90.3%\n五名语言学博士为 89.3% · 采用本科生分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 OCNLI 准确率\nRoBERTa 78.2% 对人工 90.3%\n人机差距约 12 个百分点\n比较完整与前提去重训练集",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "source_boundary",
      "label": "论文与发布边界\narXiv v1 SHA-256 fa195f…\n仓库 b53efde… · CC BY-NC 2.0\n新闻前提经 LCMC/ELRA 授权使用\nCLUE 排行榜处理隐藏测试标签",
      "type": "document",
      "size": "xl"
    }
  ],
