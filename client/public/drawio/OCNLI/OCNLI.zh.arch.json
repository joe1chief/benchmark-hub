  "nodes": [
    {
      "id": "source",
      "label": "收集原生中文前提句\n政府 · 新闻 · 文学\n电视谈话 · 电话对话\n同时覆盖书面与口语体裁",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "preprocess",
      "label": "预处理来源句子\n移除 Callhome 标注符号\n保留 8–50 个汉字的句子\n不从英文数据自动翻译",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "annotators",
      "label": "招募 145 名假设撰写者\n中文母语者\n中国高校本科生与研究生\n中文或其他语言专业",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "protocol",
      "label": "改编 MNLI 假设生成协议\n蕴含 · 中立 · 矛盾\n假设与前提重叠不超过 70%\n控制单人贡献量",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "classic",
      "label": "生成两个初始子集\nSINGLE 每标签一个 · 11,986\nMULTI 每标签最多三个 · 12,328\n第一/二/三个对应简单/中等/困难",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "controlled",
      "label": "增加两个偏差控制子集\nENCOURAGE 鼓励多样性 · 16,584\n奖励减少否定词\nCONSTRAINT 约束否定词 · 15,627",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "corpus",
      "label": "形成原始 OCNLI 语料\n56,486 个前提—假设句对\n四种假设生成策略\n五种原生中文体裁",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "每个子集约抽取 15% 复标\n每对由四人独立判断\n加入原撰写者初始标签\n每条共获得五个标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agreement",
      "label": "检查复标一致性\n至少三票一致率 98.3–98.8%\n比较子集与生成顺序\n保留质量验证证据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold",
      "label": "确定 NLI 标准标签\n对五个标签多数投票\n无多数票样本标记为“-”\n评测时可排除",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "创建主数据划分\n随机选取 6,000 条已复标 MULTI\n开发集 3,000 + 测试集 3,000\n平衡简单/中等/困难",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "train",
      "label": "组装训练集发布版本\n剩余约 50,000 个句对\n包含全部 SINGLE 与 MULTI\n另发布 30k train.small",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "baselines",
      "label": "评测中文 NLI 基线\nCBOW · biLSTM · ESIM\n中文 BERT-base · RoBERTa-large\n报告准确率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "用人工表现验证难度\n五名新学生 · 300 条测试样本\n人工 90.3% 对 RoBERTa 78.2%\n报告约 12 个百分点差距",
      "type": "terminal",
      "size": "xl"
    }
  ],
