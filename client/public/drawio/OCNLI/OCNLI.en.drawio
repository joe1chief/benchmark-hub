etry"/></mxCell><mxCell id="10" value="MULTI CONSTRAINT&#xa;At Most One of Three Contradictions Uses a Negator&#xa;Random Checks · Lower Pay for Violations&#xa;15,627 Reported Pairs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Form the Original OCNLI Corpus&#xa;Paper Headline and Table Total: 56,486&#xa;Four Displayed Subset Rows Sum to 56,525&#xa;Preserve the 39-pair Paper Conflict" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Relabel a Subset of Each Condition&#xa;SINGLE 1,919 · MULTI 1,994&#xa;ENCOURAGE 3,000 · CONSTRAINT 3,000&#xa;Four Independent Labels + Writer Label = Five" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Check Verification Agreement&#xa;At Least Three Votes Agree on 98.3–98.8%&#xa;Compare Conditions and Elicitation Orders&#xa;Retain All Five Labels as Evidence" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x=