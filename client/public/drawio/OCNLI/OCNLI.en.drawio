    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="632" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Collect Original Chinese Premises&#xa;Government · News · Literature&#xa;TV Talk Shows · Telephone Calls&#xa;Written and Spoken Primary Sources" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Preprocess Source Sentences&#xa;Remove Chinese Callhome Annotation Marks&#xa;Keep Sentences with 8–50 Characters&#xa;Do Not Translate from English" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Recruit 145 Hypothesis Writers&#xa;Native Chinese Speakers&#xa;Undergraduates and Graduates&#xa;Chinese or Other Language Majors" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Adapt the MNLI Elicitation Protocol&#xa;Entailment · Neutral · Contradiction&#xa;Cap Hypothesis–Premise Overlap at 70%&#xa;Limit Any One Writer's Contribution" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wr