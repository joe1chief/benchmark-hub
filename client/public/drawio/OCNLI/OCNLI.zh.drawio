<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="632" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="收集原生中文前提句&#xa;政府 · 新闻 · 文学&#xa;电视谈话 · 电话对话&#xa;同时覆盖书面与口语原始来源" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="预处理来源句子&#xa;移除中文 Callhome 标注符号&#xa;保留 8–50 个汉字的句子&#xa;不从英文数据翻译" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="招募 145 名假设撰写者&#xa;中文母语者&#xa;高校本科生与研究生&#xa;中文或其他语言专业" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="改编 MNLI 假设生成协议&#xa;蕴含 · 中立 · 矛盾&#xa;假设与前提重叠不超过 70%&#xa;限制单个撰写者的贡献量" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="采用哪种假设&#xa;生成条件？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="SINGLE · MNLI 式&#xa;每个 NLI 标签写一个假设&#xa;论文报告 11,986 个句对&#xa;不设简单/中等/困难顺序" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="MULTI&#xa;每标签最多写三个假设&#xa;第一 · 第二 · 第三个 = 简单 · 中等 · 困难&#xa;论文报告 12,328 个句对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="MULTI ENCOURAGE&#xa;奖励多样化假设&#xa;鼓励不用否定词构造矛盾&#xa;论文报告 16,584 个句对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="MULTI CONSTRAINT&#xa;三个矛盾假设中最多一个含否定词&#xa;随机检查 · 违规降低报酬&#xa;论文报告 15,627 个句对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="形成原始 OCNLI 语料&#xa;论文标题数与表中总数为 56,486&#xa;四个子集行相加却为 56,525&#xa;显式保留 39 条计数冲突" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="从每种条件抽样复标&#xa;SINGLE 1,919 · MULTI 1,994&#xa;ENCOURAGE 3,000 · CONSTRAINT 3,000&#xa;四个独立标签 + 原撰写标签 = 五个" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="检查复标一致性&#xa;至少三票一致率为 98.3–98.8%&#xa;比较生成条件与生成顺序&#xa;保留全部五个标签作为证据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="确定参考标签&#xa;对五个标签多数投票&#xa;蕴含 · 中立 · 矛盾&#xa;无多数票样本标记为“-”" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="创建论文主划分&#xa;随机打散 6,000 条已复标 ENCOURAGE/CONSTRAINT&#xa;验证 3,000 + 测试 3,000 · 平衡生成顺序&#xa;SINGLE/MULTI 与其余句对进入训练集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="固定仓库发布 b53efde…&#xa;训练 50,486 · 验证 3,000 · 测试 3,000&#xa;测试输入公开但标签隐藏&#xa;训练含 49 条“-” · 验证含 50 条“-”" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="删除与验证/测试重合的前提&#xa;train.small 发布 30,286 行&#xa;仓库另采样 10k 与 3k 子集&#xa;共用同一验证集与测试集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="预测三个 NLI 标签之一&#xa;CBOW · 双向长短期记忆网络 · ESIM&#xa;中文 BERT-base · RoBERTa-large&#xa;分别使用完整 50k 或去重 30k 训练" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="参考标签可用&#xa;且不是“-”吗？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="不在本地计分&#xa;排除无多数票的“-”样本&#xa;隐藏测试标签需提交到 CLUE" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="计算三分类准确率&#xa;排除无多数票参考项&#xa;分别报告验证与测试结果&#xa;论文模型结果取五次运行均值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="保守人工基线&#xa;20 条练习 + 300 条随机测试样本&#xa;五名未参与构建的本科生为 90.3%&#xa;五名语言学博士为 89.3% · 采用本科生分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="报告 OCNLI 准确率&#xa;RoBERTa 78.2% 对人工 90.3%&#xa;人机差距约 12 个百分点&#xa;比较完整与前提去重训练集" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3520" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="论文与发布边界&#xa;arXiv v1 SHA-256 fa195f…&#xa;仓库 b53efde… · CC BY-NC 2.0&#xa;新闻前提经 LCMC/ELRA 授权使用&#xa;CLUE 排行榜处理隐藏测试标签" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3