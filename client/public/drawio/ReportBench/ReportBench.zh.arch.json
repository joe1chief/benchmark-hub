      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "受测智能体生成报告\n端到端自主检索调研生成的综述\n严禁直接引用来源原始综述论文",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_10",
