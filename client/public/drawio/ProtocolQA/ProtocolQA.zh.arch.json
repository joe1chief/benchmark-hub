  "nodes": [
    {
      "id": "protocol_corpus",
      "label": "已发表实验方案知识库\nProtocols.io与STAR Protocols文献\n保留湿实验分步操作流程\n筛选具可操作性的真实方案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "round1_experts",
      "label": "第一轮生物学领域专家\n签约生物学博士与科研人员\n顶尖生物学在读博士生\n挑选可供扰动的实验方案",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "error_injection",
      "label": "针对性实验错误注入\n有意修改关键或中间操作步骤\n明确破坏或改变实验输出结果\n详细记录错误机制与负面后果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "round2_experts",
      "label": "第二轮独立生物学专家\n独立专家组接收改动方案\n错误构造与题目起草人员相互隔离\n审查错误说明与失败合理性",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "alignment_validation_gate",
      "label": "失败场景有效性核验门\n验证错误与后果机制是否完全对齐？\n确认是否必然导致实验失败？\n淘汰无效修改或进入题目起草",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "mcq_drafting",
      "label": "故障排查多选题起草\n描述假想的湿实验异常结果\n编写包含1个正确修复措施的选择题\n加入具生物学迷惑性的干扰选项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "author_calibration_gate",
      "label": "作者校准与终审决策门\n作者团队校准每位作者前5-10道题\n在Airtable中开展持续多轮质检\n达标正式收录或打回修改草稿",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "protocolqa_corpus",
      "label": "ProtocolQA基准数据集\n135道经严谨质检的实验排错选择题\n划分为108道公开题与27道私有题\n纯文本无工具生物学排错基准",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_inference",
      "label": "零样本思维链推理评测\n输入零样本CoT标准化提示词\n随机打乱备选答案顺序消除位置偏差\n提供显式信息不足拒答选项\n无外部工具辅助生成完整回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "response_parsing_gate",
      "label": "答案提取与状态分流门\n通过正则或Claude 2提取单字母标签\n有效选择选项还是显式拒答？\n分流判定进入对应指标统计",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "selective_metrics",
      "label": "选择性指标体系计算\n准确率 = 正确题数 / 全部测试题数\n精确率 = 正确题数 / 已尝试作答题数\n覆盖率 = 已尝试作答题数 / 全部题数\n三次独立运行取均值评估稳定性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_expert_audit",
      "label": "独立专家开放式回答审计\n20题去除多选提示的开放式子集\n双生物学家独立盲审打分与复核\n与允许使用科研工具的人类专家对比",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_report",
      "label": "ProtocolQA评测基准报告\n多轮评测选择性准确率综合分析\n模型拒答行为与覆盖率权衡分析\n湿实验故障排查综合能力评测报告",
      "type": "terminal",
      "size": "xl"
    }
  ],
