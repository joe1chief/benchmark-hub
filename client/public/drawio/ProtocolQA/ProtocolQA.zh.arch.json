    {
      "id": "benchmark_scope",
      "label": "ProtocolQA基准范围\n135道无工具实验方案故障排除选择题\n属于LAB-Bench而非全库2,457题\n构建 · 评测 · 审计",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "expert_round_one",
      "label": "第一轮专家\n签约生物学专家\n生物学博士或顶尖博士项目学生\n制作修改后的实验方案材料",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "protocol_sources",
      "label": "已发表实验方案来源\nprotocols.io\nSTAR Protocols\n提取可执行实验步骤",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "error_injection",
      "label": "注入一个或多个错误\n修改或省略步骤\n明确改变或破坏实验输出\n也覆盖中间步骤失败",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "error_explanation",
      "label": "解释注入错误\n记录改动为何错误\n说明预期负面影响\n与修改后的方案配对",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "expert_round_two",
      "label": "第二轮专家\n另一批专家接收方案与解释\n选择候选并起草问题\n与注入错误的工作分离",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "alignment_check",
      "label": "检查错误与解释对齐\n确认解释匹配实际改动\n拒绝不对齐的候选\n对齐后才继续",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "outcome_check",
      "label": "检查负面实验结果\n同意该错误会损害结果\n要求失败原因明确\n结果合理后才继续",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mcq_draft",
      "label": "起草故障排除选择题\n描述假想实验结果\n询问如何改动以修复\n正确答案对应注入错误",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "author_calibration",
      "label": "作者校准\n作者细审每名写作者最初5–10题\n返工 · 接受 · 或移除\n校准后再扩大产题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ongoing_review",
      "label": "持续作者复核\n合入语料库前审核题目\n修订或拒绝有缺陷的草稿\n校准后持续维护质量",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_set",
      "label": "冻结ProtocolQA\n135道多项选择题\n无工具生物学推理\n公开与私有部分共同评测",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "zero_shot_cot",
      "label": "零样本CoT · 不使用工具\n随机打乱答案选项\n加入明确拒答选项\n要求答案标签内单个字母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_completion",
      "label": "收集模型文本\n不借助检索工具进行推理\n输出所选字母或拒答\n评测全部ProtocolQA题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "text_parser",
      "label": "文本完成解析器\n正则读取答案标签\nClaude 2回退解析文本完成\n拒答计为未尝试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "selective_metrics",
      "label": "计算选择性指标\n准确率 = 正确数 / 总题数\n精确率 = 正确数 / 已尝试数\n覆盖率 = 已尝试数 / 总题数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "three_run_report",
      "label": "报告论文结果\n使用公开与私有部分\n每个模型取三次运行平均\n三项指标分别报告",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "open_answer_rewrite",
      "label": "独立20题开放回答审计\n必要时移除选择题措辞\n收集Claude 3.5与GPT-4o回答\n不是OpenAI的108题衍生集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "expert_grade",
      "label": "生物学专家评分回答\n与理想选择题答案对照\n判定正确或错误\n由论文作者专家评分",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "second_review",
      "label": "第二名复核者检查全部评分\n复核完成后再报告\n人工准确率审计\n不是自动评分器",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_answer_report",
      "label": "报告开放回答准确率\nClaude 3.5 Sonnet为0.30\nGPT-4o为0.20 · 共20题\n与主选择题指标分开",
      "type": "terminal",
      "size": "xl"
    },
    {
