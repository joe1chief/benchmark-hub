    {
      "id": "meta",
      "label": "构思元任务\n由论文合著者提出候选\n执行去重与重要性筛选\n保留 32 个元任务",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "subtasks",
      "label": "将元任务分解为子任务\n要求属于基础多模态能力\n要求能挑战当前模型\n要求具有公开测试样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "search",
      "label": "搜索候选数据集\nGoogle · Papers With Code\nKaggle · ChatGPT\n评估相关性与可用性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "sample",
      "label": "抽取来源数据\n每子任务最多 200 个样本\n执行随机抽样\n平衡各贡献数据集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metadata",
      "label": "构建统一元数据\n存储多模态输入\n补充问答所需信息\n标注能力与视觉提示类型",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "mcq",
      "label": "生成多项选择问答\n使用人工规则或 ChatGPT\n最多构造八个选项\n保留唯一标准答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "汇总 MMT-Bench\n共 31,325 道问题\n32 个元任务 · 162 个子任务\n13 种输入 · 14 类能力",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "评测 32 个公开 LVLM\n使用 OpenCompass 流程\n输入任务特定模态\n生成一个模型回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extract",
      "label": "三阶段抽取答案\n先读取选项字母\n再匹配选项内容\n最后询问 ChatGPT · 失败记 Z",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "计算准确率\n将预测选项与标准答案比较\n先按子任务汇总\n再平均为元任务分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "vectors",
      "label": "构建 162 个任务向量\nLoRA 微调 Qwen-VL-Chat\n每个子任务训练三轮\n以余弦距离比较向量",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "发布分层任务地图\n聚类相关子任务\n比较模型排名\n报告整体多任务结果",
      "type": "terminal",
      "size": "xl"
    }
