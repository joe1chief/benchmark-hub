  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n论文 · arXiv 2404.16006v1\n首版评测代码 · 8ec8203c\n当前仓库 · 5e900028\nHF 数据集 · 2255d3a7",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "meta",
      "label": "构思元任务\n全体合著者提出候选\n去重并按重要性筛选\n保留 32 个元任务",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "subtasks",
      "label": "分解候选子任务\n数十名 AI 领域合著者参与\n建立分层任务结构",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "criteria_gate",
      "label": "同时满足三项子任务标准？\n多维度质量与逻辑严谨性决策门\n基于严格阈值的合格判定准则",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "exclude_subtask",
      "label": "排除候选子任务\n不基础、不具挑战性\n或测试样本无法公开获取",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "search",
      "label": "按子任务名搜索\nGoogle · Papers With Code\nKaggle · ChatGPT\n下载候选数据集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dataset_gate",
      "label": "候选数据集相关且可用？\n多维度质量与逻辑严谨性决策门\n基于严格阈值的合格判定准则",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_dataset",
      "label": "淘汰候选数据集\n继续搜索其他来源",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sampling",
      "label": "平衡来源抽样\n每子任务随机保留至多 200 条\n每个贡献数据集取相同样本数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metadata",
      "label": "整理统一元数据\n图像 + 生成问答所需信息\n人工标注所需能力\n标注视觉提示 / 输入图像类型",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "qa_route",
      "label": "该任务采用哪种问答生成路径？\n多维度质量与逻辑严谨性决策门\n基于严格阈值的合格判定准则",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "rules",
      "label": "人工设计规则\n生成问题 + 标准答案\n示例 · 草图检索\n从元数据随机采样干扰图像\n依任务而定 · 最多八个选项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "chatgpt",
      "label": "精心设计的 ChatGPT 提示词\n高效生成高质量选择题\n示例 · 视频描述\n生成混淆性错误选项\n依任务而定 · 最多八个选项",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "merge_qa",
      "label": "合并生成的选择题\n保留任务层级",
      "type": "process",
      "size": "s"
    },
    {
      "id": "dataset",
      "label": "汇总论文版 MMT-Bench\n31,325 道多项选择题\n32 个元任务 · 162 个子任务\n13 类视觉输入 · 14 类能力",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布基准资产\n项目页 + 官方仓库\n后续 HF 全量 / 验证划分\n合并图像版与 MI 版",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "发布时间线与权利边界\n论文 v1 · 2024 年 4 月 24 日\nHF 2255d3a7 · 6 月 24 日 · CC BY 4.0\n全量标签 tag · 84012c95 · 7 月 18 日\n仓库根目录无 LICENSE",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "parser_drift",
      "label": "论文 / 代码漂移\n论文失败 → Z\n仓库耗尽 → 随机选项 / Z\n仓库判分 → 最多 8 项仍限 A–D\n元任务：按行加权 → 论文的子任务均值（e7004588）",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_eval",
      "label": "论文 v1 评测\n30 个公开可用 LVLM\n输入任务特定模态\n每道选择题生成一个自由回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "letter_gate",
      "label": "抽取到唯一选项字母？\n多维度质量与逻辑严谨性决策门\n基于严格阈值的合格判定准则",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "content_gate",
      "label": "抽取到唯一选项内容？\n多维度质量与逻辑严谨性决策门\n基于严格阈值的合格判定准则",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "chatgpt_extract",
      "label": "步骤 3 · 询问 ChatGPT\n将回答匹配到一个选项\n返回一个有效选项或 Z",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "valid_gate",
      "label": "规范化 ChatGPT 输出\n有效选项 → 与标准答案比较\n无结果 / 拒答 → Z · 始终计错",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "计算论文准确率\n抽取选项对比标答 · Z 计错\n元任务 = 所有子任务准确率均值\nOverall 覆盖所有子任务\nOverall* 排除视觉识别",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_report",
      "label": "报告多任务结果\n总体 · 32 个元任务\n162 个子任务明细\n不同提示变体分别评测",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "task_data",
      "label": "步骤 2 · 构建逐子任务数据\n将每道选择题改为指令数据\n162 个子任务各一套数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "probe",
      "label": "步骤 1 · 选择 Qwen-VL-Chat 探测模型\n从预训练初始权重出发\n在多数子任务上具备良好表现",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "vectors",
      "label": "步骤 3 · 每子任务执行 LoRA 微调\n162 个子任务各训练三轮\n权重差作为任务向量\n参数从 9.6B 降至 3.5M",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "distance",
      "label": "构建 162 × 162 任务图\n距离 = 1 − 余弦相似度\n取值范围 0 至 2",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_map",
      "label": "分析任务地图\n层次聚类 · 12 个簇\nKendall Tau 排名一致性\n发现域内 / 域外任务",
      "type": "terminal",
      "size": "xl"
    }
  ],
