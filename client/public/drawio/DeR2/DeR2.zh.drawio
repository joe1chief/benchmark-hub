<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3864" pageHeight="704" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文 arXiv:2601.21937v2&#xa;GitHub @ 95a8aba&#xa;HF 数据集 @ b0a84aed&#xa;TSV SHA256 3473fab…" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="2023—2025 年源论文&#xa;理论导向 · 15+ 学科&#xa;排除应用实验、&#xa;社会调查与数值模拟" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="81 位博士标注员&#xa;仅在自身专业工作&#xa;每题 2,500 元&#xa;审核每条 350 元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="人工定稿五个字段&#xa;指令 · 概念 · 推理链&#xa;答案 · 文档集&#xa;唯一且可验证的目标" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="每种条件运行三次&#xa;仅指令：3/3 错误&#xa;仅概念：至少一次正确&#xa;且至少一次错误" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="是否满足校准条件？&#xa;若概念条件三次全对：&#xa;文档集复测 · 始终正确则丢弃&#xa;至少两次失败则保留，否则修改" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="从源论文参考文献建库&#xa;每个概念至少一篇相关文档&#xa;添加主题邻近噪声&#xa;禁止概念 / 答案泄漏" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="审核员至少有 3 条通过样本&#xa;科学逻辑 · 唯一答案&#xa;重跑难度校准&#xa;再次复核文档集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="DeR²-300 · 数量版本边界&#xa;300 题 · 冻结文档库&#xa;论文：平均 6.5 篇文档&#xa;TSV：相关 1,111 + 噪声 666 = 1,777&#xa;固定均值 5.9233 · 无训练/开发/测试划分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="三套条件专用提示&#xa;仅流程与评分保持一致&#xa;四种受控输入&#xa;仅指令 · 仅概念&#xa;仅相关文档 · 完整文档集" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="提示 C · 仅指令条件&#xa;参数知识&#xa;不提供概念或文档" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="提示 B · 仅概念条件&#xa;预言概念&#xa;组合与调度推理" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="提示 A · 仅相关文档条件&#xa;干净证据文档&#xa;提取并操作化概念" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="提示 A · 完整文档集条件&#xa;相关文档 + 噪声文档&#xa;选择、去噪并推理" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="520" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="确定性长文本保护&#xa;默认 max_chars = 30,000&#xa;保留前半与后半&#xa;中间插入固定截断标记" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="固定输入 · 禁止联网&#xa;温度 = 1 · top_p = 0.7&#xa;每个模型 × 设置运行两次&#xa;报告平均分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3064" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="doubao-seed-1-6-251015 裁判&#xa;任务特定归一化&#xa;数值容差 · 符号等价&#xa;清单匹配" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3320" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="答案准确率&#xa;论文原词 · 不新增缩写&#xa;知识损失 · 检索损失&#xa;噪声诱发损失 · 文档到概念损失&#xa;唯一公式：RLoss = 仅概念 − 完整文档集" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3584" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge