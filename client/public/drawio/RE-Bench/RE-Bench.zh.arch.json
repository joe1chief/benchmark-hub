      "label": "规格阶段\n撰写任务说明\n提出评分函数\n提出起始解",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "spec_review",
      "label": "评审并返工规格\n覆盖关键 AI 研发挑战\n人类可进步且上限足够高\n实现成本可接受",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "implementation",
      "label": "实现阶段\n构建完整评测环境\n加入内部高分参考解\n按要求持续返工",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_trials",
      "label": "基线测试阶段\n组织人类专家试跑\n观察进展与上限\n识别实际运行问题",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "baseline_review",
      "label": "重新评估环境\n保留 · 修订 · 丢弃\n经常进行显著调整",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "revision_loop",
      "label": "未满足要求\n返回规格阶段\n开始下一轮修订",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "discarded",
      "label": "丢弃失败候选\n超过 12 份规格\n超过 5 个完整实现",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "paper_suite",
      "label": "RE-Bench V1 · 七个环境\nLLM Foundry · Triton 内核 · 嵌入修复\nScaling Law · 受限架构 MLM\nGPT-2 问答 · Rust 编程题\n开放式机器学习研发任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "environment_contract",
      "label": "封装每个环境\n指令 + 资源 + 评分函数\n可见但较弱的起始解\n隐藏的高分参考解",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "actor_gate",
      "label": "在可比条件下运行\n采用墙钟时间预算\n每个环境最多使用 6 张 H100",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_runs",
      "label": "人类专家基线\n71 次八小时尝试\n共 61 名不同专家\n使用相同环境条件",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "agent_runs",
      "label": "AI 智能体尝试\n改变智能体设计与预算\n使用相同任务接口",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_work",
      "label": "迭代完成开放式任务\n编辑文件 · 运行代码 · 实验\n运行过程中调用评分函数\n将分数与时间写入日志",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_gate",
      "label": "选择单次运行原始分数\n常规环境与\nScaling Law 环境分流",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "highest_log",
      "label": "六个常规环境\n取运行结束前日志中\n记录的最高分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "scaling_final",
      "label": "Scaling Law 环境\n智能体无法看到所得分数\n仅最终提交计分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "对每个任务线性归一化\n原始 y · 起始 ys · 参考 yr\nyn = (y - ys) / (yr - ys)\n起始解 = 0 · 参考解 = 1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "floor_score",
      "label": "应用分数边界\n差于起始解时置为 0\n允许分数大于 1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalized_score",
      "label": "单次运行归一化分数\n可在七个环境之间\n进行比较",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "best_of_k",
      "label": "构造 score@k 样本\n每个环境内对运行结果\n有放回抽取 k 次",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "selection_gate",
      "label": "聚合抽取的 k 次运行\n分数可见任务与\n分数隐藏的 Scaling Law 分流",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "max_select",
      "label": "常规环境\n从 k 次抽样运行中\n选择最高分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "random_select",
      "label": "Scaling Law 环境\n分数不可观察\n随机选择一次抽样运行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_report",
      "label": "报告 score@k\n对七个环境的归一化分数\n取平均\n比较人类与智能体",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_snapshot",
