{
  "version": 1,
  "title": "LoraxBench 构建流程",
  "type": "academic-diagram",
  "source": "edited",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 27,
    "edges": 33,
    "modules": 0
  },
  "nodes": [
    {
      "id": "evidence",
      "label": "固定主要证据\narXiv 2508.12459v1 · 2025-08-17\ngoogle/LoraxBench @ 1ebe2dac\n七个 Parquet 文件 · CC BY 4.0",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "coverage",
      "label": "定义 20 种语言 · 23 个子集\n印尼语 + 19 种本地语言 · 三种各分为两个语域\n爪哇语 · Krama / Ngoko\n巽他语 · Lemes / Loma\n马都拉语 · Engghi Ethen / Enja’Iya",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "route",
      "label": "将六类印尼语源任务并行分流",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reading",
      "label": "阅读理解 · TyDi-QA\n印尼语 Secondary Task\n保留文章 + 问题 + 文中答案片段\n每子集 564 条测试 + 100 条训练",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_qa",
      "label": "开放域问答 · 来自阅读理解测试集\n移除文章 · 逐题人工验证\n删除 6 道不可回答问题\n每子集 558 条测试题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "nli",
      "label": "自然语言推断 · IndoNLI\n专家编写测试集 · 单句子集\n前提 + 假设 · 三分类标签\n每子集 1,446 条测试题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "translation",
      "label": "机器翻译 · IndoNLI\n复用 251 条印尼语前提句\n翻译成 22 个源语言/语域版本\n评测方向：本地语言 → 印尼语",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "causal",
      "label": "因果推理 · COPAL-ID\n曾居雅加达的母语者\n过滤雅加达特有题\n原因 / 结果 · 两个选项\n每子集 365 条测试题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cultural",
      "label": "文化问答 · IndoCulture\n选择非省份特定题\n删除 61 · 修正错字 12 · 改进干扰项 13\n每子集 510 道三选一题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_records",
      "label": "整理印尼语主记录\n保留任务专属字段与标准答案\n按任务保留上下文和选项\nMCQA 训练集与测试集分开",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "indonesian",
      "label": "保留印尼语原始记录\n仅适用于五类非翻译任务\n这些记录不经过翻译\n发布时与 22 个本地变体配套组装",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "guidelines",
      "label": "执行翻译指南\n保持语义 · 不增删上下文\n只选一个自然译法 · 不用“/”或括号\n数字形式与印尼语原文一致\n严格采用指定正式/日常语域",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "translate",
      "label": "专业母语者翻译\n供应商聘用双语母语标注者\n同时掌握印尼语与对应本地语言\n翻译方向：印尼语 → 本地语言",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "人工 + 脚本辅助验证\n第二位母语者复核每条记录\nSheets 标记长度 / 数字异常\n每种语言聘用 8–31 名标注者",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "retranslate",
      "label": "修正确认错误\n重译被标记的错误项\n团队会议解决不一致\n将修正版本纳入发布",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "组装 23 个子集 · 机器翻译仅含 22 个源变体\n发布六个 Hugging Face 配置\n测试 84,711 + MCQA 训练 2,300\n官方总量 · 87,011 行\n数据 revision · 1ebe2dac",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "count_drift",
      "label": "保留数量口径证据\n论文表 3 合计 · 84,711 条测试\n论文 §3.5 正文 · 84,895（多 184）\nHF · 84,711 测试 + 2,300 训练",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "public_boundary",
      "label": "公开发布边界\nCC BY 4.0 数据与 README\n未公开构建或评测代码\n未固定上游 revision / 选择随机种子",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "eval_scope",
      "label": "选择评测设置\n六类任务均做零样本评测\n阅读理解另外做少样本实验\n使用其 100 条训练样本池",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompts",
      "label": "构造附录中的任务提示\n基础提示 · 直接作答\n语言提示 · 说明与印尼语相似\nGATITOS 词典 · 仅覆盖支持语言",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "运行已选择的推理模式\n使用论文列出的模型检查点\n多语言 · 东南亚 · 印尼专用模型\n按适用范围调用闭源或开源模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_mode",
      "label": "配置答案 / 推理模式\n生成文本 + 答案抽取\nNLI / 文化 / 因果 · 选项对数概率\n文化 / 因果 · 完形对数概率\n概率模式仅适用于开源模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "计算任务指标\n五类非翻译任务 · 准确率\n机器翻译 · ChrF++\n开放问答 · 标准答案是输出子串",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "附录敏感性分析\nGemini-2.5-Flash 评审 · 1–5 分\n得分除以 5 归一化\n论文提醒低资源语言评审可靠性风险",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "best_prompt",
      "label": "选择表现最佳设置\n报告各提示中的最大表现\n包含适用的答案选择模式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 LoraxBench 结果\n任务 × 模型 × 语言\n印尼语与本地语言对比\n正式与日常语域对比",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "eval_gap",
      "label": "评测可复现性边界\n未公开解码配置\n未公开少样本 k / 抽样规则 / 随机种子\n未发布超出论文描述的精确解析器代码",
      "type": "document",
      "size": "xl"
    }
  ],
