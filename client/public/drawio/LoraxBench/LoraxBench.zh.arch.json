      "type": "database",
      "size": "xl"
    },
    {
      "id": "tydi",
      "label": "改造 TyDi-QA\n阅读理解保留文章\n开放问答移除文章\n各子集保留测试集及 100 条训练题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "other_tasks",
      "label": "形成另外四类任务\nNLI 来自专家编写的 IndoNLI 测试集\n翻译取自 IndoNLI 前提句\n因果推理与文化问答采用多选题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cleanup",
      "label": "按数据源执行清洗\n删除 6 道不可回答的开放问答\n删除偏向雅加达的 COPAL-ID 题\n将 IndoCulture 整理为 510 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "translate",
      "label": "由母语者翻译\n每种语言使用专业译者\n按任务要求连接本地语言与印尼语\n采用统一任务指南",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "由第二位母语者复核\n检查语言和文化有效性\n通过团队会议对齐判断\n每种语言 8–31 位标注者",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "checks",
      "label": "运行翻译自动检查\n标记异常文本长度\n标记数字不一致\n将可疑项送回修正",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "retranslate",
      "label": "修正被标记的翻译\n重译已确认的错误\n重新检查修正记录\n保留语言与语域标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布官方数据\nHugging Face 共 87,011 行\n含 2,300 条 TyDi-QA 训练数据\n测试表合计 · 84,711",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "formats",
      "label": "构造六类任务输入\n分类与多项选择\n抽取式及开放式生成\n本地语言到印尼语翻译",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "运行模型评测\n五类任务使用零样本设置\n阅读理解使用少样本示例\n比较标准、语言与词典提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "使用任务专属指标\n非翻译任务采用准确率\n开放问答 · 答案子串匹配\n翻译 · ChrF++",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告多语言结果\n按任务与语言分解\n比较正式与日常语域\n分析不同提示策略差距",
      "type": "terminal",
      "size": "xl"
    }
