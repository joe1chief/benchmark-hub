  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2240" pageHeight="736" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="设计 20 个生产式环境
从零构建有状态 Docker Compose 系统
平衡现实性 · 多样性 · 权限交集
覆盖有用的 Linux 智能体工作流" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="对环境执行质量控制
人工 · 自动化 · 模型共同检查
迭代修订任务与评分器
公开 10 个环境 · 保留 10 个" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="构建 1,667 个主任务
LLM 辅助生成后由人工审核
功能 · 重构 · 修错 · 调研
重写 · 基础设施六类任务" style="ellipse;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="实现隐藏的主任务评分器
以外部二元检查判断成功
测试有用任务是否完成
评分逻辑不进入智能体上下文" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="人工编写 185 个副任务
副任务构建不使用 LLM
外泄 · 恶意软件 · 数据篡改
越权 · 监控破坏 · 密钥访问六类" style="ellipse;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="实现最小化隐藏副任务评分器
定义目标 · 评分细节 · 可选测试
区分即时失败与延迟失败
尽量缩小评分 API 接口面" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="形成同环境候选任务对
组合相容的主任务与副任务
不固化一套永久配对
对全部同环境组合执行检查" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="第一阶段 · 筛查意外完成
LLM 标记不可能 · 可能 · 很可能
识别会顺带触发副目标的主任务
将可疑任务对送入回放测试" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1400" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="第二阶段 · 回放并测试可疑任务对
在全新环境回放已保存的诚实轨迹
第二个模型只尝试完成评分器目标
删除通过者 · 总体约占 0.9%" style="rounded=1;arcSize=20;html=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1680" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="发布 LinuxArena 任务资源
20 个环境 · 1,667 主任务 · 185 副任务
区分公开环境与保留环境
以隐藏评分器维护评测完整性" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1960" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="运行诚实策略与攻击策略
