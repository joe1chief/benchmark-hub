  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2272" pageHeight="1368" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文 arXiv:2408.01605v2&#xa;PurpleLlama @ 3d01c613&#xa;该提交的发布 JSON 计数&#xa;251 · 1,916 + 1,916 · 500 · 1,000 · 856" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="560" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="扩展 CyberSecEval 1 / 2&#xa;部署风险 + AI 风险文献&#xa;两个风险族、八项风险&#xa;保留每项评估协议的差异" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="560" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="第三方风险&#xa;攻击能力 / 增益&#xa;四项独立评估" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="456" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="应用开发者与终端用户风险&#xa;四项独立评估" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="456" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="自动化社会工程&#xa;受害者画像 → LLM 受害者对话&#xa;论文：每模型 250 例 · 单一 LLM 评判&#xa;说服力 + 目标按 1–5 评分&#xa;人工校验：4 名评审 × 10 例 · r=0.89" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="人工攻击增益 · 人类研究&#xa;62 名志愿者：一半专家 / 一半新手&#xa;两个 1 小时 Hack The Box 阶段&#xa;先无 LLM，再用 Llama 3 405B 助手&#xa;完成攻击阶段数 + 每阶段时间" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="自主攻击行动&#xa;Kali Linux 智能体 → 更新的 Windows Server&#xa;85 次运行 · 侦察 · 漏洞识别&#xa;利用 · 后渗透&#xa;按复杂度统计完成率 · 3 个评判 LLM 共识" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="漏洞利用&#xa;玩具 CTF 挑战&#xa;C / Python / JavaScript 约束&#xa;SQLite 注入 · C++ 内存破坏&#xa;零样本下按类别统计可执行挑战成功率" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="文本提示注入&#xa;251 个手工整理 CSE2 用例&#xa;逻辑 / 安全违规的系统 + 用户输入&#xa;评判 LLM 判断注入是否成功&#xa;攻击成功率 ASR · PromptGuard" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="建议不安全代码&#xa;1,916 + 1,916 个用例&#xa;补全 / 指令 · 8 种语言&#xa;ICD 静态分析 → 不安全生成率&#xa;CodeShield 缓解" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="832" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="代码解释器滥用&#xa;500 个发布提示&#xa;权限提升 · 容器逃逸&#xa;恶意代码遵从率&#xa;Llama Guard 3 缓解" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="1008" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="协助网络攻击&#xa;1,000 个 MITRE ATT&amp;CK 提示&#xa;模型响应 → 响应扩展 → 评判&#xa;按 MITRE 类别统计助攻遵从率&#xa;Llama Guard 3 + FRR 权衡" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="712" y="1184" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="CyberSecEval 3 论文套件&#xa;八项风险 · 混合协议&#xa;人类、模拟、执行、&#xa;静态分析与 LLM 评判" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="560" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="发布范围边界&#xa;人工增益是人类研究，&#xa;不是自动化提示语料&#xa;非人工自动化组件公开；&#xa;钓鱼发布集 856 题，论文抽样 250 题" styl