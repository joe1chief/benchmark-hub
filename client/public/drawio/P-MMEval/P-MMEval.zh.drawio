    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="1072" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2411.09116v2 · PDF 00f32884b4d5&#xa;EMNLP 2025 终稿 · PDF 17f87baa7ede&#xa;HF 47bb647f35fd" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="固定十种语言&#xa;英文 · 中文 · 阿拉伯文 · 西班牙文 · 日文&#xa;韩文 · 泰文 · 法文 · 葡萄牙文 · 越南文&#xa;论文认定覆盖七个语言家族" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择三个基础组成部分&#xa;XNLI · MHellaSwag&#xa;语言理解&#xa;FLORES-200 · 语言生成" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="选择五个专项组成部分&#xa;HumanEval-XL · MGSM&#xa;MLogiQA · MMMLU&#xa;MIFEval" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="抽取基础任务测试数据&#xa;FLORES 完整测试集 · 1012 题&#xa;XNLI 按源顺序取前 120 题&#xa;MHellaSwag 按源顺序取前 120 题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="抽取专项任务测试数据&#xa;HumanEval-XL 80 · MGSM 250&#xa;MLogiQA 80 · MMMLU 简单200 + 困难200&#xa;MIFEval 先取110，删除14，最终96" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="补齐缺失语言&#xa;使用 gpt-4o-2024-05-13&#xa;保留已有人工标注&#xa;构造平行语言记录" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="专业翻译团队穷尽复核&#xa;纠正错误 · 本地化词汇&#xa;删除难以准确翻译的实例&#xa;最高修改率 82.50% · MHellaSwag 日文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="组装平行样本&#xa;跨语言匹配相同问题&#xa;保持标准答案与任务语义&#xa;支持实例级迁移分析" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="八个组成部分 · 七类任务&#xa;十种语言 · FLORES 1012&#xa;XNLI 120 · MHellaSwag 120&#xa;HumanEval-XL 80×12·MGSM 250&#xa;MLogiQA 80·MMMLU 400·MIFEval 96" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="统一评测提示&#xa;改编 OpenCompass 与 LM Evaluation Harness&#xa;MMMLU 使用 OpenAI simple-evals&#xa;增加固定答案格式约束" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="比较三种提示设定&#xa;英文 · 母语 · 英文少样本&#xa;从验证数据抽取示例&#xa;用 GPT-4o 补译缺失语言示例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="采用任务专用作答方式&#xa;MGSM 使用思维链&#xa;其他任务直接作答&#xa;小于 7B 的模型统一直接作答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="计算任务指标&#xa;准确率 · BLEU · Pass@1&#xa;HumanEval 取 Python · JavaScript&#xa;与 Java 的均值&#xa;COMET 仅为附录分析，不是主指标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="计算 CACR 英文→目标语言&#xa;英文答对题中两种语言均答对的比例&#xa;使用平行对齐的实例&#xa;报告跨语言迁移一致性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="报告多语言表现&#xa;按任务与语言汇总得分&#xa;汇总基础与专项任务均值&#xa;比较模型规模趋势与 CACR" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="语言家族数量边界&#xa;论文写明七个语言家族&#xa;Hugging Face 数据卡写八个&#xa;图中遵循论文" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="固定 HF 发布边界&#xa;FLORES：9 个文件 · 9,108 行&#xa;MHellaSwag：1,181 · 非 1,200&#xa;HumanEval-XL：26 × 12 个文件&#xa;论文范围：十种语言" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=ce