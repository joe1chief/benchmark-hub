ntFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="官方 Drive data_clean.zip&#xa;131,741,885 字节 · 无版本标签或 DOI&#xa;各划分行数复现论文表 3&#xa;原始 qbank 数量不是官方划分总数&#xa;SHA-256 1c2ca8130b3d86d9…" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="发布与权利边界&#xa;Drive 压缩包无 README / LICENSE&#xa;GitHub MIT 许可覆盖代码&#xa;不等于许可题目或教材&#xa;没有官方在线排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="-24" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="收集医学教材&#xa;USMLE / TWMLE：18 本英文教材&#xa;MCMLE：33 本简体中文教材&#xa;源材料为 PDF" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="教材许可边界&#xa;论文：签署许可协议后发布&#xa;仅限研究使用&#xa;可下载 ≠ 可不受限复用" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="976" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="对 PDF 教材执行 OCR&#xa;纠正拼写错误&#xa;将文本切分为段落&#xa;TWMLE 共用英文教材集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="形成检索语料库&#xa;英文 231,581 段&#xa;简体中文 116,216 段&#xa;1,273 万词元 / 1,473 万汉字" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="人工教材覆盖度审计&#xa;两名医学博士 · 每来源 100 道开发题&#xa;证据足够：美国 88% · 大陆 100%&#xa;台湾 87% · 仅诊断、不筛题" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="976" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="开放域四选一问答&#xa;题目 + 选项 + 教材语料&#xa;检索证据并选择一个答案&#xa;分考试来源独立评测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="论文评测采用&#xa;哪条语言路径？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="TWMLE 论文路径&#xa;繁体中文题目翻译为英文&#xa;使用 Google 翻译&#xa;运行与 USMLE 相同的模型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="536" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="原语言论文路径&#xa;USMLE：英文题目 + 英文语料&#xa;MCMLE：简体中文题目 + 中文语料&#xa;保持来源特定开发 / 测试集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="776" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="论文基线方法族&#xa;随机 · PMI · IR-ES · IR-CUSTOM&#xa;检索器 → MAX-OUT 阅读器&#xa;BERT / BioBERT / RoBERTa 系列" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="事后 Top-25 检索审计&#xa;两名医生 · 每来源 100 道开发题&#xa;完整 / 部分 / 无：美国 24 / 8 / 68&#xa;大陆 75 / 21 / 4 · 台湾 60 / 16.7 / 23.3&#xa;Top-N 召回率有条件 · 不计分" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="376" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="报告论文最佳测试准确率&#xa;USMLE 英文 36.7%&#xa;MCMLE 简体中文 70.1%&#xa;TWMLE 繁体中文 42.0%&#xa;无人类分数或综合指标" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="仅发布 IR 基线&#xa;代码 HEAD 27b02f66aac2&#xa;textsearch.py SHA f23d7ccaef21&#xa;Python 3.6 · Elasticsearch 2.4.1&#xa;读取 question / options / answer_idx" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="1056" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="构建教材搜索索引&#xa;英文 Snowball 分析器&#xa;中文 SmartCN 分析器&#xa;BM25 · 单分片 · 无副本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="1056" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="为每个答案选项打分&#xa;查询 = 题干 + 选项文本&#xa;汇总 Top-N Elasticsearch 分数&#xa;发布代码默认 topn = 1" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="1056" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="选择置信分最高的选项&#xa;仅在严格大于时更新&#xa;正分并列时保留首个最大值&#xa;将选项标签与 answer_idx 比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="1056" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="发布代码准确率&#xa;正确选项数 / 全部解析行 × 100&#xa;不设部分得分&#xa;打印一位小数百分比" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="1056" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="评测器实现边界&#xa;IR 基线，不是通用 LLM 评测器&#xa;无自由文本答案解析或无效规则&#xa;缺字段或全零分数可能直接中止" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="1376" width="200" height="100" as="geometry"/></mxCell><mxCell id="31" value="分别发布有证据支撑的结果&#xa;论文模型按考试来源报告准确率&#xa;发布 IR 脚本按 JSONL 报告准确率&#xa;人工审计保持为诊断项&#xa;无官方综合分或在线排行榜" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2744" y="856" width="200" height="100" as="geometry"/></mxCell><mxCell id="32" value="固定论文与发布证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#9E9E9E;strokeWidth=1;endArrow=open;endFill=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=3 3;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="34" value="当前爬虫未发布" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#9E9E9E;strokeWidth=1;endArrow=open;endFill=0;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dash