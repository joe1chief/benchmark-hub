  "nodes": [
    {
      "id": "scrnaseq_datasets",
      "label": "精选单细胞转录组 (scRNA-seq) 图谱库\n汇聚 10x Genomics 与 Smart-seq2 等公开与专有单细胞测序集\n涵盖丰富的人体与模式生物组织类型、细胞分群及实验批次变异",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "workflow_curation",
      "label": "生物信息学分析流程任务设计\n基于标准 Scanpy 与 Seurat 分析管线构建结构化生信评测任务\n设定细胞类型标注、差异表达基因分析与批次效应校正三大核心方向",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ground_truth_pipeline",
      "label": "生信金标准分析基准管线\n基于金标准细胞标志基因 (Marker Genes) 与参考图谱生成标签真值\n精确计算统计差异表达倍数变化 (Log2FC) 与批次整合校正指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_quality_gate",
      "label": "生信分析任务生物学合理性核验？\nLatchBio 资深计算生物学家严格把关任务设计严谨性与合理性\n核验测序深度是否充足、质控过滤是否合规及细胞群区分度是否显著",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_task_discard",
      "label": "低质测序与模糊细胞聚类剔除池\n过滤细胞活性低、双胞率过高或聚类严重混杂的不达标样本任务\n确保入选分析任务具备高信噪比与明确的生物学事实支撑",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "undisclosed_sourcing_boundary",
      "label": "专有数据集溯源与发布边界声明\nClaude Sonnet 5 系统卡第 8.14.2 节披露 195 道单细胞评测题\n完整原始数据采纳来源、标注细节与切分元数据属于内部未公开资产",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "task_cohort_partition",
      "label": "195 道专业问题分流校准\n将 195 道生信题目均衡分配至三大单细胞核心计算分析能力\n涵盖细胞类型鉴定标注、差异表达分析及跨批次数据集整合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "singlecellbench_freeze",
      "label": "SingleCellBench 冻结评测基准套件\n包含 195 道经过严格生信质控的单细胞转录组分析问题\n标准化配备输入 AnnData 矩阵对象与生物学研究探索问题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "bioinformatics_prompt_assembly",
      "label": "生物信息学专业提示词封装\n组装单细胞基因表达矩阵元数据与特定生物学分析提问\n提示模型推导细胞群体特征、输出分析结论或编写分析处理代码",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "基座大模型生信推断与代码生成\n大模型执行生物学逻辑推导或编写 Python (Scanpy) / R (Seurat) 代码\n深度解析 UMAP 降维聚类特征、差异表达热图与生物学统计检验表",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execution_sandbox",
      "label": "隔离生信分析代码运行沙箱\n在预装 Scanpy、Harmony 及 Scipy 的容器沙箱中执行生成代码\n安全捕获代码执行日志、计算所得聚类度量值及最终分析结论",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execution_status_gate",
      "label": "沙箱代码成功执行且格式合规？\n核验代码是否零异常成功跑通、语法合法且按格式给出预测结果\n明确区分纯编程语法崩溃与高级生物学逻辑分析偏差",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "runtime_error_sink",
      "label": "代码执行崩溃与语法异常池\n记录导包错误、内存溢出、死循环及运行中断等编程层级失误\n精确定量衡量模型在复杂单细胞数据科学中的基础编码鲁棒性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "bioinformatic_evaluator",
      "label": "流程定制学生物信息学评分器\n针对细胞标注计算调整兰德指数 (ARI)、NMI 与 F1 标签一致性\n针对差异表达比对 Log2FC 相关系数，针对批次校正计算 LISI 整合度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "undisclosed_metric_gate",
      "label": "综合评测指标达标判定？\n系统卡披露 195 题的高层综合模型得分 (Aggregate Score)\n判定模型输出的生物学结论是否符合专业生信实验金标准",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "singlecellbench_reporting",
      "label": "SingleCellBench 官方评测报告\n完整呈现 Claude Sonnet 5 系统卡中披露的基准综合汇总得分\n细粒度呈现细胞标注、差异基因分析与批次校正各子任务能力",
      "type": "terminal",
      "size": "xl"
    }
  ],
