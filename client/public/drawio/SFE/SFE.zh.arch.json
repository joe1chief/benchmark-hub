  },
  "nodes": [
    {
      "id": "discipline_selection",
      "label": "五大多学科前沿基础科学领域\n天文学、化学、地球科学、生命科学与材料科学\n由各学科博士专家梳理确立的高价值基础科研前沿方向",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "native_data_harvest",
      "label": "原生科研实验与仿真数据集\n涵盖望远镜、光谱仪及模拟器等 17 种异构原始科研数据格式\n包含 FITS、CIF、PDB、NetCDF、质谱与地震波信号",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "visual_rendering_engine",
      "label": "科研数据标准化可视化渲染\n将原始矩阵与高维坐标渲染为科研出版级高保真科学图像\n生成多波段谱图、晶体衍射图样及显微结构拓扑切片",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "vqa_authoring",
      "label": "专家级双语科学问答对编写\n各学科 2-5 位专业科研人员协同编写高质量 VQA 题对\n覆盖信号感知、属性理解与比较推理三层递进认知维度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "expert_consensus_gate",
      "label": "跨学科专家交叉同行评审？\n多位同行专家双盲独立核验科学事实准确性与解题自洽性\n验证科学金标准答案的唯一性与物理/化学规律严谨性",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_vqa_discard",
      "label": "科学瑕疵与语义歧义题目剔除池\n过滤渲染失真、题意不明或存在科学争议的不合格候选题目\n确保入选问答在五大自然科学领域内绝对严谨无误",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "format_syntax_gate",
      "label": "自动化语法与空间定位格式校验？\n核验坐标框格式、JSON 数据模式与中英文双语题意对齐\n确保目标空间定位 IoU 标注与 LaTeX 公式语法完备合规",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "format_repair_discard",
      "label": "格式不合规或标注错位剔除池\n剔除坐标格式损坏、双语不对齐或正则无法解析的不合格项\n严格保障基准元数据结构的统一机器可读性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "sfe_dataset_freeze",
      "label": "SFE 冻结科学评测基准套件\n包含 66 项专业科研任务的 830 组高质量双语科学 VQA 题对\n均衡覆盖 5 大基础学科、3 层认知维度与 3 种作答题型",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "multimodal_prompt_assembly",
      "label": "科学多模态输入提示词封装\n组装高保真科学渲染图像与中英双语专业题干提示词\n采用零样本评测协议 (T=0) 并赋予顶级科研专家系统角色",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "vlm_scientific_inference",
      "label": "多模态大模型科学认知推理\n多模态视觉语言模型解析专业科学图谱、切片与结构图\n自回归生成分步科学思维链推导及目标答案表达",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_type_routing_gate",
      "label": "作答题型与模态评测分流？\n客观选择题/精确匹配题 vs 开放阐述题 vs 科学目标空间定位题\n将模型预测分流至对应学科定制的计分引擎",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "objective_scorer",
      "label": "确定性客观匹配与公式校验引擎\n执行选择题选项正则精确匹配及数值/物理化学公式容差比对\n统计各学科层级的绝对客观准确率 (%)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_semantic_evaluator",
      "label": "语义相似度与专家模型裁判评估\n计算 BERTScore F1 文本语义得分并调用专家级 LLM 裁判评分\n全方位评估科学逻辑推理深度与事实叙述准确性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "grounding_iou_engine",
      "label": "空间视觉定位与代码执行验证器\n解析模型预测的目标包围盒坐标并计算重合交并比 (IoU)\n评估针对原生科学数据格式的处理与分析代码执行成功率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sfe_metrics_reporting",
      "label": "SFE 多学科综合科研基准报告\n汇报综合准确率、BERTScore F1、定位 IoU 与执行成功率\n全面呈现 5 大学科、3 层认知阶梯与双语维度的细粒度能力图谱",
      "type": "terminal",
      "size": "xl"
    }
  ],
