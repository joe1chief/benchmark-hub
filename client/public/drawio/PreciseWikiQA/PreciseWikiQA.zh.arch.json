  "nodes": [
    {
      "id": "step_1",
      "label": "定义评测范围\n评估外在幻觉\n使用假定已见的训练知识\n要求简短事实答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "从GoodWiki开始\n44,754个高质量维基页面\n覆盖广泛主题与事实内容\n使用公开可复现来源池",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "关联WikiRank重要度\n使用每页调和中心性\n代理训练语料出现频率\n排列头部到长尾知识",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "创建十个难度桶\n标记为0至9级\n按中心性由难到易\n稳定动态集难度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "抽取5,000个源页面\n每个难度桶抽500页\n平衡全部难度层级\n每个动态集重新采样",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "选择参考章节\n把百科页面切为章节\n随机选取一个章节\n推理时不提供该来源",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "生成客观问题\nLlama 3.1 70B阅读章节\n问题具体且自包含\n无需额外上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "独立生成标准答案\n基于同一参考章节作答\n分开问题与答案生成阶段\n减少答案对问题措辞泄露",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "执行问答质量约束\n答案为词或短语\n删除超过十词的答案\n无法回答则重新生成问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "形成动态测试集\n5,000组问答\n不发布固定问题列表\n保持可复现难度分布",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "查询被测模型\n只提供问题不提供上下文\n允许回答或拒答\n记录自由文本响应",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "先判断是否拒答\n识别因知识不足而放弃\n纠正问题仍视为尝试回答\n使用LLM评判提示词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "判断已尝试答案\n响应与标准答案比较\n正确 · 错误 · 不可验证\n后两类均视为幻觉",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告三项指标\n错误拒答率\n已尝试答案中的幻觉率\n总体正确率 · 三次运行平均",
      "type": "terminal",
      "size": "xl"
    }
  ],
