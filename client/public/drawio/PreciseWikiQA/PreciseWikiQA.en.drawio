    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="816" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Fixed Primary and Official Evidence&#xa;arXiv 2504.17550v1 · PDF 2257f8628da9&#xa;Git 80307ac6bc9f · GoodWiki 7491f6da6439&#xa;Paper, Code, and Source Data Are Separated" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Define Extrinsic Hallucination Evaluation&#xa;Ask Short Fact-seeking Queries&#xa;Assume Knowledge Could Be in Training Data&#xa;Use No Context at Inference" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Pin the GoodWiki Source&#xa;44,754 Pages · September 4, 2023&#xa;HF Revision 7491f6da6439&#xa;Parquet LFS SHA 2b8b3edebede" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Join WikiRank 2024 Importance&#xa;Harmonic Centrality per Wikipedia Page&#xa;Titles SHA f83bc6ac3f3a&#xa;Scores SHA 2acf403c1f0e" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Create 10 Bins&#xa;0 Hardest · 9 Easiest&#xa;Centrality Proxies Training-data Frequency&#xa;Keep the Distribution Stable across Runs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Sample the Source Pool&#xa;Draw 500 Pages per Bin&#xa;Use 5,000 Source Pages per Trial&#xa;Regenerate the Dynamic Set Each Trial" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Select One Reference Section&#xa;Chunk Each Wikipedia Page into Sections&#xa;Drop the Last Section when More than Two&#xa;Randomly Select One Remaining Section" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Generate an Objective Question&#xa;Llama-3.1-70B-Instruct&#xa;Concise · Context-free · Single Answer&#xa;Question Temperature 0.7 · Top-p 0.9" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Generate the Gold Answer Separately&#xa;Use the Same Reference Section&#xa;Return One Word or a Short Phrase&#xa;Answerability Call Uses Temperature 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Quality Gate&#xa;Unanswerable: Regenerate&#xa;&gt;10 Words: Filter" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Form a Dynamic Test Set&#xa;5,000 Question-answer Pairs per Trial&#xa;No Fixed Public Question List&#xa;Run Three Independently Generated Trials" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Audit Generated Gold Answers&#xa;Human Annotation on 250 Generated Pairs&#xa;97.2 Percent of Answers Are Correct&#xa;Judge Accuracy Is Validated Separately" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor