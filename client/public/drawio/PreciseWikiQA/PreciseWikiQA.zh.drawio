<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="816" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定论文与官方证据&#xa;arXiv 2504.17550v1 · PDF 2257f8628da9&#xa;Git 80307ac6bc9f&#xa;GoodWiki 7491f6da6439 · 各来源分开" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义外在幻觉评测&#xa;提出简短事实查询&#xa;假设知识可能存在于训练语料&#xa;推理时不提供维基百科上下文" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="固定GoodWiki来源&#xa;44,754页 · 采集于2023年9月4日&#xa;HF版本7491f6da6439&#xa;Parquet LFS哈希2b8b3edebede" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="关联WikiRank 2024重要度&#xa;使用每个维基页面的调和中心性&#xa;标题哈希f83bc6ac3f3a&#xa;分数哈希2acf403c1f0e" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="创建10个档位&#xa;0最难 · 9最易&#xa;中心性代理训练数据出现频率&#xa;保持不同运行的难度分布稳定" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="抽取来源页面池&#xa;每档抽取500页&#xa;每次试验使用5,000个来源页&#xa;每次试验重新生成动态集合" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="选择一个参考章节&#xa;将每个维基页面切分为章节&#xa;超过两节时去掉最后一节&#xa;从剩余章节随机选择一个" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="生成客观问题&#xa;使用Llama-3.1-70B-Instruct&#xa;简洁 · 无需上下文 · 唯一答案&#xa;问题温度0.7 · Top-p 0.9" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="独立生成标准答案&#xa;使用同一参考章节&#xa;仅返回一个词或短语&#xa;可回答性调用温度为0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="质量门&#xa;不可回答：重新生成&#xa;超过10词：过滤" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="形成动态测试集&#xa;每次试验5,000组问答&#xa;不提供固定公开问题列表&#xa;独立生成并执行三次试验" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="审核生成的标准答案&#xa;人工标注250组生成问答&#xa;97.2%的答案正确&#xa;另行验证评审模型准确率" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="执行被测模型推理&#xa;只发送问题 · 不附上下文&#xa;温度0 · Top-p 1&#xa;使用各模型默认聊天模板&#xa;三次试验 · 自由文本响应" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="收集自由文本响应&#xa;允许直接回答或拒答&#xa;不添加维基百科检索上下文&#xa;为两类评审保留完整文本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="使用Llama-3.1-70B-Instruct&#xa;拒答JSON&#xa;纠正答案 = 尝试" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="判断已尝试答案是否正确&#xa;将响应与标准答案比较&#xa;正确 · 错误 · 不可验证&#xa;后两类都计为幻觉" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="报告三次试验平均指标&#xa;错误拒答率&#xa;尝试回答中的幻觉率&#xa;总体正确回答率" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="数据版本边界&#xa;固定GoodWiki版本7491f6da6439&#xa;WikiRank下载地址没有版本号&#xa;本次审查以观测字节哈希固定" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="论文与批处理重生成差异&#xa;论文重试不可回答的问题&#xa;批处理以continue直接丢弃&#xa;每个桶使用100个候选缓冲" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="固定运行器边界&#xa;模块默认N为5000 · 脚本传入N为1&#xa;未固定抽样随机种子&#xa;被测模型默认最多生成256词元" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="评审提示与解析器差异&#xa;提示先列三类又要求Yes或No&#xa;解析器接受精确的correct或yes&#xa;其余结果全部标为幻觉" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="许可证与权利边界&#xa;HalluLens：CC BY-NC 4.0&#xa;GoodWiki数据集：MIT&#xa;不推断WikiRank未声明的权利" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto