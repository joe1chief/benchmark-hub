<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1800" pageHeight="1392" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="汇集八个医学问答源集&#xa;MedQA · PubMedQA · MedMCQA · MedBullets&#xa;MMLU · MMLU-Pro · MedExQA · MedXpertQA&#xa;MedXpertQA 再分为 R 与 U" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="统一多项选择题记录&#xa;问题 · 选项映射 · 标准答案索引&#xa;保留数据集与真实题目标识&#xa;每题三至十个选项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="用多模型探测每道候选题&#xa;覆盖多种模型架构&#xa;统计 N 个模型中答对的 k 个&#xa;避免单模型难度偏差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="答对模型比例 k / N&#xa;是否严格低于 50%？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="按子集抽取困难候选题&#xa;每个子集最多 100 题&#xa;平衡九个评测子集&#xa;保持源数据多样性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="标注推理深度&#xa;四名临床阶段医学生&#xa;五级最少推理步骤量表&#xa;先校准再重叠标注估计一致性" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="审查题目有效性&#xa;标记错答案与上下文不足&#xa;标记陈旧或临床无关知识&#xa;任一标记都会触发小组复核" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="是否少于两名标注员&#xa;认定该问题确实成立？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="执行 MELD 污染筛查&#xa;去掉选项并将问题一分为二&#xa;让模型续写未见的后半段&#xa;计算 Levenshtein 相似度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1520" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="汇合两类核验证据&#xa;人工有效性 + MELD 证据&#xa;MELD 阈值与剔除量未披露&#xa;最终计数对账方式未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="从论文困难集剔除&#xa;简单候选或有效性失败&#xa;人工审核共剔除 21 题&#xa;错答案 5 · 上下文 5 · 无关 11" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="发布论文 v3 MedicalAgentsBench&#xa;共 862 题 · 平均 147.4 Tokens&#xa;七个子集各 100 题 + MedBullets 89&#xa;+ MMLU 73，合计九个子集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="已锁定公开发布包的漂移&#xa;Git v1.0 与 HF/Zenodo 多出 32 题 AfriMedQA&#xa;README 任务表合计 894，而非 862&#xa;论文未给出对账说明" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="执行标准化评测&#xa;七个基础模型 + 三个内化推理模型&#xa;九种外化方法，覆盖范围不一&#xa;SPO/AFlow：仅 GPT-4o-mini / GPT-4o&#xa;Agent 仅评困难集 · 独立运行三次" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="抽取单个选项标签&#xa;各方法使用 JSON 或 LLM 解析器&#xa;必要时重新实现 Agent 选择题解析&#xa;发布包没有单一通用解析器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="运行器是否输出同时含 realidx&#xa;与 predicted_answer 的结果行？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="方法专属失败或省略&#xa;全局计分器不会补回缺失 ID&#xa;因而不强制使用固定 862 分母" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="按选项精确相等计分&#xa;标准答案优先 answer_idx，否则 answer&#xa;仅预测与标准值相等才正确&#xa;单题得分为一或零" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="先按 realidx 去重&#xa;准确率为保留结果行的均值&#xa;对论文九个子集做宏平均&#xa;报告三次运行的均值与标准差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="在保留结果行平均成本与耗时&#xa;成本按 API Tokens 或托管费率&#xa;原始时间为完整周期墙钟均值&#xa;Pareto 笔记本调整 DeepSeek-V3&#xa;绘图时间 = 原始均值 / 10" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="560" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="发布准确率与成本结果&#xa;Pass@1 与各子集准确率&#xa;推理成本与调整后时间标记&#xa;经验准确率成本 Pareto 前沿" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="1208" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="25" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5