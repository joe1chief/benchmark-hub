  "nodes": [
    {
      "id": "sources",
      "label": "汇集八个医学问答数据集\nMedQA、PubMedQA、MedMCQA\nMedBullets、MMLU、MMLU-Pro\nMedExQA 与 MedXpertQA",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "standardize",
      "label": "统一多项选择题合同\n保留问题选项和正确答案\n统一数据集与题目标识\nMedXpert 分 R 与 U 子集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "probe",
      "label": "用多架构模型探测难度\n对每个候选题运行代表模型\n统计模型正确作答比例\n避免单一架构定义难度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hardgate",
      "label": "执行困难候选门槛\n仅保留模型正确率低于 50%\n聚焦尚未饱和的临床推理\n排除明显简单题目",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "sample",
      "label": "平衡九个评测子集\n七个子集各取 100 题\nMedBullets 取 89 题\nMMLU 取 73 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "depth",
      "label": "核验多步推理深度\n四名临床阶段医学生\n使用五级推理深度量表\n记录离散推理和判断步骤",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "validity",
      "label": "审核问题临床有效性\n标记错答案和上下文不足\n排除陈旧或临床无关知识\n共移除 21 个问题",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "meld",
      "label": "使用 MELD 筛查污染\n问题文本去掉答案选项\n前半提示生成后半内容\n按 Levenshtein 相似度识别记忆",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MedicalAgentsBench\n最终包含 862 道困难题\n平均长度 147.4 tokens\n覆盖八源集九个子集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "basemodels",
      "label": "评测十个基础模型\n七个非推理基础模型\n三个内化推理模型\n使用统一提示和选择解析",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "methods",
      "label": "评测九种外化推理方法\nCoT 与 Self-Consistency\n三种高级提示方法\n四种协作或搜索型 Agent",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "计算选择题准确率\n比较预测选项与答案索引\n按九个子集汇总结果\n再计算跨数据集平均值",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "cost",
      "label": "统计推理成本与耗时\n商业模型按 token 定价\n开源模型按托管价格估算\n记录样本完整交互耗时",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "发布能力成本联合分析\n对比内化与外化推理\n绘制准确率成本 Pareto 前沿\n报告模型方法互补效果",
      "type": "terminal",
      "size": "xl"
    }
  ],
