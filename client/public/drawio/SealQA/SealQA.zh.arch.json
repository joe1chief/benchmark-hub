  "nodes": [
    {
      "id": "step_1",
      "label": "组建 NLP 专业研究团队\n6 名资深自然语言处理专家\n平均每道题目耗时逾 1 小时",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "确立 5 类高难度题型\n复杂多步推理、歧义辨析、时效追踪\n跨语言搜索与虚假前提识别",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "撰写单确定解题目\n编写题意明确、唯一确定答案之问题\n确保标准答案无争议可检验",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "挂载参考来源与解析\n关联支撑网页 URL 及详细推导解释\n标注预期搜索路径与关键词",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "标注时效性元数据\n记录信息有效年份与定期复审周期\n标识高动态变化知识点",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "前沿模型试跑与淘汰\n在最顶尖联网大模型上反复测试\n持续改写直至受测前沿模型全部做错",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "同行交叉复审流程\n至少 2 名硕博研究员独立核验\n检查网页链接有效性、答案与表述",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "专家终审与复查排期\n资深专家终极签署确认收录\n确立动态时效性定期复检日历",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "Seal-0 绝对零分核心集\n筛选前沿模型准确率恒为 0% 的 111 题\n构建极限能力检验试金石",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "Seal-Hard 综合挑战集\n扩充至 254 道高难度网页检索问答\n附带权威黄金参考链接与解题推导",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "LongSeal 长文本干扰集\n每题配比 1 篇真值文档与 50 篇强干扰\n随机插入至 12/20/30 篇长文档上下文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "联网工具自主模式\n智能体自主调用搜索引擎与浏览器工具\n实时浏览网络页面并提取解题线索",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "搜索注入辅助模式\n将预检索外部证据片段注入提示上下文\n评测智能体在噪音证据下的纯推理能力",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "LongSeal 上下文打包\n在海量强干扰文档中乱序混入真值文献\n评估长上下文检索定位与抗干扰稳健性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_15",
      "label": "智能体执行与答案生成\n在指定配置下运行受测系统\n生成最终回答文本与推导结论",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_16",
      "label": "GPT-4o-mini 智能判分与出报\n标注正确、错误或放弃尝试三大类别\n输出全集准确率及五大题型分项报告",
      "type": "terminal",
      "size": "xl"
    }
  ],
