      "type": "database",
      "size": "xl"
    },
    {
      "id": "download",
      "label": "下载候选视频\n要求分辨率至少为 720P\n保留版式、主题与时长元数据\n分配至四个时长组",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "subtitles",
      "label": "确保具备英文字幕\n对提供字幕的平台删除缺失或非英文视频\n其余平台用 Whisper-V3-Large 生成\n保留带时间戳的字幕片段",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "过滤视觉与内容质量\n使用 Q-Align 评估视频质量\n删除质量特别低的候选项\n人工剔除无法标注的视频",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "video_set",
      "label": "确定 3,763 个最终视频\n保留全部 10 个内容类别\n覆盖四个目标时长区间\n视频与字幕均完整可用",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "train_annotators",
      "label": "培训有经验的标注者\n讲解每一种问题类别\n在视频上显示时间对齐字幕\n要求先完整观看视频",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "questions",
      "label": "编写引用推理多选题\nL1 感知 · L2 关系\n覆盖 17 个细粒度问题类别\n加入 3–4 个相关干扰选项",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "grounding",
      "label": "定位每道题的引用上下文\n在问题中突出引用查询\n标注所有引用时刻的帧索引\n覆盖单个或多个视频时刻",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qc",
      "label": "执行三角色标注质检\n主标注者创建问题并过滤视频\n检查者核对类别与要求\n修订者修正约 20% 的问题标注",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 6,678 道人工多选题\n验证集 · 752 视频 / 1,337 题\n测试集 · 3,011 视频 / 5,341 题\n保留时长组与题型标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "interleave",
      "label": "构造交错多模态输入\n沿时间轴采样视频帧\n将字幕插入其前后相邻帧之间\n以字幕中点时间戳对齐",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "运行零样本多模态模型评测\n在验证集上选择帧采样设置\n每道题输出一个多选答案\n以选定设置运行测试集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告多项选择准确率\n验证集与测试集总体准确率\n分解四个时长组\n分解 17 个问题类别",
      "type": "terminal",
      "size": "xl"
    }
