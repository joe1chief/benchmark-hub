  "nodes": [
    {
      "id": "b1",
      "label": "B1 · 定义覆盖网格\n4 个不连续时长区间\n(8,15] · (15,60] 秒\n(180,600] · (900,3600] 秒\n10 个内容类别",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b2",
      "label": "B2 · 下载网页视频\n119 个频道 · 横屏 99 + 竖屏 20\n官方平台 API · 2024 年 4 月\n接受分辨率 ≥ 720P",
      "type": "database",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "d1",
      "label": "平台提供转录字幕？",
      "type": "decision",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b3",
      "label": "已有转录字幕路径\n剔除缺失字幕的视频\n剔除非英语字幕的视频\n保留带时间戳英语文本",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b4",
      "label": "无转录字幕路径\n生成英语字幕\nWhisper-V3-Large\n保留时间戳",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b5",
      "label": "B3 · 采样与质量过滤\n均匀覆盖主题 / 10 个类别\nQ-Align 分数范围 [0,1]\n仅保留分数 > 0.25",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "b6",
      "label": "B4 · 人工过滤视频\n剔除静帧 / 字幕不完整视频\n论文最终数量 · 3,763 个视频\n视频 + 英语字幕",
      "type": "database",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "a1",
      "label": "B5 · 培训有经验的合同标注者\n受控实验室 · 按题型培训\n显示时间对齐字幕\n标注前完整观看视频",
      "type": "user",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "a2",
      "label": "B6 · 编写引用推理多选题\nL1 感知 + L2 关系\n17 个细粒度题型\n4–5 个选项 · 3–4 个相关干扰项",
      "type": "document",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "a3",
      "label": "B7 · 定位被引用上下文\n包含并突出引用查询\n为每个引用时刻标注帧索引\n覆盖单个或多个时刻",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "a4",
      "label": "B8 · 三角色质量控制\n主标注者命题并剔除视频\n检查者核对题型 / 规则\n修订者修复被标记条目\n20% 被判有问题并修订",
      "type": "user",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "r1",
      "label": "R1 · 论文拆分合同\n无训练集 · 验证 20% / 测试 80%\n验证 · 1,337 题 / 752 视频\n测试 · 5,341 题 / 3,011 视频\n测试标签隐藏",
      "type": "database",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r2",
      "label": "R2 · 固定 Meta · cdf34446\n6,678 行 · 验证 1,337 / 测试 5,341\n唯一视频 ID · 验证 753 / 测试 3,008\n论文视频数 · 752 / 3,011\n明确标示数据发布漂移",
      "type": "database",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r3",
      "label": "R3 · 主数据集 · 60d1c89c\n需同意访问 · CC BY-NC-SA 4.0\n视频 / 字幕归档 + JSON\n验证标签公开 · 测试标签 = −1\n仅限非商业使用",
      "type": "database",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "r4",
      "label": "发布 / 评测边界\nGitHub 加载器 · fc3c5532\n固定仓库没有原生评分器\nREADME 指向可变的 LMMs-Eval main\n测试经邮件提交 · 隐藏评分",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "e1",
      "label": "E1 · 载入一个拆分\n原始 MP4 + 字幕 JSON + 元数据\n问题 + 4–5 个选项\n验证 correct_choice 为 0–4 · 测试为 −1",
      "type": "database",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e2",
      "label": "E2 · 均匀采样视频帧\nnum_frames = min(预算, int(时长))\n每秒最多 1 帧\n论文在验证集比较 1–256 帧",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e3",
      "label": "E3 · 交错视频帧与文本\n按字幕中点时间戳排序\n固定加载器仅在采样帧覆盖\n字幕时段时保留该字幕",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e4",
      "label": "E4 · 追加多选提示\n问题 + 带字母选项\n要求直接返回选项字母\n不要求思维链",
      "type": "document",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "d2",
      "label": "评测拆分？",
      "type": "decision",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e5",
      "label": "验证集 · 选择设置\n零样本 · 比较不同帧预算\n为每个模型选择最优设置\n标签公开",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "e6",
      "label": "测试集 · 固定已选设置\n对 5,341 题做零样本评测\n返回 A / B / C / D / E\n提交 JSON · 测试标签隐藏",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "m1",
      "label": "M1 · 多项选择准确率\n正确预测数 / 总题数\n不使用辅助裁判模型\n提交可接受字母开头字符串\n精确测试评分器未公开",
      "type": "formula",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "m2",
      "label": "M2 · 报告与排行榜\n验证总分 + 测试总分\n4 个时长区间准确率\n17 个题型准确率\n引用查询深度分析",
      "type": "terminal",
      "module": "evaluate",
      "size": "xl"
    }
  ],
