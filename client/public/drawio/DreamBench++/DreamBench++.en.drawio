    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4384" pageHeight="784" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Evidence boundary&#xa;arXiv 2406.16855v2&#xa;repo 66ca27e5&#xa;HF revision 459b0649&#xa;data.zip commit d5b0c8a2" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Candidate subject keywords&#xa;200 from GPT-4o + top 200 Unsplash&#xa;deduplicate, then 7 annotators extend&#xa;about 300 keywords after expansion" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Acquire candidate references&#xa;Unsplash · Rawpixel · Google Search&#xa;authorized individual contributions&#xa;verify academic-use copyright status" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="SAM automatic filter&#xa;remove images with a too-small&#xa;main subject area" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;font