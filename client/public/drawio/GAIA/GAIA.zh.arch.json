  "nodes": [
    {
      "id": "seeds",
      "label": "任务编写规范与种子设计\n定义人类概念简单但极耗工具调用的真实场景\n强制要求单一、无歧义的简明事实答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "truth_sources",
      "label": "真实多模态源素材注入\n收集真实文档：PDF、XLSX、CSV、MP3、PNG、JSON\n覆盖动态网页、公开 API 与权威在线统计表",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "craft",
      "label": "人工高阶任务构筑\n确保对人类极度直观 (人类 Baseline 达成率 92%)\n对 AI 则需跨模态感知、网页检索与代码求解",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "元数据与黄金答案标注\n标注唯一简明文本、数值或列表格式标准答案\n记录完整的专家逐步推导执行轨迹 (Step-by-Step Traces)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidates",
      "label": "候选任务池构筑 (623 题)\n汇聚 623 道未经验证的多模态复合助理任务\n覆盖跨应用办公、多媒体分析与复杂事实查询",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "solvers",
      "label": "双盲独立交叉求解\n两名独立求解员在完全未知原作者答案下解题\n全流程不接触标注证据与任何解题提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "compare",
      "label": "双盲一致性裁决闸门\n对比两名求解员独立产出与原作者答案\n依据完全一致、表述瑕疵或实质缺陷分流",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "accept",
      "label": "全票通过 / 确认有效\n两求解员答案一致，或原作者推导无误(求解员失误)\n免修直接晋级已验证任务集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "repair",
      "label": "题目表述瑕疵重修\n修正存在歧义的指代说明或失效网络链接\n作者微调问题描述以消除多解可能",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "revalidate",
      "label": "新求解员二次盲审闸门\n指派第三位独立求解员对重修题目二次盲测\n判定重修后题目是否彻底具备唯一确定解",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard",
      "label": "瑕疵候选题目淘汰池\n剔除存在严重歧义、依赖不稳定网页或多解的题目\n累计淘汰 157 道存疑任务以确保高质严谨",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "validated",
      "label": "双盲质检通过题库\n经双盲独立复测与严格仲裁确认的健壮题库\n具备 100% 可复现与确定性评测标准",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "levels",
      "label": "三阶难度层级划分\nLevel 1 (54题): <=5步操作，单工具轻量交互\nLevel 2 (86题): 5-10步，多模态/Python/网页混合\nLevel 3 (26题): 长流程任意多工具自主规划",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final",
      "label": "GAIA 完整基准冻结\n收录 466 道高区分度通用 AI 助理真实任务\n确立 92% 人类基准对比基线",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dev",
      "label": "公开开发验证集 (166 题)\n完整公开题干、多模态附件与参考黄金答案\n用于 Agent 策略微调、提示词调优与错误归因",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "test",
      "label": "盲测测试集 (300 题)\n完全封存真实参考答案，仅支持官方排行榜评测\n防范测试集污染，以准精确匹配 (Quasi-Exact Match) 记分",
      "type": "terminal",
      "size": "xl"
    }
  ],
