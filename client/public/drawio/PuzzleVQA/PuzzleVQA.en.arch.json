    },
    {
      "id": "task_scope",
      "label": "Define Abstract-pattern VQA\nDiagnose Visual Perception\nInduction and Deduction\nwithout Extensive World Knowledge",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "concepts",
      "label": "Four Fundamental Concepts\nNumbers · Colors\nSizes · Shapes",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "mode_taxonomy",
      "label": "Compose Puzzle Modes\nFour Single-concept Categories\nSix Dual-concept Categories",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "categories",
      "label": "Ten Puzzle Categories\n200 Test Items per Category\nSingle and Dual Concepts",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "templates",
      "label": "Design 20 Multimodal Templates\nTwo Templates per Category\nDefine Objects · Layout\nPattern · Demonstrations · Query",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "define_layout",
      "label": "Fix Layout + Abstract Pattern\nStraightforward Rules\nAvoid Unnecessary Complexity\nEnsure Programmatic Correctness",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "populate_objects",
      "label": "Randomly Populate Objects\nSatisfy the Template Pattern\nForm Multiple Demonstrations\nof the Underlying Rule",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "construct_query",
      "label": "Construct Missing-object Query\nSelect One Target Answer\nHide It with a Question Mark",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "make_choices",
      "label": "Build Multiple-choice Options\nFour Choices Normally\nThree for Size Questions\nHeuristic Distractor Sampling",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "render_image",
      "label": "Render Puzzle with Python\nPillow Draws Image Objects\nAugment Template and Objects",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reasoning_text",
      "label": "Generate Ground-truth Explanations\nCaption for Visual Perception\nPattern Explanation for Induction\nDeduction toward Final Answer",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "record_schema",
      "label": "Store Seven Record Fields\nimage · question · options · answer\ncaption · explanation · deduction",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "paper_dataset",
      "label": "PuzzleVQA Paper Dataset\n20 Templates × 100 Unique Items\n20 JSONL Files · 2,000 Rows\nTest-only Benchmark",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_input",
      "label": "Evaluate Same 2,000 Puzzles\nImage + Question + Options\nZero-shot Setting",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt_gate",
      "label": "Select Diagnostic Prompt\nBaseline or Progressive\nGround-truth Guidance",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "zero_shot",
      "label": "Zero-shot CoT Baseline\nDescribe Image First\nThen Think Step by Step",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "guided_caption",
      "label": "Guided Perception\nPrepend Ground-truth Caption\nbefore the Question",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "guided_induction",
      "label": "Guided Perception + Induction\nPrepend Caption\n+ Pattern Explanation",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "guided_deduction",
      "label": "Guided Through Deduction\nCaption + Pattern + Deduction\nStop before Revealing Answer",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_output",
      "label": "Multimodal Model Output\nGreedy Decoding\nReasoning + Candidate Choice",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "direct_regex",
      "label": "Parse the Raw Response\nPrefer Last Parenthesized A–D\nFallback to Last Bare A–D",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extraction_prompt",
      "label": "If Direct Extraction Fails\nPrompt Model with Output\nand Explicit Choice Trigger",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fallback_regex",
      "label": "Re-run the Same Parser\nPrefer Last Parenthesized A–D\nFallback to Last Bare A–D",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parsed_answer",
      "label": "Map Letter to Option\nProduce One Predicted Answer",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "Report Accuracy\nCorrect Predictions\ndivided by 2,000 Items",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "paper_release",
