  "nodes": [
    {
      "id": "step_1",
      "label": "获取多样网页图像\n从网页托管图像开始\n保留图像 URL\n覆盖不同场景与对象类别",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "运行 Detic 检测器\n使用标准非 VLM 模型\n检测候选对象实例\n不使用 VLM 生成标注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "应用严格置信度过滤\n移除低置信度检测\n提高自动标签精度\n保留合格实例框",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "为每张图选择一个类别\n取检测实例最多的类别\n使用一个明确计数目标\n记录其对象标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "将检测框转为对象中心\n存储 x 与 y 点坐标\n统计所选对象实例数\n保留 0 至 10 的候选计数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "形成计数问答对\n图像与目标对象类别配对\n以总数作为答案\n保留中心点供训练监督",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "过滤准确性与多样性\n移除不可靠候选项\n减少重复视觉样例\n准备训练池与核验池",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "抽取评测候选项\n覆盖 2 至 10 个对象\n每个计数抽取 120 例\n沿用 CountBenchQA 式验证",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "人工核验评测样例\n检查真实对象数量\n剔除错误检测器标签\n形成可信计数参考答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "划分验证集与测试集\n各 540 条人工核验记录\n计数范围保持 2 至 10\n评测记录不含点坐标字段",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "定稿训练集\n发布剩余 36,916 条记录\n计数范围为 0 至 10\n包含对象中心点与类别标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "发布开放数据集\nODC-BY-1.0 研究许可\nURL · SHA-256 · 计数 · 标签 · 点\n按哈希核验下载图像",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "生成计数预测\n提供图像与计数问题\n比较仅输出计数策略\n评估先指点后计数推理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告计数准确率\n比较预测计数与参考计数\n使用验证集或保留测试集\n分析点顺序策略影响",
      "type": "terminal",
      "size": "xl"
    }
  ],
