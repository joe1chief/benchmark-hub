  "nodes": [
    {
      "id": "source_evidence",
      "label": "固定官方证据\narXiv 2409.17146v2 · PDF 54c5e78b4066\nGit 793fa387edfd · HF ebf51cf70e45\n论文定义构建，快照核验发布",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "web_images",
      "label": "从网页图像开始\n论文仅说明使用网页图像\n未公开确切来源语料库\n不借用PixMo-Cap主题描述",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "detic",
      "label": "运行非VLM检测器\n论文引用Detic工作\n数据卡明确将检测器命名为Detic\n生成候选对象检测结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "confidence",
      "label": "执行严格置信度阈值过滤\n仅保留高置信度检测\n论文未公开阈值数值\n将其保留为明确过滤门",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dominant_class",
      "label": "每图选择一个类别\n按对象类别统计检测框\n选择检测数量最多的类别\n定义单一计数目标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "centers_qa",
      "label": "派生中心点与计数问答\n将检测框转换为对象中心\n统计所选类别实例数\n配对图像、标签、计数与点",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "diversity_filter",
      "label": "过滤准确性与多样性\n官方数据卡披露此处理\n去除不准确或冗余的数据\n具体规则仍未公开",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidate_pool",
      "label": "形成候选池\n保留0至10的合格计数\n预留2至10供人工核验\n其余记录可用于计数训练",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_sample",
      "label": "抽取评测候选\n沿用CountBenchQA方法\n每个计数抽取120个样例\n覆盖2至10个对象",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_verify",
      "label": "人工核验计数\n检查每个抽取候选\n确认对象身份与总数\n九个计数共1,080个核验项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_release",
      "label": "创建验证集与测试集\n验证540条 · 测试540条\n均覆盖2至10个对象\n发布的评测记录不含点坐标",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "train_release",
      "label": "定稿训练划分\n使用剩余0至10计数记录\n论文报告约36k张图像\n固定发布包含36,916条",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "fixed_release",
      "label": "封装固定官方数据集\n训练36,916 · 验证540 · 测试540\nURL · SHA-256 · 计数 · 标签 · 点\nODC-BY-1.0；图像URL可重复",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_setup",
      "label": "执行论文计数评测\n表1使用保留测试集\n表4的PCQA使用验证集\n计数任务保持12个裁剪",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "strategy_gate",
      "label": "选择计数策略\n比较论文中的四个消融分支\n使用同一个PCQA验证集\n按论文规则分别评分",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "count_only",
      "label": "仅生成计数\n不输出对象中心解释\nPCQA验证准确率80.2\n论文对比支路",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "point_then_count",
      "label": "先指点再生成计数\n先输出有序对象中心点\nPCQA验证准确率86.3\n论文默认且最佳支路",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "count_then_point",
      "label": "先计数再生成点\n反转解释输出顺序\nPCQA验证准确率77.6\n论文对比支路",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pointing_regex",
      "label": "为正则计数生成点\n仅输出点坐标而不输出计数\n保留该论文对比分支\n与文本计数解析器分离",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_points",
      "label": "用正则统计输出点\n将论文正则直接用于点坐标\n不调用PointCountEval文本解析\nPCQA验证准确率85.4",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_count",
      "label": "解析显式输出计数的分支\n固定代码读取末尾整数或数词\n也接受“a total of N”形式\n报告正确、接近、有效及分计数结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "报告计数准确率\n预测计数须与参考值精确相等\n表1报告保留测试集结果\n表4报告策略消融结果",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "construction_boundary",
      "label": "构建披露边界\n未公开检测器检查点与配置\n未公开阈值与多样性规则\n未公开来源采样与划分种子",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "论文至发布边界\n论文约36k，固定数据为36,916\n评测点坐标按设计缺失\n数据卡arXiv标签指向Detic而非Molmo",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "evaluator_boundary",
      "label": "评测器复现边界\nGit公开加载器、模板与解析器\n但未公开数据构建流程\nVLMEvalKit不支持PixMo-Count",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "license_boundary",
      "label": "发布与许可边界\nODC-BY-1.0研究发布\n图像仍由外部URL托管\n使用已发布SHA-256核验下载",
      "type": "document",
      "size": "xl"
    }
  ],
