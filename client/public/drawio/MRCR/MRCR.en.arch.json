      "id": "responses",
      "label": "Generate Assistant Responses\nUse GPT-4o for All Responses\nCover Target and Distractors\nKeep One Shared Distribution",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "conversation",
      "label": "Build Multi-turn Conversation\nAlternate User and Assistant\nMix Many Writing Requests\nForm the Long Haystack",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "needles",
      "label": "Insert Repeated Needles\nChoose 2 · 4 · or 8 Needles\nRepeat an Identical User Ask\nInterleave Same-source Distractors",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "target",
      "label": "Select Ordered Target\nChoose the i-th Occurrence\nUse One-indexed Position\nRetain Its Assistant Response",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "query",
      "label": "Append Retrieval Instruction\nRequest the i-th Response\nRequire Random 10-char Prefix\nForbid Any Other Text",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "bins",
      "label": "Measure Prompt plus Answer\nTokenize Total Context\nAssign Eight Length Bins\nSpan 4,096 through 1,048,576",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sample",
      "label": "Balance the Dataset\n100 Samples per Length Bin\nRepeat for 2 · 4 · 8 Needles\nTotal 3 × 8 × 100",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Publish OpenAI MRCR\n2,400 Samples\nKeep Prompt · Answer · Prefix\nStore Needle and Length Metadata",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "correction",
      "label": "Maintain Corrected Release\nReplace Too-many-needle Rows\nRepair Incorrect Ground Truth\nMark Changes with date_added",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prefix_gate",
      "label": "Required Prefix Present?\nMissing Prefix = 0\nPresent: Strip Both Prefixes",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "Compute Similarity Score\nPython difflib SequenceMatcher\nCompare Response with Gold Text\nReport Ratio by Bin and Needles",
