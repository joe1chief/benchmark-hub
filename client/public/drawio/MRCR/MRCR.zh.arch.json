  "nodes": [
    {
      "id": "schema",
      "label": "定义写作任务空间\n438 个不同实体\n10 种写作格式\n组合主题与写作形式",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "responses",
      "label": "生成助手回答\n全部回答由 GPT-4o 生成\n同时覆盖目标与干扰项\n保持相同生成分布",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "conversation",
      "label": "构建多轮对话\n交替排列用户与助手消息\n混合大量写作请求\n形成长上下文干草堆",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "needles",
      "label": "插入重复目标针\n选择 2 · 4 · 8 个针\n重复完全相同的用户请求\n穿插同源干扰请求",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "target",
      "label": "选择顺序目标\n指定第 i 次出现\n使用从一开始的序号\n保存对应助手回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "query",
      "label": "追加检索指令\n要求返回第 i 个回答\n要求随机 10 字符前缀\n禁止输出任何其他文本",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "bins",
      "label": "计算提示加答案长度\n对总上下文执行分词\n划分八个长度桶\n覆盖 4,096 至 1,048,576",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sample",
      "label": "平衡数据集规模\n每个长度桶抽取 100 条\n分别覆盖 2 · 4 · 8 个针\n总数为 3 × 8 × 100",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 OpenAI MRCR\n共 2,400 个样本\n保留提示 · 答案 · 前缀\n存储针数量与长度元数据",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "correction",
      "label": "维护已修正版本\n替换目标针过多的样本\n修复错误标准答案\n以 date_added 标记变更",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prefix_gate",
      "label": "应用前缀门控\n回答必须以前缀开头\n缺少前缀时直接记零分\n否则从回答与真值移除前缀",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "计算文本相似度\nPython difflib SequenceMatcher\n比较模型回答与标准文本\n按长度桶与针数量报告比率",
      "type": "terminal",
      "size": "xl"
    }
  ],
