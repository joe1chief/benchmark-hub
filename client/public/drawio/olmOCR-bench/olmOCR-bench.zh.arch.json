    {
      "id": "source_evidence",
      "label": "固定官方证据\narXiv 2502.18443v3 · PDF d006f3f9100a\nGit f7cfe4c22098 · HF 54a96a6fb6a2\n论文定协议，快照审计代码与数据",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "benchmark_goal",
      "label": "定义确定性OCR事实\n测试忠实页面线性化\n保留文本、结构与顺序\n避免完整参考或大模型裁判",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "eligibility",
      "label": "执行论文资格过滤\n仅移除同时满足两个条件的文档\n含个人信息且并非为公开传播而准备\n附录复用训练混合数据PII提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "decontaminate",
      "label": "与训练数据去污染\n对照olmOCR-mix-0225\n在PDF URL层面去重\n保持基准文档隔离",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "source_gate",
      "label": "选择七类PDF来源之一\n使用来源专用采集路径\n创建简单可机器核验事实\n所有结果均进入人工复核",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "arxiv_math",
      "label": "构建arXiv数学测试\n522份PDF · 2,927项公式测试\n单一TeX源文件及渲染PDF\nolmOCR · 动态对齐 · KaTeX · 复核",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "old_scans_math",
      "label": "构建老扫描数学测试\n36份PDF · 458项公式测试\nInternet Archive公版教材\n随机页面 · olmOCR · 人工公式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "tables",
      "label": "构建表格测试\n188份PDF · 1,020项关系测试\n内部爬取库 · Gemini Flash 2.0\n随机单元格并人工复核",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "old_scans",
      "label": "构建老扫描文本测试\n98份PDF · 526项LoC测试\n人工转录驱动顺序脚本\n人工缺失测试并二次复核",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "headers_footers",
      "label": "构建页眉页脚测试\n266份PDF · 753项缺失测试\nDocLayout-YOLO的abandon区域\n遮罩 · Gemini Flash 2.0 · 人工边界",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "multi_column",
      "label": "构建多栏测试\n231份PDF · 884项顺序测试\n从内部爬取库目视抽样\nClaude Sonnet 3.7 HTML · 人工复核",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "long_tiny_text",
      "label": "构建长篇微小文字测试\n62份PDF · 442项存在测试\nInternet Archive高密度页面\nGemini Flash 2.0 · 人工核验",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_review",
      "label": "生成并复核各来源测试\n人工设计与复核\nGPT-4o提示生成 · 通常T=0.1\n人工修正事实与关系\n排除歧义或无效案例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_scope",
      "label": "冻结论文v3表格口径\n表10：1,403份PDF · 7,010项核心测试\n存在721 · 缺失823 · 顺序1,061\n表格1,020 · 公式3,385",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "fixed_release",
      "label": "封装固定HF发布\n1,403份PDF · 七个来源JSONL\n7,010项核心加9项显式基线\n修订54a96a6fb6a2采用ODC-BY-1.0",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "run_ocr",
      "label": "逐PDF页面运行OCR系统\n保留已发布的单页PDF\n输出Markdown或Unicode纯文本\n保持自然阅读顺序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "规范化可比较文本\n合并空白并移除强调标记\n将引号与连字符映射为ASCII\n将Unicode规范化为NFC",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "test_gate",
      "label": "路由至论文测试族\n五类核心测试加基线\n评估简单页面级属性\n每项结果均为二元值",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "baseline",
      "label": "每份PDF执行一项基线\n要求输出含字母数字\n拒绝末尾重复超过30次的n元组\n拒绝意外中文、日文或表情符号\n除非该PDF已有例外配置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "presence_absence",
      "label": "测试文本存在与缺失\n必须存在721 · 必须缺失823\n模糊匹配并可限制首尾N字符\n存在测试默认区分大小写",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reading_order",
      "label": "测试自然阅读顺序\n1,061项先后关系\n模糊搜索两个文本片段\n要求有效的先后位置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "table_accuracy",
      "label": "测试表格单元格关系\n1,020项单元格与邻接事实\n解析Markdown或HTML表格\n复杂跨行列结构需要HTML",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "math_formula",
      "label": "测试数学公式版式\n3,385个参考方程\n使用KaTeX渲染LaTeX\n匹配符号及相对边界框",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "source_rates",
      "label": "按来源记录二元结果\n每项事实确定性通过或失败\n七个文档来源JSONL分组\n基线为第八组并计算各组通过率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "macro_score",
      "label": "宏平均来源分数\n每个来源组权重相同\n总分等于各组通过率均值\n不对7,010项事实做微平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "confidence",
      "label": "报告总分与95%置信区间\n论文表4使用10,000次Bootstrap\n论文未说明重采样单位\n一致比较各OCR系统",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "source_boundary",
      "label": "构建披露边界\n未标识内部来源语料库\n未公开确切选择种子\n已命名大模型无不可变检查点",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "论文至发布计数边界\n正文写1,402，表10写1,403\n固定JSONL有7,019条物理记录\n即7,010项核心加9项基线",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "evaluator_drift",
      "label": "后续评测器漂移边界\n九项基线仍归入其来源组\nGit新增格式与脚注测试类型\n多数重复通过 · 1,000而非论文10,000",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "license_boundary",
      "label": "发布与许可边界\n固定数据集采用ODC-BY-1.0\nPDF保留各自来源信息\n原始上游权利仍然适用",
      "type": "document",
      "size": "xl"
    }
