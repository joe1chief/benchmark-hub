    {
      "id": "scenarios",
      "label": "调研游戏化现实场景\n结合广泛调研与众包\n聚焦明确规则与决策过程\n原创设计网上不可检索的问题",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "定义两域任务分类\n执行域按规则变换当前状态\n规划域搜索未来动作序列\n覆盖字符串、矩阵、路径与逻辑游戏",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execution",
      "label": "编写执行域问题\n使用确定性的单步推断\n按固定规则操作字符串或状态\n每个中间步骤均可验证",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "planning",
      "label": "编写规划域问题\n要求多步策略决策\n搜索潜在未来状态\n必要时加入检查点或状态变量",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "references",
      "label": "构建可验证参考答案\n记录正确的最终答案\n记录逐步求解过程\n保留确定性中间状态",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "format",
      "label": "统一结构化输出格式\n强制返回 JSON 对象\nanswer 为字符串列表\n需要时 process 为字符串列表",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "构建 0–3 四级难度\n逐级增加规则复杂度与推理步数\n单步 0 级题可只输出答案\n复杂 0 级与 1–3 级需输出过程",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "exemplars",
      "label": "每道题加入两个示例\n包含题目与正确答案\n包含逐步求解过程\n解释规则如何应用",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "bilingual",
      "label": "制作中英文双语版本\n仔细翻译问题文本\n翻译指令与输出约束\n保持规则和参考答案语义一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 304 道 LogicGame 问题\n保留执行域与规划域标签\n附带难度、示例与参考过程\n对齐两种语言版本",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "infer",
      "label": "运行确定性模型评测\n温度 0 · 最大 2,048 token\n使用零样例或两个示例提示\n解析规定的 JSON 响应",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "分别评分答案与推理过程\nA-Acc 二值判断答案正确性\nP-Acc 按字符级匹配过程\nAP-Acc 对两者执行逻辑与",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告准确率与格式失败\nA-Acc · P-Acc · AP-Acc\nJSError · IFError\nNIJ-Acc 排除两类格式错误",
      "type": "terminal",
      "size": "xl"
    }
