  "nodes": [
    {
      "id": "evidence",
      "label": "证据与版本固定点\n论文 2402.14762v3\n数据仓库 bc18b3e2\nOpenCompass 分支 da7b1c3a\nJSONL SHA-256 1a1e433a…d80",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "dialogue_sources",
      "label": "归纳细粒度能力\n检查 ShareGPT 与 RealChat\n分析人类与 LLM 对话\n融入教育心理学",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "三层能力分类法\n感知性 · 适应性 · 交互性\n记忆 · 理解 · 抗干扰\n改述 · 反思 · 推理 · 提问",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_catalog",
      "label": "定义 13 项第三层任务\nCM · AR · SI · TS · CC · CR · FR\nSC · SA · MR · GR · IC · PI\n30 个主题 · 每任务至少 10 个",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "generation_prompts",
      "label": "构建任务专属 GPT-4 提示\n统一的初始指令\n各任务独有规则\n人工编写示例",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "生成候选对话\nGPT-4 每任务生成超过 1,000 条\n遵循指定能力约束\n覆盖主题清单",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "screen",
      "label": "应用五类筛选准则\n任务规则与主题多样性\n删除近似重复\n排除实时或 2022 年后知识\n拒绝常识错误、冒犯与隐私信息",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "curation_gate",
      "label": "五名标注员是否\n全部通过该候选？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MT-Bench-101\n1,388 个英文对话\n4,208 个历史轮次 · 13 项任务\n公开 · Apache-2.0",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "discard",
      "label": "拒绝该候选\n任一标注员均可阻止保留\n不采用多数票通过\n各类拒绝数量未公开",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_audit",
      "label": "固定发布物审计\n结构为 task、id、history\nID 1–1388 · 每对话 2–7 轮\n重复历史：SI 1138 与 1142",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "turn_gate",
      "label": "该任务是否从第二轮\n开始直接评测？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "skip_first",
      "label": "跳过首轮评测\nFR · CR · AR · SA · SC · CM\n593 个对话各减少一个评测项\n从第二轮开始",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "all_turns",
      "label": "从第一轮开始评测\nCC · GR · IC · MR · PI · SI · TS\n保留全部已发布轮次\n不排除首轮",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "evaluation_items",
      "label": "构造 3,615 个评测项\n4,208 轮 − 593 个首轮\n黄金历史 + 当前用户输入\n仅评分最新回答",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "candidate_response",
      "label": "生成候选回答\n使用人工筛选的黄金上下文\n避免自生成历史误差累积\n仅推理最后一个回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "任务专属 GPT-4 评审\n给出 1–10 分及理由\n输出 Rating: [[score]]\n论文温度为 0.6",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_drift",
      "label": "固定 OpenCompass 实现边界\ngpt-4-1106-preview · 温度 0.8\n与论文温度 0.6 不同\nMR/GR 提示加入参考对话",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "parse_gate",
      "label": "正则能否找到\n方括号整数？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "dialogue_minimum",
      "label": "汇总成功解析的轮次分数\n对话分数取轮次最低值\n一轮失败即可拉低整段对话\n仅成功解析的轮次参与",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "invalid_policy",
      "label": "跳过无效评审输出\n当前版本不检查 1–10 范围\n无有效轮次的对话会消失\n全部无效则触发断言",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "task_mean",
      "label": "计算各任务分数\n对话最低分的无权平均\n13 项任务各得到一个值\n对话缺失会缩小分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_average",
      "label": "计算论文 Avg.\n13 项任务分数的宏平均\n每项任务权重相同\n公开汇总器不输出该值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_validation",
      "label": "验证自动评分\n随机 100 个对话 · 五名专家\n人工分数采用多数意见\n自动-人工 87% · 人工内部 80%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "implementation_boundary",
      "label": "解析与报告边界\n正则读取第一个 [整数]\n无效输出降低实际覆盖率\n代码仅输出任务分，不输出 Avg.",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告能力画像\n论文比较 21 个 LLM\n分析任务与对话轮次\n结果来自论文表格而非实时榜单",
      "type": "terminal",
      "size": "xl"
    }
  ],
