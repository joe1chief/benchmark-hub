<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1520" pageHeight="528" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据边界：arXiv:2402.18667v1&#xa;FoFo @ 140b1661&#xa;测试集 SHA 8f4cddcb&#xa;论文方法 + 固定公开发布物审计" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="专家给出适合智能体的子领域种子&#xa;GPT-4 扩展，人工迭代并重新归组&#xa;10 个领域 × 5 个子领域 = 50" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="GPT-4 为每个子领域提出 5 种专用格式&#xa;500 个候选三元组 · 254 个唯一字符串&#xa;要求人类可读，初始排除通用格式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="专家评估、重生成或移除候选格式&#xa;加回 JSON / XML / CSV&#xa;以及 Markdown / YAML&#xa;再确定领域-格式清单" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="GPT-4 为每个三元组写 FORMAT-INSTRU&#xa;明确格式配置与真实任务&#xa;提供虚拟上下文或允许模型自行补全" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="人工逐条核验、编辑、移除或重生成&#xa;发布：494 条指令 · 248 种格式&#xa;指令平均长度 2,908 字符" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="按模型家族封装每条指令&#xa;Alpaca · Vicuna · Mistral&#xa;Zephyr · OpenChat&#xa;其他模型直接使用原始指令" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="每条指令生成一个回答&#xa;temperature 0.7 · top-p 1&#xa;最多 5,120 token&#xa;解码并剥离提示，Zephyr 单独切分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="GPT-4 评审 · 最多 1,024&#xa;temperature 0&#xa;为每个回答输出二元判定与理由&#xa;缺少任一格式要求即失败" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="json_parser 提取&#xa;format_correctness&#xa;仅保留二元 0/1 标签&#xa;准确率 = 100 × n_correct / n_total" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="人工复核 100 个模型回答&#xa;84/100 与 GPT-4 一致&#xa;16 个分歧均为评审假阳性" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;e