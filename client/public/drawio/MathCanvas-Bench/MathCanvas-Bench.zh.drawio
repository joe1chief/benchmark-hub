  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2720" pageHeight="1168" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="收集多模态数学题&#xa;来源为教材、考试与网站&#xa;覆盖初中与高中&#xa;初始约 63.2 万组题目与解答" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="第一轮 GPT-5 审查&#xa;判断图像是否参与推理&#xa;将数学公式统一规范为&#xa;LaTeX 格式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="280" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="图像是否对推理过程&#xa;确有作用？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="第二轮 GPT-5 审查&#xa;检查正确性与明确答案&#xa;检查图像清晰度&#xa;排除纯绘图任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1000" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="正确、有答案、图像清晰&#xa;且并非纯绘图任务？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="对文本和图像去重&#xa;保留唯一题目—解答对&#xa;约 30.3 万 → 约 22.2 万&#xa;论文未公开去重阈值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1720" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="标准化全部图像&#xa;使用 SwinIR 超分辨率&#xa;统一缩放至 512 × 512&#xa;保持题目与解答对应关系" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="使用 GPT-4.1 分类&#xa;划分八个主要知识类别&#xa;添加细粒度子类别&#xa;为按类别抽样做准备" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="从整理语料中剔除&#xa;图像无关或质量检查失败" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1000" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="是否为多项选择题？&#xa;基准候选资格门" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行基准加权抽样&#xa;类别原占比取 0.7 次方&#xa;提升稀有类别的代表性&#xa;目标规模约三千题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="是否被加权抽入&#xa;基准样本？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1720" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="发布 MathCanvas-Bench&#xa;论文概称 3K 题&#xa;公开固定版本为 3,079 条&#xa;按八个测试类别发布" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="形成训练候选集&#xa;不具基准资格的选择题&#xa;加未抽中的开放式题&#xa;仅对本分支执行泄漏检查" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="与任一基准题的五元词组&#xa;Jaccard 相似度是否大于 0.4？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1720" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="发布 MathCanvas-Instruct&#xa;训练集实际 218,604 题&#xa;论文概称约 21.9 万题&#xa;未检出与测试题近似项" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="从训练集中移除&#xa;相似度超过 0.4&#xa;基准题本身保持不变" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1720" y="984" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="运行待评多模态模型&#xa;输入题目与初始图像&#xa;生成图文交错推理过程&#xa;并给出最终答案" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1000" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="准备官方裁判输入&#xa;仅拼接文本推理步骤&#xa;加入题目与标准答案&#xa;不向裁判发送生成图像" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="使用 GPT-4.1-2025-04-14 裁判&#xa;解析带编号标签的标准答案&#xa;从全文匹配提取预测答案&#xa;缺失答案记为空值且判错" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="280" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="API 与结构化解析成功&#xa;且答案部分数为一至四？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="标准答案包含&#xa;几个答案部分？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="不计入指标分母&#xa;API、结构化解析失败或部分数不支持&#xa;分别记录错误数或跳过数" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="评分单个答案部分&#xa;正确记 1，错误记 0&#xa;加权分等于二元得分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="880" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="评分二至四个答案部分&#xa;后一项权重为前一项的 1.3 倍&#xa;归一化使权重和为 1&#xa;累加所有正确项权重" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFami