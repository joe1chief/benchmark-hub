    {
      "id": "collect",
      "label": "收集多模态数学题\n来源含教材考试与网站\n覆盖初中和高中内容\n初始 632K 题及解答",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "relevance_filter",
      "label": "第一轮 GPT-5 清洗\n移除图像与问题无关项\n统一数学表达为 LaTeX\n保留约 367K 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality_filter",
      "label": "第二轮 GPT-5 清洗\n移除错误与无明确答案\n移除低质图及纯绘图题\n保留约 303K 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "deduplicate",
      "label": "执行文本和图像去重\n比较问题与视觉内容\n合并或移除近重复项\n得到约 222K 题池",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "image_enhance",
      "label": "标准化视觉输入\n使用 SwinIR 超分辨率\n统一缩放至 512 × 512\n改善低清数学图像",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "标注数学类别\n使用 GPT-4.1 分类\n划分八个主要类别\n继续标注细粒度子类",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "benchmark_sample",
      "label": "建立 benchmark 候选池\n从 222K 题池划出候选\n排除全部多项选择题\n保留开放式视觉推理题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "weighted_sample",
      "label": "加权抽取 3K 道题\n类别原占比取 0.7 次方\n提升稀有数学类型占比\n同时保留自然分布特征",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "leakage",
      "label": "控制训练测试泄漏\n计算五元词组 Jaccard\n相似度超过 0.4 时\n从训练集移除对应题目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MathCanvas-Bench\n共 3,000 道开放式题\n要求图文交错解决方案\n训练余集约 219K 题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "infer",
      "label": "运行多模态模型\n输入题目与原始图像\n模型可生成视觉中间结果\n输出图文交错推理过程",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "extract",
      "label": "提取并核对所有子问\nGPT-4.1 提取最终答案\n逐项对照标准答案\n记录每个子问是否正确",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "汇总双指标结果\n全部子问正确才得完整分\n加权评分采用递增子问权重\n报告总体与类别表现",
      "type": "terminal",
      "size": "xl"
    }
