      "size": "xl"
    },
    {
      "id": "training_candidates",
      "label": "Form Training Candidates\nBenchmark-ineligible MCQs\n+ Non-selected Open Problems\nApply Leakage Check Only Here",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "leakage_gate",
      "label": "5-gram Jaccard Similarity > 0.4\nto Any Benchmark Question?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "training_release",
      "label": "Release MathCanvas-Instruct\n218,604 Training Problems\nPaper Reports About 219K\nNo Detected Near-test Question",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "leakage_remove",
      "label": "Remove from Training Set\nSimilarity Exceeds 0.4\nBenchmark Item Remains Unchanged",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "model_output",
