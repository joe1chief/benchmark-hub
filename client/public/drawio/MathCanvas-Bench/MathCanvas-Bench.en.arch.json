      "label": "Multiple-choice Problem?\nBenchmark Eligibility Gate",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "weighted_sample",
      "label": "Weighted Benchmark Sampling\nRaise Each Category Share to Power 0.7\nIncrease Rare-type Representation\nTarget about 3K Problems",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sample_gate",
      "label": "Selected for the Weighted\nBenchmark Sample?",
