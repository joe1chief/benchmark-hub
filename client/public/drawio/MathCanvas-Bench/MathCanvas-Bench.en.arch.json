      "label": "Second GPT-5 Review\nCheck Correctness + Explicit Answer\nCheck Image Clarity\nExclude Drawing-only Tasks",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality_gate",
      "label": "Correct, Answered, Clear,\nand Not Drawing-only?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "deduplicate",
      "label": "Deduplicate Text and Images\nRetain Unique Problem–Solution Pairs\nAbout 303K → About 222K\nThreshold Not Reported",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "image_enhance",
      "label": "Standardize All Images\nApply SwinIR Super-resolution\nResize to 512 × 512\nPreserve Problem–Solution Pairing",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
