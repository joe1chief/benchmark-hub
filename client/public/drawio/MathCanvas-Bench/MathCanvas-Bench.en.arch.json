      "type": "process",
      "size": "xl"
    },
    {
      "id": "gpt_judge",
      "label": "Judge with GPT-4.1-2025-04-14\nParse Tagged Ground-truth Parts\nExtract Matching Predicted Answers\nMissing Answer → null + Incorrect",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "valid_evaluation_gate",
      "label": "API + Schema Successful\nand One to Four Parts?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "parts_gate",
      "label": "How Many Ground-truth\nAnswer Parts?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "invalid_evaluation",
      "label": "Exclude from Metric Denominator\nAPI/Schema Failure or Unsupported Count\nRecord Error or Skipped-item Count",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "single_score",
      "label": "Score One Answer Part\nCorrect → 1 · Incorrect → 0\nWeighted Score Equals Binary Score",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "multi_score",
      "label": "Score Two to Four Parts\nEach Later Part Gets 1.3× Weight\nNormalize Weights to Sum to 1\nSum Weights of Correct Parts",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "Aggregate Official Metrics\nDenominator: valid_evaluations\nComplete: Mean All-parts-correct\nWeighted: Mean Per-problem Score",
      "type": "terminal",
      "size": "xl"
    }
