  "nodes": [
    {
      "id": "repo_config",
      "label": "官方 ZeroEval 统一配置仓\n标准化任务配置与评测环境参数\n控制随机种子、任务分片与采样策略",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_loader",
      "label": "任务数据与提示模板动态加载器\n加载选择题、开放问答与逻辑网格规范\n为各子任务定制化组装评测输入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_loader",
      "label": "模型推理后端统一配置\n声明目标大模型本地权重路径或 API 密钥\n配置最大上下文长度与生成超参数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "backend_router",
      "label": "推理执行后端路由决策门\n本地 vLLM / Hugging Face 加速推理 vs\n云端商业 API 提供商接口调用",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "local_backend",
      "label": "本地 vLLM / Hugging Face 执行器\n高吞吐分布式张量并行批量推理\n直接执行确定性贪婪采样解码",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "api_backend",
      "label": "商用 API 接口服务提供商\n异步高并发网络 API 批量请求引擎\n智能调控速率限制与连接并发度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt_shards",
      "label": "提示词渲染装配与数据分片\n将模板与实例渲染为多进程分片\n支持分布式并行节点协同计算",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cache_resume",
      "label": "持久化缓存与断点续跑机制\n实时将生成中间结果落盘持久化\n异常中断后自动恢复跳过已完成项",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "batch_retry",
      "label": "批量推理与带上限重试机制\n结合指数退避策略执行模型调用\nAPI 错误重试次数严格限定最多 10 次",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "merge_outputs",
      "label": "分布式分片结果聚合汇总\n归集各分片结果为统一 JSON 文件\n校验样本顺序完整性与字段格式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "scorer_router",
      "label": "任务专属评估分流路由器\n按任务维度分流至专业解析器\n适配选择题、数学、代码、逻辑与规划",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "mmlu_parser",
      "label": "MMLU-Redux 选择题解析引擎\n融合 JSON、正则与 LaTeX Boxed 解析\n精确抽取标准 A/B/C/D 选项字母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "math_parser",
      "label": "GSM8K 与 MATH 数值规范校验器\n清洗数学表达式、符号与货币单位\n基于浮点数容差判定数值完全相等",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "crux_parser",
      "label": "CRUX 推理任务输出比对器\n规范化多行代码及推理输出文本\n执行严格的字符串字面精确匹配",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "zebra_parser",
      "label": "ZebraLogic 网格逻辑验证器\n抽取结构化 JSON 网格行与关系约束\n严格校验每个单元格逻辑赋值准确性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gplanet_parser",
      "label": "G-PlanET 具身规划动作评分器\n验证多步行动轨迹与动作序列逻辑\n校验前置条件满足度与最终目标达成",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "completeness_gate",
      "label": "逐任务样本完整性校验门禁\n核验分片样本是否全量收集齐全\n分流至最终基准报告或缺漏预警",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "zeroeval_report",
      "label": "ZeroEval 统一评测基准报告\n汇总各子任务准确率与标准基线得分\n输出发表级大模型全景评估榜单",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "incomplete_flag",
      "label": "评测未全量完成异常警报\n精确标记缺失样本或意外中断分片\n杜绝样本不全导致的失真评测结论",
      "type": "terminal",
      "size": "xl"
    }
  ],
