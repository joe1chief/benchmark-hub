<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3320" pageHeight="1616" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2504.01848v3&#xa;PDF 2f58f1a6581a&#xa;Git df37a1752ad6&#xa;项目树 caec0bdac8e6" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="从 ICML 2024 开始&#xa;Spotlight 与 Oral 论文&#xa;当代机器学习研究&#xa;建立广泛候选池" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="GPT-4o 初筛&#xa;商业机构与地理条件&#xa;有实证贡献且非纯框架&#xa;单机硬件可完成" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="应用复现性过滤&#xa;不依赖闭源模型&#xa;不需新采集或标注人类数据&#xa;细节充分且依赖可获取" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="人工筛查初筛论文&#xa;确认适用性与单机范围&#xa;共联系 42 位合格作者&#xa;获得 20 项合作&#xa;覆盖 12 个 ICML 主题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="两名工程师起草 Rubric&#xa;深入阅读论文&#xa;分解实证贡献&#xa;定义完整复现目标" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="构建分层 Rubric&#xa;要求组织为树&#xa;子节点细化父目标&#xa;兄弟节点按重要性加权" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="细化叶节点标准&#xa;专家可在 15 分钟内判定&#xa;代码开发·执行·结果匹配&#xa;20 篇论文共 8,316 个叶节点" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="内部与原作者联合评审&#xa;优化结构与措辞&#xa;与原作者签订正式合作协议&#xa;多轮反馈修订&#xa;正确性确认与最终签署" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="解决论文信息不足&#xa;面向候选者的补遗&#xa;可选的仅评判器补遗&#xa;记录澄清与范围" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="完成 PaperBench 任务&#xa;20 篇 ICML 论文·12 个主题&#xa;论文 + 补遗 + Rubric&#xa;工件 + 黑名单 + 配置" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="运行候选智能体&#xa;论文 + 补遗 + 说明&#xa;Ubuntu 24.04·单张 A10&#xa;论文实验上限 12 小时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="提交复现仓库&#xa;从零实现研究工作&#xa;根目录必须有 reproduce.sh&#xa;保留代码与实验配置" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="在全新虚拟机中复现&#xa;Ubuntu 24.04·单张 A10&#xa;从头执行 reproduce.sh&#xa;论文执行上限 12 小时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="形成执行后提交&#xa;保留源代码仓库&#xa;增加 reproduce.log&#xa;增加生成结果与图表" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="选择叶节点要求类型&#xa;加载论文与完整 Rubric&#xa;加入前序兄弟和祖先要求&#xa;独立评分每个叶节点" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="代码开发分支&#xa;查看文档与源代码&#xa;查看 reproduce.sh&#xa;是否存在正确实现？" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="执行分支&#xa;查看文档、代码和脚本&#xa;查看 reproduce.log&#xa;是否发生要求的执行？" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="结果匹配分支&#xa;查看文档、脚本和日志&#xa;查看新增或修改的输出&#xa;证据是否匹配论文？" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="运行 SimpleJudge&#xa;o3-mini-2025-01-31·高推理&#xa;按要求类型筛选文件&#xa;过长时排序并取前十个&#xa;论文 + 补遗 + 相关证据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="叶节点二元评分&#xa;满足当前标准记 1&#xa;否则记 0&#xa;缺脚本则执行与结果节点为 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="沿 Rubric 树加权汇总&#xa;父节点为子节点加权均值&#xa;分数逐层传播至根节点&#xa;根节点即复现分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="报告基准表现&#xa;平均复现分数&#xa;对全部 20 篇论文求均值&#xa;论文主实验每篇运行三次" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="构建 JudgeEval&#xa;4 个 PaperBench 部分复现&#xa;1 个开发集论文复现&#xa;专家二元真值与解释&#xa;不运行独立复现阶段" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="评测多种评判后端&#xa;GPT-4o-mini·GPT-4o&#xa;o1-mini·o1·o3-mini&#xa;按论文宏平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="报告 JudgeEval 指标&#xa;准确率·精确率·召回率·F1&#xa;o3-mini SimpleJudge F1 为 0.83&#xa;每篇约 66 美元" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="候选者访问边界&#xa;任务期间隐藏 Rubric&#xa;禁止使用原作者代码&#xa;监控逐论文黑名单" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="1432" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="固定公开发布&#xa;commit df37a1752ad6·MIT&#xa;20 个正式 + 3 个开发任务目录&#xa;5 个 JudgeEval 样例" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="1432" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="发布完整性边界&#xa;初始 352ed048 缺少数据&#xa;df37a175 补充随机插值任务&#xa;并增加第 3 个开发任务" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="1432" width="200" height="100" as="geometry"/></mxCell><mxCell id="31" value="Code-Dev 变体边界&#xa;跳过干净环境复现&#xa;只评代码开发叶节点&#xa;成本更低但严格性更弱" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="1432" width="200" height="100" as="geometry"/></mxCell><mxCell id="32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometr