    {
      "id": "step_1",
      "label": "从ICML 2024起步\n收集Spotlight与Oral论文\n聚焦当代机器学习研究\n形成跨主题候选池",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "应用适配性筛选\n需有实证且单机可运行\n不依赖闭源模型或新人工数据\n方法细节与依赖可获取",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "阅读论文并招募作者\n随机检查筛选后论文\n联系42位原论文作者\n确定20篇并覆盖12个主题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "起草分层评分树\n两名研究工程师先行编写\n分解论文实证贡献\n定义完整复现所需结果",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "开展内部审查\n细化结构与判据\n使叶节点二元且足够细粒度\n按同层重要性赋权",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "与论文原作者共建\n多轮核验正确性\n消除论文未充分说明处\n编写候选与评判专用附录",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "定稿分层评分树\n结果匹配 · 执行\n代码开发三类叶节点\n原作者核验并签字确认",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "发布PaperBench任务\n20篇论文 · 8316个叶结果\n提供论文与澄清附录\n隐藏评分树并设置代码黑名单",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "智能体从零复现\n理解论文实证贡献\n开发并排查实验\n提交含reproduce.sh的仓库",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "在全新虚拟机复现\nUbuntu 24.04 · 单张A10\nreproduce.sh最多运行12小时\n生成结果与reproduce.log",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "独立评判每个叶节点\nSimpleJudge读取论文与评分树\n排序并放入最相关十个文件\n给出二元通过或失败",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "加权向上汇总分数\n父节点为子节点加权均值\n一直传播到评分树根部\n得到单项Replication Score",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "用JudgeEval验证评判器\n五篇论文的部分复现提交\n人类专家叶标签作为金标准\n宏平均二元指标 · F1为0.83",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告基准表现\n平均Replication Score\n按要求类型拆分结果\n比较智能体与人类基线",
      "type": "terminal",
      "size": "xl"
    }
