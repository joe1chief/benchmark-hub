  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="952" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="整合生物医学知识来源&#xa;MEDLINE / PubMed 与 PubMed Central&#xa;MeSH、本体、数据库与 RDF 三元组" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="构建 Task 1a 训练数据&#xa;标题 + 摘要 + 已有 MeSH 标签&#xa;索引日期早于 2013 年 3 月 1 日" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择后续 MEDLINE 记录&#xa;3 批 × 每批 6 周 • 新文章不重复&#xa;选择预计 90 天内获 MeSH 的期刊" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="运行在线语义索引&#xa;21 小时内预测 MeSH 标题&#xa;提交时不可见人工标签" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="等待 NLM 人工索引标签&#xa;逐步揭示真实 MeSH&#xa;挑战结束时冻结已获标签" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="评分 Task 1a 分类&#xa;平面 Micro-F1&#xa;分层最低公共祖先 F Measure" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="生物医学专家编写真实问题&#xa;是非 • 事实 • 列表 • 摘要&#xa;用论文与本体建立答案依据" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="构建 Task 1b 金标准基准&#xa;29 道开发题 + 282 道测试题&#xa;类型 • 概念 • 论文 • 片段 • 三元组 • 答案" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="仅发布 Phase A 输入&#xa;问题文本 + 问题类型&#xa;隐藏官方金标证据与答案" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="运行 Task 1b Phase A 检索&#xa;返回概念、论文、片段与 RDF 三元组&#xa;每题上限 100 / 100 / 100 / 1,000" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="评分 Phase A 检索&#xa;MAP 为主指标&#xa;GMAP • Precision • Recall&#xa;F Measure 为附加指标&#xa;片段使用 offset 感知匹配" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="运行 Task 1b Phase B 作答&#xa;官方金标概念 / 论文&#xa;片段 / 三元组为主输入&#xa;可用自身 Phase-A 输出或重跑&#xa;生成精确与理想答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="评分精确答案&#xa;是非准确率 • 事实型 MRR 为主&#xa;列表平均 F 为主 • 摘要题无精确答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="评分理想答案&#xa;专家四项维度按 1–5 分评分&#xa;召回 • 精确 • 重复 • 可读性&#xa;ROUGE 仅作探索" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=mi