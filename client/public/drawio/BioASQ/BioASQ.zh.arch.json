  "nodes": [
    {
      "id": "sources",
      "label": "整合生物医学知识来源\nMEDLINE / PubMed 与 PubMed Central\nMeSH、本体、数据库与 RDF 三元组",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task1a_train",
      "label": "构建 Task 1a 训练数据\n标题 + 摘要 + 已有 MeSH 标签\n索引日期早于 2013 年 3 月 1 日",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task1a_test",
      "label": "选择后续 MEDLINE 记录\n3 批 × 每批 6 周 • 新文章不重复\n选择预计 90 天内获 MeSH 的期刊",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task1a_submit",
      "label": "运行在线语义索引\n21 小时内预测 MeSH 标题\n提交时不可见人工标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task1a_gold",
      "label": "等待 NLM 人工索引标签\n逐步揭示真实 MeSH\n挑战结束时冻结已获标签",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "task1a_metrics",
      "label": "评分 Task 1a 分类\n平面 Micro-F1\n分层最低公共祖先 F Measure",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "experts",
      "label": "生物医学专家编写真实问题\n是非 • 事实 • 列表 • 摘要\n用论文与本体建立答案依据",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "qa_gold",
      "label": "构建 Task 1b 金标准基准\n29 道开发题 + 282 道测试题\n类型 • 概念 • 论文 • 片段 • 三元组 • 答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "phase_a_input",
      "label": "仅发布 Phase A 输入\n问题文本 + 问题类型\n隐藏官方金标证据与答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "phase_a",
      "label": "运行 Task 1b Phase A 检索\n返回概念、论文、片段与 RDF 三元组\n每题上限 100 / 100 / 100 / 1,000",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "phase_a_metrics",
      "label": "评分 Phase A 检索\nMAP 为主指标\nGMAP • Precision • Recall\nF Measure 为附加指标\n片段使用 offset 感知匹配",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "phase_b",
      "label": "运行 Task 1b Phase B 作答\n官方金标概念 / 论文\n片段 / 三元组为主输入\n可用自身 Phase-A 输出或重跑\n生成精确与理想答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "exact_metrics",
      "label": "评分精确答案\n是非准确率 • 事实型 MRR 为主\n列表平均 F 为主 • 摘要题无精确答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ideal_metrics",
      "label": "评分理想答案\n专家四项维度按 1–5 分评分\n召回 • 精确 • 重复 • 可读性\nROUGE 仅作探索",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "results",
      "label": "发布 BioASQ 挑战结果\n语义索引与问答榜单\n公开数据、评测服务、运行结果与基线",
      "type": "terminal",
      "size": "xl"
    }
  ],
