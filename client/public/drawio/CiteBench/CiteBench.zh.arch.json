      "size": "xl"
    },
    {
      "id": "schema",
      "label": "序列化统一标签化输入\n被引摘要 + ABS 标签的引用论文摘要\nCTX_B 标签前文 + CTX_A 标签后文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "anchors",
      "label": "规范引文锚点\n目标参考文献映射为 [0]\n其他参考文献映射为 #OTHEREFR",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "splits",
      "label": "发布统一数据划分\n训练 322,037 • 验证 23,016\n测试 13,712 • 合计 358,765",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "baselines",
      "label": "训练标准化基线\nLexRank 抽取式基线\nLED 直接监督生成模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generation",
      "label": "生成引文文本\n使用统一输入与目标格式\n比较单数据集训练与联合训练",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "计算文本相似度\nROUGE-1 • ROUGE-2 • ROUGE-L\n与标准引文文本计算 BERTScore",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "transfer",
