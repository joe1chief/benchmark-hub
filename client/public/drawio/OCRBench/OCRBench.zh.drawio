    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3080" pageHeight="832" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="汇集论文大规模实验数据&#xa;29 个公开 OCR 相关数据集&#xa;文本识别 · VQA · 文档&#xa;KIE · HMER" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="对应哪一种&#xa;论文产物？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="构造语义对照数据&#xa;使用 IIIT5K 词典&#xa;ST：3,000 张单词图像&#xa;NST：打乱同一批字符" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="准备 FullTest 实验池&#xa;删除答案少于四个符号的问题&#xa;部分大型数据集抽取 3,000 条&#xa;不据此推断紧凑版选样规则" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="执行 29 数据集实验&#xa;FullTest JSON · 论文表 1–2&#xa;分数据集统计包含式准确率&#xa;区别于 1,000 条发布版" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="定义紧凑版 OCRBench&#xa;五组件采用固定配额&#xa;1,000 条图像—问题—答案&#xa;论文未给出逐项选样算法" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="分配五个组件的&#xa;固定配额" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="文本识别 · 300&#xa;规则 · 不规则 · 艺术字&#xa;手写 · 数字串 · 非语义文本&#xa;六类各 50" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="88" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="场景文本 VQA · 200&#xa;STVQA · TextVQA&#xa;ESTVQA 英文 · OCRVQA&#xa;四个来源各 50" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="文档 VQA · 200&#xa;DocVQA · ChartQA 增强题&#xa;ChartQA 人工题 · InfographicVQA&#xa;四个来源各 50" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="关键信息提取 · 200&#xa;SROIE 67 · FUNSD 66 · POIE 67&#xa;询问给定键对应的值&#xa;保留多个正确答案候选" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="手写数学表达式识别 · 100&#xa;HME100K 图像&#xa;识别手写数学表达式&#xa;要求输出 LaTeX" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="保留任务专属问题&#xa;英文 · 中文 · 数字串提示&#xa;KIE 增加直接读图指令&#xa;保留 HMER 的 LaTeX 合同" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="人工核验全部 1,000 条&#xa;修正不准确答案&#xa;补充其他正确答案候选&#xa;检查固定组件配额" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="发布 OCRBench 数据与图像&#xa;JSON 字段：类型 · 数据集 · 问题&#xa;答案 · 图像路径 · ID&#xa;Hugging Face 公开镜像 1,000 条" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="执行多模态模型零样本推理&#xa;输入单张图像及其问题&#xa;保留自由文本预测&#xa;论文未统一生成参数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="应用发布版归一化&#xa;非 HMER：小写 + 去首尾空白&#xa;展平换行&#xa;HMER：删空格/换行，不转小写&#xa;逐个测试备选标准答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="按发布代码赋予二元单题得分&#xa;任一归一化标准答案&#xa;为预测文本子串 → 1&#xa;否则 → 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="汇总五组件正确数&#xa;文本识别 300 · 场景 VQA 200&#xa;文档 VQA 200 · KIE 200&#xa;HMER 100&#xa;总分：0–1,000" styl