  "nodes": [
    {
      "id": "study_sources",
      "label": "汇集论文大规模实验数据\n29 个公开 OCR 相关数据集\n文本识别 · VQA · 文档\nKIE · HMER",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "artifact_gate",
      "label": "对应哪一种\n论文产物？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "semantic_controls",
      "label": "构造语义对照数据\n使用 IIIT5K 词典\nST：3,000 张单词图像\nNST：打乱同一批字符",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "broad_filter",
      "label": "准备 FullTest 实验池\n删除答案少于四个符号的问题\n部分大型数据集抽取 3,000 条\n不据此推断紧凑版选样规则",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "broad_study",
      "label": "执行 29 数据集实验\nFullTest JSON · 论文表 1–2\n分数据集统计包含式准确率\n区别于 1,000 条发布版",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "compact_contract",
      "label": "定义紧凑版 OCRBench\n五组件采用固定配额\n1,000 条图像—问题—答案\n论文未给出逐项选样算法",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "component_gate",
      "label": "分配五个组件的\n固定配额",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "recognition",
      "label": "文本识别 · 300\n规则 · 不规则 · 艺术字\n手写 · 数字串 · 非语义文本\n六类各 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "scene_vqa",
      "label": "场景文本 VQA · 200\nSTVQA · TextVQA\nESTVQA 英文 · OCRVQA\n四个来源各 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "doc_vqa",
      "label": "文档 VQA · 200\nDocVQA · ChartQA 增强题\nChartQA 人工题 · InfographicVQA\n四个来源各 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "kie",
      "label": "关键信息提取 · 200\nSROIE 67 · FUNSD 66 · POIE 67\n询问给定键对应的值\n保留多个正确答案候选",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "hmer",
      "label": "手写数学表达式识别 · 100\nHME100K 图像\n识别手写数学表达式\n要求输出 LaTeX",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompting",
      "label": "保留任务专属问题\n英文 · 中文 · 数字串提示\nKIE 增加直接读图指令\n保留 HMER 的 LaTeX 合同",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "人工核验全部 1,000 条\n修正不准确答案\n补充其他正确答案候选\n检查固定组件配额",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 OCRBench 数据与图像\nJSON 字段：类型 · 数据集 · 问题\n答案 · 图像路径 · ID\nHugging Face 公开镜像 1,000 条",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "infer",
      "label": "执行多模态模型零样本推理\n输入单张图像及其问题\n保留自由文本预测\n论文未统一生成参数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "应用发布版归一化\n非 HMER：小写 + 去首尾空白\n展平换行\nHMER：删空格/换行，不转小写\n逐个测试备选标准答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "containment",
      "label": "按发布代码赋予二元单题得分\n任一归一化标准答案\n为预测文本子串 → 1\n否则 → 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "汇总五组件正确数\n文本识别 300 · 场景 VQA 200\n文档 VQA 200 · KIE 200\nHMER 100\n总分：0–1,000",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "source_boundary",
      "label": "来源与发布边界\narXiv v7 4cc667… · 仓库 86d091…\nJSON df7595… · HF 92a54b…\n存在短答案候选\nMIT 代码 · 数据沿用上游条款",
      "type": "document",
      "size": "xl"
    }
  ],
