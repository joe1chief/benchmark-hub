      "type": "process",
      "size": "xl"
    },
    {
      "id": "semantic",
      "label": "增加语义对照数据\n使用 IIIT5K 词典\nST 保留 3,000 个单词\nNST 打乱同一批字符",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidate",
      "label": "准备大规模实验候选池\n大型数据集各抽取 3,000 条\n排除少于四个符号的答案\n降低包含式判断误报",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompts",
      "label": "统一任务专属提示\n英文 · 中文 · 数字串识别\nKIE 键到值问题\nHMER 要求输出 LaTeX",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "recognition",
      "label": "选择文本识别样本 · 300\n规则 · 不规则 · 艺术字\n手写 · 数字串\n非语义文本 · 每类 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "vqa",
      "label": "选择两个 VQA 组件\n场景文本 VQA · 200\n四个来源各 50\n文档 VQA · 200 · 四组各 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "extraction",
      "label": "选择 KIE 与 HMER 组件\nKIE · 200：SROIE 67\nFUNSD 66 · POIE 67\nHME100K HMER · 100",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "人工核验全部 1,000 个问答对\n修正不准确的标准答案\n补充其他正确答案候选\n检查五组件覆盖",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布紧凑版 OCRBench\n1,000 条图像—问题—答案\n五个 OCR 任务组件\n全部经人工筛选与校正",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "infer",
      "label": "执行大模型零样本推理\n输入图像与任务提示\nKIE 添加直接读图前缀\n保留自由文本回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "criterion",
      "label": "应用统一判断标准\n检查标准答案是否\n出现在模型回答中\n接受其他正确答案候选",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "按组件统计正确数\n文本识别最高 300\n场景 VQA · 文档 VQA · KIE 各 200\nHMER 最高 100",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 OCRBench 分数\n五个组件正确数相加\n最终范围 0–1,000\n分析 OCR 能力缺口",
      "type": "terminal",
      "size": "xl"
    }
