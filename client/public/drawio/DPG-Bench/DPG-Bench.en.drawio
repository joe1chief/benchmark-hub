 parent="1"><mxGeometry x="504" y="88" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Object365 Composition&#xa;sample 1–4 objects&#xa;cover main category and subcategory&#xa;form a multi-object prompt seed" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="First GPT-4 Pass: Dense Expansion&#xa;enrich scene context&#xa;add object attributes&#xa;specify spatial / semantic relationships" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Human Verification&#xa;inspect expanded prompts&#xa;correct unsupported&#xa;or incoherent details&#xa;retain valid dense requirements" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Second GPT-4 Pass via DSG&#xa;derive semantic tuples and categories&#xa;write yes / no questions&#xa;construct question dependency graphs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="312" width="200" height="100" as="geometry"/></mxCell