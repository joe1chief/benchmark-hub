  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n论文 v5 · ICLR 2025\n仓库 5422852d · 无标签\n核查于 2026-07-21",
      "type": "document",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "sources",
      "label": "确定四类图像来源\nCOCO 2017 验证集 · SBU\nTextVQA · Flickr\n最终 400 个图像-提示对",
      "type": "database",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "sampling",
      "label": "选择来源图像\n随机：COCO · SBU · TextVQA\nFlickr：论文仅报告多样主题\nFlickr 选择方法未披露",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "content_labels",
      "label": "标注图像内容\nGPT-4V 主题用于图 4\n公开 JSON 不含内容标签\n标注提示 / 快照未公开",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "author",
      "label": "人工编写指令\n多样 · 困难 · 开放式\n组合多个请求 / 约束\n每张图像对应一条指令",
      "type": "user",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "construction_gaps",
      "label": "未披露的构建协议\n来源配额 / 随机种子\n标注者数量 / 培训\n无公开质检 / 拒绝 / 仲裁流程\nGPT-4V 提示 / 版本 / 解码",
      "type": "document",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "qc",
      "label": "遵循三项编写原则\n正确性：人类可回答\n不泄露答案\n回答必须依赖图像\n未发布接受 / 拒绝门槛",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "decompose",
      "label": "拆分每条指令\n保存原子子指令\n保留有序组件边界\n记录 num_of_component",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "分配两套采集分类\n论文八类子指令\n五类复杂度标签\n复杂度不作为报告指标",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "weights",
      "label": "分配组件最高权重\n重要性 + 难度 · 1–10\n论文规则：每题总和 = 10\n若含描述类：两组件时为 6，三项以上为 4",
      "type": "process",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "构成论文基准\n400 个图像-提示对\n图像 + 指令 + 组件\n类型 + 权重 + 复杂度",
      "type": "database",
      "module": "build",
      "size": "xl"
    },
    {
      "id": "release_fields",
      "label": "固定 JSON 版本 · f75671cd\n400 行 · 398 条唯一指令\nimage · instruction · type\nnum_of_component · components\ncomponent_weight · component_type\nimage_name：80 行 · 21 个值",
      "type": "database",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "release_audit",
      "label": "发布完整性审计\n每题组件数：2 / 3 / 4 / 5\n对应数量：204 / 155 / 40 / 1\n单题内类别重复：22",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "weight_drift",
      "label": "论文权重规则审计 · 零基行号\n描述类违例：3 · 9 · 31\n308 · 316 · 372\n行 261：含两个描述类组件，规则有歧义\n权重和 = 8：行 241 · 247",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "taxonomy_drift",
      "label": "论文名称 ↔ 发布键名\ndescription ↔ describe\ngenre ↔ linguistics · OCR ↔ textual\n其余采用规范化蛇形命名",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "image_boundary",
      "label": "图像访问边界\n400 个唯一图像字符串\n399 个 HTTP(S) · 零基行 193 缺协议\n仅 URL · 无图像包\nREADME：URL 不稳定 · 三次修复\n无逐行来源字段",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "openness",
      "label": "公开发布边界\n数据 + notebook + 单行示例\n仓库附自定义 Apple 许可\n无依赖锁定 / 测试\n无参考答案 / 裁判输出",
      "type": "document",
      "module": "release",
      "size": "xl"
    },
    {
      "id": "candidate",
      "label": "运行候选多模态模型推理\nREADME 约定：url + text\n失败时令 text = \"error\"\n单行示例却使用\nquestion_id + prompt + text",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "positional_join",
      "label": "载入基准与候选 JSONL\n按候选文件行数迭代\n按行位置配对指令\n忽略基准 image 字段\n裁判直接接收候选行 url\n不校验 URL / 长度 / 顺序",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "error_gate",
      "label": "候选 text 是否为 \"error\"？\n多维度质量与逻辑严谨性决策门\n基于严格阈值的合格判定准则",
      "type": "decision",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "judge_prompt",
      "label": "否 → 构造固定英文裁判提示\n指令 + 有序组件\n各组件最高权重\n候选回答 + 严格评分要求\n要求首句采用指定分数格式",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "judge_call",
      "label": "调用多模态 GPT-4o 裁判\n用户文本 + 候选行 url\n无系统消息 · max_tokens 2,000\nbare except 最多重试五次\n快照 / 其他解码参数未固定",
      "type": "user",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "仅解析首句\n句点 → 逗号 → 冒号 / 斜杠\n按类别与总分保存整数比率\n不检查边界 / 组件数 / 求和\n不保证八类均有得分",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "failure_skip",
      "label": "是 / 调用失败 / 格式异常 → 排除\n\"error\" 或五次失败：保留初始整数\n裁判格式异常：score_raw 为字符串\n广义解析异常：静默吞掉\n不进入均值；实际分母缩小",
      "type": "terminal",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "judge_drift",
      "label": "裁判版本漂移 · 论文 v5\nmini-2024-07-18 · 4o-2024-05-13\n4o-2024-11-20 · chatgpt-4o-latest\n分数变化，八模型排名稳定\n表3：0–100 · 表6–9：0–1\n波动约1%；notebook：\"gpt-4o\"",
      "type": "document",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "overwrite",
      "label": "分类汇总注意项\nscore_dict 以类别为键\n重复类别会覆盖先前组件\n发布集中 22 题可能触发\ntotal_score 单独解析",
      "type": "document",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "对成功解析的比率求均值\n各类别算术平均\ntotal_score 算术平均\nnotebook 输出范围：0–1",
      "type": "process",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告尺度约定\n方法与表 1 / 3：0–100\nnotebook 与表 6–9：0–1\n主总分 = 原始均分 ÷ 10 × 100\n八类分项 · 声称使用全部 400 条\n不报告复杂度标签",
      "type": "terminal",
      "module": "evaluate",
      "size": "xl"
    },
    {
      "id": "evaluator_gaps",
      "label": "复现边界\n论文表格的裁判快照未固定\n示例结构与 notebook 冲突\n无全集守卫 / 错误报告\n无托管提交流程",
      "type": "document",
      "module": "evaluate",
      "size": "xl"
    }
  ],
