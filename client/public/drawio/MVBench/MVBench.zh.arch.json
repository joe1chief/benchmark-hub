  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n论文 · arXiv 2311.17005v4\n官方仓库 · 4dd8210b\nHF 数据集 · 230a2d4f\n审计精确版本",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "spatial_tasks",
      "label": "扩展九类空间任务\n动作 · 物体 · 位置 · 场景\n计数 · 属性 · 姿态 · 字符\n认知 → 20 项时序任务\n排除单帧捷径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sources",
      "label": "选择 11 个公开视频数据集\n第一 / 第三人称视角\n室内 / 室外场景\n真实 / 模拟视频",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "temporal_gate",
      "label": "视频片段是否具备时序敏感性？\n包含有意义的运动\n主要为 5-35 秒",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "exclude",
      "label": "排除候选样本\n运动可忽略\n上下文过长\n未通过数据源专用规则",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "source_rules",
      "label": "应用难度 + 数据源规则\n难度合适且答案可区分？\nSTAR · 平移视频起止点\nCLEVRER · 排除超过 10 个条件",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "source_rule_gate",
      "label": "应用难度与数据源规则后是否符合条件？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "mcq_gate",
      "label": "是否已有可用的多项选择问答？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "direct_qa",
      "label": "直接采用现有问答\n保留标准答案\n保留公开标注\n保留任务专用筛选结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generate_question",
      "label": "使用 ChatGPT 生成问题\n遵循时序任务定义\n问题落在视频标注上\n附录 · 需要时生成 3-5 个问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidate_gate",
      "label": "模板能否提供候选选项？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "template_options",
      "label": "构造模板候选项\n使用真实标注\n示例 · 正确 / 反义 / 不确定\n示例 · 方向 + 静止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "llm_options",
      "label": "使用 LLM 构造候选项\n意外动作 / 开放式问答\n转换答案并生成干扰项\n保持标准答案正确",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sample_options",
      "label": "论文 · 每题采样 3-5 个选项\n从可用候选项中抽取\n对每道问题应用\n保留标准答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "shuffle_options",
      "label": "打乱选项顺序\n消除位置规律\n保持答案映射",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_balance",
      "label": "使用 LLM 平衡选项长度\n减少长答案泄漏\n保持相近且合理的文本长度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "汇总论文版 MVBench\n20 项时序任务\n每项任务 200 道选择题\n共 4,000 道选择题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release_snapshot",
      "label": "固定的公开数据快照\n20 个 JSON 配置 · 4,000 行\n签名字段 · 问题 + 答案 + 候选\n唯一值 · 3,569 / 4,000\n重复 · 151 组 / 582 行\n1,000 行带起止时间",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_drift",
      "label": "论文到发布数据的偏差\n论文要求 3-5 个选项\nHF 含 5 行单选项 + 118 行双选项\n仓库说明约 30 道重复问答被替换",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "rights_boundary",
      "label": "发布与权利边界\nHF 卡片 · MIT + 使用确认条款\n视频权利仍归原始来源\n320 个 NTU 视频需人工申请",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "eval_load",
      "label": "载入参考笔记本输入\n任务 JSON + 源视频 / 帧\n保留原始视频元数据\n选择 VideoChat2 评测路径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "bound_gate",
      "label": "是否存在起止时间边界？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "bounded_clip",
      "label": "限定到标注时间段\n将秒数转换为帧范围\n在区间中心均匀取帧",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "full_clip",
      "label": "使用完整视频 / 帧序列\n保留数据集专用解码器\n在完整范围中心均匀取帧",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sample_frames",
      "label": "VideoChat2 笔记本参考实现\n均匀采样 16 帧\n缩放并中心裁剪到 224\n其他模型自行规定输入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_prompt",
      "label": "应用论文评测提示词\n关注因果 / 顺序 / 运动\n追加“仅给出最佳选项”\n回答以 Best option: ( 开始",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "decode_parse",
      "label": "确定性生成 + 笔记本解析\ndo_sample = False · max_new_tokens = 100\n仅保留首行 · 返回文本前加左括号\n转小写 / 切分 · 取双方首个词元",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_row",
      "label": "确定性计算行级得分\n两个选项词元互相包含 · 1\n先移除预测词元中的句点\n否则 · 0\n忽略答案内容 · 不使用 LLM 裁判",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "汇总行级准确率\n各任务正确数 / 总数\n总体正确数 / 4,000\n每项任务均为 200 行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 MVBench 结果\n20 项任务准确率\n总体平均准确率\n不使用 LLM 裁判",
      "type": "terminal",
      "size": "xl"
    }
  ],
