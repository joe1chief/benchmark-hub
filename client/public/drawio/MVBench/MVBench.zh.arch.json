      "type": "database",
      "size": "xl"
    },
    {
      "id": "sensitivity",
      "label": "筛选时序敏感视频\n移除几乎无运动片段\n移除上下文过长视频\n主要保留 5–35 秒片段",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "平衡问题难度\n随机移动 STAR 片段边界\n限制 CLEVRER 描述条件\n避免过易或过难",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "questions",
      "label": "用 ChatGPT 生成问题\n遵循各任务定义\n基于公开视频标注\n转换为多项选择题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidates",
      "label": "构造候选选项\n优先使用标准标注模板\n开放问答由 LLM 转换\n加入正确答案与干扰项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "options",
      "label": "处理答案选项\n抽取三至五个选项\n随机打乱顺序\n用 LLM 统一合理长度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "定稿 MVBench\n每个任务 200 道选择题\n20 个任务共 4,000 题\n保留视频标准标注",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "应用时序评测提示\n检查人物动作与姿态\n检查物体细节与运动\n要求输出一个最佳选项",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "extract",
      "label": "保证选项抽取\n为各选项添加圆括号\n使用 Best Option: ( 前缀\n达到 100% 抽取率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "对照标准答案评分\n使用确定性准确率\n避免 LLM 评分偏差\n报告分任务与平均结果",
      "type": "terminal",
      "size": "xl"
    }
