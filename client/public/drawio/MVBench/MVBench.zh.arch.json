      "type": "database",
      "size": "xl"
    },
    {
      "id": "temporal_tasks",
      "label": "定义 20 类时序任务\n覆盖感知到认知\n要求完整视频推理\n排除单帧捷径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "datasets",
