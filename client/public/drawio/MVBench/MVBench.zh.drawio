<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="1112" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;论文 · arXiv 2311.17005v4&#xa;官方仓库 · 4dd8210b&#xa;HF 数据集 · 230a2d4f&#xa;审计精确版本" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="扩展九类空间任务&#xa;动作 · 物体 · 位置 · 场景&#xa;计数 · 属性 · 姿态 · 字符&#xa;认知 → 20 项时序任务&#xa;排除单帧捷径" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择 11 个公开视频数据集&#xa;第一 / 第三人称视角&#xa;室内 / 室外场景&#xa;真实 / 模拟视频" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="视频片段是否具备时序敏感性？&#xa;包含有意义的运动&#xa;主要为 5-35 秒" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="排除候选样本&#xa;运动可忽略&#xa;上下文过长&#xa;未通过数据源专用规则" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="464" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="应用难度 + 数据源规则&#xa;难度合适且答案可区分？&#xa;STAR · 平移视频起止点&#xa;CLEVRER · 排除超过 10 个条件" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1072" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="应用难度与数据源规则后是否符合条件？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="是否已有可用的多项选择问答？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1616" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="直接采用现有问答&#xa;保留标准答案&#xa;保留公开标注&#xa;保留任务专用筛选结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="-16" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="使用 ChatGPT 生成问题&#xa;遵循时序任务定义&#xa;问题落在视频标注上&#xa;附录 · 需要时生成 3-5 个问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="模板能否提供候选选项？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="构造模板候选项&#xa;使用真实标注&#xa;示例 · 正确 / 反义 / 不确定&#xa;示例 · 方向 + 静止" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2432" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="使用 LLM 构造候选项&#xa;意外动作 / 开放式问答&#xa;转换答案并生成干扰项&#xa;保持标准答案正确" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2432" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="论文 · 每题采样 3-5 个选项&#xa;从可用候选项中抽取&#xa;对每道问题应用&#xa;保留标准答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2704" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="打乱选项顺序&#xa;消除位置规律&#xa;保持答案映射" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2976" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="使用 LLM 平衡选项长度&#xa;减少长答案泄漏&#xa;保持相近且合理的文本长度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3248" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="汇总论文版 MVBench&#xa;20 项时序任务&#xa;每项任务 200 道选择题&#xa;共 4,000 道选择题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3520" y="144" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="固定的公开数据快照&#xa;20 个 JSON 配置 · 4,000 行&#xa;签名字段 · 问题 + 答案 + 候选&#xa;唯一值 · 3,569 / 4,000&#xa;重复 · 151 组 / 582 行&#xa;1,000 行带起止时间" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="624" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="论文到发布数据的偏差&#xa;论文要求 3-5 个选项&#xa;HF 含 5 行单选项 + 118 行双选项&#xa;仓库说明约 30 道重复问答被替换" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="624" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="发布与权利边界&#xa;HF 卡片 · MIT + 使用确认条款&#xa;视频权利仍归原始来源&#xa;320 个 NTU 视频需人工申请" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="624" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="载入参考笔记本输入&#xa;任务 JSON + 源视频 / 帧&#xa;保留原始视频元数据&#xa;选择 VideoChat2 评测路径" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3520" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="是否存在起止时间边界？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3248" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="限定到标注时间段&#xa;将秒数转换为帧范围&#xa;在区间中心均匀取帧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2976" y="704" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="使用完整视频 / 帧序列&#xa;保留数据集专用解码器&#xa;在完整范围中心均匀取帧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2976" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="VideoChat2 笔记本参考实现&#xa;均匀采样 16 帧&#xa;缩放并中心裁剪到 224&#xa;其他模型自行规定输入" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2704" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="应用论文评测提示词&#xa;关注因果 / 顺序 / 运动&#xa;追加“仅给出最佳选项”&#xa;回答以 Best option: ( 开始" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2432" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="确定性生成 + 笔记本解析&#xa;do_sample = False · max_new_tokens = 100&#xa;仅保留首行 · 返回文本前加左括号&#xa;转小写 / 切分 · 取双方首个词元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="确定性计算行级得分&#xa;两个选项词元互相包含 · 1&#xa;先移除预测词元中的句点&#xa;否则 · 0&#xa;忽略答案内容 · 不使用 LLM 裁判" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="816" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="汇总行级准确率&#xa;各任务正确数 / 总数&#xa;总体正确数 / 4,000&#xa;每项任务均为 200 行" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x=