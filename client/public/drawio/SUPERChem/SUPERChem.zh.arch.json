      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_item_discard",
      "label": "存在争议或机理有瑕试题剔除池\n过滤可能存在数据泄露、副反应争议或选项瑕疵的问题\n保障基准题目在现代化学理论与实验实证上的绝对严谨",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "ai_leak_filter",
