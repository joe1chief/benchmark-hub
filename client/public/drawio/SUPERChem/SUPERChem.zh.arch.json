      "type": "decision",
      "size": "xl"
    },
    {
      "id": "incorrect_answer_sink",
      "label": "答题错误与机理推导失误池\n记录选项判断错误、虚构副反应机理及输出解析异常\n细粒度归类动力学控制、热力学平衡或立体化学判断偏差",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "rpf_llm_judge",
      "label": "Gemini 2.5 Pro 专家推导图谱裁判\n将待测模型完整思考链与专家检查点图谱进行语义匹配比对\n基于加权里程碑召回率精确计算推理路径保真度 (RPF)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "superchem_reporting",
      "label": "SUPERChem 全面化学能力评测报告\n输出 Pass@1 准确率、RPF 推理保真度及多模态增益方差\n呈现各化学二级学科能力雷达图并对比人类专家 40.3% 基线",
      "type": "terminal",
      "size": "xl"
    }
