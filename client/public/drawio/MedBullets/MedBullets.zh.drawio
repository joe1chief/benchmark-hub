<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4120" pageHeight="1032" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定位 Medbullets Step 2/3 链接&#xa;来自 X 的公开帖子&#xa;时间为 2022-04 至 2023-12&#xa;模拟临床问题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="独立 JAMA 伴随轨道&#xa;1,524 题 · 13 个领域&#xa;仅提供 URL 与抓取器&#xa;须有 JAMA 全文访问许可&#xa;不发布原始数据且不并入 Medbullets" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="抓取开放访问题目页面&#xa;跟随从 X 收集的链接&#xa;保留源 URL 与文本内容&#xa;抓取器版本未发布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="移除图像并保留文本&#xa;论文未称剔除对应病例&#xa;锁定数据中 116 题仍写有“Figure”&#xa;图像依赖问题仍未解决" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="未披露的构建边界&#xa;未发布 Medbullets 抓取代码&#xa;未给出去重或准入规则&#xa;未报告作者复审协议" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="保留每条来源记录&#xa;病例 + 问题 + 五个选项&#xa;标准答案 + 来源链接&#xa;专家解析覆盖每个选项" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="形成 Medbullets-5&#xa;308 道英文 Step 2/3 题&#xa;解析由医生或其他&#xa;医疗专业人士撰写" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="派生 Medbullets-4&#xa;每题删去一个错误选项&#xa;保留题目、答案及解析&#xa;发布版有 244/308 题重排余下选项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="官方公开数据快照&#xa;仓库 HEAD 013b9447f2a2&#xa;数据提交 d20bfca3cff0&#xa;两种版本各 308 条完整记录" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="发布与版本边界&#xa;仓库及数据均无许可证文件&#xa;论文 v6 晚于 2024 数据提交&#xa;未发布官方评分器代码" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="仅对 Medbullets-5 做事后选项顺序测试&#xa;随机打乱答案选项&#xa;比较原始数据与乱序数据准确率&#xa;仅诊断 · 不移除题目" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="仅对 Medbullets-5 做事后 TS-Guessing 测试&#xa;gpt-4-0613 · Llama-3-70b-chat&#xa;遮盖一个错误选项&#xa;成功率不超过 10% · 不移除题目" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="评测七个指定大模型&#xa;gpt-3.5-turbo-0613 · gpt-4-0613&#xa;chat-bison-001 · Llama-2-70b-chat&#xa;Llama-3-70b-chat · medalpaca-13b&#xa;meerkat-7b-v1.0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="托管 API · 每组结果单次运行&#xa;GPT-3.5/4：T=1 · top-p=1&#xa;PaLM 2：T=.8 · 其余采用默认值" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Llama Chat 模型 · 单次运行&#xa;Llama 2：T=.8 · top-p=.95&#xa;rep=1.1 · 最长 1,024&#xa;Llama 3：T=.85 · top-p=.95" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="医疗模型 · 单次运行&#xa;MedAlpaca：fp16 · 最长 512&#xa;rep=1.1 · beam=2&#xa;Meerkat：fp16 · greedy · 最长 1,024&#xa;T=.7 · rep=1.0" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2600" y="768" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="采用论文中的哪种&#xa;提示策略进行评测？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="直接回答 · X 到 Y&#xa;零样本、二样本或五样本&#xa;少样本随机采用留一法示例&#xa;使用模型专属答案模板" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="两阶段思维链 · X 到 R 到 Y&#xa;零样本先生成推理&#xa;将完整依据输入第二阶段&#xa;再要求选择一个答案" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="标准答案条件解析 · XY* 到 R&#xa;提供正确答案&#xa;解释为何该答案最佳&#xa;以及其余各项为何错误" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="评判答案预测&#xa;将所选字母与标准答案比较&#xa;报告准确率&#xa;官方解析器与无效规则未发布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3000" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="自动评估生成解释&#xa;ROUGE-L · BERTScore · BLEURT&#xa;BARTScore+/++ · CTC 三个维度&#xa;GPT-4o G-Eval · T=1 · 5 Tokens/5 次" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3000" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="未披露的评测边界&#xa;无官方评测代码仓库&#xa;解析器与无效输出规则未发布&#xa;失败样本分母与指标版本未锁定" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="报告答案结果&#xa;四选项与五选项版本准确率&#xa;零样本直接回答 + 思维链&#xa;少样本直接回答曲线" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3560" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="人工评测 · 随机 30 道 Medbullets-5&#xa;GPT-4/PaLM 2 · 每份输出三人评分&#xa;美国医学/医疗领域硕博评审者&#xa;完整性：逐选项勾选&#xa;正确性/相关性：1–5 级量表" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="报告解释结果&#xa;全部输出的自动指标&#xa;人工均值&#xa;完整性 · 正确性 · 相关性&#xa;Bennett S：正确 .60 · 相关 .65" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3560" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="分别发布研究结果&#xa;答案准确率&#xa;自动与人工解释得分&#xa;不计算综合基准总分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3840" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;