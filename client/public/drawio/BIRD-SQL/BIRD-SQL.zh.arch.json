  },
  "nodes": [
    {
      "id": "raw_databases",
      "label": "多领域跨行业关系型数据库\n涵盖 37 个专业领域的 95 个大型数据库 (33.4GB)\n从 Kaggle、Relation.vit 与开放数仓收集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "schema_profiling",
      "label": "数据模式解析与领域知识抽取\n实体关系图 (ER)、字段描述与真实值分布\n提炼回答业务问题必需的外部领域知识线索",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dual_sql_authoring",
      "label": "双专家独立编写 SQL 查询\n数据标注员提出业务问题并标注外部知识证据\n由两名资深工程师背靠背独立编写 SQL 语句",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "execution_match_gate",
      "label": "双执行等价性自动化校验门\n两份独立编写的 SQL 执行结果表是否完全一致？\n在真实关系型数据库引擎中执行验证",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "expert_adjudication",
      "label": "专家仲裁与查询执行效率优化\n仲裁结果不一致并修正自然语言二义性\n挑选计算开销最小且执行效率最高的高效 SQL",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "match_candidate",
      "label": "一致性验证合格样本\n完全一致的问题-外部知识-SQL金标三元组\n保证高精度语义对齐与正确执行行为",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "BIRD-SQL 冻结全量评测基准\n12,751 对高难度跨领域文本转 SQL 样本\n按 69 训练 · 11 开发 · 15 隐藏测试数据库切分",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_assembly",
      "label": "模式规约与知识增强提示装配\n组装 DDL 表结构定义 + 外键依赖 + 领域知识\n附加用户自然语言提问构造完整评估输入",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "模型上下文推理与代码生成\n采用少样本思维链 (CoT) 或专用微调大模型\n生成自包含且语法合法的目标 SQL 查询",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sandbox_execution",
      "label": "安全隔离数据库沙箱执行\n在 SQLite 数据库引擎中运行模型预测查询\n严密捕获语法错误、非法字段引用与超时熔断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "result_accuracy_gate",
      "label": "查询结果集等价性判定门\n预测查询产出的数据表与金标结果完全一致？\n执行行序无关的数据集值级精确比对",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "valid_efficient",
      "label": "执行完全正确与效率度量\n统计查询执行用时并度量相对效率比率\n计算有效效率得分并赋予相应加速奖励",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execution_failure",
      "label": "执行失败与报错分类\n标记语法解析失败、空表输出或数据比对不符\n无效执行判定为零分并记录失败类型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "官方多维评测指标综合报告\n执行准确率 (EX) 与有效准确率 (VA)\n基于执行效率奖励的有效效率得分 (R-VES)",
      "type": "terminal",
      "size": "xl"
    }
  ],
