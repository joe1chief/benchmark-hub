{
  "version": 1,
  "title": "LiveMathBench 数据集构建流程与 G-Pass@k 评测协议",
  "type": "academic-diagram",
  "source": "paper-grounded",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 14,
    "edges": 15,
    "modules": 2
  },
  "nodes": [
    {
      "id": "comp_sources",
      "label": "持续数学竞赛题目接入\n采集 2024 年最新高难度数学竞赛以防止数据污染\n涵盖 CNMO、高考数学 (CCEE)、AMC 10/12 与 WLPMC",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "option_stripping",
      "label": "格式标准化与选项剔除\n将选择题改造为开放式填空解答题\n剔除 A–D 选项以杜绝模型随机盲猜",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "bilingual_curation",
      "label": "双语翻译与 LaTeX 排版规范化\n构建高质量中英双语平行题干\n执行数学公式与符号排版专业统一",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "full_pool",
      "label": "LiveMathBench 完整题库 (v202412)\n119 道原创竞赛题 × 2 种语言 = 238 条记录\n按题目难度与竞赛体系进行细粒度分类",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "difficulty_gate",
      "label": "前沿模型准确率 < 20%？\n在顶尖推理模型 (o1, QwQ) 上进行难度筛选\n将基础竞赛题与极限难题子集分流",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "hard_subset",
      "label": "LiveMathBench-Hard 极限子集\n高难度复杂多跳推理题（英文 21 题，中文 24 题）\n用于深度检验推理模型的复杂解题能力",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "standard_subset",
      "label": "LiveMathBench-Standard 标准题集\n覆盖高中与奥赛层级的均衡题目集\n用于综合评测各量级基础模型的数学能力",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "推理链题目提示词封装\n采用零样本思维链提示并强制以 \\boxed{} 格式输出\n引导模型逐步展开完整推导与计算过程",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sampling_inference",
      "label": "多采样自回归推理生成\n针对每道题目独立采样生成 48 条候选轨迹\n包含温度采样（T=0.7）与贪心解码",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "boxed_parser",
      "label": "符号化答案规则解析\n提取末尾 \\boxed{...} 内的最终数学表达式\n执行 LaTeX 归一化与 SymPy 代数转换",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "math_equivalence_gate",
      "label": "与标准金标在符号上等价？\n利用 SymPy 代数化简零检测进行严格等价比较\n精确判定分数、根号、多项式及代数恒等式",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "trajectory_correct",
      "label": "解题轨迹正确\n判定该轨迹成功解题（得分 = 1）\n输入 Pass@k 组合估计器进行统计",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "trajectory_failure",
      "label": "解题轨迹失败\n计算错误、证明不完整或格式解析失败\n记录为失败样本（得分 = 0）",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "metric_computation",
      "label": "G-Pass@k 与基准指标汇总\nPass@1 贪心准确率与 Pass@k 扩展曲线\nG-Pass@k 与 mG-Pass@16 推理稳定性指标",
      "type": "terminal",
      "size": "xl"
    }
  ],
  "edges": [
    { "from": "comp_sources", "to": "option_stripping", "type": "primary" },
    { "from": "option_stripping", "to": "bilingual_curation", "type": "primary" },
    { "from": "bilingual_curation", "to": "full_pool", "type": "primary" },
    { "from": "full_pool", "to": "difficulty_gate", "type": "primary" },
    { "from": "difficulty_gate", "to": "hard_subset", "type": "primary", "label": "准确率 < 20%" },
    { "from": "difficulty_gate", "to": "standard_subset", "type": "optional", "label": "准确率 >= 20%" },
    { "from": "hard_subset", "to": "prompt_formatting", "type": "primary" },
    { "from": "standard_subset", "to": "prompt_formatting", "type": "primary" },
    { "from": "prompt_formatting", "to": "sampling_inference", "type": "primary" },
    { "from": "sampling_inference", "to": "boxed_parser", "type": "primary" },
    { "from": "boxed_parser", "to": "math_equivalence_gate", "type": "primary" },
    { "from": "math_equivalence_gate", "to": "trajectory_correct", "type": "primary", "label": "符号等价" },
    { "from": "math_equivalence_gate", "to": "trajectory_failure", "type": "optional", "label": "错误/格式异常" },
    { "from": "trajectory_correct", "to": "metric_computation", "type": "primary" },
    { "from": "trajectory_failure", "to": "metric_computation", "type": "primary" }
  ]
}
