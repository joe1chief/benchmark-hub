  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5480" pageHeight="656" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文与固定快照范围&#xa;arXiv:2603.08655v1&#xa;第 2 节 · 附录 B 与 E&#xa;Pro：133 · Full：246&#xa;来源复核于 2026-07-18" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="汇集美国财政部公报&#xa;1939–1982 年按月 · 此后按季&#xa;固定仓库范围：1939–2025 年&#xa;约 89,000 页 · 超过 2,600 万数值&#xa;每期公报 100–200 页" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="保留文档异质性&#xa;文本 · 表格 · 图形 · 图表&#xa;嵌套表头 · 单位 · 脚注 · 修订值&#xa;1996 年起转为原生数字 PDF&#xa;移除内嵌文本层" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="应用三项设计准则&#xa;企业文档复杂性&#xa;检索加多步推理&#xa;单一、无歧义且可核验的答案" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="编写种子问题与答案&#xa;每题落到命题所用 PDF 页面&#xa;要求真实金融分析&#xa;明确财政年与自然年&#xa;明确实际值与名义值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="与 SuperAnnotate、Turing 扩展标注&#xa;提供示例问题&#xa;依据语料生成新题&#xa;拒绝无依据的知识问答&#xa;要求表述无歧义" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="执行 USAFacts 主题复核&#xa;反映真实分析师查询&#xa;检查政府数据相关性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="独立复现答案&#xa;新标注员使用命题所用 PDF 页面&#xa;与原始答案比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="复现答案是否&#xa;与原始答案一致？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="第三位标注员复核&#xa;仅在答案不一致时触发&#xa;解决答案冲突" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行两轮端到端质检&#xa;智能体生成替代答案&#xa;人工检查每个冲突&#xa;分类：智能体失败 · 两者皆可 · 标准答案错误&#xa;消除题目歧义或修正标准答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="移除仅靠参数知识可答的问题&#xa;Claude Opus 4.5 与 GPT-5.1&#xa;不提供语料或外部来源&#xa;保留依赖检索的问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="参数过滤后题池&#xa;保留 246 道问题&#xa;均有来源且可核验" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="两个构建期智能体是否都答对？&#xa;Claude Opus 4.5 与 GPT-5.1&#xa;使用 Databricks 解析文档" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="是：标为 Easy&#xa;113 道问题&#xa;仅进入 Full 伴随集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="否：标为 Pro&#xa;至少一个智能体未答对&#xa;133 道问题 · 核心基准" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="发布两个 CSV 视图&#xa;officeqa_full.csv：246 = 113 Easy + 133 Pro&#xa;officeqa_pro.csv：133 道 Pro&#xa;uid · question · answer&#xa;source_docs · source_files · difficulty&#xa;本页聚焦 Pro" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3520" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="加载 CSV 与语料表示&#xa;需要 Hugging Face 访问审批&#xa;原始 PDF：约 4 GB&#xa;解析 JSON：约 730 MB&#xa;转换 TXT：约 460 MB" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3760" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="选择论文评测设置&#xa;仅提示 · 联网搜索&#xa;预言机 PDF 页面加联网&#xa;预言机解析页面加联网&#xa;全语料智能体：PDF 或解析文本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4000" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="应用论文提示合同&#xa;使用最大计算精度&#xa;在 FINAL_ANSWER 标签内返回数值&#xa;智能体按需使用语料与联网&#xa;除非指定日期或文档&#xa;否则采用最新修订值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=8;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4240" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="论文 v1 确定性指标&#xa;99% 的答案为数值&#xa;精确匹配或绝对相对误差&#xa;0.0% · 0.1%&#xa;1.0% · 5.0%&#xa;默认 0.0% · 格式规范化&#xa;模糊文本匹配" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=8;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4480" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="固定 reward.py 约束&#xa;最后一个 FINAL_ANSWER&#xa;单行直接答案&#xa;最多 250 字符&#xa;数值个数 · 单位兼容&#xa;数值列表 · 上下文年份处理&#xa;论文后实现 · 不反推论文协议" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=8;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4720" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="报告二元正确率&#xa;在所选 split 上取平均&#xa;论文默认报告 OfficeQA Pro&#xa;默认 0.0% 误差阈值&#xa;固定来源未披露官方榜单" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=cent