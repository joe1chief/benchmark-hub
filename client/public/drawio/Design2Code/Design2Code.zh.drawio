    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1624" pageHeight="784" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="C4 验证集链接&#xa;抓取真实世界网页&#xa;内联全部 CSS&#xa;每页一个 HTML 文件" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="初始真实网页池&#xa;127.9k 个 CSS 已内联&#xa;单 HTML 页面&#xa;保留布局与复杂度" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="自动过滤与去重&#xa;移除 &gt;100k GPT-2 Token&#xa;移除仅图像 / 仅文本页&#xa;去重 127.9k&#xa;-&gt; 14k 候选" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="可评测页面&#xa;移除外部依赖&#xa;多媒体内容&#xa;替换为占位符" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="两位作者人工筛选&#xa;共同 200 页 -&gt; 75%&#xa;再拆分随机