  },
  "nodes": [
    {
      "id": "knowledge_taxonomy",
      "label": "五层分级知识概念体系\n包含 99 个知识节点与 67 个叶子数学概念\n横跨算术、代数、几何、统计与离散逻辑五大知识领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "raw_visual_problems",
      "label": "多模态视觉数学题目采集\n来源于权威竞赛试题库、中高考试卷及数学教辅教材\n汇总搜集 6,524 道候选几何与算术多模态选择题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eligibility_gate",
      "label": "图文一致性与必要性门控？\n验证标准答案无歧义且题目推理必须高度依赖配图信息\n严格筛除无需看图即可通过文本常识破解的伪多模态题目",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_discard",
      "label": "图文脱节/纯文本可解题剔除\n剔除多解题、配图信息冗余或无需视觉感知的瑕疵题\n确保评测基准具备不可替代的真实视觉推理挑战性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "expert_concept_annotation",
      "label": "三专家独立知识概念标注\n三位专业数学研究员对题目涉及的核心考点概念进行独立归类\n编写标准规范解题步骤并统计完成推理所需的最少步数",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "consensus_gate",
      "label": "至少两位专家达成标注共识？\n要求在知识概念归属与难度级别上取得多数一致 (>= 2/3)\n存在分歧项交由专家仲裁委员会交叉复审并裁定",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "subproblem_decomposition",
      "label": "子问题模块化解耦分解\n将复杂的复合多步问题拆解为单概念对应的基础子问题序列\n实现对模型特定知识掌握与综合概括能力的解耦诊断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "testmini_freeze",
      "label": "We-Math 官方 Testmini 核心集\n冻结 1,740 道核心评测题并配套 67 张标准知识概念卡片\n分层覆盖 1,215 道一步题、360 道二步题及 165 道三步题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "multimodal_prompting",
      "label": "标准化多模态题目呈现\n将高分辨率几何图表与题干问题及选择题选项配对输入\n要求模型分别作答整体复合原题及其对应解耦子问题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "lmm_inference",
      "label": "多模态大模型自回归推理\n主流视觉基座大模型进行零样本多模态链路推演\n采用贪婪解码策略 (T=0) 输出分步推理过程与最终选项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "regex_extraction",
      "label": "选项正则抽取与格式校验\n从模型生成文本中精确提取选项标识 [A-E]\n将非结构化回答规范映射为标准符号键并校验格式有效性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "correctness_gate",
      "label": "复合题与子问题联合判定？\n判定联合二元组：(子问题正确性向量, 复合题正确性状态)\n探究模型在原子概念掌握与多概念融合推理间的本质差异",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "diagnostic_classification",
      "label": "四维认知推理状态分类\nIK (知识匮乏) · IG (泛化不足/无法综合)\nCM (完全掌握) · RM (机械死记/猜中无据)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "error_sink",
      "label": "诊断失效与错误归因池\n量化模型死记硬背幻觉与跨概念复合推理的泛化瓶颈\n按代数、几何等不同数学领域细分错误成因分布",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "score_formulation",
      "label": "认知诊断加权得分计算\n加权综合评估得分：Score = alpha*IK + beta*IG + CM\n采用论文默认权重 alpha=0、beta=0.5（奖励部分泛化能力）",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics_reporting",
      "label": "We-Math 官方指标发布\n公布四维比例指标（IK、IG、CM、RM 各自占比）\n及横跨五层知识架构、67 个核心考点的模型认知综合能力分布",
      "type": "terminal",
      "size": "xl"
    }
  ],
