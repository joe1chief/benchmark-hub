    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1824" pageHeight="992" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="真实 Python 库&#xa;GitHub 开源仓库&#xa;模块化项目 + 原生 pytest" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="仓库筛选标准&#xa;300-120,000 行 + 至少 10 星&#xa;pytest + 三年内创建 / 更新" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="264" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="人工克隆与测试门&#xa;检查结构和依赖&#xa;仅保留原生测试全通过仓库" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="584" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="AST API 清单&#xa;类 / 函数 / 常量&#xa;签名 + 源码位置；排除测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="904" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="标注者行为审查&#xa;输入 / 输出 / 约束&#xa;导入路径与被测试语义" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#19