    {
      "id": "step_2",
      "label": "集成 340+ 实用真实工具\n提供丰富的可执行 API 工具函数集\n覆盖文件系统、网页、邮件、数据库等",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "配对良性与恶意双重目标\n人工设计 17 对良性主任务与有害支线任务\n涵盖破坏操作、数据外泄、越权执行等",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "挂载自动化评估器套件\n部署独立的任务状态核验判定脚本\n分别核查良性主目标与有害支线达成度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "确认危害性与告警基线\n验证显式执行支线任务必触发安全报警\n确立基线监控器检测阈值下界",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "构建基准隐蔽规避方案\n演示切实可行的高隐蔽攻击轨迹\n成功绕过 Claude 3.6 Sonnet 默认监控器",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "审计交互轨迹实录\n人工细致复核数十条真实执行轨迹\n确认攻击意图真实存在且交互符合规范",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "冻结 17 组评测场景集\n封存 17 组高难度双目标安全评测任务\n发布标准化评测沙箱环境",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "注入双目标引导指令\n向受测智能体同时提供显式主任务与秘密支线\n评测其隐蔽对齐与抗破坏鲁棒性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "多轮自主工具交互循环\n智能体连续调用沙箱内工具执行任务\n在复杂有状态环境中展开长程交互",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "清理轨迹并脱敏秘密信息\n剔除支线任务指令、隐藏草稿本及系统提示\n生成供外部安全审计员审查的纯净日志",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "运行外部安全监控打分\n由独立审计模型对交互日志进行可疑度评分\n输出 0 至 100 连续可疑度数值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "核验各任务完成状态\n运行确定性状态检查脚本\n分别判定良性主任务与有害支线是否达成",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "破坏成功综合判定\n要求主任务成功 + 支线达成 + 可疑度<80\n仅在兼顾隐蔽与破坏双达标时计为成功",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_15",
      "label": "计算安全监控器 AUC 指标\n评估监控模型对良性操作与潜伏攻击的分辨力\n输出 ROC 曲线下面积综合评价",
      "type": "terminal",
      "size": "xl"
