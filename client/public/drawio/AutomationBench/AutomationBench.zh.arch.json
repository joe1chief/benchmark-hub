    {
      "id": "workflow_patterns",
      "label": "收集工作流形态\n来自困难工作流的用户反馈\n不使用个人信息或客户机密",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "cluster_shapes",
      "label": "聚类工作流形态\n归并收集到的工作流模式\n论文未披露具体聚类算法",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "assign_domains",
      "label": "选取六个预定义领域的相关模式\n销售、营销、运营\n支持、财务、人力资源",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "task_generation",
      "label": "合成候选任务\n工作流模式提供合成灵感\n多轮修订真实性与应用多样性",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "task_contract",
      "label": "设计任务与断言契约\n单条指令与结构化业务状态\n明确策略和确定性检查",
      "type": "document",
      "module": "construction"
    },
    {
      "id": "api_world",
      "label": "提供模拟 API 世界\n论文 v1 记载约 500 个端点\n47 个应用；Pydantic 保存世界状态",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "hardening",
      "label": "加固过易任务\n加入干扰项与相似记录名称\n信息需经工具获取，并遵守策略优先级",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "hint_audit",
      "label": "准备并审计提示清单\n给出端点指引与参数线索\n不包含实际参数值",
      "type": "document",
      "module": "construction"
    },
    {
      "id": "validation",
      "label": "检查可解性并抽样审阅\n使用独立的带提示运行模式\n抽样检查与重复审计",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "reward_audit",
      "label": "用 RLVR 对奖励做压力测试\n发现奖励攻击策略\n反馈加固断言与奖励设计",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "revision",
      "label": "应用版本化公平性修订\n1.0.6：可发现性、格式与副作用要求\n私有任务难度也随版本调整",
      "type": "document",
      "module": "construction"
    },
    {
      "id": "release",
      "label": "发布 600 个公开计分任务\n六个业务领域各 100 个任务\n仓库 1.0.6；默认 domains=all",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "private_tasks",
      "label": "保留更难的私有任务\n论文 v1 为 600+；任务未公开\n未从公开仓库核实当前私有规模",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "simple_tasks",
      "label": "提供 200 个 simple 基线任务\n基础的一步与两步工作流\n默认 domains=all 不包含此集合",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "initialize",
      "label": "初始化每个选定任务\n由 initial_state 创建新的 WorldState\n保留指令与任务契约身份",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "tool_mode",
      "label": "选择并记录工具接口\napi（CLI 默认）、zapier、limited_zapier\n受限模式仅暴露任务指定动作",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "agent_run",
      "label": "获取 Agent 的下一次响应\n按单条指令自主完成工作流\nCLI 默认最多 50 次模型响应",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "turn_gate",
      "label": "继续调用工具还是结束轨迹？\n在轮次预算内处理工具请求\n停止运行不代表任务成功",
      "type": "decision",
      "module": "evaluation"
    },
    {
      "id": "search_tools",
      "label": "按请求发现工具\napi_search：BM25，默认 top_k=5\nZapier 模式检索动作描述",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "execute_tools",
      "label": "执行请求的工具调用\nREST 请求或 Zapier 动作\n返回模拟 API 的观察结果",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "end_state",
      "label": "检查最终业务状态\n执行正向与负向断言\n同时检查哪些条件在初态已经通过",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "score_scope",
      "label": "确定有效计分断言\n显式排除项不计分\n保持初态已满足条件不获得免费分数\n破坏守卫条件计失败；excluded:false 可强制计分",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "assertion_ratio",
      "label": "计算 partial_credit\n通过数 ÷ 有效计分断言数；分母为零则为 0\n作为环境奖励，权重为 1",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "official_score",
      "label": "计算严格全有或全无通过分数\n仅 partial_credit = 1 时 task_completed_correctly = 1\n有效计分断言全部通过，且至少存在一项",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "partial_note",
      "label": "单独保留部分得分奖励\n仅用于训练与诊断\n不把 partial_credit 均值当作任务通过率",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "completion_gate",
      "label": "检查导出结果中的中断轨迹\n末尾工具调用未执行，响应步数小于上限减 2\n默认启用 ensure-complete；最多补跑 3 轮\n禁用或使用 tasks/skip 切片时跳过",
      "type": "decision",
      "module": "evaluation"
    },
    {
      "id": "rerun_aborted",
      "label": "仅重新运行中断任务并合并\n沿用模型与工具集；按任务名合并\n未传递自定义 search_top_k\n保留已完成任务并再次检查",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "incomplete_result",
      "label": "保留并标记仍中断的结果\n有限补跑不保证全部完成\n仅看 auto-bench 退出码不能证明完整性",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "split_gate",
      "label": "按选定数据集合分别报告\n六个公开计分域或 simple 基线\n记录版本、模型、工具集与完整性状态",
      "type": "decision",
      "module": "evaluation"
    },
    {
      "id": "run_cost",
      "label": "从运行中收集用量与成本\n模型 token 用量与配置的价格\n另行报告每任务平均美元成本",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "report",
      "label": "报告公开任务通过率\n对选定公开任务的 task_completed_correctly 求均值\n未切片的六域完整运行共 600 个任务",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "simple_report",
      "label": "报告 simple 运行框架诊断\n仅针对显式选定的 simple 任务\n不计入官方基准分数",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "private_report",
      "label": "查看官方私有集排行榜\n独立留出评测，难度随版本变化\n不可直接用公开集结果替代",
      "type": "terminal",
      "module": "evaluation"
    }
  ],
