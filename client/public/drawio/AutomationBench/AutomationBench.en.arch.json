    {
      "id": "workflow_patterns",
      "label": "Collect Workflow Shapes\nDifficult workflows from user feedback\nNo PII or confidential customer data",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "cluster_shapes",
      "label": "Cluster Workflow Shapes\nGroup the collected patterns\nClustering algorithm is not disclosed",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "assign_domains",
      "label": "Select for Six Predefined Domains\nSales, marketing, operations\nSupport, finance, HR",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "task_generation",
      "label": "Synthesize Candidate Tasks\nWorkflow patterns provide inspiration\nRevise realism and app variety",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "task_contract",
      "label": "Design Task and Assertion Contracts\nSingle instruction and structured state\nPolicies and deterministic checks",
      "type": "document",
      "module": "construction"
    },
    {
      "id": "api_world",
      "label": "Provide Simulated API Worlds\nAbout 500 endpoints in paper v1\n47 apps; Pydantic world state",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "hardening",
      "label": "Harden Tasks That Are Too Easy\nDistractors and similar record names\nTool-accessed information and policy priorities",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "hint_audit",
      "label": "Prepare and Audit Hint Sheets\nEndpoint guidance and parameter clues\nNo actual parameter values",
      "type": "document",
      "module": "construction"
    },
    {
      "id": "validation",
      "label": "Check Solvability and Sample Tasks\nSeparate hinted runtime mode\nSample inspection and repeated audits",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "reward_audit",
      "label": "Pressure-Test Rewards with RLVR\nFind reward-hacking strategies\nStrengthen assertion and reward design",
      "type": "process",
      "module": "construction"
    },
    {
      "id": "revision",
      "label": "Apply Versioned Fairness Revisions\nv1.0.6: discovery, formatting, side effects\nPrivate task difficulty also revised",
      "type": "document",
      "module": "construction"
    },
    {
      "id": "release",
      "label": "Publish 600 Scored Public Tasks\n100 tasks in each of six domains\nRepository 1.0.6; default domains=all",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "private_tasks",
      "label": "Hold Out Harder Private Tasks\nPaper v1: 600+; not publicly released\nCurrent private size is not verified",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "simple_tasks",
      "label": "Provide 200 Simple Baseline Tasks\nFoundational one- and two-step workflows\nExcluded from default domains=all",
      "type": "database",
      "module": "construction"
    },
    {
      "id": "initialize",
      "label": "Initialize Each Selected Task\nFresh WorldState from initial_state\nKeep prompt and task-contract identity",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "tool_mode",
      "label": "Select and Record the Tool Interface\napi (CLI default), zapier, limited_zapier\nLimited mode exposes task-specific actions",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "agent_run",
      "label": "Obtain the Next Agent Response\nSingle-instruction autonomous workflow\nCLI default cap: 50 model responses",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "turn_gate",
      "label": "Continue Tool Use or End the Rollout?\nTool requests within the turn budget\nStopping is not proof of task success",
      "type": "decision",
      "module": "evaluation"
    },
    {
      "id": "search_tools",
      "label": "Discover Tools When Requested\napi_search: BM25, default top_k=5\nZapier mode searches action schemas",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "execute_tools",
      "label": "Execute Requested Tool Calls\nREST requests or Zapier actions\nReturn simulated API observations",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "end_state",
      "label": "Inspect Final Business State\nRun positive and negative assertions\nAlso check which conditions passed initially",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "score_scope",
      "label": "Resolve Effective Scored Assertions\nExplicit exclusions do not count\nPreserved free checks earn no credit\nBroken guards fail; excluded:false can force scoring",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "assertion_ratio",
      "label": "Compute partial_credit\nPassed / scored assertions; zero denominator gives 0\nEnvironment reward, weight 1",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "official_score",
      "label": "Compute Strict All-or-Nothing Pass\ntask_completed_correctly = 1 iff partial_credit = 1\nEvery scored assertion passes; at least one is scored",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "partial_note",
      "label": "Keep Fractional Reward Separately\nTraining and diagnostic only\nDo not average partial_credit as the pass rate",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "completion_gate",
      "label": "Check Aborted Rollouts in Exported Results\nDangling tool-call ending; steps below cap minus 2\nDefault ensure-complete; up to 3 rerun rounds\nSkipped when disabled or tasks/skip slices are used",
      "type": "decision",
      "module": "evaluation"
    },
    {
      "id": "rerun_aborted",
      "label": "Rerun Only Aborted Tasks and Merge\nReuse model and toolset; merge by task name\nCustom search_top_k is not forwarded\nKeep completed tasks and repeat the check",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "incomplete_result",
      "label": "Retain and Flag Remaining Aborts\nBounded reruns do not guarantee completion\nMain auto-bench exit status alone is insufficient",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "split_gate",
      "label": "Report the Selected Dataset Separately\nSix scored public domains or simple baseline\nRecord version, model, toolset, and completion status",
      "type": "decision",
      "module": "evaluation"
    },
    {
      "id": "run_cost",
      "label": "Collect Usage and Cost from the Run\nModel token usage and configured prices\nReport mean USD cost per task separately",
      "type": "process",
      "module": "evaluation"
    },
    {
      "id": "report",
      "label": "Report Public Task Pass Rate\nMean task_completed_correctly over selected public tasks\n600 tasks for an unsliced six-domain run",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "simple_report",
      "label": "Report Simple Harness Diagnostics\nExplicitly selected simple tasks only\nExcluded from the official benchmark score",
      "type": "terminal",
      "module": "evaluation"
    },
    {
      "id": "private_report",
      "label": "Read the Official Private-Set Leaderboard\nSeparate held-out evaluation and versioned difficulty\nPublic results are not directly interchangeable",
      "type": "terminal",
      "module": "evaluation"
    }
  ],
