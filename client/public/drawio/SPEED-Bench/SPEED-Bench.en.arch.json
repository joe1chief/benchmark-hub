      "size": "xl"
    },
    {
      "id": "category_classification",
      "label": "Category Classification & Tagging\nClassify Prompts into 11 Semantic Domains\nCode · Math · Multi-Turn · Reasoning · Chat",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "split_curation_gate",
      "label": "Benchmark Split Decision Gate\nSelect Diverse Qualitative Prompts (880)\nor Synthesize Serving Workloads (1k-32k)?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "qualitative_pipeline",
      "label": "Embedding Diversity Selection\ntext-embedding-3-large & Greedy Min-Similarity\n80 Diverse Prompts per Category (880 Total)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "throughput_pipeline",
      "label": "Length & Entropy Bucketing\n5 Length Buckets (1k, 2k, 8k, 16k, 32k)\n3 Entropy Groups x 512 Prompts per Bucket",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "SPEED-Bench Dual Benchmark Release\n880 Semantically Diverse Qualitative Tasks\n7,680 Realistic Serving Throughput Workloads",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "offline_tokenization",
      "label": "Offline Tokenizer Normalization\nStandardize Prompts Outside Inference Engine\nEliminates Client-Side Tokenization Bottlenecks",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "spec_verification_gate",
      "label": "Speculative Token Verification Gate\nDraft Tokens Accepted by Target Model Verifier?\nCompare Candidate Logits in Target Sandbox",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "accept_branch",
      "label": "Draft Acceptance Fast-Path\nTarget Verifier Confirms Draft Tokens\nAdvance Context Window by Accepted Length",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rollback_branch",
      "label": "Draft Rejection & Resampling Path\nTarget Model Corrects Mismatched Token\nRoll Back Speculative State & Resample from Target",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "token_telemetry",
      "label": "Token Acceptance & Rollback Telemetry\nCompute Accepted Length (AL) & Rollback Steps\nDispatches Concurrent Requests up to 512",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "Speculative Serving Metric Reporting\nAcceptance Rate · Output TPS · User TPS\nStandardized Speedup across SGLang & vLLM",
      "type": "terminal",
      "size": "xl"
    }
  ],
