  "nodes": [
    {
      "id": "scholar_corpus_server",
      "label": "Ai2 学术语料库检索服务 (ASC)\n全面收录海量自然科学文献全文与引用元数据索引\n提供学术论文全文检索、摘要抽取及引文图谱多跳遍历 API",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "query_taxonomy_branch",
      "label": "科学问答任务类型分流？\n论文全文内容理解问答 vs 学术引文图谱推理问答\n分流至具体文献内容抽取或宏观学术拓扑网络推理",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "citation_template_gen",
      "label": "GPT-5 引文图谱问题合成\n编写少样本模板考查会议期刊、学者合作与文献共被引关系\n使用真实学术实体实例化图谱多跳检索与拓扑推理模式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "content_qa_formulation",
      "label": "GPT-5 论文内容问答构建\n智能体调用学术语料服务器检索前沿科研文献\n严格基于检索到的论文段落与实验数据提炼针对性科学问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "solvability_verification_gate",
      "label": "工具必要性与可解性校验？\n验证问题必须通过真实学术检索工具方能得出确定性答案\n剔除答案存在争议、概念幻觉或无需工具即可记忆检索的题目",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "unsolvable_query_discard",
      "label": "无解或证据模糊问题剔除池\n过滤证据不足、引文关系悬空或题意歧义的问题\n确保所有入选科学问答均具备确凿的文献客观依据",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "corpus_query_merge",
      "label": "统一科学问答语料聚合\n汇总论文内容理解题与引文图谱推理题两类科学任务\n统一标准化工具调用协议模式与学术检索环境接口规范",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "seed_data_freeze",
      "label": "ScienceQA 科学问答种子集\n结构化固化经严格过滤的高质量科研检索问答题集\n作为多步工具调用智能体执行轨迹生成的标准任务输入",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "agent_execution_engine",
      "label": "GPT-4.1-mini 智能体工具交互执行\n智能体自主发起文献检索、摘要调取及引用溯源调用\n在学术服务器动态环境中完成多轮交互式科学探索解题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "live_environment_response",
      "label": "学术语料服务器真实环境响应记录\n完整记录真实 API 返回的学术原文、状态码与执行时延\n严禁使用合成模拟或虚构大模型伪造的环境返回结果",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "trajectory_validity_gate",
      "label": "工具调用序列与最终答案核验？\n核验工具调用参数规范性、解析合规性及最终答案正确性\n验证从初始检索到定位证据及得出结论的完整逻辑链条",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "failed_trajectory_discard",
      "label": "调用失败与推理错误轨迹丢弃池\n剔除 API 超时、虚构参数、逻辑中断及答案错误的轨迹\n阻断异常或含幻觉的工具交互数据进入下游流程",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "trajectory_distillation",
      "label": "黄金工具轨迹抽取与指令封装\n抽取分步思考-行动-观察 (Reason-Action-Observation) 轨迹\n将多轮学术检索交互格式化为标准 SFT 监督微调指令数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dolci_sft_integration",
      "label": "Dolci Instruct SFT 训练集整合\n将高质量科学工具轨迹注入 Olmo 3 后训练微调数据集\n全面赋予模型自主检索科学文献与多跳引文推理的核心能力",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "capability_evaluation_gate",
      "label": "下游模型科学工具调用能力达标？\n在独立科研检索任务集上评测微调后 Olmo 3 模型的表现\n核验工具调用格式依从率与科研问答推理准确度",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "scienceqa_profile_reporting",
      "label": "ScienceQA 数据集与模型科研能力画像\n汇总报告科学工具轨迹质检采纳率、交互步长分布统计\n以及微调模型在跨学科文献检索与多跳推理上的综合表现",
      "type": "terminal",
      "size": "xl"
    }
  ],
