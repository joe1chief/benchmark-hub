      "type": "process",
      "size": "large"
    },
    {
      "id": "verbalize",
      "label": "大语言模型自然对话表达\n将结构化规划诉求转写为自然语言提示词\n模拟真实用户复杂且口语化的提问方式",
      "type": "process",
      "size": "large"
    },
    {
