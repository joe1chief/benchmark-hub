      "id": "manual",
      "label": "人工整理来源：1,039对问答\n原创问题 • 大学考试\n习题与题库",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "programmatic",
      "label": "半自动来源：1,749对问答\n筛选后的化学数据库 + 程序生成变体\n包含化学偏好与直觉任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "schema",
      "label": "通过GitHub拉取请求提交问题\n采用BIG-bench风格标准结构\n编码分子、方程、单位和答案类型",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "canary",
      "label": "加入BIG-bench金丝雀字符串\n要求模型开发者从训练数据中过滤\n降低基准污染风险",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "合并前质量门禁\n原整理者 + 至少两名科学家\n自动化标准结构检查",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "labels",
      "label": "为每题标注属性\n化学主题 • 所需技能 • 难度\n知识 • 推理 • 计算 • 直觉",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "corpus",
      "label": "发布完整ChemBench语料\n共2,788对问答\n2,544道选择题 + 244道开放题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "mini",
      "label": "整理ChemBench-Mini：236题\n保留全部高级题并限制主题/技能组合数量\n平衡主题与技能用于日常评测",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "system",
      "label": "评测模型或工具增强系统\n接受任何能返回文本的系统\n使用完整集或ChemBench-Mini",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "应用模型适配提示模板\n区分补全模型与指令模型格式\n规范SMILES、LaTeX、方程和单位",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "确定性生成\n贪心解码 • 温度0\n请求结构化答案与1–5级置信度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "稳健多阶段解析\n提取答案标签、选项字母和数值\n正则完成文字转数字；失败时用LLM兜底",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "ChemBench-Mini人类基线\n通过网页调查19名化学专家\n部分条件允许网页搜索等工具",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "评估正确性与置信度\n比较模型、智能体和化学家\n发布主题/技能明细与排行榜",
      "type": "terminal",
      "size": "xl"
    }
  ],
