<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3224" pageHeight="536" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="人工整理：1,039 道问答&#xa;大学考试 • 习题讲义 • 教材&#xa;URL • IChO • 课程 • 全新问题" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="半程序化生成：1,749 道问答&#xa;整理后的化学数据 + 程序化变体&#xa;反应性 • 结构 • 安全 • 化学偏好" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="通过 GitHub Pull Request 提交&#xa;扩展 BIG-bench Schema&#xa;语义标记：分子 • 方程 • 单位" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="加入 BIG-bench 金丝雀字符串&#xa;要求开发者过滤训练数据&#xa;降低基准污染风险" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="合并前质量门&#xa;原整理者之外至少两名科学家复核&#xa;自动检查 Schema / LaTeX / 格式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="人工标注每道题&#xa;化学主题 • 所需技能 • 难度&#xa;知识 • 推理 • 计算 • 直觉" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="完整 ChemBench 语料&#xa;共 2,788 道问答&#xa;2,544 道选择题 + 244 道开放题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="ChemBench-Mini：236 题&#xa;保留全部高级题&#xa;每个“知识/推理 × 主题”组合最多 3 题&#xa;排除直觉题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="选择待评系统&#xa;任何返回文本的系统&#xa;模型或工具增强系统&#xa;使用完整语料或 Mini" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="模型适配提示&#xa;补全式与指令式格式&#xa;适配 SMILES • LaTeX • 方程 • 单位" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="贪心解码 • 温度 0&#xa;答案提示：结构化 [ANSWER] 输出&#xa;独立置信度提示：仅输出 1–5" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="多阶段答案解析&#xa;[ANSWER] 标签 • 选项字母 • 数值&#xa;科学计数法 + 单词转数字正则&#xa;规则失败时使用 LLM 回退" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="口头置信度&#xa;独立给出 1–5 分&#xa;不返回问题答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="人类基线：19 位化学专家&#xa;作答全部 236 道 Mini 题 • 不可跳题&#xa;工具 / 无工具子集&#xa;禁止使用其他 LLM 或向他人求助" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="352" width="