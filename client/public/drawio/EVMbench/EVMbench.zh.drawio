, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1400" y="384" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="隔离的 Ubuntu 24.04&#xa;Docker 任务容器 · 禁网&#xa;仓库 · 范围 · 已知问题 · 赞助方提示&#xa;评分使用独立且不可访问的容器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1664" y="384" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="选择基准模式&#xa;Detect · Patch · Exploit" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1920" y="384" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Detect 智能体&#xa;检查限定范围的仓库&#xa;提交审计报告" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Detect 裁判：未版本化 gpt-5 别名&#xa;推理强度 high · 快照未固定&#xa;匹配每个标准漏洞&#xa;召回率；误报不惩罚" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Detect 金融奖励&#xa;命中漏洞：历史审计奖励中位数&#xa;缺失 / 邀请赛 + Tempo = $0&#xa;输出：detect_award · detect_max_award&#xa;award_rate_metric = Σ 奖励 / Σ 最大奖励" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpac