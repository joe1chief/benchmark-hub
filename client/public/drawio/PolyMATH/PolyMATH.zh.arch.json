    { "from": "gpt4o_draft", "to": "human_postedit", "type": "primary" },
    { "from": "glossary_calibration", "to": "human_postedit", "type": "primary" },
    { "from": "human_postedit", "to": "dataset_release", "type": "primary" },
    { "from": "dataset_release", "to": "native_prompting", "type": "primary" },
    { "from": "native_prompting", "to": "multilingual_inference", "type": "primary" },
    { "from": "multilingual_inference", "to": "boxed_extraction", "type": "primary" },
    { "from": "boxed_extraction", "to": "verification_gate", "type": "primary" },
    { "from": "verification_gate", "to": "lang_correct_sink", "type": "primary", "label": "答案精确匹配" },
    { "from": "verification_gate", "to": "lang_error_sink", "type": "optional", "label": "答案错误/不完整" },
