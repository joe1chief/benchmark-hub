  "nodes": [
    {
      "id": "seed_sourcing",
      "label": "500 道英文种子题目采集\n源自高难度竞赛题与权威数学基准\n跨度覆盖小学初等数学至国际奥林匹克数学",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "difficulty_framework",
      "label": "二维题目难度评估框架\n解构为思维深度与知识广度两个核心维度\n精细划分为 4 个难度等级（各等级 125 题）",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "phd_tagging",
      "label": "博士专业标注与分类\n由理工科博士研究员打上初版难度标签\n撰写规范严谨的逐步推导与解答证明",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "consensus_gate",
      "label": "经至少 2 名其他专家一致确认？\n执行三盲交叉评审确保难度准确与无逻辑缺陷\n协商解决分歧并对争议题目重新定级",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "english_base",
      "label": "高质量英文核心题库冻结\n500 道带标准 Boxed 答案的清晰题目\n作为多语言平行扩展的高精度母本",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "gpt4o_draft",
      "label": "GPT-4o 多语言初译生成\n将英文核心母本翻译为 17 种不同目标语言\n严格保留 Markdown 格式与 MathJax 分隔符",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "glossary_calibration",
      "label": "专业术语库与公式校准\n数学专家提取数学核心术语列表并规范译名\n防止 LaTeX 数学公式被分词器破坏或误译",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_postedit",
      "label": "母语译员人工译后精校\n专业翻译人员全面复核 17 种语言译文\n确保专业数学语境流畅且语义严格对齐",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "dataset_release",
      "label": "PolyMATH 冻结基准集发布\n18 种语言 × 500 道题 = 9,000 条平行记录\n打包为 72 个标准格式评测文件",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "native_prompting",
      "label": "母语奥赛推理提示词封装\n采用目标语言零样本思维链提示词输入\n规范模型输出符合 \\boxed{} 标准答案标记",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "multilingual_inference",
      "label": "多语言自回归推理评测\n在主流前沿模型与多语言模型上进行贪心解码\n全面测试跨语言数学泛化与推理稳定性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "boxed_extraction",
      "label": "Boxed 答案抽取与归一化\n正则表达式解析器提取最终目标标记\n结合 SymPy 进行代数化简与精确等价判定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "verification_gate",
      "label": "在目标语言下判定等价？\n将候选模型解答与目标语言参考答案进行比较\n判定该语言下的解题正确性",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "lang_correct_sink",
      "label": "语言答对解题分支\n记录该语言特定题目解题成功\n计入对应语言的各难度准确率分桶",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "lang_error_sink",
      "label": "翻译失真/推理崩溃分支\n译文歧义、语言推理崩溃或数值计算失误\n揭示跨语言数学推理性能衰减瓶颈",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "multilingual_metrics",
      "label": "PolyMATH 综合指标汇总\n各语言准确率与难度加权准确率评分\n跨语言一致性差距 (英语 vs 非英语模型差距)",
      "type": "terminal",
      "size": "xl"
    }
  ],
