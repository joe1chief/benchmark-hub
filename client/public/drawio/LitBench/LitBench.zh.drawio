    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2448" pageHeight="1176" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据 · EACL 2026 正式版&#xa;2026.eacl-long.362 · Git c1017dbe&#xa;A.9 · 有效 batch128 · LR1e-5&#xa;warmup10% · bfloat16 · AdamW&#xa;Git GenRM · 2e-5 · 3 epochs · max8192&#xa;Git 脚本 ≠ 论文配置" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-72" y="-24" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="r/WritingPrompts 语料源&#xa;共享提示下的人类故事&#xa;赞数 · 评论 · 时间戳&#xa;赞数只是有噪声的偏好代理" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-72" y="264" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="留出测试候选&#xa;用 PRAW 搜索 Fan 等来源帖&#xa;每个来源帖取前 100 项结果&#xa;得到 5,000+ 个提示帖 ID&#xa;剔除 2023 年前故事" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="248" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="训练候选&#xa;euclaise/WritingPrompts_preferences&#xa;来源 HF 6f0b721 · MIT&#xa;故事严格早于 2023 年" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="248" y="336" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="故事级质检 · 测试&#xa;赞数至少为 10&#xa;删除非故事评论&#xa;不少于 50 词 · 至多 2,048 token" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="568" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="故事级质检 · 训练&#xa;赞数至少为 10&#xa;删除非故事评论&#xa;不少于 50 词 · 至多 2,048 token" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="568" y="336" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="同提示测试配对&#xa;赞数更高者作为 chosen&#xa;赞数差至少为 chosen 的 25%&#xa;chosen 必须发布时间更晚" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="888" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="同提示训练配对&#xa;赞数更高者作为 chosen&#xa;赞数差至少为 chosen 的 25%&#xa;chosen 必须发布时间更晚" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="888" y="336" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="测试配对长度去偏&#xa;按 chosen−rejected 建 100 桶直方图&#xa;剪枝至对称分布&#xa;平衡 chosen 更长 / 更短" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1208" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="训练配对长度去偏&#xa;按 chosen−rejected 建 100 桶直方图&#xa;剪枝至对称分布&#xa;平衡 chosen 更长 / 更短" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1208" y="336" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="论文测试基准&#xa;2,480 个成对比较&#xa;3,543 篇唯一故事&#xa;平均每篇 550 词" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1528" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="论文训练语料&#xa;43,827 个偏好对&#xa;50,309 篇唯一故事&#xa;与测试集独立整理" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1528" y="336" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="零样本 LLM 裁判&#xa;输入无标签故事 A / B&#xa;先解释再输出 A/B&#xa;两种故事顺序都评测&#xa;对成对准确率取平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1848" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Bradley-Terry 奖励模型&#xa;用 43,827 对训练&#xa;分别给两篇故事打分&#xa;最小化 chosen−rejected 奖励&#xa;的负对数 sigmoid" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1848" y="336" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="生成式奖励模型&#xa;SFT 直接 A/B 或 GPT-4.1 理由 + 结论&#xa;测试时随机交换 A/B&#xa;温度 0 · 单次采样&#xa;使用交叉熵训练" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1848" y="664" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="成对准确率 + 论文结论&#xa;正确偏好数 ÷ 有效样本数&#xa;零样本结果平均两种故事顺序&#xa;Claude 3.7 Sonnet · 73%&#xa;最佳 BT / GenRM · 约 78%&#xa;GenRM-CoT · 72%" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2168" y="336" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="新故事奖励模型排序&#xa;64 篇故事 · 40 个 LitBench 提示&#xa;由 GPT-4.1 + GPT-4o 生成&#xa;Llama-8B BT 排序新故事&#xa;每个提示选 RM 最佳 / 最差故事" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1528" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="在线人工实验&#xa;46 名英美 Prolific 工作者&#xa;每对 10–13 名评分者&#xa;选择 RM 偏好者 · 56.4% vs 43.6%" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Ari