  "nodes": [
    {
      "id": "source",
      "label": "从 r/WritingPrompts 出发\n同一写作提示下有多篇故事\n以 Reddit 赞数作为偏好信号\n保留故事、提示与发布时间元数据",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "test_raw",
      "label": "收集留出测试基准\n使用 PRAW 查询 Reddit\n对 5,000+ 提示 ID 搜索前 100 项\n仅保留 2023-01-02 之后的故事",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "train_raw",
      "label": "引入训练语料\n使用 MIT 许可的 WritingPrompts 偏好集\n选取 2023 年前发布的故事\n与留出测试集严格分离",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "story_filter",
      "label": "在两份数据上分别过滤故事\n要求至少 10 个赞\n词数不少于 50 且不超过 2,048 token\n去除低信号或过长样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pairs",
      "label": "在同一提示内组成故事对\n比较对同一提示的两篇回答\n将赞数更高者标为偏好故事\n保留配对相关元数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "preference_filter",
      "label": "增强偏好信号可靠性\n要求赞数差至少达到 25%\n偏好故事必须发布时间更晚\n降低边缘差异与曝光时长偏差",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_debias",
      "label": "消除故事长度差偏差\n构建 100 桶长度差直方图\n剪枝至近似对称分布\n平衡偏好故事更长与更短的比例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 LitBench 数据资源\n测试集 · 2,480 对 / 3,543 篇故事\n训练集 · 43,827 对 / 50,309 篇故事\n两份数据分别执行同一套筛选流程",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "judges",
      "label": "评测零样本 LLM 裁判\n输入未标注的故事 A 与 B\n交换两种顺序以控制位置偏差\n将裁决与人类偏好对比",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rewards",
      "label": "训练创意写作奖励模型\nBradley–Terry 判别式模型\n带或不带推理说明的生成式模型\n在去偏测试集上计算一致率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_study",
      "label": "通过在线人工实验验证排序\n用 GPT-4.1 与 GPT-4o 生成新故事\n由训练后的奖励模型排序\n请标注者进行成对偏好选择",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告与人类偏好的一致率\n比较现成裁判与训练后模型\n最佳零样本裁判达到 73%\nBradley–Terry 与生成式模型达到 78%",
      "type": "terminal",
      "size": "xl"
    }
  ],
