  "nodes": [
    {
      "id": "goal",
      "label": "定义视觉与跨模态隐私风险\n属性感知加身份关联\n重建个体级隐私档案\n纯文本泄露不在范围内",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "定义隐私分类体系\n依据 GDPR 与 CCPA\n七类 · 36 个属性\n排除含糊或定义不清的类型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attribute_sources",
      "label": "汇集属性级证据\n筛选公开来源\n用合成实例扩充\n1,119 张图像覆盖七类属性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "profile_seed",
      "label": "创建 40 个全合成个体\n构建完整文本档案\n身份 · 财务 · 健康 · 出行\n详细档案保存为 JSON",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attribute_synthesis",
      "label": "合成属性级补充数据\n约 18% 由豆包生成\n指纹 2% · 身份证 11%\n医疗记录 5% · 购物记录 2%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "source_rights",
      "label": "上游权利混合边界\n含知识共享与 Apache，也有未声明许可\n另含保留全部权利与自定义非商业条款\n部分属性图像只能提供链接",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "profile_links",
      "label": "建立稳定属性关联\n报告和证件与身份记录匹配\n对齐社会关系与地址\n保持跨记录身份一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "perception_tasks",
      "label": "设计四项隐私感知任务\n直接标识符 · 间接标识符\n隐私信息抽取\n隐私区域定位",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "profile_media",
      "label": "生成个体级多模态材料\n每个个体十张图像加档案 JSON\n照片 · 指纹 · 各类记录\n按既定关联使用豆包与 Photoshop",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reasoning_tasks",
      "label": "设计五项隐私推理任务\n单步交叉验证 · 单步推理\n链式推理 · 重识别与可关联性\n跨模态关联",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "chained_guideline",
      "label": "人工编写链式推理题\n定义需要多来源的问题\n写出可验证的预期步骤\n执行核验后评估难度与覆盖",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "benchmark",
      "label": "汇编双语基准\n1,119 张图像 · 7,414 条人工设计 VQA\n40 个合成档案 · 九项任务\n中文与英文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release_gap",
      "label": "官方快照边界\nGitHub 3fc53f39 · HF a364b842\nCC BY-NC-SA 4.0 · 更新尚未完成\n30 个档案 · 663 张图像 · 缺 VQA 与评测器",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "verification_gate",
      "label": "选择核验路径\n绝对标准答案？\n语义判断？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "deterministic",
      "label": "核验 93% 的评测样本\n使用确定性规则匹配\n输出与绝对标准答案比较\n正确答案清晰且无歧义",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hybrid",
      "label": "核验其余 7% 样本\nQwen2.5-72B-Instruct 初判后人工确认\nCohen 一致性系数：0.96 · 0.92 · 0.84\n用于语义与中间步骤判断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "评测超过 50 个 VLM\n使用原始提示 · 不显式要求思维链\n温度设为 0\n覆盖商业与开源模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "计算分层隐私风险指标\nF1 · IEA 精确匹配 · mIoU\n准确率 · 步骤完成百分比\n分数越高表示隐私风险越高",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "refusal",
      "label": "区分能力与拒答\n错误回答和拒答都算任务失败\n不计作成功抽取隐私\n另行报告拒答率",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 PPR 隐私风险画像\n隐私感知与推理分数\n中英语言 · 任务 · 属性拆分\n同时报总体与仅已回答准确率",
      "type": "terminal",
      "size": "xl"
    }
  ],
