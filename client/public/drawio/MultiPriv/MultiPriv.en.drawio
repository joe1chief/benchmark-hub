    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3080" pageHeight="752" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Define Visual and Cross-modal Privacy Risk&#xa;Attribute Perception plus Identity Linkage&#xa;Reconstruct Individual-level Profiles&#xa;Text-only Leakage Is Out of Scope" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="224" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Define the Privacy Taxonomy&#xa;Grounded in GDPR and CCPA&#xa;Seven Categories · 36 Attributes&#xa;Exclude Ambiguous or Poorly Defined Types" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="224" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Assemble Attribute-level Evidence&#xa;Filter Public Sources&#xa;Augment with Synthesized Instances&#xa;Cover Seven Categories in 1,119 Images" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Create 40 Fully Synthetic Individuals&#xa;Build a Complete Textual Profile&#xa;Identity · Finance · Health · Travel&#xa;Store Detailed Profile in JSON" style="rounded=1;arcSize=20;html=0;conve