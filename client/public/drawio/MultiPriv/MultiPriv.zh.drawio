<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3080" pageHeight="752" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义视觉与跨模态隐私风险&#xa;属性感知加身份关联&#xa;重建个体级隐私档案&#xa;纯文本泄露不在范围内" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="224" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义隐私分类体系&#xa;依据 GDPR 与 CCPA&#xa;七类 · 36 个属性&#xa;排除含糊或定义不清的类型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="224" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="汇集属性级证据&#xa;筛选公开来源&#xa;用合成实例扩充&#xa;1,119 张图像覆盖七类属性" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="创建 40 个全合成个体&#xa;构建完整文本档案&#xa;身份 · 财务 · 健康 · 出行&#xa;详细档案保存为 JSON" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="合成属性级补充数据&#xa;约 18% 由豆包生成&#xa;指纹 2% · 身份证 11%&#xa;医疗记录 5% · 购物记录 2%" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="上游权利混合边界&#xa;含知识共享与 Apache，也有未声明许可&#xa;另含保留全部权利与自定义非商业条款&#xa;部分属性图像只能提供链接" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="建立稳定属性关联&#xa;报告和证件与身份记录匹配&#xa;对齐社会关系与地址&#xa;保持跨记录身份一致" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="设计四项隐私感知任务&#xa;直接标识符 · 间接标识符&#xa;隐私信息抽取&#xa;隐私区域定位" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="生成个体级多模态材料&#xa;每个个体十张图像加档案 JSON&#xa;照片 · 指纹 · 各类记录&#xa;按既定关联使用豆包与 Photoshop" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="设计五项隐私推理任务&#xa;单步交叉验证 · 单步推理&#xa;链式推理 · 重识别与可关联性&#xa;跨模态关联" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="人工编写链式推理题&#xa;定义需要多来源的问题&#xa;写出可验证的预期步骤&#xa;执行核验后评估难度与覆盖" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="汇编双语基准&#xa;1,119 张图像 · 7,414 条人工设计 VQA&#xa;40 个合成档案 · 九项任务&#xa;中文与英文" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="官方快照边界&#xa;GitHub 3fc53f39 · HF a364b842&#xa;CC BY-NC-SA 4.0 · 更新尚未完成&#xa;30 个档案 · 663 张图像 · 缺 VQA 与评测器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="选择核验路径&#xa;绝对标准答案？&#xa;语义判断？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="核验 93% 的评测样本&#xa;使用确定性规则匹配&#xa;输出与绝对标准答案比较&#xa;正确答案清晰且无歧义" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="核验其余 7% 样本&#xa;Qwen2.5-72B-Instruct 初判后人工确认&#xa;Cohen 一致性系数：0.96 · 0.92 · 0.84&#xa;用于语义与中间步骤判断" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="384" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="评测超过 50 个 VLM&#xa;使用原始提示 · 不显式要求思维链&#xa;温度设为 0&#xa;覆盖商业与开源模型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="计算分层隐私风险指标&#xa;F1 · IEA 精确匹配 · mIoU&#xa;准确率 · 步骤完成百分比&#xa;分数越高表示隐私风险越高" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="区分能力与拒答&#xa;错误回答和拒答都算任务失败&#xa;不计作成功抽取隐私&#xa;另行报告拒答率" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;vertic