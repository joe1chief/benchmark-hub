{
  "version": 1,
  "title": "CMATH 数据集构建流程与评测协议",
  "type": "academic-diagram",
  "source": "paper-grounded",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 15,
    "edges": 16,
    "modules": 2
  },
  "nodes": [
    {
      "id": "sources",
      "label": "中文小学练习与试题来源\n真实的小学数学练习册与期末试卷\n覆盖中国课程标准 1 至 6 年级",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "text_extract",
      "label": "文本数字化与格式转换\nPDF 与 Word 试卷文档解析为纯文本\n自动提取并配合人工勘误校对",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "graphical_gate",
      "label": "是否包含图形/几何内容？\n过滤需要图表或几何图形的题目\n纯文本题与依赖视觉题分流门禁",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_graphical",
      "label": "图形依赖题目剔除\n移除需要几何图表的题目\n确保纯自然语言模态评测",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "clean_dedup",
      "label": "文本清洗与语义去重\n两两相似度过滤与表述规范化\n统一数学单位与问题提问格式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "author_validation",
      "label": "作者团队人工审核\n研究人员多轮逐题交叉复审\n校验题目一致性、合理性与难度",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "metadata_tagging",
      "label": "多维度元数据标注\n标注年级（1–6 年级）与标准数值答案\n手工标注推理步数与最大数字位数 D",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cmath_core",
      "label": "CMATH 冻结基准集\n1,689 道经严密验证的小学数学题\n600 道公开开发集 + 360 道干扰项鲁棒性集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "零样本题目输入封装\n直接输入中文题目陈述并提示给出最终答案\n可选添加干扰信息（1–5 句无关干扰）",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "大语言模型自回归推理\n主流基础模型采用贪心解码（T=0）\n生成中间推理过程与最终解答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "regex_extraction",
      "label": "数值答案规则解析\n从模型输出文本中提取最终数值答案\n归一化小数、分数与整数表达",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_gate",
      "label": "提取答案与标准答案匹配？\n与标准金标答案进行数值等价比较\n对舍入偏差或解析错误零容忍",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "correct_sink",
      "label": "答题正确分支\n计入对应年级与评测设置的正确计数\n用于原始题与干扰题鲁棒性对比",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "incorrect_sink",
      "label": "答题错误/干扰受扰分支\n计算错误或受干扰信息误导的答错样本\n分析各年级难度下的性能下降",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "metrics_reporting",
      "label": "CMATH 评测结果汇总\n1–6 年级分年级准确率\n干扰项鲁棒性性能衰减指数",
      "type": "terminal",
      "size": "xl"
    }
  ],
  "edges": [
    { "from": "sources", "to": "text_extract", "type": "primary" },
    { "from": "text_extract", "to": "graphical_gate", "type": "primary" },
    { "from": "graphical_gate", "to": "clean_dedup", "type": "primary", "label": "纯文本题目" },
    { "from": "graphical_gate", "to": "discard_graphical", "type": "optional", "label": "含几何图形" },
    { "from": "clean_dedup", "to": "author_validation", "type": "primary" },
    { "from": "author_validation", "to": "metadata_tagging", "type": "primary" },
    { "from": "metadata_tagging", "to": "cmath_core", "type": "primary" },
    { "from": "cmath_core", "to": "prompt_formatting", "type": "primary" },
    { "from": "prompt_formatting", "to": "model_inference", "type": "primary" },
    { "from": "model_inference", "to": "regex_extraction", "type": "primary" },
    { "from": "regex_extraction", "to": "eval_gate", "type": "primary" },
    { "from": "eval_gate", "to": "correct_sink", "type": "primary", "label": "匹配正确" },
    { "from": "eval_gate", "to": "incorrect_sink", "type": "optional", "label": "不匹配/错误" },
    { "from": "correct_sink", "to": "metrics_reporting", "type": "primary" },
    { "from": "incorrect_sink", "to": "metrics_reporting", "type": "primary" },
    { "from": "discard_graphical", "to": "clean_dedup", "type": "optional" }
  ]
}
