ign=center" vertex="1" parent="1"><mxGeometry x="1744" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="执行每个生成组件&#xa;测试数据库 · 样例数据 · 工具 · 验证器&#xa;在隔离环境捕获运行错误" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="根据执行反馈修复&#xa;将错误摘要与问题代码反馈给 LLM&#xa;最多 5 次 · Schema/数据容许 10% · 启动容许 0%" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="发布于 AgentWorldModel-1K&#xa;1,000 个环境和 10,000 个任务之一&#xa;公开 gen_*.jsonl：数据库 + MCP + 任务 + 验证器" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="运行多轮工具使用 Agent&#xa;可重置的隔离 HireBench 环境&#xa;Agent 改变招聘工作流状态" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="合并状态信号与轨迹&#xa;代码增强 LLM-as-a-Judge&#xa;处理不完美的环境证据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;stroke