    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4120" pageHeight="656" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="一手证据与固定快照&#xa;arXiv:2602.10090v3 · 图 2 · 第 3.1-3.3 节 · 附录 A.1-A.3&#xa;代码 85e322f · HF 数据 e9b8de6&#xa;gen_scenario.jsonl:762 · gen_tasks.jsonl:520" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="确定制品身份&#xa;HireBench Coding Graduate Pipeline&#xa;ats_applicant_tracking_system_&#xa;4 · 官方 ID 后缀 · 不是独立基准" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="从 100 个领域名称种子开始&#xa;面向有状态数据库应用&#xa;要求可生成真实的合成 CRUD 数据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="合成场景描述&#xa;将名称扩展为应用概念&#xa;包含 HireBench 招聘工作流" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="248" width="20