      "type": "process",
      "size": "xl"
    },
    {
      "id": "partition",
      "label": "按最终安全标签分流\n安全或恢复 → 无害池\n其余有害项 → 有毒池\n保留类别元数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release_main",
      "label": "发布互补数据集\nOR-Bench-80K：安全提示\nOR-Bench-Toxic：约 600 条\n同测有用性与安全性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "screen",
