  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n初始论文 · arXiv 2306.13394v1\n最新论文 · v5 · 核心套件不变\nEvaluation 分支 · 04eb8401\n评分工具 · 1c1d69e1",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "定义 14 个子任务\n感知 · 10 项\n认知 · 四项\n均使用成对是非问题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "perception",
      "label": "感知分支 · 10 项\n粗粒度识别 · 四项\n细粒度识别 · 五项\nOCR · 一项",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "cognition",
      "label": "认知分支 · 四项\n常识推理\n数值计算 · 文本翻译\n代码推理",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "coarse",
      "label": "从 COCO 采样图像\n存在 · 计数 · 颜色 · 位置\n每项 30 张图像\n合计 120 张",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "fine",
      "label": "从公开识别集采样\n海报 147 · 名人 170\n场景 / 地标 / 艺术品各 200\n合计 917 张",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "ocr",
      "label": "从公开 OCR 集采样\n选择相对简单的样本\n20 张图像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "commonsense",
      "label": "构建常识推理图像\n人工拍摄或扩散模型生成\n70 张图像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "cognition_three",
      "label": "拍摄另外三类认知图像\n数值 · 翻译 · 代码\n每项 20 张图像\n合计 60 张",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "merge_sources",
      "label": "合并五路图像来源\n保留子任务归属",
      "type": "process",
      "size": "s"
    },
    {
      "id": "manual_pairs",
      "label": "独立人工编写全部问答对\n不直接复用或依赖来源数据集标注\n第一题标准答案 · 是\n第二题标准答案 · 否",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "prompt_rule",
      "label": "使用简洁零样本指令\n问题 + “请回答是或否”\n每张图像恰有两个问题\n不提供示例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "汇总 MME\n1,187 张图像\n2,374 组指令-答案\n14 个逐子任务文件",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "访问与发布边界\nv1 · 邮件申请\n2024 HF 快照 · 7056f44d\n2,374 行 · 数量与论文一致\n数据卡 · Apache-2.0",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "construction_gaps",
      "label": "未披露的构建细节\n标注员数量 / 培训 / 一致性\n图像筛选与拒绝规则\n去重 / 污染审计\n逐行来源与权利映射",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_schema",
      "label": "公开快照边界\nquestion_id · image · question\nanswer · category\n无逐行来源 / 许可证字段\n已替代最初的仅邮件申请方式",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_history",
      "label": "论文修订边界\nv1 评测 10 个模型\nv5 评测 30 个模型\n构建与指标未变化\n当前会议信息为论文后更新",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "format_results",
      "label": "准备官方评分工具文件\n每个子任务一个文件\n每张图像连续两行\n将响应追加为第四个制表字段\n响应必须保持单行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "input_gate",
      "label": "四字段且每块恰有两行？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "abort",
      "label": "中止整个评分器\n字段拆包 / 断言失败\n不逐行跳过或补值",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "解析小写化后的响应\n精确 yes / no 直接接受\n否则只检查前四个字符\n先查 yes 再查 no · 否则 other",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_gate",
      "label": "解析结果为 yes 或 no？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "recognized",
      "label": "与标准答案比较\n标签正确则单题正确数加一\n两题都正确则 ACC+ 计数加一",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "other",
      "label": "将 other 视为错误\n保留在 ACC 与 ACC+ 分母\n从精确率 / 召回率 / 混淆计数中排除",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pair_metrics",
      "label": "计算两个核心指标\nACC · 正确问题 / 全部问题\nACC+ · 两题均对 / 全部图像\n随机基线 · 50% 与 25%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_score",
      "label": "计算逐子任务得分\n100 × (ACC + ACC+)\n满分 · 200",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "totals",
      "label": "分别报告两类总分\n感知 · 10 项求和 · 满分 2,000\n认知 · 四项求和 · 满分 800\n分母取决于实际提供的行 / 两行块",
      "type": "terminal",
      "size": "xl"
    }
  ],
