geometry"/></mxCell><mxCell id="16" value="固定版生成器漂移&#xa;前 9,000 条人工集 · 温度 .8&#xa;2B + 3B · 主路径无 NLI&#xa;解析器丢弃类别&#xa;单行错误直接跳过&#xa;5 轮最多生成 10 个候选&#xa;无随机种子" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCCBC;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="发布边界&#xa;UT Austin · UNC · Drexel&#xa;代码/数据 MIT · 站点保留权利&#xa;资产公开 · 仅结果页&#xa;无提交排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="当前审计哪一种&#xa;评测合同？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3000" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="论文检测设置&#xa;无知识零样本&#xa;上下文设置：&#xa;提供 PubMedQA 知识&#xa;仅输入输出；不确定类分开&#xa;答案配对抽样未披露" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="论文二分类裁判提示&#xa;输出 0：事实正确 · 1：存在幻觉&#xa;仅输出整数&#xa;解析失败处理未披露" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=mi