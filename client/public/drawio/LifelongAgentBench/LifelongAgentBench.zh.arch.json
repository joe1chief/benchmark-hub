      "module": "construction",
      "size": "xl"
    },
    {
      "id": "db_generate",
      "label": "生成数据库候选\nDeepSeek-R1 / deepseek-reasoner\nSQL · 表结构 · 指令 · 数据行\n判断指令一致性",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "db_gate",
