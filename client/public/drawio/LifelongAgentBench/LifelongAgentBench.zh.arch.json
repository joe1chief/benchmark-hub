    },
    {
      "id": "db_release",
      "label": "筛选 500 条数据库任务\n来自 1,306 条候选\n分层保证技能覆盖\n每项技能至少出现 20 次",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_sample",
      "label": "采样 OS 目标技能\n29 个允许的 Bash 命令\n论文目标：9–12 个命令\n生成器未强制校验命令数",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_generate",
      "label": "生成 OS 候选\nDeepSeek-R1 / deepseek-reasoner\n指令 · 初始化 · 标准解\n任务评价器 · 指令润色",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_gate",
      "label": "OS 候选有效？\n解题前评价器返回非零\n标准解后评价器返回 0\n含目标技能且通过超时检查",
      "type": "decision",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_reject",
