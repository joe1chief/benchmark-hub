    {
      "id": "sources",
      "label": "Fix Official Sources\nPaper v3 · 2025-05-30\nCode d6f19b42 · Data 75054b60",
      "type": "document",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "skills",
      "label": "Define Atomic Skills\nDB 22 · OS 29 · KG 7\nAnalysis Relation · Not a Gate\nas⁽ᵐ,ⁿ⁾[E⁽ⁱ⁾] = 2aₘaₙ\n÷ (aₘ + aₙ)\naₖ = as⁽ᵏ⁾[E⁽ⁱ⁾]",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "db_sample",
      "label": "Sample SQL Skills\nFavor Infrequent Skills\nWeight ∝ 1 / (Count + 1)\nTarget One-table Tasks",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "db_generate",
      "label": "Generate Database Candidates\nDeepSeek-R1 / deepseek-reasoner\nSQL · Schema · Instruction · Rows\nJudge Instruction Consistency",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "db_gate",
      "label": "Database Candidate Valid?\nSQL Parses and Uses Target Skills\nQuery Executes Consistently\nResult or State Hash Is Defined",
      "type": "decision",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "db_reject",
      "label": "Reject DB Candidate\nInvalid or Inconsistent",
      "type": "terminal",
      "module": "construction",
      "size": "large"
    },
    {
      "id": "db_release",
      "label": "Select 500 DB Tasks\nFrom 1,306 Candidates\nStratified Skill Coverage\nAt Least 20 Uses per Skill",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_sample",
      "label": "Sample OS Target Skill\n29 Allowed Bash Commands\nPaper Target: 9–12 Commands\nGenerator Does Not Enforce Count",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_generate",
      "label": "Generate OS Candidate\nDeepSeek-R1 / deepseek-reasoner\nInstruction · Init · Ground Truth\nTask-specific Evaluator · Polish",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_gate",
      "label": "OS Candidate Valid?\nEvaluator Is Nonzero before Solution\nEvaluator Is 0 after Ground Truth\nTarget Skill Present · Timeout Passes",
      "type": "decision",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "os_reject",
      "label": "Reject OS Candidate\nFailed Script Gate",
      "type": "terminal",
      "module": "construction",
      "size": "large"
    },
    {
      "id": "os_release",
      "label": "Fixed HF Release: 500 OS Tasks\nObserved Command Count: 4–26\n339 within 9–12 · 161 outside\nPaper Target Is Not a Hard Filter",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "kg_source",
      "label": "Start from GrailQA\nS-expressions · Entities · Answers\nNot LLM-generated Task Plans\nPreserve Question Functions",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "kg_convert",
      "label": "Convert to Constrained Actions\nRelations · Neighbors · Intersection\nAttributes · Argmax · Argmin · Count\nExecute through SPARQL",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "kg_gate",
      "label": "KG Candidate Valid?\nConversion Has No Action Error\nS-expression Executes Correctly\nEntity Names Pass Release Filter",
      "type": "decision",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "kg_reject",
      "label": "Reject KG Candidate\nConversion or Execution Error",
      "type": "terminal",
      "module": "construction",
      "size": "large"
    },
    {
      "id": "kg_release",
      "label": "Select 396 KG Tasks\nLength 2–8: 50 Each\nLength 9: 46\nExtra Review for Length 7–9",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "manual_review",
      "label": "Review Each Environment\nRandomly Inspect 10% of Tasks\nSyntax · Logic · Practical Relevance\nApply Pilot-test Configuration",
      "type": "user",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "dataset_release",
      "label": "Release 1,396 Tasks\nDB 500 · OS 500 · KG 396\nThree Public Parquet Files\nHF Viewer: default / train",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "framework",
      "label": "Configure Six Components\nModel Pool · Agent · Environment\nHistory Factory · Controller · Callbacks\nLocal or Transparent-RPC Deployment",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "sequence",
      "label": "Execute Tasks in Fixed Order\nController Restores Checkpoints\nNever Parallelize Task Sequence\nAccumulate Experience over Time",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "db_eval",
      "label": "Database Runtime + Score\nOne MySQL Container per Run · Create / Drop DB\nAction: Operation / Answer · Max 3 Rounds\nSELECT Result · Writes State MD5",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "os_eval",
      "label": "OS Runtime + Score\nFresh Ubuntu Container per Task\nAct: bash / Act: finish · Max 5 Rounds\nEvaluator Exit 0 Means Success",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "kg_eval",
      "label": "KG Runtime + Score\nSeven Action APIs · Max 15 Rounds\nFinal Answer: Variable #n\nExact Match · F1 · Executable Rate",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "success_gate",
      "label": "Correct and Completed?\nBinary Task Reward",
      "type": "decision",
      "module": "evaluation",
      "size": "large"
    },
    {
      "id": "replay_memory",
      "label": "Store Successful Trajectory\nRecent FIFO Experience Memory\nFailed Tasks Are Not Stored",
      "type": "database",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "replay",
      "label": "Compare Experience Replay\nBaseline N = 0\nTested N: 1 · 2 · 4 · 8 · 16 · 32 · 64\nInject Recent Successful Trajectories",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "gsc",
      "label": "Optional GSC after Inference\nPublic Callback: DB + OS Only\nOriginal + Grouped Candidates\nMajority Vote May Replace Action",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "agent_infer",
      "label": "Generate Original Agent Response\nFixed Prompt + Current Observation\nEnvironment-specific Parser Format\nCallback Receives This Response",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report Task Success Rate\nBreak Down DB · OS · KG\nSkill · Difficulty · Replay Depth\nGroups · Input Tokens · OOM",
      "type": "terminal",
      "module": "evaluation",
      "size": "xl"
    }
  ],
