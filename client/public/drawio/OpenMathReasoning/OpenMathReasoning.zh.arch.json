    {
      "id": "source",
      "label": "收集AoPS论坛讨论\n排除Middle School Math论坛\n论文阶段共620K条讨论\n保留帖子级数学上下文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "extract",
      "label": "用Qwen2.5-32B-Instruct抽取\n每帖可识别零个一个或多个问题\n精炼问题陈述\n得到580K个问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "classify",
      "label": "分类每个问题\n区分证明题与非证明题\n识别多选题或二元问题\n判断有效或无效",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "filter",
      "label": "移除不适合的格式\n删除多选题二元题和无效题\n保留550K个问题\n保持开放式可回答任务",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "transform",
      "label": "规范问题可回答性\n把证明题转换为答案题\n尽可能抽取最终答案\n标记无法抽取答案的案例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "decontam",
      "label": "执行数学基准去污染\n由大模型比对热门任务\n移除高度相似问题\n论文流水线得到540K",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_scope",
      "label": "论文v1构建口径\n540K个唯一问题\n3.2M条长思维链解答\n1.7M条工具推理及566K条选择数据",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release_scope",
      "label": "官方HF v1.0发布口径\n306K个问题具有公开解答\n另有193,170条仅问题记录\n总计5,678,317行",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "cot_generate",
      "label": "生成长思维链候选\n使用DeepSeek-R1与QwQ-32B\n每题最多生成32个解答\n温度0.7且Top-p为0.95",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cot_filter",
      "label": "过滤长思维链解答\n核对抽取答案或多数答案\n由Qwen2.5-32B判断答案等价\n保留与预期答案一致的候选",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cot_release",
      "label": "保留3,201,061条思维链数据\n其中2.7M条来自DeepSeek-R1\n其中0.5M条来自QwQ-32B\n形成长推理训练分集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "tir_seed",
      "label": "启动工具集成推理\n提示LIMO-Qwen-32B使用Python\n合成1.2M个候选解答\n过滤为15K条阶段零样例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "tir_iterate",
      "label": "迭代工具推理训练与生成\n先训练QwQ再训练14B模型\n执行并过滤使用代码的解答\n保留1,718,466条工具推理数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "genselect",
      "label": "构建生成式选择数据\n采样候选解答并重写摘要\n先由QwQ-32B选择再由Qwen2.5-32B重写\n保留565,620条选择记录",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布OpenMathReasoning v1.0\n包含思维链工具推理选择及额外问题\n数据采用CC BY 4.0并发布开放模型\nNeMo Skills提供复现流水线",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "train_models",
      "label": "训练OpenMath-Nemotron模型\n用思维链工具推理和选择数据监督微调\n覆盖1.5B、7B、14B和32B规模\n用于证明数据集质量",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_suite",
      "label": "评测下游数学能力\n使用AIME24、AIME25和HMMT-24-25\n使用HLE-Math纯文本子集\n不是数据集自身的内在得分",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sample64",
      "label": "每题生成64个答案\n温度0.6且Top-p为0.95\n采用思维链或工具推理模式\n执行答案校验",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "聚合准确率指标\npass@1对64次生成取平均\nmaj@64采用多数投票\n另将GenSelect作为推理变体报告",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "按模型规模和基准报告\n分别呈现思维链工具推理和选择变体\nAIMO-2夺冠方案只是使用案例\n不存在OpenMathReasoning测试集榜单",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "count_boundary",
      "label": "数量更正边界\n论文540K指流水线阶段问题数\nHF数据卡更正有解问题为306K\n过滤及流水线Bug丢失137K个证明题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "license_boundary",
      "label": "发布与许可边界\nHF v1.0数据采用CC BY 4.0\nNeMo Skills代码采用Apache 2.0\n论文称发布许可允许商业使用",
      "type": "document",
      "size": "xl"
    },
