  "nodes": [
    {
      "id": "scenarios",
      "label": "人工设计 44 个部署场景\nAgent • 模拟工具 • 对抗目标\n详细策略与成功判据",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "categories",
      "label": "覆盖四类策略违规\n机密泄露 • 目标冲突\n禁止信息 • 禁止行动",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "competition",
      "label": "运行 Gray Swan 公开挑战赛\n2025-03-08 至 04-06 • 四轮\n22 个匿名前沿 Agent",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "submissions",
      "label": "收集红队攻击\n直接与间接提示注入\n180 万次提交交互",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "challenge_judge",
      "label": "判定挑战赛策略违规\n自动成功评估\n提供人工申诉与复核路径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "successful_pool",
      "label": "形成成功攻击候选池\n超过 60,000 次策略违规\n保留目标行为与来源模型",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "strict_filter",
      "label": "使用更严格的 LLM 评审器\n重新核验挑战赛成功样本\n保留高质量有效注入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sampling",
      "label": "按行为-模型组合采样\n每组最多 5 条高质量攻击\n保留全部 44 个目标行为",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "benchmark",
      "label": "构建 ART Benchmark\n4,700 条精选攻击\n44 个 Agent 部署场景",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "models",
      "label": "评测 19 个前沿模型\n挑战赛模型 + 未见模型\n包含 Gemini 2.5 Pro 与 o4-mini",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "query_budgets",
      "label": "按查询预算重放攻击\nk = 1 • 10 • 100\n判断每个行为是否至少违规一次",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "asr",
      "label": "计算行为级攻击成功率\nk 次查询内被攻破的行为占比\n数值越低越安全",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "transfer",
      "label": "分析攻击迁移性\n来源模型 → 其他目标模型\n跨行为通用攻击簇",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "汇报 Agent 安全结果\n不同 k 的 ASR • 迁移性与通用性\n鲁棒性与能力相关性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_status",
      "label": "论文所述访问状态\n计划采用私有动态排行榜\n本版来源未显示已公开发布",
      "type": "document",
      "size": "xl"
    }
