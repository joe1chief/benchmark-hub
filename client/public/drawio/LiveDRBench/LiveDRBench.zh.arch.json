    {
      "id": "definition",
      "label": "界定深度研究任务\n要求高检索扇出\n要求非平凡推理与信息综合\n将论点生成与长报告写作分离",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "desiderata",
      "label": "制定可更新任务要求\n需要多来源且答案客观\n无法靠单页或参数记忆直接作答\n覆盖多领域与多类用户需求",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "seed",
      "label": "选择推理种子问题\n从文档或长上下文问答出发\n保留标准答案及其证据\n纳入科学与公共事件来源",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "inversion",
      "label": "反转原始问题\n将答案属性改写为检索线索\n询问符合条件的事件或实体\n迫使系统跨开放网络发现答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "refine",
      "label": "精炼为唯一且可验证的答案\n必要时加入区分性属性\n若有同答案文档则补充证据\n保持流水线可周期更新",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "categories",
      "label": "整理八个任务类别\nSciFacts · NovelDS · PriorArt\nEntities · Flights 及其子类别\n平衡科学与世界事件领域",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold",
      "label": "构建分类特定的标准论点\n从源文档推导答案\n为世界事件抓取结构化列表\n保存实体名称与嵌套论点结构",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "人工完成标准答案\n检查初始答案外的智能体输出\n加入有效的替代答案\n固化可复现的评分论点列表",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 LiveDRBench\n八个类别共 100 个任务\n典型任务约需 20 个信息单元\n设计目标为至少需要 10 次检索",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "systems",
      "label": "运行深度研究与检索系统\n允许从完整互联网检索\n比较 3 个闭源深度研究系统\n加入推理与非推理检索基线",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "规范化系统生成的研究输出\n抽取论点与子论点 JSON\n非结构化输出用 GPT-4 解析\n在报告文风之前评测论点层",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agreement",
      "label": "匹配生成论点与标准论点\n使用论文公开的 GPT-4o 一致性提示\n判断论点语义正确性\n保留父论点与子论点关系",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "计算修正后的精确率与召回率\n以子论点质量加权父论点\n父论点或全部子论点失败则记零\n将两项指标合成为 F1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告性能与推理轨迹行为\n按类别报告精确率、召回率、F1\n统计来源数与检索扇出\n分析分支搜索与回溯",
      "type": "terminal",
      "size": "xl"
    }
