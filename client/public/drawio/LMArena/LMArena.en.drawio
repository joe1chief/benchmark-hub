1;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="-104" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Select an Anonymous Model Pair&#xa;Paper Uses Non-uniform Sampling&#xa;Favor Similar, Uncertain Pairs&#xa;Pair Is Not a Uniform-random Baseline" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="152" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Side-by-side Model Battle&#xa;Send the Same Turns to Both Models&#xa;Hide Identities during the Battle&#xa;Continue until the User Can Judge" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="408" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Record One Human Preference&#xa;Model A · Model B · Tie · Both Bad&#xa;Reveal Identities Only after Voting&#xa;Store Both Conversations + Vote" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="664" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Exclude Identity Leakage&#xa;Filter Model and Company Keywords&#xa;Preserve Anonymous Ranking Data&#xa;Paper's Stated Main Data Filter" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="920" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Paper Table 1 Snapshot&#xa;2024-01-21 · 243,329 Conversations&#xa;50 Models · 90,051 Users&#xa;149 Languages · Mean 1.3 Turns" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1176" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="IPW Win-matrix Estimate&#xa;θ̂_T(a) = T⁻¹ Σₜ Hₜ 1{Aₜ=a}/Pₜ(a)&#xa;Correct Non-uniform Pair Sampling&#xa;Paper Ranking Replay: 213,576 Votes" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1432" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Reweighted Bradley-Terry MLE&#xa;P(i≻j)=e^ξⁱ/(e^ξⁱ+e^ξʲ); ξ₁=0&#xa;ξ̂ = argmin Σₜ P(Aₜ)⁻¹ ℓ(Hₜ,pξ(Aₜ))&#xa;Target a Uniform Model-pair Distribution" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1688" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Sandwich Joint Confidence Set&#xa;Multiplicity-aware Approximate Rank&#xa;Rₘ = 1 + Σₘ′ 1{inf Cₘ′ &gt; sup Cₘ}&#xa;Do Not Sort Point Estimates Alone" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1944" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Publish the Paper-era Ranking&#xa;BT Coefficients · Win Matrix&#xa;Confidence Intervals · Approximate Rank&#xa;Earlier UI Elo Is Not This Estimator" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="2200" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Active-sampling Feedback&#xa;Pₜ(a) ∝ √(Σ̂ₜ,ₐₐ / nₜ(a))&#xa;− √(Σ̂ₜ,ₐₐ / (nₜ(a)+1))&#xa;Sample by Expected CI-width Reduction" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="200" y="-152" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="Unsafe-content Flag Only&#xa;OpenAI Moderation API&#xa;3% of User Requests Flagged&#xa;Paper Does Not State Rank Exclusion" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="328" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="Expert Validation Only&#xa;160 Random Battles · Blind Labeling&#xa;Graduate Students + External Fact Checks&#xa;72.8–83.1% Crowd-expert Agreement" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1096" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="Paper Anomaly Experiment Only&#xa;25 Anomalous + 25 Normal IPs&#xa;Fisher Test at 5 Random Checkpoints&#xa;Not a Paper Ranking Input" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1352" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="2024-08-29 → 2025-05-16&#xa;Style Control → Text Default&#xa;Tokens · Headers · Bold · Lists&#xa;z_f = std((f_A−f_B)/(f_A+f_B))&#xa;Contextual BT: β_A−β_B+zᵀγ" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="-264" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="2025-07-23&#xa;Online Bootstrap → CLT / M-estimator CI&#xa;Frequency-based Pair Reweighting&#xa;Arena-Rank Weight: Reciprocal of max{n_ab, 50}&#xa;Distinct from Paper Propensity IPW" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="104" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="2025-07-14 → 2025-10-04&#xa;Stronger Dedup + Identity-leak Checks&#xa;Statistical Anomalous-user Filter&#xa;Remove Model-vs-itself Rows&#xa;Exact Dedup / Anomaly Algorithms Not Public" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="472" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="2026-03 → 2026-05-12&#xa;10% of Direct Sessions Become Battles&#xa;Exclude Skip; Keep Decisive A/B Votes&#xa;Add is_direct_battle&#xa;+ same_org_indicator&#xa;Exact Feature Encodings Not Public" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1208" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="2026-04-30 Listing Policy&#xa;Display Publicly Available Models&#xa;Require Stable Rating + at Least 1,000 Votes&#xa;At Least One Public Model per Battle&#xa;At Least 20% Public-vs-public Battles" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="840" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="Renamed Live Arena Leaderboard&#xa;BT / Contextual BT, Not Elo Updates&#xa;Arena-Rank Scale: 1000 + 400β / ln(10)&#xa;Dated Methods Must Not Rewrite Paper v1" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1576" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="Do Not Merge the Paper Units&#xa;Table 1: 243,329 Conversations&#xa;Ranking Replay: 213,576 Votes&#xa;Different Scope and Purpose" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;ve