    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="832" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Primary Evidence + Fixed Revision&#xa;arXiv:2401.14493v1 · 25 Jan 2024&#xa;Official Git ef403d0&#xa;Paper Sections 3–5 + Appendices A–B" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Source K Health Conversations&#xa;Real Patient-physician Text Interactions&#xa;Paper Says Questions Are Deidentified&#xa;Raw Conversation Corpus Not Released" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Automatic Question Prefilter&#xa;Fine-tuned BERT: Question vs Statement&#xa;Regex Removes Logistics Questions&#xa;Billing and Delivery Examples" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Candidate Question Pool · About 26K&#xa;Real Consumer-health Wording&#xa;Ambiguous Jargon + Multiple Conditions&#xa;Candidates for Stand-alone Review" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;s