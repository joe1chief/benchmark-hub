  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3280" pageHeight="784" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="主要证据与固定版本&#xa;arXiv:2512.12772v2 · 2026-05&#xa;ICLR 2026 · OR Zg1YH8R5GG&#xa;Git dbd84e1 · HF ae27ad8&#xa;协议以论文 v2 为准" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义严格联合音视频分类体系&#xa;15 个任务 · 5 个认知维度&#xa;4 类音频 · 3 类场景跨度&#xa;每个答案必须同时依赖音频与视频" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="筛选 SF20K 影片来源&#xa;1,072 部专业制作短片&#xa;去除不可用或灰度视频&#xa;保留 1,046 部可用影片" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="识别语义一致场景&#xa;PySceneDetect 切分长视频&#xa;合并高度相似的相邻场景&#xa;保留丰富的场景内上下文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="视觉描述通道&#xa;Qwen2.5-VL · 1 fps · 覆盖全部场景&#xa;描述静态物体与人物&#xa;描述运动与镜头转换" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="音频描述通道&#xa;Whisper-v3 语音转写 + 精确时间戳&#xa;Qwen2.5-Omni：人声 / 声音 / 音乐&#xa;声音事件与音乐先一并生成" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Qwen2.5 音频描述精修&#xa;分离背景音乐与声音事件&#xa;将嗓音特征与转写对齐&#xa;去除幻觉和重复内容" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Qwen2.5 按任务合成问答&#xa;时序 / 情节关系使用模板&#xa;通用任务由大模型策划&#xa;生成问题 + 答案 + 简短解释" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="约束任务输入与场景跨度&#xa;只给所需场景和模态描述&#xa;单 / 多场景：仅高质量场景&#xa;全场景：使用全部场景描述&#xa;核验多场景信息区间" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="收集问答候选池&#xa;9,109 组问答&#xa;问题 · 答案 · 解释" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="通用质检 · Qwen2.5 思维链&#xa;输入仅含问答与解释&#xa;模态 · 格式 · 内容 · 臆测&#xa;排除单模态或证据不足的答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="任务专项质检&#xa;顺序检查：VSSR / MPO&#xa;歧义检查：SPL / SOER&#xa;音频信号类型检查：声音事件 / 音乐" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="过滤问答后生成干扰项&#xa;三个可信但错误的干扰项&#xa;错误细节 · 时间 / 空间错位&#xa;形成四选一问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="三阶段自动流程输出&#xa;3,974 道四选一问题&#xa;问题 · 解释 · 视频 / 片段" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3000" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="人类标注员评分与纠错&#xa;答案正确性 + 信息正确性&#xa;音视频依赖性 + 问题难度&#xa;正确答案在干扰项中时修正标签" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3000" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="人工决定样本去留&#xa;接受：直接保留&#xa;待审：按评分进一步筛选&#xa;先剔除错答，再按其余标准筛选&#xa;因答案错误剔除 17.4%" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="事后答案标签精修&#xa;外部强模型独立选择答案&#xa;与原人工标注进行多数投票&#xa;无多数结论 → 保留人工标签&#xa;不删样本；重新计算论文结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="审计后的 JointAVBench&#xa;2,853 题 · 保留率 71.8%&#xa;平均视频时长 97.2 秒&#xa;15 任务 · 音频类型 · 场景跨度" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="论文评测协议&#xa;随机打乱四个选项&#xa;仅输入问题文本 · 统一 32 帧&#xa;适用时使用模型官方默认配置" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="Git dbd84e1 输出解析器&#xa;汇集正则 / 前缀 / 选项文本匹配&#xa;单词输出兜底 · 仅接受唯一 A–D&#xa;与打乱后的正确前缀精确比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="汇报准确率&#xa;总体 + 各任务&#xa;各音频类型 + 场景跨度" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="受限数据集 / 视频边界&#xa;HF ae27ad：仅研究或教育用途&#xa;低清片段 + YouTube 原始链接&#xa;不得将视频片段作为独立媒体再分发&#xa;HF 卡片元数据：CC BY-SA 4.0" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="600" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="论文 / 代码 / 元数据漂移&#xa;论文附录 H：CC BY-NC-SA 4.0&#xa;Git dbd84e1 代码：Apache 2.0&#xa;README 的最高 56.2% 已过时&#xa;论文 v2 报告 65.3% · 以论文为准" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align