    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2184" pageHeight="936" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定审阅证据&#xa;arXiv：2501.00584v2&#xa;Git：012712a&#xa;HF：4d9ddfa" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义三类时间语境&#xa;过去 · 当前 · 未来&#xa;每题锚定问题时间戳&#xa;模拟在线视频使用" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="6 类任务 · 16 个子任务&#xa;空间 · 时间&#xa;时空感知&#xa;幻觉核验&#xa;过去记忆 · 未来预测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="论文内部数量矛盾&#xa;引言：七个数据集&#xa;第 3.2 节：八个数据集&#xa;六个领域&#xa;不把两种口径强行合并" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="仅选择验证集与测试集&#xa;排除训练集&#xa;降低潜在数据泄漏&#xa;保留多样真实场景" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="复用已有时空标注&#xa;精确时间戳 · 边界框&#xa;动作与对象标注&#xa;轨迹信息" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="构造任务专属问答&#xa;人工标注员重写&#xa;任务专属模板&#xa;保留查询时刻语义" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="构造流式干扰项&#xa;同视频偏移时间戳&#xa;相似问题或对象&#xa;常见但错误的回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="执行人工质量检查&#xa;检查问题清晰度&#xa;检查选项歧义&#xa;核验标注准确性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="裁剪并平衡样本&#xa;从最早相关问题处开始&#xa;按视频时长比例抽样&#xa;场景多样性 · 任务平衡" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="固定公开 HF 版本&#xa;1,463 个视频 · 7,090 个问题&#xa;2 选项：1,774 · 3 选项：72&#xa;4 选项：5,244" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="选择评测上下文&#xa;使用同一批时间戳选择题&#xa;离线滑动窗口&#xa;在线流式输入" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="滑动窗口评测&#xa;取此前 32 秒&#xa;按 2 帧每秒采样&#xa;最多 64 帧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="流式评测&#xa;从片段起点到问题时间戳&#xa;按 2 帧每秒采样&#xa;累积当时可见上下文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="预测选择题答案&#xa;运行离线或在线多模态模型&#xa;保留每个子任务结果&#x