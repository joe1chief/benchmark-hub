    "modules": 0
  },
  "nodes": [
    {
      "id": "evidence",
      "label": "固定证据边界\narXiv 2407.01523v3 · 2024-11-12\nGit + 数据 88b5f09 · 1,082 行\nv3/数据 = 1,082；README 写 1,091\n代码 Apache-2.0 · 数据 CC BY-NC 4.0",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "document_route",
      "label": "文档来源？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "existing_docs",
      "label": "76 份已有数据集 PDF\nDUDE · SlideVQA\nChartQA · FinanceBench\n保留 >15 页；按来源下采样\n排除许可受限文档",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "new_docs",
      "label": "59 份新收集 PDF\n24 篇 arXiv 论文\n21 份指南 · 14 份宣传册\n来源 ManualsLib + Google 搜索\n人工检查学术使用可用性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "annotators",
      "label": "培训十名作者标注员\n医生/博士生 · 三份练习 PDF\n再执行 54 批 · 每批 2–4 份 PDF\n每份 PDF 投入 60–90 分钟\n每批复核并持续给出反馈",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "question_route",
      "label": "问题路径？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "new_questions",
      "label": "编写 965 道新题\n每份已有 PDF 约 3 题 · 新 PDF 约 6 题\n侧重跨页与不可回答问题\n平衡文本 · 布局 · 表格\n图表 · 图像及证据元数据",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "source_outcome",
      "label": "审核 425 道来源题\n六类缺陷：证据 · 重复\n歧义 · 需去语境化\n低相关性 · 捷径\n保留、修订还是移除？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "retain_source",
      "label": "保留\n不含阻断性缺陷\n保留答案与元数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "revise_source",
      "label": "修订 · 占 425 题的 32.2%\n纠正答案 / 证据\n去语境化或消除歧义",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "remove_source",
      "label": "移除 · 占 425 题的 46.1%\n重复 / 捷径或\n其他无法修复的缺陷",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "candidates",
      "label": "合并 1,176 道候选题\n211 道保留/修订题 + 965 道新题\n问题 + 简短答案\n证据页 / 来源 / 答案格式",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "relevance_gate",
      "label": "GPT-4o 不看 PDF\n能否答对？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "relevance_remove",
      "label": "质检一移除\n94 道低文档相关性题\n不纳入最终分母",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "reflection_gate",
      "label": "GPT-4o 查看 PDF 后\n是否与参考答案不一致？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reflection_revise",
      "label": "质检二：专家自我反思\n将不一致项返回原标注员\n13.8% 被认定为有问题\n必要时修订标注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "crosscheck_gate",
      "label": "独立标注员是否\n标记不一致？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "adjudicate",
      "label": "质检三：元标注\n17.5% 不一致 · κ = 0.42\n两名主要作者裁决\n必要时修订",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "MMLongBench-Doc v3\n135 份 PDF · 1,082 道题\n184 道来源题 + 898 道新题\n494 道单页 · 365 道跨页\n223 道不可回答",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "vision_input",
      "label": "LVLM 视觉路径\n每页以 144 DPI 渲染\nGPT-4o/GPT-4V/Gemini：逐页图像\nClaude：最多 20 张图\n开源模型：拼接为 1 或 5 张图",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ocr_input",
      "label": "OCR + LLM 路径\nTesseract 提取页面文本\n超出模型上下文即截断\n图表 / 图像信息仍有损\n仅为对比路径，不是金标准输入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extraction",
      "label": "先生成，再抽取\n提示：文档 + 问题；尽量简洁\n候选 T=0 · max_new_tokens=1024\nGPT-4o 输出“Extracted answer:”\n+“Answer format:”；T=0 · max_tokens=256",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_gate",
      "label": "两个标记切分后\n是否得到答案？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "local_zero",
      "label": "解析 / 抽取失败\n抽取器异常返回“Failed”\nrun_lvlm.py：“Failed to extract”→0\nrun_api.py：解析异常未捕获\nAPI 评测中止",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "answer_format",
      "label": "参考答案格式？\n忽略抽取器声明的格式",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "string_score",
      "label": "Str / None\n归一化大小写、单位、引号\n正则敏感值 → 精确相等\n否则 ANLS，阈值 τ = 0.5",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "integer_score",
      "label": "整数\n预测先转 float 再转 int\n精确相等，否则 0 分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "float_score",
      "label": "浮点数\n去除单位 / 百分号\n接受 x/100、x 或 100x\n相对容差为 1%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "list_score",
      "label": "列表\n对“[ … ]”预测执行 Python eval\n长度不同 → 0；元素排序\n数值/敏感值精确匹配，否则\n取成对 ANLS 的最小值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "广义指标\n准确率 = 1,082 个已评分行的均值\n正例召回率分母 = 859\n精确率分母 = 预测为正的行数\nF1 为调和平均；分组 494/365/223",
      "type": "terminal",
      "size": "xl"
    }
  ],
