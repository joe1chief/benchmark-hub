      "size": "xl"
    },
    {
      "id": "crosscheck",
      "label": "质检三：专家交叉检查\n标记 17.5% 不一致项\n一致性 Kappa 为 0.42\n由主要作者最终裁决",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "dataset",
