{
  "version": 1,
  "title": "MMLongBench-Doc v3 构建与评测流程",
  "type": "academic-diagram",
  "source": "edited",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 30,
