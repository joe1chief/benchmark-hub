{
  "version": 1,
  "title": "MMLongBench-Doc v3 Build and Evaluation Process",
  "type": "academic-diagram",
  "source": "edited",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 30,
    "edges": 38,
    "modules": 0
  },
  "nodes": [
    {
      "id": "evidence",
      "label": "Fixed Evidence Boundary\narXiv 2407.01523v3 · 12 Nov 2024\nGit + Data 88b5f09 · 1,082 Rows\nv3/Data = 1,082; README Says 1,091\nApache-2.0 Code · CC BY-NC 4.0 Data",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "document_route",
      "label": "Document Source?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "existing_docs",
      "label": "76 Existing-dataset PDFs\nDUDE · SlideVQA\nChartQA · FinanceBench\nKeep >15 Pages; Down-sample Sources\nExclude License-restricted Documents",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "new_docs",
      "label": "59 Newly Collected PDFs\n24 arXiv Papers\n21 Guidelines · 14 Brochures\nManualsLib + Google Search\nManually Check Academic Availability",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "annotators",
      "label": "Train Ten Author-Annotators\nDoctors/PhD Students · Three Practice PDFs\nThen 54 Batches · 2–4 PDFs Each\n60–90 Minutes per PDF\nReview Each Batch + Give Feedback",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "question_route",
      "label": "Question Route?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "new_questions",
      "label": "Author 965 New Questions\n≈3 per Existing PDF · ≈6 per New PDF\nFavor Cross-page and Unanswerable\nBalance Text · Layout · Table\nChart · Image + Evidence Metadata",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "source_outcome",
      "label": "Audit 425 Source Questions\nSix Defects: Evidence · Repetition\nAmbiguity · Decontextualization\nLow Relevance · Shortcut\nRetain, Revise, or Remove?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "retain_source",
      "label": "Retain\nNo Blocking Defect\nPreserve Answer + Metadata",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "revise_source",
      "label": "Revise · 32.2% of 425\nCorrect Answer / Evidence\nDecontextualize or Clarify",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "remove_source",
      "label": "Remove · 46.1% of 425\nRepetition / Shortcut or\nOther Unrepairable Defect",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "candidates",
      "label": "Merge 1,176 Candidates\n211 Retained/Revised + 965 New\nQuestions + Short Answers\nEvidence Pages / Sources / Format",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "relevance_gate",
      "label": "GPT-4o Correct\nwithout the PDF?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "relevance_remove",
      "label": "QC1 Removal\n94 Low Document-relevance Items\nExclude from Final Denominator",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "reflection_gate",
      "label": "GPT-4o with PDF\nDisagrees with Reference?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reflection_revise",
      "label": "QC2 Expert Self-reflection\nReturn Inconsistencies to Annotator\n13.8% Identified as Problematic\nRevise Annotation as Needed",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "crosscheck_gate",
      "label": "Independent Annotator\nFlags an Inconsistency?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "adjudicate",
      "label": "QC3 Meta-annotation\n17.5% Inconsistent · κ = 0.42\nTwo Primary Authors Decide\nRevise When Necessary",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "MMLongBench-Doc v3\n135 PDFs · 1,082 Questions\n184 Source + 898 New\n494 Single · 365 Cross-page\n223 Unanswerable",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "vision_input",
      "label": "LVLM Visual Route\nRender Every PDF Page at 144 DPI\nGPT-4o/GPT-4V/Gemini: Page Images\nClaude: At Most 20 Images\nOpen Models: Concatenate to 1 or 5",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ocr_input",
      "label": "OCR + LLM Route\nTesseract Extracts Page Text\nTruncate Beyond Model Context\nCharts / Images Remain Lossy\nComparison Route, Not Gold Input",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extraction",
      "label": "Generate then Extract\nPrompt: Document + Question; Be Concise\nCandidate T=0 · max_new_tokens=1024\nGPT-4o Emits “Extracted answer:”\n+ “Answer format:”; T=0 · max_tokens=256",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_gate",
      "label": "Both Marker Splits\nProduce an Answer?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "local_zero",
      "label": "Parse / Extractor Failure\nExtractor Exception Returns “Failed”\nrun_lvlm.py: “Failed to extract” → 0\nrun_api.py: Uncaught Parse Exception\nAPI Evaluation Aborts",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "answer_format",
      "label": "Reference Answer Format?\nExtractor-declared Format Is Ignored",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "string_score",
      "label": "Str / None\nNormalize Case, Units, Quotes\nRegex-sensitive → Exact Equality\nElse ANLS, Threshold τ = 0.5",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "integer_score",
      "label": "Int\nConvert Prediction through float → int\nExact Equality, Else 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "float_score",
      "label": "Float\nStrip Units / Percent Sign\nAccept x/100, x, or 100x\nRelative Tolerance = 1%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "list_score",
      "label": "List\nPython eval on “[ … ]” Prediction\nUnequal Length → 0; Sort Elements\nExact Numeric/Sensitive Else\nMinimum Pairwise ANLS",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Generalized Metrics\nAccuracy = Mean over 1,082 Scored Rows\nPositive Recall Denominator = 859\nPrecision Denominator = Predicted Positives\nF1 = Harmonic Mean; Groups 494/365/223",
      "type": "terminal",
      "size": "xl"
    }
  ],
