    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1608" pageHeight="2288" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="复用合格的公开标注&#xa;多场景 OCR 基准&#xa;受限类别 KIE 数据集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="304" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="重新标注选定公开数据&#xa;多语言图像与开放类别 KIE&#xa;把标签提升到 LMM 评测质量" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="新采集真实应用图像&#xa;全部中文多场景与文档解析数据&#xa;实拍文档、自然场景、网页与手写图像" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="合并复用数据与新复核数据&#xa;文档 52.5% • 自然场景 36.8% • 网页 7.8%&#xa;41% 为首次发布的真实应用图像" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="赛道 1：多场景文字识别&#xa;印刷