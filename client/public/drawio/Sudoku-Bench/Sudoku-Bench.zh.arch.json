  "nodes": [
    {
      "id": "puzzle_sources",
      "label": "专业数独题目库\nCracking the Cryptic (CTC) 独家变体与 Nikoli 经典档案\n由世界顶级出题专家 Simon Anthony 与 Mark Goodliffe 策划",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "variant_diversity",
      "label": "变体规则与约束规范\n温度计、杀手框、德国低语线、箭头线与回文线\n将视觉线条与区域几何约束转化为精确坐标拓扑关系",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sudokupad_export",
      "label": "SudokuPad 纯文本编码转换\n将交互式 SudokuPad JSON 转换为纯文本格式的题目定义\n编码棋盘维度、初始已知数与空间约束线条坐标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "solvability_gate",
      "label": "唯一有效解验证？\n运行精确覆盖求解器 (Knuth Algorithm X) 与人工求解校验\n确保每道题目存在且仅存在唯一步骤确定解，无解分支歧义",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_discard",
      "label": "无效/多解题目剔除\n剔除多解、无解或约束编码损坏的不合规候选题目\n保障基准测试具备严格确定性的逻辑可解性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "difficulty_stratification",
      "label": "五级难度梯度标定\n按照 1 星（入门级）至 5 星（大师级）进行分层校准\n覆盖 15 道 4×4、15 道 6×6 以及 70 道 9×9 挑战题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "challenge_freeze",
      "label": "Sudoku-Bench 核心冻结集\n包含 100 道核心评估题目及规范标准解答棋盘\n另附独立 Nikoli-100 与 CTC 视频解题轨迹研究资产",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "文本题目呈现与提示组装\n零样本提示详细说明变体规则、网格尺寸与初始填数\n严格禁止调用外部求解器插件或执行 Python 代码",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "eval_mode_routing",
      "label": "评测模式选择？\n多轮交互式逐步求解 vs 单轮整盘一次性求解\n检验分步局部战术推理能力与全局整体求解规划能力",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "singleshot_inference",
      "label": "单轮自主模型推理\n模型在单次对话中直接输出整盘完整填数解\n各基础推理模型采用贪婪解码策略 (T=0)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "singleshot_gate",
      "label": "完整棋盘与标准答案完全匹配？\n逐行、逐列、逐宫及变体约束进行逐格等价性校验\n对任何错填、漏填或规则违规采取零容忍判定",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "multistep_turn",
      "label": "多轮分步交互推理\n模型每轮输出至少一个坐标单元格填数 (r, c) = d\n滑动上下文窗口保留初始题目规则及最近 5 轮历史轨迹",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_validity_gate",
      "label": "本轮填数与标准答案一致？\n自动化校验器对比模型当前提交填数与标准解\n还原真实人类数独逻辑推演过程的严谨性",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "early_termination",
      "label": "首错即停终止池\n一旦模型出现首次错误填数或冲突推断立即终止评测\n记录该题在发生错误前已正确填入的数字总数",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "board_update_loop",
      "label": "棋盘状态动态更新\n将合规填数持久化写入棋盘状态并请求下一步逻辑推导\n循环执行填数推理直到棋盘完全解出或触发错误终止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics_reporting",
      "label": "Sudoku-Bench 官方指标报告\n完全求解率 (% 无错解出整盘题目的比例)\n各难度等级下模型在终止前正确填入数字的平均数量",
      "type": "terminal",
      "size": "xl"
    }
  ],
