  "nodes": [
    {
      "id": "putnam_archive",
      "label": "普特南数学竞赛官方题库归档\n640 道题目源自 MAA 官方历史题卷（1962–2023）\n涵盖代数、分析、数论、几何与组合数学等领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "solution_factoring",
      "label": "答案提取与问题解耦重构\n将闭式解从定理陈述中分离（约占 60% 题目）\n保留探索未知解与形式化验证证明的双重挑战",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "formal_lean4",
      "label": "Lean 4 人工形式化构建\n数学专家编写的 640 道 Lean 4 形式化规约\n深度复用 Mathlib 核心数学库的定义、策略与类型系统",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "formal_isabelle",
      "label": "Isabelle/HOL 人工形式化构建\n640 道平行的 Isabelle/HOL 形式化命题规约\n将类型论构造精确适配到高阶逻辑证明框架中",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "formal_coq",
      "label": "Coq/Rocq 人工形式化构建\n412 道基于 Coq 构造性类型论的形式化规约\n严谨表征基础代数引理与实分析性质证明",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "peer_verification",
      "label": "双人独立交叉审核门禁\n第二位专家严格核验形式化命题与 MAA 原文的语义等价性\n验证语法有效性与定理可证明性",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "putnam_freeze",
      "label": "PutnamBench 多证明语言形式化基准冻结\n跨越 640 道题目的 1,692 套多语言形式化代码全集\n支持 Task 1（求解并证明）与 Task 2（仅形式化证明）",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_branching",
      "label": "形式化证明提示词封装\nTask 1: 模型推导数值解、补全定理命题并撰写完整证明\nTask 2: 直接提供带答案的标准命题，模型仅撰写证明策略",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "prover_generation",
      "label": "形式化证明自回归生成\n利用大语言模型自回归生成形式化证明策略与脚本\n支持单次尝试或 Pass@n 采样生成（如 n=10，T=0.7）",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "compiler_sandbox",
      "label": "交互式定理证明器隔离沙箱\n执行 Lean 4 lake build、Isabelle 或 Coq coqc 编译\n设置严格超时与容器资源隔离以保证评测安全性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "kernel_verification_gate",
      "label": "证明内核严格校验通过？\n证明助手微内核进行严格类型检查与 Q.E.D. 完备性验证\n杜绝任何幻觉，保障 100% 数学无误",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "certified_sink",
      "label": "形式化严格认证证明\n内核判定证明通过且不含 sorry、admit 等跳步占位符\n计为该题成功解出（得分 = 1）",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "kernel_failure_sink",
      "label": "类型检查/编译失败分支\n策略报错、存在未证明目标、执行超时或语法错误\n被证明器内核判定为失败（得分 = 0）",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "PutnamBench 证明评测指标汇总\nPass@1 与 Pass@n 形式化定理证明准确率\n按 Lean 4、Isabelle 与 Coq 语言维度分项对比",
      "type": "terminal",
      "size": "xl"
    }
  ],
