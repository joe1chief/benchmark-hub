      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_team",
      "label": "人工形式化团队\n2 名博士生 + 5 名本科生\n具备数学、计算机和证明助手经验\n每题每语言平均约 25 分钟",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "lean_forms",
      "label": "首先用 Lean 4 形式化\n论文记录 640 份\n使用 Mathlib 定义\n全部人工构造",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "isabelle_forms",
      "label": "随后用 Isabelle 形式化\n论文记录 640 份\n适配 HOL 基础\n并非机械翻译",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "coq_forms",
      "label": "最后用 Coq 形式化\n论文记录 412 份\nMathComp · Coquelicot · GeoCoq\n按语言特性适配",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "second_person_verify",
      "label": "独立同伴复核\n每份形式化至少由\n第二个人检查一次\n平均约 10 分钟",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_dataset",
      "label": "PutnamBench 论文口径\n640 道问题\nLean 640 + Isabelle 640 + Coq 412\n共 1,692 份形式化",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_gate",
      "label": "选择评测任务\n解答析出问题支持\n两种不同设置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_one",
      "label": "任务一\n推断闭式解答\n将其改写进定理\n再证明正确性\n论文基线未评测此任务",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "task_two",
      "label": "任务二\n已给出定理与解答\n生成一份证明\n证明其正确性",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "prover_attempts",
      "label": "生成证明尝试\n每题最多 n 次尝试\n论文 GPT-4o 基线为 pass@10\n温度 0.7",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "proof_check",
      "label": "在 Lean 4 · Isabelle · Coq\n执行候选证明\n由目标证明助手认证\n成功或失败",
