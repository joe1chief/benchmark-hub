  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1992" pageHeight="1096" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="LogiQA 原始测试题对&#xa;英文 651 题 · 中文 651 题&#xa;篇章 · 问题 · 四个选项&#xa;标准选项索引" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="按源数据顺序取前 N 题&#xa;单任务数据集抽样规则&#xa;发布 ID 为 0–103 且有空缺&#xa;最终目标为 80 道题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="272" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="固定十种语言&#xa;英 · 中 · 阿 · 西 · 日&#xa;韩 · 泰 · 法 · 葡 · 越&#xa;覆盖七个语言家族" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="512" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="翻译另外八种语言&#xa;GPT-4o-2024-05-13&#xa;保留原始英文与中文&#xa;翻译完整四选一记录" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="专业翻译团队复核&#xa;穷尽式审核每条机器译文&#xa;检查含义与术语&#xa;检查文化适