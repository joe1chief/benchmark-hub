dedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1712" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="按 ID 对齐平行记录&#xa;连接前规范化 ID 类型&#xa;禁止按文件行序直接配对&#xa;各语言 ID 集与标准答案一致" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1472" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="发布 MLogiQA 测试集&#xa;每种语言 80 道测试题&#xa;十个语言文件&#xa;共 800 条测试实例" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1232" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="比较三种提示设定&#xa;EN · 英文指令&#xa;Native · 目标语言指令&#xa;EN-Few-shot · 目标语言示例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="992" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="发布的验证记录&#xa;每种语言八条验证题&#xa;主要用于提供示例&#xa;论文未说明每次提示使用的 k" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="992" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="生成直接答案&#xa;MLogiQA 不使用 CoT&#xa;篇章 · 问题 · A–D&#xa;要求固定 JSON 答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="推理边界&#xa;解码参数未披露&#xa;论文未给出 MLogiQA 专用&#xa;温度或 Token 上限" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="OpenCompass 0.3.7 边界&#xa;HF 行使用 options 数组&#xa;配置却要求四个编号选项字段&#xa;仅 EN 零样本 · ZeroRetriever" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1232" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="解析最后一个 JSON 或母语短语匹配&#xa;JSON 正则仅接受大写 A–D&#xa;母语短语可能产出小写 a–d&#xa;比较时忽略大小写；否则 None" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="512" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="成功抽取选项？&#xa;A · B · C · D" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="272" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="无法解析：发布代码失败路径&#xa;代码把 None 交给模糊扫描&#xa;不可解析输出触发 TypeError&#xa;未修补代码则没有分数" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="272" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="已抽取：计算各语言准确率&#xa;正确选项数 ÷ 全部 80 题&#xa;错误选项计 0 分&#xa;百分比保留两位小数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="计算 CACR 英→目标语言&#xa;英文答对题中两语均答对的比例&#xa;使用平行对齐后的 ID&#xa;报告迁移一致性" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="分析代码边界&#xa;论文 Formula 1 定义 CACR&#xa;OpenCompass 0.3.7&#xa;未发布 CACR 实现" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="912" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="访问与权利边界&#xa;P-MMEval 卡片：Apache-2.0&#xa;LogiQA 仓库无 LICENSE 文件&#xa;无专用排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=A