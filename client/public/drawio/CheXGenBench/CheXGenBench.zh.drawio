ine=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="在固定测试提示上生成&#xa;保存提示与合成图像元数据&#xa;统一使用 5,034 图像测试划分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="保真度 + 模式覆盖&#xa;RadDino FID/KID + PRDC&#xa;BioViL-T 图文对齐&#xa;整体 + 分病理条件分析" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="隐私 + 患者重识别&#xa;最近训练图像：像素距离&#xa;RadDino 潜空间距离&#xa;Siamese 重识别：均值 • 最大值 • 计数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="分类效用&#xa;20K 真实 + 20K 合成；ResNet-50&#xa;训练 20 轮；在 5,034 个真实样本测试&#xa;Accuracy • F1 • AUROC" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id=