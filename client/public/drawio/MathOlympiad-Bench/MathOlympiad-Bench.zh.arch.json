  "nodes": [
    {
      "id": "sources",
      "label": "汇集现有形式化题目\n来源为 Compfiles 与 IMOSLLean4\n聚焦奥林匹克级数学题\n保留非形式化原题文本",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "composition",
      "label": "汇总竞赛覆盖范围\n158 道 IMO 正赛题，1959–2024\n131 道 IMO 候选题，2006–2023\n68 道全国奥赛题与 3 道谜题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "issue_gate",
      "label": "来源记录是否存在问题？\n陈述不完整、分散于多文件\n含多个定理或不兼容 Mathlib",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "repair",
      "label": "由人工整理记录\n补全题目陈述\n合并定义与依赖\n拆分定理并修复 Mathlib 兼容性",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "规范化单条基准记录\n仅保留一个形式化定理\n配对一个对应的非形式化陈述\n保持题意与假设不变",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "compile_statement",
      "label": "核验形式化语句\n将证明替换为 by sorry\n在目标 Mathlib 环境中编译\n检查语法与环境依赖",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "statement_gate",
      "label": "语句使用 sorry 占位后\n是否能够编译？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MathOlympiad-Bench\n共 360 条人工核验记录\n每条含形式定理与非形式化陈述\n覆盖代数、数论、组合与几何",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "overlap_audit",
      "label": "审核重叠的 IMO 题\n与 MiniF2F 对照\n至少发现三处后者陈述偏弱或不符\n本基准未观察到同类问题",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "setup",
      "label": "准备形式证明评测\n使用 Lean 4.9.0-rc1\n提供完整上下文与待证定理\n独立采样 N 次证明尝试",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "首轮生成整段证明\n论文上限为 30,000 词元\n从模型输出提取证明\n组装候选 Lean 文件",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "proof_gate",
      "label": "Lean 是否完整编译通过\n且不含 apply? 或 exact? 策略？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "pass_sample",
      "label": "接受本次证明尝试\n记录一个成功样本\n停止修正该次尝试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "correction_gate",
      "label": "是否启用自我修正\n且尚未用完两轮修复？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise",
      "label": "根据验证器反馈修正\n输入上一版输出与 Lean 错误\n生成下一版证明\n总输出预算为 40,000 词元",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fail_sample",
      "label": "将本次尝试记为失败\n标准模式或已达到修复上限",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "汇总 Pass@N\nN 次尝试至少一条成功则该题通过\n主要比较采用 N = 32\n分别报告直接生成与自我修正",
      "type": "terminal",
      "size": "xl"
    }
  ],
