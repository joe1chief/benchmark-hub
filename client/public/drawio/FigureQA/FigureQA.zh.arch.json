      "size": "xl"
    },
    {
      "id": "render",
      "label": "渲染 5 类：垂直柱图 / 水平柱图\n折线 / 点线 / 饼图 · 白色背景\n随机字体、网格线、宽度与图例",
      "type": "process",
      "size": "xl"
