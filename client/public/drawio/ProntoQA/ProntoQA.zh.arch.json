  "nodes": [
    {
      "id": "step_1",
      "label": "定义受控推理任务\n证明仅使用连锁肯定前件\n每题要求唯一标准证明\n句子保持易于语义解析",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "生成线性本体\n从先验抽取3至10个概念\n添加子类关系与概念属性\n每个节点最多一个子节点",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "选择本体条件\n使用虚构概念名称\n使用符合现实的真实本体\n使用随机反事实错误本体",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "初始化形式证明\n均匀随机选择起始节点\n把一个实体赋给该概念\n建立初始逻辑公理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "沿本体向上遍历\n每一跳应用一次推理规则\n到目标节点或属性时停止\n控制1跳 · 3跳 · 5跳证明",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "渲染自然语言上下文\n用语法映射每条边和属性\n使用句法简单的表达变体\n保持唯一的反向解析",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "控制上下文难度\n添加干扰句阻断捷径\n自顶向下或自底向上排序\n测试规划而非知识检索",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "创建查询与二元标签\n陈述证明中的初始实体事实\n以0.5概率询问结论或其否定\n标注True或False",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "生成标准思维链\n翻译每个证明步骤的结论\n每个形式步骤对应一句话\n保存上下文 · 查询 · CoT · 标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "执行8-shot思维链评测\n独立生成上下文示例\n追加一个不含答案的测试题\n解码模型思维链与标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "符号解析预测思维链\n反向应用同一套简单语法\n使用递归下降语义解析\n恢复逻辑形式序列",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "分类每个证明步骤\n判断严格有效或广义有效\n判断原子步骤或跨步推理\n标记正确路径 · 误导 · 无效",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "对照标准证明\n检查是否推出目标结论\n比较模型预测的二元标签\n区分局部推理与规划错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告形式推理指标\n标签准确率 · 严格证明准确率\n跨步 · 广义 · 有效证明准确率\n按跳数顺序与本体拆分",
      "type": "terminal",
      "size": "xl"
    }
  ],
