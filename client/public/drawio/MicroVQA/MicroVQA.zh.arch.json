  "nodes": [
    {
      "id": "tasks",
      "label": "定义三类科研任务\n访谈九名显微研究 PI 与博士后\n专家图像理解\n假设生成 · 实验方案设计",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "experts",
      "label": "招募 12 名生物学专家\n覆盖不同显微研究领域\n每名专家约 90 条样本\n估计专家总工时约 600 小时",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "images",
      "label": "汇集可再分发图像\n贡献者自有实验\n开放数据库与 CC-BY 论文\n2024 年 1 月以后发表的文献",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "raw",
      "label": "创建 1,061 条原始 VQA\n每题最多六张 RGB 图或视频帧\n问题 · 详细答案 · 干扰项\n实验背景与研究动机",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "审核贡献者样本质量\n研究难度 · 任务对齐 · 图像多样性\n正文称第 10 与第 40 条后反馈\n附录 E.1 称先审四至六条",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold",
      "label": "创建 50 道金标多选题\n由医师科学家主导设计\n遵循 NBME 单一最佳答案格式\n保留原始问答目标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dspy",
      "label": "优化第一阶段提示\nDSPy MIPROv2 · 思维链 + RAG · o1-mini\n裁判语义 · NBME 格式 · 多余线索\n语义保持权重最高",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "stage1",
      "label": "生成第一阶段考试式多选题\n保留科学语义\n形成单一最佳答案\n添加可信且长度相近的干扰项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "refine",
      "label": "执行一次 RefineBot 尝试\nGPT-4o 无图评测器 + 反思器\n改写器累计利用历轮反思\n等价性检查 · 最多五轮",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "refine_gate",
      "label": "RefineBot 尝试成功吗？\n评测器答错 · 改写语义保持",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "dual_gate",
      "label": "最终难度门槛通过吗？\n两个指定模型均失败 · 两种子",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "gate_models",
      "label": "最终门槛模型对\nGPT-4o-2024-08-06\nClaude-3.5-Sonnet-20241022",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "rerun",
      "label": "以新随机种子重跑整个 RefineBot\n论文未给出总重跑次数上限\n部分题目最终仍无法通过",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "stage1_fallback",
      "label": "保留第一阶段多选题\n用于始终无法通过 RefineBot 的题目\n不采用未成功的第二阶段改写",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual",
      "label": "原创建者复核最终多选题\n全量复核发布的 1,042 题\n检查正确答案与干扰项\n发现问题时做最小修正",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attrition",
      "label": "构建计数边界\n1,061 条原始样本 → 1,042 道发布题\n论文与数据卡均未披露\n19 条样本的流失规则",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MicroVQA 测试集\n1,042 道多选题 · 423 道多图题\n三类科学推理任务\n数据采用 CC BY-SA 4.0",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_prompt",
      "label": "构造论文评测提示\n图像 + 问题 + 从一编号的选项\nLLaVA 系列外采用 MMMU-Pro 思维链\n要求输出“The answer is (X)”",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "解析首个精确答案匹配\n区分大小写的“answer is”加一位数字\n允许可选粗体与括号\n序号减一 · 无匹配记为负一",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "汇总官方指标\n全部发布样本上的平均准确率\n缺失或格式错误输出均记错\n分任务 · 无图 · 仅选项分析",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "scaffold_gap",
      "label": "固定评测器复现边界\n论文给出 LLaVA 专用前缀与后缀\n当前代码对所有模型使用同一提示\nCLI 读 test · 批量辅助函数请求 train",
      "type": "document",
      "size": "xl"
    }
  ],
