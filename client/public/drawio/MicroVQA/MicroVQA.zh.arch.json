    {
      "id": "experts",
      "label": "招募 12 名生物学专家\n覆盖不同显微研究领域\n每名专家约创建 90 条\n估计专家总投入约 600 小时",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "images",
      "label": "收集可再分发图像\n贡献者自己的实验\n图像数据库\n2024 年以来发表的研究论文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "raw",
      "label": "创建 1,061 条原始 VQA\n图像组 · 问题 · 详细回答\n实验上下文与提问动机\n每条耗时 30 至 40 分钟",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "检查贡献者样本质量\n研究级难度\n任务对齐 · 图像内容多样性\n第 10 条和第 40 条后反馈",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold",
      "label": "创建 50 道金标 MCQ\n由医师科学家主导设计\n人工转换原始问答对\n遵循 NBME 与 Bloom 原则",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dspy",
      "label": "优化第一阶段提示\n用金标 MCQ 监督 DSPy\n内容相似度 · NBME 格式\n惩罚额外作答线索",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "stage1",
      "label": "生成考试风格 MCQ\n保留原问答语义\n形成唯一最佳答案\n增加可信干扰项",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reflect",
      "label": "运行 RefineBot 评估与反思器\n不看图像用思维链作答\n暴露仅靠语言的捷径\n总结被利用的策略",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rewrite",
      "label": "改写薄弱 MCQ\n替换容易排除的干扰项\n检查器确保语义等价\n迭代至变难或达到次数上限",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "seeds",
      "label": "执行最终难度门槛\n失败题更换随机种子重跑\nGPT-4o 与 Claude 3.5 各两个种子\n要求两个模型均回答错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual",
      "label": "专家复核每道最终 MCQ\n原创建者检查正确性\n发现问题时做最小修改\n全量复核最终 1,042 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MicroVQA\n1,042 道专家整理 MCQ\n明场 · 荧光 · 电子显微图像\n覆盖三类科学推理任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "评测多模态模型\n采用 MMMU-Pro 思维链提示\n解析数字形式最终答案\n报告分任务准确率与无图消融",
      "type": "terminal",
      "size": "xl"
    }
  ],
