    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2920" pageHeight="632" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="100 个常见领域名称&#xa;作为有状态应用领域种子&#xa;用于 Self-Instruct 扩展" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Self-Instruct 场景扩展&#xa;领域名称 → 应用描述&#xa;有状态 CRUD 工作流" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="场景筛选 + 去重&#xa;CRUD 分类器 • 嵌入余弦阈值 0.85&#xa;通过类别上限保证多样性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="ClassBench：音乐学校排课与考勤&#xa;发布场景 ID：scheduling&amp;#95;2&#xa;单个 AWM 环境，不是独立基准" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="10 个 API 可解用户任务&#xa;登录后场景 • 自包含&#xa;任务定义后端所需行为" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="最小 SQLite Schema + 样例数据&#xa;满足每个任务的执行前提&#xa;不含认证字段" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="两阶段接口合成&#xa;API 规格 → Python 实现&#xa;暴露 MCP 工具 + FastAPI 服务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="每个任务一个验证器&#xa;比较初始与最终数据库状态&#xa;结构化信号 + 成功准则&#xa;代码增强 LLM 判分器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="隔离执行每个组件&#xa;Schema / 数据错误率须低于 10%&#xa;须达到 0% 环境启动错误率&#xa;测试数据库 • 接口 • 验证器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id