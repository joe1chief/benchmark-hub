      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "随 AgentWorldModel-1K 发布\n属于 1,000 个环境与 10,000 个任务\n数据库 + 工具 + 任务 + 验证逻辑",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "run",
