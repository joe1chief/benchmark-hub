      "type": "process",
      "size": "xl"
    },
    {
      "id": "verifier",
      "label": "生成任务专属验证逻辑\n比较执行前后的数据库状态\n代码增强 LLM-as-a-Judge 奖励",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execute",
