<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3344" pageHeight="696" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据边界&#xa;arXiv:2503.13646v1&#xa;仓库 @ 7022ba7&#xa;数据集 v1.0 · JSON SHA adc9e7d" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Ego4D 源视频&#xa;多样真实场景&#xa;带时间戳的第一人称叙述 (Nj, tj)" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="为每条叙述推导时间窗口&#xa;Tj = tj ± βi / (2α)&#xa;βi：局部平均时间戳间隔&#xa;α：这些间隔的全局平均值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="合并连续叙述片段&#xa;达到 120 条叙述或 120 秒即停止&#xa;源短片段平均约 5 秒" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Gemini 1.5 Pro 零样本视频描述&#xa;输入：片段 + Ego4D 叙述&#xa;补充叙述中缺失的背景上下文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="用 Gemini 1.5 Pro 生成 10 类开放式问答&#xa;动作：顺序 · 计数 · 事件次序 · 未来预测&#xa;特定物体动作 · 物体顺序 · 物体计数&#xa;空间关系 · 物体定位 · 特定动作物体" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="人工对照视频复核&#xa;必须依赖多帧信息&#xa;问题与答案必须逻辑一致&#xa;剔除无关或缺少时序复杂度的样本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Gemini 单帧捷径门禁&#xa;剔除单帧即可回答的问答&#xa;策展门禁所用帧未披露&#xa;评测单帧设置使用中心帧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="论文：EgoTempo 开放式问答基准&#xa;500 个问答 · 10 类各 50 个&#xa;221 段视频的 365 个片段 · 40 个场景&#xa;3–140 秒 · 平均 45 秒" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="固定 v1.0 JSON 审计&#xa;500 行 · 367 个唯一 clip_id&#xa;222 个唯一 video_uid&#xa;发布数量与论文不一致" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="受控证据设置&#xa;使用相同问题与参考答案" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="纯文本&#xa;诊断语言或常识捷径" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="单个中心帧&#xa;诊断静态视觉捷径" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="均匀采样的多帧&#xa;采样率 S = 0.1、0.5、1 FPS&#xa;固定帧数与顺序消融另行开展" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="多模态大模型开放式预测&#xa;覆盖闭源与开源视频模型&#xa;Gemini 实验使用 1.5 Flash&#xa;不使用生成数据的 Pro" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="论文协议：Gemini 1.5 Pro 评审&#xa;预测 + 参考答案 → 正确或错误&#xa;同时返回判定理由&#xa;固定仓库 notebook 则默认 Flash" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="报告各能力与总体准确率&#xa;报告各证据设置的绝对分数&#xa;视频增益 = Accuracy(S) / 单帧准确率" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3064" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=