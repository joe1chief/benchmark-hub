      "module": "construction",
      "size": "xl"
    },
    {
      "id": "variant_sources",
      "label": "Harder / More Diverse Variants\nAMPS · Big-Bench Hard · IFEval\nProcedural Synthetic Tasks\nNot New-source-only",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "construct_tasks",
      "label": "Task-specific Construction\nAPIs · Sampling · Scripts · Authoring\nPaper: 40–100 Questions per Task\nTarget ≈30–70% Frontier Success",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "objective_gate",
      "label": "Objective Ground Truth\nand Automatic Scorer?",
      "type": "decision",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "reject_task",
      "label": "Reject Subjective or\nUnverifiable Task\nNo Human / LLM Preference Judge",
      "type": "document",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "prompt_contract",
      "label": "Write Task-specific Prompt\nZero-shot CoT · Best Guess\nExplicit Parsable Final Answer\nXML Tags / Bold / Exact Format",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "validate_questions",
      "label": "Validate Questions + Ground Truth\nGeneration-script Checks\nAuthor Inspection and Task QC\nKeep Diverse Difficulty",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "paper_snapshot",
      "label": "Paper v2 / ICLR 2025 Snapshot\n18 Tasks · 6 Categories\n1,000 Questions after Update 1\nEnglish · Test-only Benchmark",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "update_select",
      "label": "Select Tasks to Refresh\nOldest · Easiest · Suspected Leakage\nPaper Policy: Monthly Updates",
      "type": "process",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "regenerate",
      "label": "Regenerate / Replace Questions\n≈1/6 per Paper Update\nChange Generator for Harder Drift\nRerun All Models after Update",
      "type": "process",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "version_tags",
      "label": "Version Every Question\nRelease Date · Removal Date\nSelect a Dated Benchmark Release",
      "type": "document",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "public_release",
      "label": "Public Questions / Prior Releases\nCode + Some Data on GitHub / HF\nPaper: New Batch Public after 1 Month",
      "type": "database",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "private_window",
      "label": "Newest Questions Withheld\nUsed by Official Leaderboard\nPaper Target: ≈1/6 Private\nExact Private Subset Not Public",
      "type": "database",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "current_snapshot",
      "label": "Official Site · 2026-06-25\n23 Task Columns · 7 Categories\nCanonical Cost Basis: 1,270 Questions\n1,198 Regular + 72 Agentic v2",
      "type": "database",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "release_drift",
      "label": "Version Drift — Do Not Conflate\nPaper: 18 / 6 · Monthly ≈1/6\nSite: 23 / 7 / 1,270 · Full Refresh ≈6 Months\nREADME / Public HF Lag Latest Site",
      "type": "document",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "release_select",
      "label": "Choose Benchmark Release\nOfficial Code Supports 11 Dates\nThrough 2026-06-25 at Code Pin",
      "type": "user",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "load_filter",
      "label": "Load Version-valid Questions\nRelease Date ≤ Selected Date\nRemoval Date Empty or Later\nQuestion IDs Must Be Unique",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "eval_route",
      "label": "Agentic Coding Category?",
      "type": "decision",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "standard_infer",
      "label": "Standard Model Inference\nPaper: Single-turn · T=0\nCode Base Fallback: T=0\nModel/Q/CLI/Provider Config\nExamples: T=0.7 / 1.0",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "agentic_infer",
      "label": "Current Agentic Coding v2\nMini-SWE-Agent in Docker\nPatch Real Repositories\nCurrent Agent Cap: 250 Steps",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "standard_scorer",
      "label": "Store Answer + Metadata\nTask-specific Objective Evaluator\nRegex / Exact / Fuzzy / Edit-distance\nTests / IF Verifiers · Fractional OK",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "agentic_scorer",
      "label": "Apply Patch + Run Repository Tests\nFAIL_TO_PASS + PASS_TO_PASS\nResolved = 1 · Unresolved / No Patch = 0\nInfra / Flaky: Retry or Skip",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "question_score",
      "label": "Branch-specific Judgment Merge\nStandard: Task-specific Score in [0, 1]\nAgentic: Resolved 1 / Unresolved 0\nKeep Evaluation-status Metadata",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "score_audit",
      "label": "Standard-parser Manual QC\nSample Incorrect Standard Outputs\nBroaden Fair Parsers if Needed\nRescore Standard Models after Changes",
      "type": "user",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "task_average",
      "label": "Mean Question Scores\n→ Task Score",
      "type": "process",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "category_average",
      "label": "Equal Mean of Task Scores\n→ Category Score",
      "type": "process",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "overall_average",
      "label": "Equal Mean of Categories\nPaper: 6 · Current Site: 7\n→ LiveBench Score",
      "type": "process",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "leaderboard",
      "label": "Release-specific Leaderboard\nTask · Category · Overall Breakdown\nNever Merge Scores across Releases",
      "type": "terminal",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "Public / Withheld Boundary\nRepo + Older HF Data Are Public\nLatest Questions Are Not Public\nNo Frozen Public Full 2026 Corpus",
      "type": "document",
      "module": "evidence_boundary",
      "size": "xl"
    },
    {
      "id": "evidence_pins",
      "label": "Evidence Freeze · 2026-07-21\nPaper v2 · Code 4bf3d6f4\nSite f2e0b4bc · Cost SHA 09ffc358\nPublic HF Sets Changed 2025-04",
      "type": "document",
      "module": "evidence_boundary",
      "size": "xl"
    }
