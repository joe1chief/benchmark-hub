  "nodes": [
    {
      "id": "recent_sources",
      "label": "近期信息来源\n数学竞赛 · arXiv · 新闻\nKaggle / Socrata · 电影 · 代码\n每版冻结来源日期",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "variant_sources",
      "label": "更难 / 更多样的任务变体\nAMPS · Big-Bench Hard · IFEval\n程序化合成任务\n并非全部来自新信息源",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "construct_tasks",
      "label": "按任务构造题目\nAPI · 采样 · 脚本 · 人工作者\n论文：每任务 40–100 题\n目标：前沿模型约 30–70% 成功率",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "objective_gate",
      "label": "有客观真值\n且可自动评分？",
      "type": "decision",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "reject_task",
      "label": "淘汰主观或\n无法核验的任务\n不采用人类 / LLM 偏好 Judge",
      "type": "document",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "prompt_contract",
      "label": "编写任务专用提示\n零样本 CoT · 不会则猜\n明确可解析终答格式\nXML 标签 / 加粗 / 精确格式",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "validate_questions",
      "label": "核验题目与真值\n生成脚本自动检查\n作者检查与任务质检\n保持难度多样性",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "paper_snapshot",
      "label": "论文 v2 / ICLR 2025 快照\n18 个任务 · 6 个类别\n首次更新后共 1,000 题\n英文 · 仅测试用途",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "update_select",
      "label": "选择需要更新的任务\n最旧 · 最易 · 疑似泄漏\n论文策略：每月更新",
      "type": "process",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "regenerate",
      "label": "重生成 / 替换题目\n论文每次平均约替换 1/6\n修改生成器并逐步加难\n更新后重跑全部模型",
      "type": "process",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "version_tags",
      "label": "为每题维护版本\n发布日期 · 移除日期\n按日期选择基准版本",
      "type": "document",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "public_release",
      "label": "公开题目 / 历史版本\nGitHub / HF 公开代码与部分数据\n论文：新批次延迟 1 个月公开",
      "type": "database",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "private_window",
      "label": "最新题目暂不公开\n用于官方排行榜\n论文目标：约 1/6 私有\n私有子集精确数量未公开",
      "type": "database",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "current_snapshot",
      "label": "官网版本 · 2026-06-25\n23 个任务列 · 7 个类别\n标准成本基数：1,270 题\n1,198 常规 + 72 Agentic v2",
      "type": "database",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "release_drift",
      "label": "版本漂移 · 不得混写\n论文：18 / 6 · 每月约 1/6\n官网：23 / 7 / 1,270 · 约 6 个月全刷新\nREADME / 公开 HF 落后于官网",
      "type": "document",
      "module": "maintenance",
      "size": "xl"
    },
    {
      "id": "release_select",
      "label": "选择基准版本\n固定代码支持 11 个日期\n截至 2026-06-25",
      "type": "user",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "load_filter",
      "label": "加载该版本有效题目\n发布日期 ≤ 所选日期\n未移除或移除日期更晚\n题目 ID 必须唯一",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "eval_route",
      "label": "属于 Agentic Coding？",
      "type": "decision",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "standard_infer",
      "label": "标准模型推理\n论文：单轮 · T=0\n代码基础回退：T=0\n模型/题/CLI/服务商配置\n示例：T=0.7 / 1.0",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "agentic_infer",
      "label": "当前 Agentic Coding v2\nDocker 内运行 Mini-SWE-Agent\n修改真实代码仓库\n当前 Agent 上限 250 步",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "standard_scorer",
      "label": "保存答案与元数据\n任务专用客观评分器\n正则 / 精确 / 模糊 / 编辑距离\n测试 / IF 核验器 · 可得小数分",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "agentic_scorer",
      "label": "应用补丁并运行仓库测试\nFAIL_TO_PASS + PASS_TO_PASS\n已解决 = 1 · 未解决 / 无补丁 = 0\n基础设施 / Flaky：重试或跳过",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "question_score",
      "label": "汇合两分支逐题判定\n标准：任务专用得分 [0, 1]\nAgentic：已解决 1 / 未解决 0\n保留评测状态元数据",
      "type": "process",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "score_audit",
      "label": "标准解析器人工质检\n抽查标准任务错误答案\n必要时扩展公平解析规则\n规则更新后重评标准任务模型",
      "type": "user",
      "module": "evaluation",
      "size": "xl"
    },
    {
      "id": "task_average",
      "label": "逐题得分取均值\n→ 任务分",
      "type": "process",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "category_average",
      "label": "任务分等权平均\n→ 类别分",
      "type": "process",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "overall_average",
      "label": "类别分等权平均\n论文 6 类 · 当前官网 7 类\n→ LiveBench 总分",
      "type": "process",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "leaderboard",
      "label": "特定版本排行榜\n任务 · 类别 · 总分明细\n不把不同版本分数混为一套",
      "type": "terminal",
      "module": "aggregation",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "公开 / 暂缓公开边界\n仓库与较早 HF 数据公开\n最新题目未公开\n无完整公开的 2026 冻结语料",
      "type": "document",
      "module": "evidence_boundary",
      "size": "xl"
    },
    {
      "id": "evidence_pins",
      "label": "证据冻结 · 2026-07-21\n论文 v2 · 代码 4bf3d6f4\n官网 f2e0b4bc · 成本 SHA 09ffc358\n公开 HF 集变更于 2025-04",
      "type": "document",
      "module": "evidence_boundary",
      "size": "xl"
    }
  ],
