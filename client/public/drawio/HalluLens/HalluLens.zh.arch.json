  "nodes": [
    {
      "id": "taxonomy",
      "label": "定义 HalluLens 分类体系\n区分幻觉与事实性问题\n按核验来源分成两支",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "extrinsic",
      "label": "外在幻觉\n输出与训练数据不一致\n构建动态防泄漏任务",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "intrinsic",
      "label": "内在幻觉\n输出与输入上下文不一致\n复用仍有区分度的相关基准",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wiki_pool",
      "label": "构建受控 Wikipedia 来源池\n44,754 个 GoodWiki 页面\n按 WikiRank 调和中心性划分难度",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "nonexistent",
      "label": "生成不存在的实体\n来自固定科学/药品库或 LLM 命名\n逐一确认名称不存在",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "precise",
      "label": "PreciseWikiQA · 5,000 对\n10 个难度区间各抽 500 页\n客观答案不超过 10 个词",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "longwiki",
      "label": "LongWiki · 250 个提示\n难度 5-9 每档各 50 个\n可回答且模拟答案至少四句",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "mixed",
      "label": "MixedEntities · 8,000 个名称\n动物、植物、细菌、药品各 2,000\n混合词元并查询 ITIS/药品库排重",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "generated",
      "label": "GeneratedEntities · 1,950 个名称\n三个 LLM 轮转 · 三组各 650 个\n每组企业 300 · 事件 300 · 产品 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dynamic_suite",
      "label": "汇总动态外在幻觉套件\n可重新生成提示以抵抗泄漏\n四条数据流共 15,200 个样本",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "intrinsic_set",
      "label": "整合三个既有基准\nHHEM 摘要 · 带参考的 ANAH 2.0\nFaithEval 噪声/冲突上下文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "运行模型与自动评判器\n拒答/正确性判断 · 事实声明拆分\nLongWiki 仅用 Wikipedia 核验",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "报告各任务幻觉指标\n拒答 · 幻觉 · 正确回答\n精确率 · Recall/F1@32 · 错误接受率",
      "type": "terminal",
      "size": "xl"
    }
  ],
