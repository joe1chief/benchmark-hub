      "id": "mixed",
      "label": "MixedEntities · 8,000 names\n2,000 each: animal · plant · bacteria · medicine\nmix tokens and check ITIS/drug databases",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "generated",
      "label": "GeneratedEntities · 1,950 names\nthree-LLM round robin · three 650-name sets\nbusiness 300 · event 300 · product 50 per set",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dynamic_suite",
      "label": "Assemble dynamic extrinsic suite\nregenerate prompts to resist leakage\n15,200 samples across four streams",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "intrinsic_set",
      "label": "Integrate three existing benchmarks\nHHEM summarization · ANAH 2.0 with reference\nFaithEval noisy/contradictory context",
