      "type": "user",
      "size": "xl"
    },
    {
      "id": "hard_qc",
      "label": "复核所有人类未解题\n基准人员与额外专家检查有效性\n移除四道畸形或损坏问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 99 道 BioMysteryBench 问题\n76 道人类可解 • 23 道人类困难\n完整数据约 159 GB • 题面材料 CC BY 4.0",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "environment",
      "label": "准备生物信息学容器\n最小标准工具 • 可用 pip 与 conda 安装\n可访问 NCBI、Ensembl 等批准数据库",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "solve",
      "label": "Agent 执行端到端分析\n交替进行计算分析与生物学推理\n可选择任意有效分析路线",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "grade",
      "label": "评分最终生物学结论\n对照客观答案 Rubric 而非限定方法\n每道题运行五次 episode",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告准确率与解题一致性\n分开统计 76 道可解与 23 道困难题\n题内 Bootstrap 并展示 0/5 至 5/5 次数",
      "type": "terminal",
      "size": "xl"
