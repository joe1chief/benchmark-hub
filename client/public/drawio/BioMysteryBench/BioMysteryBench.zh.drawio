<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="952" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="真实原始或最小处理组学数据&#xa;测序 • 蛋白质组 • 代谢组&#xa;客观可控属性或经正交验证的元数据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="领域专家编写科研谜题&#xa;开放式研究分析&#xa;避免主观科学结论" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="锚定客观真值&#xa;数据可控属性或正交验证&#xa;与方法无关的生物学结论" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="强制提交验证 Notebook&#xa;证明数据中确实存在所需信号&#xa;在公开打包前验证答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="打包每道题&#xa;问题 • 匿名数据 • 答案 Rubric&#xa;允许域名与数据使用条款" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="最多五位领域专家从头作答&#xa;记录相互独立的尝试&#xa;不接触基准答案键" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="至少一位人类答对？&#xa;是 → 人类可解&#xa;零人答对 → 额外质量复核" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="零人答对题目额外复核&#xa;基准构建者与其他专家&#xa;区分坏题和真正的人类困难题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="408" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="历史 v8 发布&#xa;99 题：76 题可解 / 23 题困难&#xa;2026 年 4 月文章对应版本" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="2026 年 6 月全量答案键审计&#xa;专家生物信息学家重跑每道题&#xa;多模型复核 • 删除 9 题 • 修订 24 题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="当前 BioMysteryBench v11&#xa;90 题 = 73 题人类可解 + 17 题人类困难&#xa;官方完整数据集修订版" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="反作弊与访问策略&#xa;禁止通过 Accession ID 反向查找来源&#xa;允许标准数据库、序列注释、参考基因组与 BLAST" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="可安装工具的生物信息学容器&#xa;标准工具 • pip • conda&#xa;可访问 NCBI、Ensembl 等标准资源" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="智能体每题运行五次 Episode&#xa;可选择任意有效分析路径&#xa;交替执行计算与生物学推理" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="488" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="最终答案 Rubric 全有或全无评分&#xa;只评分正确的生物学结论&#xa;不评分分析方法" 