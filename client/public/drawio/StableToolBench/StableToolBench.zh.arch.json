    {
      "id": "step_1",
      "label": "ToolEval2 候选 1,100 题\n继承自原始 RapidAPI 评测集之核心用例\n涵盖复杂单接口与跨领域多接口调用",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "审计真实 API 漂移与失效\n实测在线接口宕机、认证失效与参数变更\n揭示动态在线接口评测之脆弱性与不可复现性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "初始化虚拟服务器缓存仓\n汇聚 ToolBench 训练与测试历史交互轨迹\n归档原始 API 调用输入、响应及错误日志",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "筛选与清洗缓存调用记录\n剔除系统性无效记录，保留真实业务异常响应\n精炼沉淀 164,980 条高质量缓存数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "构建 API 调用签名索引\n按工具名、端点路径及参数哈希建立索引\n支持毫秒级精确查询与参数规范化对齐",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "实时 API 降级尝试\n当缓存未命中时尝试向真实在线服务发起请求\n妥善处理请求频次限制与网络超时错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "GPT-4-Turbo 虚拟仿真生成\n依据官方 API 文档与 Schema 构造逼真响应\n结合至多 5 个少样本历史缓存案例对齐输出",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "持续回填更新响应缓存\n将全新实测与仿真生成的响应写入持久缓存\n确保虚拟评测环境完全确定且可复现",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "三模型独立可解性盲审\n由三大顶尖前沿模型开展联合独立审查\nGPT-4-Turbo、Gemini-Pro 与 Claude-2 共同研判",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "多数票可解性裁决门禁\n仅保留经多数票裁决为完全具备可解性的题目\n严格剔除语义断裂、不可达或自相矛盾的废题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "冻结 765 道标准评测集\n固化具备高信度、高稳定性的核心测试用例\n确保在虚拟 API 仿真服务器下百分百可解",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "运行受测工具智能体\n向被测模型输入任务指令与候选工具接口规范\n智能体自主展开多轮规划与调用交互",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "返回虚拟仿真环境响应\n虚拟服务器依据请求拦截返回确定性数据\n实现彻底杜绝外部 API 漂移的稳定执行环境",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "GPT-4-Turbo 智能评级裁决\n全面检视智能体执行轨迹与最终交付成果\n给出已解决 (Solved)、存疑或未解决评级",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_15",
      "label": "计算可解通过率 (SoPR)\n按已解决赋 1 分、存疑赋 0.5 分、失败赋 0 分\n计算可解任务集上的绝对通过率指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_16",
      "label": "计算可解胜率指标 (SoWR)\n在解决对未解决时直接判定胜负\n其余情形由 GPT-4 进行成对对比输出相对胜率",
      "type": "terminal",
      "size": "xl"
    }
  ],
