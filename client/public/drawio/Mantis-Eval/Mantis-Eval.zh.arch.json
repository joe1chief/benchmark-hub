      "type": "document",
      "size": "xl"
    },
    {
      "id": "short_prompt",
      "label": "格式化简答提示\n允许在最终回答前分析\n要求使用 Final Answer: 标记\n运行所选模型封装器",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "mc_parse",
