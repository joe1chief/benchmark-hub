      "type": "user",
      "size": "xl"
    },
    {
      "id": "observe",
      "label": "助手观察模式\n接收用户动作与通知\n只读工具\n等待或提出帮助",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "interaction_gate",
      "label": "提议结果？\n接受 · 拒绝 · 收集\n或任务结束／轮次上限",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "execute",
      "label": "助手执行模式\n完整跨应用扁平API\n仅执行获批任务\n随后进入下一用户轮次",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_oracle",
      "label": "最终状态Oracle\n检查用户目标是否完成\n记录提议与接受次数\n统计只读动作与轮次",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "robustness",
      "label": "选择环境条件\n基线：不注入失败或噪声\n工具失败率0.1 · 0.2 · 0.4\n泊松噪声每分钟2 · 4 · 6个事件\n噪声穿插到场景事件中",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "报告四次运行指标\nSuccess@4 · Success⁴\n成功率 · 提议率\n接受率 · 平均只读动作数",
