  "nodes": [
    {
      "id": "exercism",
      "label": "Exercism 题目池\n共 697 道练习\n覆盖六种热门语言",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "languages",
      "label": "语言覆盖\nC++ / Go / Java / JavaScript\nPython / Rust",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "probe",
      "label": "七模型难度预试\n每个模型尝试全部 697 题\n统计每题成功模型数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "filter",
      "label": "难度过滤\n保留仅被 0-3 个模型解出的题\n排除另外 472 道较简单练习",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "Aider Polyglot\n225 道困难练习\nC++ 26 • Go 39 • Java 47\nJavaScript 49 • Python 34\nRust 30",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "input",
      "label": "基准任务\n练习说明\n仅提供可编辑的解答文件\n测试 / 示例 / 元数据文件均不提供",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "aider",
      "label": "使用指定模型运行 Aider\n选择编辑格式\n练习按随机顺序执行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "edit",
      "label": "将需求转化为代码\n格式化并应用文件编辑\n保存到本地源文件",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hidden_tests",
      "label": "在 Docker 中运行隐藏测试\n测试文件不进入模型上下文\n每次编辑后才复制测试文件\n使用语言专用测试命令",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "retry_gate",
      "label": "测试通过或尝试次数耗尽？\n第二次测试后停止",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "repair",
      "label": "根据测试输出重试\n默认 --tries 2\n首次编辑 + 一次修复尝试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "基准报告\nPass@1 与 Pass@2\n正确完成题目百分比\n正确编辑格式 / 格式完好率",
      "type": "terminal",
      "size": "xl"
    }
  ],
