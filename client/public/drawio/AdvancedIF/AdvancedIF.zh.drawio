ry x="1624" y="408" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="编写末轮量规&#xa;同一标注员 • 最多 20 条&#xa;二元可验证准则" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="多轮人工审核&#xa;复核提示与量规&#xa;修订后再发布" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="发布 AdvancedIF&#xa;402 + 736 + 507 = 1,645&#xa;人工对话与人工量规" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="生成模型回答&#xa;使用完整对话上下文&#xa;在末轮评分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="逐条验证量规准则&#xa;o3-mini 判断真或假&#xa;输入提示、回答与量规" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="648" width="200" he