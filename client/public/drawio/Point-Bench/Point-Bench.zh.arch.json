      "size": "xl"
    },
    {
      "id": "target_points",
      "label": "标注预期目标\n使用同一个Gradio界面\n直接在图像上\n放置目标点\n保留目标数量",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sam_masks",
      "label": "生成初始掩码\n用选定目标点\n提示SAM\n为预期目标产生\n二元区域",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "refine_masks",
