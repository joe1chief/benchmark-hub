  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n论文 · 2311.16502v4\n代码 · f3e473e1\n数据 · ff942ca8\nApache-2.0",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "scope",
      "label": "确定专家级范围\n六大学科门类\n30 个科目\n183 个以上子领域\n视觉输入必须有价值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recruit",
      "label": "招募 50 多名学生\n专业与科目匹配\n包含共同作者\n人工收集\n英文 · 大学难度",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "collect",
      "label": "收集或自拟题目\n免费网页 · 测验\n教材 · 讲义\n保持来源多样\n避开易检索答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "raw",
      "label": "形成原始题池\n约 1.3 万道题\n每题一张或多张图\n选择题或短开放题\n遵守来源权利",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dedup",
      "label": "识别重复候选\n词汇重合\n来源 URL 相似度\n作者裁决\n删除确认重复题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "format",
      "label": "共同作者质量检查\n统一格式\n修正错字\n复核歧义\n随机抽样审计",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "是否过易？\n标注四档难度\n非常容易 · 容易\n中等 · 困难\n检查设计标准",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "drop_easy",
      "label": "排除非常容易题\n约占原始题池 10%\n低于预期难度\n不进入基准",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "final_set",
      "label": "最终 MMMU\n11,550 道题\n10,861 选择 · 689 开放\n30 类图像\n覆盖 6 / 30 / 183",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "schema",
      "label": "Schema 字段分组摘要\n精确字段名见审核备注\nid · question · options\nanswer · explanation\n图像 · 类型 · 难度 · 子领域",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "按科目划分\n开发集 · 每科 5 题共 150\n验证集 · 900\n测试集 · 10,500\n开发集支持少样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "执行零样本评测\n优先模型默认提示\n否则在验证集调提示\nLLaVA 示例 · 温度为零\n解析随机种子 42",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qtype",
      "label": "题目类型？\n选择题\n或开放题",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "parse_mc",
      "label": "解析选择题回答\n优先 (A) 再找独立 A\n超过 5 词再匹配选项文本\n多候选取最后出现者\n与标准字母精确匹配",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mc_valid",
      "label": "找到选择题候选？\n解析搜索已穷尽",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "mc_random",
      "label": "随机选项补救\nrandom.choice 选项\n全局种子 42\n仍计入分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mc_score",
      "label": "选择题计分\n解析或随机字母\n与标准答案精确相等\n正确为 1 · 否则 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_open",
      "label": "解析开放题回答\n提取结论短语和数值\n字符串转小写\n数值保留两位小数\n候选去重",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_valid",
      "label": "找到标准答案匹配？\n字符串包含\n或数值相等",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "open_wrong",
      "label": "开放题记错\n不做随机补救\n得分为 0\n仍计入分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_score",
      "label": "开放题计分\n任一标准化答案匹配\n正确为 1\n否则 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "报告微平均准确率\n正确数 / 已评测行数\n跨科目按题量加权\n缺失预测不会被官方脚本\n补入分母",
      "type": "terminal",
      "size": "xl"
    }
  ],
