    {
      "id": "evidence",
      "label": "Freeze Primary Evidence\nPaper · 2311.16502v4\nCode · f3e473e1\nData · ff942ca8\nApache-2.0",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "scope",
      "label": "Define Expert Scope\nSix Disciplines\n30 Subjects\nMore Than 183 Subfields\nVisual Input Must Matter",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recruit",
      "label": "Recruit 50+ Students\nMatching University Majors\nInclude Coauthors\nManual Collection\nEnglish · College Level",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "collect",
      "label": "Collect or Author Questions\nFree Web · Quizzes\nTextbooks · Lectures\nDiverse Sources\nAvoid Easy-to-find Answers",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "raw",
      "label": "Build Raw Pool\nAbout 13K Questions\nOne or More Images\nMC or Short Open Answer\nRespect Source Rights",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dedup",
      "label": "Detect Duplicate Candidates\nLexical Overlap\nSource URL Similarity\nAuthor Adjudication\nRemove Confirmed Duplicates",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "format",
      "label": "Coauthor Quality Checks\nStandardize Format\nCorrect Typos\nReview Ambiguities\nAudit Random Samples",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "Very Easy?\nFour-level Annotation\nVery Easy · Easy\nMedium · Hard\nDesign Criterion Check",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "drop_easy",
      "label": "Exclude Very-easy Items\nAbout 10% of Raw Pool\nBelow Intended Difficulty\nNot in Benchmark",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "final_set",
      "label": "Final MMMU\n11,550 Questions\n10,861 MC · 689 Open\n30 Image Types\n6 / 30 / 183 Coverage",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "schema",
      "label": "Schema Field Groups\nExact Keys in Audit Note\nid · question · options\nanswer · explanation\nimages · type · difficulty · subfield",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "Split by Subject\nDev · 5 Each = 150\nValidation · 900\nTest · 10,500\nDev Supports Few-shot",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "Run Zero-shot Evaluation\nUse Model Default Prompt\nOtherwise Tune on Validation\nLLaVA Example · Temperature 0\nSeed 42 for Parsing",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qtype",
      "label": "Question Type?\nMultiple Choice\nor Open Answer",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "parse_mc",
      "label": "Parse MC Response\nPrefer (A) then Bare A\nOption Text if More Than 5 Tokens\nMultiple Hits · Last Occurrence\nExact Gold-letter Match",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mc_valid",
      "label": "MC Candidate Found?\nParser Search Exhausted",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "mc_random",
      "label": "Random-choice Remedy\nrandom.choice Options\nGlobal Seed 42\nStill Enters Denominator",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mc_score",
      "label": "Score MC Item\nParsed or Random Letter\nExact Equality to Gold\nCorrect = 1 · Else 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_open",
      "label": "Parse Open Response\nConclusion Clauses and Numbers\nLowercase Strings\nNumbers Rounded to 2 Decimals\nDeduplicate Candidates",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_valid",
      "label": "Gold Match Found?\nString Substring\nor Numeric Equality",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "open_wrong",
      "label": "Mark Open Item Wrong\nNo Random Remedy\nScore = 0\nStill Enters Denominator",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_score",
      "label": "Score Open Item\nAny Normalized Gold Match\nCorrect = 1\nOtherwise 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "Report Micro Accuracy\nCorrect / Evaluated Rows\nWeighted Across Subjects\nOmitted Predictions Are Not Added\nto Official Script Denominator",
      "type": "terminal",
      "size": "xl"
    }
  ],
