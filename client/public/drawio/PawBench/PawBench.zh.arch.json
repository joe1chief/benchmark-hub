  "nodes": [
    {
      "id": "step_1",
      "label": "定义联合评测单元\n模型 × Harness × 任务\n区分模型与运行时影响\n保持同一可比任务合同",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "复用六类任务来源\nClawEval 52 · QwenClawBench 29\nPinchBench 23 · SkillsBench 15\nWildClawBench 10 · 自建 21",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "汇总并标准化 150 个任务\n把来源转换为统一任务格式\n保留提示词与工作区合同\n使评分器可跨 Harness 运行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "标注五个正交维度\n场景 · 能力 · 复杂度\n模态 · 环境\n复杂度分 L1 L2 或 L3",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "封装每个任务页面\n提示词与预期行为\n评分标准与检查器代码\nRubric · 工作区文件 · 元数据",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "集成三个 Harness\nQwenPaw · OpenClaw · Hermes\n只适配 Agent 运行时\n暴露相同任务接口",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "强制 Harness 兼容合同\n相同提示词与工作区合同\n相同超时与轨迹格式\n相同最终结果结构",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "交叉运行 9 模型与 3 Harness\n执行每个已配置任务组合\n固定任务定义\n将变化归因于模型或运行时",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "执行任务并保存证据\n记录完整轨迹与指标\n可选保留最终工作区\n可选保留 Docker 镜像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "选择官方评分模式\n自动检查器\nLLM Judge\n检查器与 Judge 混合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "评定任务结果\n运行确定性检查器代码\n应用任务专属 LLM Rubric\nJudge 基线 Claude Opus 4.6",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "聚合可比结果\n将任务结果转换为百分比\n计算模型与 Harness 总分\n保留逐任务证据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "发布排行榜切片\n来源 · 场景 · 能力\n复杂度 · 模态 · 环境\n评分类型 · 模型 · Harness",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "诊断 Harness 差距\n固定 Harness 比较模型\n固定模型比较 Harness\n检查轨迹与评分失败",
      "type": "terminal",
      "size": "xl"
    }
  ],
