      "size": "xl"
    },
    {
      "id": "model_harness_grid",
      "label": "形成基线运行网格\n9个模型 · 3个Harness · 150题\n27组模型与Harness提交\n配置4,050个任务单元",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prepare_workspace",
      "label": "准备隔离工作区\n启动指定Docker Harness\n清理旧文件并放入声明文件\n创建output与sessions目录",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execute_agent",
      "label": "执行Agent任务\n发送任务专属提示词\n执行任务超时限制\n捕获Harness轨迹",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "collect_evidence",
      "label": "收集执行证据\n工作区 · 轨迹 · 用量 · 日志\n保留任务状态与耗时\n可选保存工作区或Docker镜像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "grading_gate",
      "label": "选择评分模式\n自动检查器\n大模型裁判\n检查器与裁判混合",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "automated_grade",
      "label": "执行自动评分\n提取内嵌Python grade代码\n运行任务专属检查\n平均数值型标准得分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "llm_grade",
      "label": "执行大模型裁判评分\n输入任务提示与期望行为\n加入规则与轨迹摘要\n只接受一个JSON评分对象",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hybrid_grade",
      "label": "合并混合评分\n使用每题声明的权重\n自动分低于0.75时裁判贡献归零\n检测到运行中API故障时例外",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize_score",
      "label": "规范化任务结果\n得分保持在0至1\n仅满分视为通过\n保留标准明细与备注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "聚合模型与Harness提交\n平均每题结果\n统计错误与缺失任务\n保留自动与裁判分区",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "slices",
      "label": "构建诊断切片\n来源 · 场景 · 能力\n复杂度 · 模态 · 环境\n评分类型 · 模型 · Harness",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "diagnose",
      "label": "诊断模型与Harness差异\n固定模型比较Harness\n固定Harness比较模型\n检查失败样例与任务轨迹",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "no_paper_boundary",
