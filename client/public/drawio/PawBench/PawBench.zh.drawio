vg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4080" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="诊断模型与Harness差异&#xa;固定模型比较Harness&#xa;固定Harness比较模型&#xa;检查失败样例与任务轨迹" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4344" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="方法来源边界&#xa;尚无独立论文发布&#xa;官方仓库与项目网站&#xa;是主要方法来源" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="固定发布边界&#xa;没有Git标签或GitHub Release&#xa;固定提交0f794a8bb6c2&#xa;仓库采用Apache-2.0许可" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="提示词与解析器边界&#xa;每题提示词与评分规则公开&#xa;不存在单一全局推理提示词&#xa;未披露统一答案解析器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="Harness可比性契约&#xa;相同任务提示 · 工作区 · 超时&#xa;相同轨迹与结果结构&#xa;各Harness适配器保持独立" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="裁判版本边界&#xa;README基线：Claude Opus 4.6&#xa;代码默认：4-5-20251101&#xa;运行配置可以覆盖默认值" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3304" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="许可与资产边界&#xa;PawBench代码采用Apache-2.0&#xa;复用任务保留来源信息&#xa;外部资产沿用上游权利" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="发布固定基线快照&#xa;27组提交即9模型×3 Harness&#xa;快照日期为2026年5月29日&#xa;结果数值不是构建要求" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4344" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geo