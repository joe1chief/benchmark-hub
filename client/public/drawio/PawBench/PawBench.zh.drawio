 as="geometry"/></mxCell><mxCell id="6" value="封装任务契约&#xa;提示词 · 期望行为 · 评分标准&#xa;检查器代码或大模型裁判规则&#xa;工作区文件 · 任务超时" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="应用五维正交标签&#xa;场景 · 能力 · 复杂度&#xa;模态 · 环境&#xa;每题保留来源身份" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="固定PawBench-v1.0任务树&#xa;150题且任务ID唯一&#xa;hybrid 120题 · automated 15题&#xa;LLM judge 15题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="构建三套Harness镜像&#xa;QwenPaw 1.1.3&#xa;OpenClaw 2026.4.24&#xa;Hermes 2026.4.23" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="形成基线运行网格&#xa;9个模型 · 3个Harness · 150题&#xa;27组模型与Harness提交&#xa;配置4,050个任务单元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="准备隔离工作区&#xa;启动指定Docker Harness&#xa;清理旧文件并放入声明文件&#xa;创建output与sessions目录" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行Agent任务&#xa;发送任务专属提示词&#xa;执行任务超时限制&#xa;捕获Harness轨迹" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="收集执行证据&#xa;工作区 · 轨迹 · 用量 · 日志&#xa;保留任务状态与耗时&#xa;可选保存工作区或Docker镜像" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="选择评分模式&#xa;自动检查器&#xa;大模型裁判&#xa;检查器与裁判混合" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="执行自动评分&#xa;提取内嵌Python grade代码&#xa;运行任务专属检查&#xa;平均数值型标准得分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeW