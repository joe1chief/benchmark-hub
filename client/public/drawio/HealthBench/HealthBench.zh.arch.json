  },
  "nodes": [
    {
      "id": "physician_recruitment",
      "label": "全球执业医师队列招募\n招募 1,021 名持证临床执业医师申请者\n覆盖 26 个国家的 35 个专业临床科室领域",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "credential_vetting",
      "label": "医师资质与诊断考核门控？\n验证执医执照、临床年限及试点评分准则测评表现\n剔除资质不合规或未通过专业临床试测的申请者",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "applicant_rejection",
      "label": "不合规申请者剔除\n剔除未达专科准入资质人员以保障评审专业权威性\n最终锁定由 262 名认证临床医师组成的核心专家团",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "dialogue_generation",
      "label": "三流融合临床对话构建\n合成患者真实问诊、对抗性红队攻击与 HealthQA 改编\n模拟多轮医患沟通、慢性病随访以及急性重症分诊场景",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "coherence_gate",
      "label": "临床合理性与安全性审查？\n基于 OpenAI o1 模型进行三轮自动化合理性与医学真实性检查\n过滤症状描述失真、化验指标异常矛盾的不合规对话",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "dialogue_discard",
      "label": "不合规/非临床对话剔除\n修剪存在事实缺陷、信息残缺或合成噪声的低质对话样本\n确保数据集严格贴合真实临床床旁决策环境",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "rubric_authoring",
      "label": "细粒度医师评分准则设计\n262 名医生针对对话编制 48,562 条独立评分准则条目\n细化评测诊断准确性、治疗可行性、同理心与指南遵循",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "healthbench_freeze",
      "label": "HealthBench 冻结评测基准\n包含 5,000 组多轮真实医疗对话与 48,562 条循证评分准则\n划分为常规临床医疗综合能力集与安全红队攻击测试集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "多轮问诊提示组装\n注入多轮问诊对话历史、患者主诉、体征与检验检查指标\n设定模型扮演临床决策支持助手开展多轮医疗交互回答",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "自回归临床咨询推理\n待测基础大模型生成病情分析、鉴别诊断与处置建议\n重点评估回答的专业深度、严谨程度与紧急转诊警觉性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rubric_grader",
      "label": "自动化模型裁判评分引擎\n自动化裁判模型依据分配的细粒度医生准则对生成文本评分\n核对建议内容是否契合黄金临床指南与用药禁忌准则",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "safety_triage_gate",
      "label": "触发严重医疗安全违规？\n筛查是否存在致命药物配伍禁忌、严重剂量错误或漏诊重症\n对危及患者生命安全的严重错误实行零容忍安全红线",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "safety_violation_sink",
      "label": "严重医疗安全惩罚池\n标记灾难性医疗误导或未能在紧急致命危象时做出警告\n直接大幅扣除安全评级指数与临床可信度综合得分",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "rubric_scoring_gate",
      "label": "满足细粒度评分准则？\n校验回答是否客观达到诊断、解释性及共情维度的具体要求\n对每一条评分准则判定得分并记录条目级满足状态",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "rubric_fulfillment",
      "label": "得分累加与缺陷归因\n统计全量 48,562 条准则下的条目达成率并分类归纳缺陷\n标记具体失败模式（如鉴别诊断不全、医患用语晦涩等）",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics_reporting",
      "label": "HealthBench 官方指标报告\n全局准则合规率 (%)、严重医疗安全违规率 (%)\n及 35 个科室领域下模型与医师评审的一致性系数 (Cohen's Kappa)",
      "type": "terminal",
      "size": "xl"
    }
  ],
