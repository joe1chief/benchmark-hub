      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "Release AlignBench\n683 Chinese Queries\nEight Main Categories",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model",
      "label": "Generate Target LLM Response\nFixed-Answer Categories: T = 0.1\nTarget T = 0.7 for Open / Writing / Role",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "Fixed gpt-4-0613 Point-Wise Judge\nJudge T = 0.1\nQuery + Reference + Target Response\nTask-Specific Dimensions + CoT",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_dict",
      "label": "Parse Last Score Dictionary\nInteger Scores for Each Dimension\nRead 'Overall Score'; Regex Fallback",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "Aggregate Official Results\nReasoning = mean(Math, Logic)\nLanguage = mean(6 language categories)\nOverall = (Reasoning + Language) / 2",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "AlignBench Results\nCategory • Reasoning • Language\nOverall Score on the 1–10 Scale",
      "type": "terminal",
      "size": "xl"
    }
