      "id": "sources",
      "label": "真实中文场景\n在线聊天服务使用场景\n研究者编写的挑战题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "rules",
      "label": "四条查询规则\n任务导向 • 清晰流畅\n困难复杂 • 脱敏处理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "论文类别 1–4\n基本任务 • 中文理解\n综合问答 • 文本写作",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "taxonomy_more",
      "label": "论文类别 5–8\n逻辑推理 • 数学计算\n角色扮演 • 专业能力",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "draft",
      "label": "GPT-4 参考答案草稿\n为每条查询提供起点",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_review",
      "label": "人工核验参考答案\n修订并完善草稿\n检查正确性与质量",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "evidence",
      "label": "知识密集型证据\n人工核验时进行网页检索\n记录网址与原文引用",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "verified",
      "label": "已核验候选三元组\n查询 + 类别 + 参考答案\n必要时附带检索证据",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "三模型难度过滤\nGPT-3.5-Turbo • ChatGLM • 讯飞星火\nGPT-4 评分；剔除最易的 50%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "发布 AlignBench\n683 条中文查询\n八个主要类别",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model",
      "label": "生成目标 LLM 回复\n固定答案类别：T = 0.1\n开放 / 写作 / 角色目标 T = 0.7",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "固定 gpt-4-0613 点式评审\n评审 T = 0.1\n查询 + 参考答案 + 目标回复\n任务特定维度 + 思维链",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_dict",
      "label": "解析末尾评分字典\n提取各维度整数分\n读取“综合得分”；正则回退",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "聚合官方结果\n推理 = 数学与逻辑平均分\n语言 = 其余 6 类平均分\n总分 = (推理 + 语言) / 2",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "AlignBench 结果\n类别 • 推理 • 语言\n1–10 分制总分",
      "type": "terminal",
      "size": "xl"
    }
  ],
