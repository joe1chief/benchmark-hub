  "nodes": [
    {
      "id": "evidence_boundary",
      "label": "证据状态\narXiv v2 · 2026-01-08\nOpenReview：已撤稿\n仅静态结果表 · 无在线榜单",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "expert_scope",
      "label": "专家范围\n项目整体共 209 名有偿专家\n单题分工与裁决人数\n未披露",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "forum_curation",
      "label": "整理并交叉审核论坛\n领域 · URL · 讨论样例\n核验专业性与真实性",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "crawl",
      "label": "50 多个已审核论坛\n2,000 多个讨论串 · 近 7 个月\n帖子均发布于 2025 年 1 月后",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "screenshots",
      "label": "以截图保留讨论\n布局 · 格式 · 问答关系\n仅作为内部构建输入",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "vlm_extract",
      "label": "VLM 结构化抽取\nis_valid · question · answer\nexplanation · has_answer",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "validity_gate",
      "label": "页面有效且\n问题清晰？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_invalid",
      "label": "剔除\n无效或问题不清晰的页面",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "quality_filter",
      "label": "LLM 质量筛选\n准确性 · 完整性 · 专业性 · 时效稳健性\n知识深度 · 长链/多步 · 抽象/综合\n迷惑性/原创性 → is_qualified + reason",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality_gate",
      "label": "全部质量\n准则通过？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_quality",
      "label": "剔除\n不合格候选",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "format_route",
      "label": "问题性质？\n保持源语言",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "mcq",
      "label": "知识型 → 选择题\n5–7 个选项 · 恰 1 项正确\n4–6 个可信干扰项\n随机排序 · 语法一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "short_answer",
      "label": "推理/数值型 → 简答题\n详细参考答案\n1–5 个核心知识点",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidates",
      "label": "约 1,000 个候选\n问题 + 参考答案\n等待专家验证",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "expert_gate",
      "label": "领域专家验证通过？\n长尾 · 清晰 · 形式完备\n事实正确",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_expert",
      "label": "剔除\n未通过专家检查",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "pilot_models",
      "label": "随机 6–8 个前沿模型\n计算每题初步通过率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "trivial_gate",
      "label": "是否过于简单？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_trivial",
      "label": "剔除\n过于简单的题目",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "tier_assignment",
      "label": "按通过率划分难度\nL1 >50% · 137 题\nL2 30%–50% · 133 题\nL3 <30% · 160 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "论文 v2 合同 · 430 题\n249 道选择题 · 181 道简答题\n7 个一级 · 21 个二级领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "评测 11 个模型\n使用发布的问题提示\nTemperature = 1 · top_p = 1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_input",
      "label": "附录 B / HF 评判\n参考答案 + 评价点 + 模型回答\n不提供问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_result",
      "label": "全部评价点门控 + 最终答案语义等价\n后续自我纠正优先\n少于 100 token 依据 · answer_score 0 / 1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "准确率 (%)\n= 100 / 430 × Σᵢ yᵢ\nyᵢ ∈ {0, 1}",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "论文表 2\n总体 + 7 个一级领域准确率\n无按难度拆分的模型得分表",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "artifact_boundary",
      "label": "版本 / 资产边界\nv1 摘要 + HF：502 · v1 正文：505\nv2 论文合同：430\n无公开题目映射",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "judge_drift",
      "label": "评判证据冲突\n第 4 节：包含问题\n附录 B + HF：不包含问题\n主流程遵循附录 / HF",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "public_boundary",
      "label": "部分公开\nHF 8bf9f2ee… · 502 条文本记录\n无 430 子集 / 截图 / 来源 URL\n无官方评测器代码",
      "type": "document",
      "size": "xl"
    }
  ],
