    {
      "id": "videos",
      "label": "筛选 6,000 个 VidOR 视频\n原始视频来自 YFCC-100M\n优先较长且交互丰富的片段\n不限定演员或活动类别",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "按视频随机划分\n训练 · 验证 · 测试 = 7:1:2\n在题目标注之前完成划分\n避免视频跨划分复用",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "guidance",
      "label": "培训并监督 100 名本科生\n从下拉菜单选择问题类型\n建议题干 ≤22 词 · 答案 ≤6 词\n上报无法提出好问题的视频",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "annotation",
      "label": "一年内分三阶段标注\n先标注因果问题\n再标注时序问题\n最后标注描述问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qa_roles",
      "label": "分离问题与答案标注角色\n回答者先检查问题质量\n尽可能修复不合格问题\n仅依据可见客观证据作答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "acceptance_gate",
      "label": "能否依据视频可见证据\n客观回答？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_annotation",
      "label": "删除不可用问题\n主观 · 无法回答\n或缺少可见证据",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "postprocess",
      "label": "后处理已验收标注\n删除确认无聊的视频\n均衡验证与测试集的是非答案\n删除答案大于二十的计数题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "保留 5,440 个视频 · 52,044 条问答\n训练 3,870 · 验证 570 · 测试 1,000\n因果 48% · 时序 29% · 描述 23%\n保留简短自由文本答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_gate",
      "label": "采用哪种评测\n任务合同？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "mc_group",
      "label": "构造选择题候选答案\n排除二元问题\n按已标注题型分组\n用 Sentence-BERT 检索 50 个最相似问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mc_filter",
      "label": "过滤候选答案\n忽略停用词后删除词形重复项\n删除答案相似度 >0.9 的候选\n淘汰相似度 <0.2 的简单负例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mc_manual",
      "label": "组成每组五选一题目\n采样四个合格干扰项\n均匀插入正确答案\n人工检查并修订全部题组",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mc_eval",
      "label": "评分 47,692 道选择题\n精确比较选项索引\n细分题型 · 因果 · 时序 · 描述\n总准确率 · 人类验证集准确率 88.38%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "oe_task",
      "label": "定义开放式生成任务\n不提供候选选项\n使用全部 52,044 条问答\n生成简短自由文本答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "oe_eval",
      "label": "使用公开的 NExT-OE 评分器\n自定义停用词过滤 · 词形还原\n二元题与计数题使用精确匹配\n其余用 WUPS@0 · 有补充答案时取最高分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "分别报告 NExT-QA 结果\n选择题准确率\n因果/时序/描述开放题 WUPS\n论文未定义跨任务合并分数",
      "type": "terminal",
      "size": "xl"
    },
    {
