<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3560" pageHeight="632" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义解释型视频问答&#xa;可见的因果与时序动作&#xa;丰富的物体交互&#xa;真实日常活动" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="筛选 6,000 个 VidOR 视频&#xa;原始视频来自 YFCC-100M&#xa;优先较长且交互丰富的片段&#xa;不限定演员或活动类别" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="按视频随机划分&#xa;训练 · 验证 · 测试 = 7:1:2&#xa;在题目标注之前完成划分&#xa;避免视频跨划分复用" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="培训并监督 100 名本科生&#xa;从下拉菜单选择问题类型&#xa;建议题干 ≤22 词 · 答案 ≤6 词&#xa;上报无法提出好问题的视频" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="一年内分三阶段标注&#xa;先标注因果问题&#xa;再标注时序问题&#xa;最后标注描述问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="分离问题与答案标注角色&#xa;回答者先检查问题质量&#xa;尽可能修复不合格问题&#xa;仅依据可见客观证据作答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="能否依据视频可见证据&#xa;客观回答？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="删除不可用问题&#xa;主观 · 无法回答&#xa;或缺少可见证据" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="后处理已验收标注&#xa;删除确认无聊的视频&#xa;均衡验证与测试集的是非答案&#xa;删除答案大于二十的计数题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="保留 5,440 个视频 · 52,044 条问答&#xa;训练 3,870 · 验证 570 · 测试 1,000&#xa;因果 48% · 时序 29% · 描述 23%&#xa;保留简短自由文本答案" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="采用哪种评测&#xa;任务合同？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="构造选择题候选答案&#xa;排除二元问题&#xa;按已标注题型分组&#xa;用 Sentence-BERT 检索 50 个最相似问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="过滤候选答案&#xa;忽略停用词后删除词形重复项&#xa;删除答案相似度 &gt;0.9 的候选&#xa;淘汰相似度 &lt;0.2 的简单负例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="组成每组五选一题目&#xa;采样四个合格干扰项&#xa;均匀插入正确答案&#xa;人工检查并修订全部题组" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="评分 47,692 道选择题&#xa;精确比较选项索引&#xa;细分题型 · 因果 · 时序 · 描述&#xa;总准确率 · 人类验证集准确率 88.38%" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="定义开放式生成任务&#xa;不提供候选选项&#xa;使用全部 52,044 条问答&#xa;生成简短自由文本答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="408" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="使用公开的 NExT-OE 评分器&#xa;自定义停用词过滤 · 词形还原&#xa;二元题与计数题使用精确匹配&#xa;其余用 WUPS@0 · 有补充答案时取最高分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="408" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="分别报告 NExT-QA 结果&#xa;选择题准确率&#xa;因果/时序/描述开放题 WUPS&#xa;论文未定义跨任务合并分数" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="论文与发布边界&#xa;arXiv v2 SHA-256 c2c951…&#xa;NExT-QA 2432e97… · NExT-OE a83f8f5… · MIT&#xa;问答标注与评分器公开 · 原始视频经网盘提供&#xa;标注日志与构建脚本未发布" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFam