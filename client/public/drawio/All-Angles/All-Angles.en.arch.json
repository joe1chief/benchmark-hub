  "nodes": [
    {
      "id": "source_pools",
      "label": "Multi-View Source Pools\nEgo-Exo4D + EgoHumans\nReal-World Multi-Camera Activities",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "select_scenes",
      "label": "Manual Scene Selection\n83 Ego-Exo4D + 7 EgoHumans\n90 Final Scenes",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "view_set",
      "label": "Curate Each View Set\nFinal 4–5 Dispersed Views\nResize to 796 × 448",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_design",
      "label": "Design Six Tasks\nCount • Attribute • Distance • Direction\nManipulation • Camera Pose",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "mllm_questions",
      "label": "GPT-4o Authors Five Task Types\n3 Questions per Type and Scene\nCount • Attribute • Distance\nDirection • Manipulation",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "camera_template",
      "label": "Camera-Pose Template\nDedicated Construction Rule\nOne Question per Scene",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "view_policy",
      "label": "Task-Specific View Policy\nAll Views: Count + Camera Pose\nTwo Random Views: Other Tasks",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "first_review",
      "label": "First Human Review\n8 STEM PhD Annotators\nPilot Samples, Then Review All Items",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "cross_check",
      "label": "Cross-Check Every Annotation\nAt Least One Other Annotator\nGroup Discussion Resolves Disputes",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "random_audit",
      "label": "Periodic Random Audit\nSample Reviewed Questions\nCorrect Issues Before Release",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "mcq_contract",
      "label": "Enforce MCQ Contract\nThree Answer Options\nExactly One Correct Answer",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paired",
      "label": "Construct Paired Questions\nRephrase • Change Orientation • Change Views\nPreserve Visual Correspondence",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_qc",
      "label": "Final Human Quality Control\nVerify Evidence and Single Answer\n85.3% Paired Coverage, Excluding Counting",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Release All-Angles Bench\n2,132 QA Pairs • 90 Scenes\nSix Multi-View Tasks",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_contract",
      "label": "Downstream Model Evaluation\nVLMEvalKit • Greedy • Temperature 0\nFixed MCQ Prompt with Option Letters",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_parser",
      "label": "Extract the Final Option\nQwen2.5-32B Parser\nMap Output to One Option Letter",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "Accuracy\nOverall and Per Task\nDirect MCQ Correctness",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "consistency",
      "label": "Paired Consistency\nCC • WW • IC Outcomes\nDiagnose Cross-View Instability",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "human_subset",
      "label": "Separate Human Study\n250 Questions • Exclude Paired Data\nTwo Additional PhD Annotators",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report Evaluation Evidence\nAccuracy • CC / WW / IC\nModel and Human Results Stay Separate",
      "type": "terminal",
      "size": "xl"
    }
  ],
