  "nodes": [
    {
      "id": "source_pools",
      "label": "Candidate Multi-View Sources\nEgo-Exo4D + EgoHumans\nReal-World Multi-Camera Activities",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "select_scenes",
      "label": "Manual Scene Selection\n83 Ego-Exo4D + 7 EgoHumans\n90 Final Scenes",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "view_set",
      "label": "Curate Each View Set\nFinal 4–5 Spatially Dispersed Views\nResize Images to 796 × 448",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_design",
      "label": "Design Six Reasoning Tasks\nCount • Attribute • Distance • Direction\nManipulation • Camera Pose",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "draft",
      "label": "Five MLLM-Generated Task Categories\nCounting • Attribute • Distance\nDirection • Manipulation\nThree Questions per Task and Scene",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "camera_template",
      "label": "Camera Pose Estimation\nDedicated Question Template\nOne Question per Scene",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "view_policy",
      "label": "Apply Task-Specific View Policy\nAll Views for Counting and Camera Pose\nOther Tasks Use Two Randomly Selected Views",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_review",
      "label": "Eight STEM PhD Annotators Review All Items\nRemove Invalid Questions\nRefine Wording and Answer Choices",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "mcq",
      "label": "Enforce the MCQ Contract\nThree Answer Options\nExactly One Correct Answer",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paired",
      "label": "Construct Paired Questions\nRephrase, Swap Orientation, or Change Views\nPreserve the Underlying Correspondence",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_qc",
      "label": "Perform Final Human Quality Control\nVerify Visual Evidence and Single Answer\n85.3% Paired Coverage Excluding Counting",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "benchmark",
      "label": "Release All-Angles Bench\n2,132 QA Pairs • 90 Scenes\nSix Multi-View Task Categories",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_eval",
      "label": "Downstream Evaluation: 27 MLLMs\nStandard Multiple-Choice Prompting\nParse One of Three Answer Options",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "Compute Accuracy\nOverall and by Task Category\nCompare Open and Proprietary Models",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "consistency",
      "label": "Measure Paired Inconsistency\nCompare Answers to Corresponding Items\nDiagnose Cross-View Instability",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "Downstream Human Reference\nRandom 250-Question Subset\nExclude Paired Questions\nCover All Six Task Categories",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report Downstream Model Results\nAccuracy • Paired Consistency\nOverall and Per-Task Performance",
      "type": "terminal",
      "size": "xl"
    }
  ],
