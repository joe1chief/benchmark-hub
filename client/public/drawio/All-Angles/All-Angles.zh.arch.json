  },
  "nodes": [
    {
      "id": "source_pools",
      "label": "候选多视角来源\nEgo-Exo4D + EgoHumans\n真实多相机活动场景",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "select_scenes",
      "label": "人工筛选场景\nEgo-Exo4D 83 个 + EgoHumans 7 个\n共 90 个最终场景",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "view_set",
      "label": "整理每组视角\n最终保留 4–5 个空间分散视图\n图像缩放至 796 × 448",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_design",
      "label": "设计六类推理任务\n计数 • 属性 • 距离 • 方向\n物体操作 • 相机姿态",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "draft",
      "label": "五类 MLLM 生成任务\n计数 • 属性 • 距离\n方向 • 物体操作\n每场景每任务三题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "camera_template",
      "label": "相机姿态估计\n专用问题模板\n每场景一题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "view_policy",
      "label": "应用任务特定视角策略\n计数与相机姿态使用全部视图\n其他任务随机选择两个视角",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_review",
      "label": "八名 STEM 博士标注员全量复核\n移除无效问题\n优化措辞与答案选项",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "mcq",
      "label": "强制选择题合同\n三个答案选项\n且仅有一个正确答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paired",
      "label": "构造配对问题\n改写、交换方位或更换视图\n保持底层对应关系不变",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_qc",
      "label": "最终人工质检\n核验视觉证据与唯一答案\n除计数外配对覆盖率 85.3%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "benchmark",
      "label": "发布 All-Angles Bench\n2,132 个问答对 • 90 个场景\n六类多视角任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_eval",
      "label": "下游评测：27 个 MLLM\n标准选择题提示\n解析三个答案选项之一",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "计算准确率\n总体与任务类别分项\n比较开源与闭源模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "consistency",
      "label": "测量配对不一致率\n比较对应问题的答案\n诊断跨视角不稳定性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "下游人类参考\n随机抽取 250 题子集\n排除配对问题\n覆盖全部六类任务",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "汇报下游模型结果\n准确率 • 配对一致性\n总体及分任务表现",
      "type": "terminal",
      "size": "xl"
    }
  ],
