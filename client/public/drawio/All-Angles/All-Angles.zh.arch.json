{
  "version": 1,
  "title": "All-Angles Bench 构建流程",
  "type": "academic-diagram",
  "source": "edited",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 20,
    "edges": 22,
    "modules": 0
  },
  "nodes": [
    {
      "id": "source_pools",
      "label": "多视角来源池\nEgo-Exo4D + EgoHumans\n真实多相机活动场景",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "select_scenes",
      "label": "人工筛选场景\nEgo-Exo4D 83 个 + EgoHumans 7 个\n共 90 个最终场景",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "view_set",
      "label": "整理每组视角\n最终保留 4–5 个分散视图\n缩放至 796 × 448",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_design",
      "label": "设计六类任务\n计数 • 属性 • 距离 • 方向\n物体操作 • 相机姿态",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "mllm_questions",
      "label": "GPT-4o 生成五类任务\n每场景每类生成三题\n计数 • 属性 • 距离\n方向 • 物体操作",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "camera_template",
      "label": "相机姿态专用模板\n独立构造规则\n每场景生成一题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "view_policy",
      "label": "按任务选择视角\n计数与相机姿态使用全部视角\n其余任务随机选择两个视角",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "first_review",
      "label": "首轮人工复核\n8 名 STEM 博士标注员\n先试标，再全量复核",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "cross_check",
      "label": "每条标注交叉复核\n至少由另一名标注员检查\n分歧通过小组讨论解决",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "random_audit",
      "label": "定期随机抽检\n抽查已复核问题\n发布前纠正问题",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "mcq_contract",
      "label": "固化选择题合同\n三个答案选项\n仅有一个正确答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paired",
      "label": "构造配对问题\n改写 • 改变方向 • 改变视角\n保持视觉对应关系",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_qc",
      "label": "最终人工质检\n核验视觉证据与唯一答案\n配对覆盖率 85.3%，不含计数",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 All-Angles Bench\n2,132 个问答对 • 90 个场景\n六类多视角任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_contract",
      "label": "下游模型评测\nVLMEvalKit • 贪心解码 • 温度 0\n固定选择题提示与选项字母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_parser",
      "label": "提取最终选项\nQwen2.5-32B 解析器\n将输出映射为一个选项字母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "accuracy",
      "label": "准确率\n总体与逐任务统计\n直接选择题正确性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "consistency",
      "label": "配对一致性\nCC • WW • IC 三类结果\n诊断跨视角不稳定",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "human_subset",
      "label": "独立人类实验\n250 题 • 排除配对数据\n另由两名博士标注员作答",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告评测证据\n准确率 • CC / WW / IC\n模型与人类结果保持分离",
      "type": "terminal",
      "size": "xl"
    }
  ],
