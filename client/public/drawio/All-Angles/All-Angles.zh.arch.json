      "size": "xl"
    },
    {
      "id": "paired",
      "label": "构造配对问题\n改写、交换方位或更换视图\n保持底层对应关系不变",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_qc",
      "label": "最终人工质检\n核验视觉证据与唯一答案\n除计数外配对覆盖率 85.3%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "benchmark",
