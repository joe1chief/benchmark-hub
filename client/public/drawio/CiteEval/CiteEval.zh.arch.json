      "type": "process",
      "size": "xl"
    },
    {
      "id": "citation_indices",
      "label": "正则引用标号提取解析\n精准匹配方括号引用标记（如 [1]、[2]）\n建立句中声明与文档编号的映射关系",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "valid_indices",
      "label": "有效引文过滤与越界截断\n保留落在真实检索区间 [1..10] 内的引用\n标记模型幻觉产生的越界无效标号",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "blind_passes",
      "label": "三人全独立双盲专家审校\n每条长文响应由三名独立标注员盲审\n保障极高的人工标注信度与一致性",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "statements",
      "label": "细粒度单句断言精细研判\n结合长文完整上下文通读单条语句\n精准定性断言背后的知识来源属性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "context_vote",
      "label": "引文知识来源多数票仲裁闸门\n多数票决断知识来源：外部检索 vs 其他\n判定断言是否属于依赖检索段落支撑",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "retrieval_annotations",
      "label": "检索支持度与引文精确度打分\n标注最小证据修改以实现完全支撑\n收集三人独立的 Likert 细粒度引文评分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rating_mean",
      "label": "三人评分多维均值计算\n计算引文质量、真实度与相关性综合均值\n平滑主观偏见并对齐量纲基准",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "response_pool",
      "label": "有效断言综合指标池\n汇总长文中所有适用检索语句的分值\n整合成文档级别的细粒度引用质量分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "na",
      "label": "非检索语句豁免分支（N/A）\n归属于用户上下文、常识或参数知识\n免除外部检索引文缺失的惩罚",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "response_rejoin",
      "label": "全量响应重构与元数据回并\n将1,200条长文响应与逐句标注对齐回并\n固化结构化引文评测金标准语料",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "metric_split",
