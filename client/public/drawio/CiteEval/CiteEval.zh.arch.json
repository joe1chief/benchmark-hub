      "label": "定义三项评测原则\n使用完整检索上下文\n纳入检索外上下文与细粒度评分",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "queries",
      "label": "采样长文本问答查询\nASQA • ELI5 • MS MARCO • LFRQA\n开发集 948 条 + 测试集 3,000 条",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "retrieval",
      "label": "固定检索证据\n每个查询提供 10 个段落\n评测时保留完整上下文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "responses",
      "label": "生成人工研究回答\n100 查询 × 3 来源 × 4 模型\nGPT-4o/mini + Llama-3-70B/8B，共 1,200 条",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "statements",
      "label": "解析陈述与引文\n使用 NLTK 拆分回答\n抽取 [1] 至 [10] 引文标记",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attribution",
      "label": "标注支持来源\n检索 • 用户 • 回答 • 参数知识\n对不适用的检索外来源标记 N/A",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "edits",
      "label": "记录关键引文编辑\n添加缺失引文\n删除无支持或不必要引文",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "ratings",
      "label": "给出细粒度评分\n将引文质量评为 1 至 5 分\n同时评测完整与仅引文上下文",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "qc",
      "label": "人工标签质量控制\n三轮盲标 + 多数票／均值聚合\n三轮试标后由语言学专家验证",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "划分指标开发数据\n200 条用于指标开发\n1,000 条用于元评测",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "auto_context",
      "label": "自动识别支持来源\n判断每条陈述由哪类上下文支持\n同时覆盖检索与检索外证据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ensemble",
      "label": "构建 CiteEval-Auto\nITERCOE + EDITDIST 集成\n融合模型推理与编辑距离",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "validate",
      "label": "对照人工分数进行元评测\nGPT-4o + MLR 配置\nPearson 相关系数达到 0.731",
      "type": "terminal",
      "size": "xl"
    },
