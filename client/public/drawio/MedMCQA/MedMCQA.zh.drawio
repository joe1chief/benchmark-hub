tion · India · graph · map 等" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="剔除原始题目&#xa;格式错误或候选缺失&#xa;依赖图片 / 表格 / 外部信息" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCCBC;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="启发式文本清洗&#xa;解析 HTML · 符号&#xa;URL · 空白&#xa;修复选项格式&#xa;与拼写" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="人工监督校对&#xa;Grammarly 检查&#xa;问题 · 选项 · 解析&#xa;由人类选择&#xa;适当建议" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="删除重复题&#xa;最终语料：193,155 题&#xa;21 个学科 · 约 2,400 个主题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="按来源考试划分&#xa;训练：模拟 + 在线 182,822&#xa;开发：NEET PG 4,183&#xa;测试：AIIMS PG 6,150&#xa;图表/压缩包总计 193,155&#xa;摘要称 &gt;194K&#xa;正文/README 对调开发与测试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="跨分区泄漏防护&#xa;对问题两两计算 Levenshtein&#xa;相似度 &gt; .9 则删除开发/测试题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="MedMCQA 公开压缩包&#xa;训练 182,822 · 开发 4,183 · 测试 6,150&#xa;公开测试集不含 cop 与 exp&#xa;测试标准答案保持私有" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="未披露的构建边界&#xa;网站 / 书目 / 完整词表缺失&#xa;无构建 / 去重 / 划分脚本&#xa;抽样 / 裁决规则未披露&#xa;论文内部歧义：&#xa;缺失选项既称剔除又称修复" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCCBC;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="408" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="发布 / 权利边界&#xa;Saama AI Research&#xa;无需伦理审查&#xa;仓库采用 MIT&#xa;压缩包无内嵌许可证&#xa;抓取题目权利未披露" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3000" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="固定版仓库漂移&#xa;压缩包 JSONL ≠ 代码 CSV；无适配器&#xa;无检索器；问题与选项同段&#xa;exp 为配对文本&#xa;最小验证损失 ≠ 最高分；耐心2&#xa;长192 · 丢弃.4 · 种子42" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCCBC;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3000" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="运行论文模型研究，还是&#xa;当前公开盲测提交？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2720" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="论文实验是否使用&#xa;外部知识上下文？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="检索最高余弦段落&#xa;DPR + 维基百科&#xa;或 PubMedBERT + PubMed&#xa;PubMed 段落&#xa;截断至 250 词元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="论文阅读器 · 每题四条序列&#xa;BERT · SciBERT&#xa;BioBERT · PubMedBERT&#xa;有上下文：[CLS] C [SEP]&#xa;Q [SEP] O [SEP]&#xa;无上下文：[CLS] Q [SEP] O [SEP]&#xa;无生成式提示 / 解析器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="微调论文阅读器&#xa;2 张 Tesla T4 · 5 轮&#xa;学习率 2e-4 · 批量 16" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="论文检查点选择&#xa;五轮中取验证分数&#xa;最高的检查点" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="线性层 + Softmax&#xa;对四个选项分数取 Argmax&#xa;输出 1–4 的选项序号" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="论文准确率&#xa;正确预测数 / 全部有标签记录数&#xa;总体 + 分学科" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="对盲测集运行推理&#xa;6,150 个 ID + 问题 + 选项&#xa;不公开正确选项或解析" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="生成官方提交 CSV&#xa;列：id + Prediction (correct option)&#xa;预测必须是 1–4 的整数&#xa;通过 Google 表单上传" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="官方外部计分&#xa;私有标答测试准确率&#xa;缺失预测规则&#xa;计分分母规则&#xa;均未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="官方主页排行榜&#xa;含上下文 + 无上下文&#xa;公开展示提交结果" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="固定代码能否读取&#xa;转为 CSV 的副本，&#xa;其中有 cop，且上下文模式&#xa;还具有 exp？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="公开测试代码路径失败&#xa;压缩包 JSONL；代码 pd.read_csv&#xa;无适配器&#xa;转换后仍要求 cop - 1&#xa;