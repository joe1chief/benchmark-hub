<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="616" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="识别 AIME 评测缺口&#xa;每年仅发布 30 道题&#xa;方差高且难以区分前沿模型" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="数学专家创建原创题&#xa;参考成熟竞赛题型&#xa;面向高级多步推理" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="系统化改编竞赛问题&#xa;结构修改与场景重构&#xa;不照搬原题并保持数学深度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="强制无直接重复&#xa;全部为新整理而非逐字复用&#xa;降低依靠记忆作答的机会" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="排除直接给出简单答案的题目&#xa;题面不能直接提供简单答案&#xa;必须经过真正数学推理" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="保留前沿难度&#xa;等于或难于最难 AIME 题&#xa;过滤并整理最终挑战集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="应用发布答案合同&#xa;100 道题 • 答案均为整数&#xa;无固定数值范围限制" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="发布 BeyondAIME&#xa;100 道专家整理的整数答案题&#xa;无固定答案范围 • 抗污染" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="每个模型每题收集 32 次响应&#xa;按发布金标判定正确性&#xa;保留全部 32 次评测响应" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="报告 BeyondAIME 准确率&#xa;按每题 32 次响应计算 Avg@32&#xa;稳定比较前沿推理模型" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEF