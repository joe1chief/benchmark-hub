  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4904" pageHeight="952" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="学科选择用户研究&#xa;133 名本科生及研究生&#xa;每人编写两个专家视频问答样例&#xa;作者选定 27 个主题与四大学科" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="招募并培训专家&#xa;正文 §3.1：共 67 人&#xa;附录 A.1：列出 73 个 ID&#xa;每主题至少两名专家" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="教材引导的概念定位&#xa;由专家选择权威教材&#xa;逐章审阅&#xa;选择需动态呈现的概念" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="检索概念相关 YouTube 视频&#xa;用 Data API v3 核验 CC 许可&#xa;无音轨 • 屏幕文字尽量少&#xa;排除讲座" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="是合格的视觉密集型 CC 视频？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillCo