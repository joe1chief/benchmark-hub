><mxGeometry x="4104" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="隐藏测试集&#xa;2,000 项 • 由作者持有&#xa;提交代码后由作者运行评测&#xa;内容无法独立核验" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4624" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="生成模型回答&#xa;按题型使用 CoT 或直接回答提示&#xa;模型专用视频或帧输入&#xa;温度 1.0 • 最多 1,024 Tokens&#xa;Gemini 2.0 Flash Thinking 例外：最多 8,192 Tokens" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3840" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="评测题型？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3584" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="GPT-4o 选择题判分&#xa;抽取 A–E 中的单个字母&#xa;与标准答案比较&#xa;返回结构化布尔值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3320" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="GPT-4o 开放题判分&#xa;要求明确且无歧义地等价于&#xa;相同技术或概念&#xa;不补造回答中缺失的答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, s