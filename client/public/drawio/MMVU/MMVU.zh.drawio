ign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="专家解答元数据&#xa;维基百科领域知识链接&#xa;逐步推理依据&#xa;仓库称依据经 GPT-4o 校订" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="64" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="作者或高表现标注员复核&#xa;检查全部标注&#xa;排除纯文本或单帧捷径&#xa;验证回答必须理解视频" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3064" y="64" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="需要修订？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3320" y="64" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="修订并重新提交&#xa;共修订 523 个样例&#xa;再次接受专家复核" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3584" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="修订后符合设计标准？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3840" y="288" width="200" height="100" as="geometry"/></mxCell><mx