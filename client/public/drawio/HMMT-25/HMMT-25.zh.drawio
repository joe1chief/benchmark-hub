  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3224" pageHeight="656" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据与固定版本&#xa;MathArena · arXiv 2505.23281v3&#xa;代码 462e6f4 · 数据集 6fdc427" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择 HMMT 2025 年 2 月锦标赛&#xa;仅限个人赛题&#xa;不含邀请赛/HMIC&#xa;高难度且声誉可靠的数学竞赛&#xa;发布于 2025 年 2 月 15 日" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="提取 3 场个人赛 × 每场 10 道题&#xa;代数 · 几何 · 组合&#xa;按标准模板统一格式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="逐题人工核验&#xa;对照官方来源检查错别字与不一致&#xa;检查题面和答案格式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="发布 30 行数据集&#xa;problem · answer · problem_type&#xa;CC BY-NC-SA 4.0" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="使用最终答案提示&#xa;要求逐步推理&#xa;最终答案写入 \boxed{}" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="每题生成 4 个独立回答&#xa;使用模型提供商推荐超参数&#xa;不针对基准额外调参" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="规则式最终答案解析器&#xa;任意 LaTeX → SymPy 结构&#xa;与标准答案做等价检查" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="88" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="GUI 标记待复核输出&#xa;过短或截断 · 解析器错误&#xa;推理轨迹有答案但未成功提取" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Gemini-2.5-