<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3024" pageHeight="576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="从 BRIGHT StackExchange 出发&#xa;七个领域共 739 个查询&#xa;统一语料含 526,319 个文档" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="分配同领域专家&#xa;以社区答案作为起点&#xa;独立识别可辩护解答所需前提" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="分解每个信息需求&#xa;紧凑且不冗余的推理 aspect&#xa;每个 aspect 配一至两句理由" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="论文 aspect 重要性&#xa;Likert 1–5 分&#xa;归一化后权重总和为 1&#xa;从主导证据到边缘证据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="重审原 BRIGHT 正例&#xa;把显式证据分配给 aspect&#xa;丢弃弱项 • 合并重叠 • 裁剪噪声" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="收集新的 aspect 证据&#xa;网页搜索或 AI 辅助搜索&#xa;必须提供显式、精确、可信的支持" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="用 FireCrawl 处理来源页面&#xa;去模板并人工裁剪残余噪声&#xa;多 aspect 页面切成单 aspect 正例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="迭代修订 aspect 结构&#xa;补缺失前提 • 拆分过宽 aspect&#xa;合并重复推理需求" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="同领域第二标注员独立复核&#xa;检查粒度、平衡、权重和覆盖&#xa;重查证据可信度 • 50 题 κ = 0.742" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文基准汇总&#xa;739 查询 • 526,319 文档&#xa;2,763 aspect • 5,272 金证据&#xa;平均 3.74 aspect • 7.13 正例" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="固定 HF 发布边界&#xa;2,763 条 aspect 使用 {1, 2, 3}&#xa;论文写 Likert 1–5&#xa;HF 修订 dbdc22b" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="运行静态排序检索&#xa;每题输出一个段落排序列表&#xa;奖励互补 aspect 覆盖" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="评分静态检索&#xa;α-nDCG@k，α = 0.5&#xa;加权 A-Recall • NDCG@k&#xa;Recall@k" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="固定 Agentic 评测样本&#xa;175 题 • 每领域 25 题&#xa;固定随机种子 42&#xa;所有检索器使用相同样本与预算" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="在搜索 Agent 中运行检索器&#xa;GPT-5-mini + Qwen3.5 后端&#xa;每轮 Top-5&#xa;固定 R=1, 2, 3 或自适应停止" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="构建并验证参考答案&#xa;GPT-5 高推理读取人工金证据&#xa;对 40 个样本做盲评人类核验" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="GPT-5 评审引用答案&#xa;aspect 覆盖 0 / 0.5 / 1&#xa;总体质量 1–5&#xa;完整性 • 轮数 • AER 效率奖励" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="汇报检索器与 Agent 效用&#xa;静态多样性 • 推理完整性&#xa;最终质量、搜索轮数与 AER" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2744" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" par