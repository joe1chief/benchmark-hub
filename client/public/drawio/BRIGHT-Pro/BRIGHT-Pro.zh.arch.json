  "nodes": [
    {
      "id": "bright_source",
      "label": "从 BRIGHT StackExchange 出发\n七个领域共 739 个查询\n统一语料含 526,319 个文档",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "experts",
      "label": "分配同领域专家\n以社区答案作为起点\n独立识别可辩护解答所需前提",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "aspects",
      "label": "分解每个信息需求\n紧凑且不冗余的推理 aspect\n每个 aspect 配一至两句理由",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "weights",
      "label": "标注 aspect 重要性\nLikert 1–5 分 • 归一化后总和为 1\n从主导证据到边缘证据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reaudit",
      "label": "重审原 BRIGHT 正例\n把显式证据分配给 aspect\n丢弃弱项 • 合并重叠 • 裁剪噪声",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "collect",
      "label": "收集新的 aspect 证据\n网页搜索或 AI 辅助搜索\n必须提供显式、精确、可信的支持",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "segment",
      "label": "用 FireCrawl 处理来源页面\n去模板并人工裁剪残余噪声\n多 aspect 页面切成单 aspect 正例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "refine",
      "label": "迭代修订 aspect 结构\n补缺失前提 • 拆分过宽 aspect\n合并重复推理需求",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qc",
      "label": "同领域第二标注员独立复核\n检查粒度、平衡、权重和覆盖\n重查证据可信度 • 50 题 κ = 0.742",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 BRIGHT-Pro\n739 个查询 • 平均 3.74 个 aspect\n每题平均 7.13 个正例文档",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "static_eval",
      "label": "运行静态排序检索\n每题输出一个段落排序列表\n奖励互补 aspect 覆盖",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "static_metrics",
      "label": "评分静态检索\nα-nDCG@k，α = 0.5 • 加权 A-Recall\nNDCG@k 与 Recall@k 诊断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agentic_sample",
      "label": "固定 Agentic 评测样本\n175 题 • 每领域 25 题\n所有检索器使用相同样本与预算",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agent_loop",
      "label": "在搜索 Agent 中运行检索器\nGPT-5-mini 与 Qwen3.5 • 每轮 Top 5\n固定 R=1,2,3 或自适应停止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reference",
      "label": "构建并验证参考答案\nGPT-5 高推理读取人工金证据\n对 40 个样本做盲评人类核验",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "评审带引用的最终答案\naspect 覆盖 0 / 0.5 / 1 • 总体 1–5\n完整性 • 轮数 • AER 效率奖励",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "汇报检索器与 Agent 效用\n静态多样性 • 推理完整性\n最终质量、搜索轮数与 AER",
      "type": "terminal",
      "size": "xl"
    }
  ],
