    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3024" pageHeight="576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Start from BRIGHT StackExchange&#xa;739 Queries across Seven Domains&#xa;Unified Corpus of 526,319 Documents" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Assign Field-Specific Experts&#xa;Use Community Answers&#xa;as Starting Points&#xa;Identify Premises Needed&#xa;for Defensible Solutions" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Decompose Each Information Need&#xa;Compact Non-Redundant&#xa;Reasoning Aspects&#xa;One- to Two-Sentence Rationale&#xa;per Aspect" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Paper Aspect Importance&#xa;Likert 1 to 5&#xa;Normalize Weights to Sum to One&#xa;Dominant through&#xa;Peripheral Evidence" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Re-Audit Original BRIGHT Positives&#xa;Assign Explicit Evidence to Aspects&#xa;Discard Weak • Merge Overlap&#xa;Trim Noise" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Collect New Aspect Evidence&#xa;Web Search or AI-Assisted Search&#xa;Require Explicit and Precise&#xa;Credible Support" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Process Source Pages with FireCrawl&#xa;Remove Boilerplate&#xa;and Manually Trim Noise&#xa;Split Multi-Aspect Pages into&#xa;Single-Aspect Positive Passages" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Iteratively Refine Aspect Schema&#xa;Add Missing Assumptions&#xa;Split Broad Aspects&#xa;Consolidate Redundant&#xa;Reasoning Needs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Run Independent Same-Field Review&#xa;Check Granularity and Balance&#xa;Weights and Coverage&#xa;Recheck Evidence Credibility&#xa;κ = 0.742 on 50" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Paper Benchmark Assembly&#xa;739 Queries • 526,319 Documents&#xa;2,763 Aspects • 5,272 Gold Passages&#xa;Avg 3.74 Aspects • 7.13 Positives" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Pinned HF Release Boundary&#xa;2,763 Aspect Rows Use {1, 2, 3}&#xa;Paper Says Likert 1–5&#xa;HF Revision dbdc22b" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Run Static Ranked Retrieval&#xa;One Ranked Passage List per Query&#xa;Reward Complementary&#xa;Aspect Coverage" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="-8" width="200" height="100" as="geom