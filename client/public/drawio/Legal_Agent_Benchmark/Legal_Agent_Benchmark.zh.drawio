  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2392" pageHeight="1000" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="1 ·&#xa;构建&#xa;发布" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="40" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="3" value="2 ·&#xa;公开&#xa;评测" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="120" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="4" value="3 ·&#xa;私有&#xa;LAB-&#xa;AA" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#F3E5F5;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="200" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="5" value="从真实客户事项抽象任务&#xa;起点为执业律师处理过的工作&#xa;人物、机构与事项事实均合成&#xa;覆盖 24 个代表性执业领域" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="-104" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="定义初级律师级委派任务&#xa;合伙人式指令 · 平均约 50 个英文单词&#xa;限定在封闭的事项材料范围&#xa;指定可供审阅的交付物" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="168" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="构建合成事项材料&#xa;在律师指导与审核下批量生成&#xa;混合关键与外围文档&#xa;在多个文件间嵌入待识别问题" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="440" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="编写原子化专家评分点&#xa;二元 · 等权 · 不设标准答案&#xa;match_criteria 定义通过与失败&#xa;限定交付物 · 来源文档可选" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="712" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="打包独立完整的任务&#xa;tasks/[领域]/[工作流]/[场景]/&#xa;task.json + documents/&#xa;标题 · 指令 · 工作类型 · 标签&#xa;交付物 · 评分点" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="984" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="执行内容与完整性门禁&#xa;律师指导并审核合成材料&#xa;校验 JSON · 标题 · 评分点 · ID 唯一性&#xa;交付物列表 · 禁止旧版权重" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1256" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="发布持续演进的 MIT 仓库&#xa;固定 README：1,671 个任务&#xa;24 个执业领域及合同工作&#xa;加入并购尽职调查扩展" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1528" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="区分公开与私有资产边界&#xa;公开任务 · 评分准则 · 运行框架&#xa;未发布 train/dev/test 切分&#xa;LAB-AA 私有留出集独立于仓库" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1800" y="136" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="框架加载一个公开任务&#xa;task.json + 事项材料&#xa;系统提示 · 技能手册 · 任务指令&#xa;智能体访问评分准则即自动失败" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="-184" y="456" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="为每个任务创建 Podman 沙箱&#xa;禁用网络 · 移除全部 capabilities&#xa;材料目录只读&#xa;工作区与输出目录可写" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="88" y="456" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="运行模型—工具循环&#xa;Bash · Read · Write · Edit&#xa;Glob · Grep&#xa;无工具调用时停止 · 默认最多 200 轮&#xa;保存交付物 · 轨迹 · 运行指标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="360" y="456" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="匹配并解析交付文件&#xa;精确 · 扩展名 · 模糊 · LLM 匹配&#xa;DOCX · XLSX · PPTX · PDF 转为文本&#xa;仅加载当前评分点关联文件" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="632" y="456" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="每次 LLM 调用评判一个评分点&#xa;标题 + 输出 + match_criteria 提示&#xa;默认 Sonnet 4.6 · 温度 0&#xa;Anthropic/Google&#xa;OpenAI/Mistral · 返回 JSON 判定与理由" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="904" y="456" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="应用严格的全通过计分&#xa;每个评分点只能通过或失败&#xa;仅当全部评分点通过时任务得 1 分&#xa;任务级不给部分分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1176" y="456" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="生成 scores.json 与 report.html&#xa;核心指标：任务全通过率&#xa;诊断指标：汇总评分点通过率&#xa;热图 · 覆盖率 · Token · 时间 · 成本" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="1448" y="456" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="使用独立的私有留出集&#xa;120 个任务 · 24 个执业领域&#xa;镜像公开任务的领域与分布&#xa;不随 MIT 仓库公开发布" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1640" y="776" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="发布独立 LAB-AA 排行榜&#xa;Artificial Analysis Stirrup 框架&#xa;单一 LLM 逐评分点评判&#xa;全通过率 + 评分点通过率&#xa;成本 · Token · 速度 · 轮数" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1912" y="776" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="5" target="6"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="6" target="7"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="7" target="8"><mxGeometry relative="1" as="geometry"></