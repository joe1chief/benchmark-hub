  "nodes": [
    {
      "id": "source",
      "label": "从真实客户事项抽象任务\n起点为执业律师处理过的工作\n人物、机构与事项事实均合成\n覆盖 24 个代表性执业领域",
      "type": "user",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "task",
      "label": "定义初级律师级委派任务\n合伙人式指令 · 平均约 50 个英文单词\n限定在封闭的事项材料范围\n指定可供审阅的交付物",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "documents",
      "label": "构建合成事项材料\n在律师指导与审核下批量生成\n混合关键与外围文档\n在多个文件间嵌入待识别问题",
      "type": "document",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "rubric",
      "label": "编写原子化专家评分点\n二元 · 等权 · 不设标准答案\nmatch_criteria 定义通过与失败\n限定交付物 · 来源文档可选",
      "type": "user",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "package",
      "label": "打包独立完整的任务\ntasks/[领域]/[工作流]/[场景]/\ntask.json + documents/\n标题 · 指令 · 工作类型 · 标签\n交付物 · 评分点",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "qc",
      "label": "执行内容与完整性门禁\n律师指导并审核合成材料\n校验 JSON · 标题 · 评分点 · ID 唯一性\n交付物列表 · 禁止旧版权重",
      "type": "process",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布持续演进的 MIT 仓库\n固定 README：1,671 个任务\n24 个执业领域及合同工作\n加入并购尽职调查扩展",
      "type": "database",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "boundary",
      "label": "区分公开与私有资产边界\n公开任务 · 评分准则 · 运行框架\n未发布 train/dev/test 切分\nLAB-AA 私有留出集独立于仓库",
      "type": "document",
      "module": "construction",
      "size": "xl"
    },
    {
      "id": "load",
      "label": "框架加载一个公开任务\ntask.json + 事项材料\n系统提示 · 技能手册 · 任务指令\n智能体访问评分准则即自动失败",
      "type": "process",
      "module": "public_eval",
      "size": "xl"
    },
    {
      "id": "sandbox",
      "label": "为每个任务创建 Podman 沙箱\n禁用网络 · 移除全部 capabilities\n材料目录只读\n工作区与输出目录可写",
      "type": "process",
      "module": "public_eval",
      "size": "xl"
    },
    {
      "id": "agent",
      "label": "运行模型—工具循环\nBash · Read · Write · Edit\nGlob · Grep\n无工具调用时停止 · 默认最多 200 轮\n保存交付物 · 轨迹 · 运行指标",
      "type": "process",
      "module": "public_eval",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "匹配并解析交付文件\n精确 · 扩展名 · 模糊 · LLM 匹配\nDOCX · XLSX · PPTX · PDF 转为文本\n仅加载当前评分点关联文件",
      "type": "process",
      "module": "public_eval",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "每次 LLM 调用评判一个评分点\n标题 + 输出 + match_criteria 提示\n默认 Sonnet 4.6 · 温度 0\nAnthropic/Google\nOpenAI/Mistral · 返回 JSON 判定与理由",
      "type": "process",
      "module": "public_eval",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "应用严格的全通过计分\n每个评分点只能通过或失败\n仅当全部评分点通过时任务得 1 分\n任务级不给部分分",
      "type": "process",
      "module": "public_eval",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "生成 scores.json 与 report.html\n核心指标：任务全通过率\n诊断指标：汇总评分点通过率\n热图 · 覆盖率 · Token · 时间 · 成本",
      "type": "terminal",
      "module": "public_eval",
      "size": "xl"
    },
    {
      "id": "private_holdout",
      "label": "使用独立的私有留出集\n120 个任务 · 24 个执业领域\n镜像公开任务的领域与分布\n不随 MIT 仓库公开发布",
      "type": "database",
      "module": "partner_leaderboard",
      "size": "xl"
    },
    {
      "id": "lab_aa",
      "label": "发布独立 LAB-AA 排行榜\nArtificial Analysis Stirrup 框架\n单一 LLM 逐评分点评判\n全通过率 + 评分点通过率\n成本 · Token · 速度 · 轮数",
      "type": "terminal",
      "module": "partner_leaderboard",
      "size": "xl"
    }
  ],
