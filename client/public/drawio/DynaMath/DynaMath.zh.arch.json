      "type": "process",
      "size": "xl"
    },
    {
      "id": "variations",
      "label": "编码受控变化空间\n数值 · 函数 · 图结构 · 几何\n运算 · 颜色 · 布局 · 情境",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "render",
