      "type": "process",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "人工程序质检\n核验采样条件、图像、解法、\n答案格式与生成难度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "variants",
      "label": "动态评测集\n每个种子随机采样 10 个变体\n501 × 10 = 5,010 道具体问题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "predict",
      "label": "视觉语言模型零样本预测\n图像 + 问题 · 温度 0\n生成推理与短答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extract",
