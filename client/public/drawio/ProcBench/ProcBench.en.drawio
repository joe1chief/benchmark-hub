    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2800" pageHeight="1056" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Fixed Official Evidence&#xa;arXiv 2410.03117v1&#xa;PDF cf5f2ecc5ba3&#xa;Git 06b98344a730&#xa;HF 182e5139c73" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Isolate Instruction Followability&#xa;Fix the Path to the Goal&#xa;Minimize Implicit Knowledge&#xa;Measure Direct Multi-step Inference" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Apply Task Design Criteria&#xa;State the Complete Procedure&#xa;Make Each Human Step Simple&#xa;Require Only Basic English" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Define 23 Distinct Families&#xa;String, List and Integer States&#xa;Varied State-transition Rules&#xa;No Specialized Domain Knowledge" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Write One Fixed Template per Task&#xa;Give the Full Procedure&#xa;Specify Concrete Input Fields&#xa;Request Every Resulting State" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Schedule Controlled Lengths&#xa;Problem Lengths 2 through 25&#xa;Ten Examples at Each Length&#xa;240 Examples per Task Family" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Run Task-specific Generators&#xa;Sample Strings, Lists or Numbers&#xa;Apply Template-defined Operations&#xa;Save Question Configuration" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Enforce Requested Step Count&#xa;Compare Generated State Length&#xa;Drop Any Mismatched Sample&#xa;Resample until the Slot Is Filled" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Generate Ground Truth Together&#xa;Save Initial State&#xa;Save All Intermediate States&#xa;Save Typed Final State" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Freeze Paper-defined ProcBench&#xa;23 Families × 240 Examples&#xa;5,520 Examples in Total&#xa;Fixed Template plus Question" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Derive Length Cohorts&#xa;Short: 2 to 6 Steps&#xa;Medium: 7 to 16 Steps&#xa;Long: 17 to 25 Steps" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Prompt for the Full Sequence&#xa;Provide Template plus Question&#xa;Require Intermediate and Final States&#xa;No Task-specific Helper Prompt" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Collect Free-form Model Output&#xa;Preserve the Raw Answer&#xa;Preserve Model Usage Metadata&#xa;Pass Text to Shared Extraction" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Infer a Per-task Typed Schema&#xa;Read Ground-truth Field Types&#xa;intermediate: Typed List&#xa;final: Integer, String or List" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Normalize with GPT-4o&#xa;Model gpt-4o-2024-08-06&#xa;Structured-output Pydantic Parse&#xa;Exclude Final from Intermediate List" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="Materialize Parsed Prediction&#xa;Keep intermediate and final Fields&#xa;Preserve Task-specific Types&#xa;On Failure Insert Empty Prediction" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value