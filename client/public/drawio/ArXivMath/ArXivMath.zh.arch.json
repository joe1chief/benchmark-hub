      "type": "document",
      "size": "xl"
    },
    {
      "id": "candidate_pool",
      "label": "形成月度候选池\n约 200 道问题\n数值 • 公式 • 特定数学对象",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "full_paper",
      "label": "补齐缺失上下文\n用 DeepSeek-OCR-2 转换全文\n加入必要假设",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "automatic_filters",
      "label": "运行自动筛选\n自包含 • 无法由已有工作猜出\n未使用 AI • 核验作者专业性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "author_review",
      "label": "作者人工复核\n定义明确 • 非平凡 • 有研究价值\n删除所有存疑问题",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布月度 ArXivMath\n复核后约保留 30 题\n保存最终答案标准值",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_runs",
      "label": "使用默认参数运行模型\n每个基准运行四次\n不启用搜索或代码工具",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parser",
      "label": "解析并验证最终答案\n基于 SymPy 判断精确等价\n与标准答案比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "format_repair",
      "label": "修复格式失败\n要求模型重新表述\n使用预期答案格式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "使用 LLM 正确性评审\n交叉检查解析器结论\n标记所有分歧",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_disagreement",
      "label": "人工解决分歧\n占答案不到 1%\n运行后复核可移除歧义题",
      "type": "user",
      "size": "xl"
    },
    {
