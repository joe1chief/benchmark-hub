      "id": "sources",
      "label": "收集中文小说与剧本\n覆盖多种体裁、场景和主要角色\n保持对原始作品的忠实性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "principles",
      "label": "遵循四项采集原则\n原作忠实 • 分布多样\n多轮对话 • 人在回路",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "plot_division",
      "label": "用 GPT-4 识别剧情转折\n在语义边界切分叙事文本\n保证每个片段包含完整剧情",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extract",
      "label": "用 GPT-4 抽取角色扮演对话\n保留台词、行为与场景\n把回复表示为行为加台词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "filter",
      "label": "过滤对话结构与长度\n保留两角色 ABAB 对话直到第三人加入\n仅保留超过五轮的对话",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_qc",
      "label": "人工审查连贯性与质量\n移除损坏或低质量样本\n保留真实多轮角色互动",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "profiles",
      "label": "补全角色档案\n从百度百科获取知识、行为和说话风格\n收集角色 MBTI 标签用于回测",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布论文版本 CharacterEval\n77 个角色 • 1,785 段对话\n11,376 个样本 • 按样本而非对话划分",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model",
      "label": "运行角色扮演对话 Agent\n输入角色档案与多轮上下文\n生成行为与台词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_labels",
      "label": "12 位标注员评价模型回答\n稀疏主观指标矩阵 • 五分量表\n人类判断用于训练 CharacterRM",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "rm",
      "label": "训练 CharacterRM\n以 Baichuan2-13B-base 为骨干\n判断 12 项主观指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "conversation",
      "label": "对话能力\n流畅性 • 连贯性 • 一致性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "character",
      "label": "角色一致性\n知识暴露 • 准确 • 幻觉\n人设行为 • 人设台词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attractiveness",
      "label": "角色扮演吸引力\n类人性 • 沟通技巧\n表达多样性 • 共情",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "personality",
      "label": "人格回测\n心理访谈与 MBTI 分类\n对照角色标签报告 MBTI 准确率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告四维 13 项指标\n比较通用与角色扮演专用 LLM\n分析不同对话轮次的质量",
      "type": "terminal",
      "size": "xl"
    }
