  "nodes": [
    {
      "id": "evidence",
      "label": "Freeze Evidence\nPaper 2406.09411v2 · Code 840b85fe\nData 4c393cff · Pre/Post SHA256 Pinned\n12 Tasks · 10 Relations\nLabels: Task · Type · Position · Count",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "source_route",
      "label": "Answerable Data Source?\nExisting Dataset\nDerived Dataset\nNewly Collected Data",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "existing_source",
      "label": "Existing · 531 · 40.8%\nGeneCIS · SeedBench · IconQA\n≤200 per Dataset · Reuse MCQA",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "derived_source",
      "label": "Derived Data · 282 · 21.7%\nNLVR2 · HallusionBench\nISVQA · MMBench\nReformat Binary/Open/Single-image QA",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "new_source",
      "label": "New Data · 487 · 37.5%\nHistoricalMap · UnivBuilding\nPubMedMQA · SciSlides\nFill Missing Tasks and Image Types",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "answerable_pool",
      "label": "Harmonize MCQA\nReuse / Generate / Rewrite / Combine\nAuthor Missing Coverage\n1,300 Answerable · 2–9 Ordered Images",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "transform_route",
      "label": "Minimal-change Strategy?\nChange Images\nChange Question\nChange Options",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "image_transform",
      "label": "Replace or Reorder Images\n315 Counterparts · 24.2%\nBreak Question-image or\nImage-image Relations",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "question_transform",
      "label": "Modify the Question\n459 Counterparts · 35.3%\nMake Question Incompatible\nwith Images and Options",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "option_transform",
      "label": "Replace the Options\n526 Counterparts · 40.5%\nRemove Any Correct Answer\nPreserve Minimal Difference",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paired_pool",
      "label": "Pair + Metadata\ncounterpart_idx: 1,300 + 1,300\nOne Transform per Counterpart\nRelation Manual · Task/Type Aligned\nCount/Position Auto · Keep Image Order",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "quality_gate",
      "label": "Two-stage QC Passes?\nRules: Format · Gold · Metadata\nCoreference · Redundancy · Access\n4 Experts: Ambiguity · Image Clarity\nRetention · 86.3%",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "quality_reject",
      "label": "Reject QC Failure\nInvalid Format / Gold / Reference / Image\nAmbiguous Query or Unclear Image",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Release MuirBench\n2,600 MCQs · 11,264 Images\n1,300 Pairs · Mean 4.3 · Range 2–9\nData · CC BY 4.0",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "schema",
      "label": "Pinned HF Schema\nidx · task · image_relation · image_type\nquestion · options · answer · image_list\ncounterpart_idx · 3–5 Choices\nPaper images → Release image_list",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "modality_gate",
      "label": "Configure Input?\nVLMEvalKit · T=0 · Retry=10\nNo Full Runner\nNative Multi-image or Concatenated Single-image\nKeep Order + Position",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "concatenate",
      "label": "Concatenate Ordered Images\nBuild One Visual Input\nPath for Single-image Models",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "Prompt + Response\nQuestion · Dynamic A…E Choices\nHint Lists A–D · End with “Answer:”\nCoherent Image Placement\nT=0 · Retry=10 · Keep Raw",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "coverage_gate",
      "label": "Prediction Coverage Complete?\nExpected Full Set · 2,600 Items\nOne Prediction per Released Row",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "candidate_gate",
      "label": "Parser Candidate Count?\nFirst Search (A), Then Bare A\nIf >5 Tokens, Match Option Text",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "random_fallback",
      "label": "Seeded Random Fallback\nNo Candidate Was Found\nrandom.seed(42)\nChoose from Available Labels",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "drift_gate",
      "label": "Multiple-candidate Rule?\nPaper Protocol\nReleased postprocess.py",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "paper_first",
      "label": "Paper Says First Occurrence\nAppendix C.2 Protocol\nDoes Not Match Released Code\nRecord as Specification Drift",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "code_last",
      "label": "Released Code Uses Last Occurrence\nrfind Each Candidate\nargmax Selects Latest Position\nThis Is the Executable Path",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_gate",
      "label": "Parsed Label Equals Gold?\nCompare Extracted Choice Index\nAccuracy per Released Row",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "correct",
      "label": "Correct Item · 1\nPredicted Option Equals Gold\nInclude in Complete Denominator",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "incorrect",
      "label": "Incorrect Item · 0\nPredicted Option Differs\nInclude in Complete Denominator",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "Aggregate Accuracy\nFull-set Denominator · 2,600\nCompare Answerable vs Unanswerable\nPreserve Pair and Subset Labels",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "Human Evaluation Protocol\nTwo Domain Experts\nPair Members Go to Different Experts\nPaper Overall Accuracy · 93.15%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report Robustness\nOverall + 12-task Accuracy\nRelation · Position · Answerability\nTransform-type Error Rates\nMissing Rows → Incomplete · No Full-set Claim",
      "type": "terminal",
      "size": "xl"
    }
  ],
