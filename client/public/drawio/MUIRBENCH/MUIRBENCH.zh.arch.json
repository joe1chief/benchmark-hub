    {
      "id": "evidence",
      "label": "固定一手证据\n论文 2406.09411v2 · 代码 840b85fe\n数据 4c393cff · 固定前后处理 SHA256\n12 种任务 · 10 类关系\n标签：任务 · 类型 · 位置 · 数量",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "source_route",
      "label": "可答题数据来源？\n现有数据集\n派生数据集\n新收集数据",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "existing_source",
      "label": "现有数据 · 531 题 · 40.8%\nGeneCIS · SeedBench · IconQA\n每数据集最多 200 题 · 复用选择题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "derived_source",
      "label": "派生数据 · 282 题 · 21.7%\nNLVR2 · HallusionBench\nISVQA · MMBench\n改写二元、开放或单图问答",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "new_source",
      "label": "新数据 · 487 题 · 37.5%\nHistoricalMap · UnivBuilding\nPubMedMQA · SciSlides\n补齐缺失任务和图像类型",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "answerable_pool",
      "label": "统一多项选择问答\n复用 / 生成 / 改写 / 组合\n人工补齐缺失覆盖\n1,300 个可答题 · 2–9 张有序图像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "transform_route",
      "label": "最小改动策略？\n修改图像\n修改问题\n修改选项",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "image_transform",
      "label": "替换或重排图像\n315 个对应题 · 24.2%\n破坏问题—图像关系或\n图像—图像关系",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "question_transform",
      "label": "修改问题\n459 个对应题 · 35.3%\n使问题与图像及选项\n不再兼容",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "option_transform",
      "label": "替换选项\n526 个对应题 · 40.5%\n移除所有正确答案\n保持语义差异最小",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paired_pool",
      "label": "配对 + 元数据\ncounterpart_idx：1,300 + 1,300\n每个对应题采用一种变换\n关系人工标注 · 任务/类型对齐\n数量/位置自动化 · 保留图像顺序",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "quality_gate",
      "label": "两阶段质检通过吗？\n规则：格式 · 答案 · 元数据\n指代 · 冗余 · 可访问性\n4 位专家：歧义 · 图像清晰度\n保留率 · 86.3%",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "quality_reject",
      "label": "淘汰质检失败样本\n格式 / 答案 / 指代 / 图像无效\n问题有歧义或图像不清楚",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MuirBench\n2,600 题 · 11,264 张图\n1,300 个配对 · 平均 4.3 · 范围 2–9\n数据许可 · CC BY 4.0",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "schema",
      "label": "固定版 HF 字段\nidx · task · image_relation · image_type\nquestion · options · answer · image_list\ncounterpart_idx · 3–5 个选项\n论文 images → 发布 image_list",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "modality_gate",
      "label": "配置输入方式？\nVLMEvalKit · 温度 0 · 重试 10\n未发布完整运行器\n原生多图或拼接为单图\n保留顺序与位置",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "concatenate",
      "label": "拼接有序图像\n构成单个视觉输入\n用于仅支持单图的模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "提示词 + 回答\n问题 · 动态 A…E 选项\n提示仅列 A–D · 末尾“Answer:”\n保持图文位置连贯\n温度 0 · 重试 10 · 保留原文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "coverage_gate",
      "label": "预测覆盖完整吗？\n完整集合应为 2,600 题\n每个发布样本一条预测",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "candidate_gate",
      "label": "解析器找到几个候选？\n先搜索 (A)，再搜索裸字母 A\n回答超过 5 词时匹配选项文本",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "random_fallback",
      "label": "固定种子的随机回退\n没有找到候选\nrandom.seed(42)\n从可用标签中选择",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "drift_gate",
      "label": "多候选采用哪条规则？\n论文协议\n已发布 postprocess.py",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "paper_first",
      "label": "论文规定取首次出现\n附录 C.2 的协议\n与已发布代码不一致\n记录为规格漂移",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "code_last",
      "label": "已发布代码取末次出现\n用 rfind 查找每个候选\nargmax 选择最靠后的位置\n这是实际可执行路径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_gate",
      "label": "解析标签等于标准答案吗？\n比较提取出的选项索引\n对每个发布样本计准确率",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "correct",
      "label": "单项正确 · 1\n预测选项等于标准答案\n纳入完整分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "incorrect",
      "label": "单项错误 · 0\n预测选项不等于标准答案\n纳入完整分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "汇总准确率\n完整集合分母 · 2,600\n比较可答题与不可答题\n保留配对和子集标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "人类评测协议\n两位领域专家\n同一配对的两题分给不同专家\n论文总体准确率 · 93.15%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告鲁棒性\n总体 + 12 个任务准确率\n关系 · 位置 · 可答性子集\n变换类型错误率\n样本缺失 → 不完整 · 不得称完整准确率",
      "type": "terminal",
      "size": "xl"
    }
  ],
