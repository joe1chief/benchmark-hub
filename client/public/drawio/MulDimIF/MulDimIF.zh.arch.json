  "nodes": [
    {
      "id": "raw_questions",
      "label": "ShareGPT 真实用户对话语料\n原始多轮真实用户提问种子\n覆盖丰富的开放领域任务原型",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "4大主类与13种子类约束体系\n长度、格式、语义与风格分类法\n构建多维度细粒度约束规约架构",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "select_category",
      "label": "约束维度抽样引擎\n选取未覆盖的约束维度子类\n在不同层级间均衡约束组合分布",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "add_constraints",
      "label": "约束注入与渐进复合引擎\n每次追加1至2条兼容的细分规则\n将指令难度自 Level I 阶梯式提升至 Level IV",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dual_check",
      "label": "双重可行性与冲突判别闸门\n自动化可解性与逻辑自洽性检验\n确保共存的复合规则互不抵触",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_candidate",
      "label": "淘汰冲突候选样本\n剔除逻辑上不可解的异常规则组合\n丢弃过度约束或语义断裂的提问",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "level_gate",
      "label": "复杂度分级循环判定闸门\n检验是否达到 Level IV 复合深度\n未达到则回环继续注入下一维度约束",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "select_pattern",
      "label": "改写模式路由判定闸门\n分支导向三种标准呈现样式\n示例式、列表式与融入式改写模板",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "example_rewrite",
      "label": "示例驱动模式改写\n追加3组格式对齐的示范问答样例\n通过少样本上下文隐式传达约束意图",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "listing_rewrite",
      "label": "显式列表模式改写\n采用清晰的编号条目列举各条约束\n以直接祈使句形式规范输出结构",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "incorporation_rewrite",
      "label": "自然融入模式改写\n将约束规则润色融入用户背景描述中\n以隐晦自然的语流提出复合需求",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rewritten_pool",
      "label": "多元改写提示样本池\n包含三种呈现模式的多维指令语料\n具备丰富的句式多样性与格式变体",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_data_review",
      "label": "人工数据质量精细评审\n评测员检验语言流畅度与表达自然度\n核验复合指令在现实场景的可执行性",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "checker_draft",
      "label": "Python 规则校验代码生成\n编写确定性自动化判分脚本初稿\n包含 AST、正则匹配与语法解析断言",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dual_code_review",
      "label": "双人双盲代码审计闸门\n两名独立工程师交叉复核判别代码\n彻底消除代码逻辑漏洞与误判风险",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "fixed_release",
      "label": "冻结 MulDimIF 基准正式发布\n包含 7,906 条训练数据与 1,200 道精校测试题\n建立双语多维指令遵循基准",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "test_inference",
      "label": "目标大语言模型推理执行\n在 1,200 道测试集上进行贪婪生成\n完整记录生成词元轨迹与原始输出",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rule_checks",
      "label": "多维细粒度断言执行流水线\n运行严格单元测试级的 Python 校验器\n计算逐条维度的二元（0/1）合规标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sliced_scores",
      "label": "多维分层评测雷达报告\n输出按难度等级、约束类别与全局严格准确率\n生成权威多维度指令遵循能力榜单",
      "type": "terminal",
      "size": "xl"
    }
