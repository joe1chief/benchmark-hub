    {
      "id": "sources",
      "label": "人工收集英文多选题\n免费访问的模拟测验与在线考试\n五类职业 · 来源解释用于构建\n保留或改写方式未披露\n60% 及格线仅作描述 · 不作筛选",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "source_boundary",
      "label": "来源溯源边界\n论文未逐题列出来源网址\n原始题量与来源构成未报告\n未报告逐题上游权利审计",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "exact_dedup",
      "label": "删除完全重复项\n对问题去重\n对解释去重\n各阶段剔除数量未报告",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "semantic_filter",
      "label": "删除语义相似问题\n使用 BERT 表征与余弦相似度\n检查语义近重复\n模型版本与阈值未披露",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "legal_filter",
      "label": "排除法律法规类问题\n使用人工整理的关键词表\n词表与匹配规则未发布\n本阶段剔除数量未报告",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "shuffle",
      "label": "打乱答案选项\n为合理使用调整原始选项位置\n保持正确答案映射不变\n算法与随机种子未披露",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "explanation_pair",
      "label": "每个问答对附两份解释\n采用不同写作风格\n对正确选项给出可理解的推理\n全集解释对相似度为 78.7%",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "construction_validation",
      "label": "人工核验每条记录\n检查问题与两份解释\n确认表达方式不同\n确认医学推理正确且可理解",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "construction_boundary",
      "label": "构建审核边界\n解释的撰写或选择方法未说明\n核验人数与资质未报告\n分工、裁决与一致性未报告",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "corpus",
      "label": "形成 965 道英文多选题\n生物医学工程 148 · 实验室科学 377\n临床心理学 111 · 作业治疗 194\n言语语言病理学 135",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "在每个专业内划分数据\n开发集：每类 5 道，共 25 道\n测试集：143 + 372 + 106 + 189 + 130 = 940\n除人工评测外，模型评测均使用测试集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release_rights",
      "label": "发布数据集与研究资产\n数据集采用 CC BY-NC-SA 4.0 · 仅限非商业\n基于该数据训练的模型仅限研究用途\n未验证可用于临床决策",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "models",
      "label": "评测 22 个模型条目\n18 个开源基线 + MedPhi-2\nGPT-3.5-1106 · GPT-4-1106 · GPT-4-0125\n零样本 · 批大小 1 · 温度 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "evaluation_arm",
      "label": "选择评测分支？\n下一词元分类\n或对话式答案加解释",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "logits",
      "label": "下一词元概率分类\n无法取得概率的三个 GPT 接口不参与\n汇集 A · B · C · D 的概率\n选择概率最高的词元",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "chat_generation",
      "label": "生成对话式答案与解释\n发布脚本采用贪心解码\n不采样 · 最多生成 300 个新词元\n将 generated_text 直接交给解析器",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "chat_parser",
      "label": "将对话答案解析为 A 至 D\n替换选项文本 · 正则匹配答案句式\n首个独立字母 · thefuzz 兜底\n模糊匹配后不存在弃答状态",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "chat_correct",
      "label": "解析出的选项\n是否等于标准答案？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "answer_accuracy",
      "label": "计算答案准确率\n逐题精确比较 A 至 D\n分别报告各专业结果\n论文报告五专业宏平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "explanation_metrics",
      "label": "评价生成解释\nBLEU · ROUGE-L · METEOR\n通过 evaluate 计算 SciBERT BERTScore\n与两份参考解释比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "explanation_zero",
      "label": "将全部解释指标强制置零\n字符串匹配答案错误时必须执行\n错误答案的推理不能获得部分分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_evaluation",
      "label": "25 道开发题人工评分规则\n三名健康相关专业硕士评审\n0 分：错误 / 缺失 / 无关\n0.5 分：答案对 / 理由有缺陷\n1 分：答案与理由均正确",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_boundary",
      "label": "人工评审边界\n未报告题目分配与每题评审人数\n未报告分数聚合方式\n未报告裁决与一致性",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告评测结果\n答案 · 解释 · 人工评价\n五专业宏平均\n与人工评分的相关系数\n单参考 .9347 · 双参考 .9385",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "implementation_boundary",
