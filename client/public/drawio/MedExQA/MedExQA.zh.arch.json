      "type": "process",
      "size": "xl"
    },
    {
      "id": "semantic",
      "label": "过滤语义近似题\n使用 BERT 编码问题\n比较余弦相似度\n移除近重复题目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "legal",
      "label": "排除法律法规题\n使用人工定义关键词表\n移除特定司法辖区内容\n保留可迁移医学知识",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "shuffle",
