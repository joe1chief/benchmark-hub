      "type": "document",
      "size": "xl"
    },
    {
      "id": "validation",
      "label": "人工核验每条记录\n检查问题与两份解释\n确认表达方式不同\n确认医学推理正确",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "corpus",
      "label": "形成 965 道英文多选题\n生医工 148 · 检验 377 · 心理 111\n作业治疗 194\n言语语言病理 135",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "划分开发集与测试集\n每个专业取五条开发样本\n开发集 = 25\n测试集 = 940",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "models",
      "label": "评测 22 个模型\n18 个开放基线 · 三个 GPT 模型\n加入 MedPhi-2\n零样本 · 批量一 · 温度零",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer",
      "label": "解析答案分类\n基础模型使用下一词元 logits\n聊天模型用正则与模糊匹配\n将选项与标准答案比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "评估生成解释\nBLEU · ROUGE-L · METEOR\nSciBERT BERTScore\n答案错误则解释得分为零",
