<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="检索 MedEdPORTAL&#xa;“Simulation Case”与&#xa;“Standardized Patient”&#xa;1,073 篇文章&#xa;22,244 个附件" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="按文本完整性筛选&#xa;直接保留 931 篇可抽取文章&#xa;人工审查 142 篇多模态文章&#xa;保留 86 · 丢弃 56 · 共 1,017" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="转为统一 Markdown&#xa;Office 文档使用 MarkItDown&#xa;DOC 与 PDF 使用 MinerU2 和 OCR&#xa;生成 7,147 个 Markdown 文件" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="评估文本仿真可行性&#xa;Codex 阅读文章全部文件&#xa;抽取专科与紧急程度&#xa;1,017 篇中保留 613 篇" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="拆分独立就诊场景&#xa;每条元数据对应一个场景&#xa;分配至 17 个临床专科&#xa;得到 1,638 个可执行病例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="划分四类角色包&#xa;场景初始化 · 病人&#xa;环境控制器 · 评估者&#xa;复制后删除角色不可见段落" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="审计泄漏与一致性&#xa;检查评分项语义等价信息&#xa;检查病人扮演信息充分性&#xa;迭代修正异常" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="解析冻结专家 Rubric&#xa;逐字复制每条评分点&#xa;不合并也不改写&#xa;24,602 条映射至六项 ACGME 能力" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="由临床医生验证构建质量&#xa;12 名医生 · 平均医学训练八年&#xa;100 个抽样病例每例双人评分&#xa;修正形成 100 例验证子集" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="发布 MedSP1000&#xa;由 613 篇文章形成 1,638 例&#xa;17 个专科 · 六项能力&#xa;24,602 条轨迹级 Rubric" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="初始化被评临床模型&#xa;仅披露场景初始化信息&#xa;输出 speak · actions · eos&#xa;通过交互逐步获取信息" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="运行闭环仿真&#xa;病人智能体负责对话&#xa;控制器处理行动与状态推进&#xa;无来源结果标为不支持且绝不捏造" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="评估完整交互轨迹&#xa;评估智能体接收冻结 Rubric&#xa;每项二元判断完成或未完成&#xa;运行验证：100 次运行每次双人评分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="报告 Rubric 完成率&#xa;总体与专科：病例宏平均&#xa;能力维度定义在论文中冲突&#xa;第 2.1.3 节微平均&#xa;第 4.3 节公式 3 宏平均" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="固定发布计数边界&#xa;HF scenario_index：1,639 个路径&#xa;代码：1,638 个 Rubric 文件&#xa;其中 4 个为空 · 1,634 个可解析" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="运行协议边界&#xa;论文：无轮数上限 · temperature 0&#xa;仓库示例：最多 12 轮&#xa;默认 API 路径不传 temperature" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="能力维度聚合冲突&#xa;第 2.1.3 节汇总评分项：微平均&#xa;第 4.3 节公式 3 平均病例比率：宏平均&#xa;论文没有调和两种定义" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="权利标签冲突&#xa;论文：数据 CC BY-NC-SA · 代码 CC BY-SA&#xa;HF 卡片与仓库 LICENSE 写 MIT&#xa;仍须遵守原始 MedEdPORTAL 条款" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeS