    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2312" pageHeight="1008" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="冻结主要证据版本&#xa;论文v1 · 附录A&#xa;代码2b8237bb · 数据429e30e9&#xa;核查于2026-07-21" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义八类富文本场景&#xa;标牌 · 标签 · 印刷品 · 网页&#xa;幻灯片 · 海报 · 字幕 · 对话&#xa;论文未报告来源语料库" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="304" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="每类生成20条提示&#xa;GPT-4o · 短文本与长文本各10条&#xa;生成图像描述&#xa;原始提示词与解码参数未公开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="576" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="逐条人工后审&#xa;审核生成的描述&#xa;调整待渲染文字长度&#xa;使长度分布更均衡" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="848" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="论文构建输出&#xa;8 × 20 = 160条提示&#xa;设计上短文本与长文本各80条&#xa;面向中英文文字渲染" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="固定公开版本 · 429e30e9&#xa;英文160行 + 中文160行&#xa;共享ID · 类别 · 长短标签&#xa;prompt · text[] · text_length&#xa;无训练/开发/测试划分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1392" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="未披露的构建协议&#xa;GPT-4o版本/提示词/解码参数&#xa;中文改写或翻译路径&#xa;标注人数/拒绝规则/争议裁决&#xa;无更多过滤或QC协议" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="848" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="长短标签描述的是分布&#xa;英文短10–30词 · 长文本多为30–50词&#xa;中文短文本多为20–40字 · 长文本通常超60字&#xa;固定发布数据仍含标签离群值&#xa;这些范围不是硬性验收门槛" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1392" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="英文语言视图&#xa;text_prompts.jsonl · 160个ID&#xa;八类场景 · 每类20条&#xa;短文本与长文本各80条" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1664" y="64" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="中文语言视图&#xa;text_prompts_zh.jsonl · 160个ID&#xa;ID/类别/长短标签与英文一致&#xa;内容不是统一的逐字翻译" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1664" y="360" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="候选图像生成模型&#xa;输入完整的对应语言提示&#xa;每个提示ID生成4张图&#xa;基准侧不截断提示" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2032" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="图像生成协议未标准化&#xa;候选模型与检查点&#xa;分辨率 · 随机种子 · 采样器 · 引导&#xa;改写与安全拒绝处理&#xa;论文和评测器均未固定" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2032" y="0" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="每种语言预期160 × 4&#xa;640张PNG · 双语合计1,280张&#xa;prompt_id_repeat_id.png&#xa;ID为0–199且有两段20-ID空缺" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2032" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="官方MODE = en或zh&#xa;选择匹配JSONL与图像目录&#xa;排序目录内全部*.png&#xa;解析下划线或点号前的整数ID&#xa;用ID映射prompt与text[]" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Qwen2.5-VL-7B-Instruct OCR&#xa;图像 + 固定英文OCR提示&#xa;只返回文字 · 避免重复&#xa;提示规定空结果：&quot;No text recognized&quot;&#xa;max_new_tokens = 1,024" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1488" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="固定OCR清理漂移&#xa;目标为addCriterion与&quot;No text recognized.&quot;&#xa;循环每轮复用原始OCR，首项删除被覆盖&#xa;带句点的空结果可被删除&#xa;提示要求的无句点空结果仍保留&#xa;逐图保存OCR与标准文字" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1216" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="按评测MODE归一化？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="944" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="英文模式归一化&#xa;保留中日韩字符/拉丁字母/数字/空格&#xa;删除标点并合并连续空格&#xa;小写化 · 按空白切词" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="624" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="中文模式归一化&#xa;保留中日韩字符/拉丁字母/数字&#xa;删除标点与全部空白&#xa;每个剩余字符作为一个单位" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="624" y="608" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="无序Counter交集&#xa;重复单位按双方较小频次计数&#xa;丢弃片段顺序与相对顺序&#xa;多余OCR单位不受惩罚" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="304" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="单图文字准确率&#xa;匹配标准单位数 / 标准单位总数&#xa;类召回覆盖率 · 不用编辑距离&#xa;代码键名误拼为text_accuray" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="每个MODE的官方Text Score&#xa;Σ逐图匹配数 / Σ逐图标准单位数&#xa;对已读入图像做微平均&#xa;不是提示或4次重复的均值" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="32" y="824" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="每次运行只报告一种语言&#xa;scores.txt · 保留4位小数&#xa;不检查全集或重复次数是否完整&#xa;缺失/额外PNG会改变样本权重&#xa;并可能改变得分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="304" y="824" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="固定HF静态榜单&#xa;11行模型结果 · 无人工上界&#xa;英文 · 中文 · Avg&#xa;Avg = (英文 + 中文) / 2&#xa;无提交或实时更新协议" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="576" y="824" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="发布与开放边界&#xa;Apache-2.0公开代码与提示JSONL&#xa;无官方生成图像包&#xa;静态表格而非托管评测服务&#xa;无人工参考得分" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="848" y="824" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="复现注意事项 · 2b8237bb&#xa;Qwen模型名未固定revision&#xa;README固定Transformers 4.52.0&#xa;eval.sh写出results.jsonl&#xa;却调用不存在的results.json" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="824" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242