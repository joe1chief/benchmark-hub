  },
  "nodes": [
    {
      "id": "evidence",
      "label": "冻结主要证据版本\n论文v1 · 附录A\n代码2b8237bb · 数据429e30e9\n核查于2026-07-21",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "scenarios",
      "label": "定义八类富文本场景\n标牌 · 标签 · 印刷品 · 网页\n幻灯片 · 海报 · 字幕 · 对话\n论文未报告来源语料库",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "gpt4o",
      "label": "每类生成20条提示\nGPT-4o · 短文本与长文本各10条\n生成图像描述\n原始提示词与解码参数未公开",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_qc",
      "label": "逐条人工后审\n审核生成的描述\n调整待渲染文字长度\n使长度分布更均衡",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "paper_total",
      "label": "论文构建输出\n8 × 20 = 160条提示\n设计上短文本与长文本各80条\n面向中英文文字渲染",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release_snapshot",
      "label": "固定公开版本 · 429e30e9\n英文160行 + 中文160行\n共享ID · 类别 · 长短标签\nprompt · text[] · text_length\n无训练/开发/测试划分",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "construction_gaps",
      "label": "未披露的构建协议\nGPT-4o版本/提示词/解码参数\n中文改写或翻译路径\n标注人数/拒绝规则/争议裁决\n无更多过滤或QC协议",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "length_stats",
      "label": "长短标签描述的是分布\n英文短10–30词 · 长文本多为30–50词\n中文短文本多为20–40字 · 长文本通常超60字\n固定发布数据仍含标签离群值\n这些范围不是硬性验收门槛",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "en_file",
      "label": "英文语言视图\ntext_prompts.jsonl · 160个ID\n八类场景 · 每类20条\n短文本与长文本各80条",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "zh_file",
      "label": "中文语言视图\ntext_prompts_zh.jsonl · 160个ID\nID/类别/长短标签与英文一致\n内容不是统一的逐字翻译",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "candidate",
      "label": "候选图像生成模型\n输入完整的对应语言提示\n每个提示ID生成4张图\n基准侧不截断提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generation_gap",
      "label": "图像生成协议未标准化\n候选模型与检查点\n分辨率 · 随机种子 · 采样器 · 引导\n改写与安全拒绝处理\n论文和评测器均未固定",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sample_files",
      "label": "每种语言预期160 × 4\n640张PNG · 双语合计1,280张\nprompt_id_repeat_id.png\nID为0–199且有两段20-ID空缺",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "ingest",
      "label": "官方MODE = en或zh\n选择匹配JSONL与图像目录\n排序目录内全部*.png\n解析下划线或点号前的整数ID\n用ID映射prompt与text[]",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ocr",
      "label": "Qwen2.5-VL-7B-Instruct OCR\n图像 + 固定英文OCR提示\n只返回文字 · 避免重复\n提示规定空结果：\"No text recognized\"\nmax_new_tokens = 1,024",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cleanup",
      "label": "固定OCR清理漂移\n目标为addCriterion与\"No text recognized.\"\n循环每轮复用原始OCR，首项删除被覆盖\n带句点的空结果可被删除\n提示要求的无句点空结果仍保留\n逐图保存OCR与标准文字",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize_mode",
      "label": "按评测MODE归一化？\n多维度质量与逻辑严谨性决策门\n基于严格阈值的合格判定准则",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "en_norm",
      "label": "英文模式归一化\n保留中日韩字符/拉丁字母/数字/空格\n删除标点并合并连续空格\n小写化 · 按空白切词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "zh_norm",
      "label": "中文模式归一化\n保留中日韩字符/拉丁字母/数字\n删除标点与全部空白\n每个剩余字符作为一个单位",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "match",
      "label": "无序Counter交集\n重复单位按双方较小频次计数\n丢弃片段顺序与相对顺序\n多余OCR单位不受惩罚",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "image_ratio",
      "label": "单图文字准确率\n匹配标准单位数 / 标准单位总数\n类召回覆盖率 · 不用编辑距离\n代码键名误拼为text_accuray",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "micro_score",
      "label": "每个MODE的官方Text Score\nΣ逐图匹配数 / Σ逐图标准单位数\n对已读入图像做微平均\n不是提示或4次重复的均值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "language_report",
      "label": "每次运行只报告一种语言\nscores.txt · 保留4位小数\n不检查全集或重复次数是否完整\n缺失/额外PNG会改变样本权重\n并可能改变得分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "leaderboard",
      "label": "固定HF静态榜单\n11行模型结果 · 无人工上界\n英文 · 中文 · Avg\nAvg = (英文 + 中文) / 2\n无提交或实时更新协议",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "openness",
      "label": "发布与开放边界\nApache-2.0公开代码与提示JSONL\n无官方生成图像包\n静态表格而非托管评测服务\n无人工参考得分",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "runner_gap",
      "label": "复现注意事项 · 2b8237bb\nQwen模型名未固定revision\nREADME固定Transformers 4.52.0\neval.sh写出results.jsonl\n却调用不存在的results.json",
      "type": "document",
      "size": "xl"
    }
  ],
