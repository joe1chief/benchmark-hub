  "nodes": [
    {
      "id": "scenarios",
      "label": "定义八类富文本场景\n标牌 · 物体标签 · 印刷品 · 网页\n幻灯片 · 海报 · 字幕 · 对话\n覆盖实用长文本布局",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "生成英文候选提示\n每类使用GPT-4o生成\n每个场景20个提示\n10个短文本 + 10个长文本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "bilingual",
      "label": "构建对应中文记录\n共享类别 · 长度 · prompt ID\n保留预期渲染文字\n分开保存中英文视图",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "lengths",
      "label": "平衡文字长度分档\n英文短10–30词 · 长30–50词\n中文短20–40字\n中文长文本通常超过60字",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "人工复核每个提示\n检查场景与文字一致性\n调整待渲染文字长度\n改善长度分布平衡",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布LongText-Bench\n160个双语提示概念\n160条英文 + 160条中文记录\nprompt · text · category · length · ID",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "render",
      "label": "生成评测图像\n使用各语言专用提示词\n每个提示采样4张图像\n保存为prompt_id_repeat_id.png",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ocr",
      "label": "用Qwen2.5-VL-7B识别文字\n要求仅返回文字内容\n避免重复已识别内容\n最多生成1,024个新词元",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "归一化OCR与标准文字\n删除标点与符号\n英文 · 小写化并合并空格\n中文 · 保留汉字与字母数字",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "match",
      "label": "按无序多重集合匹配\n英文单位 · 单词\n中文单位 · 字符\n忽略文字片段相对顺序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "计算单图文字准确率\n匹配到的标准文字单位数\n除以全部标准文字单位数\n不使用编辑距离",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告LongText-Bench得分\n对全部图像做微平均\n汇总每个提示的4次采样\n报告英文 · 中文 · 总平均",
      "type": "terminal",
      "size": "xl"
    }
  ],
