  "nodes": [
    {
      "id": "step_1",
      "label": "识别候选开源仓库\n要求可构建独立程序\n优先编译型语言项目\n覆盖多种软件领域",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "标准化采集Agent\nmini-SWE-agent框架\nClaude Sonnet 4.5\nUbuntu 22.04 Docker容器",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "构建标准可执行程序\n从原始源代码编译\n验证程序能够运行\n记录单一可复现构建脚本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "探索外部可观察行为\n阅读源码文档与原生测试\n用多样输入调用参考程序\n收集现有行为测试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "生成行为测试\n断言stdout stderr及退出码\n检查生成文件与副作用\n不依赖源码内部实现",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "按覆盖率扩充测试\n测量当前行覆盖率\n定向覆盖缺失代码路径\n迭代追求完整覆盖",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "检查断言质量\n标记仅退出码检查\n标记短子串与或式断言\n提示Agent修复弱测试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "过滤无效测试\n要求标准程序确定性通过\n删除虚假程序也能通过的测试\n只保留外部可观察断言",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "移除实现细节\n删除源代码与原始测试\n清理使用文档\n仅保留任务可见信息",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "构建离线任务镜像\n注入只可执行标准程序\n加入清理后文档与必需资产\n禁网并禁止读取二进制",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "发布基准\n200个开源程序任务\n共248,853个测试函数\n每任务测试中位数770",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "从黑盒行为重建程序\n探测可执行程序与文档\n编写源代码与构建脚本\n任意语言 · 1,000步 · 6小时",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "运行隐藏行为测试\n构建并调用候选程序\n比较所有外部可观察效果\n排除被判为作弊的方案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "评估行为等价性\nResolved：全部测试通过\nTests Passed：衡量部分进展\nAlmost：至少95%测试通过",
      "type": "terminal",
      "size": "xl"
    }
  ],
