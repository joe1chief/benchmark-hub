  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1184" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;arXiv 2607.02032v2 SHA256 0af39b8c953f&#xa;Git dc2ef80e00ad · 筛选代码 a42cd03e0977&#xa;HF ce177cfe25bc · 数据卡 c7fbf603d2d6" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="评测四个智能体目标与 14 个模型&#xa;GAIA 165 · SWE-Bench Verified 500&#xa;SWE-Bench Multimodal 102&#xa;SWT-Bench 430 · 使用 OpenHands Index" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="评测 19 个非智能体基准&#xa;覆盖 11 类能力的实例得分&#xa;使用 lm-evaluation-harness 或官方代码&#xa;提供低成本文本、代码与多模态信号" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="构建来源与目标矩阵&#xa;X：模型乘来源实例得分&#xa;P：逐目标实例的智能体得分&#xa;丢弃近零方差来源列" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="选择协议&#xa;留出验证&#xa;或全模型发布" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="执行严格模型留一验证&#xa;14 个模型中留出 1 个&#xa;其余 13 个用于筛选与拟合&#xa;汇总 14 次留出预测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="形成论文全局 SVD 基&#xa;仅对校准矩阵 X 做薄 SVD&#xa;保留右奇异几何结构 V&#xa;论文方法声明排除留出模型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="论文与代码的 SVD 边界&#xa;论文声明排除留出模型&#xa;cli.py 用全部 14 行 X 构建 Vt_full&#xa;目标 Y 仍只使用训练折" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="为每个候选实例打分&#xa;相关性为绝对 Spearman rho&#xa;杠杆度 h 为 V 载荷平方和&#xa;rho 仅由校准模型计算" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="拆分严格预算 C&#xa;局部预算 C_L&#xa;全局预算 C_G" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="选择局部子集 L&#xa;按绝对 Spearman rho 排序&#xa;在已选 X_L 上重新执行 SVD&#xa;构建目标自适应局部基" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="232" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="选择全局子集 G&#xa;按 h 乘绝对 rho 排序&#xa;使用全局来源池几何结构&#xa;兼顾信息量与目标相关性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="保证 C 个唯一复合实例&#xa;按 C_L:C_G 比例合并 L 与 G&#xa;遇到重叠时继续扩展两侧排序&#xa;每个目标达到 C = 100 后停止" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="嵌入校准模型与留出模型&#xa;L 使用局部 SVD 坐标&#xa;G 使用全局伪逆坐标&#xa;始终保留两个独立视角" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="筛选后自助采样目标实例&#xa;对目标条目进行有放回采样&#xa;复现设置 B = 300 且种子为 42&#xa;汇集含噪目标均值用于拟合" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="预测目标&#xa;绝对得分&#xa;或成对排序" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="目标 A：发布代码实现&#xa;以 Spearman 权重投影 SVD 坐标&#xa;对自助采样目标均值拟合带截距 OLS&#xa;论文正文描述原始 C 维向量预测器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="目标 B：预测成对偏好&#xa;构造有序模型得分差&#xa;拟合带岭正则的逻辑回归&#xa;复用目标 A 的实例筛选" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="集成局部与全局路径&#xa;用 lambda 混合两类留出预测&#xa;按目标调节预算、秩与混合系数&#xa;保持严格 100 实例并集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="报告 C = 100 的留一代理质量&#xa;平均 MAE 3.80% · Spearman 0.81&#xa;Pearson 0.74 · 成对准确率 84.37%&#xa;目标成本低于 1%&#xa;自动调参使用聚合后的留出标签" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="物化全模型 PACE-Bench&#xa;使用固定超参数与全部 14 个模型&#xa;此分支没有留出预测&#xa;为四个目标拟合两条路径的权重" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="1000" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="发布四个加权 JSONL 文件&#xa;GAIA 100 · SWE 100&#xa;多模态 105 · SWT 107 行&#xa;含题面、答案、指标、权重、图像 · 来源 12 / 19" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="1000" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="验证与身份边界&#xa;留一指标不等于全模型发布评测&#xa;每个文件有 100 个唯一复合键&#xa;多模态 5 行、SWT 7 行为局部/全局重复" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="1000" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="发布内容边界&#xa;412 行中 405 行内容已解析&#xa;上游漂移导致 7 行仍未解析&#xa;身份键为基准、子目录与实例 ID" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="1000" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="开放性与许可边界&#xa;HF 声明 mixed-upstream&#xa;每个实例保留各自上游条款&#xa;Git 快照没有 LICENSE 或标签发布" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="1000" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="4"><mxGeometry relative="1" as="geometry"><Array as="points"><mxPoint x="140" y="190"/><mxPoint x="620" y="190"/></Array></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exit