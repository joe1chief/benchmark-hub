<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="1056" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="定义医疗安全范围&#xa;九项 AMA 医学伦理原则&#xa;违反原则即有害请求&#xa;建立医疗特有风险分类" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="GPT-4 生成分支&#xa;每次针对一项原则提示&#xa;要求生成 20 条医疗请求&#xa;要求包含医学术语" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="筛选 GPT-4 请求&#xa;共 900 条&#xa;每项原则 100 条&#xa;删除重复与无关样本&#xa;保留直接伦理违规请求" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Llama-2 生成分支&#xa;使用 Llama-2-7b-chat&#xa;贪婪坐标梯度攻击&#xa;优化肯定式目标回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="筛选 GCG 请求&#xa;九项原则共 900 条&#xa;各原则数量&#xa;118/114/62/112/100&#xa;48/122/128/96" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="合并并去重&#xa;得 1,800 条唯一请求&#xa;GPT-4 900 + Llama-2 900&#xa;覆盖九项原则" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="编写安全示范回应&#xa;GPT-4 拒绝每条请求&#xa;简述伦理风险&#xa;人工验证并编辑" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="按九项原则分层&#xa;MedSafety-Eval 900 条&#xa;MedSafety-Improve 900 条&#xa;每份均为 450 + 450 来源" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="医生验证&#xa;25 名医生 × 每人 25 条&#xa;共 625 次评定·567/625 不道德&#xa;482/567 匹配至少两项原则" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="维护版本边界&#xa;当前仓库新增 74,374 条&#xa;论文后 Llama-3 请求&#xa;不纳入论文基准" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="准备安全评测输入&#xa;MedSafety-Eval 900 条&#xa;GenSafety-Eval 330 条&#xa;仅提供有害请求&#xa;不展示安全参考回应" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="生成自由文本回应&#xa;测试通用与医疗大模型&#xa;贪婪解码&#xa;OpenAI 温度为 0&#xa;最多 512 个词元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="GPT 安全裁判&#xa;gpt-3.5-turbo-0125&#xa;温度为 0&#xa;AMA 或通用安全政策&#xa;输出 #reason 与 #score" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="解释裁判分数&#xa;1 = 完全拒绝&#xa;5 = 完全服从&#xa;分数越低越安全&#xa;报告均值 + 标准误" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="568" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="已发布评测器边界&#xa;仅保留 #reason 与 #score 原文&#xa;未提供分数解析或聚合器&#xa;复现时需自行实现" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="构建对齐数据混合&#xa;医疗安全 900 条&#xa;通用安全 900 条&#xa;合并安全 1,800 条" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="微调医疗大模型&#xa;Medalpaca 7B / 13B&#xa;Meditron 7B&#xa;比较三种安全数据混合" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="检查医疗能力保持&#xa;MedQA · MedMCQA&#xa;PubMedQA · MMLU-Medical&#xa;三样本上下文学习&#xa;从训练集随机抽取示例&#xa;取 10 个随机种子的平均准确率" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="报告安全性与效用&#xa;安全分数均值 + 标准误&#xa;比较对齐前后&#xa;报告能力准确率" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeCol