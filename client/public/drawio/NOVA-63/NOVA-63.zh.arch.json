    {
      "id": "native_sources",
      "label": "母语者采集本地题目\n教育网站 · 学术出版物 · 考试\n中学至研究生层级\n验证母语与文化真实性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "format",
      "label": "LLM 上下文学习格式规范化\n提取题干 · 选项 · 答案\n同时分类为选择题或问答题\n去除 HTML 与无关内容",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extraction_review",
      "label": "抽样人工核验提取质量\n检查多媒体过滤与原文保留\n检查完整性与格式\n不是逐题人工关卡",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extraction_gate",
      "label": "提取完整且可\n独立作答吗？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_extract",
      "label": "淘汰提取失败项\n缺少组件或上下文\n格式不可用",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "quality_filter",
      "label": "LLM 质量标注\n可读性 1–3 · 完整性 0–1\n清晰度与一致性 1–3\n评分并给出理由",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality_gate",
      "label": "每项质量指标都达到最高分吗？\n可读性 3 · 完整性 1\n清晰度与一致性 3",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_quality",
      "label": "淘汰质量失败项\n缺少媒体或上下文\n可读性差或含歧义",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "classify",
      "label": "添加多维元信息\n13 个一级 · 63 个二级 · 262 个三级学科\n分层选择最接近类别\n识记型或推理型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_panel",
      "label": "难度评估模型组\n对话与推理模型\n小模型 ≤14B · 大模型 >14B\n零样本 · 种子 42 · 温度 0",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_annotation",
      "label": "执行模型难度标注\n记录正误与所选选项\n先解析 JSON 再按答案文本兜底\n淘汰显式依赖多媒体的题目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "difficulty_gate",
      "label": "大模型准确率\n低于 50% 吗？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_easy",
      "label": "淘汰难度不足项\n大模型准确率 ≥50%",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "abnormal_gate",
      "label": "难度模式可疑吗？\n小模型更高或错误选项答案集中\n交由母语专家复核",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "manual_validation",
      "label": "母语专家人工核验\n检查语言 · 歧义 · 缺失媒体\n验证参考答案\n需具备相关研究生专业背景",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "validation_gate",
      "label": "触发附录最终阈值\n或复核发现错误吗？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_abnormal",
      "label": "淘汰可疑题目\n触发附录阈值规则或\n母语复核发现错误",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "selected_pool",
      "label": "初始高难有效题池\n在二级学科层面\n统计和协调题量",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "supplement_gate",
      "label": "二级学科题池\n需要补充吗？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "qa_conversion",
      "label": "将选定问答题转为选择题\n对照标准答案判定模型回答\n用常见模型错误构造干扰项\n共转换 2,425 道题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "conversion_rescreen",
      "label": "重新应用此前全部标准\n再做质量与难度筛选\n每道转换题都人工复核\n检查母语流畅度与翻译腔",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "interdisciplinary",
      "label": "重分配跨学科题目\nLLM 判断潜在学科交叉\n将题目移入较小题池\n平衡二级学科分布",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_review",
      "label": "最终人工复核\n学科相关性 · 文本质量\n机器翻译痕迹\n完整性与明显逻辑错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_gate",
      "label": "所有最终复核\n标准都通过吗？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_final",
      "label": "淘汰最终复核失败项\n相关性或质量低\n有翻译痕迹或不完整",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "balance",
      "label": "平衡语言 × 二级学科\n至少保留 50 道题\n上限设为 150 道题\n超出上限时随机采样",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "NOVA-63 论文基准\n89,107 道母语选择题 · 14 种语言\n8 个语系 · 63 个二级学科\n每个语言-学科单元 50–150 道",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "evaluate",
      "label": "评测 62 个 LLM\n对话/推理模型：零样本结尾答案\n基座模型：五样本选项概率\n同学科内复用示例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "报告精确选项准确率\n题目 · 二级学科 · 一级学科平均\n主结果采用一级学科均值\n避免大规模学科权重过高",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "publication_boundary",
      "label": "论文与发布边界\nACL PDF SHA-256 630e3a… 报告 89,107\nACL 网页摘要当前写 93,536\nHF 修订 7bfc985… 仅含 README\nMIT 数据卡注明数据仍在评审",
      "type": "document",
      "size": "xl"
    }
