<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="552" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定的一手证据&#xa;arXiv 2506.07977v3 · PDF d23bb2e1d69d&#xa;Git 41b49831e79e · HF f80e6317806b&#xa;第 3.1–3.2、4.1 节 · 附录 A" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义五个评测维度&#xa;提示图像对齐 · 文本渲染&#xa;知识推理 · 风格&#xa;跨提示集合的多样性" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="整理真实需求提示&#xa;公开互联网数据&#xa;用户输入&#xa;既有数据集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="平衡提示分布&#xa;聚类场景与语义&#xa;避免单一类别占优&#xa;维持五个维度比例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="去除语义重复&#xa;发现高度重叠提示&#xa;比较聚类中心嵌入&#xa;按余弦相似度过滤" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="改写提示长度&#xa;GPT-4o · Beta(2.37, 2.86)&#xa;短于 30 · 中等 30 至 60&#xa;长于 60 个词&#xa;比例约为 1:2:1" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="执行人工审核&#xa;移除敏感内容&#xa;拒绝语义冲突&#xa;检查提示合理性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="构建中文发布集&#xa;翻译并核验 1,120 条提示&#xa;增加 200 条多语种提示&#xa;保留五个共享类别" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="发布六个提示集合&#xa;动漫 245 · 人像 244 · 物体 206&#xa;文本 200 · 推理 225 · 多语种 200&#xa;英文 1,120 · 中文 1,320" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="固定代码边界&#xa;Git CSV 分别为 1,120 和 1,320 行&#xa;每条提示一个宫格文件 · 按 m×n 切分&#xa;image_grid 为 2 时表示四张图&#xa;问题图与推理答案预先生成" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="生成评测图像&#xa;选择特定维度的提示子集&#xa;建议每条提示使用四个随机种子&#xa;按类别与模型存储" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="评测语义对齐&#xa;论文：GPT-4o 构建 DSG 图&#xa;代码：加载固定问题图&#xa;Qwen2.5-VL-7B 回答问题&#xa;按父节点答案控制后代计分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="评测文本渲染&#xa;Qwen2.5-VL 提取并清理文本&#xa;编辑距离 · 完成率 · 词准确率&#xa;三项合成文本分数&#xa;英文阈值 100 · 中文阈值 50" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="评测知识与推理&#xa;论文：GPT-4o 生成参考答案&#xa;代码：加载固定答案 JSON&#xa;计算 LLM2CLIP 文图相似度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="评测风格一致性&#xa;使用 CSD 与 OneIG 风格编码器&#xa;各自取最高参考图相似度&#xa;再平均两个编码器分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="评测输出多样性&#xa;配对同一提示的生成结果&#xa;论文：一减 DreamSim 相似度&#xa;代码：DreamSim 距离后求平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="报告五项核心指标&#xa;分别展示中英文结果&#xa;按类型与提示长度细分&#xa;逐提示子集比较模型" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="公开发布边界&#xa;HF f80e6317806b · CC BY-NC 4.0&#xa;数据 JSON 为 1,120 和 1,320 行&#xa;Git 树没有 LICENSE 文件&#xa;项目榜单在论文后继续更新" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html