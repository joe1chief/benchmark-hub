<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2168" pageHeight="1032" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;论文 · arXiv 2410.07073v2&#xa;数据 · 0d94c4ed · Parquet caca64ff&#xa;评测器 · d61811fc&#xa;任务代码自 70eecd8f 未变" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义实用多模态用途&#xa;信息抽取 · 摘要生成&#xa;基于图像的推理&#xa;每个问题都必须依赖图像&#xa;未报告正式纳入规则" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="论文 · 五类图像&#xa;图表 21 · 表格 19&#xa;PDF 页面 24 · 图示 20&#xa;其他 8&#xa;合计 · 92 个对话" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="人工策展基准内容&#xa;选择图像&#xa;编写开放式问题&#xa;编写参考答案&#xa;保持图像依赖性" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="验证参考答案&#xa;由第二组标注员复核&#xa;人工答案接受二次检查&#xa;未描述复核准则&#xa;未报告一致性统计" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1072" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="构建对话结构&#xa;69 × 一轮 · 18 × 两轮&#xa;4 × 三轮 · 1 × 四轮&#xa;92 个对话&#xa;121 组用户问题 / 参考答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="论文基准产物&#xa;实用多模态对话&#xa;开放式参考答案&#xa;每个对话一张图像&#xa;未报告数据划分方案" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1616" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="固定 Hugging Face eval 发布&#xa;提交 0d94c4ed · 92 行&#xa;image · conversation · category&#xa;eval · 顶层空值 0&#xa;bytes 92 · path 空值 92 · SHA caca64ff…" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="176" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="已发布失败状态&#xa;无 [[rating]] → 内部 -1 sentinel&#xa;sentinel 不返回 · 无限重试&#xa;第三次评判 API 异常即抛出&#xa;模型 / 评判器终态错误中止整跑" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="评判标准措辞漂移&#xa;第 3 节：正确性 + 完整性&#xa;附录 A.5 与代码：&#xa;正确性 + 有帮助性&#xa;要求输出 · [[rating]]" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="论文评测合同&#xa;并行查询全部轮次&#xa;历史使用标准答案&#xa;每轮独立评判&#xa;提供完整对话历史" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="未披露的构建细节&#xa;图像来源与逐行权利&#xa;纳入 / 排除规则&#xa;标注员数量 / 培训 / 一致性&#xa;拒绝与仲裁数量" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="公开访问边界&#xa;HF 数据与 GitHub 代码可下载&#xa;数据卡未声明许可证&#xa;评测仓库无许可证文件&#xa;当前 README 增加权利限制" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1072" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="可变且未固定的数据依赖&#xa;load_dataset(name) · 未指定 revision&#xa;早期 91 行 · 2024-09-19 起 92 行&#xa;出现过五个不同 Parquet LFS 对象&#xa;无数据集发布标签" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Conversation JSON 合同&#xa;121 组交替用户 / 助手消息&#xa;首轮用户：图像 + 文本 · 92&#xa;后续用户：仅文本 · 29&#xa;助手：单一文本块 · 121" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1616" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="固定发布的类别漂移&#xa;charts 21 · tables 24&#xa;pdf_pages 19 · diagrams 20 · misc 8&#xa;表格 / PDF 数量与论文对调&#xa;无行 ID 或来源字段" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="496" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="按用户轮次展开对话&#xa;创建 121 个独立交互&#xa;保留历史标准助手答案&#xa;当前参考答案单独保存&#xa;前序候选错误不会传播" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1888" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="查询候选模型&#xa;8 个并行 worker&#xa;temperature = 0&#xa;max_tokens = 4,096&#xa;已发布 VLLMModel · 三次尝试" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1616" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="收集候选回答&#xa;每个评测轮次一个回答&#xa;按完成顺序保存交互&#xa;与当前参考答案配对&#xa;不补填缺失回答" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="已发布评判回放缺陷&#xa;传入完整消息字典&#xa;用户问题变为 “rolecontent”&#xa;参考答案变为原始列表 / 字典&#xa;图像与真实问题均被遗漏" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1072" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="调用已发布 GPT-4o 评判器&#xa;gpt-4o-2024-05-13&#xa;temperature = 0 · max_tokens = 2,048&#xa;8 个并行 worker&#xa;返回解释 + [[rating]]" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="解析首个双括号数字&#xa;正则接受整数或小数&#xa;不验证一至十分范围&#xa;未匹配时产生 -1 sentinel&#xa;仅解析成功值成为逐轮分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="汇总成功的逐轮分数&#xa;Micro · 121 轮整体均值&#xa;五个类别均值&#xa;四个轮次位置均值&#xa;“Macro” · 上述九个均值再平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="已发布指标 JSON&#xa;micro_average_score&#xa;混合 macro_average_score&#xa;五类 + 四个轮次位置均值&#xa;不重新计算论文 r = 0.91" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="27" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry">