      "size": "xl"
    },
    {
      "id": "use_cases",
      "label": "定义实用多模态用途\n信息抽取 · 摘要生成\n基于图像的推理\n每个问题都必须依赖图像\n未报告正式纳入规则",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_categories",
      "label": "论文 · 五类图像\n图表 21 · 表格 19\nPDF 页面 24 · 图示 20\n其他 8\n合计 · 92 个对话",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "manual_curation",
      "label": "人工策展基准内容\n选择图像\n编写开放式问题\n编写参考答案\n保持图像依赖性",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "answer_verification",
      "label": "验证参考答案\n由第二组标注员复核\n人工答案接受二次检查\n未描述复核准则\n未报告一致性统计",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "conversations",
      "label": "构建对话结构\n69 × 一轮 · 18 × 两轮\n4 × 三轮 · 1 × 四轮\n92 个对话\n121 组用户问题 / 参考答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_output",
      "label": "论文基准产物\n实用多模态对话\n开放式参考答案\n每个对话一张图像\n未报告数据划分方案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "hf_snapshot",
      "label": "固定 Hugging Face eval 发布\n提交 0d94c4ed · 92 行\nimage · conversation · category\neval · 顶层空值 0\nbytes 92 · path 空值 92 · SHA caca64ff…",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "failure_boundary",
      "label": "已发布失败状态\n无 [[rating]] → 内部 -1 sentinel\nsentinel 不返回 · 无限重试\n第三次评判 API 异常即抛出\n模型 / 评判器终态错误中止整跑",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "wording_drift",
      "label": "评判标准措辞漂移\n第 3 节：正确性 + 完整性\n附录 A.5 与代码：\n正确性 + 有帮助性\n要求输出 · [[rating]]",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_judge_contract",
      "label": "论文评测合同\n并行查询全部轮次\n历史使用标准答案\n每轮独立评判\n提供完整对话历史",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "construction_gaps",
      "label": "未披露的构建细节\n图像来源与逐行权利\n纳入 / 排除规则\n标注员数量 / 培训 / 一致性\n拒绝与仲裁数量",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "openness_boundary",
      "label": "公开访问边界\nHF 数据与 GitHub 代码可下载\n数据卡未声明许可证\n评测仓库无许可证文件\n当前 README 增加权利限制",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_history",
      "label": "可变且未固定的数据依赖\nload_dataset(name) · 未指定 revision\n早期 91 行 · 2024-09-19 起 92 行\n出现过五个不同 Parquet LFS 对象\n无数据集发布标签",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "schema_audit",
      "label": "Conversation JSON 合同\n121 组交替用户 / 助手消息\n首轮用户：图像 + 文本 · 92\n后续用户：仅文本 · 29\n助手：单一文本块 · 121",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "category_drift",
      "label": "固定发布的类别漂移\ncharts 21 · tables 24\npdf_pages 19 · diagrams 20 · misc 8\n表格 / PDF 数量与论文对调\n无行 ID 或来源字段",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "expand_turns",
      "label": "按用户轮次展开对话\n创建 121 个独立交互\n保留历史标准助手答案\n当前参考答案单独保存\n前序候选错误不会传播",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidate_query",
      "label": "查询候选模型\n8 个并行 worker\ntemperature = 0\nmax_tokens = 4,096\n已发布 VLLMModel · 三次尝试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidate_answers",
      "label": "收集候选回答\n每个评测轮次一个回答\n按完成顺序保存交互\n与当前参考答案配对\n不补填缺失回答",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "released_replay",
      "label": "已发布评判回放缺陷\n传入完整消息字典\n用户问题变为 “rolecontent”\n参考答案变为原始列表 / 字典\n图像与真实问题均被遗漏",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_api",
      "label": "调用已发布 GPT-4o 评判器\ngpt-4o-2024-05-13\ntemperature = 0 · max_tokens = 2,048\n8 个并行 worker\n返回解释 + [[rating]]",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "score_parser",
      "label": "解析首个双括号数字\n正则接受整数或小数\n不验证一至十分范围\n未匹配时产生 -1 sentinel\n仅解析成功值成为逐轮分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregation",
      "label": "汇总成功的逐轮分数\nMicro · 121 轮整体均值\n五个类别均值\n四个轮次位置均值\n“Macro” · 上述九个均值再平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "output",
      "label": "已发布指标 JSON\nmicro_average_score\n混合 macro_average_score\n五类 + 四个轮次位置均值\n不重新计算论文 r = 0.91",
      "type": "terminal",
      "size": "xl"
    }
