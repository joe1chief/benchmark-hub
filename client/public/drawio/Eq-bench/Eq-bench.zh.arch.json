    },
    {
      "id": "dialogues",
      "label": "GPT-4 生成高情绪张力对话\n必须描写冲突或紧张场景\n论文未说明候选池规模",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "selection",
      "label": "后续官方 README：共生成 200 段对话\n为 V1 选择最连贯且最具挑战的 60 段\n未披露逐条选择量表",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "references",
      "label": "作者制定每道问题与参考答案\n选择四种差异化候选情绪\n设定预期的 0–10 强度\n参考值以总和 10 的归一化形式存储",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "EQ-Bench V1 测试制品\n60 道英文情绪理解题\n作者参考答案；不使用 GPT-4 评审\nV1 JSON SHA 9c52ae2",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "version_gate",
      "label": "显式选择论文时期协议\n当前仓库默认 V2 / 171 题\n含修订的 V1：-v1 -revise\nV1 与 V2 分数不可直接比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "使用完全一致的 V1 零样本提示\n首轮为四种情绪打 0–10 分\n逐步批评后再给出修订分数\n固定标题支持自动解析",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "runner",
      "label": "论文 §3.10 重试协议\n温度从 0.01 开始\n每次解析失败后增加 0.15\n直至成功解析或尝试次数超过 5",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "repo_runner",
      "label": "固定运行器差异\n每题仅尝试 3 次\n同样从 0.01 开始、每次增加 0.15\n必须解析四个名称匹配的整数分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "将每个模型向量归一化到总和 10\n总和为零或情绪名称不匹配则拒绝\n与已归一化的 V1 参考答案比较\n评估相对强度而非绝对强度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "question_score",
      "label": "单题原始分数\nq = 10 − Σ |模型情绪 − 参考情绪|\n仅计入可解析的首轮 / 修订答案\n不设下限；q 可以为负",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "聚合协议边界\n论文 V1 与固定的当前运行器",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "paper_aggregate",
      "label": "论文 V1 聚合\n分别平均可解析的首轮 / 修订轮\n选择更高的整轮，绝不逐题择优\n原始均值乘 10 · 少于 50/60 题则失败",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "repo_aggregate",
      "label": "固定运行器增加可解析率门禁\n修订轮得分必须不低于首轮\n且可解析数不少于首轮的 95%\n否则取首轮 · 通过阈值 83.33%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "EQ-Bench V1 分数允许为负\n随机基线为 0，而非下界\n与参考答案完全一致的上限为 100\n同时报告首轮 / 修订轮可解析数",
      "type": "terminal",
      "size": "xl"
    }
