    "modules": 2
  },
  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n论文 2405.11985v5 · 评测器 96590634\n代码 efc6a78a · 数据 7cdca63e",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "source_route",
      "label": "图像来源？\n公开数据集\n网络采集\n人工拍摄",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "public_source",
      "label": "公开富文本图像 · 30%\nICDAR MLT19 等数据\n文档与自然场景\n保留原始来源权利",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "web_source",
      "label": "网络图像 · 20%\nLAION-OCR\n从 Common Crawl 筛选\n菜单 · 标识 · 地图 · 账单",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "manual_source",
      "label": "人工拍摄 · 50%\n前往各语言对应国家\n母语真实场景\n高质量本地文字",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "ocr",
      "label": "提取并筛选文字\n字节跳动多语言 OCR API\n按语言类型筛选\n按文字数量筛选",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eligibility_gate",
      "label": "富文本图像合格吗？\n合规性审查\nOCR 检出文字\n属于可用语言组",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "drop_image",
      "label": "标注前淘汰\nOCR 无文字，或含政治 / 色情 /\n暴力 / 其他不安全内容",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "language_pool",
      "label": "汇总九种母语图像\nAR · DE · FR · IT · JA\nKO · RU · TH · VI\n8,980 原始图 → 8,895 候选图",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "annotator_train",
      "label": "招募并培训标注员\n母语使用 10 年以上 · 大学学历\n指南 · 问答 · 试标",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "maker_round",
      "label": "首轮制定者标注\n每语言 3 人 · 每图 5 个问答\n前 3 题读取 · 后 2 题推理\n答案简洁",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "initial_pool",
      "label": "初始标注池\n8,895 张图像\n28,906 个问答对\n母语问题与答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "checker_gate",
      "label": "二轮审核结果？\n两名审核员独立检查\n相关性 · 正确性\n冗余性 · 伦理性",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "keep_qa",
      "label": "保留问答对\n相关且正确\n简洁且不重复",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "correct_qa",
      "label": "修正问答对\n修复答案或措辞\n删除重复内容",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "remove_qa",
      "label": "删除问答对\n无关或不合伦理\n不进入最终语料",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "audit_gate",
      "label": "10% 语言抽检通过吗？\n质检员按语言抽样\n核对标注规范",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reannotate",
      "label": "退回重新标注\n修正未通过的问答对\n重新进入质量抽检",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "MTVQA 最终语料\n8,794 张图像\n28,607 个问答对\n20 余种场景\n数据许可 CC BY-NC 4.0",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "发布固定版数据\nimage · id · qa_pairs · lang\nqa_pairs：Python 字面量 · KO → KR\n训练 6,678 / 21,829\n测试 2,116 / 6,778 · 无适配器",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "论文零样本提示词\n“用问题语言中的词或短语回答”\n附加问题 · 模型默认设置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_input_gate",
      "label": "官方 acc.py 输入状态？\n按语言组织的 JSON 文件目录\n每项含 annotation 与 answer",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "eval_abort",
      "label": "评测器中止\n目录缺失或 JSON 格式错误\n键缺失或目标列表为空\n不做逐项容错",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "empty_nan",
      "label": "空目录结果\n没有语言得分\nNumPy 均值产生 NaN\n不存在有效分母",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "match_gate",
      "label": "任一目标是答案子串吗？\n双方转小写并去首尾空白\n从模型答案中删除句点\n并非严格完全相等",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "score_one",
      "label": "单项得分 = 1\n至少一个目标匹配\n纳入该文件分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_zero",
      "label": "单项得分 = 0\n没有目标子串匹配\n纳入该文件分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "汇总已发布准确率\n先求每个文件的项目均值\n再对文件做无权平均\n不检查 9 文件 · 缺失会缩小宏平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "人类基线\n每种语言十名受教育母语者\n随机选择\n论文 v5 平均值 = 79.7%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 MTVQA 结果\n各语言准确率与宏平均\n模型 / 人类差距\nOCR · 推理 · 偏差 · 幻觉",
      "type": "terminal",
      "size": "xl"
    }
  ],
