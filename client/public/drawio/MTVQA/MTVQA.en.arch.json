    {
      "id": "evidence",
      "label": "Freeze Primary Evidence\nPaper 2405.11985v5 · Evaluator 96590634\nCode efc6a78a · Data 7cdca63e",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "source_route",
      "label": "Image Source?\nPublic Dataset\nWeb Collection\nManual Capture",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "public_source",
      "label": "Public Text-rich Images · 30%\nICDAR MLT19 and Related Data\nDocuments and Natural Scenes\nPreserve Source Rights",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "web_source",
      "label": "Web Images · 20%\nLAION-OCR\nFiltered from Common Crawl\nMenus · Logos · Maps · Bills",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "manual_source",
      "label": "Manual Capture · 50%\nCountries of Each Language\nNative Real-world Scenarios\nHigh-quality Local Text",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "ocr",
      "label": "Extract and Select Text\nByteDance Multilingual OCR API\nFilter by Language Type\nFilter by Text Amount",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eligibility_gate",
      "label": "Eligible Text-rich Image?\nRegulatory Review\nOCR Text Present\nUsable Language Group",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "drop_image",
      "label": "Drop before Annotation\nNo OCR Text, or Political / Sexual /\nViolent / Other Unsafe Content",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "language_pool",
      "label": "Group Nine Native Languages\nAR · DE · FR · IT · JA\nKO · RU · TH · VI\n8,980 Raw → 8,895 Candidates",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "annotator_train",
      "label": "Recruit + Train Annotators\nNative Use 10+ Years · University Degree\nGuidelines · Q&A · Pilot",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "maker_round",
      "label": "First-round Makers\n3 Annotators / Language · 5 QAs / Image\nFirst 3 Read · Last 2 Reason\nConcise Answers",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "initial_pool",
      "label": "Initial Annotation Pool\n8,895 Images\n28,906 QA Pairs\nNative Questions and Answers",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "checker_gate",
      "label": "Second-round Outcome?\nTwo Independent Checkers\nRelevance · Correctness\nRedundancy · Ethics",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "keep_qa",
      "label": "Retain QA Pair\nRelevant and Correct\nConcise and Nonredundant",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "correct_qa",
      "label": "Correct QA Pair\nRepair Answer or Wording\nRemove Repeated Content",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "remove_qa",
      "label": "Remove QA Pair\nIrrelevant or Unethical\nExclude from Final Corpus",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "audit_gate",
      "label": "10% Language Audit Passes?\nQuality Inspector Sampling\nCheck Annotation Standards",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reannotate",
      "label": "Return for Re-annotation\nCorrect Failed QA Pairs\nRe-enter Quality Audit",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Final MTVQA Corpus\n8,794 Images\n28,607 QA Pairs\nMore Than 20 Scenarios\nCC BY-NC 4.0 Data",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "Pinned Data Release\nimage · id · qa_pairs · lang\nqa_pairs: Python Literal · KO → KR\nTrain 6,678 / 21,829\nTest 2,116 / 6,778 · No Adapter",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "Paper Zero-shot Prompt\n“Answer ... in the language of the question”\nAppend Question · Model Defaults",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_input_gate",
      "label": "Official acc.py Input State?\nDirectory of Language JSON Files\nannotation + answer per Entry",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "eval_abort",
      "label": "Evaluator Aborts\nMissing Directory or Malformed JSON\nMissing Keys or Empty Targets\nNo Item-level Recovery",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "empty_nan",
      "label": "Empty Directory Result\nNo Language Scores\nNumPy Mean Emits NaN\nNo Valid Denominator",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "match_gate",
      "label": "Any Target Is a Substring?\nLowercase and Strip Both\nRemove Periods from Prediction\nNot Strict Exact Equality",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "score_one",
      "label": "Score Entry = 1\nAt Least One Target Matches\nKeep Entry in File Denominator",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score_zero",
      "label": "Score Entry = 0\nNo Target Substring Matches\nKeep Entry in File Denominator",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "Released Accuracy\nMean Rows per File\nUnweighted Mean of Files\nNo 9-file Check · Missing Files Shrink Macro",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "Human Baseline\nTen Educated Native Speakers\nRandomly Selected per Language\nPaper-v5 Mean = 79.7%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report MTVQA Results\nPer-language Accuracy + Macro\nModel / Human Gap\nOCR · Reasoning · Bias · Hallucination",
      "type": "terminal",
      "size": "xl"
    }
  ],
