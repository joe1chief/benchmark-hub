ry></mxCell><mxCell id="34" value="是：Reask" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#9E9E9E;strokeWidth=1;endArrow=open;endFill=0;dashed=1;dashPattern=3 3;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="13" target="14"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/><Array as="points"><mxPoint x="324" y="850"/><mxPoint x="1444" y="850"/></Array></mxGeometry></mxCell><mxCell id="36" value="补充后重新评估" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#9E9E9E;strokeWidth=1;endArrow=open;endFill=0;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.25;entryY=1;entryDx=0;entryDy=0;dashed=1;dashPattern=3 3;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="14" target="9"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="38" value="否：计分" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=1;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="13" target="16"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="0" y="-12" as="offset"/></mxGeometry></mxCell><mxCell id="40" value="验证研究" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="15" target="17"><mxGeometry x="0" relative="1" as="geometry"><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell></root></mxGraphModel>
