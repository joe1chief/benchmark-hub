  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3224" pageHeight="696" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据与固定版本&#xa;HaluEval · arXiv 2305.11747v3&#xa;官方仓库 b7b66e8" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="抽取 30,000 条任务种子&#xa;HotpotQA · OpenDialKG · CNN/DailyMail&#xa;问答、对话、摘要各 10,000 条" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="ChatGPT 单轮 + 多轮策略&#xa;模式数：问答 4 · 对话 3 · 摘要 3&#xa;温度 1.0 · 最多 256 token · top-p 1.0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="真值增强筛选&#xa;比较两个幻觉候选&#xa;保留最可信且最困难的一个" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="形成 30,000 条任务记录&#xa;正确输出 + 选中的幻觉输出&#xa;保存为一个配对" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="从 Alpaca 52K 查询开始&#xa;每条查询采样 3 个 ChatGPT 回答&#xa;面向通用指令跟随" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="对回答分歧度排序&#xa;用 BERTScore 计算平均语义相似度&#xa;保留相似度最低的 5,000 条查询" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="每条回答由 3 名标注员判断 3 个维度&#xa;不可验证 · 非事实 · 不相关&#xa;记录是/否 + 幻觉片段" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="应用最大/多数投票&#xa;30 名入选标注员 · Fleiss κ=0.811&#xa;论文：5,000 条回答 · 977 条为是" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文定义的 HaluEval · 共 35,000 条&#xa;30,000 条任务配对 + 5,000 条通用样本&#xa;通用字段：hallucination Yes/No&#xa;+ hallucination_spans" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="选择发布子集&#xa;任务配对或通用回答" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="三个任务型评测器&#xa;问答 · 对话 · 摘要各加载独立指令&#xa;随机展示正常或幻觉输出&#xa;温度 0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="移除句点&#xa;同时含 Yes 与 No，或两者均无 → 错误&#xa;仅有单一 substring 命中 → 归一为 Yes 或 No" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="分类已标注的 ChatGPT 回答&#xa;论文报告 General 准确率&#xa;发布的 evaluate.py 未提供通用通路" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontF