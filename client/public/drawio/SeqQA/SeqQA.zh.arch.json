  "layout": "horizontal",
  "counts": {
    "nodes": 16,
    "edges": 17,
    "modules": 2
  },
  "nodes": [
    {
      "id": "sequence_curation",
      "label": "生物序列数据库与标准质粒库\n汇聚 NCBI GenBank、UniProt、Ensembl 与实验室通用载体质粒\n精选覆盖 15 项核心生物序列操作任务的原生 DNA、RNA 与蛋白质序列",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "programmatic_generator",
      "label": "参数化生物序列算法题模引擎\n基于可重现参数化脚本批量生成序列切分与基因工程构建场景\n精准配置 PCR 引物设计、限制性内切酶切位点、ORF 与克隆重组片段",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "biopython_ground_truth",
      "label": "BioPython 确定性计算金标准求解器\n算法求解出理论上绝对精确的理想生物序列真值\n高精度计算退火温度 (Tm)、分子量、密码子翻译与酶切条带长度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "near_miss_distractor_gen",
      "label": "规则化对抗近错干扰项生成引擎\n合成确定性近错陷阱与具备生物学欺骗性的候选干扰选项\n施加移码突变、截短 ORF、点突变密码子与 GC 含量扰动",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "phd_validation_gate",
      "label": "分子生物学博士专家盲审核验？\n生物专业博士严格审查题目生化合理性与干扰项区分度\n确保生物学逻辑严密且存在且仅存在一个确定性唯一正确选项",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_item_discard",
      "label": "歧义与生化自相矛盾题目剔除池\n过滤因引物简并二聚体、二级结构干扰或生化逻辑不自洽的题目\n确保入选题目在计算生物学与分子生物学实验上绝对确定可靠",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "canary_partitioning",
      "label": "金丝雀防污染切分与公开发布分卷\n注入全局金丝雀标识符 (Canary) 防止预训练网络数据爬取污染\n划分公开验证题集与防泄露的受保护核心评测保留集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "seqqa_freeze",
      "label": "SeqQA 冻结生物序列评测基准\n15 项专业任务下的 750 道经程序与专家双重核验的多项选择题\n每道题目均标配明确的放弃作答 (Decline) 兜底选项",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "零样本思维链专业提示词组装\n组装目标核酸/氨基酸序列、操作约束、4 个备选项与显式放弃选项\n采用零样本思维链 (CoT) 格式并严格禁止调用外部 Python/Bio 工具",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "自回归生物序列逻辑链推导\n待测模型在心智中分步推导反向互补、密码子翻译及限制性酶切过程\n自回归输出完整推导步骤并在末尾明确声明选择结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "choice_extraction",
      "label": "选项解析与主动弃权状态提取器\n正则捕获最终选择的字母选项或识别模型主动声明的弃权意图\n严谨区分模型理性拒绝作答与回答中断/格式崩溃异常",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "decline_routing_gate",
      "label": "模型完成作答还是主动弃权？\n分离实质性尝试作答的样本与模型主动放弃作答的样本\n为解耦评估模型的作答覆盖率 (Coverage) 与有效精度 (Precision)",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "abstention_sink",
      "label": "主动弃权与不确定性放弃池\n记录模型因把握不足而主动声明放弃作答的题目集合\n用于统计基准作答覆盖率指标: 尝试题数 / 总题数 (750)",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "accuracy_evaluation_gate",
      "label": "选择结果是否命中确定性金标准？\n比对抽取选项与 BioPython 算法金标准答案是否绝对一致\n对近错干扰项（如移码、碱基突变或错误翻译）执行零容忍判错",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "sequence_error_sink",
      "label": "序列操作推理失败分析池\n细粒度归因失败原因: 读码框移位、引物错配退火或酶切产物误判\n建立大语言模型在生物信息学底层计算中的特异性错误画像",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "seqqa_metrics_reporting",
      "label": "SeqQA 官方多任务评测报告\n统计全局准确率 (Accuracy)、有效精确率 (Precision) 与覆盖率 (Coverage)\n呈现 15 个子任务 3 次运行均值并对标人类分子生物学博士基线",
      "type": "terminal",
      "size": "xl"
    }
  ],
