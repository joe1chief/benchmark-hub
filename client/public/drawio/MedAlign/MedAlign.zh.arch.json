  "nodes": [
    {
      "id": "ehr",
      "label": "准备纵向患者病历\n同时包含结构与非结构事件\n以 OMOP CDM 表示数据\n每份病历转换为单一 XML",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "recruit",
      "label": "招募临床指令作者\n共 15 名执业临床医生\n覆盖 7 个医学专科\n通过在线表单独立提交",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "collect",
      "label": "第一阶段：收集指令\n构想日常 EHR 工作情境\n提交 1314 条问题或命令\n附患者特征与临床语境",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "dedup",
      "label": "清理并标记指令\nROUGE-L 超 0.7 判近重复\n去重后保留 983 条\n其中 407 条适用于一般患者",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "query",
      "label": "第二阶段：构造检索查询\n使用一般患者适用指令\n拼接患者特征与临床语境\n对比随机配对和 BM25Okapi",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "retrieve",
      "label": "检索相关患者病历\n从 77200 名患者子样本检索\nBM25 返回每条指令 top-5\n同一池用于随机基线",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "relevance",
      "label": "人工判断配对相关性\n作者执行二元相关审查\n303 条指令 top-5 至少一份相关\nBM25 命中率 74% 对随机 38%",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "response",
      "label": "第三阶段：专家生成回复\n优先分配同专科非原作者\n检查可行性与信息充分性\n以病历最新时间为锚作答",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 MedAlign 数据合同\n共 983 条临床指令\n303 条专家参考回复\n对应 276 份纵向 EHR",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "models",
      "label": "运行六个通用语言模型\n覆盖闭源与开源模型\n为生成预留 256 tokens\n从病历末尾保留最新信息",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mr",
      "label": "处理超长病历上下文\n32k 仍容不下超 80% 病历\n多步精炼按 30k 分块顺序输入\n每块更新或保留已有回复",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human",
      "label": "九名临床医生盲法评测\n二元判断临床回复是否正确\n再按相关性与适当性排序\n允许并列且随机模型顺序",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "automated",
      "label": "运行自动文本生成指标\nCOMET、BERTScore 与 METEOR\n加入 chrF、BLEU、ROUGE 等\n由指标产生模型回复排序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "汇总临床与自动评测\n报告正确率、胜率与平均排名\n计算与人工排序的 Kendall Tau\n分析上下文长度造成的差异",
      "type": "terminal",
      "size": "xl"
    }
  ],
