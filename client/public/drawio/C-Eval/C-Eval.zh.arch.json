      "type": "database",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "组织为 52 个学科\n四个层级 + 四个领域\n每学科至少 200 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "解析来源格式\nPDF • Word • 网页\n恢复题干与选项",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "format",
      "label": "统一每道题格式\n恰好四个选项\n数学内容转换为 LaTeX",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "clean",
      "label": "去重与清洗\n删除无效或损坏题目\n保留学科元数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "validate",
      "label": "多轮人工验证\n检查题目、选项与答案\n修正剩余错误",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "pool",
      "label": "C-Eval 题库\n13,948 道多项选择题\n覆盖 52 个学科",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "在每个学科内切分\n开发集：5 个样例\n验证集 : 测试集 = 1 : 9",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "dev",
      "label": "开发集\n每学科 5 个示例\n提供标准答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "validation",
      "label": "验证集\n非开发集题目的十分之一\n公开答案标签",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "test_set",
      "label": "论文测试集\n非开发集题目的十分之九\n2023 年协议中标签私有",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "hard",
      "label": "C-Eval Hard\n八个高难 STEM 学科\n作为附加子集报告",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "gpt4_explanations",
      "label": "GPT-4 生成逐步解释\n输入开发集题目\n条件中包含标准答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_revision",
      "label": "人工修订\n纠正并完善 GPT-4 解释\n与开发集示例一起发布",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "版本边界\n论文：测试标签私有\n仓库自 2025-07-27 起完整测试集公开",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "evaluation_sets",
      "label": "选择评测切分\n验证集 • 测试集 • C-Eval Hard\n保留论文时期的报告协议",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "zero_answer",
      "label": "零样本仅答案\n要求输出选项字母\n不提供演示样例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "five_answer",
      "label": "五样本仅答案\n使用开发集题目与答案\n上下文过长时减少样例数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "five_cot",
      "label": "五样本思维链\n使用人工修订的开发集解释\n上下文过长时减少样例数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "extract",
      "label": "正则抽取选项\n解析模型预测的选项\n应用官方答案规则",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "报告准确率\n学科与总体平均\n对比三种提示模式",
      "type": "terminal",
      "size": "xl"
    }
