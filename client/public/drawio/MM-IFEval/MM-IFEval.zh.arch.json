    "modules": 2
  },
  "nodes": [
    {
      "id": "evidence",
      "label": "证据固化\narXiv 2504.07957v2\n2025-04-27 · PDF e927327a…\n仓库 bb844a7 · 内置评测 d4900dd\nVLMEvalKit 7055d30 · 修复 a039b67",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sources",
      "label": "五类图像领域\nCC3M + ALLaVA · 自然场景\nRICO 移动 · MultiUI 网页\nChartQA · Geo170k\n各来源题数未说明",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "image_qc",
      "label": "图像质量筛选\n剔除低分辨率\n剔除低语义丰富度\n信号：IC9600 + RAM\n阈值/淘汰数未说明",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_generation",
      "label": "任务生成 / 筛选\n无 QA：采样 16 类任务池\nGPT-4o 选择图像匹配任务\n有 QA：去少样本 / 选项\n正则 + 长度限制",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "约束分类体系\n6 大类 · 32 个子类别\n长度 · 数学 · 语言/格式\n修辞/逻辑 · 动作\n关键词 · LLM 填充内容",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "integrate",
      "label": "约束整合\n无 QA：为多样性采样\n有 QA：选择兼容类型\nLLM 重选/生成内容\n剔除完全矛盾组合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_review",
      "label": "人工标注\nC：开放回答 + 多项约束\nP：图像问题 + 标准答案列表\n论文的关键复核环节\n协议/一致性未说明",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "conflict_qc",
      "label": "冲突后处理\n额外 LLM 复查问题\n缓解问题/约束冲突\n保留人工复核题目\n无 Prompt/种子/泄漏审计",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_release",
      "label": "论文基准\n400 道主问题\n300 C · 平均 5.1 项约束\n100 P · 标准答案列表\nP 覆盖 13 类图像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "released_tsv",
      "label": "发布 TSV 审计\n687 = 400 主问题 + 287 辅助\n300 C · 1,524 项约束\n489 规则 · 748 直接 · 287 对比\nMD5 973bb839…70ae7a6",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "候选模型推理\nC：图像 + 完整约束 Prompt\nP：图像 + 原始问题\n辅助：移除一项约束\n解码参数未固定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "eval_route",
      "label": "评测 / 失败路由\nTSV 标签 → 规则 · 直接 · 对比 · P\nAPI：直接 ×4 · 对比/P ×3\nans 未赋值可中止\n解析策略因路径而异",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "rule_verify",
      "label": "规则验证\n10 个算法子类\n函数/参数经人工复核\n字符串化 · 逐约束布尔分\n异常传播；无兜底",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "direct_judge",
      "label": "直接 Judge / 正则\n图像 + 回答 + 直接约束\n清理空白/* · 解析 x/y\n解析错：外层最多 3 轮\nAPI 耗尽可中止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "compare_judge",
      "label": "对比 Judge / 解析\n无图 · 每项一条辅助请求\n有/无约束 → Summary 布尔\n解析错：跳过且不外层重试\n漏项会缩小分母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "c_item_score",
      "label": "C 单题 / 失败计分\n规则/对比二值 · 直接 x/y\n正常：已记录约束分数均值\n对比解析错会缩小分母\n缺 total_score：C 汇总加 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "p_judge",
      "label": "P Judge / 解析\n无图 · 回答 + JSON 标准答案\n标准子串；先 right 后 wrong\n解析错：外层最多 3 轮\n缺 total_score：汇总中止",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "400 题汇总\nC = 300 道 C 题均值\nP = 100 道 P 题均值\nOverall = (300C + 100P)/400\n当前 0-1 · 论文用百分比",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "openness_boundary",
      "label": "发布 / 开放性审计\n部分公开；TSV 许可未知\n无逐行来源/图像权利\nMMIF-23k 仅为训练数据\n无固定发布 · 正文 16 vs 附录 18",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "evaluator_drift",
      "label": "评测器版本边界\n论文未固定 Judge 快照\n内置 C：GPT-4o-2024-11-20\n内置 P：GPT-4o-mini\nREADME 05-13 vs 可变别名",
      "type": "document",
      "size": "xl"
    }
  ],
