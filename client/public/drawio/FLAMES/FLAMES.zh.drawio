  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2824" pageHeight="776" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据边界&#xa;arXiv:2311.06899v6&#xa;Flames 仓库 @ 234bcb7&#xa;HF CaasiHUANG/flames-scorer&#xa;版本 @ cdb1528" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义五维价值框架&#xa;公平 590 · 安全 779 · 道德 522&#xa;合法 118 · 数据保护 242&#xa;中国价值观归入道德维度" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="众包人员编写中文提示&#xa;为每个子维度提供具体场景&#xa;伪装 · 反向诱导 · 不安全询问&#xa;参考成功示例但自由创作" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="进行两轮审核&#xa;1：目标价值 + 明确场景 + 攻击方法&#xa;2：至少成功攻击一个受测模型&#xa;检查员修改或丢弃失败提示" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="FLAMES-prompts&#xa;2,251 条对抗提示&#xa;平均提示长度：85.92 tokens&#xa;成功攻击率：53.09%" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="收集 17 个中文能力模型回答&#xa;专家迭代细化评分规则&#xa;是否回应提示中的有害目的&#xa;也计入评分&#xa;产出评测回答&#xa;与评分器训练数据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="每条回答&#xa;由两名研究生标注&#xa;公平/安全/道德：3 / 2 / 1&#xa;合法/数据保护：3 / 1&#xa;对应领域专家&#xa;仲裁分歧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="已标注回答语料&#xa;约 22.9K 条&#xa;提示-回答-标签&#xa;支持人工评测&#xa;与多任务评分器训练" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="公开纯提示样本：1,000 条&#xa;跨维度与子组件随机选择&#xa;公平 249 · 安全 429&#xa;道德 201 · 合法 46&#xa;数据保护 75 · 其余保留" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="论文人工指标&#xa;无害率&#xa;= 标签 3 的回答占比&#xa;无害分&#xa;= 平均标签 / 3 × 100&#xa;五个维度等权宏平均" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1920" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="构建评分器样本&#xa;输入提示 + 输出回答&#xa;标签来自人工标注&#xa;验证：MOSS + GPT-4 回答&#xa;测试：InternLM-Chat-7B&#xa;+ InternLM-Chat-20B 回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1920" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="训练 FLAMES-scorer&#xa;每维独立分类头&#xa;多任务训练&#xa;RoBERTa-Large 骨干&#xa;InternLM-Chat-7B 骨干&#xa;最佳准确率：79.5%" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2224" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="发布 FLAMES 评测&#xa;论文结果：人工无害率&#xa;+ 无害分&#xa;固定 Flames-1k-Chinese&#xa;评分器支持自动化&#xa;OOD 可靠性未验证" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="" style="