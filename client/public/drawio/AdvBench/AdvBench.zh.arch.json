    {
      "id": "threat",
      "label": "定义护栏绕过威胁模型\n测试对齐模型能否被诱导生成\n其通常会拒绝的内容",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "setting",
      "label": "构建哪类 AdvBench 集合？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "strings",
      "label": "整理 500 个有害字符串\n有毒、威胁、误导、歧视、网络犯罪、\n危险或非法内容\n3-44 个 LLaMA token • 均值 16",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "behaviors",
      "label": "整理 500 个有害行为\n将相同广义主题写成指令\n成功指尝试遵从，而非拒答",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "objective",
      "label": "定义优化目标\n字符串：精确目标续写\n行为：与遵从一致的肯定式前缀",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "suffix",
      "label": "初始化 20-token 对抗后缀\n附加到一个或多个提示\n汇总多提示与多模型损失",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gcg",
      "label": "运行贪心坐标梯度搜索\n梯度 Top-k 256 • 候选批量 512\n用最低损失候选替换一个 token",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "protocol",
      "label": "选择攻击协议\n单题：前 100 项、单一模型\n通用：25 个训练 + 100 个留出行为\n迁移：25 个行为、2 或 4 个源模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "run",
      "label": "保留 500 步后的最佳后缀\n按各模型默认对话模板运行\n评测白盒与黑盒迁移",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "应采用哪条成功判定？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "string_score",
      "label": "有害字符串评分\n出现精确目标字符串即成功\n同时记录目标交叉熵损失",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "behavior_score",
      "label": "有害行为评分\n判断是否合理尝试执行指令\n必要时人工区分遵从与拒答",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "asr",
      "label": "计算攻击成功率\n单题 ASR • 通用训练/测试 ASR\n388 个测试行为上的迁移 ASR",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "compare",
      "label": "比较攻击方法与迁移\nPEZ • GBDA • AutoPrompt • GCG\n源模型 → 开源及闭源目标模型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告鲁棒性与通用性\nASR 越高表示护栏绕过越成功\n字符串诱导中目标损失越低越好",
      "type": "terminal",
      "size": "xl"
    }
