    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="2288" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="获取 CodeCrafters 私有提交&#xa;工程师从零实现 Git、Redis、SQLite 等软件&#xa;代码库质量反映不同真实开发水平" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择小型真实代码库与功能&#xa;代码规模少于 10,000 行&#xa;私有来源未进入公开训练语料" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="编写详细功能指令&#xa;把实现要求拆成多个较小阶段&#xa;说明官方测试的运行方式" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="编译为 Harbor 格式任务&#xa;初始仓库 • instruction.md • 环境&#xa;测试 • task.toml • 可选参考解" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="接入 CodeCrafters 官方测试器&#xa;由员工手工编写&#xa;经数十万用户四年以上反复检验" 