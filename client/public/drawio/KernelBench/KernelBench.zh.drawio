<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3064" pageHeight="816" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="主要证据与论文协议&#xa;arXiv:2502.10517v1&#xa;ICML 2025&#xa;OpenReview yeoN1iQT1x&#xa;论文定义 250 个评测任务" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="整理真实 PyTorch 工作负载&#xa;现代深度学习算子&#xa;算子序列与完整模型&#xa;Level 3 使用热门代码仓库" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="打包标准任务制品&#xa;torch.nn.Module Model&#xa;get_inputs + get_init_inputs&#xa;固定形状 · dtype · 初始化参数" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Level 1 · 100 题&#xa;单个原始操作&#xa;卷积 · 矩阵乘 · 损失&#xa;激活 · 归一化" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Level 2 · 100 题&#xa;多算子序列&#xa;保留参考实现语义&#xa;提供内核融合优化机会" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Level 3 · 50 题&#xa;完整机器学习架构&#xa;端到端 PyTorch 模型&#xa;来自热门代码仓库" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="论文合同 · 250 题&#xa;L1 / L2 / L3 是并行分区&#xa;仅提供用于评测的 PyTorch 参考实现&#xa;不提供金标准 / 优化内核" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1080" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="论文范围边界&#xa;论文前仓库历史中已存在 L4&#xa;L4 不属于论文的 250 题合同&#xa;未报告划分 / 去重 / 污染检查" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1080" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="制品 / 版本边界&#xa;候选 Git 1f7b25b：无作者版本标签&#xa;当前 Git 423217d：任务内容明显漂移&#xa;HF v0.1 ca1464e：包含 20 个 L4 任务&#xa;当前加载器仅接受 L1 / L2 / L3" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1384" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="单样例优化提示&#xa;一个加法 Model / ModelNew 示例&#xa;当前任务的参考 Model&#xa;精确输入生成器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1384" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="贪心解码 ModelNew&#xa;用自定义 GPU 代码替换 PyTorch 算子&#xa;CUDA · PTX · CUTLASS · Triton&#xa;或其他适用程序库" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1664" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="论文评测环境&#xa;裸机 NVIDIA L40S · Ada&#xa;48 GB · 300 W&#xa;Python 3.10&#xa;PyTorch 2.5.0+cu124&#xa;CUDA 12.4" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1944" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="在目标 GPU 编译 + 执行&#xa;编译返回的 ModelNew 代码&#xa;拒绝编译 / 运行失败&#xa;拒绝形状 / 数值错误" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1944" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="随机正确性门控&#xa;生成 5 组随机输入&#xa;比较 Model 与 ModelNew 输出&#xa;5 组全部匹配 → correct_i = 1" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2224" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="测量目标 GPU 延迟&#xa;预热 3 次 + 100 次 CUDA Event 试验&#xa;s_i = mean(T_Eager)&#xa;/ mean(T_New)&#xa;两者均在同一块 L40S 上计时" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="\(在 N = 250 上汇报 fast_p&#xa;fast_p = (1/N) Σ&#xa;1[correct_i 且 s_i &gt; p]&#xa;fast_0 = 正确任务比例&#xa;fast_1 = 正确且快于 Eager\)" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="19" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" s