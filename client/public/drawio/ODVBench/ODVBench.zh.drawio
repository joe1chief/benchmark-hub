t="100" as="geometry"/></mxCell><mxCell id="11" value="定义全部十二项在线任务&#xa;静态：RTP · PTM · DDM&#xa;静态：KIE · HD · TCD&#xa;动态：AP · LP · DP&#xa;事件：RP · RA · ARA" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="生成问题&#xa;人工编写任务模板&#xa;填入已核验标注&#xa;绑定查询时间戳" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="构造候选选项&#xa;使用任务选项池加 LLM&#xa;加入合理干扰项&#xa;保留二至四个选项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="执行选项处理&#xa;保持选项长度相近&#xa;打乱选项顺序" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="执行多轮人工复审&#xa;核验清晰度与答案准确性&#xa;检查干扰项合理性&#xa;修正无效问答对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="平衡基准样本&#xa;按视频长度分配问题&#xa;尽量扩大场景多样性&#xa;平衡场景与任务类型" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="固定论文 v1 基准&#xa;1,190 段视频 · 5–90 秒&#xa;6,322 题 · 平均查询 18.9 秒&#xa;静态 1,639 · 动态 2,973&#xa;事件 1,710" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="固定当前官方数据发布&#xa;HF 5dcf37c… 与 Annodata ca769c2…&#xa;1,190 段视频 · 6,348 行&#xa;动态 2,999：比论文 v1 多 26 行" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="强制 ODV 因果访问&#xa;在查询时间戳截断输入&#xa;不提供未来内容&#xa;基准通用合同" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3520" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="应用论文与代码设置&#xa;StreamForest：1 FPS&#xa;离线基线：固定帧数&#xa;选项字母 · 16 token · 温度 0&#xa;top-p 1 · 单 beam · 不采样" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;wh