<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4520" pageHeight="632" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定 ODV-Bench 范围&#xa;arXiv 2509.24871v1 · 图 3 · 第 4 节&#xa;OnlineIT 训练流程不在构建范围&#xa;论文未披露排除或去重&#xa;OnlineIT-drive 用于 FT-drive" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="汇集六个驾驶来源&#xa;ROAD-Waymo · MM-AU&#xa;WayveScenes101 · BDD100K&#xa;BiRViT-1K · D²-City&#xa;从日常驾驶覆盖到事故" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择任务相关视频&#xa;过滤已有数据标注&#xa;加入 YOLO 目标检测&#xa;再由人工检查补充" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="来源标注是否&#xa;足够且适用？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="转换现有标签&#xa;使用标注充