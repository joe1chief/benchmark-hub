    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1584" pageHeight="2368" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Collect Apartment Listings&#xa;Interior Photo Sequences&#xa;Official Listing Floor Plans" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="80" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Select 50 Apartments&#xa;Approximately 20 Interior Photos Each&#xa;Adapt the Official Floor Plan as Ground Truth" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="288" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Standardize Ground-Truth Floor Plans&#xa;Nine Rendering Rules&#xa;Black Walls • Green Doors • Red Room Centers • White Background" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="752" y="504" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Package the Evaluation Input&#xa;Photo Sequence plus Formatting Instructions&#xa;Keep Most Apartments Private; Release Code and a Sample" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helve