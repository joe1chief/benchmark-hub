      "id": "challenge_checks",
      "label": "三项难度综合校验闸门\n难以检索 · 无法靠常识记忆 · 无法直猜\n过滤常规单次搜索即可破解的浅层题",
      "type": "process",
      "size": "medium"
    },
    {
      "id": "revise",
      "label": "多轮迭代修订与约束硬化\n出题专家反复打磨消解题意歧义\n堵截捷径策略确保多跳浏览必要性",
      "type": "process",
      "size": "medium"
    },
    {
      "id": "draft_set",
      "label": "原始候选任务池 (1,287 题)\n专家精心构造的复杂网络浏览任务\n覆盖全球公开互联网多样化真实站点",
      "type": "database",
      "size": "medium"
    },
    {
      "id": "zero_pass_audit",
      "label": "零通过率题目专项审计\n深度复查 118 道全模型未解难题\n排查网页失效、答案漂移或表述漏洞",
      "type": "process",
      "size": "medium"
    },
    {
      "id": "remove_defects",
      "label": "缺陷题目剔除与质量净化\n坚决剔除 21 道含歧义或时效过期题目\n修正微小标点与提取格式错漏",
      "type": "process",
      "size": "medium"
    },
    {
      "id": "final_set",
      "label": "BrowseComp 最终冻结基准 (1,266 题)\n超高区分度复杂网络导航评测集\n基线大模型单机零样本准确率极低",
      "type": "database",
      "size": "medium"
    },
    {
      "id": "encrypt",
      "label": "答案加密与防污染金丝雀\n采用 SHA-256 校验与金丝雀加密字串\n彻底杜绝预训练爬虫抓取导致数据泄露",
