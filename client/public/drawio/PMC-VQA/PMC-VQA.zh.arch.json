  "nodes": [
    {
      "id": "step_1",
      "label": "从PMC-OA开始\n160万对生物医学图像与图注\n来源为PubMed Central开放子集\n覆盖240万篇论文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "选取381K对图像与图注\n使用医学图像采集第一阶段\n不执行自动子图切分\n保留复杂医学图像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "每条图注生成五组问答\n用图注文本提示ChatGPT\n四个选项且仅一个正确\n随机化正确选项位置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "清洗生成输出\n移除重复拒答与虚假条目\n强制符合指定模板\n保留1,497,808组问答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "把数据分成两半\n避免文本过滤器自训练\n在其中一半训练\n到另一半执行推理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "训练纯文本LLaMA-7B\n只输入问题与答案选项\n不提供对应图像\n学习生物医学语言捷径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "过滤纯语言可答问题\n打乱选项并推理五次\n正确至少3次即移除\n保留848,433组问答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "标注图像可回答性\n人工标注2,192组问答\n1,752训练 · 440测试\n使用二元图像可答标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "训练问题分类器\n准确率达到81.77%\n识别仅依赖图注的信息\n应用于剩余候选池",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "形成清洗后PMC-VQA\n226,946组问答\n对应149,075张医学图像\n约80%为放射学图像",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "创建图像隔离划分\n随机选择50,000组问答\n形成PMC-VQA-test-initial\n训练与测试图像不重叠",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "人工核验测试样本\n检查图像相关性与可答性\n检查干扰项难度和图像质量\n保留2,000题PMC-VQA-test",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "运行两类评测任务\nChoice提供四个候选答案\nBlanking不提供选项\n生成A至D或自由文本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告任务专用指标\nChoice使用准确率\nBlanking使用准确率与BLEU-1\n在人工核验测试集上比较",
      "type": "terminal",
      "size": "xl"
    }
  ],
