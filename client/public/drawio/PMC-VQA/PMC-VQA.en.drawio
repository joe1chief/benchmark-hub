rap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Clean Generated Outputs&#xa;Remove Repeats Refusals&#xa;and Dummy Cases&#xa;Enforce Required Output Template&#xa;Keep 1,497,808 QA Pairs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Split into Two Cross-fit Halves&#xa;Train on One Half&#xa;Infer on the Opposite Half&#xa;Avoid Filtering on Training&#xa;Examples" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Train Text-only LLaMA-7B&#xa;Question and Four Options Only&#xa;Never Supply the&#xa;Corresponding Image&#xa;Learn Language-answerable&#xa;Shortcuts" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Filter Language-answerable QAs&#xa;Shuffle Options and Infer&#xa;Five Times&#xa;Remove When Correct&#xa;at Least 3 of 5&#xa;Retain 848,433 QA Pairs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Label Image Answerability&#xa;Manually Annotate 2,192 Pairs&#xa;1,752 Train · 440 Test&#xa;Binary Image-answerable Targets" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Train Question Classifier&#xa;Reach 81.77 Percent Accuracy&#xa;Reject Caption-only&#xa;Information&#xa;Apply to the Remaining&#xa;Candidate Pool" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Finalize Clean PMC-VQA&#xa;226,946 Question-answer Pairs&#xa;149,075 Medical Images&#xa;Approximately 80 Percent Radiology" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Create Image-disjoint&#xa;Initial Test&#xa;Randomly Select 50,000 Pairs&#xa;PMC-VQA-test-initial&#xa;No Image Overlap with Training" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;st