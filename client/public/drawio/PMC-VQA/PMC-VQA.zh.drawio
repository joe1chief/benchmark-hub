<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3800" pageHeight="1152" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2305.10415v6 · PDF 7573df69e4c0&#xa;官方代码 1678ec2c97f0&#xa;HF 数据 b56ae594f794" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="从 PMC-OA 开始&#xa;160 万生物医学图像图注对&#xa;PubMed Central 开放获取子集&#xa;来源覆盖 240 万篇论文" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选取 38.1 万图像图注对&#xa;使用图像收集第一阶段&#xa;跳过自动子图拆分&#xa;保留多样复杂图像" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="每个图注生成五组问答&#xa;用图注文本提示 ChatGPT&#xa;四个选项且一个正确&#xa;随机化正确选项位置" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="清洗生成输出&#xa;删除重复拒答与占位样本&#xa;强制满足指定输出模板&#xa;保留 1,497,808 组问答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="分成两半交叉拟合&#xa;在其中一半训练&#xa;在另一半推理&#xa;避免过滤自身训练样本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="训练纯文本 LLaMA-7B&#xa;只提供问题与四个选项&#xa;不提供对应图像&#xa;学习仅凭语言可答捷径" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="过滤仅凭语言可答问答&#xa;打乱选项并推理五次&#xa;至少答对三次则删除&#xa;保留 848,433 组问答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="标注图像可回答性&#xa;人工标注 2,192 组问答&#xa;训练 1,752 · 测试 440&#xa;二元图像可回答标签" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="训练问题分类器&#xa;准确率达到 81.77%&#xa;排除只在图注中出现的信息&#xa;应用于剩余候选池" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="定稿清洗后 PMC-VQA&#xa;226,946 组问答&#xa;149,075 张医疗图像&#xa;约 80% 为放射影像" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="创建图像隔离初始测试集&#xa;随机选择 50,000 组问答&#xa;PMC-VQA-test-initial&#xa;与训练集无图像重叠" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="人工核验测试样本&#xa;检查图像相关性与可回答性&#xa;检查干扰项与图像质量&#xa;保留 2,000 题 PMC-VQA-test" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="执行 Choice 任务&#xa;论文提示为 Question q · Options a1 到 a4&#xa;后缀为 the answer is&#xa;生成正确的 A B C 或 D&#xa;在人工核验测试集评测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=