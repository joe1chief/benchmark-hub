  "nodes": [
    {
      "id": "repo_search",
      "label": "GitHub 目标仓库源\n跨越 5 种主流语言的 50 个高星代码仓库\nPython · C++ · Java · TypeScript · Rust",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dep_analysis",
      "label": "跨文件依赖与拓扑排序\n分析入口目录源文件的模块引用图\n按依赖逻辑对全仓库代码文件实施拓扑排序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "treesitter_extract",
      "label": "Tree-Sitter 语法函数抽取\n解析 AST 并提取全部非重名具体函数定义\n过滤语法错误并限制函数体长度在 2KB 内",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "needle_selection",
      "label": "针函数定位与选取\n每个代码仓库均匀选取 10 个代表性函数\n总计锁定 500 个金标待检索针函数 (Needles)",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "desc_generation",
      "label": "GPT-4 语义描述合成\n根据函数实现生成精炼自然语言功能描述\n描述业务逻辑并严格防范源码直接泄漏",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "needle_quality_gate",
      "label": "针函数描述消歧质检门\n自然语言描述是否在全库中唯一锁定目标？\n经专家与多模型交叉核验无二义性",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_ambiguous",
      "label": "淘汰歧义与泛化针函数\n剔除描述过于泛化或库内存在近似实现的函数\n确保基准具备极高事实辨别力",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "RepoQA 冻结评测基准集\n包含 500 个多语言代码大海捞针任务\n50 个代码仓库 x 每库 10 个精准针函数",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "context_assembly",
      "label": "长程上下文草堆植入装配\n组装 16K-128K 词元全仓库代码上下文\n将针函数随机置于 10% 至 100% 深度位置",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "模型代码检索与提取推理\n模型阅读全库上下文定位目标函数\n完整生成并提取对应语义描述的源码实现",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "treesitter_scoring",
      "label": "Tree-Sitter 块抽取与打分\n提取模型输出中首个合法的语法代码块\n计算精确匹配 (EM) 与 CodeBLEU>=0.8 判定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "代码大海捞针检索准确率\n按编程语言、仓库类别与植入深度报告准确率\n衡量大模型长代码上下文精准检索能力",
      "type": "terminal",
      "size": "xl"
    }
  ],
