<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2920" pageHeight="576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="实时众包用户&#xa;接受数据公开发布条款&#xa;提交新鲜、开放式提示" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="抽取匿名模型对&#xa;投票前隐藏模型身份&#xa;偏向实力接近的模型对&#xa;非均匀抽样降低不确定性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="并排多轮对战&#xa;向两个模型发送相同用户消息&#xa;继续对话直至用户能够判断" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="记录成对偏好&#xa;模型 A • 模型 B • 平局 • 都不好&#xa;保存两段对话与投票" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="身份关键词过滤&#xa;移除提及模型或公司的对话&#xa;保持模型匿名性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="OpenAI 审核安全标记&#xa;标记不安全请求：3%&#xa;不作为排名输入过滤器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="论文快照（2024-01-21）&#xa;约 24 万票 • 超 9 万用户 • 超 50 模型&#xa;超 100 种语言 • 英语占 77%&#xa;近期每日 1–2K 个有效投票" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="主题建模方法&#xa;text-embedding-3-small：1,536 维&#xa;UMAP -&gt; 5；HDBSCAN 最小簇 32" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="600 个长尾主题簇&#xa;每簇抽取 10 个提示&#xa;GPT-4-Turbo 生成主题标签" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="专家重标 160 场对战&#xa;研究生盲评并核查事实&#xa;众包—专家一致率：72.8%–83.1%" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="独立异常 IP 分析&#xa;序贯 p 值 + Fisher 合并&#xa;在第 1–100 票中随机检查 5 次&#xa;用 25 异常 + 25 正常用户验证&#xa;不作为排名输入过滤器" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="估计成对胜率矩阵&#xa;对非均匀模型对抽样做逆概率加权&#xa;目标为模型对上的均匀分布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="重加权 Bradley–Terry 极大似然&#xa;每场权重为 1 / P(pair)&#xa;估计总体 BT 系数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Sandwich 稳健置信区间&#xa;大样本时优先于 Bootstrap&#xa;经多重性校正的近似排名" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="发布论文时期排行榜&#xa;BT 分数 • 胜率 • 置信区间&#