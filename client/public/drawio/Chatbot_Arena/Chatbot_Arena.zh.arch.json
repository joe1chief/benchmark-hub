      "type": "process",
      "size": "xl"
    },
    {
      "id": "vote",
      "label": "记录成对偏好\n模型A • 模型B • 平局 • 两者都差\n保存两段对话及一张选票",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "content_filter",
