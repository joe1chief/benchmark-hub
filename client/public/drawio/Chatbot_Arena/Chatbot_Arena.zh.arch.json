      "type": "process",
      "size": "xl"
    },
    {
      "id": "valid",
      "label": "有效人工偏好对战\n论文快照累计超过24万票\n近期每天约1,000–2,000张有效票",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "diversity",
      "label": "验证提示多样性\n嵌入并聚类为600个主题\n覆盖编程、数学、诗歌、医疗等长尾主题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "experts",
      "label": "在160场对战上验证投票质量\n研究生盲评并检索核实事实\n众包与专家一致率为72%–83%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "win_matrix",
