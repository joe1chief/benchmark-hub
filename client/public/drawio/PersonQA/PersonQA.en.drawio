    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1640" pageHeight="552" math="1" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Establish the Disclosure Boundary
Evidence is limited to system cards
No standalone paper or repository
Do not infer an unpublished pipeline" style="shape=document;boundedLbl=1;html=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Use Public Facts About People
This source basis is officially stated
Questions target person-level facts
