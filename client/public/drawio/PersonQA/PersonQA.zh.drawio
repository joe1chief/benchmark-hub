<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="816" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方系统卡证据&#xa;o1 · PDF 3ba7bdbe69e0&#xa;深度研究 · PDF 6662a84c7fdf&#xa;o3 与 o4-mini · PDF 32d7ca19fff2" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="确立公开信息范围&#xa;PersonQA 无独立论文&#xa;仅使用官方系统卡&#xa;不推测隐藏构建管线" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="定义人物事实问答&#xa;面向人物提出问题&#xa;使用公开可得事实&#xa;衡量已尝试答案准确率" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="覆盖 18 类事实&#xa;类别数量已披露&#xa;类别名称未披露&#xa;类别分布未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="使用内部评测集&#xa;包含人物事实问题与参考事实&#xa;样本量与划分未公开&#xa;未发布题目载荷" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="选择系统卡所报模型快照&#xa;系统卡比较具名模型版本&#xa;分数对应各卡特定运行&#xa;未发布通用固定检查点" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="向模型提出 PersonQA 问题&#xa;生成自然语言回答&#xa;保留是否尝试作答&#xa;提示词与生成设置未公开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="应用已尝试答案口径&#xa;准确率面向已尝试答案&#xa;拒答与弃答处理未披露&#xa;精确分母未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="计算准确率&#xa;模型是否正确回答&#xa;越高越好&#xa;精确评分器未发布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="计算幻觉率&#xa;模型产生幻觉的频率&#xa;越低越好&#xa;精确评分器未发布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="分别报告两项指标&#xa;准确率 · 越高越好&#xa;幻觉率 · 越低越好&#xa;两项结果分开解释" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="审核参考事实时效性&#xa;过时测试事实会夸大幻觉率&#xa;当前子女事实可能多于金标&#xa;后续答案需更仔细复核" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="系统卡所报解释&#xa;o3 整体产生更多陈述&#xa;正确与幻觉陈述均会增多&#xa;原因尚未确定" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="构建公开边界&#xa;来源选择未披露&#xa;编写与标注未披露&#xa;复核与仲裁未披露" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="评测实现边界&#xa;提示词与解析器未披露&#xa;生