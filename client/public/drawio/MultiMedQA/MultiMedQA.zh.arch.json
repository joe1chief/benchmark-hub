      "type": "process",
      "size": "xl"
    },
    {
      "id": "mcq_score",
      "label": "按准确选项计分\n分数据集或 MMLU 主题算准确率\n比较 PaLM 与 Flan-PaLM 变体\n报告提示策略消融",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "long_sample",
