    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2360" pageHeight="736" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Define Broad Medical QA Evaluation&#xa;Medical Exams · Research · Consumer Questions&#xa;Multiple-choice and Long-form Answers&#xa;English-language Scope" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Select Six Existing QA Datasets&#xa;Professional Exams · Biomedical Literature&#xa;Consumer Health and Medication Questions&#xa;Retain Dataset-specific Formats" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Prepare Health Query Seeds&#xa;Seed Medical Conditions and Symptoms&#xa;Consumer-oriented Starting Terms&#xa;Search-driven Collection Branch" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCDD2;strokeColor=#E57373;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Inventory the Existing Sources&#xa;MedQA · MedMCQA · PubMedQA&#xa;Six MMLU Clinical Topics&#xa;LiveQA · MedicationQA" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillCo