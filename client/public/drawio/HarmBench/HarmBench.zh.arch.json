      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "建立官方保留划分\n验证 100 · 测试 410\n按类别交集分层后人工调整",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attack",
