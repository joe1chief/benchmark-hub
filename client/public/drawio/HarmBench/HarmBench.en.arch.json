      "type": "database",
      "size": "xl"
    },
    {
      "id": "multimodal",
      "label": "Multimodal · 110\nbehavior string references an image\ntests image-conditioned attacks",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "dataset",
      "label": "Assemble 510 HarmBench behaviors\nfour functional · seven semantic categories\nbehavior IDs and category metadata",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "Create canonical held-out split\nvalidation 100 · test 410\nstratify intersections then adjust manually",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "attack",
      "label": "Generate attack test cases\nred-team method receives each behavior\ndo not tune on test or semantic duplicates",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "target",
      "label": "Run the target model or defense\nstandardized generation parameters\ngreedy completion for comparability",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_route",
      "label": "Classify behavior success\nexhibited or clearly attempted behavior\nuse held-out validation/test classifiers",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "open_judge",
      "label": "Non-copyright classifier\nopen Llama-2-13B-chat classifier\ntrained on human-labeled completions",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hash_judge",
      "label": "Copyright classifier\ncompare completion against stored hashes\ndirectly detect protected text generation",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "Report attack success rate\nsuccessful test cases divided by all cases\nbreak down attack · target · category",
