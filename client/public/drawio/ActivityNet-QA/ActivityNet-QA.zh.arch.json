    {
      "id": "videos",
      "label": "从 ActivityNet v1.3 采样视频\n约 20,000 个长视频中选取 5,800 个\n训练 / 验证 / 测试：3,200 / 1,800 / 800 个视频",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "author",
      "label": "人工众包编写问答\n每个视频恰好 10 对问题与答案\n初始问题和答案均以中文编写",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "types",
      "label": "控制问题类型覆盖\n1 动作 + 1 空间 + 1 时间 + 7 自由问题\n自由题答案：是非、数量、颜色、物体、位置、其他",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "标注质量门控\n问题编写者与答案标注者相互独立\n不可答题返工；随机抽题由多人作答并多数投票",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "translate",
      "label": "中译英质量检查\n用 CIDEr 比较谷歌、百度、搜狗与有道译文\n低一致性样本人工检查；其余采用百度结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "ActivityNet-QA 数据集\n5,800 个视频上的 58,000 对中英对齐问答\n训练 / 验证 / 测试：32,000 / 18,000 / 8,000 对",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prediction",
      "label": "VideoQA 模型预测\n输入：完整视频 + 自由形式问题\n输出：简短开放式答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "exact",
      "label": "精确匹配准确率\n仅预测与金标准答案完全相等时记 1 分\n官方评测脚本使用这一比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wups",
      "label": "WUPS 语义相似度\n基于 WordNet 比较答案词集合\n论文报告阈值 0.9 与 0.0 下的 WUPS",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "按问题类型汇总\n动作 • 空间关系 • 时间关系 • 自由问题\n自由问题再按六类答案细分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "ActivityNet-QA 结果\n总体及分题型准确率\nWUPS 用于补充严格相等对答案歧义的处理",
      "type": "terminal",
      "size": "xl"
    }
