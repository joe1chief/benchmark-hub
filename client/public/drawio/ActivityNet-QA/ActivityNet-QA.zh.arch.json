      "id": "videos",
      "label": "类别均衡视频采样\n5,800 个 ActivityNet v1.3 视频\n训练/验证均衡 • 测试随机",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "author",
      "label": "众包编写问答\n每视频 10 对中文问答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "types",
      "label": "控制问题覆盖\n覆盖动作 + 空间 + 时间问题\n其余问题自由、不限题型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_gate",
      "label": "限制问答长度\n问题 ≤20 词 • 答案 ≤5 词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "yes_no_balance",
      "label": "均衡是非答案\n比例接近 1:1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "双重检查每条答案\n由另一名标注员独立复核\n不可回答问题返工",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "random_audit",
      "label": "复核抽样部分\n多人标注 • 多数投票\n规模与人数未披露",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "translate",
      "label": "中译英质检\n生成四个翻译引擎结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "translation_gate",
      "label": "CIDEr 共识门控\n平均相似度是否超过阈值？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "baidu_translation",
      "label": "保留百度翻译\n共识通过阈值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "manual_translation",
      "label": "人工翻译\n处理低共识问答",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "ActivityNet-QA\n问答：32,000 / 18,000 / 8,000\n视频：3,200 / 1,800 / 800",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prediction",
      "label": "VideoQA 预测\n视频 + 问题 → 答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "exact",
      "label": "精确匹配准确率\n预测等于参考答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wups",
      "label": "WUPS 相似度\n阈值 0.9 与 0.0\n仅报告总体分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "按题型汇总精确匹配\n动作 • 空间 • 时间 • 自由",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告结果\n精确匹配：总体 + 分题型\nWUPS：仅总体",
