    {
      "id": "standards",
      "label": "整理工业设计家族\n紧固件 • 齿轮 • 弹簧 • 管件 • 外壳\n47 项 ISO / DIN / EN / ASME / IEC 标准",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "family_modules",
      "label": "领域专家实现 106 个家族\n类型 schema • 采样器 • 验证器 • builder\n标准方程与物理参数关系",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "sample",
      "label": "按家族 × 子家族 × 难度采样\n简单 • 中等 • 困难参数复杂度\n覆盖 49 个 CadQuery 操作和可选特征",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sandbox",
      "label": "生成并沙箱执行 CadQuery\n隔离解析/导入 • 运行异常 • 30 秒超时\n拒绝零体积或反转几何",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "artifacts",
      "label": "打包已验证部件产物\n源码 • STEP • 四个标准视图\n参数 JSON • 操作列表 • 专家视觉验收",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 BenchCAD 核心集\n17,900 个执行验证部件\n106 个家族 • 52 个标准锚定家族",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "vision2code",
      "label": "构建 Vision2Code 任务\n输入四个正交渲染视图\n目标为可执行 CadQuery 程序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qa_bank",
      "label": "构建配对 Vision QA 与 Code QA\n每家族 6–12 个专家模板 • 二次复核\n2,400 个数值题对 × 两种条件输入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "edit_bank",
      "label": "构建 Code Edit 任务\n验证原件与目标 • 复核指令\n两个强模型交叉检查 • 保留 748 对",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_run",
      "label": "评测前沿、开源与 CAD 专用模型\n统一提示与沙箱 • 保持配对比较\n加入黑图、无代码和保持原程序的盲测",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "v2c_score",
      "label": "评分 Vision2Code\n执行率 • Voxel IoU • Chamfer / Hausdorff\nFeature-F1 • 关键操作召回 • 综合分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qa_score",
      "label": "评分配对 QA\n比率允许 ±5% • 整数精确匹配\nL1–L4 能力和视觉-代码差距",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "edit_score",
      "label": "评分最小代码编辑\n对剩余改进空间归一化的 IoU 增益\n执行 • 目标匹配 • 非目标区域保持",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "发布能力分解结果\n四类任务 • 家族与难度分解\n感知、参数、操作和编辑能力差距",
      "type": "terminal",
      "size": "xl"
    }
  ],
