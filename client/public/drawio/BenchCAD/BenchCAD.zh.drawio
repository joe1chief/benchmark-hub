    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="1136" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="整理工业设计零件族&#xa;106 个零件族中 52 个锚定标准&#xa;覆盖 47 项 ISO / DIN / EN / ASME / IEC 标准" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="专家实现 106 个零件族模块&#xa;类型化 Schema • 采样器 • 校验器 • 构建器&#xa;覆盖 49 种 CadQuery 操作" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="按零件族 × 子族 × 难度采样&#xa;简单 • 中等 • 困难参数复杂度&#xa;强制标准表和物理参数关系" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="沙箱执行 CadQuery&#xa;拒绝解析/导入/运行错误及 30 秒超时&#xa;拒绝零体积或反转几何" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="打包验证后的零件产物&#xa;代码 • STEP • 四个标准视图&#xa;参数 • 操作清单 • 专家视觉签核" style="shape=cy