    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2824" pageHeight="456" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据边界&#xa;arXiv:2512.24867v2&#xa;仓库 @ 5549c73&#xa;HF 数据集 @ 0f81da9" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择 62 本大学 / 研究生教材&#xa;11 个学科 · 43 个来源子领域（§3.1.1）&#xa;权威知识来源" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="人工截取教材页面&#xa;用马赛克遮盖无关内容&#xa;保留可回溯到页面的来源上下文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="提取独立正确语句及标题&#xa;doubao-1.5-vision-pro-32k&#xa;要求独立 / 完整&#xa;语义清晰 / 信息简洁" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="顺序过滤正确语句&#xa;含图语句：剔除 3,269 条&#xa;章节引用 / 公式编号 / 化学方程式：642 条&#xa;语义歧义：127 条 → 保留 21,525 条" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="3 名标注员复核全部 21,525 条&#xa;未发现重大问题&#xa;只需核验格式规范&#xa;无需领域专家编写问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="984" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="DeepSeek-R1 生成欺骗性错误对应语句&#xa;概念替换 · 因果倒置 · 细节篡改&#xa;时间错置 · 逻辑悖论&#xa;范围修改 · 同时生成错误理由" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1240" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="过滤过短样本 → 21,494 条错误语句&#xa;随机抽取 200 条人工复核&#xa;5 条理由不匹配，但语句仍为错误&#xa;作者未再做额外处理" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="语句候选集合&#xa;21,525 条正确 + 21,494 条错误 = 43,019&#xa;英文 28,045 条 + 中文 14,974 条&#xa;11 个学科 · 44 个领域 · 62 个最终子领域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1760" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="程序化抽样并组装问题&#xa;8–10 条语句 · 4–8 个字母选项&#xa;每个选项组合 2–4 条语句&#xa;发布仓库未提供构建代码与标准随机种子" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2024" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Encyclo-K 标准配置&#xa;5,038 题：英文 3,286 + 中文 1,752&#xa;按学科语句占比分配&#xa;语句编号 i、ii、…；选项编号 A、B、…" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2280" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="用三组正则解析答案字母&#xa;先搜最后一行，再搜完整响应&#xa;失败后精确匹配选项正文&#xa;未解析 = 错误 · 报告准确率" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2544" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;stroke