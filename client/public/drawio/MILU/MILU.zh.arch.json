    {
      "id": "evidence",
      "label": "固定一手证据\narXiv 2411.02538v3\n修订 2025-02-04\nPDF a862d7eb…\nGit 7d8e6c9 · HF 946c423\n数据提交 be958af",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "exam_sources",
      "label": "选择考试来源\n公开国家级 · 邦级 · 区域级网站\n1,500 多场考试\n40 多类 · 覆盖近年试卷\n专家答案 · 网站人工标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "scrape",
      "label": "抓取已发布试卷\n15 万多道原始多选题\n11 种语言且含英语\n通识 + 文化特定知识\n地方史 · 艺术 · 节庆 · 法律",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "format_qc",
      "label": "执行格式质检\n去除阅读理解\n去除图像题\n去除超过四个选项的问题\n保留统一四选一题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "language_qc",
      "label": "执行分层清洗\n人工检查大规模样本\nIndicLID + Unicode 检查\n去除语言错误记录\n问题去重",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "topic_recovery",
      "label": "恢复缺失主题\n仅约 45% 标签准确\nIndicTrans2 译成英文\nGPT-4o-mini 分配主题\n约 2 万个细粒度标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "构建主题分类\nNV-Embed-v2 嵌入标签\nK-means 聚为 50 簇\n人工复核并合并\n41 学科 · 八大领域",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "gap_fill",
      "label": "补齐学科-语言缺口\n每个组合至少 100 题\n抽取同科英文题\n任务感知 GPT-4o 翻译\n每个组合最多 500 题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_qc",
      "label": "执行最终语言审计\n每种语言抽样\n人工验证准确性\n修正剩余错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "test_release",
      "label": "发布测试集\n79,617 道四选一题\n19,915 道翻译题 · 约 25%\n11 种语言 · 41 学科\n八大领域 · 发布各语言题量",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "validation_release",
      "label": "发布验证集\n8,933 例 · 覆盖全部 41 学科\n仅用于少样本演示\n未声明训练集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "public_contract",
      "label": "发布行字段契约\nquestion · 四选项 · target\n翻译标记 · language\ndomain · subject\n11 配置 · test + validation\nCC BY 4.0 · 自动门控",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "harness",
      "label": "固定官方评测代码\nGit 7d8e6c9 · 任务 683a670\nlm_eval 0.4.4 · MIT\nai4bharat/MILU · token=true\n11 个任务 · 版本 0.0",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "eval_route",
      "label": "评测分支\n对数似然\n或零样本 JSON",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "nonapi_setup",
      "label": "设置非 API 样本数\n论文：零/一/五样本\n验证集提供演示\n当前采样器 first_n\n多数开放模型为五样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "prompt",
      "label": "渲染评测提示\nQuestion: question\nChoices: A-D · 四个选项\nAnswer:\n指令模型可用聊天模板",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "loglikelihood",
      "label": "为四个选项计分\n每个选项以提示为条件\n累加目标 token 对数概率\n选择最高分\n不使用生成解析器",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "item_accuracy",
      "label": "计算单题准确率\noption1-option4 映射 0-3\n比较预测与标准答案\n正确 1 · 错误 0\n取平均准确率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "language_score",
      "label": "计算逐语言分数\n11 个测试配置\n论文单元格为八领域均值\n分析学科与资源等级\n保留对应样本设置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "api_generate",
      "label": "执行论文 API 路径\n闭源模型 · 仅零样本\n不支持提示对数概率\n生成结构化 JSON\n成本限制一/五样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "api_parse",
      "label": "解析 API 响应\n提取所选答案\nJSON schema/解析器未发布\n固定代码中无 API 任务",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_aggregate",
      "label": "计算论文汇总\n11 种语言宏平均\nGPT-4o 74.74% · API 零样本\n开放模型多数五样本\n明确保留混合样本设置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告论文分析\n语言 · 领域 · 学科\n模型家族 · 规模 · 资源等级\n可用时报告零/一/五样本\nHF 卡片不等于新评测",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "construction_gaps",
      "label": "未披露的构建细节\n网站 URL · 收集日期\n标注者 · 一致性\n去重方法 · 质检样本量\n翻译提示/模型 · 随机种子",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "当前 HF 边界\nHF 946c423 · 自动门控\n仅列出 11 × 2 个 Parquet\n实体/Dataset Server 返回 401\n未独立审计当前数据行",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "data_history",
      "label": "发布历史边界\n初始数学格式缺陷\nv3 计分排除数学题\n数据于 2025-04-28 重推\n表格 79,617 · 正文约 85K",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "repo_boundary",
      "label": "论文/评测代码边界\n论文未固定代码提交\n当前少样本为 first_n\nREADME: --apply_chat_template\n未发布完整运行命令",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "aggregation_boundary",
      "label": "聚合边界\n论文单元格：领域均值\n总分：11 种语言宏平均\n代码组：weight_by_size\n派生 75.95：反事实值\n非官方 · 非复现",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "reporting_drift",
      "label": "论文/README 数量漂移\n摘要：超过 42 个模型\n第 4 节 42 · 引言/结论 45\n任务 README：42 学科 · 72%\nv3/卡片：41 学科 · 74%",
      "type": "document",
      "size": "xl"
    }
