  "nodes": [
    {
      "id": "scope",
      "label": "定义三模态理解任务\n输入：图像 · 音频 · 文本\n重建一致跨模态语境\n输出文本答案",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "建立推理任务分类\n时间空间实体\n因果推断\n抽象概念 · 共八类任务",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "team",
      "label": "组建标注团队\n16 名标注员\n5 名质量检查员\n均具高等教育背景",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mcq",
      "label": "编写四选一问题\n仅有一个正确答案\n至少一个高迷惑干扰项\n避免简单答案模式",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "dependency",
      "label": "强制依赖图像与音频\n拒绝单模态可答样例\n使用跨模态互补证据\n保留文本问题语境",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "constraints",
      "label": "应用数据约束\n图像分辨率不低于 480P\n音频时长不超过 30 秒\n限制重复来源与相似问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rationales",
      "label": "标注支撑证据\n提供音频转写或音乐描述\n给出图像专属理由\n给出音频专属理由",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "human_qc",
      "label": "执行人工交叉检查\n记录明确失败原因\n退回未通过样例\n定向修订问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "model_qc",
      "label": "运行 LLaVA-1.6-34B 检查\n仅图像加文本\n仅音频转写加文本\n纯文本重复测试三次",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gate",
      "label": "检验跨模态必要性\n仅接受拒答或答错样例\n回收可修订数据\n丢弃难以修复的样例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 OmniBench\n1,142 条问答\n语音 · 声音事件 · 音乐\n三大类 · 八类任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "full_eval",
      "label": "执行完整三模态评测\n同时提供图像与音频\n文本问题含四个选项\n提取答案字母",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "ablations",
      "label": "执行模态消融\n移除图像或音频\n用人工音频转写替代\n用模型图像描述替代",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告准确率\n精确匹配正确选项字母\n比较完整与消融输入\n加入音乐家人类基线",
      "type": "terminal",
      "size": "xl"
    }
  ],
