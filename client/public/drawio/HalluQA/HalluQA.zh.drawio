    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3224" pageHeight="696" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据与固定版本&#xa;arXiv 2310.03368v4 · 仓库 c025c0d&#xa;HalluQA.json e2f8ac3 · 450 行" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="设计中文对抗问题&#xa;历史 · 文化 · 习俗 · 社会现象&#xa;按幻觉成因分流" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="编写误导问题&#xa;20 种 TruthfulQA 启发模式&#xa;适配中国文化语境" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="GLM-130B 随机采样 5 次&#xa;6 个人工中文问答示例&#xa;至少 3/5 次生成错误才保留" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="形成误导题集&#xa;175 道作者编写问题&#xa;覆盖 22 个领域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="收集近期中文互联网疑难问题&#xa;用 ChatGPT 3.5 构造对抗问题&#xa;要求问题本身含误导信息" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="形成困难误导题集&#xa;69 道作者复核问题&#xa;覆盖 15 个领域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="10 名中文母语研究生实习生&#xa;编写事实知识问题&#xa;覆盖多个领域" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="ChatGPT + Puyu 各运行 5 次&#xa;两者都至少答错 3/5 才保留&#xa;收集约 1,000 道候选题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="NLP 专家筛选高质量样本&#xa;核验答案并保留 206 道&#xa;覆盖 14 个领域" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="补充答案与支撑证据&#xa;误导题：4 个正确 + 4 个错误答案&#xa;知识题：正确和错误答案各至少 1 个" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="知识题：用外部链接核验&#xa;误导题：由未参与出题的作者复核&#xa;改写或丢弃有缺陷的问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="发布 HalluQA · 450 道题&#xa;覆盖 30 个领域&#xa;175 道误导 + 69 道困难 + 206 道知识" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="要求回答每题&#xa;拒答计为幻觉&#xa;仅标准答案为不可回答时例外" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="GPT-4-0613 + 论文 5 条判据&#xa;5 次投票 · 温度 0 · top-p 0.5&#xa;以正确答案示例作为证据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="报告非幻觉率&#xa;计算全部 450 条输出中的比例&#xa;保留被判定无幻觉的结果" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="独立评判器验证&#xa;100 道题 × 6 个模型 = 600 条输出&#xa;五票结果与人工一致率 93.50%" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="论文/脚本边界&#xa;论文正文：5 条判据&#xa;固定脚本提示：6 条编号项&#xa;使用同一评判设置与决策规则" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometr