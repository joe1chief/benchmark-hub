      "label": "24 Independent Experts\nChecklist → Timed Solve (15 min)\nReveal Answer / Evidence → Verify\nHuman Baseline = 53.7%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "manual_gate",
      "label": "Revision Needed?\nInvalid / Wrong Answer\nor Correct within 3 min",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "Assign Difficulty\nHard: ≥2 LLMs Miss\nAND Expert Needs >10 min",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "Author Final Audit\n70 Sample: 68 Correct\n67 Google-proof • Privacy/IP Check",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_set",
      "label": "503 English Test MCQs\nEasy 192 • Hard 311\nShort 180 • Medium 215 • Long 108",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_input",
      "label": "Context + Question + A–D\nMiddle-truncate only if\nSequence Exceeds Model Window",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "feedback",
      "label": "Reviewer Feedback → Rewrite\nIllegal • Too Easy\nWrong Answer",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "revision_limit",
      "label": "Rewrite Limit\nReached?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard",
      "label": "Discard\nPersistent Failure",
      "type": "terminal",
      "size": "large"
    },
    {
      "id": "core_eval",
      "label": "Core Evaluation\nZero-shot: 128 Tokens\n2-call CoT: 1024 → 128 • T=0.1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aux_eval",
      "label": "Auxiliary Analyses\nRAG: 512-token Chunks + Top-N\nNo Context: Memorization Check",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parser",
      "label": "Official A–D Regex Parser\nExact Choice Match\nInvalid Output = Wrong",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Model Accuracy Reports\nOverall • Easy/Hard\nShort/Medium/Long",
      "type": "terminal",
      "size": "xl"
    }
