      "id": "auto_review",
      "label": "3 × 128k LLM Review\nGPT-4o-mini • GLM-4-Air\nGLM-4-Flash • Middle Truncate",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reject_short",
      "label": "Reject\nContext Too Short",
      "type": "terminal",
      "size": "large"
    },
