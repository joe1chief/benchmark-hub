{
  "version": 1,
  "title": "LongBench v2 构建与评测流程",
  "type": "academic-diagram",
  "source": "edited",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 23,
    "edges": 25,
    "modules": 0
  },
  "nodes": [
    {
      "id": "taxonomy",
      "label": "任务体系\n6 大类 • 20 个子任务",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sources",
      "label": "上下文来源\n97 名标注者 + 任务专用数据\n个人文件 • 既有数据集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "normalize",
      "label": "准备上下文\n文件 → 纯文本\nPyMuPDF 等工具",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_gate",
      "label": "上下文是否少于\n8,192 词？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "overlap_gate",
      "label": "是否与既有标注\n高度重合？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "编写英文选择题\n问题 + A–D + 答案\n支持证据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "auto_review",
      "label": "3 个 128k 模型复核\nGPT-4o-mini • GLM-4-Air\nGLM-4-Flash • 必要时中部截断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "reject_short",
      "label": "拒绝\n上下文过短",
      "type": "terminal",
      "size": "large"
    },
    {
      "id": "reject_overlap",
      "label": "拒绝\n重合度过高",
      "type": "terminal",
      "size": "large"
    },
    {
      "id": "auto_gate",
      "label": "三个模型是否\n全部答对？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "expert_review",
      "label": "24 名独立专家\n清单检查 → 限时作答（15 分钟）\n揭示答案/证据 → 核验\n人类基线 = 53.7%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "manual_gate",
      "label": "是否需要修订？\n无效 / 答案错误\n或 3 分钟内答对",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "标注难度\n困难：至少 2 个模型答错\n且专家用时 >10 分钟",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "作者最终审计\n抽查 70 题：68 题正确\n67 题不可搜索 • 隐私/版权检查",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_set",
      "label": "503 道英文测试选择题\n简单 192 • 困难 311\n短 180 • 中 215 • 长 108",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_input",
      "label": "上下文 + 问题 + A–D\n仅在超出模型窗口时\n截断序列中部",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "feedback",
      "label": "复核反馈 → 重写\n不合规 • 过易\n答案错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "revision_limit",
      "label": "是否达到\n重写上限？",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard",
      "label": "丢弃\n持续未通过",
      "type": "terminal",
      "size": "large"
    },
    {
      "id": "core_eval",
      "label": "核心评测\n零样本：128 Tokens\n两段式 CoT：1024 → 128 • T=0.1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aux_eval",
      "label": "辅助分析\nRAG：512-token 分块 + Top-N\n无上下文：记忆检查",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parser",
      "label": "官方 A–D 正则解析\n选项精确匹配\n无效输出计错",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "模型准确率报告\n总体 • 简单/困难\n短/中/长",
      "type": "terminal",
      "size": "xl"
    }
  ],
