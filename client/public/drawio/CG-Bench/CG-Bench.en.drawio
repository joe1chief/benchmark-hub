arent="1"><mxGeometry x="688" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Annotate 6–15 QAC per Video&#xa;Watch Entire Video • Use Native Language&#xa;Write QA, Then One or More Clue Intervals" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="944" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Create Multiple-choice Options&#xa;Add 4–7 Negative Options&#xa;Preserve Complete Events in Clue Intervals" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1192" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Manual Rationality Check&#xa;Inspect Question, Options, and Answer&#xa;Reject Illogical or Weak Items" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="GPT-4 Text-only Check&#xa;Reject Questions Answerable Without Video&#xa;Enforce Video Dependence" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1688" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="MLLM Visual-difficulty Check&#xa;Reject Sparse-frame-answerable Items&#xa;Reject Items 