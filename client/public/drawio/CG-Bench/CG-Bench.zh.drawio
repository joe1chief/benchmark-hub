  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3472" pageHeight="952" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="人工收集互联网视频&#xa;时长超过 10 分钟&#xa;保留音频与字幕" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="标注并平衡视频内容&#xa;14 个根类 • 171 个二级类 • 638 个三级类&#xa;覆盖多样的 10–80 分钟视频" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="192" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="七轮人工视频审核&#xa;检查相关性、质量与多样性&#xa;保留 1,219 个长视频" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="定义问题分类体系&#xa;感知 • 推理 • 幻觉&#xa;包含细粒度子类" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="688" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="每个视频标注 6–15 个 QAC&#xa;观看完整视频 • 使用母语&#xa;先写问答，再标一个或多个线索区间" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="944" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="创建多项选择选项&#xa;增加 4–7 个负选项&#xa;在线索区间中保留完整事件" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1192" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="人工合理性检查&#xa;审核问题、选项与答案&#xa;拒绝不合理或薄弱条目" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="GPT-4 纯文本检查&#xa;拒绝无需视频即可回答的问题&#xa;强制依赖视频内容" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1688" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="MLLM 视觉难度检查&#xa;拒绝稀疏帧即可回答的条目&#xa;拒绝小模型容易完成的条目" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1944" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="线索分布检查&#xa;监控线索时长与时间位置&#xa;保持数据集级多样性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2192" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="四项检查全部通过？&#xa;人工 AND GPT-4 AND MLLM AND 分布&#xa;任一失败均必须修订" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2440" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="返回标注员&#xa;修订问答、选项或线索区间&#xa;重新进入完整质量门" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1944" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="发布 CG-Bench&#xa;1,219 个视频 • 12,129 个 QAC&#xa;14,362 个线索区间" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2688" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="完整视频 / 线索片段 MCQ&#xa;对比长视频与合并线索输入&#xa;报告 long-acc. + clue-acc." style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="白盒线索定位&#xa;预测一个或多个时间区间&#xa;mIoU • rec.@IoU • acc.@IoU" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2