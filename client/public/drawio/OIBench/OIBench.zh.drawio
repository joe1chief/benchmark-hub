  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4040" pageHeight="592" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定 OIBench 范围&#xa;arXiv 2506.10481v1 · 第 3–5 节&#xa;主基准为 250 道题&#xa;来源复核于 2026-07-18" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="招募资深 OI 教练&#xa;大学 ACM / 高中 OI&#xa;平均约 20 年执教经验&#xa;私有题目或全新命题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="原创性 / 保密门禁&#xa;网络和纸质材料均未发布&#xa;拒绝只改数字&#xa;拒绝只改措辞&#xa;要求全新问题逻辑" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="标注难度元数据&#xa;Codeforces 风格难度分&#xa;竞赛级别标签&#xa;面向前沿推理能力" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="编写稳健官方测试&#xa;大规模 / 高资源输入&#xa;覆盖边界与极端情形&#xa;正文称标准列在附录&#xa;v1 附录未列出该标准" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="验证标准 C++ 解法&#xa;每题一份&#xa;运行全部官方测试&#xa;确认可解性&#xa;验证测试正确性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="六名 OI 选手评审&#xa;至少 CCPC 银牌&#xa;检查可解性 · 清晰度 · 样例&#xa;验证 TeX / Markdown" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="生成英文版本&#xa;三名专业译者&#xa;翻译专业学位 · 至少两年&#xa;使用 OI 教练 / 选手术语表" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="审计发布时可检索性&#xa;在线搜索每一道题&#xa;未发现可直接检索同题&#xa;结论固定于 2025 年 5 月" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="发布 OIBench 主基准&#xa;250 道原创双语题目&#xa;测试 · 难度 · 标准 C++&#xa;平均测试规模：37.5M" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行零样本代码生成&#xa;完整题目 + OJ 输入输出&#xa;C++ · Java · Python · JavaScript&#xa;推理模型上限 32,768 token" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="应用论文解码设置&#xa;默认贪心 · 温度 0&#xa;DeepSeek-R1 / Qwen3-32B：0.6&#xa;按语言保留主结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="使用论文 Docker 运行时&#xa;CentOS 7.6 · 内核 5.4&#xa;glibc 2.31 · C++17 g++11.3 -O2&#xa;Java 1.8.0u45 · Python 3.9&#xa;Node 16.18.1 · npm 8.19.2" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="编译并执行&#xa;运行全部官方测试&#xa;监控时间与内存&#xa;保留逐测试结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="计算主 AC 率&#xa;仅在全部测试通过时接受&#xa;总体 + 四语言 AC&#xa;对比中文 / 英文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="构建完成曲线&#xa;逐测试通过率 · 不是 AC&#xa;X：相对标准解资源比&#xa;对数尺度&#xa;Y：通过测试用例占比" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3280" y="408" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="报告正确性 / 效率&#xa;AC 与完成曲线保持独立&#xa;保留各语言分项结果&#xa;排除独立分析轨道" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3520" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="保持分析彼此独立&#xa;OIBench Pseudo · Risk-Score&#xa;衍生 BF · CP · TS · IT&#xa;人类对比&#xa;44 道题" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3760" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="论文 / 代码 / 许可证边界&#xa;PDF 42dc756… · 代码 2a84ab8…&#xa;HF 数据 7736d47… · 250 行&#xa;数据 CC BY-ND 4.0 · 代码无 LICENSE&#xa;宿主评分器：无 Do