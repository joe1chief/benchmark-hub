  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2784" pageHeight="1576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定原版LongBench证据&#xa;arXiv 2308.14508v2 · ACL 2024&#xa;THUDM/LongBench @ 2e00731f&#xa;HF数据集 @ 5e628be4" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="固定公开任务来源划分&#xa;论文：公开任务使用测试集&#xa;VCSUM为论文所述例外&#xa;仓库说明写验证集或测试集" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="256" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="分流至六类任务" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="568" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="单文档问答 · 750条&#xa;NarrativeQA 200 · Qasper 200&#xa;MultiField英文150 · 中文200&#xa;将公开数据重排为纯文本&#xa;3名博士生构建MultiField" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="多文档问答 · 800条&#xa;Hotpot · 2Wiki · MuSiQue各200条&#xa;2–4篇证据 + 完整篇章 + 干扰文档&#xa;随机排列篇章&#xa;DuReader 200条 · 相关加任意文档至20篇" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="摘要 · 800条&#xa;GovReport · QMSum · MultiNews · VCSUM&#xa;每个数据集200条&#xa;前三项使用ZeroSCROLLS模板&#xa;VCSUM用专用模板与长片段" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="304" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="少样本学习 · 800条&#xa;TREC · TriviaQA · SAMSum · LSHT&#xa;每个数据集200个目标查询&#xa;从训练集抽取示例&#xa;范围100–600 · 2–24 · 10–100 · 10–40" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="480" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="合成任务 · 600条&#xa;中英文检索 · PassageCount&#xa;每个数据集200条&#xa;30个段落 + GPT-3.5摘要&#xa;计数：M为17–50 · N为2–M · 打乱" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="656" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="代码补全 · 1,000条&#xa;LCC 500 · RepoBench-P 500&#xa;抽样LCC下一行任务&#xa;XF-F · Oracle-Filled RepoBench-P&#xa;打乱标准片段与跨文件片段" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="832" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="标准化候选记录&#xa;input · context · answers · length&#xa;dataset · language · all_classes · _id&#xa;英文/代码计词 · 中文计字符&#xa;length统计前三个字段" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="随机抽样标准LongBench&#xa;21个数据集 · 4,750条测试样本&#xa;14个英文 · 5个中文 · 2个代码&#xa;六类任务 · 自然长度分布&#xa;论文均值：英文6,711词 · 中文13,386字" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="400" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="保留版本漂移&#xa;论文/HF英文均值6,711/6,666.63词&#xa;论文/HF中文均值13,386/13,338.71字&#xa;仓库根目录为v2 · 原版移至LongBench/&#xa;THUDM数据URL重定向到zai-org" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1864" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="公开发布边界&#xa;仓库代码带MIT许可证&#xa;HF数据卡未声明许可证元数据&#xa;README含官方静态榜单&#xa;无提交入口或版本化排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="选取13个英文/代码数据集&#xa;Qasper · MultiField英文 · Hotpot · 2Wiki&#xa;GovReport · MultiNews · TREC · TriviaQA&#xa;SAMSum · 计数 · 英文检索&#xa;LCC · RepoBench-P" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1864" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="按词数均匀采样&#xa;0–4k · 4–8k · 8k+&#xa;每数据集每档最多100条&#xa;Qasper 100/100/24 · MultiField 67/70/13&#xa;MultiNews 100/100/94" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="发布均匀长度LongBench-E&#xa;13个数据集共3,668条&#xa;其余10个数据集每档100条&#xa;沿用记录结构与任务指标" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="选择评测集&#xa;标准LongBench或LongBench-E&#xa;按数据集分别运行" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2504" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="应用数据集专用提示&#xa;填入input与context字段&#xa;多个模板在上下文前后重复指令&#xa;输出上限为32 · 64 · 128 · 512词元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="用候选模型分词器编码&#xa;提示长度超过模型上限M时&#xa;保留前M/2与后M/2词元&#xa;加聊天模板前删除中间部分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1864" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="加入模型专用聊天模板&#xa;TREC · TriviaQA · SAMSum · LSHT除外&#xa;LCC · RepoBench-P也除外&#xa;这六项保持补全式提示" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="生成至数据集输出上限&#xa;贪心解码 · 不采样&#xa;每条测试记录生成一个预测&#xa;SAMSum额外遇换行停止" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="执行官方后处理&#xa;XGen去Assistant · InternLM截至eoa&#xa;四个少样本任务取首行&#xa;代码任务取首个非注释行&#xa;与每个参考答案比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="904" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="分派数据集指标&#xa;问答F1 · ROUGE-L&#xa;论文称CLS · 评测器按标签命中数给1/n&#xa;论文称EM · 评测器按匹配数字计分&#xa;代码编辑相似度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="584" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="计算数据集得分（%）&#xa;对多个参考答案取最大指标值&#xa;数据集求均值后乘100&#xa;LongBench-E再按长度档分组" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="264" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="聚合论文结果&#xa;类内先平均各数据集&#xa;总分为六类均值的平均&#xa;中英文视图均计入代码任务" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="报告21个数据集得分&#xa;六类均值 · 英文 · 中文 · 总分&#xa;LongBench-E三档长度结果&#xa;在官方README发布结果表" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="1392" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;dashed=1;dashP