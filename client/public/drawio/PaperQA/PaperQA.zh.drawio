<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="912" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2310.02255v3 · PDF ee5a616e9481&#xa;Git 53d525874bdd&#xa;HF 2b6ad69445fb" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="24" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="识别科学推理缺口&#xa;学术图表上的科学推理&#xa;仍未被现有来源覆盖&#xa;需要视觉扎根的数学推理&#xa;新建PaperQA来源数据集" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="280" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="获取2023年8月论文&#xa;使用Hugging Face发布的论文&#xa;选取信息丰富的表格与图形&#xa;纳入学术论文中的图表" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="人工标注问题&#xa;由STEM领域研究生标注&#xa;每题扎根于对应插图&#xa;聚焦科学推理" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="独立复核每个数据集&#xa;三名复核者标注答案&#xa;执行两步一致性流程&#xa;对比复核者答案标签" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="计算交叉复核一致性&#xa;三个新数据集共736题&#xa;答案一致率99.2%&#xa;总计六处分歧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="解决六处分歧&#xa;全体复核团队逐题讨论&#xa;修正有歧义的答案标签&#xa;每个样例达成共识" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1584" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="添加细粒度元数据&#xa;问题与答案类型 · 语言&#xa;来源 · 类别 · 任务 · 年级&#xa;上下文与推理技能" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="论文v3的PaperQA范围&#xa;107个学术插图样例&#xa;大学级图形问答&#xa;科学与统计推理" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2104" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="封装固定官方发布&#xa;发布JSON含108条PaperQA&#xa;testmini 19条 · test 89条&#xa;图像 · 问题 · 选项 · 元数据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行MathVista划分策略&#xa;testmini用于开发验证&#xa;test答案保持隐藏&#xa;近似整体来源分布" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2104" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="生成模型回答&#xa;单独传入图像&#xa;类型提示 · 问题 · 选项&#xa;可选图像描述与OCR上下文" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1584" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="规则能否抽取&#xa;精确选项或数值&#xa;可选引号正则&#xa;否则用大模型" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="使用直接抽取&#xa;返回精确选项字符串&#xa;解析整数或浮点回答&#xa;仅quick_extract启用正则" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="使用五示例大模型抽取器&#xa;拼接查询与模型回答&#xa;论文使用GPT-4抽取短答案&#xa;200题试验准确率超99.5%" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="规范化抽取答案&#xa;字母或编辑距离最近选项&#xa;整数 · 舍入浮点数 · 列表字符串&#xa;使用安全精确相等比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="报告确定性准确率&#xa;统计规范化后的精确匹配&#xa;按来源与元数据拆分&#xa;PaperQA仍是MathVista子集" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="论文与发布计数边界&#xa;论文v3记载107个样例&#xa;固定JSON含108条：19加89&#xa;主流程同时保留两项事实" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2360" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="许可与用途边界&#xa;新增贡献采用CC BY-SA 4.0&#xa;图像与问题版权仍归原作者&#xa;可作测试集，不得用作训练集" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#