.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="Report Deterministic Accuracy&#xa;Count exact normalized matches&#xa;Break down by source and metadata&#xa;PaperQA remains a MathVista subset" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="Paper-to-release Count Boundary&#xa;Paper v3 states 107 PaperQA examples&#xa;Fixed JSON contains 108: 19 plus 89&#xa;The primary flow preserves both facts" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2360" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="License and Use Boundary&#xa;New contributions: CC BY-SA 4.0&#xa;Images and questions retain copyrights&#xa;Test use allowed; training prohibited" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="728" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="Extractor Reproducibility Boundary&#xa;Paper names GPT-4, not a checkpoint&#xa;Code reads AZURE_OPENAI_MODEL&#xa;Endpoint and deployment are external" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;stroke