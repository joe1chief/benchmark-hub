  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2640" pageHeight="912" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Fixed Official Evidence&#xa;arXiv 2310.02255v3 · PDF ee5a616e9481&#xa;Git 53d525874bdd&#xa;HF 2b6ad69445fb" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="24" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Identify the Scientific Gap&#xa;Academic-figure scientific reasoning&#xa;Remains unaddressed by existing sources&#xa;Need visually grounded math reasoning&#xa;Add the PaperQA source dataset" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="280" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Source August 2023 Papers&#xa;Use papers released on Hugging Face&#xa;Take informative tables and figures&#xa;Include charts from academic papers" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Manually Annotate Questions&#xa;Graduate students in STEM fields&#xa;Ground each question in its illustration&#xa;Target scientific reasoning" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="800" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Independently Review Each Dataset&#xa;Three reviewers annotate answers&#xa;Apply the two-step consistency process&#xa;Compare reviewer answer labels" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Measure Cross-review Agreement&#xa;736 new questions across three sets&#xa;99.2 percent answer consistency&#xa;Six disagreements in total" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Resolve the Six Disagreements&#xa;Entire review team discusses each case&#xa;Refine ambiguous answer labels&#xa;Reach consensus per example" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1584" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Attach Fine-grained Metadata&#xa;Question and answer types · language&#xa;Source · category · task · grade&#xa;Context and reasoning skills" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Paper-v3 PaperQA Scope&#xa;107 academic-illustration examples&#xa;Figure question answering · college&#xa;Scientific and statistical reasoning" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2104" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Package the Fixed Official Release&#xa;108 PaperQA rows in released JSON&#xa;testmini 19 · test 89&#xa;Images · questions · choices · metadata" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Apply the MathVista Split Policy&#xa;testmini supports development&#xa;Test answers remain withheld&#xa;Approximate the full source distribution" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2104" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Generate a Model Response&#xa;Pass the image separately&#xa;Type-aware hint · question · choices&#xa;Optional caption and OCR context" style="rounded=1;arcSize=2