      "type": "document",
      "size": "xl"
    },
    {
      "id": "pubmed_pool",
      "label": "PubMed 论文池\n结构化摘要\n标题 · 正文 · 结论",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "natural_gate",
      "label": "筛选自然问题\n标题包含问号\n结构化摘要包含\n明确结论段",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "natural_instance",
      "label": "构造 pre-PQA-U 样本\n问题 = 原始标题\n上下文 = 去除结论的摘要\n长答案 = 结论",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "pqal_sample",
      "label": "随机抽取候选样本\n进入 PQA-L 专家标注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answerability_gate",
      "label": "能否用 是 · 否 · 可能 回答\n专家标注前移除\n不可回答样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "annotator_one",
      "label": "标注者一 · 医学博士候选人\n查看问题 + 上下文\n+ 长答案\n无需推理标注",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "annotator_two",
      "label": "标注者二 · 医学博士候选人\n仅查看问题 + 上下文\n长答案不可见\n需要推理标注",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "agreement_gate",
      "label": "比较两份标签\n标签一致时直接作为\n最终标准答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "discussion",
      "label": "标签不一致时\n两位标注者讨论\n寻求统一标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "removed_item",
      "label": "移除候选样本\n不可回答或\n讨论后仍无法一致",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "pqa_l",
      "label": "PQA-L\n1,000 条专家标注样本\n是 55.2% · 否 33.8%\n可能 11.0%",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "pqa_l_split",
      "label": "固定 PQA-L 划分\n随机 500 条用于\n十折交叉验证\n其余 500 条作为测试集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "eval_input",
      "label": "需要推理的测试\n输入问题 + 上下文\n推理时仍隐藏结论",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "predict",
      "label": "为每个测试 PMID\n预测一个标签\n是 · 否 · 可能",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metrics",
      "label": "PQA-L 测试报告\n准确率\n三标签宏平均 F1",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "pqa_u_filter",
      "label": "规则筛选 pre-PQA-U\n移除特殊疑问词问题\n与多实体选择问题\n可回答性判定与标注员 1\n一致率超过 93%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pqa_u",
      "label": "PQA-U\n61.2K 条未标注样本\n保留可由 是 · 否 · 可能\n回答的问题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "statement_gate",
      "label": "筛选陈述式标题\nNP-(VBP/VBZ) 词性结构\n结构化摘要包含\n明确结论段",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "artificial_convert",
      "label": "启发式 PQA-A 转换\n移动或补充系词/助动词\n改写为问题\n按动词否定状态定标签",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pqa_a",
      "label": "PQA-A\n211.3K 条自动构造样本\n是 92.8% · 否 7.2%\n不包含 可能 标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "pqa_a_split",
      "label": "PQA-A 划分\n随机 200K 条训练\n其余 11.3K 条验证",
      "type": "database",
      "size": "xl"
    },
    {
