      "type": "database",
      "size": "xl"
    },
    {
      "id": "statement_titles",
      "label": "陈述句标题文章\nNP-(VBP/VBZ) 句法模式\n必须有结构化结论",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "artificial_convert",
