      "type": "database",
      "size": "xl"
    },
    {
      "id": "answerable_filter",
      "label": "PQA-U 规则筛选\n排除疑问词和多实体选择题\n可答性一致率超过 93%",
      "type": "process",
      "size": "xl"
    },
    {
