  "nodes": [
    {
      "id": "source_evidence",
      "label": "固定官方证据\narXiv 2212.10511v4 · PDF 6de64bcf9b19\nGit 8172ab04794a · HF 098765c79ea1\n同一 TSV · SHA 9a5227f41bff",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "factual_scope",
      "label": "定义开放域事实问答\n事实表示为主语 · 关系 · 宾语\n提出实体中心问题\n不提供标准证据段落",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "relations",
      "label": "选择 16 种 Wikidata 关系\n职业 · 出生地 · 类型 · 父亲\n国家 · 制片人 · 导演 · 作为首都\n编剧 · 作曲家 · 颜色 · 宗教\n运动 · 作者 · 母亲 · 首都",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "weighted_sampling",
      "label": "向高流行度加权抽样\n仅当 \\(f > \\exp(8R - 6)\\) 时保留\nR 在 (0,1) 上均匀分布\nf 为精确匹配词频\n来自 800 MB C4 样本中的主语别名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "relation_cap",
      "label": "限制每种关系规模\n每种关系达到 2,000 条即停止\n提高关系类型多样性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "template_authoring",
      "label": "作者人工标注模板\n每种关系一个最终自然语言模板\n附录表 2 列出全部 16 个模板",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "question_instantiation",
      "label": "实例化每个问题\n将主语 S 代入占位符\n使用关系 R 对应模板\n生成自然语言问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_closure",
      "label": "构造可接受答案闭包\n纳入每个实体 E\n满足 Wikidata 中存在 (S, R, E)\n将所有这类实体作为金标答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pageviews",
      "label": "附加流行度\n查询维基百科月度访问量\n以主语流行度作为代理量\n按主语流行度分析记忆表现",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fixed_release",
      "label": "封装固定发布\n14,267 行 · 17 列\nGit TSV 与 HF test.tsv 相同\nID · 别名 · URI · 维基标题\n问题 · 流行度 · 可接受答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_config",
      "label": "使用论文提示词\n原文：Q: &lt;question&gt; A:\nGPT-3 使用零样本\nGPT-Neo 与 OPT 使用 15 样本\n从其余 15 种关系各取一例",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "memory_gate",
      "label": "选择记忆模式\n原始参数记忆\nBM25 · Contriever · GenRead\n使用相同问题做对比",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "vanilla",
      "label": "使用参数记忆\n使用已配置的零样本或 15 样本提示\n不加入检索或生成上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "retrieval",
      "label": "使用增强上下文\nBM25：保留完整首段检索文本\nContriever：按“. ”切分并丢弃末段\nGenRead：维基百科背景 · 最多 150 token\n随后追加问答提示",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "生成自由文本答案\nrunner 最多生成 15 个新 token\nGPT-3 温度 0 · top-p 1\n本地模型使用贪心解码\n仅保留输出首行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "code_scorer",
      "label": "应用固定 runner 评分器\n读取 possible_answers\n检查原样 · 小写 · 首字母大写金标\n在预测子串中查找金标\n不做通用归一化",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告 PopQA 结果\n平均准确率 · 各关系准确率\n关联二元正确性\n与主语流行度对数",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "adaptive_split",
      "label": "运行自适应检索协议\n75% 用于阈值开发\n25% 用于评测\n重复 100 次随机划分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "threshold",
      "label": "学习各关系阈值\n穷举流行度阈值\n最大化自适应准确率\n仅使用开发集预测",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "adaptive_gate",
      "label": "应用各关系阈值策略\n低于阈值时使用检索增强预测\n否则使用参数记忆预测",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "adaptive_report",
      "label": "报告自适应准确率\n对 100 次划分取平均\n比较准确率与检索占比\n保留各关系独立阈值",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "发布与运行数量边界\n固定 TSV 与图 4：14,267\n附录 B 称 GPT-3 运行 14,282 题\n15 题差异尚未解释\n不得把运行快照等同于固定 TSV",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "prompt_boundary",
      "label": "调用漂移\n论文 GPT-3：零样本 · runner：15 样本\nREADME 遗漏 --n_examples 0\nContriever README：--ret_file\nrunner：--ret_path",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "scorer_boundary",
      "label": "论文与 runner 评分边界\n论文：金标精确子串\nrunner 检查三种金标大小写\n不将整段预测转为小写\n无 token 或别名归一化器",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "adaptive_boundary",
      "label": "自适应结果边界\nnotebook 输入路径为空\n未提供固定结果文件\n阈值逻辑可复现\n此处不重算论文数值",
      "type": "document",
      "size": "xl"
    }
  ],
