  "nodes": [
    {
      "id": "step_1",
      "label": "定义流行度敏感问答\n探测事实参数记忆\n同时包含热门与长尾实体\n使用开放域问题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "选择16种Wikidata关系\n覆盖人物 · 地点 · 作品\n包含一对一与一对多关系\n保留可解释关系类型",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "随机抽取知识三元组\n抽取主语关系宾语事实\n覆盖广泛流行度\n保留Wikidata标识符",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "为每种关系编写模板\n人工表达关系含义\n使用自然问题形式\n同类问题保持措辞一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "实例化自然问题\n用三元组主语替换占位符\n保持关系语义\n生成开放域问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "收集全部可接受宾语\n查找所有满足S-R-E的实体E\n支持多答案关系\n避免单一宾语答案捷径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "扩展答案与实体元数据\n添加主语与宾语别名\n保存ID · URI · 维基标题\n保留关系类型",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "附加流行度信号\n查询维基百科月度访问量\n记录主语流行度\n记录宾语流行度元数据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "发布14,267条问题\n保留问题与答案别名\n保留关系和实体元数据\n保留流行度用于分析",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "运行开放域问答\n不提供支撑段落\n使用零样本或少样本提示\n生成自由文本答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "比较记忆模式\n评测模型原始参数记忆\n添加BM25或Contriever检索\n添加GenRead或自适应检索",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "规范模型预测\n保留用于匹配的答案文本\n对照全部标准别名\n允许任一有效关系宾语",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "应用精确子串正确性\n精确匹配任一标准答案\n允许答案出现在预测子串中\n每题记为正确或错误",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "按流行度报告准确率\n总体及各关系Accuracy\n与页面访问量对数做相关\n比较不同检索策略",
      "type": "terminal",
      "size": "xl"
    }
  ],
