  "nodes": [
    {
      "id": "step_1",
      "label": "固定科学预测时间线\n预测截止点之后的科研进展\n排除截止点之后的证据\n保留完整时间元数据",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "筛选arXiv元数据快照\n2023年10月至2025年10月\n七个AI相关类别\n保留带日期的目标论文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "映射并去重目标论文\narXiv ID映射为S2 Corpus ID\n删除未解析或重复记录\n按发表日期排序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "关联关键前期工作\n获取S2 influential引用\n只保留目标论文之前的文献\n每篇目标最多十篇关键参考",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "扩展作者发表历史\n获取目标论文作者\n加入目标之前的作者论文\n加入历史论文使用的参考文献",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "使用S2AND消歧作者\n合并记录形成作者身份\n剪除无效姓名聚类\n缺失作者保留为单例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "时间对齐引用元数据\n仅统计目标发表前引用\n按截止时间计算作者h-index\n构建逐月引用轨迹",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "冻结文本与论文角色\n从快照恢复标题和摘要\n标注目标参考与历史角色\n形成结构化学术图谱",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "发布时间切分\n训练：2023年10月至2024年10月\n测试：2024年10月至2025年10月\n9.8万目标 · 共50.2万论文",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "预测合作者\n种子作者预测其余作者\n仅使用既往发表历史\nnDCG与R-Precision评分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "选择前期工作\n由论文作者预测关键参考\n排序当时可用候选文献\nnDCG与R-Precision评分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "生成科研贡献\n作者加关键参考生成标题与摘要\n对照未来真实目标论文\nLACERScore · ROUGE-L · BERTScore",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "预测科学影响\n目标文本上下文与计量特征\n预测12个月累计引用\nMAE · Pearson · Spearman",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "组合12个月模拟\n按天生成合成论文\n将合成历史传入后续轮次\n与人类论文比较新颖性与多样性",
      "type": "terminal",
      "size": "xl"
    }
  ],
