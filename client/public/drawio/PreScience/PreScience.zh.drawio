<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2080" pageHeight="816" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定论文与官方证据&#xa;arXiv 2602.20459v2&#xa;PDF b0d435e3f4c1 · Git 47384ed79c48&#xa;HF a6cbe3237468 · 各版本分别固定" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-16" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义持续更新的科学预测数据集&#xa;观察论文、作者、引用与主题&#xa;仅使用t_p之前的历史&#xa;预测各截止点之后的科研贡献" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="固定目标论文时间窗&#xa;2023年10月至2025年9月&#xa;六个AI类别 · 不含cs.ML&#xa;训练44,984 · 测试52,836 · 共97,820" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="扩展历史伴随论文图谱&#xa;加入每篇目标的关键参考文献&#xa;加入作者发表历史及其参考文献&#xa;并集包含501,866篇不同论文" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="筛选目标参考文献集合&#xa;保留1至10篇关键参考文献&#xa;排除零篇与异常大的集合&#xa;要求论文记录可追溯至arXiv" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="解析作者身份&#xa;使用Semantic Scholar图谱元数据&#xa;应用S2AND作者消歧&#xa;人工检查优于当时S2AG结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="对齐时序元数据&#xa;发表数 · 引用数 · h指数&#xa;每个字段锚定论文发表日期&#xa;仅暴露t_p之前的历史" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="创建并验证202项主题分类&#xa;gpt-5.4-2026-03-05标注全部目标&#xa;Claude Opus 4.7复标530篇&#xa;跨标注F1为0.67 · 另做GRIT验证" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="固定论文v2描述的数据状态&#xa;训练44,984 · 测试52,836&#xa;目标97,820 · 全部501,866篇&#xa;主题 · 作者 · 参考 · 引用轨迹" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="7项科研预测任务&#xa;5项论文 + 2项主题" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=10;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="生成未来科研贡献&#xa;输入关键参考文献与t_p前历史&#xa;预测标题与摘要&#xa;LACER · ROUGE-L · BERTScore" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="执行三项排序任务&#xa;合作者 · 前期工作 · 未来组合&#xa;以第一作者或作者团队为条件&#xa;nDCG@1000 · R-Precision" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="预测12个月累计引用&#xa;作者 · 参考 · 文本 · t_p前历史&#xa;同时评测原始与对数引用空间&#xa;MAE · R2 · Pearson · Spearman" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="202个单主题 · 4,334个主题对&#xa;预测其份额变化&#xa;主题对须在任一切分至少有10篇&#xa;R2 · Pearson相关系数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1280" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="汇总论文v2各任务指标&#xa;LACER采用1至10语义量表&#xa;排序仅使用截止点可见候选&#xa;分任务报告而不虚构单一总分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="组合12个月语料模拟&#xa;从2024年10月1日的历史开始&#xa;按日抽取论文数与团队规模&#xa;预测合作者与参考文献&#xa;将生成论文回写语料" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="评测合成语料动态&#xa;每月抽100篇论文&#xa;检索10个GRIT近邻&#xa;重复六次模拟&#xa;LACER多样性 · LACER新颖性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="分别报告各类结果&#xa;各任务指标保持独立&#xa;合成论文的多样性更低&#xa;相对演化语料的新颖性下降" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="公开重建边界&#xa;发布数据使用内部Semantic Scholar API&#xa;公开脚本仅在意图上等价&#xa;结果可能变化 · 不保证字节一致" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="192" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="论文v2与HF发布差异&#xa;论文v2：六类 · 97,820个目标&#xa;HF：七类 · 97,826个目标&#xa;固定HF版本没有主题字段" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1800" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="论文v2与固定代码差异&#xa;论文v2定义七项任务&#xa;固定仓库只提供四个任务目录&#xa;没有未来组合或主题趋势运行器" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1544" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="LACER实现边界&#xa;默认评审为gpt-5-2025-08-07&#xa;解析器读取Score后的数值&#xa;API生成默认参数未固定" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1024" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="许可证与榜单边界&#xa;Git代码：Apache 2.0&#xa;HF数据：ODC-BY 1.0&#xa;未找到官方排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x=