      "type": "database",
      "size": "xl"
    },
    {
      "id": "workflow_curation",
      "label": "业务查询与工作流整理\n1,021 条复杂 SQL 与 157 个 dbt 工作流\n源自生产环境真实数据分析与数据转换管道",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "schema_assembly",
      "label": "企业超大上下文装配\n涵盖超过 1,000 列的庞大企业数据表模式\n附带业务数据字典、字段文档与方言指南",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold_authoring",
      "label": "金标查询与自动化脚本编写\n每条目标查询平均达 144 词元复杂长度\n深度涉及多表关联、公共表达式与窗口函数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "qc_execution_gate",
      "label": "多轮执行质检决策门\n能否在对应数据库沙箱中确定性执行？\n历经至少3轮交叉核验与专业红队对抗测试",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_flawed",
      "label": "淘汰缺陷与非确定性样本\n剔除结果不稳定、死锁超时或表结构损坏查询\n确保金标基准答案具有 100% 可复现性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "Spider 2.0 冻结企业级基准集\n包含 632 个真实企业级工作流评测任务\n547 道核心 SQL 题 + 85 个复杂 dbt 任务",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "企业级提示与环境装配\n业务任务意图 + 数据库 Schema + 方言约束\n注入方言开发手册与特定引擎运行环境元数据",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "agent_inference",
      "label": "智能体环境推理与代码生成\n支持多轮 ReAct 交互推理或直接代码生成\n生成兼容目标引擎方言的高效可执行 SQL",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sandbox_execution",
      "label": "真实数据库安全沙箱执行\n在云端数仓 (BigQuery/Snowflake) 或本地引擎执行\n在严格查询超时保护下提取查询结果数据表",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "result_comparison_gate",
      "label": "执行结果表等价性判定门\n输出表格数据与金标执行结果完全一致？\n执行行序无关元组比对与浮点数值容差检验",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "success_sink",
      "label": "执行完全正确归档\n将当前任务标记为成功解决 (Resolved)\n表结构与数据值 100% 精确匹配",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "failure_sink",
      "label": "执行异常与错误归因\n诊断语法错误、沙箱超时或查询值不匹配\n记录失败分类并导出完整执行轨迹日志",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "官方基准评测指标报告\n报告执行准确率 (EX) 与任务成功率 (SR)\n按 Lite (547 题) 与 Full Agentic (632 题) 分项统计",
      "type": "terminal",
      "size": "xl"
    }
