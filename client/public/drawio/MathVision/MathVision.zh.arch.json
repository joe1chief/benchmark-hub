      "size": "xl"
    },
    {
      "id": "alignment",
      "label": "图文是否可用？\n十名高年级理科生\n标注结果交叉核验",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "repair_image",
      "label": "从原文件重新截取图像\n修复不完整或错位\n再次检查图文对齐",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "stage1_keep",
      "label": "保留质检合格样本\n移除缺文或错图题\n移除隐私或冒犯内容\n剩余 3,352 道题",
