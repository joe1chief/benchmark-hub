  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2128" pageHeight="1136" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Fixed evidence boundary&#xa;arXiv:2603.04857v1&#xa;FireBench repo @ dad399d&#xa;paper composition shown below" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Define six production capabilities&#xa;format · ordered responses&#xa;item ranking · overconfidence&#xa;positive / negative requirements" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Output format · Table 1: 1,300&#xa;QA: 25 × 4 sources × 21 constraints&#xa;paper reports 1,000 QA instances&#xa;MHPP: 100 problems&#xa;JSON / XML / Markdown = 300" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Ordered responses · 200 trials&#xa;dual-role support sessions&#xa;sample 10–15 fields from ~70&#xa;one question per turn&#xa;5–10 vetted values per field" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Item ranking · 200 trials&#xa;20 realistic tables&#xa;random sort attributes&#xa;ascending / descending&#xa;return all or top-N rows verbatim" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Overconfidence · 370 samples&#xa;300 GPQA/HLE/SimpleQA paired trials&#xa;normal + uncertainty-aware inference&#xa;~70 unanswerable long documents" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Positive content · 200&#xa;manually selected prompts from&#xa;Arena Hard Auto 2.0&#xa;GPT-5 creates mandatory requirements&#xa;and verification rubrics" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Negative content · 200&#xa;the same Arena Hard Auto 2.0 prompts&#xa;GPT-5 creates prohibited constraints&#xa;and verification rubrics" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Assemble the paper benchmark&#xa;Table 1 total: 2,470&#xa;1,300 / 200 / 200 / 370 / 200 / 200&#xa;six independent capability pools" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="904" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Select category-specific grading&#xa;one binary result per sample" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Programmatic grading&#xa;format parser / regex&#xa;structured output&#xa;ordered values against ground truth&#xa;ranking rows exactly after sorting" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Overconfidence rule&#xa;correct answer ↔ do not decline&#xa;wrong answer ↔ explicitly decline&#xa;insufficient document ↔ refusal only" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Content-requirement judge&#xa;GPT-4.1 checks GPT-5 rubrics&#xa;positive: every required element&#xa;negative: every forbidden element" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Report paper results&#xa;accuracy for six categories&#xa;overall = unweighted mean&#xa;of the six accuracies&#xa;compare 11 closed/open-weight&#xa;models" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1848" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Public harness @ dad399d&#xa;QA: 12/source; 48 × 21 = 1,008&#xa;main.py averages seven test-set scores&#xa;content path invokes tested model&#xa;not judge_model" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1848" y="800" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=