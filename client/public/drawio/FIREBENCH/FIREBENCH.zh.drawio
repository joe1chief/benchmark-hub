  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2128" pageHeight="1136" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据边界&#xa;arXiv:2603.04857v1&#xa;FireBench 仓库 @ dad399d&#xa;下方展示论文组成" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义六类生产能力&#xa;格式 · 顺序回复 · 条目排序&#xa;过度自信 · 正向内容要求&#xa;负向内容要求" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="输出格式 · Table 1：1,300&#xa;问答：4 个来源各 25 题 × 21 种约束&#xa;但论文仍报告 1,000 条问答实例&#xa;MHPP：100 × JSON/XML/Markdown = 300" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="-48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="顺序回复 · 200 次试验&#xa;双角色客服会话&#xa;从约 70 字段采样 10–15 个&#xa;每轮一问；每字段 5–10 个核验值" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="条目排序 · 200 次试验&#xa;20 张真实感表格&#xa;随机排序字段与升序/降序&#xa;原样返回全部或 Top-N 行" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="过度自信 · 370 条&#xa;300 道 GPQA/HLE/SimpleQA 成对试验&#xa;标准 + 不确定性感知推理&#xa;约 70 篇长文档不可答" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="正向内容要求 · 200&#xa;人工选择 Arena Hard Auto 2.0 提示&#xa;GPT-5 生成必须包含的要求&#xa;及核验准则" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="负向内容要求 · 200&#xa;使用同一批 Arena Hard Auto 2.0 提示&#xa;GPT-5 生成禁止约束&#xa;及核验准则" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="组装论文基准&#xa;Table 1 总数：2,470&#xa;1,300 / 200 / 200 / 370 / 200 / 200&#xa;六个独立能力池" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="904" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="选择分类评分方式&#xa;每条样本得到一个二值结果" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="程序化评分&#xa;格式解析 / 正则 / 结构化输出&#xa;顺序值对照真值&#xa;排序后精确匹配行" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="过度自信规则&#xa;答对 ↔ 不拒答&#xa;答错 ↔ 明确拒答&#xa;文档信息不足 ↔ 只能拒答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="内容要求评委&#xa;GPT-4.1 检查 GPT-5 生成的准则&#xa;正向：全部必需元素均出现&#xa;负向：全部禁止元素均避开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1504" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="报告论文结果&#xa;计算六类准确率&#xa;总分 = 六类准确率&#xa;的无权平均&#xa;比较 11 个闭源 / 开放权重&#xa;模型" style="rounded=1;arcSize=50;h