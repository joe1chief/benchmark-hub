      "label": "整理权威 CTI 知识\nMITRE ATT&CK • CWE • CAPEC • CISA\nSTIX/TAXII • GDPR 与行业标准",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "cve_sources",
      "label": "接入实时漏洞数据\nNVD API • CVE 描述\nCVSS 指标与 CWE 标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "threat_sources",
      "label": "收集威胁与防御证据\nAPT 厂商报告 • 安全博客\nMITRE STIX 技术与缓解措施",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "ckt",
      "label": "构建 CTI Knowledge Test\nGPT-5 生成五选一问题\n双模型标记 + 人工修正",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rcm_vsp",
      "label": "构建 RCM 与 VSP\n映射根因 CWE 并预测 CVSS\n去重并过滤过短记录",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taa_rms_ate",
      "label": "构建 TAA、RMS 与 ATE\n匿名化攻击者 • 关联缓解措施\n将技术描述改写为场景",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "full_benchmark",
      "label": "汇总完整 AthenaBench\n六类 CTI 任务共 8,100 条\n删除重复与答案泄露线索",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "sampling_policy",
      "label": "应用任务特定采样比例\nCKT/RCM/VSP 取 10% • ATE/RMS 取 20%\nTAA 取 50%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "candidate_subsets",
      "label": "生成候选 Mini 子集\n使用十个随机种子\n评估模型总体表现",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "representative_selection",
      "label": "选择代表性随机种子\n总体表现与完整基准\n最接近的候选子集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "mini_release",
      "label": "发布 AthenaBench-Mini\nCKT 300 • ATE 100 • RCM 200\nRMS 100 • VSP 200 • TAA 50",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model_eval",
      "label": "评测 12 个 LLM\n闭源与开源模型\n支持时统一温度为 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "categorical_metrics",
      "label": "评分离散答案任务\nCKT、ATE、RCM、TAA 使用准确率\n按任务标准答案精确判断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rms_metric",
      "label": "评分风险缓解任务\nRMS 使用多标签 F1\n允许多个有效缓解策略",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "vsp_metric",
      "label": "评分漏洞严重性\n解析 CVSS 并计算 MAD\n标准化准确率为 1 - MAD / 7.7",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "combined",
      "label": "汇总六类任务分数\n统一为百分比量纲\n比较完整集与 Mini 排名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "汇报 AthenaBench-Mini 结果\n六项任务指标 + Combined Score\n诊断 CTI 推理能力缺口",
      "type": "terminal",
      "size": "xl"
    }
  ],
