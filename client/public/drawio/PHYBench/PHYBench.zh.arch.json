  "nodes": [
    {
      "id": "step_1",
      "label": "定义原创物理任务\n答案为单一符号表达式\n不接受数值近似\n以原创内容抵抗污染",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "招募178名北大学生\n物理专业学生编写与整理\n题目完全由人工创作\n不使用自动出题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "形成757题初始池\n原创或大幅改编\n选取难以搜索的习题\n参考非公开及公开材料",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "覆盖广泛物理范围\n力学 · 电磁学\n热学 · 光学\n近代与高等物理",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "执行题目硬性要求\n自包含且无歧义\n定义所有变量\n仅有一个可核验表达式",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "提交内部题库\n保存题面与参考公式\n跟踪审稿意见\n不合格草稿退回修改",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "进行多轮专家审查\n检查物理正确性\n检查措辞与可解性\n修改或淘汰缺陷题目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "仅把LLM输出用于复核\n查看o1与DeepSeek-R1答案\n暴露歧义或误读\n绝不生成题目或标准答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "由81名学生验证\n独立求解分配的题目\n含50名物理奥赛金牌\n建立高水平人类基线",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "处理验证标记\n检查清晰度与解的唯一性\n解决答案分歧\n移除不可靠题目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "形成PHYBench\n500道原创题\n难度从高中至本科\n最高达物理奥赛水平",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "运行统一零样本提示\n要求逐步推理\n输出符号LaTeX答案\n以方框表达式结尾",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "比较符号表达式\n用SymPy与latex2sympy解析\n构建表达式树\n采用Zhang-Shasha编辑距离",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "报告准确率与EED\n等价公式判为正确\nr=0时得100\n0<r<0.6时得60-100r · 否则得0",
      "type": "terminal",
      "size": "xl"
    }
  ],
