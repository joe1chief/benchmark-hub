    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2528" pageHeight="1496" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定主要证据&#xa;arXiv 2410.19168v1 · 2024-10-24&#xa;HF bd099996 · 2025-03-17&#xa;仓库 110127f · HF Space 70339a4&#xa;核验于 2026-07-21" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="步骤一 · 来源选择&#xa;列出 13 项 · 12 个真实语料 + 合成音频&#xa;优先真实录音&#xa;表 6 最终来源计数合计 10,000" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="232" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="论文表 6 · 来源 A&#xa;AudioSet 2,788 · Strong 391&#xa;MUStARD 405 · MELD 540&#xa;VoxCeleb-1 633 · IEMOCAP 515" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="232" y="16" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="论文表 6 · 来源 B&#xa;MusicBench 1,937 · Jamendo 32&#xa;SDD 277 · MusicCaps 514&#xa;GuitarSet 506 · MUSDB18 68 · 合成 1,394" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="520" y="16" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="步骤二 · 任务策展&#xa;从 90 个候选任务开始&#xa;咨询领域专家&#xa;保留 27 个现实可行任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="520" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="步骤三 · 专家标注&#xa;专家与作者迭代选择合适片段&#xa;完整收听 · 单个有效音频 · 英文多选&#xa;编写问题与标准答案&#xa;标记任务 / 难度 / 来源数据集&#xa;要求复杂推理 / 领域知识" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="808" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="步骤四 · 专家过滤&#xa;主文 §3.2 称使用独立团队&#xa;去除歧义 / 过度复杂 / 劣质音频问答&#xa;从约 11,000 对中去除约 800 对" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1096" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="保留质控人员口径冲突&#xa;主文 §3.2 · 独立过滤团队&#xa;附录 C · 标注与过滤为同一组&#xa;两组各 3 人 · 每领域各 1 人&#xa;标注 / 过滤组完整检查两遍" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1096" y="16" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="步骤五 · 选项增强&#xa;GPT-4 生成上下文相关干扰项&#xa;主文称基于音频与问题上下文&#xa;提升多选题难度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;