  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\narXiv 2602.00933v3 · 2026-05-19\nPDF SHA-256 2cd00f60…\nGit b6edd44 · HF b5bcde2",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "ecosystem",
      "label": "选择服务器生态\n36 个生产级 MCP 服务器\n全部任务共使用 220 个工具\n五个领域 · 不使用合成模拟桩",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "author",
      "label": "专家编写 1,000 个任务\n每题平均投入 4.6 个专家工时\n工具依赖 · 稳定 · 无歧义\n自然的单轮英文提示",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "tool_env",
      "label": "配置每题工具环境\n暴露 6–37 个工具 · 均值 15.2\n必需 2–8 个 · 均值 4.1\n可信干扰项 · 均值 11.1\n隐去服务器、工具和参数名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "trajectory",
      "label": "执行参考轨迹\n最小充分证据路径\n论文称平均 9.8 步\n验证可解性与工具依赖\n从不作为通过判定目标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "claims",
      "label": "编写有依据的声明评分标准\n原子且可独立核验的事实\n全量均值 4.7 条 · 范围 1–23 条\n每条声明均基于工具输出\n其他有效轨迹同样可得分",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "qa",
      "label": "执行五层质量检查\n1 专家执行 · 2 领域复审\n3 泄露复审 · 4 LLM 自动核验\n5 随机样本人工审计",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "split",
      "label": "随机拆分 1,000 个任务\n公开 500 题：支持复现\n私有 500 题：监控暴露\n留出集维护榜单完整性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "public_release",
      "label": "固定公开数据资产\nHF b5bcde2 · 500 行 Parquet\nTASK · ENABLED_TOOLS · PROMPT\nGTFA_CLAIMS · TRAJECTORY\nCC BY 4.0 · 不含私有题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "public_stats",
      "label": "公开 Parquet 实测\n暴露 7–37 个工具 · 均值 15.20\n调用 2–8 种工具 · 均值 4.11\n3–17 次工具调用 · 均值 4.85\n1–23 条声明 · 均值 3.90",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "card_drift",
      "label": "HF 卡片与 Parquet 不一致\n卡片称 10–25 个工具 · 3–6 次调用\n六行超出 10–25 范围\n五十行超过六次调用\n计数应以 Parquet 为准",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "schema_gap",
      "label": "公开数据结构审计\n五行 ENABLED_TOOLS 使用对象\n其余行使用工具名字符串\n一行 GTFA_CLAIMS 列表格式损坏\n依赖关系没有独立字段",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "repo_release",
      "label": "审计公开 Harness\nGit b6edd44 · TypeScript v2\n镜像仓库快照：1.2.7 @ sha256:24e6ed…\nrun_eval 传标签 · run_all 用本地 latest\n沙盒 URL 不校验镜像摘要",
      "type": "service",
      "size": "xl"
    },
    {
      "id": "release_gap",
      "label": "论文与公开 Harness 边界\n论文：Apache-2.0 · 仓库：MIT\n论文：每题最多重试五次\n外层 LLM 调用：3 次尝试 · 最多重试 2 次\nLiteLLM 401/429：最多重试 5 次",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "isolation_gap",
      "label": "环境隔离边界\n第 3.1 节：每轮评测间重启\n附录：每题之间重启\n公开 v2：共享沙盒且未重置\n实时 API 仍会产生上游漂移",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "eval_input",
      "label": "选择公开或私有任务\n单轮提示 + 暴露工具集\n目标工具与干扰工具混合\n论文完整评测使用全部 1,000 题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "matched",
      "label": "固定任务级评测条件\n相同提示 · 工具 · 100 次调用预算\n相同评分标准 · 最终答案协议\n仅底层适配器随提供方变化\n不使用模型专属脚手架",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agent_loop",
      "label": "运行工具型智能体\n发现工具 · 调用实时端点\n消费结果或错误并继续\n达到上限时仍评分部分响应\n最终输出一份文本答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "primary_judge",
      "label": "主声明评判器\nGemini 3.1 Pro Preview\n每条声明独立调用一次\n仅输入声明与最终答案\n满足 1 · 部分满足 0.5 · 未满足 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "coverage",
      "label": "计算仅基于答案的覆盖率\n独立声明得分取均值\n参考轨迹不参与评分\n覆盖率 ≥ 0.75 才通过",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "汇总 1,000 个任务\n通过率为任务通过值均值\n执行 10,000 次 Bootstrap 重采样\n95% CI 取 2.5 与 97.5 百分位",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_report",
      "label": "论文 v3 汇报边界\n20 个模型 · 六个提供方\n主评判器定义主要结果\n最佳 Pass@0.75 = 82.2%",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "judge_sensitivity",
      "label": "跨评判器仅做敏感性分析\nGPT-5.4 + Claude Opus 4.6\n对每个任务独立重新评分\n报告 2.1–4.6 个百分点范围\n不取平均生成主结果",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "diagnostics",
      "label": "只诊断未通过任务\n覆盖率 < 0.75 · 仅事后分析\n4 类工具调用 + 7 类认知故障\n从不改变通过判定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "live_boundary",
      "label": "动态榜单边界\n四月：Gemini 2.5 + 原始提示\n瞬态错误重试 + 100 次调用\nv3：Gemini 3.1 · 仅声明与答案\n当前榜单行已超出论文范围",
      "type": "document",
      "size": "xl"
    }
  ],
