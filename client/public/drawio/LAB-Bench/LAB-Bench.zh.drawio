    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2448" pageHeight="864" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="一手证据与固定版本&#xa;arXiv:2407.10362v3&#xa;官方 Git 998a8e0&#xa;官方 HF 5c77cec&#xa;最新可核验论文为预印本 v3" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-72" y="-24" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义实用生物研究能力&#xa;8 个大类 · 30 个子任务&#xa;程序生成 + 人工构建&#xa;统一多项选择题结构" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="208" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="程序生成 SeqQA + DbQA&#xa;SeqQA · 15 子任务 · 750 题&#xa;DbQA · 10 子任务 · 650 题&#xa;固定版本来源 / 脚本推导标准答案&#xa;确定性近错干扰项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="488" y="-24" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="文献 + 补充材料来源&#xa;LitQA2 · 248 · 近期正文推理&#xa;GPT-3.5 / GPT-4 检查难度与干扰项&#xa;仅 LitQA2 新作者首批 5–10 题校准&#xa;SuppQA · 102 · PDF/文本 · 排除 Excel" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="488" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="图像 + 表格来源&#xa;FigQA · 226 · 截图 / LabelBox&#xa;仅图像 / 无图注正文 · GPT-4 Turbo 草稿&#xa;TableQA · 305 · 表格图查找 + 推理运算&#xa;TableQA 用 GPT-4o 种子 · 专家决定" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="488" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="实验方案故障排除&#xa;ProtocolQA · 135 题&#xa;protocols.io + STAR Protocols&#xa;专家 1 注入明确错误&#xa;专家 2 核验并编写选择题" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="488" y="504" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="真实克隆工作流&#xa;CloningScenarios · 41 题&#xa;质粒 · 片段 · 酶 · 实验方法&#xa;复杂长上下文&#xa;场景可关联 · 每题独立可答" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="488" y="680" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="审核人工任务草稿&#xa;生物学博士 / 顶尖博士项目学生&#xa;Airtable 提交 · 修订 · 拒绝 · 批准&#xa;合并前由作者持续复核&#xa;模型建议从不自动采纳" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="768" y="416" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="论文完整数据集 · 2,457&#xa;8 个大类 · 30 个子任务&#xa;问题 · 标准答案 · 干扰项&#xa;Canary ID · lab-bench:5c41&#xa;完整 UUID 见固定公开资产" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1048" y="240" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="污染监测发布拆分&#xa;每个子任务约 80% 公开&#xa;公开 1,967 · 私留 490&#xa;私留题用于未来污染监测&#xa;公开 / 私留分析仅为补充结果" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1328" y="64" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="在完整集上运行论文模型基线&#xa;随机排列选项 + 信息不足选项&#xa;无工具 · 零样本思维链&#xa;要求在 [ANSWER] 标签中输出一个字母" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1328" y="328" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="抽样人类专家基线&#xa;博士级生物研究人员&#xa;可用网页 / 代码 / DNA 工具 · 禁用 AI&#xa;确定 / 不确定 · 总体覆盖 69%&#xa;不向答题者分配本人编写的问题" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1328" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="论文解析器 + 重复运行&#xa;先用正则提取 [ANSWER] 字母&#xa;正则失败时回退 Claude 2&#xa;运行 3 次 · 报告均值 ± 标准差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1608" y="328" width="200" hei