    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2744" pageHeight="632" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Michelangelo arXiv:2409.12640v2&#xa;eval_hub 提交 67b7fd2&#xa;contextarena.ai 核查于 2026-07-18" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="历史 OpenAI MRCR @ f4c69fa&#xa;2 / 4 / 8 needles；2025-12-05 修错&#xa;旧看板来源，非当前流程" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="构造长用户—助手对话&#xa;键 = 格式 + 主题 + 风格&#xa;不同回答与干扰项随机交错&#xa;最终查询要求第 i 个匹配回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="GDM MRCRv2 发布版&#xa;2 / 4 / 8 needles；文件扩至 8M tokens&#xa;要求唯一随机 12 字符前缀" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="当前看板：仅 Full 8-needle&#xa;8K 至 1M 共 8 个桶&#xa;每桶运行数非固定 100" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="每个模型独立运行&#xa;无两两对战；无 LLM 裁判&#xa;必须报告工具权限以便比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="是否找到要求的&#xa;12 字符哈希最后一次出现？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="哈希缺失&#xa;单题记 0 分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="保留最后一次哈希之后的内容&#xa;difflib.SequenceMatcher 对比目标&#xa;得分范围 [0, 1]" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="448" width="200" height="100" as="geometry"/></mxCell><mxC