<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1440" pageHeight="1496" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;ICLR PDF 3cd926feb851&#xa;Git c1bd4af7f635/c08d18bd45b1&#xa;评分器 9a1c23513926&#xa;任务规格 113bf4b60731" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="从AIOps挑战系列开始&#xa;使用真实故障记录与遥测&#xa;模式嘈杂且异构&#xa;包含指标日志和依赖追踪" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="选择合格系统&#xa;电信数据库系统&#xa;银行系统&#xa;在线市场系统" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="保留初始故障池&#xa;来自三个企业软件系统&#xa;共1,753条故障记录&#xa;具有关联遥测证据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="平衡数据集规模&#xa;下采样较大的系统&#xa;缓解最高百倍差异&#xa;保留412条记录" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="统一名称与模式&#xa;重组遥测格式&#xa;对齐跨系统标签&#xa;准备进入校准的记录" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="由三名工程师校准&#xa;检查每次故障附近遥测&#xa;验证时间组件与原因&#xa;使标签与可观察证据一致" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="过滤不可用故障&#xa;移除遥测缺失案例&#xa;移除无法识别根因案例&#xa;移除标签证据不一致案例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="形成OpenRCA数据集&#xa;三个系统共335个故障案例&#xa;68.5GB及523M行遥测&#xa;去标识化指标日志和追踪" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="定义七种根因目标&#xa;取时间组件原因的全部非空子集&#xa;简单一项中等两项困难三项&#xa;开放式结构化预测" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="采样查询规格&#xa;选择七种目标之一&#xa;加入系统及30分钟窗口&#xa;多故障时包含故障数量" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="合成自然语言查询&#xa;使用GPT-4等大模型&#xa;把规格转换为请求&#xa;保持所选根因目标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="人工核验查询与真值&#xa;把查询与遥测配对&#xa;附加评分点&#xa;每个故障发布一个目标驱动任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="提供查询与遥测&#xa;指定30分钟故障窗口&#xa;要求相应根因要素&#xa;采用类JSON结构化答案约定" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="评测方法&#xa;平衡抽样 Oracle RCA智能体" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="平衡抽样&#xa;全部遥测先降采样到一分钟&#xa;仅对各指标文件中的KPI类型&#xa;进行分层随机抽样&#xa;重复三次并报告中位数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="Oracle抽样&#xa;采用工程师识别的黄金指标&#xa;近似抽样方法上界&#xa;仍由大模型分析选中遥测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="运行RCA智能体&#xa;控制器规划遥测分析&#xa;执行器编写并运行Python&#xa;迭代分析指标追踪和日志" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="解析类JSON预测&#xa;要求包含被请求字段&#xa;允许出现额外字段&#xa;多故障采用排列匹配" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="920" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="评判被要求的要素&#xa;组件和原因必须精确匹配&#xa;时间允许正负一分钟误差&#xa;实现还会记录部分得分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="应用论文严格准确率&#xa;所有被要求要素均匹配才正确&#xa;报告代码只统计得分等于1.0&#xa;任一缺失或错误都会判错" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="按难度和方法报告准确率&#xa;分为简单中等困难目标组&#xa;平均统计严格正确案例&#xa;论文最佳RCA智能体结果为11.34%" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="920" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="版本快照边界&#xa;论文固定为ICLR 2025官方资产&#xa;仓库HEAD固定为c1bd4af7f635&#xa;GitHub没有带标签的发布版本" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="数据访问边界&#xa;Git仓库中的dataset目录为空&#xa;68.5GB遥测通过Google Drive链接&#xa;本次未重新下载或复算行数" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="开放性与许可边界&#xa;仓库代码采用MIT许可&#xa;遥测来源采用CC BY-NC 4.0&#xa;论文称衍生物按相同条款分享" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="指标实现边界&#xa;评分器计算要素级部分比例&#xa;官方严格报告筛选得分等于1.0&#xa;部分诊断分须与主指标分开" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1160" y="1312" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="29" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="30" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0