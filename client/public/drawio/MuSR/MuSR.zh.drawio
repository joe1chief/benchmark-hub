  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="5400" pageHeight="1256" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据与任务约定&#xa;论文 · arXiv 2310.16049v2 · 第 3–5 节&#xa;附录 G.1/H.1/I · 仓库 b1f4d416&#xa;输入叙事 x + 问题 qi + 候选答案&#xa;通过多步推理预测 ai&#xa;测试时隐藏 F 与 T" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择领域模板&#xa;构建黄金事实 F&#xa;模板化问题与答案&#xa;添加多样性事实 G" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="谋杀谜案模板&#xa;两名嫌疑人&#xa;凶手 · 手段 + 动机 + 机会&#xa;无辜者 · 两项有罪事实&#xa;再加一项无关可疑事实&#xa;论文最大树深度 · 4" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="664" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="物体放置模板&#xa;三人 · 三次移动 · 两件物体&#xa;一件物体移动两次&#xa;非移动者以概率 0.33 观察&#xa;答案 · 最后观察到的位置&#xa;论文最大树深度 · 3" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="664" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="团队分配模板&#xa;三人 · 两项任务&#xa;技能与配对分值 · 0 / 1 / 2&#xa;优化技能 + 团队协作&#xa;最优方案至少领先次优 2 分&#xa;论文最大树深度 · 2" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="664" y="912" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="实例化结构化输入&#xa;F 决定每个黄金答案&#xa;G 来自人工列表或大模型&#xa;G 必须出现在叙事中&#xa;第一阶段输出 · 二元组 (F, G)" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="944" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="补全推理树 T&#xa;GPT-4 递归展开每个 fi&#xa;子节点共同蕴含父节点&#xa;以场景与 G 为条件&#xa;展开到领域目标深度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1184" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="此领域是否使用&#xa;推理树校验器？&#xa;谋杀 + 物体 · 使用&#xa;团队分配 · 不使用" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1424" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="校验每一步推导&#xa;强制满足预期结构&#xa;阻止关键词与推理捷径&#xa;拒绝空洞转换&#xa;使用领域专属校验器集合 V" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1680" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="推导样本是否有效？&#xa;记录当前推导的尝试次数" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1920" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="重试同一步推导&#xa;附加校验器反馈&#xa;让大模型重新采样&#xa;最多重试提示三次" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="无有效样本后剪枝&#xa;停止展开当前分支&#xa;当前推导变为叶节点&#xa;继续生成其余推理树" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="划分推理树叶节点&#xa;场景事实 S(T) 写入故事&#xa;常识事实 C(T) 保持隐含&#xa;叶节点通过推导支持 F" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2160" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="把 S(T) 实现为叙事 x&#xa;选择哪个领域专属路径？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2400" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="撰写谋杀谜案章节&#xa;按嫌疑人 / 答案选项拆分事实&#xa;GPT-4 撰写并校验章节&#xa;打乱后拼接嫌疑人章节&#xa;添加故事引入场景" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2680" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="撰写物体放置章节&#xa;开场 + 移动 + 观察片段&#xa;每次携带此前故事继续生成&#xa;检查事实并按需重写&#xa;拼接所有章节" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2680" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="单次生成团队故事&#xa;写入技能与关系事实&#xa;不分章节 · 不用树校验器&#xa;仅重写故事引言&#xa;不泄露最优分配方案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2680" y="1072" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="汇总官方发布数据&#xa;564 篇叙事 · 756 道问题&#xa;谋杀 · 250 篇 / 250 题&#xa;物体 · 64 篇 / 256 题&#xa;团队 · 250 篇 / 250 题" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2960" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="验证端到端可解性&#xa;规则基线 · 50.0 / 35.9 / 无&#xa;七名标注员 · 每题三人标注&#xa;谋杀 34 · 物体 40 · 团队 34&#xa;多数票 · 94.1 / 95.0 / 100.0" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3200" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="验证与公开发布边界&#xa;人工只检查答案可推导性&#xa;未正式评测流畅度 / 连贯性 / 常识合理性&#xa;仓库根许可证 MIT · JSON 无许可证字段&#xa;无发布标签 / 校验和 / 正式排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3200" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="选择论文评测路径&#xa;常规 · 思维链 · 增强思维链&#xa;单样本 / 三示例少样本增强思维链&#xa;主表 · 零样本增强思维链&#xa;提示方法还是领域专属？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=8;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3680" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="运行提示基线&#xa;常规 · 直接回答&#xa;思维链 · 分步推理&#xa;增强思维链 · 领域推理提示&#xa;提供一个 / 三个已解示例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3920" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="运行领域专属方法&#xa;谋杀 · 分解式提示&#xa;物体 · 符号心智理论&#xa;团队 · 程序辅助语言模型&#xa;不存在一个通用方法" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3920" y="848" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="为每个问题生成答案&#xa;论文模型使用各自默认参数&#xa;发布版 GPT-4 配置 · 温度 1&#xa;核采样概率 1 · 最多 2400 词元&#xa;可选自洽性投票" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4160" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="解析发布代码输出&#xa;取最后一个非空答案行&#xa;将文本转成小写&#xa;任意位置含黄金数字即判正确&#xa;否则取出现的首个选项数字" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4400" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="解析文本是否包含&#xa;任意有效选项数字？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4640" y="592" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="应用发布版解析回退&#xa;随机采样一个选项&#xa;全局随机种子为 0&#xa;按已解析答案参与计分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4880" y="928" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="计算准确率&#xa;多次采样时使用多数选项&#xa;正确问题数 / 问题总数&#xa;三个领域分别报告" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=ce