    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1904" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="操作化数据最小化原则&#xa;仅在与任务相关且必要时&#xa;使用潜在隐私数据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="120" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择 VisualWebArena 应用&#xa;Reddit • Shopping&#xa;GitLab&#xa;隔离且逼真的网页副本" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="定义敏感数据分类&#xa;六类潜在隐私事实&#xa;区分任务相关与无关数据" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="设计八类任务&#xa;Shopping 3 类 • GitLab 3 类&#xa;Reddit 2 类&#xa;要求向网页应用输入信息" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="人工编写 123 个数据种子&#xa;user_instruction + PLOT&#xa;SENSITI