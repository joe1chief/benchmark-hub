  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2824" pageHeight="608" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="证据边界：arXiv:2508.00828v1&#xa;finance-agent @ 82337852&#xa;公开集 SHA 901e8cff&#xa;论文协议 + 固定 2026 仓库审计" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="咨询 7 位金融行业从业者&#xa;定义 9 类真实分析师任务&#xa;从简单检索到困难市场分析" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="专家编写 537 道多文档问题&#xa;使用 2024 年起的开放网页 / SEC 来源&#xa;覆盖检索、推理、建模与分析" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="464" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="附上专家答案与必要来源&#xa;记录逐步求解轨迹&#xa;问题必须可由公开数据回答" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="720" y="128" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="异人专家检查每个样例&#xa;纠正或移除计算/内容错误&#xa;作者最后统