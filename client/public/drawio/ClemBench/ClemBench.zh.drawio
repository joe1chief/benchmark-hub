<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2920" pageHeight="576" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文时代证据边界&#xa;arXiv 2405.20859v1&#xa;官方仓库 ba687db&#xa;评测批次：2024 年 5 月" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="当前仓库 adff278&#xa;v3.0 游戏与 CLI&#xa;属后续发布；不等同 2024 论文" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="定义每个对话游戏&#xa;提示模板&#xa;回应解析规则&#xa;游戏流程 + 终止状态" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="为所有游戏创建新实例&#xa;从现有池采样&#xa;轻量人工选择目标&#xa;降低固定实例污染" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="实例化程序化 GameMaster&#xa;用实例填充模板&#xa;控制轮次与游戏规则&#xa;检测终止状态" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="运行 LLM 对 LLM 自博弈&#xa;逐轮提示双方角色&#xa;记录完整离线对局" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="检查形式完成情况&#xa;违反解析规则 = 未完成&#xa;统计完成游戏占比" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="评分游戏专属质量&#xa;每个游戏主指标 0–100&#xa;仅评分格式正确对局" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="计算 clemscore&#xa;先逐游戏汇总主指标&#xa;再跨游戏平均&#xa;完成率 × 质量分的乘积" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="建立人类专家基线&#xa;作者每游戏玩 10–15 局&#xa;排除自己创建的实例&#xa;略去两个 Wordle 变体" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="指称游戏多语言研究&#xa;母语者翻译提示&#xa;目标表达 + 解析规则&#xa;保持同一游戏逻辑" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="验证基准特性&#xa;跨批次排名相关 0.71&#xa;人类质量 86.93 • 完成率 100%&#xa;CA τ=0.65 • HELM τ=0.39" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="发布 2024 年 5 月结果&#xa;clemscore • 完成率 • 质量分&#xa;53 个模型 + 人类基线&#xa;多语言指称游戏分析" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;s