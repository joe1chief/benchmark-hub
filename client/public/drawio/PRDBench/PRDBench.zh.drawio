<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3320" pageHeight="1616" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2510.24358v3&#xa;PDF c9b6ac8d4e97&#xa;Git 050bbcbd1332&#xa;HF 9eaa70817b22" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="筛选真实项目种子&#xa;内部 AI 产品开发请求&#xa;公开 CS 课程结课项目&#xa;CS 学位论文复现任务" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="应用两条准入规则&#xa;可完全使用 Python 实现&#xa;所有关联数据均公开&#xa;保留真实场景多样性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="领域标注与采样&#xa;GPT-4 标注候选领域&#xa;保证稀有领域覆盖&#xa;选出 20 领域的 50 个任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="初始化标准化 PRD&#xa;使用 Claude Code 等代码智能体&#xa;写明需求与功能细节&#xa;数据要求与接口" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="生成指标大纲&#xa;GPT-4.1 使用 AAA 方法&#xa;Arrange 文件与环境&#xa;Act 后 Assert 预期结果" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="生成代码脚手架&#xa;SOTA 代码智能体设计模块&#xa;固定便于标注的接口&#xa;算法实现可暂不完全正确" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="扩展评测标准方案&#xa;细化每个评分点&#xa;增加测试接口与工件&#xa;命令及预期输出" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="人工测试检查&#xa;在脚手架上运行测试&#xa;检查接口兼容性&#xa;核对输出是否符合 PRD" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="智能体修复与细化&#xa;标注员提供定向反馈&#xa;修改脚手架或评测标准&#xa;再次执行人工检查" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="执行纳入门槛&#xa;至少完成五轮修订&#xa;所有检查问题均解决&#xa;否则继续循环" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="移除生成脚手架&#xa;保留 PRD 与评测标准方案&#xa;保留测试工件和数据&#xa;要求从零实现代码" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="完成论文口径 PRDBench&#xa;50 个 Python 项目·20 个领域&#xa;论文 v3 共 1,258 个指标&#xa;单测 408·交互 732·文件 118" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="第一轮：开发&#xa;读取 PRD 与详细测试计划&#xa;在 src 中实现完整项目&#xa;不提出中间问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="PRDJudge 逐指标评测&#xa;PRD + 详细测试计划&#xa;提交代码 + 测试工件&#xa;六种工具增强操作" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="选择披露的测试类型&#xa;原样执行测试命令&#xa;比较日志、状态或文件&#xa;形成指标证据" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="单元测试分支&#xa;运行给定 pytest 命令&#xa;检查接口与断言&#xa;论文 v3：408 个指标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="Shell 交互分支&#xa;回放模拟用户输入&#xa;比较实际与预期日志&#xa;论文 v3：732 个指标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="文件比较分支&#xa;执行文件生成命令&#xa;与参考结果比较&#xa;论文 v3：118 个指标" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="写入逐指标报告&#xa;2 通过·1 部分通过·0 失败&#xa;保留每项解释&#xa;保存 round1 或 round2 JSONL" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="第二轮：调试&#xa;读取第一轮扣分报告&#xa;针对失败标准修改代码&#xa;重跑同一 PRDJudge 流程" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="报告 DEV 与 DEBUG 分数&#xa;单项目为平均分除以 2&#xa;对有效项目求平均&#xa;比较调试增益" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="收集评判轨迹&#xa;Qwen3-Coder-480B-A3B 评判&#xa;来自 11 个代码智能体&#xa;每个智能体随机 8 个项目" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="建立人工真值&#xa;两名标注员独立评分&#xa;分歧交由资深标注员裁决&#xa;三级分数：0、1、2" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="按最终分数一致性过滤&#xa;初始 2,147 条轨迹&#xa;保留 1,742 条人工一致轨迹&#xa;排除幻觉式推理" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="应用规则化工具过滤&#xa;移除过长轨迹&#xa;移除无效工具调用&#xa;最终保留 911 条轨迹" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="微调 PRDJudge&#xa;Qwen3-Coder-30B-A3B + LoRA&#xa;秩 16·1 轮·学习率 2e-4&#xa;预热 0.03·8 张 H800" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="1032" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="固定发布计数边界&#xa;Git/HF 快照实际为 1,259&#xa;单测 408·交互 732·文件 119&#xa;论文 v3 报告 1,258" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="1432" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="公开发布边界&#xa;50 份 PRD、计划与测试工件&#xa;Git 77f22c9b·HF 4994faf2&#xa;README 声称 MIT 但无 LICENSE&#xa;HF 卡片未声