      "type": "document",
      "size": "xl"
    },
    {
      "id": "aaa_outline",
      "label": "生成指标大纲\nGPT-4.1 使用 AAA 方法\nArrange 文件与环境\nAct 后 Assert 预期结果",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "scaffold",
      "label": "生成代码脚手架\nSOTA 代码智能体设计模块\n固定便于标注的接口\n算法实现可暂不完全正确",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "criteria_scheme",
      "label": "扩展评测标准方案\n细化每个评分点\n增加测试接口与工件\n命令及预期输出",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_inspection",
      "label": "人工测试检查\n在脚手架上运行测试\n检查接口兼容性\n核对输出是否符合 PRD",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "repair_loop",
      "label": "智能体修复与细化\n标注员提供定向反馈\n修改脚手架或评测标准\n再次执行人工检查",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "inclusion_gate",
      "label": "执行纳入门槛\n至少完成五轮修订\n所有检查问题均解决\n否则继续循环",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "remove_scaffold",
      "label": "移除生成脚手架\n保留 PRD 与评测标准方案\n保留测试工件和数据\n要求从零实现代码",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "benchmark_release",
      "label": "完成论文口径 PRDBench\n50 个 Python 项目·20 个领域\n论文 v3 共 1,258 个指标\n单测 408·交互 732·文件 118",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "development_round",
      "label": "第一轮：开发\n读取 PRD 与详细测试计划\n在 src 中实现完整项目\n不提出中间问题",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_inputs",
      "label": "PRDJudge 逐指标评测\nPRD + 详细测试计划\n提交代码 + 测试工件\n六种工具增强操作",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "test_type_gate",
      "label": "选择披露的测试类型\n原样执行测试命令\n比较日志、状态或文件\n形成指标证据",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "unit_test",
      "label": "单元测试分支\n运行给定 pytest 命令\n检查接口与断言\n论文 v3：408 个指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "shell_interaction",
      "label": "Shell 交互分支\n回放模拟用户输入\n比较实际与预期日志\n论文 v3：732 个指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "file_comparison",
      "label": "文件比较分支\n执行文件生成命令\n与参考结果比较\n论文 v3：118 个指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_report",
      "label": "写入逐指标报告\n2 通过·1 部分通过·0 失败\n保留每项解释\n保存 round1 或 round2 JSONL",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "debug_round",
      "label": "第二轮：调试\n读取第一轮扣分报告\n针对失败标准修改代码\n重跑同一 PRDJudge 流程",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_score",
      "label": "报告 DEV 与 DEBUG 分数\n单项目为平均分除以 2\n对有效项目求平均\n比较调试增益",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "judge_candidates",
      "label": "收集评判轨迹\nQwen3-Coder-480B-A3B 评判\n来自 11 个代码智能体\n每个智能体随机 8 个项目",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_labels",
      "label": "建立人工真值\n两名标注员独立评分\n分歧交由资深标注员裁决\n三级分数：0、1、2",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "exact_match_filter",
      "label": "按最终分数一致性过滤\n初始 2,147 条轨迹\n保留 1,742 条人工一致轨迹\n排除幻觉式推理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "tool_filter",
      "label": "应用规则化工具过滤\n移除过长轨迹\n移除无效工具调用\n最终保留 911 条轨迹",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "finetune_prdjudge",
      "label": "微调 PRDJudge\nQwen3-Coder-30B-A3B + LoRA\n秩 16·1 轮·学习率 2e-4\n预热 0.03·8 张 H800",
      "type": "process",
      "size": "xl"
    },
    {
