<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1624" pageHeight="712" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="招募数学专家&#xa;来自顶尖高校 / 教育机构&#xa;数学奥赛获奖者或有竞赛命题经验" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="独立原创题目&#xa;给出最终答案&#xa;同时撰写详细的人工逐步解答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="至少 3 名专家盲审质量&#xa;检查题面无歧义且逻辑正确&#xa;要求知识范围属于 MO / IMO 竞赛" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="核验真正原创性&#xa;与 AIME24/25 等现有集合做 10-gram 匹配&#xa;网页搜索 + 专家回忆相似竞赛题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="应用难度门禁&#xa;人类专家确认达到或超过 IMO 难度&#xa;至少 2 个先进模型在各 3 次采样中无法稳定解出" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="发布 50 道 AMO-Bench 题&#xa;代数 11 • 函数 / 数列 13 • 几何 5&#xa;数论 9 • 组合 12" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="每模型每题生成 32 个回答&#xa;推理模型温度 1.0 / 非推理模型 0.7&#xa;Top-k 50 • Top-p 0.95 • 使用最大可用长度" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="424" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="属于哪种答案类型？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="424" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="39 道题使用解析器评分&#xa;数值 • 集合 • 变量表达式&#xa;math-verify 等价性&#xa;4 位小数精度 • 变量代入" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="11 道描述题使用 LLM 评分&#xa;o4-mini (Low) 判断语义正确性&#xa;5 次独立裁判采样多数投票" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="得到单回答正确性&#xa;合并解析器与 LLM 裁判结果&#xa;预评测期间人工复核后处理" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="424" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="AMO-Bench 结果&#xa;AVG@32 = 32 个采样回答的平均准确率&#xa;Pass@32 • 输出长度 • 题类&#xa;AMO-Bench-P" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="验证混合评分器&#xa;人工检查 10 个 LLM 的 1,000 个回答&#xa;大规模评测前达到 99.2% 评分准确率" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="528" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="16" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;ht