      "type": "database",
      "size": "xl"
    },
    {
      "id": "seed",
      "label": "九名标注者编写多样种子问答\n五人负责推理题，四人负责其他题型\n强调复杂视觉与数值推理",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "types",
      "label": "覆盖五类问答\n推理 • 对话 • 选择 • 假设 • 事实核验\n并纳入不可回答问题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "vlm",
      "label": "人机协同扩展\nGPT-4o + Gemini + Claude降低单模型偏差\n每个种子生成五对新问答并交互扩展",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "refine",
      "label": "人工精修\n删除直接检索或过于简单的问题\n修订不清晰、歧义或错误的问答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "第二名标注者独立复核\n原标注者和复核者分别作答\n初始答案一致率为66.17%",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "consensus",
      "label": "协作消解全部分歧\n更正问题或答案并改写歧义\n主观估计允许小于1%的差异",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布ChartQAPro\n1,341张图表 • 1,948道验证问题\n99个来源 • 真实主题与样式多样性",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "评测21个视觉语言模型\n输入图表（有时附带说明段落）和问题\n生成开放词表答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "exact",
      "label": "精确匹配\n选择题 + 事实核验题\n所有年份型答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "numeric",
      "label": "数值匹配\n相对误差不超过5%即正确\n年份不使用宽松容差",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "text",
      "label": "文本匹配\n平均归一化编辑距离相似度\n容纳轻微表述差异",
