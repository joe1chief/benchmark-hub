  "nodes": [
    {
      "id": "sources",
      "label": "157 个种子图表网站\n来自 Hoque 与 Agrawala（2019）\nWebCharts 发现范围",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "search",
      "label": "查询 Google 图片\n“图表图像” • “图形” • “可视化数据”\n收集广泛网页图像候选",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "vit_filter",
      "label": "二分类 ViT 图表筛选\n识别并分离图表图像\n人工移除残余非图表图像",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pool",
      "label": "WebCharts 候选池\n筛选后 41,000 张图表图像\n保留广泛样式与主题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "web_select",
      "label": "选择 WebCharts 语料\n从 41K 候选选出 800 张图表\n另行人工整理 200 张信息图",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "other_sources",
      "label": "其他人工整理来源语料\nPew • Tableau • PPIC • OWID\n排除简单统计图表",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "charts",
      "label": "合并 1,341 张真实图表\n最终发布集覆盖 99 个在线来源\n保留 URL、替代文本与元数据",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "seed",
      "label": "9 名标注者创建种子问答\n5 人负责推理；4 人负责其他类型\n要求复杂视觉与数值推理",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "types",
      "label": "五类问答\n推理 • 对话 • 选择题\n假设 • 事实核验\n另含不可回答问题",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "vlm",
      "label": "人机协同扩展\nGPT-4o + Gemini + Claude\n每个模型为每张图表生成 5 组问答\n标注者另做交互式提示扩展",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "refine",
      "label": "人工精修\n移除直接检索或过于简单的问题\n修订不清晰、有歧义或错误的条目",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "7 名跨类别复核标注者\n5 人复核事实题；2 人复核其他类型\n复核者与原创建者交叉核验",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "consensus",
      "label": "初始一致率：66.17%\n共同解决全部分歧\n修订错误或歧义\n主观估计允许 <1% 差异",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "发布 ChartQAPro\n1,341 张图表 • 1,948 道核验问题\nACL 最终版：99 个来源",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "评测 21 个视觉语言模型\n直接提示 • 思维链（CoT）\n程序思维（PoT）\n图表 + 可选段落 -> 答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "exact",
      "label": "精确匹配\n选择题 + 事实核验\n所有年份答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "numeric",
      "label": "数值匹配\n允许 5% 相对误差\n年份不使用容差",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "text",
      "label": "文本匹配\n平均归一化 Levenshtein 相似度\nANLS 经阈值后给予部分分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "增强宽松准确率\n平均每题正确性\n按图表、答案和问题类型分析",
      "type": "terminal",
      "size": "xl"
    }
  ],
