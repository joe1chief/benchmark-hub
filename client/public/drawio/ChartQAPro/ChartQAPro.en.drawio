  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4424" pageHeight="536" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="157-site Seed of Chart-hosting Websites&#xa;From Hoque and Agrawala (2019)&#xa;WebCharts Discovery Scope" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Query Google Images&#xa;“chart images” • “graphs” • “visual data”&#xa;Gather Broad Web Image Candidates" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Binary ViT Chart Filter&#xa;Isolate Likely Chart Images&#xa;Manually Remove Remaining Non-chart Images" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="WebCharts Candidate Pool&#xa;41,000 Chart Images after Filtering&#xa;Retain Broad Styles and Topics" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Select the WebCharts Corpus&#xa;800 Charts from the 41K Pool&#xa;Separately Hand-curate 200 Infographics" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Other Curated Source Corpora&#xa;Pew • Tableau • PPIC • Our World in Data&#xa;Exclude Simple Statistical Charts" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Merge 1,341 Real-world Charts&#xa;Final Release Spans 99 Online Sources&#xa;Preserve URL, Alt Text, and Metadata" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="9 Annotators Create Seed QA Pairs&#xa;5 on Reasoning; 4 on Other Types&#xa;Require Complex Visual + Numerical Reasoning" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Five QA Families&#xa;Reasoning • Conversational • Multiple-choice&#xa;Hypothetical • Fact-checking&#xa;Also Include Unanswerable Cases" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="352" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Human–VLM Expansion&#xa;GPT-4o + Gemini + Claude&#xa;Each Model Creates 5 Pairs per Chart&#xa;Annotators Also Prompt Interactively" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Human Refinement&#xa;Remove Direct-retrieval or Simple Questions&#xa;Revise Unclear, Ambiguous, or Incorrect Items" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="7 Cross-category Review Annotators&#xa;5 Review Factoid; 2 Review Other Types&#xa;Reviewer + Original Creator Cross-check" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Initial Agreement: 66.17%&#xa;Resolve Every Disagreement Together&#xa;Revise Errors or Ambiguity&#xa;Allow &lt;1% on Subjective Estimates" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Release ChartQAPro&#xa;1,341 Charts • 1,948 Verified Questions&#xa;Final ACL Count: 99 Sources" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3240" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Evaluate 21 Vision–Language Models&#xa;Direct • Chain-of-Thought (CoT)&#xa;Program-of-Thought (PoT)&#xa;Chart + Optional Paragraph -&gt; Answer" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3544" y="168" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="Exact Match&#xa;Multiple-choice + Fact-checking&#xa;All Year-valued Answers" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3840" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="Numeric Match&#xa;Correct within 5% Relative Error&#xa;Years Excluded from Tolerance" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontC