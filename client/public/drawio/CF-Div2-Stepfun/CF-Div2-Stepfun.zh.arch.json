      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_replay_gate",
      "label": "金标裁判正确性质检门\n回放人类竞赛已通过 (AC) 提交源码\n要求在所有测试集上达到100%全通",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "discard_flawed",
      "label": "淘汰异常测试用例\n剔除过于严苛、死锁或不稳定的测试\n消除虚假报错与误杀合格解",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "frozen_benchmark",
      "label": "CF-Div2-Stepfun 冻结基准\n53道严密标定的算法竞赛题目\n配备完备离线自动评测套件",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "prompt_formatting",
      "label": "竞赛提示格式装配\n完整题述 + 数据规模约束 + 输入输出格式\n要求模型输出完整可编译程序",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_inference",
      "label": "模型算法代码生成\n自回归采样生成 (每题采样8次)\n输出 C++ 或 Python 完整求解源码",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sandbox_execution",
      "label": "严格离线沙箱评测机\n独立子进程安全隔离运行环境\n执行内存限制(256MB)与CPU时限(2.0s)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "assertion_check",
      "label": "全量测试断言校验\n逐一测试样例、随机大样本与压力测试\n要求空白规整后的输出完全精确一致",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_reporting",
      "label": "官方评测指标统计\n通过率 · 准确率 · pass@8 · avg@8\n全面评估高难度算法竞赛求解能力",
      "type": "terminal",
      "size": "xl"
    }
