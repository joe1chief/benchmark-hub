      "size": "xl"
    },
    {
      "id": "tool_filter",
      "label": "过滤候选工具\n确定性依赖\n工具驱动的信息访问\n领域真实性\n非平凡信息增益",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "tool_schema",
      "label": "定稿185个可执行工具\n每种类型有5至10个别名\n基于别名的名称与版本\nGPT-5.2生成说明\n固定类型化签名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "noisy_tools",
      "label": "加入925个噪声工具\n每个可执行工具配五个\n已弃用 · 条件受限\n陈旧 · 不可靠\n非权威值",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "backend",
      "label": "实例化可执行后端\n每个零售案例有完整记录\n隐藏且非平凡的取值\n唯一类型化输出\n固定噪声工具响应",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_spec",
      "label": "定义类型化任务\n初始类型D0\n目标类型Y\n多输入任务必须使用\n每一个已声明输入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "state_graph",
      "label": "构建状态图\n工具加入新的输出类型\n枚举包含极小工具集\n及其合法执行顺序\n形成真实路径Pi",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "task_filter",
      "label": "保留可解长程任务\n丢弃空路径集合\n最短路径至少5次调用\n发布路径长度为5至9",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "instantiate_query",
      "label": "实例化查询案例\n从后端抽取具体取值\n保持任务可解\nGPT-5.2把任务语言化\n隐藏中间子目标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "gold_answer",
      "label": "构造标准答案\n选择一条有效路径\nGPT-5.2依序执行\n使用抵达的目标取值\n保留全部有效路径作为过程真值",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "paper_dataset",
      "label": "论文最终基准\n327条零售查询\n56种类型 · 1,665个工具\n185个可执行 · 925个噪声\n555个阻断替代工具",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "runtime_state",
      "label": "初始化隐藏运行时状态\n状态含查询q可调用集Ut\n与已获得类型Dt\nU0为空 · D0已可用\nAgent可见100步预算",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "action_gate",
      "label": "每步仅选一个动作\n检索候选工具\n调用已检索工具\n或提交最终答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "retriever",
      "label": "解析一次检索请求\n按输入 · 按输出\n或同时按输入输出\n别名匹配后精确类型匹配\n至多14个可执行 · 30个总工具",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "default_candidates",
      "label": "默认检索模式\n返回全部匹配可执行工具\n均匀填充剩余槽位\n加入成对说明性噪声\n已检索工具保持可调用",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "blocker_mode",
      "label": "可选阻断检索模式\n选择有效路径上的工具\n至少保留一条路径\n替换为显式失败隐式失败\n或语义误导工具",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "tool_call",
      "label": "执行结构化工具调用\n工具必须已被检索\n所需类型必须已获得\n解析唯一后端元组\n将可信输出加入Dt",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "feedback",
      "label": "返回环境反馈\n候选工具或无直接工具提示\n工具结果或协议错误\n跟踪调用取值与轮次",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "budget_gate",
      "label": "检查模型可见的100步预算\n预算未耗尽\n返回动作选择\n预算已耗尽\n不再执行动作并结束",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_check",
      "label": "结束轨迹\n提交答案或预算已耗尽\n规范化文本并做包含匹配\n要求状态含目标类型Y",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "completion_metrics",
