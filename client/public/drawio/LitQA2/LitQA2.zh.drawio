  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2120" pageHeight="1528" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="构建" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="40" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="3" value="发布" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="120" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="4" value="评测" style="rounded=1;arcSize=8;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#BDBDBD;strokeWidth=1.5;fontColor=#212121;fontSize=12;fontStyle=1;verticalAlign=top;align=left;spacingLeft=12;spacingTop=10;dashed=1;dashPattern=8 4" vertex="1" parent="1"><mxGeometry x="200" y="40" width="48" height="88" as="geometry"/></mxCell><mxCell id="5" value="固定可复现实证&#xa;论文 2409.13740v2&#xa;paper-qa d7675d7b · Aviary 1c061dbc&#xa;公开/门控数据 5c77cec6/e9ee5486" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="-104" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="选择近期来源论文&#xa;发表时间在过去36个月内&#xa;优先选择冷门的中间发现&#xa;记录预期来源 DOI" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="168" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="专家人工编写多项选择题&#xa;答案必须依赖论文正文&#xa;不能仅凭标题或摘要回答&#xa;需要推理且不能直接照抄原句" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="440" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="构造可信干扰项&#xa;使用论文其他事实或领域知识&#xa;保存标准答案或 null&#xa;允许有意设计不可回答题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="712" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="挑战测试题目草稿&#xa;定期测试 ChatGPT 3.5/4 · 关闭日志&#xa;经常在 Google Scholar 搜索题目措辞&#xa;检查能否由替代来源回答" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="984" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="从候选中剔除&#xa;未通过作者质量审核&#xa;不得合入正式题库" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1544" y="344" width="160" height="80" as="geometry"/></mxCell><mxCell id="11" value="出题者校准与持续作者审核&#xa;细审新作者最初约10题&#xa;接收 · 返工 · 剔除？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1528" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="汇总 LitQA2 · 248题&#xa;原始 LitQA 47题&#xa;首次发布 +100 → 147题&#xa;后续新增未见101题 → 248题&#xa;问题 · 答案/null · 干扰项 · DOI" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="2"><mxGeometry x="1800" y="152" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="paper-qa 复现清单&#xa;二次 ID 划分 · 不是 HF 物理 split&#xa;从199行选训练159 + 验证40&#xa;从门控语料选测试49" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="88" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="固定 HF LAB-Bench 语料&#xa;仅一个物理 train split · 199行&#xa;不存在物理 eval 或 test split&#xa;HF 5c77cec6 · CC BY-SA 4.0" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="360" y="536" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="自动门控测试题库 · 49题&#xa;aviary-paper-data 测试划分&#xa;HF e9ee5486 · 共享联系信息门槛" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="360" y="728" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="部分公开发布&#xa;199题无门槛 · 49题自动门控&#xa;数据集许可证 · CC BY-SA 4.0&#xa;无官方实时排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="632" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="未披露的构建细节&#xa;精确采样框与候选题总量&#xa;挑战提示词与生成参数&#xa;接收率与复核者一致性&#xa;完整剔除与修订记录" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="3"><mxGeometry x="904" y="776" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="准备每次论文 v2 调用&#xa;问题 + 全部答案选项&#xa;加入“信息不足，无法回答”&#xa;每次调用均随机排列选项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1640" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="运行一项 PaperQA 配置&#xa;每题调用一次 paperqa&#xa;对全部248题完整运行3次&#xa;温度0 · 系统配置可变" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1368" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="GPT-4-0613 字母抽取器&#xa;论文原始提示词（保留英文）&#xa;Extract the single letter answer&#xa;from the following question and answer&#xa;{prompt_output('QA')}&#xa;Single Letter Answer:" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="1096" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="判定解析后的选项&#xa;命中标准答案 → 正确&#xa;选择信息不足 → 不确定&#xa;标答为 null 且选信息不足 → 正确" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="824" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="计算 LitQA2 指标&#xa;准确率 = 正确数 / 全部题数&#xa;精确率 = 正确数 / 已作答数&#xa;DOI召回率 = 正确来源归因数 / 全部题数" style="rounded=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#757575;strokeWidth=1;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="552" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="报告论文 v2 评测&#xa;按配置汇总三次运行&#xa;比较旧147题与未见新101题&#xa;单独报告人工工具使用基线" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="280" y="1112" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="当前默认实现 ≠ 论文 v2 协议&#xa;paper-qa d767 · 提示词常量已不同&#xa;Aviary 1c061 · gpt-4o-mini + 选项文本&#xa;选项需显式提供随机种子才会打乱&#xa;不可与论文报告结果混用" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=9;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="4"><mxGeometry x="8" y="1304" width="200" height="10