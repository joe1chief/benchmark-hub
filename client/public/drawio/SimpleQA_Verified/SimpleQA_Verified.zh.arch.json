  "nodes": [
    {
      "id": "step_1",
      "label": "原始 SimpleQA 候选题库\n4,326 道短事实候选提示词\nOpenAI 初始参数知识评测池",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "唯一来源文档过滤\n每个来源文档仅保留单一问题\n防止跨来源特定主题过度聚集",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "Gemini 嵌入语义去重\n计算稠密语义向量相似度\n严格剔除同义改写重复查询",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "TF-IDF 字词统计去重\n稀疏词汇重合度比对分析\n消除表层词法重合冗余样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "爬虫协议规范合规审查\n严格遵循发布者拒绝抓取声明\n清除受 Robots 限制的来源内容",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "答案类型与主题分布均衡\n均衡实体类别与领域知识分布\n平衡科学、历史、艺术与地理占比",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "非数值真值仲裁调和\n结合检索增强模型集成校验\n化解网络互联内容冲突陈述",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "数值基准真值对齐纠偏\n多来源统计数据差异调和\n实施 5% 相对误差容限边界",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "可接受数值区间校准\n逐题设定合理容差允许窗口\n明确上下界金标基准边界",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "高难 1,000 题基准子集\n前沿大模型难度分层筛选\n精选 1,000 道高熵事实提问",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "人工精修与元数据增强\n修复失效 URL 与日期精度表达\n补充推理步骤与来源引用标注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "无外部工具直接作答协议\n标准 API 零样本直答提示\n纯粹考察模型参数化记忆检索",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "GPT-4.1 自动化裁判判分\n支持数值容差区间匹配提示词\n有效辨识免责对冲与多样化拒答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "三分类结果判定归纳\n判定正确、错误或未尝试拒答\n精准解耦模型幻觉与审慎拒答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_15",
      "label": "准确率与 CGA 指标计算\n统计基础准确率与有效尝试率\n计算有效作答正确率 (CGA)",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_16",
      "label": "调和 F1 评测综合报告\n有效正确率与尝试率调和平均\n严厉惩罚盲目猜测与过度拒答",
      "type": "terminal",
      "size": "xl"
    }
  ],
