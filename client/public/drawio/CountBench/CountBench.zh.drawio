  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2744" pageHeight="432" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="论文 + 发布版本边界&#xa;arXiv:2302.12066v1 · §§4、5.1&#xa;官方 JSON @ 2c573a8：540 条" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="公开 LAION-400M&#xa;图像—描述对" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="保留英文拼写计数词 two 至 ten&#xa;非拼写数字或大于 ten 的数字&#xa;多用于日期、时间与地址" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="现成目标检测器&#xa;统计每类对象的检测数量&#xa;描述数量须匹配数量最多的类别" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="自动过滤候选&#xa;“two”超过 158K&#xa;“ten”仅约 100" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="初步平衡每个数量&#xa;每个数量保留 100–200 个候选" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="人工验证&#xa;描述数量必须匹配&#xa;图中清晰可见对象" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="最终平衡：60 × 9 = 540&#xa;CountBench 仅作测试集&#xa;与计数训练集 C 无重叠" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="创建九条候选描述&#xa;数量覆盖 two 至 ten&#xa;一条正确 + 八条反事实" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="CLIP-B/32 + BASIC-S 零样本评测&#xa;计算九条描述的图文相似度&#xa;最高得分对应预测数量" style="rounded=1;arcSize=20;html=0;c