  "nodes": [
    {
      "id": "spatial_raw_datasets",
      "label": "空间转录组多技术平台图谱库\n汇聚 10x Visium、MERFISH、Stereo-seq 与 Slide-seq 多源数据\n整合高分辨率空间基因表达丰度矩阵与原位组织病理切片影像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "spatial_task_curation",
      "label": "空间生信微环境分析任务设计\n基于组织空间几何坐标设计 115 道深度生物学推理任务\n覆盖细胞空间近邻相互作用、受体-配体对接与组织微区划分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "spatial_ground_truth",
      "label": "算法空间自相关与基准真值计算\n执行 Squidpy/Seurat 空间聚类算法与 Moran's I 空间自相关统计\n计算推导出组织结构域切分金标准与细胞空间接触互作真值矩阵",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "external_validation_gate",
      "label": "外部同行科学家独立验证？\n由外部独立资深计算生物学家盲审核验试题与分析结论\n确认任务设定与已发表权威组织生物学文献及算法真值严格吻合",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "flawed_task_discard",
      "label": "空间伪影与未达标任务剔除池\n过滤因组织撕裂伪影、测序分辨率不足或共定位存疑的问题\n确保入选基准的 115 题具备无可争议的外部生物学实验实证",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "undisclosed_sourcing_boundary",
      "label": "专有数据溯源与发布边界说明\nClaude Sonnet 5 系统卡第 8.14.2 节披露 115 道外部验证题目\n底层专有临床样本获取渠道与原始检测明细属于内部保护资产",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "verified_task_assembly",
      "label": "经过外部验证的基准规范化组装\n将 115 道通过专家盲审的问题整合为标准化机器可读格式\n组装空间坐标表达矩阵特征、形态学线索与明确的生物学提问",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "spatialbench_freeze",
      "label": "SpatialBench Verified 冻结基准套件\n包含 115 道经过外部严格实证核验的空间转录组生信挑战题\n完整配套细胞空间物理坐标、切片图像特征元数据与权威参考答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "spatial_prompt_assembly",
      "label": "空间生物学专业分析提示封装\n整合细胞空间位置坐标、基因表达定量计数与具体生物学分析任务\n引导模型推理组织微环境演进机制并推导复杂组织生物学特性",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "model_spatial_reasoning",
      "label": "基座大模型空间转录组深度推断\n大模型解析细胞空间排布拓扑或生成空间生信分析处理代码\n推导病理浸润微区、空间形态发生素梯度及局部细胞通讯机制",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "code_execution_sandbox",
      "label": "空间生信专用代码执行沙箱\n在预装 Squidpy 与 Scanpy 的容器运行时中安全执行模型分析代码\n动态计算近邻富集度、空间可变基因 (SVG) 与受体-配体互作得分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "execution_status_gate",
      "label": "空间分析脚本执行与语法校验？\n核验代码是否顺利跑通、无内存超限、无语法崩溃且成功输出结果\n提取计算所得量化空间度量、组织微区分类标签及生物学推论",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "execution_failure_sink",
      "label": "代码执行崩溃与坐标维度异常池\n记录空间物理坐标对齐失败、内存溢出及语法未完成崩溃\n客观测定模型在处理多模态高维空间转录组数据时的代码鲁棒性",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "biological_consistency_evaluator",
      "label": "生物学一致性与空间度量评估器\n计算预测微环境结构域与金标准结构域的 Jaccard 相似度指数\n比对空间表达梯度相关系数，评估模型结论与权威文献的一致度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "verified_accuracy_gate",
      "label": "模型结论是否符合外部验证金标准？\n对照外部生物学专家核验准则全面评审模型输出的生物学结论\n确认模型是否从复杂空间转录组结果中做出了严谨正确的科学推断",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "spatialbench_reporting",
      "label": "SpatialBench Verified 官方评测报告\n报告 Claude Sonnet 5 系统卡中所披露的综合基准表现得分\n细粒度呈现组织微环境解析、细胞相互作用推断与病理定位能力",
      "type": "terminal",
      "size": "xl"
    }
  ],
