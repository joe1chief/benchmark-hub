  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2280" pageHeight="816" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Define Multi-step Logical Reasoning&#xa;Binary Context Entailment&#xa;Explicit Depths One through Five&#xa;Separate Three Logic Types" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Catalog Logic Ingredients&#xa;33 Zero- or One-variable Rules&#xa;for PL / FOL&#xa;Eight NM Reasoning Patterns&#xa;Depths One through Five" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="200" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Build the PL and FOL Stream&#xa;One Rule Defines Depth One&#xa;Each Step Uses One Inference Rule&#xa;Later Premises Reuse Earlier Conclusions" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Build the Non-monotonic Stream&#xa;Start from Eight Default Patterns&#xa;Use Only One NM Rule per Chain&#xa;Mix NM Conclusions with Classical Logic" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2