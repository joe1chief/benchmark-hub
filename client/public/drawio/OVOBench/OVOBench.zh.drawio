    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3024" pageHeight="1536" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定审阅证据&#xa;arXiv：2501.05510v2&#xa;Git：c34093f&#xa;HF：fec29e3" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="392" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义三类在线模式&#xa;向后追溯&#xa;实时视觉感知&#xa;向前主动响应" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="列出任务划分&#xa;3 个向后 · 6 个实时 · 3 个向前&#xa;正文共 12 个任务&#xa;图 2 图注却写 14 个" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="选择验证集或测试集来源&#xa;EPM：QA-Ego4D · OpenEQA&#xa;ASI：STAR · YouCook2&#xa;CrossTask · HiREST · COIN" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="映射其余源视频&#xa;REC：Perception-Test · THUMOS&#xa;SSR：COIN · CRR：MovieNet&#xa;实时任务：Ego4D · 补充 YouTube" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="三条元标注路径&#xa;复用精确标注&#xa;半自动时间戳&#xa;直接人工标注" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="复用准确事件时间戳&#xa;读取已有数据集元数据&#xa;保留事件边界&#xa;映射到目标任务" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="构建半自动时间戳&#xa;Gemini-1.5 生成粗粒度时间戳&#xa;人工查看视频&#xa;人工精修事件边界" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="收集志愿者元标注&#xa;SSR 与 CRR 问题&#xa;答案及真值时间戳&#xa;遵循任务专属指南" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="汇总并精修元数据&#xa;查看每个源视频&#xa;修正事件边界&#xa;验证元标注" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="生成候选问答&#xa;随机抽取短视频片段&#xa;GPT-4o 使用人工精修提示词&#xa;补充人工提出的问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="构造向后与实时选择题&#xa;每题 2–5 个选项&#xa;规则变换&#xa;基于视频的错误选项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="执行人工质量检查&#xa;检查每道问答&#xa;人工审核干扰项&#xa;打乱选项以消除顺序偏差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="固定论文版本&#xa;644 个独立视频&#xa;2,814 条问答元标注&#xa;七个领域 · 12 个任务" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="选择在线评测模式&#xa;向后与实时选择题&#xa;向前密集查询&#xa;保留查询时序" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="评测过去与当前&#xa;从片段起点到查询时刻&#xa;带时间戳的提示&#xa;预测选择题答案" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="评测未来响应&#xa;沿时间线密集查询&#xa;模型选择等待或作答&#xa;REC · SSR · CRR" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="792" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="应用论文向前任务指标&#xa;REC 时序：p1 = 0.2 · p2 = 0.05&#xa;SSR 与 CRR 由 GPT-4o 判断&#xa;时间衰减：p = 0.5" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="672" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="报告论文协议结果&#xa;任务与模式结果&#xa;主表采用准确率指标&#xa;比较模型与人类" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="67