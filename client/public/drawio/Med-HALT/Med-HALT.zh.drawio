try"/></mxCell><mxCell id="20" value="生成模型输出&#xa;TGI · 温度 0.6 · Top-p 0.95&#xa;最多 128 个新 token · seed 42&#xa;停止序列：Stop Here" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="解析预测文本&#xa;仅取首行 · 删除 Stop Here&#xa;修复引号 · ast.literal_eval&#xa;失败后正则重建键值" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="是否具备评测器输入合同？&#xa;需要 gpt_output 与 testbed_data" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="当前 main 的复现缺口&#xa;转换器写入平铺字段与 output&#xa;eval_full 需要旧版嵌套字段&#xa;未发布适配器" style="rounded=1;arcSize=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFCCBC;strokeColor=#FF7043;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="1272" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="使用哪条判分规则？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="判定 FCT 修正答案&#xa;搜索八种 answer 键名&#xa;小写后与金标精确相等&#xa;忽略 yes/no 与解释字段" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="872" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="判定 NOTA 与四项 MHT&#xa;读取 cop、paper_title 或 url&#xa;小写后精确字符串匹配&#xa;不 strip、不模糊匹配、不规范化 URL" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="1088" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="判定虚假问题的 cop&#xa;用拒答关键词子串白名单&#xa;包含未知、以上皆非、无意义等词&#xa;缺少键时产生异常" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="1312" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="应用代码计数合同&#xa;分别累计正确与错误&#xa;exception_count 单独记录&#xa;total = correct + wrong" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="1088" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="计算准确率&#xa;100 × correct / (correct + wrong)&#xa;解析或缺键异常被排除&#xa;此指标不会把异常计为错误" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verti