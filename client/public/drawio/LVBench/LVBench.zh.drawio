  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2488" pageHeight="1136" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="主要证据与固定版本&#xa;ICCV 2025 · arXiv v3&#xa;Git 518df472 · HF 0caedb92&#xa;站点 07fdecb1 · 2026-07-21 核验" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="24" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="收集 500 个 YouTube 候选&#xa;通过搜索、推荐与领域关键词&#xa;自媒体 21 · 动画 18 · 体育 17&#xa;直播 17 · 电视 16 · 纪录片 14&#xa;每个候选至少 30 分钟" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="360" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="应用五项视频筛选规则&#xa;主角清晰 · 结构因果连贯&#xa;平均每 5 分钟至少一个重要事件&#xa;稳定清晰 · 至少 720p&#xa;关键信息依靠视觉" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="696" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="论文报告的视频集&#xa;103 个视频 · 117 小时&#xa;平均时长 4,101 秒&#xa;六类但非均衡 · 不含音频" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1032" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="专业标注设置&#xa;雇佣标注员 · 全片标注平台&#xa;人工检查质量与有害内容&#xa;每个视频平均报酬 30 美元" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1368" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="阶段 1 · 完整分析视频&#xa;标记事件、场景与关键实体&#xa;识别时间依赖&#xa;识别因果关系" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1704" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="阶段 2 · 编写分布式问题&#xa;最终过滤前平均每小时 24 题&#xa;覆盖完整视频时间线&#xa;每个视频初始覆盖六项能力" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1704" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="分配多标签能力&#xa;TG · Sum · Rea · ER · EU · KIR&#xa;使用具体且唯一的指代&#xa;发布物包含 26 种规范组合" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1368" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="阶段 3 · 构造选项与线索&#xa;1 个正确项 · 3 个可信干扰项&#xa;对齐选项格式与长度&#xa;标注最小精确起止片段" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1032" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="执行编辑质控&#xa;检查覆盖、一致性与唯一性&#xa;减少过量时间定位题&#xa;保持指代无歧义" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="696" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="门控纯文本可回答题目&#xa;GLM-4 与 GPT-4 独立作答&#xa;答案相同且正确时删除&#xa;论文未报告删除数量" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="360" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="发布 103 条视频记录&#xa;内含 1,549 个 QA&#xa;唯一 UID · A–D · time_reference&#xa;无推荐 train/dev/test 切分&#xa;仅用于评测" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="24" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="非原生长视频路线&#xa;均匀固定帧采样&#xa;例如 32 或 96 帧&#xa;适配各模型输入上限" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="192" y="536" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="原生长视频路线&#xa;按每秒 1 帧处理&#xa;仅在超过模型上限时继续下采样&#xa;并非输入原始完整帧率" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="760" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="使用论文选择题提示&#xa;question 已包含 (A)–(D)&#xa;直接返回选项字母&#xa;不给出解释" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="864" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="执行论文响应解析&#xa;先正则匹配 · 失败后由 LLM 抽取&#xa;v3 未指定 LLM 或其提示词&#xa;未报告生成配置" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1200" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="运行公开精确匹配评分器&#xa;输入 JSON 映射 UID 到答案字符串&#xa;直接与真值 A–D 比较&#xa;polish_answer 存在但未接入" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1536" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="计算总体与六项能力分数&#xa;总体分母为已提交的已知 UID&#xa;多标签题进入每个对应分母&#xa;完整提交时分母才为 1,549" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1872" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="发布 Overall · ER · EU · KIR&#xa;发布 TG · Rea · Sum&#xa;result.json 保存 0–1 小数&#xa;排行榜显示百分比" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2208" y="648" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="版本与发布数据漂移&#xa;v1/v2/v3：8/15/26 个模型&#xa;论文：117 小时 · 均值 4,101 秒&#xa;JSONL：115.532 小时&#xa;JSONL 均值：4,038 秒&#xa;16 条低于 720p · 4 条超两小时" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="24" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="制品与排行榜边界&#xa;QA、元数据与脚本公开&#xa;整体部分公开 · 声明 CC BY-NC-SA&#xa;原视频仍在外部 YouTube&#xa;HF train=7 是七张文档图片&#xa;静态榜单可用 · 提交 Space 故障" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="864" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;dashed=1;dashPattern=6 4;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="24" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4">