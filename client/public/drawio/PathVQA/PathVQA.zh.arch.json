  "nodes": [
    {
      "id": "source_evidence",
      "label": "固定论文证据\narXiv 2003.10286v1\nPDF cbfe071a8d80\nACL 2021 · PDF 9760f1711cdb",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "clinical_gap",
      "label": "解决医疗数据缺口\n公开病理图像稀缺\n病理学家缺少标注时间\n改用教材与数字图书馆",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "textbook_sources",
      "label": "选择公开教材来源\nTextbook of Pathology\nBasic Pathology\n使用在线PDF版本",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "pdf_extract",
      "label": "抽取PDF图像与文本\nPyPDF2读取图像XObject\nPDFMiner读取文本与位置\n保留页面坐标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "caption_match",
      "label": "匹配教材图注\n用正则查找Fig或Figure\n按页面位置排序\n依次配对图像与图注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "peir_source",
      "label": "选择在线图书馆\n病理教育信息资源库\nPEIR公开数字图书馆\n使用图像页面与图注",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "peir_crawl",
      "label": "抓取PEIR图文对\nRequests下载页面与图像\nBeautiful Soup解析目标HTML标签\n图注随本地图像保存",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "clean_pairs",
      "label": "清洗图像图注对\n移除非病理图像\n排除流程图与肖像\n修正图注错配",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "corenlp",
      "label": "使用CoreNLP解析图注\n分句与分词\n标注词性与命名实体\n生成成分与依存分析",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "simplify",
      "label": "简化长句\n重排主语、动词与从句\n应用论文引用的句法规则\n生成更短的陈述句",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "question_transducer",
      "label": "应用Tregex转换器\n按规则查询成分树\n分解主要动词\n执行主语与助动词倒装",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "yesno_generation",
      "label": "生成肯定问题\n倒装主语与助动词\n保留图注原命题\n原始答案对应yes",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "negative_generation",
      "label": "生成平衡的否定问题\n采样相同词性的短语\n从其他图注取替换项\n替换原问题中心词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_generation",
      "label": "生成开放式问题\nwhat · where · when · whose · how\nhow much或how many\n移除目标答案短语",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "merge_qa",
      "label": "合并生成的问答对\n汇总开放式与是非分支\n保留抽取出的答案短语\n每条数据绑定对应图像",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "manual_review",
      "label": "逐题人工校对\n修正拼写、句法与语义\n删除含糊或过短问题\n清理符号、空格与答案冠词",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "paper_scope",
      "label": "形成arXiv v1数据集\n4,998张图像 · 32,799个问答\n教材1,670张 · PEIR 3,328张\n开放题16,465 · 是非题16,334",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "paper_split",
      "label": "按图像随机划分\n比例0.5 · 0.3 · 0.2\n训练2,499图 · 17,325问答\n验证1,499 · 9,462 · 测试1,000 · 6,012",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "vqa_models",
      "label": "运行论文VQA基线\n输入一张图像与一个问题\n生成yes、no或自由文本\n与参考答案比较",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "metric_gate",
      "label": "判断问题类型\n二元yes或no\n开放式自由回答\n使用论文分类指标",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "binary_metrics",
      "label": "评测二元问题\n使用精确yes或no准确率\n报告答对百分比\n与开放题分开统计",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "open_metrics",
      "label": "评测开放式答案\n精确匹配 · 宏平均F1\nBLEU-1 · BLEU-2 · BLEU-3\n比较词项与n元组",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告PathVQA结果\n分别保留二元与开放题指标\n保留官方图像级划分\n比较论文披露的VQA基线",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "论文计数边界\narXiv v1记载32,799个问答\nACL 2021记载32,795个\n两个版本不可互相替换",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "mirror_boundary",
      "label": "更新发布与镜像边界\n作者更新117e7f4ef88a：5,004 · 32,795\n镜像保留32,632问答与4,289图像\nHF 168583288333为社区镜像",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "prompt_boundary",
      "label": "评测复现边界\n未披露官方推理提示词\n未披露答案解析器或大模型裁判\n不猜测生成配置",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "copyright_boundary",
      "label": "许可与版权边界\n数据仓库声明MIT许可\n图像与图注版权仍归出版方\n作者与PEIR保留来源权利",
      "type": "document",
      "size": "xl"
    }
  ],
