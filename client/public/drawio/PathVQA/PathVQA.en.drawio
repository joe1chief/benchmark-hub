<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4360" pageHeight="896" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="Fixed Paper Evidence&#xa;arXiv 2003.10286v1&#xa;PDF cbfe071a8d80&#xa;ACL 2021 · PDF 9760f1711cdb" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="Address the Medical-data Gap&#xa;Public pathology images are scarce&#xa;Pathologists have little annotation time&#xa;Use textbooks and digital libraries" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="184" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="Select Public Textbook Sources&#xa;Textbook of Pathology&#xa;Basic Pathology&#xa;Use public PDF editions online" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="Extract PDF Images and Text&#xa;PyPDF2 reads image XObjects&#xa;PDFMiner reads text and location&#xa;Preserve page coordinates" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="Match Textbook Captions&#xa;Find Fig or Figure by regular expression&#xa;Order items by page location&#xa;Pair images and captions by order" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="Select the Online Library&#xa;Pathology Education Informational Resource&#xa;PEIR public digital library&#xa;Use image pages and captions" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="440" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="Crawl PEIR Image Pairs&#xa;Requests downloads pages and images&#xa;Beautiful Soup reads target HTML tags&#xa;Save captions beside local files" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="704" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="Clean Image-caption Pairs&#xa;Remove non-pathology images&#xa;Exclude flowcharts and portraits&#xa;Correct caption mismatches" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="960" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Parse Captions with CoreNLP&#xa;Sentence split and tokenization&#xa;POS and NER annotations&#xa;Constituency and dependencies" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1224" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Simplify Long Sentences&#xa;Rearrange subjects verbs and clauses&#xa;Apply published syntactic rules&#xa;Produce shorter declarative sentences" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1480" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Apply the Tregex Transducer&#xa;Query constituent trees with rules&#xa;Decompose the main verb&#xa;Perform subject-auxiliary inversion" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Generate Yes Questions&#xa;Invert subject and auxiliary&#xa;Keep the caption proposition&#xa;Use its original answer as yes" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Generate Balanced No Questions&#xa;Sample a same-POS phrase&#xa;Take the replacement from other captions&#xa;Replace the original head words" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="Generate Open Questions&#xa;What · where · when · whose · how&#xa;How much or how many&#xa;Remove the target answer phrase" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2000" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="Merge Generated QA Pairs&#xa;Combine open and yes or no branches&#xa;Retain the extracted answer phrase&#xa;Link every item to its image" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2264" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="Manually Proofread Every Question&#xa;Fix spelling syntax and semantics&#xa;Remove vague or very short questions&#xa;Strip extra symbols spaces and articles" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2520" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="Finalize the arXiv-v1 Dataset&#xa;4,998 images · 32,799 QA pairs&#xa;1,670 textbook · 3,328 PEIR&#xa;16,465 open · 16,334 yes or no" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="Randomly Split by Image&#xa;Ratio 0.5 · 0.3 · 0.2&#xa;Train 2,499 images · 17,325 QA&#xa;Val 1,499 · 9,462 · Test 1,000 · 6,012" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="Run the Paper VQA Baselines&#xa;Encode one image and one question&#xa;Generate yes or no or free text&#xa;Compare with the reference answer" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3304" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="Which Question Type?&#xa;Binary yes or no&#xa;Open-ended free answer&#xa;Use the paper's type-specific metric" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3560" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="Score Binary Questions&#xa;Apply exact yes or no Accuracy&#xa;Report the percentage correct&#xa;Keep the binary subset separate" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3824" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="Score Open Answers&#xa;Exact Match · Macro F1&#xa;BLEU-1 · BLEU-2 · BLEU-3&#xa;Compare tokens and n-grams" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3824" y="472" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="Report PathVQA Results&#xa;Keep binary and open metrics distinct&#xa;Preserve the official image split&#xa;Compare disclosed VQA baselines" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="4080" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="Paper-count Boundary&#xa;arXiv v1 reports 32,799 QA pairs&#xa;ACL 2021 reports 32,795&#xa;The versions are not interchangeable" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2784" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="Updated-release Mirror Boundary&#xa;Author update 117e7