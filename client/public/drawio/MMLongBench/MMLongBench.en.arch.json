{
  "version": 1,
  "title": "MMLongBench v3 Build and Evaluation Process",
  "type": "academic-diagram",
  "source": "edited",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 30,
    "edges": 41,
    "modules": 0
  },
  "nodes": [
    {
      "id": "evidence",
      "label": "Fixed Evidence Boundary\narXiv 2505.10610v3 · 6 Oct 2025\nCode 69044ca · Data 0c008eb\n13,331 Rows · 16 Source Datasets",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "category_route",
      "label": "Which Long-context\nTask Category?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "vrag_build",
      "label": "Visual RAG · 2,272 Rows\nInfoSeek Lead + ViQuAE KILT Gold\nWikipedia 2019-08-01 · 100 Words\nBM25 → GTE-large Hard Negatives\n3 Permutations / 6 Gold Depths",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "niah_build",
      "label": "NIAH · 5,536 Rows\nVH-Single / Multi + MM-NIAH\nRet · Count · Reason, Text + Image\nWeb Text in 100-word Chunks\nAdd Distractors to Length L",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "icl_build",
      "label": "Many-shot ICL · 1,958 Rows\nCars · Food101 · SUN397 · iNat2021\n5/10/20/40/50 Classes by Length\nRandom IDs 0…N−1 · Balanced Rounds\nTruncate Only the Last Round",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "summ_build",
      "label": "PDF Summarization · 387 Rows\nGovReport: GAO Only; Remove Summary\nMulti-LexSum: Rebuild PDFs from HTML\nRemove Answer HTML; Truncate from End\nDrop >128K + 24K · 15,951 Claims",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_build",
      "label": "Long-document VQA · 3,178 Rows\nMMLongBench-Doc · LongDocURL · SlideVQA\nCorrect Answer Formats; Drop Unrecoverable\nDrop String Answers Longer than 5 Words\nKeep Original Document ID in Question",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_length_gate",
      "label": "Document Longer\nthan Target L?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "doc_truncate",
      "label": "Truncate Both Sides Evenly\nPreserve Every Answer Page\nStop at Target Length L",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_pad",
      "label": "Alternate Left / Right Padding\nSample Negative Documents\nLast Padding PDF May Be Page-truncated\nPrefix “Based on Document {ID}…”",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "token_count",
      "label": "Unified Cross-modal Token Count\nText = Llama2 Tokenizer\nImage = 14×14 Patches\nApply 2×2 Pixel Unshuffle\nSum Text + Visual Tokens",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_versions",
      "label": "Materialize Five Lengths\n8K · 16K · 32K · 64K · 128K\nBinary K = 2¹⁰\nSame Semantic Example at Each L",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "MMLongBench Paper Release\n13,331 Examples · Five Categories\nMMLongBench-Doc Slice = 961 Rows\n≠ Stand-alone 1,082-row Release\nMIT Card; Source Licenses Still Apply",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "denominator",
      "label": "Evaluation Denominator per Length\nVRAG 900 · NIAH 2,250 · ICL 400\nSummarization 200 · DocVQA 300\nTotal = 4,050 Cases at Each L",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "inference",
      "label": "Evaluate 46 LCVLMs\nGreedy Candidate Decoding\nFive Input Lengths per Model\n4,050 × 5 = 20,250 Runs\nUntestable Capacity Cases = N/A",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "metric_route",
      "label": "Which Category-specific\nParser and Metric?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "vrag_metric",
      "label": "Visual RAG Metric\nParse “Answer:” then First Line\nNormalize Case / Punctuation / Articles\nSubstring Exact Match\n900 Cases per Length",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "niah_metric",
      "label": "NIAH Metrics\nVH = Binary Accuracy\nMM Text Ret/Reason = SubEM\nMM Image Ret/Reason = Choice Accuracy\nCount = Exact Sum; Modalities Averaged",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "icl_metric",
      "label": "ICL Metric\nRequire “label: {integer}”\nFallback to Last, then First Number\nExact Class Accuracy\n400 Cases per Length",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "summ_judge",
      "label": "GPT-4o Summary Judge\nGold → Pre-generated Atomic Claims\nCandidate → Sentence Precision\nClaim Recall + Binary Fluency\nT=0.1 · max_tokens=4096",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "summ_parse_gate",
      "label": "Last JSON Object Parses\nfor All Three Calls?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "summ_formula",
      "label": "Summary Score\nRecall = Found Claims / Gold Claims\nPrecision = Supported / Sentences\nF1 = Harmonic Mean\nFluency-F1 = Fluency × F1",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "summ_skip",
      "label": "Summary Judge Failure Handling\nRequest: Retry 5×, Then Raise\nInvalid JSON: Skip This Sample\nAggregate Rows with gpt4-scores Only\nZero Scored Rows → Raise Error",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "doc_parse",
      "label": "DocVQA Direct Parser\nPrefer Text after “Answer:”\nOtherwise Use First Output Line\nNo GPT-4o Answer Extractor in v3",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_format",
      "label": "Reference Answer Format?",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "doc_string",
      "label": "String / None\nRegex-sensitive Value → SubEM\nOtherwise Token F1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_integer",
      "label": "Integer\nExtract All Finite Integers\nAny Exact Match → 1, Else 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_float",
      "label": "Float\nExtract All Finite Numbers\nAccept x/100, x, or 100x\nRelative Tolerance = 1%",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "doc_list",
      "label": "List\nPaper: Greedy Best Element Match\nAverage Element Scores\nPinned Code Scores Each Gold Element\nagainst Full Parsed Prediction",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Report by Dataset, Category, Length\nAccuracy · SubEM · Fluency-F1\nDocVQA Rule Score\nDo Not Convert N/A into Failure\nv1.1 LLM Judge Is Outside This Pin",
      "type": "terminal",
      "size": "xl"
    }
  ],
