    {
      "id": "source",
      "label": "Chatbot Arena 查询池\n200,000 条众包提示",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "cleanup",
      "label": "论文 v2 提示清理\n去重 • 单轮 • 英文\n精确快照与过滤规则未公开",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "topics",
      "label": "论文 v2 主题建模\ntext-embedding-3-small • UMAP • HDBSCAN\n4,000 个不同主题\n由 LLM 总结并命名",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "论文 v2 质量标注\nGPT-4-Turbo • 七项标准\n逐条提示评分 0–7",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "v2_gate",
      "label": "论文 v2 质量门槛\n保留提示得分 ≥ 6\n保留簇均分 ≥ 5",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cluster_pool",
      "label": "高质量主题簇池\n超过 500 个簇\n由论文 v2 门槛筛得",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "sample",
      "label": "多样性随机采样\n随机选择 250 个簇\n每簇 2 条 = 500 条",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "safety_cleanup",
      "label": "采样后安全清理\n移除 PII / 冒犯性内容\n在 250 × 2 采样之后执行",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Arena-Hard 流程页\n同一 Arena-Hard-Auto-v0.1 发布\n500 题 • 并非独立数据集",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "responses",
      "label": "候选模型与基线回复\n基线：gpt-4-0314\n在 500 条开放提示上生成",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "two_games",
      "label": "每题执行两局裁判\n交换 A/B 位置\n500 × 2 = 每模型 1,000 次判断",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge_prompt",
      "label": "gpt-4-1106-preview • T = 0\nmax_tokens = 4,096\n先生成自己的答案，再比较回复",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "raw_judgment",
      "label": "五个允许的裁判标签\n[[A>>B]] • [[A>B]] • [[A=B]]\n[[B>A]] • [[B>>A]]",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parser",
      "label": "固定版本裁判解析器\n无标签 → continuation；最多 2 次\n单一 / 重复同标签 → 接受\n冲突标签 → 立即无效；不重试",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "normalized_battles",
      "label": "归一化第二局位置\n明显胜负 ×3 • 轻微胜负 ×1\n保留平局 • 丢弃无效结果",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "bt_elo",
      "label": "Bradley-Terry / Elo 尺度逻辑回归\n无正则估计\n锚定 gpt-4-0314 = 1,000",
      "type": "formula",
      "size": "xl"
    },
    {
      "id": "baseline_winrate",
      "label": "转换为相对基线胜率\n相对 gpt-4-0314\n默认报告并非 Elo rating",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "bootstrap",
      "label": "Bootstrap 不确定性\n100 轮 • 2.5 / 97.5 百分位\n得到 95% 置信区间",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Arena-Hard-Auto-v0.1 报告\n相对基线胜率 • 95% 置信区间\n可审计的成对判断到 BT 链",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "version_boundary",
      "label": "仅作来源版本证据\nApril blog / 仓库：均分 ≥ 6 • v1：GPT-3.5\n固定实现主题命名：gpt-4o-mini\n非论文 v2 主链",
      "type": "document",
      "size": "xl"
    }
  ],
