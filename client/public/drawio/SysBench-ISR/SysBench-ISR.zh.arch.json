  "nodes": [
    {
      "id": "step_1",
      "label": "ISR 指标切片协议确立\n提取指令满足率 (ISR) 核心度量\nGLM-4.5 报告规范化切片评测协议",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "复用六类原子约束体系\n格式、语言、人设、逻辑、否定与范围\n全量承袭 SysBench 形式化分类学",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "源头在线交互指令日志库\n真实人机交互系统前置指令池\n海量原始提示词语料沉淀",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "多阶段去重与清洗流水线\n启发式规则过滤与语义聚类\n剔除逻辑自相矛盾与不可测样本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "21 名专业标注员人工遴选\n人工严格甄选代表性系统消息\n保障涵盖现实业务实际使用场景",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "高质量系统提示词提纯重构\n凝练产出 500 条高质量系统消息\n严格保留清晰原子可验证约束",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "GPT-4o 协同五轮对话生成\n生成具备上下文依赖的交互轮次\n构建高度复杂多轮对话语境",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "指令交互关联属性标注\n标注顺从指令与冲突对抗指令\n标记各轮次间时序依赖与并行关系",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "细粒度约束评测检查清单\n为每个用户提问配置原子检查表\n定义客观明确的通过与失败准则",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "冻结 500 会话 / 2,500 轮对话全集\n完整复用 SysBench 底层评测数据\n确保评测基准样本分布严密对齐",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "目标模型推理生成执行\n输入系统前置消息、对话历史与当前指令\n产出候选模型文本回复",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "先进 LLM 裁决器校验比对\n依据详尽检查表逐项检验模型回复\n结合上下文背景判定约束满足",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "原子约束二元布尔判分\n逐项判定满足 (1) 或违规 (0)\n细致量化单条指令内各项约束",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "全约束协同满足严格门禁\n仅当全部关联约束均为 1 时判定通过\n单项违规即标记该指令未满足",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_15",
      "label": "指令满足率 (ISR) 权威基准报告\n满足全部约束的指令平均占比\n系统消息多轮遵从核心能力指标",
      "type": "terminal",
      "size": "xl"
    }
  ],
