{
  "version": 1,
  "title": "MMSI-Bench 证据对齐构建与评测流程",
  "type": "academic-diagram",
  "source": "edited",
  "profile": "academic-paper",
  "theme": "academic-color",
  "layout": "horizontal",
  "counts": {
    "nodes": 28,
    "edges": 33,
    "modules": 2
  },
  "nodes": [
    {
      "id": "evidence",
      "label": "固定一手证据\n论文 · 2505.23764v3\n代码 · 13e58a2b\n数据 · ec7c92bf\nICLR 2026 定稿版",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sources",
      "label": "八个真实世界来源\nMatterport 463 · ScanNet 280\nEgo4D 67 · AgiBot 45 · DTU 72\nnuScenes 39 · DAVIS 29 · Waymo 5\n不使用合成场景",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "pool",
      "label": "检查图像数据库\n超过 12 万张候选图\n室内 · 室外 · 驾驶\n视频 · 机器人 · 重建\n选择相关图像组合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "定义十一类任务\n六类位置关系\n两类属性 · 两类运动\n相机 · 物体 · 区域\n加多步推理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "六名 3D 视觉研究者\n总投入超过 300 小时\n自由形式自然英文\n不使用问题模板\n追求新颖性与难度",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "select",
      "label": "整合多张图像\n基础任务 · 固定两张\n多步任务 · 最多十张\n推断真实场景\n人类可回答",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dependent",
      "label": "必须跨图空间推理？\n不能由单图\n或常识回答",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_dependency",
      "label": "排除或重做\n视觉证据不足\n单图即可回答\n常识即可回答",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "question",
      "label": "编写四选一问题\n仅一个正确选项\n可信干扰项\n准确且无歧义\n自然人类表达",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "rationale",
      "label": "标注推理过程\n详细逐步路径\n多步题 · 3 至 11 步\n平均 5.7 步\n支持质检与分析",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "三名独立专家\n检查每个样本\n答案 · 歧义 · 证据\n推理完整性\n记录拒绝原因",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "通过全部复核？\n最终审计",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise",
      "label": "标注者返修循环\n接收审核反馈\n修改或替换样本\n重新进入质检",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_set",
      "label": "最终 MMSI-Bench\n1,000 道题\n1,990 张独立图像\n每题平均 2.55 张\n单题最多十张",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "增加难度标签\n每题两名新评测者\n归一化完成时长\n人类答错直接记困难\n易 605 · 中 262 · 难 133",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "精确八字段 Parquet Schema\nid · images · question_type\nquestion · answer · thought\nmean\\_normed\\_duration\\_seconds\ndifficulty · CC BY + 上游权利",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "strategy",
      "label": "采用哪种提示？\n论文实验\n直接 · 语言 · 视觉",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "direct",
      "label": "直接提示\n图像 + 问题\n要求输出选项字母\n字母放在反引号内",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cot",
      "label": "语言提示\n加 Let's Think Step by Step\n再要求选项字母\n字母放在反引号内",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "visual",
      "label": "视觉提示\n用 PATS 标记图像\n再直接要求字母\n字母放在反引号内",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "评测 37 个 MLLM\n温度为零\n最长输出 2,048 词元\n随机 · 盲测 GPT-4o\n五人平均人类基线",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "regex",
      "label": "抽取选项字母\n先解双或单反引号\n取首个独立 A 至 D\n排除 A 后紧跟单词\n发布代码正则路径",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parsed",
      "label": "找到有效 A 至 D？\n必须符合输出格式",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "fallback",
      "label": "手动 LLM 抽取路径\n仅供三类指定模型\nchatgpt-0125 · 最多三试\n输出 A 至 D 或 Z",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fallback_valid",
      "label": "补救返回 A 至 D？\nZ 或 API 耗尽即失败",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "fallback_fail",
      "label": "保留抽取失败\n默认正则未命中\n或 LLM 返回 Z / 耗尽\n该题得分为 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "精确匹配准确率\n正确为 1 · 否则 0\n分母为输入文件行数\n完整发布集运行为 1,000\n缺失行不会自动补入",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "analyze",
      "label": "自动推理分析\n提供标准答案 + 参考推理\n落地 · 重建\n情境变换 · 空间逻辑\n类别 5 表示完全正确",
      "type": "terminal",
      "size": "xl"
    }
  ],
