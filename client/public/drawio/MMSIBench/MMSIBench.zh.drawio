 value="增加难度标签&#xa;每题两名新评测者&#xa;归一化完成时长&#xa;人类答错直接记困难&#xa;易 605 · 中 262 · 难 133" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="296" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="精确八字段 Parquet Schema&#xa;id · images · question_type&#xa;question · answer · thought&#xa;mean\_normed\_duration\_seconds&#xa;difficulty · CC BY + 上游权利" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="528" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="采用哪种提示？&#xa;论文实验&#xa;直接 · 语言 · 视觉" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="952" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="直接提示&#xa;图像 + 问题&#xa;要求输出选项字母&#xa;字母放在反引号内" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="992" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="语言提示&#xa;加 Let's Think Step by Step&#xa;再要求选项字母&#xa;字母放在反引号内" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;alig