  "nodes": [
    {
      "id": "evidence",
      "label": "Freeze Primary Evidence\nPaper · 2505.23764v3\nCode · 13e58a2b\nData · ec7c92bf\nICLR 2026 Camera Ready",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "sources",
      "label": "Eight Real-world Sources\nMatterport 463 · ScanNet 280\nEgo4D 67 · AgiBot 45 · DTU 72\nnuScenes 39 · DAVIS 29 · Waymo 5\nNo Synthetic Scenes",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "pool",
      "label": "Inspect Image Database\nMore Than 120K Candidates\nIndoor · Outdoor · Driving\nVideo · Robot · Reconstruction\nSelect Relevant Image Sets",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "taxonomy",
      "label": "Define Eleven Tasks\nSix Position Relations\nTwo Attributes · Two Motions\nCamera · Object · Region\nplus Multi-step Reasoning",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "Six 3D-vision Researchers\nMore Than 300 Hours\nFree-form Natural English\nNo Question Templates\nMaximize Novelty and Difficulty",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "select",
      "label": "Integrate Multiple Images\nBasic Tasks · Exactly Two\nMulti-step · Up to Ten\nInfer Actual Scenario\nHuman-answerable",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dependent",
      "label": "Requires Cross-image\nSpatial Reasoning?\nNot Solvable by One Image\nor Common Sense",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "reject_dependency",
      "label": "Reject or Redesign\nInsufficient Visual Evidence\nSingle-image Solvable\nCommon-sense Solvable",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "question",
      "label": "Author Four-choice Question\nExactly One Correct Option\nPlausible Distractors\nAccurate and Unambiguous\nNatural Human Wording",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "rationale",
      "label": "Annotate Reasoning Process\nDetailed Step-by-step Path\nMulti-step · 3 to 11 Steps\nAverage 5.7 Steps\nSupports QC and Analysis",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "review",
      "label": "Three Independent Experts\nCheck Every Sample\nAnswer · Ambiguity · Evidence\nReasoning Completeness\nRecord Rejection Reason",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "quality",
      "label": "Pass All Reviews?\nFinal Audit",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise",
      "label": "Annotator Revision Loop\nReceive Reviewer Feedback\nRevise or Replace Item\nRe-enter Quality Control",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_set",
      "label": "Final MMSI-Bench\n1,000 Questions\n1,990 Unique Images\nMean 2.55 per Question\nMaximum Ten Images",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "difficulty",
      "label": "Add Difficulty Labels\nTwo New Evaluators per Item\nNormalize Completion Times\nWrong Human Answer = Hard\nEasy 605 · Medium 262 · Hard 133",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Exact 8-field Parquet Schema\nid · images · question_type\nquestion · answer · thought\nmean\\_normed\\_duration\\_seconds\ndifficulty · CC BY + upstream rights",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "strategy",
      "label": "Prompt Strategy?\nPaper Experiments\nDirect · Linguistic · Visual",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "direct",
      "label": "Direct Prompt\nImages + Question\nRequest Option Letter\nEnclose Letter in Backticks",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cot",
      "label": "Linguistic Prompt\nAdd Let's Think Step by Step\nThen Request Option Letter\nEnclose Letter in Backticks",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "visual",
      "label": "Visual Prompt\nPATS Marks on Images\nThen Direct Letter Request\nEnclose Letter in Backticks",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "Evaluate 37 MLLMs\nTemperature 0\nMax Output 2,048 Tokens\nRandom · Blind GPT-4o\nFive-person Human Average",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "regex",
      "label": "Extract Option Letter\nUnwrap Double or Single Backticks\nFirst Standalone A to D\nReject A Followed by a Word\nReleased Regex Route",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parsed",
      "label": "Valid A–D Found?\nRequired Output Format",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "fallback",
      "label": "Manual LLM Extraction Route\nOnly Three Selected Model Families\nchatgpt-0125 · Up to 3 Tries\nOutput A–D or Z",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fallback_valid",
      "label": "Fallback Returns A–D?\nZ or API Exhaustion = Failure",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "fallback_fail",
      "label": "Preserve Extraction Failure\nDefault Regex Miss\nor LLM Z / Exhaustion\nItem Score = 0",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "Exact-match Accuracy\nCorrect = 1 · Else 0\nDenominator = Input Rows\nFull Release Run = 1,000\nMissing Rows Are Not Inserted",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "analyze",
      "label": "Automated Reasoning Analysis\nGive Gold + Reference Rationale\nGrounding · Reconstruction\nTransformation · Spatial Logic\nCategory 5 = Fully Correct",
      "type": "terminal",
      "size": "xl"
    }
  ],
