inder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2040" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="生成完整模型解答&#xa;输入为纯文本或文本加图像&#xa;保持小题回答顺序" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2344" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="执行答案级评分&#xa;先用规则数学验证器&#xa;失败的等价表达式交 Gemini-2.5-Flash 复核" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="112" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="是否有官方评分细则&#xa;7 套考试进入步骤级路径&#xa;6 套考试进入仅答案级路径" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2640" y="632" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="授予步骤级部分分&#xa;Gemini-2.5-Flash 逐条核对官方评分点&#xa;4 套多解考试取最高方案分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2944" y="448" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="仅使用答案级结果&#xa;用于 6 套无评分细则的考试&#xa;最终答案正确即得满分" style="