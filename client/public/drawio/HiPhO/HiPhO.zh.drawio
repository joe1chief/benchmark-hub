  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="4120" pageHeight="952" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="一手证据与固定快照&#xa;arXiv:2509.07894v4 · 第 3.1-4 节 · 附录 A.1-A.2&#xa;论文期公开树 b7f4814 · data/*.json" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="选择 13 套最新考试试卷&#xa;2024-2025 年 7 项高影响力竞赛&#xa;要求存在可用人类选手成绩" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="收集 13 套官方试卷&#xa;题目 PDF · 官方答案&#xa;每套考试的奖牌分数线" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="使用 OCR 工具抽取 PDF&#xa;将文本重排为可编辑 Markdown&#xa;保留物理表达式的 LaTeX 格式" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="匹配题目与答案&#xa;对齐索引与编号模式&#xa;关联所需图像和考试上下文" sty