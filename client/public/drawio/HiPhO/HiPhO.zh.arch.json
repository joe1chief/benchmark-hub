      "type": "database",
      "size": "xl"
    },
    {
      "id": "ocr",
      "label": "使用 OCR 工具抽取 PDF\n将文本重排为可编辑 Markdown\n保留物理表达式的 LaTeX 格式",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "match",
      "label": "匹配题目与答案\n对齐索引与编号模式\n关联所需图像和考试上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "verify",
      "label": "人工核验每个题解对\n专家修正 OCR 错误与错配\n对照原始试卷验证答案",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "marking",
      "label": "结构化官方评分细则\n7 套考试提供步骤级标准\n转换为模型可读 Rubric",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "refine",
      "label": "精炼已核验题目\n补全上下文 · 结构化小题\n明确单位但不降低题目难度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "增加细粒度标注\n5 个物理领域 · 4 种模态类型\n6 种答案类型 · 3 个难度等级",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "benchmark",
      "label": "发布统一 HiPhO JSON\n360 道题 · 519 个小题\n308 道英文题 + 52 道中文题",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "model",
      "label": "生成完整模型解答\n输入为纯文本或文本加图像\n保持小题回答顺序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_grade",
      "label": "执行答案级评分\n先用规则数学验证器\n失败的等价表达式交强模型复核",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "route",
      "label": "是否有官方评分细则\n7 套考试进入步骤级路径\n6 套考试进入仅答案级路径",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "step_grade",
      "label": "授予步骤级部分分\n强模型逐条核对官方评分点\n4 套多解考试取最高方案分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_only",
      "label": "仅使用答案级结果\n用于 6 套无评分细则的考试\n最终答案正确即得满分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "problem_score",
      "label": "计算每题分数\n最终答案正确 = 满分\n否则保留已完成中间步骤得分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "medal",
