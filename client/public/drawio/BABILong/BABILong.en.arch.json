      "type": "database",
      "size": "xl"
    },
    {
      "id": "interleave",
      "label": "Hide Task Facts in Background Text\nInterleave Relevant and Distractor Sentences\nPreserve Their Natural and Logical Order",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_control",
      "label": "Add Background until Target Length\nMeasure with the GPT-2 Tokenizer\nAdapt Fact Positions Algorithmically",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "Pre-Generate Reproducible Splits\n0K • 4K • 8K • 16K • 32K • 64K\n128K • 512K • 1M • 10M Tokens",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "direct_eval",
      "label": "Run Long-Context LLMs Directly\nLocate Supporting Facts\nMemorize and Reason to the Answer",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rag_chunks",
      "label": "Run RAG-C Baseline\nRetrieve 512-Token Chunks\nPass Retrieved Evidence to the LLM",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rag_sentences",
      "label": "Run RAG-S Baseline\nRetrieve Individual Sentences\nTest Multi-Hop and Temporal Failures",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recurrent_train",
      "label": "Curriculum-Fine-Tune Memory Models\nRMT • ARMT • Mamba\nGradually Increase Recurrent Segments",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recurrent_eval",
      "label": "Evaluate Recurrent Memory\nExtrapolate beyond Training Lengths\nTest Selected Runs up to 50M Tokens",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "Compute Exact Task Accuracy\nReport Every QA Task and Context Length\nUse 1,000 Samples to 32K and 100 Beyond",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "effective_context",
      "label": "Diagnose Effective Context Use\nCompare One-, Two-, and Three-Fact Tasks\nTrack Accuracy Decay with Length",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "method_compare",
      "label": "Compare Direct, RAG, and Memory Models\nAnalyze Retrieval Order and Missing Facts\nSeparate Refusals Where Reported",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "Publish BABILong Results\nAccuracy by Task, Length, and Method\nPredefined Splits plus 50M Extrapolation",
      "type": "terminal",
      "size": "xl"
    }
