  "nodes": [
    {
      "id": "babi_simulation",
      "label": "生成 bAbI 模拟\n人物、物体、地点与事件\n合成事实和标准答案",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "task_suite",
      "label": "选择 QA1 至 QA20\n事实链 • 归纳 • 演绎\n计数 • 列表/集合 • 时空推理",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "pg19",
      "label": "采样 PG19 图书\n自然长篇叙事\n按原顺序抽取背景句子",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "interleave",
      "label": "把任务事实隐藏到背景文本\n交错相关句与干扰句\n保持自然顺序和逻辑顺序",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "length_control",
      "label": "添加背景直至目标长度\n用 GPT-2 tokenizer 计量\n算法化调整事实位置",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "预生成可复现长度分区\n0K • 4K • 8K • 16K • 32K • 64K\n128K • 512K • 1M • 10M token",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "direct_eval",
      "label": "直接运行长上下文 LLM\n定位支撑事实\n记忆并推理得到答案",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rag_chunks",
      "label": "运行 RAG-C 基线\n检索 512-token 文本块\n把证据交给 LLM",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rag_sentences",
      "label": "运行 RAG-S 基线\n检索单句\n测试多跳与时序失败",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recurrent_train",
      "label": "课程式微调记忆模型\nRMT • ARMT • Mamba\n逐步增加循环片段数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recurrent_eval",
      "label": "评测循环记忆\n外推到训练长度之外\n部分实验测试到 50M token",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "score",
      "label": "直接评测 QA1–QA5 准确率\n每任务、每长度 1,000 例\n覆盖至 32K\n32K 以上 100 例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "rag_score",
      "label": "RAG 精确准确率\n每任务、每长度 50 例\nRAG-C / RAG-S 分别报告",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "recurrent_score",
      "label": "循环记忆准确率\n至 1M 使用完整测试集\n10M 使用 100 例\n部分实验外推至 50M",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "effective_context",
      "label": "诊断上下文利用\n一、二、三事实任务\n跟踪准确率随长度衰减\n分析检索顺序与遗漏事实",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "method_compare",
      "label": "比较独立评测协议\n直接 • RAG-C • RAG-S\nRMT • ARMT • Mamba\n不合并不同样本数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "发布 BABILong 结果\n按任务、长度、方法报告准确率\n保留各自样本协议\n报告部分 50M 外推结果",
      "type": "terminal",
      "size": "xl"
    }
  ],
