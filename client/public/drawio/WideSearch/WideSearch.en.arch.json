  "nodes": [
    {
      "id": "real_queries",
      "label": "Real User Queries Corpus\nAuthentic information needs from search logs\nComplex multidimensional research inquiries",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "human_clarify",
      "label": "Human Screening & Clarification\nScreen and clarify user intents\nFormulate well-defined research tables",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "gold_search",
      "label": "Exhaustive Web Search & Gold Table\nHuman experts conduct exhaustive web searches\nRecord time, queries, keywords & gold Markdown table",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parametric_gate",
      "label": "Parametric LLM Independence Gate\nTest if closed-book LLM can answer completely\nFilter tasks solvable by parametric memory",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "drop_query",
      "label": "Discard Non-Challenging Task\nTask solvable from memory or too simple\nPrune candidate from benchmark",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "difficulty_gate",
      "label": "Time & Page Budget Gate\nRequire at least 10 minutes human effort\nRequire visiting at least 10 unique web pages",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "commercial_response",
      "label": "Commercial Agent Response Pilot\nRun candidate task on leading commercial search agent\nCollect generated markdown response",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "auto_score",
      "label": "Automated Evaluation Scorer\nExecute automated cell and table scoring script\nProduce provisional evaluation metrics",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "human_score",
      "label": "Expert Human Scoring\nDomain human expert manually evaluates response\nIndependent blind review score",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "score_agreement_gate",
      "label": "Score Agreement Gate (>=95%)\nCompare automated score vs human score\nRequire >=95% scoring agreement consistency",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise_gold",
      "label": "Iterative Task & Gold Revision\nRefine prompt wording or update gold table entries\nIterate until automated-human consistency is achieved",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wide_set",
      "label": "200 Verified Bilingual Tasks\n100 English and 100 Chinese tasks\nSpans 18 diverse real-world topics",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "search_agent",
      "label": "Execute Search Agent\nCandidate agent receives research prompt\nConducts multi-step web browsing and table synthesis",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "parse_gate",
      "label": "Markdown Table Syntax Gate\nValidate markdown table structure and headers\nEnsure parsable table format",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "zero_score",
      "label": "Assign Zero Score\nMalformed table or missing structural response\nRecord 0.0 for unparsable output",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "primary_align",
      "label": "Primary-Key Row Alignment\nIdentify primary key column and align rows\nMatch candidate rows to gold standard rows",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cell_router",
      "label": "Cell Type Evaluation Router\nDispatch cell by semantic data type\nExact, numeric, date, URL, or semantic check",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "exact_eval",
      "label": "Exact Text Matcher\nNormalized string equality check\nCase-insensitive and whitespace-stripped",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "numeric_eval",
      "label": "Numeric Tolerance Checker\nParse numeric values and units\nEvaluate value within acceptable tolerance bounds",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "date_eval",
      "label": "Date & Time Verifier\nNormalize dates to ISO format\nCheck calendar year, month, and day accuracy",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "url_eval",
      "label": "URL Domain & Target Checker\nNormalize URL structure and verify target\nCheck source attribution validity",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "semantic_eval",
      "label": "GPT-4.1 Semantic Evaluator\nEvaluate descriptive cells with LLM judge\nAssess semantic equivalence to gold reference",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "cell_scores",
      "label": "Cell & Row Precision / Recall / F1\nCalculate fine-grained field-level scores\nAggregate across aligned matrix",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "wide_metrics",
      "label": "Perfect SR + Row / Item F1 Metrics\nPerfect-table Success Rate (SR)\nRow-level F1 and Item-level F1 scores",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "multi_run",
      "label": "Multi-Run Evaluation Summary\nReport Avg@N, Pass@N, and Max@N\nComprehensive multi-trial deep search report",
      "type": "terminal",
      "size": "xl"
    }
