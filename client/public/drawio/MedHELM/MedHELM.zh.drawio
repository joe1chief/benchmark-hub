<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2160" pageHeight="1504" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="分类体系起点&#xa;JAMA 综述中的医学任务&#xa;与临床专家 MK 共同重组&#xa;强调医学相关性与清晰边界" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="草拟初始层级结构&#xa;五个大类&#xa;21 个子类&#xa;98 项候选任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="招募 29 名临床医生&#xa;覆盖 14 个专科 · 四家机构&#xa;Stanford 26 · 其余三家各 1&#xa;独立填写调查问卷" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="开展两部分验证调查&#xa;将 21 个子类映射到五个大类&#xa;按 1 至 5 分评价完整性&#xa;提交自由文本反馈" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="分析并修订分类体系&#xa;大类映射一致率 96.7%&#xa;完整性均分 4.21 / 5&#xa;吸收 107 条意见" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="形成临床专家验证的最终分类体系&#xa;五个大类&#xa;22 个子类&#xa;121 项医学任务" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="基准来源类型？&#xa;现有 · 重构 · 新建" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="72" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="纳入 17 个现有基准&#xa;来源为公开或受控数据&#xa;将每个基准映射到分类体系&#xa;保留适合任务的评测方法" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="重构五个数据集合&#xa;应用标准化提示模板&#xa;明确评测指标&#xa;转换为适合大模型评测的基准" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="新建 13 个基准&#xa;补足管理与工作流任务空白&#xa;其中 12 个使用电子病历数据&#xa;与 Stanford Health Care 合作" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="248" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="组装 35 基准套件&#xa;覆盖全部 22 个子类&#xa;13 个开放式 · 22 个封闭式&#xa;14 个公开 · 7 个受控 · 14 个私有" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="访问 / 可复现边界&#xa;公开：可公开复现&#xa;受控：需要审批&#xa;私有：需要所属机构授权" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="基准条目合约&#xa;上下文 · 提示 · 任务指标&#xa;可选标准答案&#xa;场景 + 运行规范适配具体任务" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="标准答案质量敏感性检查&#xa;GPT-4o-mini 标记重构基准答案&#xa;问题较多：MIMIC-RRS&#xa;+ MTSamples Procedures&#xa;排名稳定 · 不过滤主套件" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="论文中的九个模型&#xa;DeepSeek R1 · o3-mini&#xa;Claude 3.7 · Claude 3.5 · GPT-4o&#xa;Gemini 2.0 Flash · GPT-4o mini&#xa;Llama 3.3 70B · Gemini 1.5 Pro 001" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="运行 HELM 任务适配器&#xa;接口或本地端点 · 温度 0&#xa;任务专用提示、解析器、词元上限&#xa;PHI/HIPAA 合规集群" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="输出类型？&#xa;封闭式&#xa;或开放式" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="512" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="封闭式指标&#xa;精确匹配：单词元或数值&#xa;微平均 F1：多标签&#xa;解析 / 失败规则因场景而异" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="开放式评审输入&#xa;候选回答 + 基准专用提示&#xa;仅在需要时提供标准答案&#xa;ROUGE / BERTScore 为辅助" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="200" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="三模型评审团 · 1 至 5 分&#xa;GPT-4o · Claude 3.7 · Llama 3.3 70B&#xa;评价准确性 · 完整性或结构 · 清晰度&#xa;NoteExtract 评结构而非完整性&#xa;温度 0 · 上限 4096 · 不用思维链&#xa;贪心花括号 JSON" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="480" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="是否存在成功的&#xa;评审模型标注？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="成功评审 int(score) 聚合&#xa;每人贡献三轴；非整数可能截断或失败&#xa;评审失败时三个轴一并退出&#xa;论文目标：3 名评审 × 3 个轴" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="840" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="失败边界&#xa;候选为空或无成功评审时记 0 分&#xa;JSON 无效 / 缺字段 / 接口报错&#xa;会丢弃整名评审" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="1128" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="临床医生验证&#xa;ACI-Bench 31 例 + MEDIQA-QA 25 例&#xa;20 名医生 · 每例至少 2 人&#xa;ICC：评审团 .47 · 人类 .43&#xa;ROUGE .36 · BERTScore .44" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="992" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="逐基准得分&#xa;保留各任务原生指标&#xa;开放式：成功评审分母规则&#xa;不存在统一的跨任务解析器" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="归一化 / 缺失值&#xa;论文未给出零到一公式&#xa;榜单保留原始分数&#xa;源码跳过缺失或不可排序的比较" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1880" y="1320" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="跨基准聚合&#xa;论文：35 基准等权宏平均&#xa;论文：得分大于等于对手即胜&#xa;源码：平局半胜 · 仅算可用比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="1320" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="估算成本与表现&#xa;输入词元 + 最大输出词元&#xa;上界 · 价格日期 2025-05-12&#xa;九模型：11,739.07 美元" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1320" y="1320" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="发布框架 + 排行榜&#xa;HELM 代码采用 Apache 2.0&#xa;14 个私有数据集不发布&#xa;隐私 · 监管 · 污染防范" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1040" y="1320" width="200" height="100" as="geometry"/></mxCell><mxCell id="31" value="版本与漂移边界&#xa;论文：MedHELM v2.0.0&#xa;审计固定：HELM@2fcc2945&#xa;论文未固定提交或结果哈希&#xa;latest 会持续变化" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="760" y="1320" width="200" height="100" as="geometry"/></mxCell><mxCell id="32" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpS