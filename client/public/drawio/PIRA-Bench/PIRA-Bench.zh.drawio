<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3320" pageHeight="1112" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定官方证据&#xa;arXiv 2603.08013v1 · PDF b75a527baea1&#xa;HF 数据版本 26194bfba20d&#xa;榜单页面 HTML a1da2a91fe24" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="收集 100 条真实 GUI 轨迹&#xa;覆盖移动端与桌面端使用&#xa;连续被动观察流&#xa;多样日常活动" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="保留截图序列&#xa;保持时序与长程上下文&#xa;论文摘要报告平均 32 帧&#xa;贡献段落报告平均 33 帧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="注入通用噪声&#xa;无关应用切换&#xa;空闲屏幕与随机浏览&#xa;要求持续过滤干扰" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="配对三种用户画像&#xa;社会经济状态&#xa;偏好与个人特征&#xa;意图须服从指定用户" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="组成混合场景分布&#xa;不切成僵硬独立子集&#xa;模拟不可预测用户行为&#xa;同时覆盖正例与负例" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="直接推荐场景&#xa;视觉上下文揭示未来目标&#xa;拆解交错任务&#xa;产生画像兼容的可行动意图" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="画像依赖场景&#xa;仅凭截图存在歧义&#xa;交叉核对画像约束&#xa;只接受画像一致的推荐" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="纯噪声负例&#xa;漫无目的或碎片化 GUI 活动&#xa;不存在可行动潜在目标&#xa;期望意图集合为空" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="432" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="收集三人独立标注&#xa;展示每条轨迹与用户画像&#xa;标出明确可行动意图&#xa;对每个轨迹画像组合标注" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="形成意图真值集合&#xa;保留至少两人共同识别的意图&#xa;噪声或画像否定场景为空集&#xa;移除无共识建议" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1840" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="定稿 PIRA-Bench&#xa;100 条轨迹 · 每条三种画像&#xa;含噪多线程 GUI 观察&#xa;提交轨迹到画像再到意图数组" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2080" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="执行主动意图预测&#xa;输入截图与指定画像&#xa;不提供显式用户指令&#xa;返回推荐意图集合" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2320" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="判定语义意图匹配&#xa;Gemini-3-flash 比较预测与真值&#xa;同时向判定器提供用户画像&#xa;判定命中遗漏与多余意图" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2560" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="评分正例轨迹&#xa;逐轨迹计算意图精确率召回率与 F1&#xa;只使用真值非空场景&#xa;宏平均得到 Average Intent F1" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="48" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="评分负例轨迹&#xa;FPS 为每个负例平均幻觉意图数&#xa;FPSnorm = 1 / [1 + ln(1 + FPS)]&#xa;零误报的完美结果为 1" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2800" y="368" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="计算最终得分&#xa;Sfinal = Average Intent F1 × FPSnorm&#xa;奖励画像一致的主动性&#xa;缩减易产生幻觉的智能体得分" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3040" y="208" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="论文措辞边界&#xa;摘要称平均 32 张截图&#xa;贡献段落称平均 33 张截图&#xa;公开数据卡未消解差异" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="712" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="固定公开数据快照&#xa;trajs.zip · 6,794,715,214 字节&#xa;LFS SHA-256 d9677ed4aada&#xa;仅图像与 profile.json · 不含公开真值" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#21