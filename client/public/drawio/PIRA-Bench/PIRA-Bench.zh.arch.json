  "nodes": [
    {
      "id": "step_1",
      "label": "采集真实GUI轨迹\n100条移动端与桌面端序列\n连续被动观察流\n覆盖多样日常活动",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_2",
      "label": "保留连续上下文\n每条轨迹平均32张截图\n保持时间顺序\n表达长时程行为",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_3",
      "label": "注入真实噪声\n无关应用切换\n空闲屏幕\n随机浏览片段",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_4",
      "label": "配对三种用户画像\n社会经济背景\n偏好与个人特征\n让意图取决于具体用户",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_5",
      "label": "构建直接场景\n视觉上下文可揭示意图\n交错插入无关任务\n推荐需与画像相容",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_6",
      "label": "构建画像依赖场景\n仅看屏幕不足以判断\n交叉参考画像属性\n只接受画像一致的推荐",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_7",
      "label": "构建纯噪声负样本\n不存在可行动潜在目标\n画像也可否决视觉线索\n标准意图集为空",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "收集三人独立标注\n同时展示轨迹与画像\n标注明确可行动意图\n每个配对独立作业",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_9",
      "label": "按一致性确定意图\n保留至少2人同意的意图\n归一化语义描述\n丢弃无共识建议",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_10",
      "label": "形成PIRA-Bench\n100条轨迹 · 每条三种画像\n同时包含正负场景\n带噪多线程观察",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_11",
      "label": "执行主动意图预测\n输入连续截图与用户画像\n不提供显式用户指令\n返回推荐意图集合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_12",
      "label": "判定语义匹配\n由Gemini-3-flash比较意图集合\n匹配预测与标准答案\n统计正确误报与遗漏意图",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_13",
      "label": "分别评分正负样本\n正样本计算宏平均Intent F1\n负样本统计每例误报数\nFPSnorm等于1除以1加ln括号1加FPS",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_14",
      "label": "计算最终得分\nF1平均值乘FPSnorm\n奖励有用的主动意图\n惩罚不必要干预",
      "type": "terminal",
      "size": "xl"
    }
  ],
