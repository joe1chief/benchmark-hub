  "nodes": [
    {
      "id": "source_evidence",
      "label": "固定官方证据\narXiv 2603.08013v1 · PDF b75a527baea1\nHF 数据版本 26194bfba20d\n榜单页面 HTML a1da2a91fe24",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "collect",
      "label": "收集 100 条真实 GUI 轨迹\n覆盖移动端与桌面端使用\n连续被动观察流\n多样日常活动",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "preserve",
      "label": "保留截图序列\n保持时序与长程上下文\n论文摘要报告平均 32 帧\n贡献段落报告平均 33 帧",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "noise",
      "label": "注入通用噪声\n无关应用切换\n空闲屏幕与随机浏览\n要求持续过滤干扰",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "profiles",
      "label": "配对三种用户画像\n社会经济状态\n偏好与个人特征\n意图须服从指定用户",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "scenario_scope",
      "label": "组成混合场景分布\n不切成僵硬独立子集\n模拟不可预测用户行为\n同时覆盖正例与负例",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "direct",
      "label": "直接推荐场景\n视觉上下文揭示未来目标\n拆解交错任务\n产生画像兼容的可行动意图",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "profile_dependent",
      "label": "画像依赖场景\n仅凭截图存在歧义\n交叉核对画像约束\n只接受画像一致的推荐",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "pure_noise",
      "label": "纯噪声负例\n漫无目的或碎片化 GUI 活动\n不存在可行动潜在目标\n期望意图集合为空",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "收集三人独立标注\n展示每条轨迹与用户画像\n标出明确可行动意图\n对每个轨迹画像组合标注",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "consensus",
      "label": "形成意图真值集合\n保留至少两人共同识别的意图\n噪声或画像否定场景为空集\n移除无共识建议",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "release",
      "label": "定稿 PIRA-Bench\n100 条轨迹 · 每条三种画像\n含噪多线程 GUI 观察\n提交轨迹到画像再到意图数组",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "predict",
      "label": "执行主动意图预测\n输入截图与指定画像\n不提供显式用户指令\n返回推荐意图集合",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "judge",
      "label": "判定语义意图匹配\nGemini-3-flash 比较预测与真值\n同时向判定器提供用户画像\n判定命中遗漏与多余意图",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "positive_score",
      "label": "评分正例轨迹\n逐轨迹计算意图精确率召回率与 F1\n只使用真值非空场景\n宏平均得到 Average Intent F1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "negative_score",
      "label": "评分负例轨迹\nFPS 为每个负例平均幻觉意图数\nFPSnorm = 1 / [1 + ln(1 + FPS)]\n零误报的完美结果为 1",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "final_score",
      "label": "计算最终得分\nSfinal = Average Intent F1 × FPSnorm\n奖励画像一致的主动性\n缩减易产生幻觉的智能体得分",
      "type": "terminal",
      "size": "xl"
    },
    {
      "id": "wording_boundary",
      "label": "论文措辞边界\n摘要称平均 32 张截图\n贡献段落称平均 33 张截图\n公开数据卡未消解差异",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "release_boundary",
      "label": "固定公开数据快照\ntrajs.zip · 6,794,715,214 字节\nLFS SHA-256 d9677ed4aada\n仅图像与 profile.json · 不含公开真值",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "evaluation_boundary",
      "label": "评测披露边界\n论文披露判定模型与得分公式\n判定提示与匹配解析器未发布\n榜单通过服务端 /api/score 排队评分",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "openness_boundary",
      "label": "混合开放边界\nHF 轨迹公开 · Apache-2.0\n提交结构公开\n真值与独立评测器未开放",
      "type": "document",
      "size": "xl"
    }
  ],
