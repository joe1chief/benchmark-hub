  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="2920" pageHeight="712" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据边界&#xa;HLE 论文 arXiv:2501.14249v10&#xa;HLE 仓库 @ 26dca2e&#xa;cais/hle @ 5a81a4c&#xa;Step 报告 arXiv:2602.10604v2&#xa;Step GitHub @ 21d85a" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="HLE 专家贡献者&#xa;近 1,000 名专家&#xa;500+ 家机构 · 50 个国家&#xa;覆盖 100+ 个学科" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="创作原创专家题目&#xa;题目 + 精确答案&#xa;详细解析 + 学科&#xa;贡献者姓名 + 机构" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="240" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="质量与格式门槛&#xa;精确 / 无歧义 / 可解&#xa;不可搜索；简短 / 可验证&#xa;仅英语；不接受主观 / 开放式任务" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="544" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="前沿模型难度筛选&#xa;精确匹配：全部模型失败&#xa;选择题：最多一个模型成功&#xa;70K 次尝试 -&gt; 约 13K 候选" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="840" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="第一轮：1-3 名研究生专家&#xa;验证并完善每道候选题&#xa;第二轮：受训专家 / 组织者批准&#xa;发布后继续接收公开反馈" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1144" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="官方 HLE 公开测试集：2,500&#xa;24% 选择题；其余精确匹配&#xa;约 14% 需要图像" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1440" y="312" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="HLEtext 公开边界&#xa;Step 模型 HF @ ab446a3&#xa;只是报告标签；无独立数据集&#xa;精确筛选器 / 行数未公开&#xa;评测代码 / 运行日志未公开" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1744" y="-32" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="选择 HLE 纯文本视图&#xa;Step 报告称其为 HLEtext&#xa;精确筛选规则与行数&#xa;均未披露" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalA