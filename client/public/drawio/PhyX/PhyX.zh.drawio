  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1880" pageHeight="1136" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定一手证据&#xa;arXiv 2505.15929v2 · fc4a3a5a69d6&#xa;Git 2cee68b17643 · 评测 3994c9615bcf&#xa;HF 5a23a2762d06 · 卡片 5a72326b9392&#xa;项目页 1e9652dcde32" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="定义物理覆盖范围&#xa;六个领域 · 25 个子领域&#xa;六种推理类型&#xa;真实视觉情境落地" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="招募 STEM 研究生&#xa;担任专家标注者&#xa;全部问题使用英文&#xa;每题包含一张真实情境图像" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="选择允许使用的来源&#xa;免费可访问在线资源&#xa;教材及多种其他材料&#xa;避免答案紧邻题目" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="配对两种题型&#xa;每个开放题转换为选择题&#xa;每个选择题转换为开放题&#xa;选择题四项且仅一项正确" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="创建三种平行视图&#xa;Full-Text 原始文本&#xa;去冗余版移除图文重复信息&#xa;Text-Minimal 仅保留核心问题" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="用 GPT-4o 描述每张图&#xa;覆盖细粒度视觉内容&#xa;形成自包含文字描述&#xa;支持纯文本 LLM 评测" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="汇总候选池&#xa;共 3,300 个问题&#xa;来自多种来源&#xa;保留答案图像与标签" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="执行标注质量核验&#xa;标注者相互交叉检查&#xa;定期随机抽样复核&#xa;团队讨论歧义项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1600" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="检测潜在重复题&#xa;分析词汇重叠&#xa;标记相似问题&#xa;交由人工复核" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1360" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="物理博士生人工复核&#xa;确认并移除重复题&#xa;验证科学准确性&#xa;消除数据集偏差" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="按文本长度筛选&#xa;移除最短的 10%&#xa;保留上下文充分的难题&#xa;完成三级清洗" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="定稿 PhyX&#xa;3,000 个独立问题&#xa;6,000 个成对开放题与选择题&#xa;18,000 个核心题型视图实例" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="构建 testmini&#xa;按比例随机抽样&#xa;覆盖六个物理领域&#xa;1,000 个问题 · 6,000 个实例" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="选择评测视图&#xa;输入图像或 GPT-4o 描述&#xa;原文去冗余或最简文本&#xa;开放题或选择题格式" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="生成模型预测&#xa;零样本逐步推理指令&#xa;使用附录 D.1 思维链提示&#xa;保留原始推理输出" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="272" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="抽取最终答案&#xa;规则优先抽取方框内容&#xa;匹配最终或正确答案表达&#xa;选择题搜索 A 到 D 选项" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-80" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="当前是哪种题型？&#xa;开放题或选择题&#xa;复用同一通用流程" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="160" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="匹配选择题字母&#xa;比较抽取的 A 到 D&#xa;直接返回二元正确性&#xa;否则调用 Judge 回退" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="判断开放题语义等价&#xa;DeepSeek-V3 对比标准答案&#xa;多次重复调用 LLM&#xa;论文要求每次均判断成功" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="400" y="752" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="判断含糊的选择题输出&#xa;仅在字母直接匹配失败时使用&#xa;复用同一 LLM Judge 模板&#xa;返回二元正确性" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="640" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="汇总二元正确性&#xa;计算准确率&#xa;每个评测切片独立计分&#xa;不使用部分得分" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="880" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="报告细粒度准确率&#xa;开放题与选择题 · 三种文本视图&#xa;六个领域 · 六种推理类型&#xa;对比模型与人类专家" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1120" y="552" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="提示词与解析器披露边界&#xa;论文披露思维链与正则逻辑&#xa;披露 Judge 描述和推理类型提示&#xa;发布代码补充少样本 Judge 细节" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fon