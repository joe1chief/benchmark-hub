      "type": "process",
      "size": "xl"
    },
    {
      "id": "step_8",
      "label": "汇总 3,300 个候选问题\n组合题型与平行视图\n保留图像和标准答案\n保留领域与推理标签",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "step_9",
