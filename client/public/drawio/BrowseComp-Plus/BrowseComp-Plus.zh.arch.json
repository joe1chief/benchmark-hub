    {
      "id": "original",
      "label": "从原始 BrowseComp 出发\n1,266 个复杂问答对\n替代动态黑盒网页评测",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "o3_mining",
      "label": "使用 OpenAI o3 与网页搜索\n生成线索、候选 URL 与证据片段\n抓取候选页面",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "initial_filter",
      "label": "过滤幻觉 URL 与抓取失败\n为 1,142 个查询保留初始证据\n把证据链送入人工复核",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "human_verify",
      "label": "14 位学生标注员验证证据\n超过 400 小时 • 一致率超过 80%\n检查每条线索与完整作答链",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "verified",
      "label": "得到 830 个验证查询\n标记推理必需的 Evidence 文档\n标记同时含最终答案的 Gold 文档",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "decompose",
      "label": "GPT-4o 分解每个查询\n平均生成七条搜索子查询\n定位主题相关的干扰文档",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "hard_negatives",
      "label": "用 Google Search API 挖掘困难负样本\n主题相关但不能帮助得到最终答案\n增加检索难度",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "corpus",
      "label": "构建固定去重语料\n830 个查询共 100,195 篇文档\n平均 6.1 Evidence • 76.28 负样本 • 2.9 Gold",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "retrievers",
      "label": "配置受控检索器\nBM25 • Qwen3-Embedding 0.6B / 4B / 8B\nReasonIR 8B • Oracle 证据上下文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "topk",
      "label": "每次搜索返回 Top-5\n每条结果截断到 512 Token\n可选 get-document 工具打开全文",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "agent",
      "label": "Deep-Research Agent 迭代搜索\n规划查询 • 阅读结果 • 交叉核验证据\n返回最终答案与文档引用",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "answer_score",
      "label": "评分端到端作答\n归一化答案准确率与 Recall\n统计搜索调用次数与 Agent 成本",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "citation_score",
      "label": "评分引用落地性\n对 Positive 文档计算 Precision 与 Recall\n保留逐查询指标",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "retrieval_score",
      "label": "评分独立检索\nEvidence 与 Gold Recall@5 / 100 / 1000\n对公开 Qrels 计算 NDCG@10",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "报告受控 Agent 与检索器结果\n解耦检索、推理、引用与上下文\n比较 BM25、稠密检索、Oracle 与消融",
      "type": "terminal",
      "size": "xl"
    }
  ],
