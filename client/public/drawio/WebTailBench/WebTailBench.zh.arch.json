      "type": "process",
      "size": "xl"
    },
    {
      "id": "harm_categories",
      "label": "7 类安全危害风险定义\n包含隐私信息窃取、金融诈骗、钓鱼凭据\n有害内容散播与未经授权的系统越权篡改",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "achievable_gate",
      "label": "客观可达成性审查门禁\n逐题核验在线可完成性与客观判据有效性\n确保任务在当前真实网站环境下具备明确解法",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "harm_review_gate",
      "label": "危害性与拒绝标准清晰度门禁\n严格确认任务请求包含明确的安全违规要素\n确保模型触发安全拒绝的判据毫无争议",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "revise_main",
      "label": "修订主任务规范描述\n微调存在歧义的操作指令或易失效界面定位要求\n补充必要的环境变量与参数限定",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "revise_harm",
      "label": "修订有害攻击提示词\n强化风险特征提示以确保触发防御逻辑\n排除可能误导模型的良性歧义词句",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "main_set",
      "label": "609 道经验证的主任务集\n精选真实在线可完成之核心评测任务库\n严格锁定至 2025 年 11 月底基准有效期",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "refusal_set",
      "label": "111 道安全拒绝基准任务\n纯人工精细编排的高仿真有害请求库\n全面探测网页智能体安全对齐防线",
      "type": "database",
      "size": "xl"
    },
    {
      "id": "freshness_gate",
      "label": "在线网页新鲜度校验门禁\n实测目标网站界面是否发生重大改版或下线\n检测页面控件变迁与临时服务宕机",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "refresh_task",
      "label": "定期用例刷新与再验证\n更新失效网页链接、DOM 选择器与断言\n在改版后的网站上重新验证用例可解性",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "fresh_session",
      "label": "全新 Playwright 浏览器会话\n为每次评测推演启动全新独立的浏览器实例\n彻底隔离 Cookie、本地缓存与会话状态",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "run_main",
      "label": "执行主任务 / 100 步预算约束\n受测智能体在 100 步硬预算内自主操控网页\n执行工具调用、点击、表单录入与信息提取",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "env_error_gate",
      "label": "网络与环境错误诊断门禁\n检测网络断连、IP 频次限制与目标网站 5xx 故障\n严密区分智能体自身推理失误与外部网络中断",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "retry_gate",
      "label": "重试预算限制门禁\n仅针对外部环境故障提供至多 5 次重试机会\n有效消除网络偶发抖动对评测公正性的干扰",
      "type": "decision",
      "size": "xl"
    },
    {
      "id": "count_incorrect",
      "label": "判定为任务执行失败\n超出重试预算、步数耗尽或逻辑错误\n将该次尝试客观记录为 0 分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "main_judge",
      "label": "o4-mini 智能任务验收核验\n判定任务成功或是否正确报告外部客观不可控阻碍\n对准确识别外部不可抗力且未幻觉者赋予满分",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "three_run_aggregate",
      "label": "三次独立复跑汇总机制\n对每道任务独立推演执行三次测试\n统计多次尝试下的平均达成表现",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "main_metrics",
      "label": "宏平均与微平均成功率大报\n输出 11 大类别的宏平均得分与全集微平均达成率\n全面反映网页智能体在真实环境下的作战能力",
      "type": "terminal",
      "size": "xl"
    },
    {
