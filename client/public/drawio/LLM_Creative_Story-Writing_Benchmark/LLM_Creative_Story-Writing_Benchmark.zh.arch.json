      "id": "prompts",
      "label": "发布 400 个固定创意简报\n每题包含十个必需叙事元素\n600–800 词 · 纯 ASCII 英文\n故事标签与逐句累计词数",
      "type": "document",
      "size": "xl"
    },
    {
      "id": "generate",
      "label": "每个模型为每个简报生成一个故事\n自然融入全部必需元素\n遵守统一格式与长度合同\n仅保留实际完成的故事",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "match",
      "label": "构造成对匹配故事\n使用相同创意简报与必需元素\n仅比较均已完成故事的模型\n不为拒答结果填充分数",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "dual_order",
      "label": "评判两种可见故事顺序\n使用多个独立评判大模型\n分离量表内与量表外观察\n降低左右位置影响",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "parse",
      "label": "解析成对评判\n提取胜者标签与带符号差值\n保留评判器与故事标识\n排除无法解析的评判输出",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "correct",
      "label": "修正位置偏差\n估计实测左右侧影响\n调整带符号比较差值\n对同一故事的反向顺序评判取平均",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "aggregate",
      "label": "汇总全局比较图\n合并故事级模型对差值\n拟合全局 Thurstone 比较得分\n推导相对模型池的获胜概率",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "bootstrap",
      "label": "估计不确定性\n同时重采样故事与评判器\n计算 95% 置信区间\n保留覆盖不全模型标记",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "report",
      "label": "发布创意写作排行榜\n比较得分 · 获胜概率 · 95% 区间\n评判器一致性相关系数\n词数合规仅作为诊断项",
      "type": "terminal",
      "size": "xl"
    }
