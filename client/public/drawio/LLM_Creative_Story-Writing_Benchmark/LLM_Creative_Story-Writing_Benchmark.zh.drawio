<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1648" pageHeight="528" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="构造候选元素组合&#xa;十类元素 · 每类抽取十个候选&#xa;固定随机种子 42&#xa;历史官方流程文档" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-72" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="LLM 提议并评分元素组合&#xa;最多一类可为 None&#xa;校验并去重 · 按 1–10 分评分&#xa;按归一化均分排序" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="216" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="筛选并发布 400 个固定简报&#xa;400 个唯一 prompt 模板&#xa;十类元素 · 每题 9–10 个实际约束&#xa;归一化均分 → 原始均分 → 固定种子破平局" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="应用故事输出合同&#xa;600–800 个英文词 · 纯 ASCII&#xa;[story] 标签 · 逐句累计词数&#xa;自然整合所有实际约束" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="792" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="生成模型故事&#xa;每个模型最多尝试 400 个简报&#xa;仅保留实际完成的输出&#xa;标记覆盖不全" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1080" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="调度同题直接比较&#xa;相同 prompt 与实际约束&#xa;稀疏且增量扩展的模型对图&#xa;缺失输出不补分" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1368" y="-8" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="按两种可见顺序评判&#xa;使用多个评判模型&#xa;保留量表内与量表外证据&#xa;降低位置效应" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1368" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="验证评判协议版本桥接&#xa;共享题目 + 桥接对局&#xa;仅合并兼容的 v2/v3 证据&#xa;当前名单与阈值未公开" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1080" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="历史解析器合同&#xa;胜者 · 差值 · [-10, 10] 带符号差值&#xa;拒绝不可解析输出 · 保留溯源&#xa;当前 v2/v3 prompt/parser 未公开" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="792" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="应用已公开的成对汇总方法&#xa;修正评判器 A 侧偏差&#xa;平均相反显示顺序的判断&#xa;按故事与无序模型对汇总" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="拟合全局相对排名&#xa;对带符号差值做 Thurstone 风格最小二乘&#xa;BT 仅保留为诊断&#xa;估计相对模型池的获胜概率" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="216" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Bootstrap 并发布&#xa;重采样故事与评判器&#xa;历史：300 次 · seed 12345 · 95% CI&#xa;当前：比较分 · 胜率 · 不确定区间与诊断" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-72" y="344" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="15" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></