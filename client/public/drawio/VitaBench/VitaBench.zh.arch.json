      "type": "process",
      "size": "xl"
    },
    {
      "id": "acceptGate",
      "label": "专家人工验收判定闸门\n资深业务专家全面核验试跑轨迹与环境终态\n确保题目逻辑合理且无自相矛盾的不可能任务",
      "type": "decision",
      "size": "xl"
    },
    {
