ign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="Does the Premise Support&#xa;Useful Clinical Inferences?" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="Discard Invalid Pilot Premises&#xa;Clinician Judgment&#xa;Often De-identification Artifacts&#xa;16 Premises Removed" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="-24" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="Cross-label Retained Pilot Pairs&#xa;One Clinician Reviews the Other's Pairs&#xa;184 Premises × Three Hypotheses&#xa;552 Sentence Pairs" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="Check Pilot Agreement&#xa;Definitely / Maybe / Definitely False&#xa;Cohen's Kappa = 0.78&#xa;Review True-versus-Maybe Disagreements" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="Scale Up Expert Annotation&#