      "type": "process",
      "size": "xl"
    },
    {
      "id": "agreement",
      "label": "交叉标注试点句对\n比较 552 个已生成句对\n肯定 · 可能 · 肯定不成立\nCohen Kappa：0.78",
      "type": "process",
      "size": "xl"
    },
    {
      "id": "annotate",
      "label": "完成专家标注\n再招募两名临床医生\n共四名临床医生\n六周处理 4,683 个前提",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "dataset",
