      "size": "xl"
    },
    {
      "id": "hypotheses",
      "label": "临床医生撰写三条假设\n肯定为真：蕴含\n可能为真：中立\n肯定为假：矛盾",
      "type": "user",
      "size": "xl"
    },
    {
      "id": "pilot",
