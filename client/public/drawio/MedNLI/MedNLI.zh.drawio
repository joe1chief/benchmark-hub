<?xml version="1.0" encoding="UTF-8"?>
<mxfile host="cli" modified="" agent="drawio-skill-cli" version="21.0.0">
  <diagram name="Page-1">
    <mxGraphModel dx="1120" dy="720" grid="1" gridSize="8" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="3304" pageHeight="1080" math="0" background="#FFFFFF"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2" value="固定证据快照&#xa;arXiv:1808.06752v2 · PDF SHA d328fab8b047&#xa;代码 HEAD e1fe2531a9e9&#xa;PhysioNet v1.0.0 · DOI 10.13026/C2RS98&#xa;辅助 BigBIO 加载器 21f3313de37d" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="-24" width="200" height="100" as="geometry"/></mxCell><mxCell id="3" value="论文构建数据源&#xa;MIMIC-III v1.3&#xa;38,597 名去标识患者&#xa;2,078,705 份英文临床病历" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="4" value="限定临床病历来源&#xa;PhysioNet 方法说明进一步明确&#xa;仅使用死亡患者对应病历&#xa;降低患者隐私风险" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="5" value="按章节标题切分病历&#xa;简单规则程序&#xa;选择既往病史章节&#xa;保留去标识化伪影" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="6" value="创建候选前提句&#xa;生物医学 LingPipe 分句器&#xa;汇集既往病史句子&#xa;随机抽取子集" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="7" value="只展示一个前提句&#xa;仅依据该句&#xa;可用医学知识与常识&#xa;不提供病历其余上下文" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="8" value="临床医生撰写三个假设&#xa;肯定为真 → 蕴含&#xa;可能为真 → 中立&#xa;肯定为假 → 矛盾" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="9" value="试点标注&#xa;两名取得专科认证的放射科医生&#xa;每人 100 个互异前提&#xa;按临床标注指南执行" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="10" value="该前提能否支持&#xa;有用的临床推断？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="11" value="丢弃无效试点前提&#xa;由临床医生判断&#xa;常见原因为去标识化伪影&#xa;共移除 16 个前提" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="-24" width="200" height="100" as="geometry"/></mxCell><mxCell id="12" value="对保留的试点句对交叉标注&#xa;一名医生复核另一名医生的句对&#xa;184 个前提 × 三个假设&#xa;共 552 个句对" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="13" value="检查试点一致性&#xa;肯定 / 可能 / 肯定为假&#xa;Cohen's Kappa = 0.78&#xa;复盘“肯定”与“可能”分歧" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="14" value="扩大专家标注&#xa;再招募两名临床医生&#xa;共四名临床医生 · 六周&#xa;标注 4,683 个前提" style="ellipse;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#1976D2;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2744" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="15" value="最终标注边界&#xa;每个句对不做多人重复标注&#xa;原因是时间与经费限制&#xa;试点一致性不等于多数投票" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="3024" y="216" width="200" height="100" as="geometry"/></mxCell><mxCell id="16" value="形成 MedNLI&#xa;4,683 个前提 × 三类标签&#xa;14,049 个唯一句对&#xa;蕴含 · 中立 · 矛盾" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2744" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="17" value="按前提互斥划分数据集&#xa;训练集 11,232&#xa;开发集 1,395&#xa;测试集 1,422" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2464" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="18" value="PhysioNet MedNLI v1.0.0&#xa;训练 / 开发 / 测试 JSONL&#xa;SNLI / MultiNLI 风格记录&#xa;句对 + 解析树 + 金标字段" style="shape=cylinder3;boundedLbl=1;backgroundOutline=1;size=15;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E8F5E9;strokeColor=#4CAF50;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="2184" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="19" value="数据源版本边界&#xa;论文：MIMIC-III v1.3&#xa;PhysioNet 父数据：MIMIC-III v1.4&#xa;不可把二者视为同一固定版本" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="20" value="受限数据访问边界&#xa;需 CITI 培训并签署 DUA&#xa;PhysioNet 健康数据许可 1.5.0&#xa;代码仓库没有 LICENSE 文件" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1904" y="896" width="200" height="100" as="geometry"/></mxCell><mxCell id="21" value="评测临床三分类 NLI&#xa;前提 + 假设 → 一个标签&#xa;测试前提不进入训练集&#xa;基准指标为准确率" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1624" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="22" value="论文实验协议&#xa;特征模型 · BOW · InferSent · ESIM&#xa;Adam · 选择最低验证损失&#xa;验证损失五轮不改善则停止&#xa;运行六个不同随机种子" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1344" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="23" value="被评测划分是否&#xa;提供金标？" style="rhombus;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFF3E0;strokeColor=#FF9800;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="24" value="公开测试标签已隐藏&#xa;PhysioNet 说明 gold_label 被遮蔽&#xa;发布读取器丢弃标签为 '-' 的记录&#xa;仅凭这些行无法计算测试准确率" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="1064" y="896" width="200" height="100" as="geometry"/></mxCell><mxCell id="25" value="发布的复现实验代码&#xa;read_nli_data 丢弃 gold_label '-'&#xa;旧版 Python 3.4 / 3.6.3&#xa;PyTorch 0.2.0 + MetaMap / UMLS" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="26" value="实现边界&#xa;无托管评测器或输出解析器&#xa;未定义无效输出策略&#xa;没有官方在线排行榜" style="shape=document;boundedLbl=1;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#FFFFFF;strokeColor=#9E9E9E;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="784" y="896" width="200" height="100" as="geometry"/></mxCell><mxCell id="27" value="对带金标的记录计分&#xa;DataLoader shuffle=False&#xa;对三类模型 logit 取 argmax&#xa;与金标做精确标签比较" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="504" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="28" value="计算分类准确率&#xa;正确预测数 / 数据集长度&#xa;不设部分得分&#xa;每次评测得到一个分数" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="224" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="29" value="汇总论文多次运行&#xa;六个相同超参数随机种子&#xa;按模型 / 设置取平均准确率&#xa;开发与测试结果分别保留" style="rounded=1;arcSize=20;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#E3F2FD;strokeColor=#2196F3;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="576" width="200" height="100" as="geometry"/></mxCell><mxCell id="30" value="报告论文准确率（%）· 开发 / 测试&#xa;特征 51.9 / 51.9 · BOW 71.9 / 70.2&#xa;InferSent 76.0 / 73.5 · ESIM 74.4 / 73.1&#xa;迁移与领域知识增益单独报告&#xa;无综合分数或在线排行榜" style="rounded=1;arcSize=50;html=0;convertToSvg=1;whiteSpace=wrap;fillColor=#ECEFF1;strokeColor=#607D8B;strokeWidth=1.5;fontColor=#212121;fontSize=11;fontFamily=Arial, Helvetica, sans-serif;verticalAlign=middle;align=center" vertex="1" parent="1"><mxGeometry x="-56" y="896" width="200" height="100" as="geometry"/></mxCell><mxCell id="31" value="固定论文与发布证据" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#9E9E9E;strokeWidth=1;endArrow=open;endFill=0;exitX=0.25;exitY=1;exitDx=0;exitDy=0;entryX=0.25;entryY=0;entryDx=0;entryDy=0;dashed=1;dashPattern=3 3;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="2" target="3"><mxGeometry x="-0.6" relative="1" as="geometry"><mxPoint x="12" y="0" as="offset"/></mxGeometry></mxCell><mxCell id="33" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="3" target="4"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="34" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" parent="1" source="4" target="5"><mxGeometry relative="1" as="geometry"></mxGeometry></mxCell><mxCell id="35" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=0;convertToSvg=1;strokeColor=#424242;strokeWidth=1.5;endArrow=block;endFill=1;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;jumpStyle=arc;jumpSize=8" edge="1" pa